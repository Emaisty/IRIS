  (wp (Store (Val (LitV (LitLoc l))) (Val v)) (\lam v' => mkProperAnd (mkProperPure (v' = LitV LitUnit)) (pointsTo l v))) => {?}

\lemma wp_alloc {cnt : Countable Loc} (v : Value) : properUPred_ent {HeapCMRA Loc cnt Value} (mkProperPure (\Sigma)) 
  (wp (Alloc (Val v)) (\lam v' => mkProperExist Loc (\lam l => mkProperAnd (mkProperPure (v' = LitV (LitLoc l))) (pointsTo l v)))) => {?}

