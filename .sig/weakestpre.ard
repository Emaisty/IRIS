\func heap_state_to_gmap {cnt : Countable Loc} (s : State cnt) : Gmap Loc cnt (Maybe (Excl Value)) => {?}
  \where {
    \func tag (p : \Sigma Loc Value) : Maybe (\Sigma Loc (Maybe (Excl Value))) => {?}

    \func heap_state_to_gmap_wf {cnt : Countable Loc} (s : State cnt) :
      gmap_wf {Loc} {cnt} {Maybe (Excl Value)} (\new (Pmap (\Sigma Loc (Maybe (Excl Value)))) {  | tree => {?}  | tree_wf => {?}}) => {?}
  }


\lemma heap_state_to_gmap_validN {cnt : Countable Loc} (n : Nat) (sigma : State cnt) : (GmapUCMRA Loc cnt (ExclUCMRA (DiscreteOFE Value))).validN n (heap_state_to_gmap sigma) => {?}

\lemma heap_state_to_gmap_lookup {cnt : Countable Loc} (sigma : State cnt) (l : Loc) :
  glookup (heap_state_to_gmap sigma) l = (\case glookup sigma.heap l \with {  | nothing => nothing  | just v => just (just (excl v))}) => {?}

\lemma heap_state_to_gmap_update {cnt : Countable Loc} (sigma : State cnt) (l : Loc) (v : Value) :
  heap_state_to_gmap (\new (State cnt) {  | heap => {?}}) = lib.heap.heap_update (heap_state_to_gmap sigma) l v => {?}

\func own_heap_auth {cnt : Countable Loc} (s : State cnt) : ProperUPred (HeapCMRA Loc cnt Value) => {?}

\lemma own_heap_alloc_bupd {cnt : Countable Loc} (sigma : State cnt) (l : Loc) (v : Value) (fresh : glookup sigma.heap l = nothing) :
  properUPred_ent {HeapCMRA Loc cnt Value} (own_heap_auth sigma) (mkProperBUpd (mkProperSep (own_heap_auth (\new (State cnt) {  | heap => {?}})) (pointsTo l v))) 
  => {?}

\lemma own_heap_store_bupd {cnt : Countable Loc} (sigma : State cnt) (l : Loc) (old v : Value) (lookup : glookup sigma.heap l = just old) :
properUPred_ent {HeapCMRA Loc cnt Value} (mkProperSep (own_heap_auth sigma) (pointsTo l old)) 
  (mkProperBUpd (mkProperSep (own_heap_auth (\new (State cnt) {  | heap => {?}})) (pointsTo l v))) => {?}

