\func wp_mono {cnt : Countable Loc} (e : Expr) (Phi Psi : Value -> ProperUPred (HeapCMRA Loc cnt Value)) (h : \Pi (v : Value) -> properUPred_ent (Phi v) (Psi v)) :
  properUPred_ent (wp e Phi) (wp e Psi) => {?}
  \where {
    \func wp_mono_at_le (Phi Psi : Value -> ProperUPred (HeapCMRA Loc cnt Value)) (h : \Pi (v : Value) -> properUPred_ent (Phi v) (Psi v)) (N : Nat) (n : Nat) 
    (n_le_N : n <= N) (e : Expr) (a : (HeapCMRA Loc cnt Value).E) (hv : validN {HeapCMRA Loc cnt Value} n a) (hp : (wp e Phi).upred_holds n a) : (wp e Psi).upred_holds n a 
      => {?}

    \func wp_mono_aux (Phi Psi : Value -> ProperUPred (HeapCMRA Loc cnt Value)) (h : \Pi (v : Value) -> properUPred_ent (Phi v) (Psi v)) (e : Expr) :
      properUPred_ent (wp e Phi) (wp e Psi) => {?}

    \func wp_pre_mono_zero (Phi Psi : Value -> ProperUPred (HeapCMRA Loc cnt Value)) (h : \Pi (v : Value) -> properUPred_ent (Phi v) (Psi v)) (e : Expr) 
    (a : (HeapCMRA Loc cnt Value).E) (hv : validN {HeapCMRA Loc cnt Value} 0 a) (hp : (wp_pre wp e Phi).upred_holds 0 a) :
      (wp_pre wp e Psi).upred_holds 0 a => {?}

    \func wp_pre_mono_step (Phi Psi : Value -> ProperUPred (HeapCMRA Loc cnt Value)) (h : \Pi (v : Value) -> properUPred_ent (Phi v) (Psi v)) (e : Expr) 
    (a : (HeapCMRA Loc cnt Value).E) {n : Nat} (hv : validN {HeapCMRA Loc cnt Value} (suc n) a) (hp : (wp_pre wp e Phi).upred_holds (suc n) a)
      (ih : \Pi (k : Nat) -> k <= n -> \Pi (e' : Expr) (a' : (HeapCMRA Loc cnt Value).E) ->
      validN {HeapCMRA Loc cnt Value} k a' -> (wp e' Phi).upred_holds k a' -> (wp e' Psi).upred_holds k a') : (wp_pre wp e Psi).upred_holds (suc n) a => {?}
  }


\lemma wp_value_intro {cnt : Countable Loc} (v : Value) (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value)) : properUPred_ent (Phi v) (wp (Val v) Phi) => {?}

\lemma wp_post_mono {cnt : Countable Loc} (e : Expr) (Phi Psi : Value -> ProperUPred (HeapCMRA Loc cnt Value)) (h : \Pi (v : Value) -> properUPred_ent (Phi v) (Psi v)) :
  properUPred_ent (wp e Phi) (wp e Psi) => {?}

\lemma wp_pure_step {cnt : Countable Loc} (e e' : Expr) (pure : \Pi (sigma : State cnt) -> PrimStep e sigma e' sigma) 
(det : \Pi (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt) -> PrimStep e sigma e2 sigma2 -> \Sigma (e2 = e') (sigma2 = sigma)) 
(no_val : to_val e = nothing) (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value)) : properUPred_ent (wp e' Phi) (wp e Phi) => {?}

\lemma wp_load {cnt : Countable Loc} (l : Loc) (v : Value) :
  properUPred_ent {HeapCMRA Loc cnt Value} (pointsTo l v) (wp (Load (Val (LitV (LitLoc l)))) (\lam v' => mkProperAnd (mkProperPure (v' = v)) (pointsTo l v))) 
  => {?}
  \where {
    \func own_heap_auth_heap_eq {cnt : Countable Loc} (s1 s2 : State cnt) (h : s1.heap = s2.heap) : own_heap_auth s1 = own_heap_auth s2 => {?}

    \func heap_auth_frag_agree {cnt : Countable Loc} (n : Nat) (sigma : State cnt) (a_frag a_auth : (HeapCMRA Loc cnt Value).E) (l : Loc) (v : Value) 
    (hv : (HeapCMRA Loc cnt Value).validN n ((HeapCMRA Loc cnt Value).op a_frag a_auth)) (h_auth : (own_heap_auth sigma).upred_holds n a_auth) 
    (h_frag : (pointsTo l v).upred_holds n a_frag) : glookup sigma.heap l = just v => {?}
      \where {
        \func option_dist_to_eq_local (n : Nat) (o1 o2 : Maybe (Maybe (Excl Value))) (h : (OptionOFE (ExclUCMRA (DiscreteOFE Value))).dist n o1 o2) : o1 = o2 => {?}
      }


    \func base_load_step_inv {cnt : Countable Loc} (l : Loc) (v : Value) (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt) (lookup : glookup sigma.heap l = just v) 
    (hstep : BaseStep (Load (Val (LitV (LitLoc l)))) sigma e2 sigma2) : \Sigma (e2 = Val v) (sigma2 = sigma) => {?}

\data LoadStepInv {cnt : Countable Loc} (l : Loc) (v : Value) (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt) : \Prop 
      | LoadStepInvIntro (e2_eq : e2 = Val v) (sigma2_eq : sigma2 = sigma)

    \func load_step_inv_ctx_item {cnt : Countable Loc} (l : Loc) (v : Value) (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt) (lookup : glookup sigma.heap l = just v) 
    (Ki : EctxItem) (K' : Ectx) (e1' e2' : Expr) (p1 : Load (Val (LitV (LitLoc l))) = fill_item Ki (fill K' e1')) (p2 : e2 = fill_item Ki (fill K' e2')) 
    (base : BaseStep e1' sigma e2' sigma2) : LoadStepInv l v sigma e2 sigma2 => {?}

    \func load_step_inv_ctx {cnt : Countable Loc} (l : Loc) (v : Value) (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt) (lookup : glookup sigma.heap l = just v) (K : Ectx) 
    (e1' e2' : Expr) (p1 : Load (Val (LitV (LitLoc l))) = fill K e1') (p2 : e2 = fill K e2') (base : BaseStep e1' sigma e2' sigma2) : LoadStepInv l v sigma e2 sigma2 
      => {?}

    \func load_step_inv {cnt : Countable Loc} (l : Loc) (v : Value) (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt) (lookup : glookup sigma.heap l = just v) 
    (hstep : PrimStep (Load (Val (LitV (LitLoc l)))) sigma e2 sigma2) : LoadStepInv l v sigma e2 sigma2 => {?}
  }


