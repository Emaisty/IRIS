\func base_redex_step_det {cnt : Countable Loc} (e e' : Expr) 
(base_det : \Pi (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt) -> BaseStep e sigma e2 sigma2 -> \Sigma (e2 = e') (sigma2 = sigma))
  (ctx_absurd : \Pi (sigma : State cnt) (sigma2 : State cnt) (Ki : EctxItem) (K : Ectx) (e1' e2' : Expr) ->
  e = fill_item Ki (fill K e1') -> BaseStep e1' sigma e2' sigma2 -> Empty) (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt) 
(step : PrimStep e sigma e2 sigma2) : \Sigma (e2 = e') (sigma2 = sigma) => {?}
  \where {
    \func base_redex_step_det_ctx {cnt : Countable Loc} (e e' : Expr) 
    (base_det : \Pi (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt) -> BaseStep e sigma e2 sigma2 -> \Sigma (e2 = e') (sigma2 = sigma))
      (ctx_absurd : \Pi (sigma : State cnt) (sigma2 : State cnt) (Ki : EctxItem) (K : Ectx) (e1' e2' : Expr) ->
      e = fill_item Ki (fill K e1') -> BaseStep e1' sigma e2' sigma2 -> Empty) (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt) (K : Ectx) 
    (e1' e2' : Expr) (p1 : e = fill K e1') (p2 : e2 = fill K e2') (base : BaseStep e1' sigma e2' sigma2) : \Sigma (e2 = e') (sigma2 = sigma) => {?}
  }


