\import iris.algebra.cmra
\import iris.base_logic.upred
\import iris.base_logic.notation
\import iris.bi.updates
\import iris.proofmode.core

-- Every proof-mode class has a source-level construction test.  These tests
-- keep the extensibility boundary honest independently of the Java metas.
\func proofmode_class_assumption {M : UCMRA} (P : ProperUPred M)
  : PMFromAssumption M P P => pm_from_assumption_refl P

\func proofmode_class_into_pure {M : UCMRA} (P : ProperUPred M)
    (phi : \Prop) (h : P ⊢ mkProperPure phi)
  : PMIntoPure M P phi \cowith
  | into_pure => h

\func proofmode_class_from_pure {M : UCMRA} (P : ProperUPred M)
    (phi : \Prop) (h : phi -> mkProperEmp ⊢ P)
  : PMFromPure M P phi \cowith
  | from_pure => h

\func proofmode_class_into_persistent {M : UCMRA}
    (P Q : ProperUPred M) (h : P ⊢ (<#> Q))
  : PMIntoPersistent M P Q \cowith
  | into_persistent => h

\func proofmode_class_from_sep {M : UCMRA} (P Q : ProperUPred M)
  : PMFromSep M (P ∗ Q) P Q => pm_from_sep_direct P Q

\func proofmode_class_into_and {M : UCMRA} (P Q : ProperUPred M)
  : PMIntoAnd M (P ∧ Q) P Q => pm_into_and_direct P Q

\func proofmode_class_into_or {M : UCMRA} (P Q : ProperUPred M)
  : PMIntoOr M (P ∨ Q) P Q => pm_into_or_direct P Q

\func proofmode_class_into_wand {M : UCMRA} (P Q : ProperUPred M)
  : PMIntoWand M (P -∗ Q) P Q => pm_into_wand_direct P Q

\func proofmode_class_into_later {M : UCMRA} (P : ProperUPred M)
  : PMIntoLater M (|> P) P => pm_into_later_direct P

\func proofmode_class_from_later {M : UCMRA} (P Q : ProperUPred M)
    (h : (|> P) ⊢ Q)
  : PMFromLater M P Q \cowith
  | from_later => h

\func proofmode_class_timeless {M : UCMRA} (P : ProperUPred M)
    (h : (|> P) ⊢ mkProperExceptZero P)
  : PMTimeless M P => pm_timeless_direct P h

\func proofmode_class_from_exist {M : UCMRA} {A : \Set0}
    (Phi : A -> ProperUPred M)
  : PMFromExist M (mkProperExist A Phi) Phi => pm_from_exist_direct {M} {A} Phi

\func proofmode_class_into_exist {M : UCMRA} {A : \Set0}
    (Phi : A -> ProperUPred M)
  : PMIntoExist M (mkProperExist A Phi) Phi =>
  pm_into_exist_direct {M} {A} Phi

\func proofmode_class_from_exist1 {M : UCMRA} {A : \Set1}
    (Phi : A -> ProperUPred M)
  : PMFromExist1 M (mkProperExist1 A Phi) Phi => pm_from_exist1_direct {M} {A} Phi

\func proofmode_class_into_exist1 {M : UCMRA} {A : \Set1}
    (Phi : A -> ProperUPred M)
  : PMIntoExist1 M (mkProperExist1 A Phi) Phi =>
  pm_into_exist1_direct {M} {A} Phi

\func proofmode_class_into_forall {M : UCMRA} {A : \Set0}
    (Phi : A -> ProperUPred M)
  : PMIntoForall M (mkProperForall A Phi) Phi => pm_into_forall_direct {M} {A} Phi

\func proofmode_class_from_forall {M : UCMRA} {A : \Set0}
    (Phi : A -> ProperUPred M)
  : PMFromForall M (mkProperForall A Phi) Phi =>
  pm_from_forall_direct {M} {A} Phi

\func proofmode_class_frame {M : UCMRA} (R Q : ProperUPred M)
  : PMFrame M R (R ∗ Q) Q => pm_frame_direct R Q

\func proofmode_class_into_update {M : UCMRA} (P Q : ProperUPred M)
    (h : P ⊢ (|==> Q))
  : PMIntoUpdate M P Q \cowith
  | into_update => h

\func proofmode_class_into_invariant {M : UCMRA}
    (P Q Close : ProperUPred M) (h : P ⊢ (Q ∗ Close))
  : PMIntoInvariant M P Q Close \cowith
  | into_invariant => h

\func proofmode_class_into_accessor {M : UCMRA}
    (P Q Close : ProperUPred M) (h : P ⊢ (Q ∗ Close))
  : PMIntoAccessor M P Q Close \cowith
  | into_accessor => h
