-- This was stuck before F02; both nested BinOp operands must be evaluated.
\lemma pures_nested_add {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (Phi : Value -> iProp S) :
  (Phi (natV 10)) ⊢ wp H E
    (NatAdd (NatAdd (Val (natV 1)) (Val (natV 2)))
      (NatAdd (Val (natV 3)) (Val (natV 4)))) Phi =>
  ipm $ wp_pures $ iExact ""

-- Pure evaluation stops at the ready stateful operation, retaining its WP.
\lemma pures_allocN_operands {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (Phi : Value -> iProp S) :
  (wp H E (AllocN (Val (natV 2)) (Val (natV 5))) Phi) ⊢ wp H E
    (AllocN (NatAdd (Val (natV 1)) (Val (natV 1)))
      (NatAdd (Val (natV 2)) (Val (natV 3)))) Phi =>
  ipm $ wp_pures $ iExact ""

\lemma pures_faa_operands {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (Phi : Value -> iProp S) :
  (wp H E (FAA (Val (LitV (LitLoc 1))) (Val (natV 2))) Phi) ⊢ wp H E
    (FAA (LocAdd (Val (LitV (LitLoc 0))) (Val (natV 1)))
      (NatAdd (Val (natV 1)) (Val (natV 1)))) Phi =>
  ipm $ wp_pures $ iExact ""
