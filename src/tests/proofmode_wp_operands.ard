\import Function.Meta
\import Meta
\import iris.algebra.coPset
\import iris.algebra.gmap
\import iris.base_logic.lib.gfunctors
\import iris.base_logic.lib.iprop
\import iris.base_logic.notation
\import iris.base_logic.upred
\import iris.program_logic.weakestpre \hiding (wp_value)
\import iris_heap_lang.lang
\import iris.proofmode.Meta
\import stdpp.coPset

-- Each test elaborates through the Java focuser and checks the resulting term.

\lemma bind_binop_right {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (op : HeapBinOp) (e1 e2 : Expr)
    (Phi : Value -> iProp S)
  : ((wp H E e2 (\lam v => wp H E (BinOp op e1 (Val v)) Phi)) ∗
      mkProperEmp) ⊢ (wp H E (BinOp op e1 e2) Phi) =>
  ipm $ iIntros "HP HE" $ wp_bind $ iExact "HP"

\lemma smart_apply_binop_right {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (op : HeapBinOp) (e1 e2 : Expr)
    (P : iProp S) (Phi Psi : Value -> iProp S)
    (rule : P ⊢ wp H E e2 Phi)
    (post : \Pi (v : Value) -> (Phi v) ⊢ wp H E (BinOp op e1 (Val v)) Psi)
  : (P ∗ mkProperEmp) ⊢ wp H E (BinOp op e1 e2) Psi =>
  ipm $ iIntros "HP HE" $ wp_smart_apply rule post $ iExact "HP"

\lemma bind_binop_left {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (op : HeapBinOp) (e1 : Expr) (v2 : Value)
    (Phi : Value -> iProp S)
  : ((wp H E e1 (\lam v => wp H E (BinOp op (Val v) (Val v2)) Phi)) ∗
      mkProperEmp) ⊢ (wp H E (BinOp op e1 (Val v2)) Phi) =>
  ipm $ iIntros "HP HE" $ wp_bind $ iExact "HP"

\lemma smart_apply_binop_left {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (op : HeapBinOp) (e1 : Expr) (v2 : Value)
    (P : iProp S) (Phi Psi : Value -> iProp S)
    (rule : P ⊢ wp H E e1 Phi)
    (post : \Pi (v : Value) -> (Phi v) ⊢ wp H E (BinOp op (Val v) (Val v2)) Psi)
  : (P ∗ mkProperEmp) ⊢ wp H E (BinOp op e1 (Val v2)) Psi =>
  ipm $ iIntros "HP HE" $ wp_smart_apply rule post $ iExact "HP"

\func bind_binop_left_first_fails {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (op : HeapBinOp) (e1 e2 : Expr)
    (Phi : Value -> iProp S) =>
  fails (ipm $ iIntros "HP HE" $ wp_bind $ iExact "HP"
    : ((wp H E e1 (\lam v => wp H E (BinOp op (Val v) e2) Phi)) ∗
        mkProperEmp) ⊢ wp H E (BinOp op e1 e2) Phi)

