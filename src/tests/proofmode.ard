\import iris.proofmode.core
\import iris.proofmode.Meta

\lemma proofmode_start_smoke {M : UCMRA} (P Q : ProperUPred M)
  : (P ∗ Q) ⊢ (P ∗ Q) =>
  ipm $ iStopProof $
    properUPred_ent_trans
      (mkProperEmp ∗ (mkProperEmp ∗ (P ∗ Q)))
      (mkProperEmp ∗ (P ∗ Q)) (P ∗ Q)
      (sep_elim_r_ent mkProperEmp (mkProperEmp ∗ (P ∗ Q)))
      (sep_elim_r_ent mkProperEmp (P ∗ Q))

\lemma proofmode_intros_smoke {M : UCMRA} (P Q : ProperUPred M)
  : (P ∗ Q) ⊢ (P ∗ Q) =>
  ipm $ iIntros "HP HQ" $ iStopProof $
    properUPred_ent_trans
      (mkProperEmp ∗ ((mkProperEmp ∗ P) ∗ Q))
      ((mkProperEmp ∗ P) ∗ Q) (P ∗ Q)
      (sep_elim_r_ent mkProperEmp ((mkProperEmp ∗ P) ∗ Q))
      (sep_mono_l_ent (mkProperEmp ∗ P) P Q
        ((BIuPredMixin M).bi_mixin_emp_sep_2 P))

\lemma proofmode_intros_local_alias {M : UCMRA} (P Q : ProperUPred M)
  : (P ∗ Q) ⊢ P =>
  \let | Aliased => P ∗ Q
  \in (ipm $ iIntros "HP HQ" $ iExact "HP" : Aliased ⊢ P)

\lemma proofmode_intros_single {M : UCMRA} (P : ProperUPred M)
  : P ⊢ P =>
  ipm $ iIntros "HP" $ iExact "HP"

\lemma proofmode_connective_local_aliases {M : UCMRA}
    (P Q R : ProperUPred M) : ((P ∗ Q) ∗ R) ⊢ (Q ∗ R) =>
  \let
    | Pair => P ∗ Q
    | Source => Pair ∗ R
    | Goal => Q ∗ R
  \in (ipm $ iIntros "HPAIR HR" $
    iDestruct "HPAIR" "HP HQ" $ iFrame "HQ" $ iExact "HR"
      : Source ⊢ Goal)

\lemma proofmode_exact_latest {M : UCMRA} (P Q : ProperUPred M)
  : (P ∗ Q) ⊢ Q => ipm $ iIntros "HP HQ" $ iExact "HQ"

\lemma proofmode_exact_older {M : UCMRA} (P Q : ProperUPred M)
  : (P ∗ Q) ⊢ P => ipm $ iIntros "HP HQ" $ iExact "HP"

\lemma proofmode_destruct {M : UCMRA} (P Q R : ProperUPred M)
  : (P ∗ (Q ∗ R)) ⊢ Q =>
  ipm $ iIntros "HP HQR" $ iDestruct "HQR" "HQ HR" $ iExact "HQ"

\lemma proofmode_destruct_or {M : UCMRA} (P Q R : ProperUPred M) :
  (((P ∨ Q) ∗ (P -∗ R)) ∗ (Q -∗ R)) ⊢ R =>
  ipm $ iIntros "HLeft HWQ" $ iDestruct "HLeft" "HCase HWP" $
    iDestruct "HCase" "HP | HQ"
      (iApply "HWP" $ iExact "HP")
      (iApply "HWQ" $ iExact "HQ")

\func proofmode_wrapped_or {M : UCMRA}
    (P Q : ProperUPred M) : ProperUPred M => P ∨ Q

\lemma proofmode_destruct_wrapped_or {M : UCMRA}
    (P Q R : ProperUPred M) :
  (((proofmode_wrapped_or P Q) ∗ (P -∗ R)) ∗ (Q -∗ R)) ⊢ R =>
  ipm $ iIntros "HLeft HWQ" $ iDestruct "HLeft" "HCase HWP" $
    iDestruct "HCase" "HP | HQ" P Q
      (iApply "HWP" $ iExact "HP")
      (iApply "HWQ" $ iExact "HQ")

\lemma proofmode_destruct_exist {M : UCMRA} {A : \Set0}
    (Phi : A -> ProperUPred M) (Q : ProperUPred M) :
  ((mkProperExist A Phi) ∗ Q) ⊢
    (mkProperExist A (\lam a => (Phi a) ∗ Q)) =>
  ipm $ iIntros "Hex HQ" $ iDestruct "Hex" "HPhi" $ \lam a =>
    iExists a $ iFrame "HPhi" $ iExact "HQ"

\lemma proofmode_destruct_exist1 {M : UCMRA} {A : \Set1}
    (Phi : A -> ProperUPred M) (Q : ProperUPred M) :
  ((mkProperExist1 A Phi) ∗ Q) ⊢ Q =>
  ipm $ iIntros "Hex HQ" $ iDestruct "Hex" "HPhi" Phi $ \lam _ =>
    iExact "HQ"

\func proofmode_wrapped_exists {M : UCMRA} {A : \Set0}
    (Phi : A -> ProperUPred M) : ProperUPred M => mkProperExist A Phi

\lemma proofmode_destruct_wrapped_exist {M : UCMRA} {A : \Set0}
    (Phi : A -> ProperUPred M) (Q : ProperUPred M) :
  ((proofmode_wrapped_exists Phi) ∗ Q) ⊢
    (proofmode_wrapped_exists (\lam a => (Phi a) ∗ Q)) =>
  ipm $ iIntros "Hex HQ" $ iDestruct "Hex" "HPhi" $ \lam a =>
    iExists a (\lam x => (Phi x) ∗ Q) $
      iFrame "HPhi" $ iExact "HQ"

\lemma proofmode_destruct_exist_explicit_family {M : UCMRA} {A : \Set0}
    (Phi : A -> ProperUPred M) (Q : ProperUPred M) :
  ((proofmode_wrapped_exists Phi) ∗ Q) ⊢
    (proofmode_wrapped_exists (\lam a => (Phi a) ∗ Q)) =>
  ipm $ iIntros "Hex HQ" $ iDestruct "Hex" "HPhi" Phi $ \lam a =>
    iExists a (\lam x => (Phi x) ∗ Q) $
      iFrame "HPhi" $ iExact "HQ"

\lemma proofmode_destruct_pure {M : UCMRA} (P : ProperUPred M)
    (phi : \Prop) :
  ((mkProperPure phi) ∗ P) ⊢ ((mkProperPure phi) ∗ P) =>
  ipm $ iIntros "Hphi HP" $ iDestruct "Hphi" "%" $ \lam h =>
    iSplitL "" (iPureIntro $ h) (iExact "HP")

\lemma proofmode_destruct_and_pure_l {M : UCMRA}
    (P Q : ProperUPred M) (phi : \Prop) :
  (((mkProperPure phi) ∧ P) ∗ Q) ⊢ (P ∗ Q) =>
  ipm $ iIntros "HAnd HQ" $
    iDestruct "HAnd" "% HP" $ \lam _ =>
    iFrame "HP" $ iExact "HQ"

\lemma proofmode_destruct_pure_rewrite {M : UCMRA}
    (Phi : Nat -> ProperUPred M) (x y : Nat) :
  ((mkProperPure (x = y)) ∗ (Phi y)) ⊢ (Phi x) =>
  ipm $ iIntros "HEq HP" $ iDestruct "HEq" "%" $ \lam eq =>
    iRewrite eq $ iExact "HP"

\func proofmode_wrapped_goal {M : UCMRA}
    (Phi : Nat -> ProperUPred M) (x : Nat) : ProperUPred M => Phi x

\lemma proofmode_destruct_pure_rewrite_explicit_family {M : UCMRA}
    (Phi : Nat -> ProperUPred M) (x y : Nat) :
  ((mkProperPure (x = y)) ∗ (Phi y)) ⊢ (proofmode_wrapped_goal Phi x) =>
  ipm $ iIntros "HEq HP" $ iDestruct "HEq" "%" $ \lam eq =>
    iRewrite eq (\lam z => proofmode_wrapped_goal Phi z) $ iExact "HP"

\func proofmode_wrapped_pure {M : UCMRA} (phi : \Prop) : ProperUPred M =>
  mkProperPure phi

\lemma proofmode_destruct_wrapped_pure {M : UCMRA}
    (P : ProperUPred M) (phi : \Prop) :
  ((proofmode_wrapped_pure phi) ∗ P) ⊢ P =>
  ipm $ iIntros "Hphi HP" $ iDestruct "Hphi" "%" $ \lam _ => iExact "HP"

\lemma proofmode_destruct_persistent {M : UCMRA} (P : ProperUPred M)
  : ((<#> P) ∗ mkProperEmp) ⊢ (P ∗ P) =>
  ipm $ iIntros "HU HE" $ iDestruct "HU" "#HP" $
    iSplitL "" (iExact "HP") (iExact "HP")

\lemma proofmode_destruct_persistent_via_rule {M : UCMRA}
    (P : ProperUPred M) (persistent : P ⊢ (<#> P)) :
  (P ∗ mkProperEmp) ⊢ (P ∗ P) =>
  ipm $ iIntros "HP HE" $
    iDestruct "HP" "#HP" persistent $
    iFrame "HP" $ iExact "HP"

\lemma proofmode_destruct_persistent_copy {M : UCMRA}
    (P : ProperUPred M) (persistent : P ⊢ (<#> P)) :
  (P ∗ mkProperEmp) ⊢ (P ∗ P) =>
  ipm $ iIntros "HP HE" $
    iDestruct "HP" "#HPersistent HCopy" persistent $
    iFrame "HCopy" $ iExact "HPersistent"

\lemma proofmode_destruct_persistent_exist {M : UCMRA}
    (Phi : Nat -> ProperUPred M) :
  ((<#> (mkProperExist Nat Phi)) ∗ mkProperEmp) ⊢
    (mkProperExist Nat Phi) =>
  ipm $ iIntros "HU HE" $ iDestruct "HU" "#HExists" $
    iDestruct "HExists" "HP" $ \lam n =>
    iExists n $ iExact "HP"

\lemma proofmode_clear {M : UCMRA} (P Q : ProperUPred M)
  : (P ∗ Q) ⊢ Q =>
  ipm $ iIntros "HP HQ" $ iClear "HP" $ iExact "HQ"

\lemma proofmode_clear_persistent {M : UCMRA} (P : ProperUPred M)
  : ((<#> P) ∗ mkProperEmp) ⊢ mkProperEmp =>
  ipm $ iIntros "HU HE" $ iDestruct "HU" "#HP" $
    iClear "HP" $ iExact "HE"

\lemma proofmode_rename {M : UCMRA} (P Q : ProperUPred M)
  : (P ∗ Q) ⊢ Q =>
  ipm $ iIntros "HP HQ" $ iRename "HQ" "HZ" $ iExact "HZ"

\lemma proofmode_rename_persistent {M : UCMRA} (P : ProperUPred M)
  : ((<#> P) ∗ mkProperEmp) ⊢ (P ∗ P) =>
  ipm $ iIntros "HU HE" $ iDestruct "HU" "#HP" $
    iRename "HP" "HQ" $ iFrame "HQ" $ iExact "HQ"

\lemma proofmode_frame {M : UCMRA} (P Q : ProperUPred M)
  : (P ∗ Q) ⊢ (P ∗ Q) =>
  ipm $ iIntros "HP HQ" $ iFrame "HP" $ iExact "HQ"

\lemma proofmode_frame_auto {M : UCMRA} (P Q : ProperUPred M)
  : (P ∗ Q) ⊢ (P ∗ Q) =>
  ipm $ iIntros "HP HQ" $ iFrame

\lemma proofmode_frame_auto_composite {M : UCMRA}
    (P Q R : ProperUPred M) :
  (P ∗ ((Q ∗ R) ∗ mkProperEmp)) ⊢ (P ∗ (Q ∗ R)) =>
  ipm $ iIntros "HP HRest" $
    iDestruct "HRest" "HQR HE" $ iFrame

\lemma proofmode_frame_many {M : UCMRA}
    (P Q R : ProperUPred M) :
  (P ∗ (Q ∗ R)) ⊢ (P ∗ (Q ∗ R)) =>
  ipm $ iIntros "HP HQR" $ iDestruct "HQR" "HQ HR" $
    iFrame "HP HQ" $ iExact "HR"

\lemma proofmode_frame_auto_emp {M : UCMRA} (P : ProperUPred M)
  : P ⊢ (P ∗ mkProperEmp) =>
  ipm $ iIntros "HP" $ iFrame

\lemma proofmode_intros_many {M : UCMRA}
    (P Q R : ProperUPred M) :
  (P ∗ (Q ∗ R)) ⊢ (P ∗ (Q ∗ R)) =>
  ipm $ iIntros "HP HQ HR" $ iFrame

\lemma proofmode_destruct_many {M : UCMRA}
    (P Q R S : ProperUPred M) :
  ((P ∗ (Q ∗ R)) ∗ S) ⊢ (P ∗ (Q ∗ (R ∗ S))) =>
  ipm $ iIntros "HAll HS" $
    iDestruct "HAll" "HP HQ HR" $ iFrame

\lemma proofmode_frame_persistent {M : UCMRA} (P : ProperUPred M)
  : ((<#> P) ∗ mkProperEmp) ⊢ (P ∗ P) =>
  ipm $ iIntros "HU HE" $ iDestruct "HU" "#HP" $
    iFrame "HP" $ iExact "HP"

\lemma proofmode_frame_auto_persistent {M : UCMRA} (P : ProperUPred M)
  : ((<#> P) ∗ mkProperEmp) ⊢ (P ∗ P) =>
  ipm $ iIntros "HU HE" $ iDestruct "HU" "#HP" $ iFrame

\lemma proofmode_left {M : UCMRA} (P Q : ProperUPred M)
  : (P ∗ mkProperEmp) ⊢ (P ∨ Q) =>
  ipm $ iIntros "HP HE" $ iLeft $ iExact "HP"

\lemma proofmode_right {M : UCMRA} (P Q : ProperUPred M)
  : (Q ∗ mkProperEmp) ⊢ (P ∨ Q) =>
  ipm $ iIntros "HQ HE" $ iRight $ iExact "HQ"

\lemma proofmode_exists {M : UCMRA} (P : ProperUPred M)
  : (P ∗ mkProperEmp) ⊢ (mkProperExist Nat (\lam _ => P)) =>
  ipm $ iIntros "HP HE" $ iExists 0 $ iExact "HP"

\lemma proofmode_pure_intro {M : UCMRA} (P : ProperUPred M)
    (phi : \Prop) (h : phi)
  : P ⊢ mkProperPure phi => ipm $ iPureIntro $ h

\lemma proofmode_assumption {M : UCMRA} (P Q : ProperUPred M)
  : (P ∗ Q) ⊢ P => ipm $ iIntros "HP HQ" $ iAssumption

\lemma proofmode_apply {M : UCMRA} (P Q : ProperUPred M)
  : ((P -∗ Q) ∗ P) ⊢ Q =>
  ipm $ iIntros "HW HP" $ iApply "HW" $ iExact "HP"

\lemma proofmode_apply_intuitionistic_reuse {M : UCMRA}
    (P Q : ProperUPred M) :
  ((<#> (P -∗ Q)) ∗ (P ∗ P)) ⊢ (Q ∗ Q) =>
  ipm $ iIntros "HPersistent HPP" $
    iDestruct "HPersistent" "#HW" $
    iDestruct "HPP" "HP1 HP2" $
    iSplitL "HP1"
      (iApply "HW" $ iExact "HP1")
      (iApply "HW" $ iExact "HP2")

\lemma proofmode_specialize {M : UCMRA} (P Q R : ProperUPred M)
  : (((P -∗ Q) ∗ P) ∗ R) ⊢ (Q ∗ R) =>
  ipm $ iIntros "HPAIR HR" $ iDestruct "HPAIR" "HW HP" $
    iSpecialize "HW" "HP" "HQ" $ iFrame "HQ" $ iExact "HR"

\lemma proofmode_specialize_intuitionistic_reuse {M : UCMRA}
    (P Q : ProperUPred M) :
  ((<#> (P -∗ Q)) ∗ (P ∗ P)) ⊢ (Q ∗ Q) =>
  ipm $ iIntros "HPersistent HPP" $
    iDestruct "HPersistent" "#HW" $
    iDestruct "HPP" "HP1 HP2" $
    iSpecialize "HW" "HP1" "HQ1" $
    iSpecialize "HW" "HP2" "HQ2" $
    iFrame "HQ1" $ iExact "HQ2"

\lemma proofmode_rewrite {M : UCMRA} (P Q : ProperUPred M)
  : ((mkProperInternalEq {M} {UPredOFE M} P Q) ∗ Q) ⊢ P =>
  ipm $ iIntros "HEq HQ" $ iRewrite "HEq" $ iExact "HQ"

\lemma proofmode_rewrite_persistent {M : UCMRA}
    (P Q : ProperUPred M) :
  ((<#> (mkProperInternalEq {M} {UPredOFE M} P Q)) ∗ (Q ∗ Q)) ⊢
    (P ∗ P) =>
  ipm $ iIntros "HU HQQ" $ iDestruct "HU" "#HEq" $
    iDestruct "HQQ" "HQ1 HQ2" $
    iSplitL "HQ1"
      (iRewrite "HEq" $ iExact "HQ1")
      (iRewrite "HEq" $ iExact "HQ2")

\lemma proofmode_next {M : UCMRA} (P : ProperUPred M)
  : (P ∗ mkProperEmp) ⊢ (|> P) =>
  ipm $ iIntros "HP HE" $ iNext $ iExact "HP"

\lemma proofmode_lob {M : UCMRA} (P : ProperUPred M)
  : (P ∗ mkProperEmp) ⊢ P =>
  ipm $ iIntros "HP HE" $ iLob "IH" $ iExact "HP"

\lemma proofmode_mod_intro {M : UCMRA} (P : ProperUPred M)
  : (P ∗ mkProperEmp) ⊢ (|==> P) =>
  ipm $ iIntros "HP HE" $ iModIntro $ iExact "HP"

\lemma proofmode_emp_intro {M : UCMRA} (P Q : ProperUPred M)
  : (P ∗ Q) ⊢ mkProperEmp =>
  ipm $ iEmpIntro

\func proofmode_wrapped_emp {M : UCMRA} : ProperUPred M => mkProperEmp

\lemma proofmode_emp_intro_wrapped {M : UCMRA} (P : ProperUPred M)
  : P ⊢ proofmode_wrapped_emp =>
  ipm $ iEmpIntro

\func proofmode_emp_intro_non_emp_fails {M : UCMRA} (P : ProperUPred M)
  : \Sigma =>
  fails (ipm $ iEmpIntro : P ⊢ P)

\lemma proofmode_mod {M : UCMRA} (P : ProperUPred M)
  : ((|==> P) ∗ mkProperEmp) ⊢ (|==> P) =>
  ipm $ iIntros "HU HE" $ iMod "HU" "HP" $
    iModIntro $ iExact "HP"

\lemma proofmode_fupd_mod {S : gFunctors} (W : wsatGS S)
    (E1 E2 : coPset) (P : iProp S)
  : ((mkProperFUpd W E1 E2 P) ∗ mkProperEmp) ⊢
      (mkProperFUpd W E1 E2 P) =>
  ipm $ iIntros "HU HE" $ iMod "HU" "HP" $
    wp_apply (fupd_intro W E2 P) $ iExact "HP"

\func proofmode_fupd_mod_mask_mismatch_fails {S : gFunctors}
    (W : wsatGS S) (E1 E2 E3 : coPset) (P : iProp S) : \Sigma =>
  fails
    (ipm $ iIntros "HU HE" $ iMod "HU" "HP" $
      wp_apply (fupd_intro W E2 P) $ iExact "HP" :
      ((mkProperFUpd W E1 E2 P) ∗ mkProperEmp) ⊢
        (mkProperFUpd W E1 E3 P))

\lemma proofmode_split_l {M : UCMRA} (P Q R : ProperUPred M)
  : (P ∗ (Q ∗ R)) ⊢ ((P ∗ R) ∗ Q) =>
  ipm $ iIntros "HP HQR" $ iDestruct "HQR" "HQ HR" $
    iSplitL "HP HR" (iFrame "HP" $ iExact "HR") (iExact "HQ")

\lemma proofmode_split_r {M : UCMRA} (P Q R : ProperUPred M)
  : (P ∗ (Q ∗ R)) ⊢ ((P ∗ R) ∗ Q) =>
  ipm $ iIntros "HP HQR" $ iDestruct "HQR" "HQ HR" $
    iSplitR "HQ" (iFrame "HP" $ iExact "HR") (iExact "HQ")

\lemma proofmode_split_and {M : UCMRA} (P Q : ProperUPred M)
  : (P ∗ Q) ⊢ mkProperAnd P Q =>
  ipm $ iIntros "HP HQ" $
    iSplitL "" (iExact "HP") (iExact "HQ")

\func proofmode_wrapped_and {M : UCMRA}
    (P Q : ProperUPred M) : ProperUPred M => mkProperAnd P Q

\lemma proofmode_split_wrapped_and {M : UCMRA} (P Q : ProperUPred M)
  : (P ∗ Q) ⊢ proofmode_wrapped_and P Q =>
  ipm $ iIntros "HP HQ" $
    iSplitL "" (iExact "HP") (iExact "HQ")

\func proofmode_wrapped_sep {M : UCMRA}
    (P Q : ProperUPred M) : ProperUPred M => P ∗ Q

\lemma proofmode_intros_many_wrapped {M : UCMRA}
    (P Q R : ProperUPred M) :
  (P ∗ proofmode_wrapped_sep Q R) ⊢ (P ∗ (Q ∗ R)) =>
  ipm $ iIntros "HP HQ HR" $ iFrame

\lemma proofmode_destruct_wrapped_sep {M : UCMRA}
    (P Q R : ProperUPred M) :
  ((proofmode_wrapped_sep P Q) ∗ R) ⊢ (Q ∗ R) =>
  ipm $ iIntros "HPair HR" $ iDestruct "HPair" "HP HQ" $
    iFrame "HQ" $ iExact "HR"

\lemma proofmode_split_wrapped_sep {M : UCMRA} (P Q : ProperUPred M)
  : (P ∗ Q) ⊢ proofmode_wrapped_sep P Q =>
  ipm $ iIntros "HP HQ" $
    iSplitL "HP" (iExact "HP") (iExact "HQ")

\lemma proofmode_split_wrapped_sep_empty_left {M : UCMRA}
    (P Q : ProperUPred M) :
  (P ∗ Q) ⊢ proofmode_wrapped_sep mkProperEmp (P ∗ Q) =>
  ipm $ iIntros "HP HQ" $
    iSplitL "" iEmpIntro (iFrame "HP" $ iExact "HQ")

\lemma proofmode_frame_wrapped_sep {M : UCMRA} (P Q : ProperUPred M)
  : (P ∗ Q) ⊢ proofmode_wrapped_sep P Q =>
  ipm $ iIntros "HP HQ" $ iFrame "HP" $ iExact "HQ"

\func proofmode_wrapped_prop {M : UCMRA}
    (P : ProperUPred M) : ProperUPred M => P

\lemma proofmode_apply_wrapped_destination {M : UCMRA}
    (P : ProperUPred M) : (P ∗ mkProperEmp) ⊢ proofmode_wrapped_prop P =>
  ipm $ iIntros "HP HE" $
    wp_apply (properUPred_ent_refl P) $ iExact "HP"

\lemma proofmode_assert {M : UCMRA} (P Q : ProperUPred M)
  : (P ∗ Q) ⊢ (P ∗ Q) =>
  ipm $ iIntros "HP HQ" $
    iAssert "HR" "HP" P (iExact "HP") (iFrame "HR" $ iExact "HQ")

\lemma proofmode_pose_proof {M : UCMRA} (P Q : ProperUPred M)
  : (P ∗ Q) ⊢ (P ∗ Q) =>
  ipm $ iIntros "HP HQ" $
    iPoseProof "HR" "HP" P (iExact "HP") (iFrame "HR" $ iExact "HQ")

\lemma proofmode_wp_value {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (v : Value) (Phi : Value -> iProp S)
  : ((Phi v) ∗ mkProperEmp) ⊢ (wp H E (Val v) Phi) =>
  ipm $ iIntros "HP HE" $ wp_value $ iExact "HP"

\lemma proofmode_wp_if_true {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (t f : Expr)
    (Phi : Value -> iProp S)
  : ((wp H E t Phi) ∗ mkProperEmp) ⊢
      (wp H E (If (Val (boolV true)) t f) Phi) =>
  ipm $ iIntros "HP HE" $ wp_if $ iExact "HP"

\lemma proofmode_wp_if_false {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (t f : Expr)
    (Phi : Value -> iProp S)
  : ((wp H E f Phi) ∗ mkProperEmp) ⊢
      (wp H E (If (Val (boolV false)) t f) Phi) =>
  ipm $ iIntros "HP HE" $ wp_if $ iExact "HP"

\lemma proofmode_wp_apply {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (t f : Expr)
    (Phi : Value -> iProp S)
  : ((wp H E t Phi) ∗ mkProperEmp) ⊢
      (wp H E (If (Val (boolV true)) t f) Phi) =>
  ipm $ iIntros "HP HE" $
    wp_apply (wp_if_true H E t f Phi) $ iExact "HP"

\lemma proofmode_eval {M : UCMRA} (P Q : ProperUPred M)
    (rule : P ⊢ Q) : (P ∗ mkProperEmp) ⊢ Q =>
  ipm $ iIntros "HP HE" $ iEval rule $ iExact "HP"

\lemma proofmode_wp_smart_apply {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (v : Value)
    (Phi Psi : Value -> iProp S)
    (post : \Pi (result : Value) -> (Phi result) ⊢ (Psi result)) :
  ((Phi v) ∗ mkProperEmp) ⊢ (wp H E (Val v) Psi) =>
  ipm $ iIntros "HP HE" $
    wp_smart_apply (wp_value_intro H E v Phi) post $ iExact "HP"

\lemma proofmode_wp_bind_smart_apply {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (vf : Value) (e : Expr)
    (P : iProp S) (Phi Psi : Value -> iProp S)
    (rule : P ⊢ wp H E e Phi)
    (post : \Pi (v : Value) -> (Phi v) ⊢
      wp H E (App (Val vf) (Val v)) Psi) :
  (P ∗ mkProperEmp) ⊢ (wp H E (App (Val vf) e) Psi) =>
  ipm $ iIntros "HP HE" $
    wp_smart_apply rule post $ iExact "HP"

\lemma proofmode_wp_let_smart_apply {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (x : Name) (rhs body : Expr)
    (P : iProp S) (Phi Psi : Value -> iProp S)
    (rule : P ⊢ wp H E rhs Phi)
    (post : \Pi (v : Value) -> (Phi v) ⊢
      wp H E (subst x v body) Psi) :
  (P ∗ mkProperEmp) ⊢ (wp H E (App (Lam x body) rhs) Psi) =>
  ipm $ iIntros "HP HE" $
    wp_smart_apply rule post $ iExact "HP"

\func proofmode_wrapped_wp {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e : Expr)
    (Phi : Value -> iProp S) : iProp S => wp H E e Phi

\lemma proofmode_wp_smart_apply_wrapped {cnt : Countable Loc}
    {S : gFunctors} (H : irisGS cnt S) (E : coPset) (e : Expr)
    (P : iProp S) (Phi Psi : Value -> iProp S)
    (rule : P ⊢ wp H E e Phi)
    (post : \Pi (v : Value) -> (Phi v) ⊢ (Psi v)) :
  (P ∗ mkProperEmp) ⊢ proofmode_wrapped_wp H E e Psi =>
  ipm $ iIntros "HP HE" $
    wp_smart_apply rule post $ iExact "HP"

\lemma proofmode_wp_bind_app_left {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e1 e2 : Expr)
    (Phi : Value -> iProp S)
  : ((wp H E e1 (\lam v => wp H E (App (Val v) e2) Phi)) ∗
      mkProperEmp) ⊢ (wp H E (App e1 e2) Phi) =>
  ipm $ iIntros "HP HE" $ wp_bind $ iExact "HP"

\lemma proofmode_wp_bind_app_right {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (vf : Value) (e : Expr)
    (Phi : Value -> iProp S)
  : ((wp H E e (\lam v => wp H E (App (Val vf) (Val v)) Phi)) ∗
      mkProperEmp) ⊢ (wp H E (App (Val vf) e) Phi) =>
  ipm $ iIntros "HP HE" $ wp_bind $ iExact "HP"

\lemma proofmode_wp_pures_value {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (Phi : Value -> iProp S)
  : ((Phi unitV) ∗ mkProperEmp) ⊢
      (wp H E
        (App (Val (LamV 0 (Val unitV))) (Val unitV)) Phi) =>
  ipm $ iIntros "HP HE" $ wp_pures $ iExact "HP"

\lemma proofmode_wp_pures_loc_add {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (l i : Nat)
    (Phi : Value -> iProp S)
  : ((Phi (LitV (LitLoc (l Nat.+ i)))) ∗ mkProperEmp) ⊢
      (wp H E (LocAdd (Val (LitV (LitLoc l))) (Val (natV i))) Phi) =>
  ipm $ iIntros "HP HE" $ wp_pures $ iExact "HP"

\lemma proofmode_wp_fork_rule {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (body : Expr)
    (Phi : Value -> iProp S)
  : (((Phi unitV) ∗ (wp H coPset_universe body H.iris_fork_post)) ∗
      mkProperEmp) ⊢ (wp H E (Fork body) Phi) =>
  ipm $ iIntros "HR HE" $
    iris.proofmode.Meta.wp_fork (wp_fork H E body Phi)
      (\lam v => properUPred_ent_refl (Phi v)) $ iExact "HR"

\lemma proofmode_inv {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (N : Namespace) (P : iProp S)
    (Phi : Value -> iProp S) (hNE : coPSubset (nclose N) E)
    (opened :
      (mkProperEmp ∗
        ((mkProperEmp ∗ (|> P)) ∗
          ((|> P) -∗
            (mkProperFUpd H.iris_wsat
              (coPset_difference E (nclose N)) E mkProperEmp)))) ⊢
      (wp H (coPset_difference E (nclose N)) NewProph
        (\lam v => mkProperFUpd H.iris_wsat
          (coPset_difference E (nclose N)) E (Phi v))))
  : (iris.base_logic.lib.invariants.inv H.iris_wsat N P) ⊢
      (wp H E NewProph Phi) =>
  ipm $ iInv "" "HP Hclose" hNE new_proph_strongly_atomic $
    iStopProof opened

\func proofmode_lookup_smoke {M : UCMRA} (P Q : ProperUPred M) :
    pm_lookup (72 :: nil) (pm_snoc (pm_snoc pm_empty (80 :: nil) P)
      (72 :: nil) Q) = just Q => idp

\func proofmode_delete_smoke {M : UCMRA} (P Q : ProperUPred M) :
    pm_delete (72 :: nil) (pm_snoc (pm_snoc pm_empty (80 :: nil) P)
      (72 :: nil) Q) = pm_snoc pm_empty (80 :: nil) P => idp

\func proofmode_duplicate_insert_fails {M : UCMRA} (P Q : ProperUPred M) :
    pm_insert (80 :: nil) Q (pm_snoc pm_empty (80 :: nil) P) = nothing => idp

\func proofmode_missing_name_fails {M : UCMRA} (P : ProperUPred M)
  : \Sigma => fails (ipm $ iExact "missing" : P ⊢ P)

\func proofmode_duplicate_intro_fails {M : UCMRA} (P Q : ProperUPred M)
  : \Sigma => fails (ipm $ iIntros "H H" $ iExact "H" : (P ∗ Q) ⊢ P)

\func proofmode_duplicate_persistent_rename_fails {M : UCMRA}
    (P Q : ProperUPred M) : \Sigma =>
  fails (ipm $ iIntros "HU HRest" $
    iDestruct "HU" "#HP" $ iDestruct "HRest" "#HQ" $
    iRename "HP" "HQ" $ iExact "HQ" :
      ((<#> P) ∗ ((<#> Q) ∗ mkProperEmp)) ⊢ Q)

\func proofmode_intro_without_goal_fails {M : UCMRA}
    (P Q : ProperUPred M) : \Sigma =>
  fails (ipm $ wp_apply (properUPred_ent_refl (P ∗ Q)) $
    iIntros "HP HQ" $ iExact "HP" : (P ∗ Q) ⊢ P)

\func proofmode_specialize_mismatch_fails {M : UCMRA}
    (P Q R : ProperUPred M) : \Sigma =>
  fails (ipm $ iIntros "HW HR" $
    iSpecialize "HW" "HR" "HQ" $ iExact "HQ" : ((P -∗ Q) ∗ R) ⊢ Q)

\func proofmode_specialize_intuitionistic_overwrite_fails {M : UCMRA}
    (P Q : ProperUPred M) : \Sigma =>
  fails (ipm $ iIntros "HPersistent HP" $
    iDestruct "HPersistent" "#HW" $
    iSpecialize "HW" "HP" "HW" $ iExact "HW" :
      ((<#> (P -∗ Q)) ∗ P) ⊢ Q)
