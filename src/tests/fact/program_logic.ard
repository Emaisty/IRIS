    | StoreS _ _ _ _ p1 _ _ => \case p1 \with {}
    | IsZeroZeroS p1 _ _ => \case p1 \with {}
    | IsZeroPosS _ p1 _ _ => \case p1 \with {}
    | PredS _ p1 _ _ => \case p1 \with {}
  | MulS _ _ p1 _ _ => \case p1 \with {}
  | ForkS _ p1 _ _ => \case p1 \with {}
  }

