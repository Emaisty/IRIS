-- The exclusive token used by the Rocq spawn/join library.  It remains a
-- separate functor requirement, since heap state and counter ghost state can
-- be shared by clients that do not use fork/join.
\func spawnR : CMRA.{0} => ExclCMRA (DiscreteOFE Nat)
\func spawnRF : RFunctor => constRF spawnR
\func spawnRF_contractive : RFunctorContractive spawnRF =>
  constRF_contractive spawnR
\func spawn_gFunctor : gFunctor =>
  mkGFunctor spawnRF spawnRF_contractive
\func spawnSigma : gFunctors => gFunctors_singleton spawn_gFunctor

\record spawnG (S : gFunctors)
  | spawn_tokG : inG S (ExclCMRA (DiscreteOFE Nat))

\func subG_spawnG {S : gFunctors} (h : subG spawnSigma S) : spawnG S \cowith
  | spawn_tokG => transport (\lam Z => inG S Z)
      (rFunctor_apply_constRF spawnR (iPropCOFE S)) (subG_inG h)

\func spawn_token_elem : (ExclCMRA (DiscreteOFE Nat)).E => excl 0

\func spawn_tok {S : gFunctors} (SG : spawnG S) (gam : gname) : iProp S =>
  own SG.spawn_tokG gam spawn_token_elem

\lemma spawn_tok_alloc {S : gFunctors} (SG : spawnG S) :
  properUPred_ent mkProperEmp
    (mkProperBUpd (mkProperExist gname (spawn_tok SG))) =>
  own_alloc SG.spawn_tokG spawn_token_elem ()

\func spawn_token_op_invalidN (n : Nat)
    (invalid : (ExclCMRA (DiscreteOFE Nat)).validN n
      ((ExclCMRA (DiscreteOFE Nat)).op
        spawn_token_elem spawn_token_elem)) : Empty =>
  invalid

\lemma spawn_tok_exclusive {S : gFunctors} (SG : spawnG S)
    (gam : gname) (Target : iProp S) :
  properUPred_ent (mkProperSep (spawn_tok SG gam) (spawn_tok SG gam))
    Target =>
  properUPred_ent_trans
    (mkProperSep (spawn_tok SG gam) (spawn_tok SG gam))
    (mkProperValidOf {iResUR S} {ExclCMRA (DiscreteOFE Nat)}
      ((ExclCMRA (DiscreteOFE Nat)).op
        spawn_token_elem spawn_token_elem)) Target
    (own_op_valid SG.spawn_tokG gam spawn_token_elem spawn_token_elem)
    (\lam n _ _ invalid => \case spawn_token_op_invalidN n invalid \with {})

\func spawnN : Namespace => ndot nroot (xO (xO xH))

\func spawn_pendingV : Value => PairV (boolV false) unitV
\func spawn_doneV (v : Value) : Value => PairV (boolV true) v

\func spawn_state {S : gFunctors} (SG : spawnG S) (gam : gname)
    (Psi : Value -> iProp S) (lv : Value) : iProp S =>
  mkProperOr
    (mkProperPure (lv = spawn_pendingV))
    (mkProperExist Value (\lam v =>
      mkProperSep (mkProperPure (lv = spawn_doneV v))
        (mkProperOr (Psi v) (spawn_tok SG gam))))

\func spawn_inv {S : gFunctors} (H : irisGS natCountable S)
    (SG : spawnG S) (gam : gname) (l : Loc)
    (Psi : Value -> iProp S) : iProp S =>
  mkProperExist Value (\lam lv =>
    mkProperSep (pointsto_full H.iris_gen_heap l lv)
      (spawn_state SG gam Psi lv))

\func join_handle {S : gFunctors} (H : irisGS natCountable S)
    (SG : spawnG S) (l : Loc) (Psi : Value -> iProp S) : iProp S =>
  mkProperExist gname (\lam gam =>
    mkProperSep (spawn_tok SG gam)
      (iris.base_logic.lib.invariants.inv H.iris_wsat spawnN
        (spawn_inv H SG gam l Psi)))

-- `irisGS` deliberately leaves the fork postcondition abstract.  Heap-lang's
-- usual instance chooses a trivially inhabited post; this explicit premise
-- is the exact condition needed by the generic spawn proof and by adequacy.
\func ForkPostInhabited {S : gFunctors} (H : irisGS natCountable S) : \Type =>
  \Pi (v : Value) -> properUPred_ent mkProperEmp (H.iris_fork_post v)

\lemma spawn_inv_initial {S : gFunctors} (H : irisGS natCountable S)
    (SG : spawnG S) (gam : gname) (l : Loc) (Psi : Value -> iProp S) :
  properUPred_ent (pointsto_full H.iris_gen_heap l spawn_pendingV)
    (spawn_inv H SG gam l Psi) =>
  properUPred_ent_trans
    (pointsto_full H.iris_gen_heap l spawn_pendingV)
    (mkProperSep (pointsto_full H.iris_gen_heap l spawn_pendingV)
      (mkProperPure {iResUR S} (spawn_pendingV = spawn_pendingV)))
    (spawn_inv H SG gam l Psi)
    (properUPred_ent_trans
      (pointsto_full H.iris_gen_heap l spawn_pendingV)
      (mkProperSep
        (mkProperPure (spawn_pendingV = spawn_pendingV))
        (pointsto_full H.iris_gen_heap l spawn_pendingV))
      (mkProperSep (pointsto_full H.iris_gen_heap l spawn_pendingV)
        (mkProperPure (spawn_pendingV = spawn_pendingV)))
      (pure_intro_sep_ent (spawn_pendingV = spawn_pendingV) idp
        (pointsto_full H.iris_gen_heap l spawn_pendingV))
      (sep_comm_ent (mkProperPure (spawn_pendingV = spawn_pendingV))
        (pointsto_full H.iris_gen_heap l spawn_pendingV)))
    (properUPred_ent_trans
      (mkProperSep (pointsto_full H.iris_gen_heap l spawn_pendingV)
        (mkProperPure {iResUR S} (spawn_pendingV = spawn_pendingV)))
      (mkProperSep (pointsto_full H.iris_gen_heap l spawn_pendingV)
        (spawn_state SG gam Psi spawn_pendingV))
      (spawn_inv H SG gam l Psi)
      (sep_mono_r_ent (pointsto_full H.iris_gen_heap l spawn_pendingV)
        (mkProperPure (spawn_pendingV = spawn_pendingV))
        (spawn_state SG gam Psi spawn_pendingV)
        (or_intro_l_ent
          (mkProperPure (spawn_pendingV = spawn_pendingV))
          (mkProperExist Value (\lam v =>
            mkProperSep
              (mkProperPure (spawn_pendingV = spawn_doneV v))
              (mkProperOr (Psi v) (spawn_tok SG gam))))))
      (exist_intro_ent (\lam lv =>
        mkProperSep (pointsto_full H.iris_gen_heap l lv)
          (spawn_state SG gam Psi lv)) spawn_pendingV))

\lemma spawn_inv_done {S : gFunctors} (H : irisGS natCountable S)
    (SG : spawnG S) (gam : gname) (l : Loc) (Psi : Value -> iProp S)
    (v : Value) :
  properUPred_ent
    (mkProperSep (pointsto_full H.iris_gen_heap l (spawn_doneV v))
      (Psi v))
    (spawn_inv H SG gam l Psi) =>
  \let
    | Point => pointsto_full H.iris_gen_heap l (spawn_doneV v)
    | Eq => mkProperPure {iResUR S} (spawn_doneV v = spawn_doneV v)
    | Payload => mkProperOr (Psi v) (spawn_tok SG gam)
    | State => spawn_state SG gam Psi (spawn_doneV v)
  \in properUPred_ent_trans (mkProperSep Point (Psi v))
      (mkProperSep Point (mkProperSep Eq Payload))
      (spawn_inv H SG gam l Psi)
      (sep_mono_r_ent Point (Psi v) (mkProperSep Eq Payload)
        (properUPred_ent_trans (Psi v)
          (mkProperSep Eq (Psi v)) (mkProperSep Eq Payload)
          (pure_intro_sep_ent (spawn_doneV v = spawn_doneV v) idp (Psi v))
          (sep_mono_r_ent Eq (Psi v) Payload
            (or_intro_l_ent (Psi v) (spawn_tok SG gam)))))
      (properUPred_ent_trans (mkProperSep Point (mkProperSep Eq Payload))
        (mkProperSep Point State) (spawn_inv H SG gam l Psi)
        (sep_mono_r_ent Point (mkProperSep Eq Payload) State
          (properUPred_ent_trans (mkProperSep Eq Payload)
            (mkProperExist Value (\lam w =>
              mkProperSep
                (mkProperPure (spawn_doneV v = spawn_doneV w))
                (mkProperOr (Psi w) (spawn_tok SG gam)))) State
            (exist_intro_ent (\lam w =>
              mkProperSep
                (mkProperPure (spawn_doneV v = spawn_doneV w))
                (mkProperOr (Psi w) (spawn_tok SG gam))) v)
            (or_intro_r_ent
              (mkProperPure (spawn_doneV v = spawn_pendingV))
              (mkProperExist Value (\lam w =>
                mkProperSep
                  (mkProperPure (spawn_doneV v = spawn_doneV w))
                  (mkProperOr (Psi w) (spawn_tok SG gam)))))))
        (exist_intro_ent (\lam lv =>
          mkProperSep (pointsto_full H.iris_gen_heap l lv)
            (spawn_state SG gam Psi lv)) (spawn_doneV v)))

-- The joiner consumes its exclusive token when it observes completion.  The
-- token is put back into the invariant, leaving the result postcondition to
-- the caller.  This is the second payload branch of the Rocq spawn protocol.
\lemma spawn_inv_done_token {S : gFunctors} (H : irisGS natCountable S)
    (SG : spawnG S) (gam : gname) (l : Loc) (Psi : Value -> iProp S)
    (v : Value) :
  properUPred_ent
    (mkProperSep (pointsto_full H.iris_gen_heap l (spawn_doneV v))
      (spawn_tok SG gam))
    (spawn_inv H SG gam l Psi) =>
  \let
    | Point => pointsto_full H.iris_gen_heap l (spawn_doneV v)
    | Eq => mkProperPure {iResUR S} (spawn_doneV v = spawn_doneV v)
    | Payload => mkProperOr (Psi v) (spawn_tok SG gam)
    | State => spawn_state SG gam Psi (spawn_doneV v)
  \in properUPred_ent_trans (mkProperSep Point (spawn_tok SG gam))
      (mkProperSep Point (mkProperSep Eq Payload))
      (spawn_inv H SG gam l Psi)
      (sep_mono_r_ent Point (spawn_tok SG gam) (mkProperSep Eq Payload)
        (properUPred_ent_trans (spawn_tok SG gam)
          (mkProperSep Eq (spawn_tok SG gam)) (mkProperSep Eq Payload)
          (pure_intro_sep_ent (spawn_doneV v = spawn_doneV v) idp
            (spawn_tok SG gam))
          (sep_mono_r_ent Eq (spawn_tok SG gam) Payload
            (or_intro_r_ent (Psi v) (spawn_tok SG gam)))))
      (properUPred_ent_trans (mkProperSep Point (mkProperSep Eq Payload))
        (mkProperSep Point State) (spawn_inv H SG gam l Psi)
        (sep_mono_r_ent Point (mkProperSep Eq Payload) State
          (properUPred_ent_trans (mkProperSep Eq Payload)
            (mkProperExist Value (\lam w =>
              mkProperSep
                (mkProperPure (spawn_doneV v = spawn_doneV w))
                (mkProperOr (Psi w) (spawn_tok SG gam)))) State
            (exist_intro_ent (\lam w =>
              mkProperSep
                (mkProperPure (spawn_doneV v = spawn_doneV w))
                (mkProperOr (Psi w) (spawn_tok SG gam))) v)
            (or_intro_r_ent
              (mkProperPure (spawn_doneV v = spawn_pendingV))
              (mkProperExist Value (\lam w =>
                mkProperSep
                  (mkProperPure (spawn_doneV v = spawn_doneV w))
                  (mkProperOr (Psi w) (spawn_tok SG gam)))))))
        (exist_intro_ent (\lam lv =>
          mkProperSep (pointsto_full H.iris_gen_heap l lv)
            (spawn_state SG gam Psi lv)) (spawn_doneV v)))

\lemma spawn_store_close {S : gFunctors} (H : irisGS natCountable S)
    (SG : spawnG S) (FPI : ForkPostInhabited H)
    (gam : gname) (l : Loc) (Psi : Value -> iProp S)
    (old v returned : Value) :
  \let
    | Body => spawn_inv H SG gam l Psi
    | D => coPset_difference coPset_universe (nclose spawnN)
    | Close => mkProperWand (mkProperLater Body)
        (mkProperFUpd H.iris_wsat D coPset_universe mkProperEmp)
    | StorePost => mkProperAnd
        (mkProperPure {iResUR S} (returned = unitV))
        (pointsto_full H.iris_gen_heap l (spawn_doneV v))
    | Frame => mkProperSep
        (mkProperSep (mkProperLater (spawn_state SG gam Psi old)) Close)
        (Psi v)
  \in properUPred_ent (mkProperSep StorePost Frame)
      (mkProperFUpd H.iris_wsat D coPset_universe
        (H.iris_fork_post returned)) =>
  \let
    | Body => spawn_inv H SG gam l Psi
    | D => coPset_difference coPset_universe (nclose spawnN)
    | Close => mkProperWand (mkProperLater Body)
        (mkProperFUpd H.iris_wsat D coPset_universe mkProperEmp)
    | Point => pointsto_full H.iris_gen_heap l (spawn_doneV v)
    | StorePost => mkProperAnd
        (mkProperPure {iResUR S} (returned = unitV)) Point
    | OldLater => mkProperLater (spawn_state SG gam Psi old)
    | Frame => mkProperSep (mkProperSep OldLater Close) (Psi v)
    | Ready => mkProperSep Close (mkProperSep Point (Psi v))
    | LaterBody => mkProperLater Body
    | arrange : properUPred_ent (mkProperSep StorePost Frame) Ready =>
        properUPred_ent_trans (mkProperSep StorePost Frame)
          (mkProperSep Point (mkProperSep Close (Psi v))) Ready
          (properUPred_ent_trans (mkProperSep StorePost Frame)
            (mkProperSep Point Frame)
            (mkProperSep Point (mkProperSep Close (Psi v)))
            (sep_mono_l_ent StorePost Point Frame
              (and_elim_r_ent
                (mkProperPure {iResUR S} (returned = unitV)) Point))
            (sep_mono_r_ent Point Frame (mkProperSep Close (Psi v))
              (sep_mono_l_ent (mkProperSep OldLater Close) Close (Psi v)
                (sep_elim_r_ent OldLater Close))))
          (sep_swap_ent Point Close (Psi v))
    | close : properUPred_ent Ready
        (mkProperFUpd H.iris_wsat D coPset_universe mkProperEmp) =>
        properUPred_ent_trans Ready (mkProperSep Close LaterBody)
          (mkProperFUpd H.iris_wsat D coPset_universe mkProperEmp)
          (sep_mono_r_ent Close (mkProperSep Point (Psi v)) LaterBody
            (properUPred_ent_trans (mkProperSep Point (Psi v)) Body LaterBody
              (spawn_inv_done H SG gam l Psi v)
              (proper_later_intro Body)))
          (wand_elim_ent LaterBody
            (mkProperFUpd H.iris_wsat D coPset_universe mkProperEmp))
  \in properUPred_ent_trans (mkProperSep StorePost Frame) Ready
      (mkProperFUpd H.iris_wsat D coPset_universe
        (H.iris_fork_post returned)) arrange
      (properUPred_ent_trans Ready
        (mkProperFUpd H.iris_wsat D coPset_universe mkProperEmp)
        (mkProperFUpd H.iris_wsat D coPset_universe
          (H.iris_fork_post returned)) close
        (fupd_mono H.iris_wsat D coPset_universe mkProperEmp
          (H.iris_fork_post returned) (FPI returned)))

\lemma spawn_store_child {S : gFunctors} (H : irisGS natCountable S)
    (SG : spawnG S) (FPI : ForkPostInhabited H)
    (gam : gname) (l : Loc) (Psi : Value -> iProp S) (v : Value) :
  properUPred_ent
    (mkProperSep
      (iris.base_logic.lib.invariants.inv H.iris_wsat spawnN
        (spawn_inv H SG gam l Psi)) (Psi v))
    (wp H coPset_universe
      (Store (Val (LitV (LitLoc l))) (Val (spawn_doneV v)))
      H.iris_fork_post) =>
  \let
    | Body => spawn_inv H SG gam l Psi
    | Rnow : Value -> iProp S => \lam old =>
        pointsto_full H.iris_gen_heap l old
    | Rafter : Value -> iProp S => \lam old =>
        spawn_state SG gam Psi old
    | K => Psi v
    | StoreE => Store (Val (LitV (LitLoc l))) (Val (spawn_doneV v))
    | D => coPset_difference coPset_universe (nclose spawnN)
    | perOld : \Pi (old : Value) -> properUPred_ent
        (mkProperSep
          (mkProperSep
            (mkProperSep (Rnow old) (mkProperLater (Rafter old)))
            (mkProperWand (mkProperLater Body)
              (mkProperFUpd H.iris_wsat D coPset_universe mkProperEmp))) K)
        (wp H D StoreE (\lam returned =>
          mkProperFUpd H.iris_wsat D coPset_universe
            (H.iris_fork_post returned))) => \lam old =>
        \let
          | Close => mkProperWand (mkProperLater Body)
              (mkProperFUpd H.iris_wsat D coPset_universe mkProperEmp)
          | Frame => mkProperSep
              (mkProperSep (mkProperLater (Rafter old)) Close) K
          | StorePost : Value -> iProp S => \lam returned =>
              mkProperAnd
                (mkProperPure (returned = unitV))
                (pointsto_full H.iris_gen_heap l (spawn_doneV v))
          | arrange : properUPred_ent
              (mkProperSep
                (mkProperSep
                  (mkProperSep (Rnow old) (mkProperLater (Rafter old)))
                  Close) K)
              (mkProperSep (Rnow old) Frame) =>
              properUPred_ent_trans
                (mkProperSep
                  (mkProperSep
                    (mkProperSep (Rnow old) (mkProperLater (Rafter old)))
                    Close) K)
                (mkProperSep
                  (mkProperSep (Rnow old)
                    (mkProperSep (mkProperLater (Rafter old)) Close)) K)
                (mkProperSep (Rnow old) Frame)
                (sep_mono_l_ent
                  (mkProperSep (mkProperSep (Rnow old)
                    (mkProperLater (Rafter old))) Close)
                  (mkProperSep (Rnow old)
                    (mkProperSep (mkProperLater (Rafter old)) Close)) K
                  (sep_assoc_l_ent (Rnow old)
                    (mkProperLater (Rafter old)) Close))
                (sep_assoc_l_ent (Rnow old)
                  (mkProperSep (mkProperLater (Rafter old)) Close) K)
        \in properUPred_ent_trans
            (mkProperSep
              (mkProperSep
                (mkProperSep (Rnow old) (mkProperLater (Rafter old)))
                Close) K)
            (mkProperSep (Rnow old) Frame)
            (wp H D StoreE (\lam returned =>
              mkProperFUpd H.iris_wsat D coPset_universe
                (H.iris_fork_post returned))) arrange
            (properUPred_ent_trans (mkProperSep (Rnow old) Frame)
              (mkProperSep (wp H D StoreE StorePost) Frame)
              (wp H D StoreE (\lam returned =>
                mkProperFUpd H.iris_wsat D coPset_universe
                  (H.iris_fork_post returned)))
              (sep_mono_l_ent (Rnow old) (wp H D StoreE StorePost) Frame
                (wp_store H D l old (spawn_doneV v)))
              (properUPred_ent_trans
                (mkProperSep (wp H D StoreE StorePost) Frame)
                (wp H D StoreE (wp_frame_post StorePost Frame))
                (wp H D StoreE (\lam returned =>
                  mkProperFUpd H.iris_wsat D coPset_universe
                    (H.iris_fork_post returned)))
                (wp_frame_r H D StoreE StorePost Frame)
                (wp_mono H D StoreE (wp_frame_post StorePost Frame)
                  (\lam returned => mkProperFUpd H.iris_wsat D
                    coPset_universe (H.iris_fork_post returned))
                  (\lam returned => spawn_store_close H SG FPI gam l Psi
                    old v returned))))
  \in wp_atomic_inv_acc_timeless_exist_frame H coPset_universe spawnN
      Body Rnow Rafter K StoreE H.iris_fork_post
      (\lam p _ => coPmem_universe p)
      (store_strongly_atomic l (spawn_doneV v))
      (\lam old => pointsto_full_timeless H.iris_gen_heap l old)
      (properUPred_ent_refl Body) perOld

\lemma spawn_store_pair_child {S : gFunctors}
    (H : irisGS natCountable S) (SG : spawnG S)
    (FPI : ForkPostInhabited H) (gam : gname) (l : Loc)
    (Psi : Value -> iProp S) (v : Value) :
  properUPred_ent
    (mkProperSep
      (iris.base_logic.lib.invariants.inv H.iris_wsat spawnN
        (spawn_inv H SG gam l Psi)) (Psi v))
    (wp H coPset_universe
      (Store (Val (LitV (LitLoc l)))
        (Pair (Val (boolV true)) (Val v))) H.iris_fork_post) =>
  \let
    | StoreDone => Store (Val (LitV (LitLoc l)))
        (Val (spawn_doneV v))
    | PairE => Pair (Val (boolV true)) (Val v)
    | PairPost : Value -> iProp S => \lam new =>
        wp H coPset_universe
          (Store (Val (LitV (LitLoc l))) (Val new)) H.iris_fork_post
  \in properUPred_ent_trans
      (mkProperSep
        (iris.base_logic.lib.invariants.inv H.iris_wsat spawnN
          (spawn_inv H SG gam l Psi)) (Psi v))
      (wp H coPset_universe StoreDone H.iris_fork_post)
      (wp H coPset_universe
        (Store (Val (LitV (LitLoc l))) PairE) H.iris_fork_post)
      (spawn_store_child H SG FPI gam l Psi v)
      (properUPred_ent_trans
        (wp H coPset_universe StoreDone H.iris_fork_post)
        (wp H coPset_universe (Val (spawn_doneV v)) PairPost)
        (wp H coPset_universe
          (Store (Val (LitV (LitLoc l))) PairE) H.iris_fork_post)
        (wp_value_intro H coPset_universe (spawn_doneV v) PairPost)
        (properUPred_ent_trans
          (wp H coPset_universe (Val (spawn_doneV v)) PairPost)
          (wp H coPset_universe PairE PairPost)
          (wp H coPset_universe
            (Store (Val (LitV (LitLoc l))) PairE) H.iris_fork_post)
          (wp_pair_values H coPset_universe (boolV true) v PairPost)
          (wp_bind_store_r H coPset_universe (LitV (LitLoc l))
            PairE H.iris_fork_post)))

\lemma spawn_child {S : gFunctors} (H : irisGS natCountable S)
    (SG : spawnG S) (FPI : ForkPostInhabited H)
    (gam : gname) (l : Loc) (Psi : Value -> iProp S) (f : Value) :
  properUPred_ent
    (mkProperSep
      (iris.base_logic.lib.invariants.inv H.iris_wsat spawnN
        (spawn_inv H SG gam l Psi))
      (wp H coPset_universe
        (App (Val f) (Val unitV)) Psi))
    (wp H coPset_universe
      (letE nR (App (Val f) (Val unitV))
        (Store (Val (LitV (LitLoc l)))
          (Pair (Val (boolV true)) (Var nR))))
      H.iris_fork_post) =>
  \let
    | Inv => iris.base_logic.lib.invariants.inv H.iris_wsat spawnN
        (spawn_inv H SG gam l Psi)
    | Call => App (Val f) (Val unitV)
    | StoreBody => Store (Val (LitV (LitLoc l)))
        (Pair (Val (boolV true)) (Var nR))
    | FramedPost : Value -> iProp S => \lam v => mkProperSep (Psi v) Inv
    | Continue : Value -> iProp S => \lam v =>
        wp H coPset_universe
          (Store (Val (LitV (LitLoc l)))
            (Pair (Val (boolV true)) (Val v))) H.iris_fork_post
    | framed : properUPred_ent
        (mkProperSep Inv (wp H coPset_universe Call Psi))
        (wp H coPset_universe Call FramedPost) =>
        properUPred_ent_trans
          (mkProperSep Inv (wp H coPset_universe Call Psi))
          (mkProperSep (wp H coPset_universe Call Psi) Inv)
          (wp H coPset_universe Call FramedPost)
          (sep_comm_ent Inv (wp H coPset_universe Call Psi))
          (wp_frame_r H coPset_universe Call Psi Inv)
    | next : \Pi (v : Value) -> properUPred_ent (FramedPost v)
        (Continue v) => \lam v =>
        properUPred_ent_trans (mkProperSep (Psi v) Inv)
          (mkProperSep Inv (Psi v)) (Continue v)
          (sep_comm_ent (Psi v) Inv)
          (spawn_store_pair_child H SG FPI gam l Psi v)
  \in properUPred_ent_trans
      (mkProperSep Inv (wp H coPset_universe Call Psi))
      (wp H coPset_universe Call Continue)
      (wp H coPset_universe (letE nR Call StoreBody)
        H.iris_fork_post)
      (properUPred_ent_trans
        (mkProperSep Inv (wp H coPset_universe Call Psi))
        (wp H coPset_universe Call FramedPost)
        (wp H coPset_universe Call Continue) framed
        (wp_mono H coPset_universe Call FramedPost Continue next))
      (wp_letE H coPset_universe nR Call StoreBody H.iris_fork_post)

\func spawn_post {S : gFunctors} (H : irisGS natCountable S)
    (SG : spawnG S) (Psi : Value -> iProp S) (returned : Value) : iProp S =>
  mkProperExist Loc (\lam l =>
    mkProperAnd (mkProperPure (returned = LitV (LitLoc l)))
      (join_handle H SG l Psi))

\lemma join_handle_intro {S : gFunctors} (H : irisGS natCountable S)
    (SG : spawnG S) (gam : gname) (l : Loc) (Psi : Value -> iProp S) :
  properUPred_ent
    (mkProperSep (spawn_tok SG gam)
      (iris.base_logic.lib.invariants.inv H.iris_wsat spawnN
        (spawn_inv H SG gam l Psi)))
    (join_handle H SG l Psi) =>
  exist_intro_ent (\lam name =>
    mkProperSep (spawn_tok SG name)
      (iris.base_logic.lib.invariants.inv H.iris_wsat spawnN
        (spawn_inv H SG name l Psi))) gam

\lemma spawn_post_intro {S : gFunctors} (H : irisGS natCountable S)
    (SG : spawnG S) (gam : gname) (l : Loc) (Psi : Value -> iProp S) :
  properUPred_ent
    (mkProperSep (spawn_tok SG gam)
      (iris.base_logic.lib.invariants.inv H.iris_wsat spawnN
        (spawn_inv H SG gam l Psi)))
    (spawn_post H SG Psi (LitV (LitLoc l))) =>
  \let
    | Source => mkProperSep (spawn_tok SG gam)
        (iris.base_logic.lib.invariants.inv H.iris_wsat spawnN
          (spawn_inv H SG gam l Psi))
    | Eq => mkProperPure {iResUR S}
        ((LitV (LitLoc l) : Value) = LitV (LitLoc l))
    | Handle => join_handle H SG l Psi
    | Pair => mkProperAnd Eq Handle
    | left : properUPred_ent Source Eq => \lam _ _ _ _ => idp
    | right : properUPred_ent Source Handle =>
        join_handle_intro H SG gam l Psi
  \in properUPred_ent_trans Source Pair
      (spawn_post H SG Psi (LitV (LitLoc l)))
      ((BIuPredMixin (iResUR S)).bi_mixin_and_intro Source Eq Handle left right)
      (exist_intro_ent (\lam loc => mkProperAnd
        (mkProperPure ((LitV (LitLoc l) : Value) = LitV (LitLoc loc)))
        (join_handle H SG loc Psi)) l)

\lemma spawn_parent_fork {S : gFunctors} (H : irisGS natCountable S)
    (SG : spawnG S) (FPI : ForkPostInhabited H)
    (gam : gname) (l : Loc) (Psi : Value -> iProp S) (f : Value) :
  properUPred_ent
    (mkProperSep
      (iris.base_logic.lib.invariants.inv H.iris_wsat spawnN
        (spawn_inv H SG gam l Psi))
      (mkProperSep (spawn_tok SG gam)
        (wp H coPset_universe (App (Val f) (Val unitV)) Psi)))
    (wp H coPset_universe
      (seqE
        (Fork (letE nR (App (Val f) (Val unitV))
          (Store (Val (LitV (LitLoc l)))
            (Pair (Val (boolV true)) (Var nR)))))
        (Val (LitV (LitLoc l))))
      (spawn_post H SG Psi)) =>
  \let
    | Inv => iris.base_logic.lib.invariants.inv H.iris_wsat spawnN
        (spawn_inv H SG gam l Psi)
    | Tok => spawn_tok SG gam
    | FWP => wp H coPset_universe (App (Val f) (Val unitV)) Psi
    | ChildE => letE nR (App (Val f) (Val unitV))
        (Store (Val (LitV (LitLoc l)))
          (Pair (Val (boolV true)) (Var nR)))
    | ChildPre => mkProperSep Inv FWP
    | ParentPre => mkProperSep Tok Inv
    | ParentWP => wp H coPset_universe (Val (LitV (LitLoc l)))
        (spawn_post H SG Psi)
    | ForkPost : Value -> iProp S => \lam _ => ParentWP
    | duplicated : properUPred_ent (mkProperSep Inv (mkProperSep Tok FWP))
        (mkProperSep (mkProperSep Inv (mkProperSep Tok FWP)) Inv) =>
        persistent_consequence_frame_ent
          (mkProperSep Inv (mkProperSep Tok FWP)) Inv
          (properUPred_ent_trans
            (mkProperSep Inv (mkProperSep Tok FWP)) Inv
            (mkProperPersistently Inv)
            (sep_elim_l_ent Inv (mkProperSep Tok FWP))
            (inv_persistent H.iris_wsat spawnN
              (spawn_inv H SG gam l Psi)))
    | arrange : properUPred_ent
        (mkProperSep (mkProperSep Inv (mkProperSep Tok FWP)) Inv)
        (mkProperSep ParentPre ChildPre) =>
        properUPred_ent_trans
          (mkProperSep (mkProperSep Inv (mkProperSep Tok FWP)) Inv)
          (mkProperSep Inv (mkProperSep Tok (mkProperSep Inv FWP)))
          (mkProperSep ParentPre ChildPre)
          (properUPred_ent_trans
            (mkProperSep (mkProperSep Inv (mkProperSep Tok FWP)) Inv)
            (mkProperSep Inv (mkProperSep (mkProperSep Tok FWP) Inv))
            (mkProperSep Inv (mkProperSep Tok (mkProperSep Inv FWP)))
            (sep_assoc_l_ent Inv (mkProperSep Tok FWP) Inv)
            (sep_mono_r_ent Inv (mkProperSep (mkProperSep Tok FWP) Inv)
              (mkProperSep Tok (mkProperSep Inv FWP))
              (properUPred_ent_trans
                (mkProperSep (mkProperSep Tok FWP) Inv)
                (mkProperSep Tok (mkProperSep FWP Inv))
                (mkProperSep Tok (mkProperSep Inv FWP))
                (sep_assoc_l_ent Tok FWP Inv)
                (sep_mono_r_ent Tok (mkProperSep FWP Inv)
                  (mkProperSep Inv FWP) (sep_comm_ent FWP Inv)))))
          (properUPred_ent_trans
            (mkProperSep Inv (mkProperSep Tok ChildPre))
            (mkProperSep Tok (mkProperSep Inv ChildPre))
            (mkProperSep ParentPre ChildPre)
            (sep_swap_ent Inv Tok ChildPre)
            (sep_assoc_r_ent Tok Inv ChildPre))
    | parent : properUPred_ent ParentPre ParentWP =>
        properUPred_ent_trans ParentPre
          (spawn_post H SG Psi (LitV (LitLoc l))) ParentWP
          (spawn_post_intro H SG gam l Psi)
          (wp_value_intro H coPset_universe (LitV (LitLoc l))
            (spawn_post H SG Psi))
    | child : properUPred_ent ChildPre
        (wp H coPset_universe ChildE H.iris_fork_post) =>
        spawn_child H SG FPI gam l Psi f
    | forked : properUPred_ent (mkProperSep ParentPre ChildPre)
        (wp H coPset_universe (Fork ChildE) ForkPost) =>
        properUPred_ent_trans (mkProperSep ParentPre ChildPre)
          (mkProperSep ParentWP
            (wp H coPset_universe ChildE H.iris_fork_post))
          (wp H coPset_universe (Fork ChildE) ForkPost)
          (properUPred_ent_trans (mkProperSep ParentPre ChildPre)
            (mkProperSep ParentWP ChildPre)
            (mkProperSep ParentWP
              (wp H coPset_universe ChildE H.iris_fork_post))
            (sep_mono_l_ent ParentPre ParentWP ChildPre parent)
            (sep_mono_r_ent ParentWP ChildPre
              (wp H coPset_universe ChildE H.iris_fork_post) child))
          (wp_fork H coPset_universe ChildE ForkPost)
  \in properUPred_ent_trans
      (mkProperSep Inv (mkProperSep Tok FWP))
      (mkProperSep ParentPre ChildPre)
      (wp H coPset_universe
        (seqE (Fork ChildE) (Val (LitV (LitLoc l))))
        (spawn_post H SG Psi))
      (properUPred_ent_trans
        (mkProperSep Inv (mkProperSep Tok FWP))
        (mkProperSep (mkProperSep Inv (mkProperSep Tok FWP)) Inv)
        (mkProperSep ParentPre ChildPre) duplicated arrange)
      (properUPred_ent_trans (mkProperSep ParentPre ChildPre)
        (wp H coPset_universe (Fork ChildE) ForkPost)
        (wp H coPset_universe
          (seqE (Fork ChildE) (Val (LitV (LitLoc l))))
          (spawn_post H SG Psi)) forked
        (wp_letE H coPset_universe nIgnore (Fork ChildE)
          (Val (LitV (LitLoc l))) (spawn_post H SG Psi)))

\lemma spawn_allocate_inv_run {S : gFunctors}
    (H : irisGS natCountable S) (SG : spawnG S)
    (FPI : ForkPostInhabited H) (gam : gname) (l : Loc)
    (Psi : Value -> iProp S) (f : Value) :
  properUPred_ent
    (mkProperSep (spawn_tok SG gam)
      (mkProperSep (pointsto_full H.iris_gen_heap l spawn_pendingV)
        (wp H coPset_universe (App (Val f) (Val unitV)) Psi)))
    (wp H coPset_universe
      (seqE
        (Fork (letE nR (App (Val f) (Val unitV))
          (Store (Val (LitV (LitLoc l)))
            (Pair (Val (boolV true)) (Var nR)))))
        (Val (LitV (LitLoc l))))
      (spawn_post H SG Psi)) =>
  \let
    | Tok => spawn_tok SG gam
    | Point => pointsto_full H.iris_gen_heap l spawn_pendingV
    | FWP => wp H coPset_universe (App (Val f) (Val unitV)) Psi
    | Rest => mkProperSep Tok FWP
    | Body => spawn_inv H SG gam l Psi
    | Inv => iris.base_logic.lib.invariants.inv H.iris_wsat spawnN Body
    | Program => seqE
        (Fork (letE nR (App (Val f) (Val unitV))
          (Store (Val (LitV (LitLoc l)))
            (Pair (Val (boolV true)) (Var nR)))))
        (Val (LitV (LitLoc l)))
    | Post => spawn_post H SG Psi
    | arrange : properUPred_ent (mkProperSep Tok (mkProperSep Point FWP))
        (mkProperSep Point Rest) => sep_swap_ent Tok Point FWP
    | laterBody : properUPred_ent Point (mkProperLater Body) =>
        properUPred_ent_trans Point Body (mkProperLater Body)
          (spawn_inv_initial H SG gam l Psi) (proper_later_intro Body)
    | allocate : properUPred_ent (mkProperSep Point Rest)
        (mkProperFUpd H.iris_wsat coPset_universe coPset_universe
          (mkProperSep Inv Rest)) =>
        properUPred_ent_trans (mkProperSep Point Rest)
          (mkProperSep
            (mkProperFUpd H.iris_wsat coPset_universe coPset_universe Inv)
            Rest)
          (mkProperFUpd H.iris_wsat coPset_universe coPset_universe
            (mkProperSep Inv Rest))
          (sep_mono_l_ent Point
            (mkProperFUpd H.iris_wsat coPset_universe coPset_universe Inv)
            Rest
            (properUPred_ent_trans Point (mkProperLater Body)
              (mkProperFUpd H.iris_wsat coPset_universe coPset_universe Inv)
              laterBody
              (inv_alloc H.iris_wsat spawnN coPset_universe Body)))
          (fupd_frame_r H.iris_wsat coPset_universe coPset_universe Inv Rest)
    | run : properUPred_ent (mkProperSep Inv Rest)
        (wp H coPset_universe Program Post) =>
        spawn_parent_fork H SG FPI gam l Psi f
  \in properUPred_ent_trans
      (mkProperSep Tok (mkProperSep Point FWP))
      (mkProperSep Point Rest) (wp H coPset_universe Program Post) arrange
      (properUPred_ent_trans (mkProperSep Point Rest)
        (mkProperFUpd H.iris_wsat coPset_universe coPset_universe
          (mkProperSep Inv Rest))
        (wp H coPset_universe Program Post) allocate
        (properUPred_ent_trans
          (mkProperFUpd H.iris_wsat coPset_universe coPset_universe
            (mkProperSep Inv Rest))
          (mkProperFUpd H.iris_wsat coPset_universe coPset_universe
            (wp H coPset_universe Program Post))
          (wp H coPset_universe Program Post)
          (fupd_mono H.iris_wsat coPset_universe coPset_universe
            (mkProperSep Inv Rest) (wp H coPset_universe Program Post) run)
          (fupd_wp H coPset_universe Program Post)))

\lemma spawn_token_then_run {S : gFunctors}
    (H : irisGS natCountable S) (SG : spawnG S)
    (FPI : ForkPostInhabited H) (l : Loc)
    (Psi : Value -> iProp S) (f : Value) :
  properUPred_ent
    (mkProperSep (pointsto_full H.iris_gen_heap l spawn_pendingV)
      (wp H coPset_universe (App (Val f) (Val unitV)) Psi))
    (wp H coPset_universe
      (seqE
        (Fork (letE nR (App (Val f) (Val unitV))
          (Store (Val (LitV (LitLoc l)))
            (Pair (Val (boolV true)) (Var nR)))))
        (Val (LitV (LitLoc l))))
      (spawn_post H SG Psi)) =>
  \let
    | Resources => mkProperSep
        (pointsto_full H.iris_gen_heap l spawn_pendingV)
        (wp H coPset_universe (App (Val f) (Val unitV)) Psi)
    | Toks => mkProperExist gname (spawn_tok SG)
    | Named => mkProperExist gname (\lam gam =>
        mkProperSep (spawn_tok SG gam) Resources)
    | Program => seqE
        (Fork (letE nR (App (Val f) (Val unitV))
          (Store (Val (LitV (LitLoc l)))
            (Pair (Val (boolV true)) (Var nR)))))
        (Val (LitV (LitLoc l)))
    | Post => spawn_post H SG Psi
    | allocate : properUPred_ent Resources (mkProperBUpd Named) =>
        properUPred_ent_trans Resources
          (mkProperSep (mkProperBUpd Toks) Resources)
          (mkProperBUpd Named)
          (properUPred_ent_trans Resources
            (mkProperSep mkProperEmp Resources)
            (mkProperSep (mkProperBUpd Toks) Resources)
            ((BIuPredMixin (iResUR S)).bi_mixin_emp_sep_1 Resources)
            (sep_mono_l_ent mkProperEmp (mkProperBUpd Toks) Resources
              (spawn_tok_alloc SG)))
          (properUPred_ent_trans
            (mkProperSep (mkProperBUpd Toks) Resources)
            (mkProperBUpd (mkProperSep Toks Resources))
            (mkProperBUpd Named)
            (bupd_frame_r Toks Resources)
            (bupd_mono (mkProperSep Toks Resources) Named
              (sep_exist_l_elim (spawn_tok SG) Resources Named
                (\lam gam => exist_intro_ent (\lam name =>
                  mkProperSep (spawn_tok SG name) Resources) gam))))
    | runNamed : properUPred_ent Named
        (wp H coPset_universe Program Post) =>
        exist_elim_ent (\lam gam => mkProperSep (spawn_tok SG gam) Resources)
          (wp H coPset_universe Program Post)
          (\lam gam => spawn_allocate_inv_run H SG FPI gam l Psi f)
  \in properUPred_ent_trans Resources (mkProperBUpd Named)
      (wp H coPset_universe Program Post) allocate
      (properUPred_ent_trans (mkProperBUpd Named)
        (mkProperBUpd (wp H coPset_universe Program Post))
        (wp H coPset_universe Program Post)
        (bupd_mono Named (wp H coPset_universe Program Post) runNamed)
        (wp_bupd H coPset_universe Program Post))

\lemma spawn_after_alloc {S : gFunctors} (H : irisGS natCountable S)
    (SG : spawnG S) (FPI : ForkPostInhabited H)
    (Psi : Value -> iProp S) (f returned : Value) :
  properUPred_ent
    (mkProperSep
      (mkProperExist Loc (\lam l => mkProperAnd
        (mkProperPure (returned = LitV (LitLoc l)))
        (pointsto_full H.iris_gen_heap l spawn_pendingV)))
      (wp H coPset_universe (App (Val f) (Val unitV)) Psi))
    (wp H coPset_universe
      (seqE
        (Fork (letE nR (App (Val f) (Val unitV))
          (Store (Val returned)
            (Pair (Val (boolV true)) (Var nR)))))
        (Val returned)) (spawn_post H SG Psi)) =>
  \let
    | FWP => wp H coPset_universe (App (Val f) (Val unitV)) Psi
    | Goal => wp H coPset_universe
        (seqE
          (Fork (letE nR (App (Val f) (Val unitV))
            (Store (Val returned)
              (Pair (Val (boolV true)) (Var nR)))))
          (Val returned)) (spawn_post H SG Psi)
    | perLoc : \Pi (l : Loc) -> properUPred_ent
        (mkProperSep
          (mkProperAnd
            (mkProperPure (returned = LitV (LitLoc l)))
            (pointsto_full H.iris_gen_heap l spawn_pendingV)) FWP) Goal =>
        \lam l =>
          \let
            | PairP => mkProperAnd
                (mkProperPure {iResUR S} (returned = LitV (LitLoc l)))
                (pointsto_full H.iris_gen_heap l spawn_pendingV)
            | Eq => returned = LitV (LitLoc l)
            | Rest => mkProperSep
                (pointsto_full H.iris_gen_heap l spawn_pendingV) FWP
            | retainEq : properUPred_ent (mkProperSep PairP FWP)
                (mkProperSep (mkProperPure Eq) (mkProperSep PairP FWP)) =>
                pure_consequence_frame_ent (mkProperSep PairP FWP) Eq
                  (properUPred_ent_trans (mkProperSep PairP FWP) PairP
                    (mkProperPure Eq)
                    (sep_elim_l_ent PairP FWP)
                    (and_elim_l_ent (mkProperPure Eq)
                      (pointsto_full H.iris_gen_heap l spawn_pendingV)))
            | useEq : Eq -> properUPred_ent
                (mkProperSep PairP FWP) Goal => \lam eq =>
                transport (\lam r => properUPred_ent
                  (mkProperSep PairP FWP)
                  (wp H coPset_universe
                    (seqE
                      (Fork (letE nR (App (Val f) (Val unitV))
                        (Store (Val r)
                          (Pair (Val (boolV true)) (Var nR)))))
                      (Val r)) (spawn_post H SG Psi)))
                  (inv eq)
                  (properUPred_ent_trans (mkProperSep PairP FWP) Rest
                    (wp H coPset_universe
                      (seqE
                        (Fork (letE nR (App (Val f) (Val unitV))
                          (Store (Val (LitV (LitLoc l)))
                            (Pair (Val (boolV true)) (Var nR)))))
                        (Val (LitV (LitLoc l)))) (spawn_post H SG Psi))
                    (sep_mono_l_ent PairP
                      (pointsto_full H.iris_gen_heap l spawn_pendingV) FWP
                      (and_elim_r_ent (mkProperPure Eq)
                        (pointsto_full H.iris_gen_heap l spawn_pendingV)))
                    (spawn_token_then_run H SG FPI l Psi f))
          \in properUPred_ent_trans (mkProperSep PairP FWP)
              (mkProperSep (mkProperPure Eq) (mkProperSep PairP FWP)) Goal
              retainEq (pure_sep_l_elim Eq (mkProperSep PairP FWP) Goal useEq)
  \in sep_exist_l_elim (\lam l => mkProperAnd
      (mkProperPure (returned = LitV (LitLoc l)))
      (pointsto_full H.iris_gen_heap l spawn_pendingV)) FWP Goal perLoc

\lemma spawn_spec {S : gFunctors} (H : irisGS natCountable S)
    (SG : spawnG S) (FPI : ForkPostInhabited H)
    (Psi : Value -> iProp S) (f : Value) :
  properUPred_ent
    (wp H coPset_universe (App (Val f) (Val unitV)) Psi)
    (wp H coPset_universe (App (Val spawn) (Val f))
      (spawn_post H SG Psi)) =>
  \let
    | FWP => wp H coPset_universe (App (Val f) (Val unitV)) Psi
    | AllocPost : Value -> iProp S => \lam returned =>
        mkProperExist Loc (\lam l => mkProperAnd
          (mkProperPure (returned = LitV (LitLoc l)))
          (pointsto_full H.iris_gen_heap l spawn_pendingV))
    | FramedPost : Value -> iProp S => \lam returned =>
        mkProperSep (AllocPost returned) FWP
    | Continue : Value -> iProp S => \lam returned =>
        wp H coPset_universe
          (seqE
            (Fork (letE nR (App (Val f) (Val unitV))
              (Store (Val returned)
                (Pair (Val (boolV true)) (Var nR)))))
            (Val returned)) (spawn_post H SG Psi)
    | AllocE => Alloc (Val spawn_pendingV)
    | BodyF => letE nHandle AllocE
        (seqE
          (Fork (letE nR (App (Val f) (Val unitV))
            (Store (Var nHandle)
              (Pair (Val (boolV true)) (Var nR)))))
          (Var nHandle))
    | BodyGeneric => letE nHandle
        (Alloc (Val (PairV (boolV false) unitV)))
        (seqE
          (Fork (letE nR (App (Var nThunk) (Val unitV))
            (Store (Var nHandle)
              (Pair (Val (boolV true)) (Var nR)))))
          (Var nHandle))
    | allocated : properUPred_ent FWP
        (wp H coPset_universe AllocE FramedPost) =>
        properUPred_ent_trans FWP (mkProperSep mkProperEmp FWP)
          (wp H coPset_universe AllocE FramedPost)
          ((BIuPredMixin (iResUR S)).bi_mixin_emp_sep_1 FWP)
          (properUPred_ent_trans (mkProperSep mkProperEmp FWP)
            (mkProperSep (wp H coPset_universe AllocE AllocPost) FWP)
            (wp H coPset_universe AllocE FramedPost)
            (sep_mono_l_ent mkProperEmp
              (wp H coPset_universe AllocE AllocPost) FWP
              (wp_alloc H coPset_universe spawn_pendingV))
            (wp_frame_r H coPset_universe AllocE AllocPost FWP))
    | continue : \Pi (returned : Value) -> properUPred_ent
        (FramedPost returned) (Continue returned) => \lam returned =>
        spawn_after_alloc H SG FPI Psi f returned
    | allocationBody : properUPred_ent FWP
        (wp H coPset_universe BodyF (spawn_post H SG Psi)) =>
        properUPred_ent_trans FWP
          (wp H coPset_universe AllocE Continue)
          (wp H coPset_universe BodyF (spawn_post H SG Psi))
          (properUPred_ent_trans FWP
            (wp H coPset_universe AllocE FramedPost)
            (wp H coPset_universe AllocE Continue) allocated
            (wp_mono H coPset_universe AllocE FramedPost Continue continue))
          (wp_letE H coPset_universe nHandle AllocE
            (seqE
              (Fork (letE nR (App (Val f) (Val unitV))
                (Store (Var nHandle)
                  (Pair (Val (boolV true)) (Var nR)))))
              (Var nHandle)) (spawn_post H SG Psi))
  \in properUPred_ent_trans FWP
      (wp H coPset_universe BodyF (spawn_post H SG Psi))
      (wp H coPset_universe (App (Val spawn) (Val f))
        (spawn_post H SG Psi)) allocationBody
      (wp_lam_beta H coPset_universe nThunk BodyGeneric f
        (spawn_post H SG Psi))

\func join_continue (l : Loc) (cell : Value) : Expr =>
  If (Fst (Val cell)) (Snd (Val cell))
    (App (Val join) (Val (LitV (LitLoc l))))

\func join_loop (l : Loc) : Expr =>
  letE nCell (Load (Val (LitV (LitLoc l))))
    (If (Fst (Var nCell)) (Snd (Var nCell))
      (App (Val join) (Val (LitV (LitLoc l)))))

\lemma join_pending_continue {S : gFunctors}
    (H : irisGS natCountable S) (E : coPset) (l : Loc)
    (Psi : Value -> iProp S) :
  properUPred_ent
    (wp H E (App (Val join) (Val (LitV (LitLoc l)))) Psi)
    (wp H E (join_continue l spawn_pendingV) Psi) =>
  \let
    | Then => Snd (Val spawn_pendingV)
    | Else => App (Val join) (Val (LitV (LitLoc l)))
    | CondPost : Value -> iProp S => \lam b =>
        wp H E (If (Val b) Then Else) Psi
    | falseIf : properUPred_ent (wp H E Else Psi)
        (wp H E (If (Val (boolV false)) Then Else) Psi) =>
        wp_if_false H E Then Else Psi
  \in properUPred_ent_trans (wp H E Else Psi)
      (wp H E (Val (boolV false)) CondPost)
      (wp H E (join_continue l spawn_pendingV) Psi)
      (properUPred_ent_trans (wp H E Else Psi)
        (wp H E (If (Val (boolV false)) Then Else) Psi)
        (wp H E (Val (boolV false)) CondPost) falseIf
        (wp_value_intro H E (boolV false) CondPost))
      (properUPred_ent_trans (wp H E (Val (boolV false)) CondPost)
        (wp H E (Fst (Val spawn_pendingV)) CondPost)
        (wp H E (join_continue l spawn_pendingV) Psi)
        (wp_fst_pair H E (boolV false) unitV CondPost)
        (wp_bind_if H E (Fst (Val spawn_pendingV)) Then Else Psi))

\lemma join_done_continue {S : gFunctors}
    (H : irisGS natCountable S) (E : coPset) (l : Loc)
    (Psi : Value -> iProp S) (v : Value) :
  properUPred_ent (Psi v)
    (wp H E (join_continue l (spawn_doneV v)) Psi) =>
  \let
    | Then => Snd (Val (spawn_doneV v))
    | Else => App (Val join) (Val (LitV (LitLoc l)))
    | CondPost : Value -> iProp S => \lam b =>
        wp H E (If (Val b) Then Else) Psi
    | thenWP : properUPred_ent (Psi v) (wp H E Then Psi) =>
        properUPred_ent_trans (Psi v) (wp H E (Val v) Psi)
          (wp H E Then Psi)
          (wp_value_intro H E v Psi)
          (wp_snd_pair H E (boolV true) v Psi)
    | trueIf : properUPred_ent (Psi v)
        (wp H E (If (Val (boolV true)) Then Else) Psi) =>
        properUPred_ent_trans (Psi v) (wp H E Then Psi)
          (wp H E (If (Val (boolV true)) Then Else) Psi)
          thenWP (wp_if_true H E Then Else Psi)
  \in properUPred_ent_trans (Psi v)
      (wp H E (Val (boolV true)) CondPost)
      (wp H E (join_continue l (spawn_doneV v)) Psi)
      (properUPred_ent_trans (Psi v)
        (wp H E (If (Val (boolV true)) Then Else) Psi)
        (wp H E (Val (boolV true)) CondPost) trueIf
        (wp_value_intro H E (boolV true) CondPost))
      (properUPred_ent_trans (wp H E (Val (boolV true)) CondPost)
        (wp H E (Fst (Val (spawn_doneV v))) CondPost)
        (wp H E (join_continue l (spawn_doneV v)) Psi)
        (wp_fst_pair H E (boolV true) v CondPost)
        (wp_bind_if H E (Fst (Val (spawn_doneV v))) Then Else Psi))

\lemma join_pending_exact {S : gFunctors}
    (H : irisGS natCountable S) (SG : spawnG S)
    (gam : gname) (l : Loc) (Psi : Value -> iProp S) :
  \let
    | Body => spawn_inv H SG gam l Psi
    | D => coPset_difference coPset_universe (nclose spawnN)
    | Close => mkProperWand (mkProperLater Body)
        (mkProperFUpd H.iris_wsat D coPset_universe mkProperEmp)
    | Base => mkProperSep (spawn_tok SG gam)
        (iris.base_logic.lib.invariants.inv H.iris_wsat spawnN Body)
    | P => wp H coPset_universe
        (App (Val join) (Val (LitV (LitLoc l)))) Psi
    | W => mkProperWand Base P
  \in properUPred_ent
      (mkProperSep (pointsto_full H.iris_gen_heap l spawn_pendingV)
        (mkProperSep Close (mkProperSep W Base)))
      (mkProperFUpd H.iris_wsat D coPset_universe
        (wp H coPset_universe
          (join_continue l spawn_pendingV) Psi)) =>
  \let
    | Body => spawn_inv H SG gam l Psi
    | D => coPset_difference coPset_universe (nclose spawnN)
    | Close => mkProperWand (mkProperLater Body)
        (mkProperFUpd H.iris_wsat D coPset_universe mkProperEmp)
    | Base => mkProperSep (spawn_tok SG gam)
        (iris.base_logic.lib.invariants.inv H.iris_wsat spawnN Body)
    | P => wp H coPset_universe
        (App (Val join) (Val (LitV (LitLoc l)))) Psi
    | W => mkProperWand Base P
    | R => mkProperSep W Base
    | LaterBody => mkProperLater Body
    | Closed => mkProperFUpd H.iris_wsat D coPset_universe mkProperEmp
    | Continue => wp H coPset_universe
        (join_continue l spawn_pendingV) Psi
    | ready : properUPred_ent
        (mkProperSep (pointsto_full H.iris_gen_heap l spawn_pendingV)
          (mkProperSep Close R))
        (mkProperSep (mkProperSep Close LaterBody) R) =>
        properUPred_ent_trans
          (mkProperSep (pointsto_full H.iris_gen_heap l spawn_pendingV)
            (mkProperSep Close R))
          (mkProperSep Close
            (mkProperSep (pointsto_full H.iris_gen_heap l spawn_pendingV) R))
          (mkProperSep (mkProperSep Close LaterBody) R)
          (sep_swap_ent (pointsto_full H.iris_gen_heap l spawn_pendingV)
            Close R)
          (properUPred_ent_trans
            (mkProperSep Close
              (mkProperSep (pointsto_full H.iris_gen_heap l spawn_pendingV) R))
            (mkProperSep Close (mkProperSep LaterBody R))
            (mkProperSep (mkProperSep Close LaterBody) R)
            (sep_mono_r_ent Close
              (mkProperSep (pointsto_full H.iris_gen_heap l spawn_pendingV) R)
              (mkProperSep LaterBody R)
              (sep_mono_l_ent
                (pointsto_full H.iris_gen_heap l spawn_pendingV)
                LaterBody R
                (properUPred_ent_trans
                  (pointsto_full H.iris_gen_heap l spawn_pendingV)
                  Body LaterBody (spawn_inv_initial H SG gam l Psi)
                  (proper_later_intro Body))))
            (sep_assoc_r_ent Close LaterBody R))
    | closeFrame : properUPred_ent
        (mkProperSep (mkProperSep Close LaterBody) R)
        (mkProperFUpd H.iris_wsat D coPset_universe
          (mkProperSep mkProperEmp R)) =>
        properUPred_ent_trans
          (mkProperSep (mkProperSep Close LaterBody) R)
          (mkProperSep Closed R)
          (mkProperFUpd H.iris_wsat D coPset_universe
            (mkProperSep mkProperEmp R))
          (sep_mono_l_ent (mkProperSep Close LaterBody) Closed R
            (wand_elim_ent LaterBody Closed))
          (fupd_frame_r H.iris_wsat D coPset_universe mkProperEmp R)
    | recurse : properUPred_ent (mkProperSep mkProperEmp R) P =>
        properUPred_ent_trans (mkProperSep mkProperEmp R) R P
          (sep_elim_r_ent mkProperEmp R)
          (wand_elim_ent Base P)
  \in properUPred_ent_trans
      (mkProperSep (pointsto_full H.iris_gen_heap l spawn_pendingV)
        (mkProperSep Close R))
      (mkProperSep (mkProperSep Close LaterBody) R)
      (mkProperFUpd H.iris_wsat D coPset_universe Continue) ready
      (properUPred_ent_trans
        (mkProperSep (mkProperSep Close LaterBody) R)
        (mkProperFUpd H.iris_wsat D coPset_universe
          (mkProperSep mkProperEmp R))
        (mkProperFUpd H.iris_wsat D coPset_universe Continue)
        closeFrame
        (fupd_mono H.iris_wsat D coPset_universe
          (mkProperSep mkProperEmp R) Continue
          (properUPred_ent_trans (mkProperSep mkProperEmp R) P Continue
            recurse (join_pending_continue H coPset_universe l Psi))))

\lemma join_done_result_exact {S : gFunctors}
    (H : irisGS natCountable S) (SG : spawnG S)
    (gam : gname) (l : Loc) (Psi : Value -> iProp S) (v : Value) :
  \let
    | Body => spawn_inv H SG gam l Psi
    | D => coPset_difference coPset_universe (nclose spawnN)
    | Close => mkProperWand (mkProperLater Body)
        (mkProperFUpd H.iris_wsat D coPset_universe mkProperEmp)
    | Base => mkProperSep (spawn_tok SG gam)
        (iris.base_logic.lib.invariants.inv H.iris_wsat spawnN Body)
    | P => wp H coPset_universe
        (App (Val join) (Val (LitV (LitLoc l)))) Psi
    | W => mkProperWand Base P
  \in properUPred_ent
      (mkProperSep (pointsto_full H.iris_gen_heap l (spawn_doneV v))
        (mkProperSep (Psi v)
          (mkProperSep Close (mkProperSep W Base))))
      (mkProperFUpd H.iris_wsat D coPset_universe
        (wp H coPset_universe (join_continue l (spawn_doneV v)) Psi)) =>
  \let
    | Body => spawn_inv H SG gam l Psi
    | D => coPset_difference coPset_universe (nclose spawnN)
    | Close => mkProperWand (mkProperLater Body)
        (mkProperFUpd H.iris_wsat D coPset_universe mkProperEmp)
    | Inv => iris.base_logic.lib.invariants.inv H.iris_wsat spawnN Body
    | Tok => spawn_tok SG gam
    | Base => mkProperSep Tok Inv
    | P => wp H coPset_universe
        (App (Val join) (Val (LitV (LitLoc l)))) Psi
    | W => mkProperWand Base P
    | Point => pointsto_full H.iris_gen_heap l (spawn_doneV v)
    | LaterBody => mkProperLater Body
    | Closed => mkProperFUpd H.iris_wsat D coPset_universe mkProperEmp
    | Continue => wp H coPset_universe
        (join_continue l (spawn_doneV v)) Psi
    | Source => mkProperSep Point
        (mkProperSep (Psi v) (mkProperSep Close (mkProperSep W Base)))
    | Flat => mkProperSep Point (mkProperSep (Psi v)
        (mkProperSep Close (mkProperSep W (mkProperSep Tok Inv))))
    | TokFront => mkProperSep Tok (mkProperSep Point
        (mkProperSep (Psi v) (mkProperSep Close (mkProperSep W Inv))))
    | BodyRest => mkProperSep (mkProperSep Point Tok)
        (mkProperSep (Psi v) (mkProperSep Close (mkProperSep W Inv)))
    | LaterRest => mkProperSep LaterBody
        (mkProperSep (Psi v) (mkProperSep Close (mkProperSep W Inv)))
    | PsiClose => mkProperSep (Psi v)
        (mkProperSep Close (mkProperSep LaterBody (mkProperSep W Inv)))
    | PsiClosedBody => mkProperSep (Psi v) (mkProperSep Close LaterBody)
    | Ready => mkProperSep (mkProperSep Close LaterBody) (Psi v)
    | flatten : properUPred_ent Source Flat => properUPred_ent_refl Source
    | moveTok : properUPred_ent Flat TokFront =>
        sep_move_fifth_front Point (Psi v) Close W Tok Inv
    | pairTok : properUPred_ent TokFront BodyRest =>
        properUPred_ent_trans TokFront
          (mkProperSep (mkProperSep Tok Point)
            (mkProperSep (Psi v) (mkProperSep Close (mkProperSep W Inv))))
          BodyRest
          (sep_assoc_r_ent Tok Point
            (mkProperSep (Psi v) (mkProperSep Close (mkProperSep W Inv))))
          (sep_mono_l_ent (mkProperSep Tok Point)
            (mkProperSep Point Tok)
            (mkProperSep (Psi v) (mkProperSep Close (mkProperSep W Inv)))
            (sep_comm_ent Tok Point))
    | makeBody : properUPred_ent BodyRest LaterRest =>
        sep_mono_l_ent (mkProperSep Point Tok) LaterBody
          (mkProperSep (Psi v) (mkProperSep Close (mkProperSep W Inv)))
          (properUPred_ent_trans (mkProperSep Point Tok) Body LaterBody
            (spawn_inv_done_token H SG gam l Psi v)
            (proper_later_intro Body))
    | reorder : properUPred_ent LaterRest PsiClose =>
        properUPred_ent_trans LaterRest
          (mkProperSep (Psi v)
            (mkProperSep LaterBody (mkProperSep Close (mkProperSep W Inv))))
          PsiClose
          (sep_swap_ent LaterBody (Psi v)
            (mkProperSep Close (mkProperSep W Inv)))
          (sep_mono_r_ent (Psi v)
            (mkProperSep LaterBody (mkProperSep Close (mkProperSep W Inv)))
            (mkProperSep Close (mkProperSep LaterBody (mkProperSep W Inv)))
            (sep_swap_ent LaterBody Close (mkProperSep W Inv)))
    | discard : properUPred_ent PsiClose PsiClosedBody =>
        sep_mono_r_ent (Psi v)
          (mkProperSep Close (mkProperSep LaterBody (mkProperSep W Inv)))
          (mkProperSep Close LaterBody)
          (sep_mono_r_ent Close
            (mkProperSep LaterBody (mkProperSep W Inv)) LaterBody
            (sep_elim_l_ent LaterBody (mkProperSep W Inv)))
    | ready : properUPred_ent Source Ready =>
        properUPred_ent_trans Source Flat Ready flatten
          (properUPred_ent_trans Flat TokFront Ready moveTok
            (properUPred_ent_trans TokFront BodyRest Ready pairTok
              (properUPred_ent_trans BodyRest LaterRest Ready makeBody
                (properUPred_ent_trans LaterRest PsiClose Ready reorder
                  (properUPred_ent_trans PsiClose PsiClosedBody Ready discard
                    (sep_comm_ent (Psi v) (mkProperSep Close LaterBody)))))))
    | closeFrame : properUPred_ent Ready
        (mkProperFUpd H.iris_wsat D coPset_universe
          (mkProperSep mkProperEmp (Psi v))) =>
        properUPred_ent_trans Ready (mkProperSep Closed (Psi v))
          (mkProperFUpd H.iris_wsat D coPset_universe
            (mkProperSep mkProperEmp (Psi v)))
          (sep_mono_l_ent (mkProperSep Close LaterBody) Closed (Psi v)
            (wand_elim_ent LaterBody Closed))
          (fupd_frame_r H.iris_wsat D coPset_universe mkProperEmp (Psi v))
  \in properUPred_ent_trans Source Ready
      (mkProperFUpd H.iris_wsat D coPset_universe Continue) ready
      (properUPred_ent_trans Ready
        (mkProperFUpd H.iris_wsat D coPset_universe
          (mkProperSep mkProperEmp (Psi v)))
        (mkProperFUpd H.iris_wsat D coPset_universe Continue) closeFrame
        (fupd_mono H.iris_wsat D coPset_universe
          (mkProperSep mkProperEmp (Psi v)) Continue
          (properUPred_ent_trans (mkProperSep mkProperEmp (Psi v))
            (Psi v) Continue (sep_elim_r_ent mkProperEmp (Psi v))
            (join_done_continue H coPset_universe l Psi v))))

\lemma join_done_token_exact {S : gFunctors}
    (H : irisGS natCountable S) (SG : spawnG S)
    (gam : gname) (l : Loc) (Psi : Value -> iProp S) (v : Value)
    (Target : iProp S) :
  \let
    | Body => spawn_inv H SG gam l Psi
    | D => coPset_difference coPset_universe (nclose spawnN)
    | Close => mkProperWand (mkProperLater Body)
        (mkProperFUpd H.iris_wsat D coPset_universe mkProperEmp)
    | Base => mkProperSep (spawn_tok SG gam)
        (iris.base_logic.lib.invariants.inv H.iris_wsat spawnN Body)
    | P => wp H coPset_universe
        (App (Val join) (Val (LitV (LitLoc l)))) Psi
    | W => mkProperWand Base P
  \in properUPred_ent
      (mkProperSep (pointsto_full H.iris_gen_heap l (spawn_doneV v))
        (mkProperSep (spawn_tok SG gam)
          (mkProperSep Close (mkProperSep W Base)))) Target =>
  \let
    | Body => spawn_inv H SG gam l Psi
    | D => coPset_difference coPset_universe (nclose spawnN)
    | Close => mkProperWand (mkProperLater Body)
        (mkProperFUpd H.iris_wsat D coPset_universe mkProperEmp)
    | Inv => iris.base_logic.lib.invariants.inv H.iris_wsat spawnN Body
    | Tok => spawn_tok SG gam
    | Base => mkProperSep Tok Inv
    | P => wp H coPset_universe
        (App (Val join) (Val (LitV (LitLoc l)))) Psi
    | W => mkProperWand Base P
    | Point => pointsto_full H.iris_gen_heap l (spawn_doneV v)
    | Source => mkProperSep Point
        (mkProperSep Tok (mkProperSep Close (mkProperSep W Base)))
    | Flat => mkProperSep Point
        (mkProperSep Tok (mkProperSep Close (mkProperSep W
          (mkProperSep Tok Inv))))
    | TokFront => mkProperSep Tok (mkProperSep Point
        (mkProperSep Tok (mkProperSep Close (mkProperSep W Inv))))
    | TwoTok => mkProperSep Tok Tok
    | select : properUPred_ent TokFront TwoTok =>
        sep_mono_r_ent Tok
          (mkProperSep Point
            (mkProperSep Tok (mkProperSep Close (mkProperSep W Inv))))
          Tok
          (properUPred_ent_trans
            (mkProperSep Point
              (mkProperSep Tok (mkProperSep Close (mkProperSep W Inv))))
            (mkProperSep Tok (mkProperSep Point
              (mkProperSep Close (mkProperSep W Inv)))) Tok
            (sep_swap_ent Point Tok (mkProperSep Close (mkProperSep W Inv)))
            (sep_elim_l_ent Tok
              (mkProperSep Point (mkProperSep Close (mkProperSep W Inv)))))
  \in properUPred_ent_trans Source Flat Target
      (properUPred_ent_refl Source)
      (properUPred_ent_trans Flat TokFront Target
        (sep_move_fifth_front Point Tok Close W Tok Inv)
        (properUPred_ent_trans TokFront TwoTok Target select
          (spawn_tok_exclusive SG gam Target)))

\lemma join_load_transition {S : gFunctors}
    (H : irisGS natCountable S) (SG : spawnG S)
    (gam : gname) (l : Loc) (Psi : Value -> iProp S) (lv : Value) :
  \let
    | Body => spawn_inv H SG gam l Psi
    | D => coPset_difference coPset_universe (nclose spawnN)
    | Close => mkProperWand (mkProperLater Body)
        (mkProperFUpd H.iris_wsat D coPset_universe mkProperEmp)
    | Base => mkProperSep (spawn_tok SG gam)
        (iris.base_logic.lib.invariants.inv H.iris_wsat spawnN Body)
    | P => wp H coPset_universe
        (App (Val join) (Val (LitV (LitLoc l)))) Psi
    | W => mkProperWand Base P
    | Rest => mkProperSep Close (mkProperSep W Base)
    | Continue => wp H coPset_universe (join_continue l lv) Psi
  \in properUPred_ent
      (mkProperSep (pointsto_full H.iris_gen_heap l lv)
        (mkProperSep (spawn_state SG gam Psi lv) Rest))
      (mkProperBUpd
        (mkProperFUpd H.iris_wsat D coPset_universe Continue)) =>
  \let
    | Body => spawn_inv H SG gam l Psi
    | D => coPset_difference coPset_universe (nclose spawnN)
    | Close => mkProperWand (mkProperLater Body)
        (mkProperFUpd H.iris_wsat D coPset_universe mkProperEmp)
    | Base => mkProperSep (spawn_tok SG gam)
        (iris.base_logic.lib.invariants.inv H.iris_wsat spawnN Body)
    | P => wp H coPset_universe
        (App (Val join) (Val (LitV (LitLoc l)))) Psi
    | W => mkProperWand Base P
    | Rest => mkProperSep Close (mkProperSep W Base)
    | Point => pointsto_full H.iris_gen_heap l lv
    | Frame => mkProperSep Point Rest
    | Continue => wp H coPset_universe (join_continue l lv) Psi
    | FContinue => mkProperFUpd H.iris_wsat D coPset_universe Continue
    | Target => mkProperBUpd FContinue
    | Pending => mkProperPure {iResUR S} (lv = spawn_pendingV)
    | Done => mkProperExist Value (\lam v =>
        mkProperSep (mkProperPure (lv = spawn_doneV v))
          (mkProperOr (Psi v) (spawn_tok SG gam)))
    | pending : properUPred_ent (mkProperSep Pending Frame) FContinue =>
        pure_sep_l_elim (lv = spawn_pendingV) Frame FContinue
          (\lam eq => transport
            (\lam current => properUPred_ent
              (mkProperSep (pointsto_full H.iris_gen_heap l current) Rest)
              (mkProperFUpd H.iris_wsat D coPset_universe
                (wp H coPset_universe (join_continue l current) Psi)))
            (inv eq) (join_pending_exact H SG gam l Psi))
    | doneOne : \Pi (v : Value) -> properUPred_ent
        (mkProperSep
          (mkProperSep (mkProperPure (lv = spawn_doneV v))
            (mkProperOr (Psi v) (spawn_tok SG gam))) Frame)
        FContinue => \lam v =>
        \let
          | Eq => mkProperPure {iResUR S} (lv = spawn_doneV v)
          | Payload => mkProperOr (Psi v) (spawn_tok SG gam)
          | WithEq => mkProperSep Eq (mkProperSep Payload Frame)
        \in properUPred_ent_trans
            (mkProperSep (mkProperSep Eq Payload) Frame) WithEq FContinue
            (sep_assoc_l_ent Eq Payload Frame)
            (pure_sep_l_elim (lv = spawn_doneV v)
              (mkProperSep Payload Frame) FContinue
              (\lam eq => transport
                (\lam current => properUPred_ent
                  (mkProperSep Payload
                    (mkProperSep
                      (pointsto_full H.iris_gen_heap l current) Rest))
                  (mkProperFUpd H.iris_wsat D coPset_universe
                    (wp H coPset_universe
                      (join_continue l current) Psi)))
                (inv eq)
                (sep_or_l_elim (Psi v) (spawn_tok SG gam)
                  (mkProperSep
                    (pointsto_full H.iris_gen_heap l (spawn_doneV v)) Rest)
                  (mkProperFUpd H.iris_wsat D coPset_universe
                    (wp H coPset_universe
                      (join_continue l (spawn_doneV v)) Psi))
                  (properUPred_ent_trans
                    (mkProperSep (Psi v)
                      (mkProperSep
                        (pointsto_full H.iris_gen_heap l (spawn_doneV v)) Rest))
                    (mkProperSep
                      (pointsto_full H.iris_gen_heap l (spawn_doneV v))
                      (mkProperSep (Psi v) Rest))
                    (mkProperFUpd H.iris_wsat D coPset_universe
                      (wp H coPset_universe
                        (join_continue l (spawn_doneV v)) Psi))
                    (sep_swap_ent (Psi v)
                      (pointsto_full H.iris_gen_heap l (spawn_doneV v)) Rest)
                    (join_done_result_exact H SG gam l Psi v))
                  (properUPred_ent_trans
                    (mkProperSep (spawn_tok SG gam)
                      (mkProperSep
                        (pointsto_full H.iris_gen_heap l (spawn_doneV v)) Rest))
                    (mkProperSep
                      (pointsto_full H.iris_gen_heap l (spawn_doneV v))
                      (mkProperSep (spawn_tok SG gam) Rest))
                    (mkProperFUpd H.iris_wsat D coPset_universe
                      (wp H coPset_universe
                        (join_continue l (spawn_doneV v)) Psi))
                    (sep_swap_ent (spawn_tok SG gam)
                      (pointsto_full H.iris_gen_heap l (spawn_doneV v)) Rest)
                    (join_done_token_exact H SG gam l Psi v
                      (mkProperFUpd H.iris_wsat D coPset_universe
                        (wp H coPset_universe
                          (join_continue l (spawn_doneV v)) Psi)))))))
    | done : properUPred_ent (mkProperSep Done Frame) FContinue =>
        sep_exist_l_elim
          (\lam v => mkProperSep
            (mkProperPure (lv = spawn_doneV v))
            (mkProperOr (Psi v) (spawn_tok SG gam)))
          Frame FContinue doneOne
    | choose : properUPred_ent
        (mkProperSep (spawn_state SG gam Psi lv) Frame) FContinue =>
        sep_or_l_elim Pending Done Frame FContinue pending done
    | expose : properUPred_ent
        (mkProperSep Point
          (mkProperSep (spawn_state SG gam Psi lv) Rest))
        FContinue => properUPred_ent_trans
          (mkProperSep Point
            (mkProperSep (spawn_state SG gam Psi lv) Rest))
          (mkProperSep (spawn_state SG gam Psi lv) Frame) FContinue
          (sep_swap_ent Point (spawn_state SG gam Psi lv) Rest) choose
  \in properUPred_ent_trans
      (mkProperSep Point (mkProperSep (spawn_state SG gam Psi lv) Rest))
      FContinue Target expose (bupd_intro FContinue)

\lemma join_load_opened {S : gFunctors}
    (H : irisGS natCountable S) (SG : spawnG S)
    (gam : gname) (l : Loc) (Psi : Value -> iProp S) (lv : Value) :
  \let
    | Body => spawn_inv H SG gam l Psi
    | D => coPset_difference coPset_universe (nclose spawnN)
    | Close => mkProperWand (mkProperLater Body)
        (mkProperFUpd H.iris_wsat D coPset_universe mkProperEmp)
    | Base => mkProperSep (spawn_tok SG gam)
        (iris.base_logic.lib.invariants.inv H.iris_wsat spawnN Body)
    | P => wp H coPset_universe
        (App (Val join) (Val (LitV (LitLoc l)))) Psi
    | W => mkProperWand Base P
    | K => mkProperSep (mkProperLater W) Base
    | Phi : Value -> iProp S => \lam loaded =>
        wp H coPset_universe (join_continue l loaded) Psi
  \in properUPred_ent
      (mkProperSep
        (mkProperSep
          (mkProperSep (pointsto_full H.iris_gen_heap l lv)
            (mkProperLater (spawn_state SG gam Psi lv)))
          Close) K)
      (wp H D (Load (Val (LitV (LitLoc l))))
        (\lam loaded => mkProperFUpd H.iris_wsat D coPset_universe
          (Phi loaded))) =>
  \let
    | Body => spawn_inv H SG gam l Psi
    | D => coPset_difference coPset_universe (nclose spawnN)
    | Close => mkProperWand (mkProperLater Body)
        (mkProperFUpd H.iris_wsat D coPset_universe mkProperEmp)
    | Base => mkProperSep (spawn_tok SG gam)
        (iris.base_logic.lib.invariants.inv H.iris_wsat spawnN Body)
    | P => wp H coPset_universe
        (App (Val join) (Val (LitV (LitLoc l)))) Psi
    | W => mkProperWand Base P
    | K => mkProperSep (mkProperLater W) Base
    | Point => pointsto_full H.iris_gen_heap l lv
    | StateP => spawn_state SG gam Psi lv
    | Rest => mkProperSep Close (mkProperSep W Base)
    | After => mkProperSep StateP Rest
    | Phi : Value -> iProp S => \lam loaded =>
        wp H coPset_universe (join_continue l loaded) Psi
    | Source => mkProperSep
        (mkProperSep (mkProperSep Point (mkProperLater StateP)) Close) K
    | S1 => mkProperSep (mkProperSep Point (mkProperLater StateP))
        (mkProperSep Close K)
    | S2 => mkProperSep Point
        (mkProperSep (mkProperLater StateP) (mkProperSep Close K))
    | S3 => mkProperSep Point
        (mkProperSep (mkProperLater StateP)
          (mkProperSep (mkProperLater Close)
            (mkProperSep (mkProperLater W) (mkProperLater Base))))
    | S4 => mkProperSep Point
        (mkProperSep (mkProperLater StateP)
          (mkProperSep (mkProperLater Close)
            (mkProperLater (mkProperSep W Base))))
    | S5 => mkProperSep Point
        (mkProperSep (mkProperLater StateP)
          (mkProperLater (mkProperSep Close (mkProperSep W Base))))
    | Ready => mkProperSep Point (mkProperLater After)
    | arrange : properUPred_ent Source Ready =>
        properUPred_ent_trans Source S1 Ready
          (sep_assoc_l_ent (mkProperSep Point (mkProperLater StateP)) Close K)
          (properUPred_ent_trans S1 S2 Ready
            (sep_assoc_l_ent Point (mkProperLater StateP)
              (mkProperSep Close K))
            (properUPred_ent_trans S2 S3 Ready
              (sep_mono_r_ent Point
                (mkProperSep (mkProperLater StateP) (mkProperSep Close K))
                (mkProperSep (mkProperLater StateP)
                  (mkProperSep (mkProperLater Close)
                    (mkProperSep (mkProperLater W) (mkProperLater Base))))
                (sep_mono_r_ent (mkProperLater StateP)
                  (mkProperSep Close K)
                  (mkProperSep (mkProperLater Close)
                    (mkProperSep (mkProperLater W) (mkProperLater Base)))
                  (properUPred_ent_trans (mkProperSep Close K)
                    (mkProperSep Close
                      (mkProperSep (mkProperLater W) (mkProperLater Base)))
                    (mkProperSep (mkProperLater Close)
                      (mkProperSep (mkProperLater W) (mkProperLater Base)))
                    (sep_mono_r_ent Close K
                      (mkProperSep (mkProperLater W) (mkProperLater Base))
                      (sep_mono_r_ent (mkProperLater W) Base
                        (mkProperLater Base) (proper_later_intro Base)))
                    (sep_mono_l_ent Close (mkProperLater Close)
                      (mkProperSep (mkProperLater W) (mkProperLater Base))
                      (proper_later_intro Close)))))
              (properUPred_ent_trans S3 S4 Ready
                (sep_mono_r_ent Point
                  (mkProperSep (mkProperLater StateP)
                    (mkProperSep (mkProperLater Close)
                      (mkProperSep (mkProperLater W) (mkProperLater Base))))
                  (mkProperSep (mkProperLater StateP)
                    (mkProperSep (mkProperLater Close)
                      (mkProperLater (mkProperSep W Base))))
                  (sep_mono_r_ent (mkProperLater StateP)
                    (mkProperSep (mkProperLater Close)
                      (mkProperSep (mkProperLater W) (mkProperLater Base)))
                    (mkProperSep (mkProperLater Close)
                      (mkProperLater (mkProperSep W Base)))
                    (sep_mono_r_ent (mkProperLater Close)
                      (mkProperSep (mkProperLater W) (mkProperLater Base))
                      (mkProperLater (mkProperSep W Base))
                      (proper_later_sep_2 W Base))))
                (properUPred_ent_trans S4 S5 Ready
                  (sep_mono_r_ent Point
                    (mkProperSep (mkProperLater StateP)
                      (mkProperSep (mkProperLater Close)
                        (mkProperLater (mkProperSep W Base))))
                    (mkProperSep (mkProperLater StateP)
                      (mkProperLater (mkProperSep Close (mkProperSep W Base))))
                    (sep_mono_r_ent (mkProperLater StateP)
                      (mkProperSep (mkProperLater Close)
                        (mkProperLater (mkProperSep W Base)))
                      (mkProperLater (mkProperSep Close (mkProperSep W Base)))
                      (proper_later_sep_2 Close (mkProperSep W Base))))
                  (sep_mono_r_ent Point
                    (mkProperSep (mkProperLater StateP)
                      (mkProperLater (mkProperSep Close (mkProperSep W Base))))
                    (mkProperLater After)
                    (proper_later_sep_2 StateP Rest))))))
    | load : properUPred_ent Ready
        (wp H D (Load (Val (LitV (LitLoc l))))
          (\lam loaded => mkProperFUpd H.iris_wsat D coPset_universe
            (Phi loaded))) =>
        wp_load_later_frame H D l (DfracOwn qp_one) lv After
          (\lam loaded => mkProperFUpd H.iris_wsat D coPset_universe
            (Phi loaded))
          (join_load_transition H SG gam l Psi lv)
  \in properUPred_ent_trans Source Ready
      (wp H D (Load (Val (LitV (LitLoc l))))
        (\lam loaded => mkProperFUpd H.iris_wsat D coPset_universe
          (Phi loaded))) arrange load

\lemma join_load_wp {S : gFunctors}
    (H : irisGS natCountable S) (SG : spawnG S)
    (gam : gname) (l : Loc) (Psi : Value -> iProp S) :
  \let
    | Body => spawn_inv H SG gam l Psi
    | Inv => iris.base_logic.lib.invariants.inv H.iris_wsat spawnN Body
    | Base => mkProperSep (spawn_tok SG gam) Inv
    | P => wp H coPset_universe
        (App (Val join) (Val (LitV (LitLoc l)))) Psi
    | W => mkProperWand Base P
    | K => mkProperSep (mkProperLater W) Base
    | Phi : Value -> iProp S => \lam loaded =>
        wp H coPset_universe (join_continue l loaded) Psi
  \in properUPred_ent (mkProperSep Inv K)
      (wp H coPset_universe
        (Load (Val (LitV (LitLoc l)))) Phi) =>
  \let
    | Body => spawn_inv H SG gam l Psi
    | Inv => iris.base_logic.lib.invariants.inv H.iris_wsat spawnN Body
    | Base => mkProperSep (spawn_tok SG gam) Inv
    | P => wp H coPset_universe
        (App (Val join) (Val (LitV (LitLoc l)))) Psi
    | W => mkProperWand Base P
    | K => mkProperSep (mkProperLater W) Base
    | Phi : Value -> iProp S => \lam loaded =>
        wp H coPset_universe (join_continue l loaded) Psi
  \in wp_atomic_inv_acc_timeless_exist_frame H coPset_universe spawnN
      Body
      (\lam lv => pointsto_full H.iris_gen_heap l lv)
      (\lam lv => spawn_state SG gam Psi lv)
      K (Load (Val (LitV (LitLoc l)))) Phi
      (\lam p _ => coPmem_universe p)
      (load_strongly_atomic l)
      (\lam lv => pointsto_full_timeless H.iris_gen_heap l lv)
      (properUPred_ent_refl Body)
      (\lam lv => join_load_opened H SG gam l Psi lv)

\lemma join_lob_step {S : gFunctors}
    (H : irisGS natCountable S) (SG : spawnG S)
    (gam : gname) (l : Loc) (Psi : Value -> iProp S) :
  \let
    | Body => spawn_inv H SG gam l Psi
    | Inv => iris.base_logic.lib.invariants.inv H.iris_wsat spawnN Body
    | Base => mkProperSep (spawn_tok SG gam) Inv
    | P => wp H coPset_universe
        (App (Val join) (Val (LitV (LitLoc l)))) Psi
    | W => mkProperWand Base P
  \in properUPred_ent (mkProperSep (mkProperLater W) Base) P =>
  \let
    | Body => spawn_inv H SG gam l Psi
    | Inv => iris.base_logic.lib.invariants.inv H.iris_wsat spawnN Body
    | Tok => spawn_tok SG gam
    | Base => mkProperSep Tok Inv
    | P => wp H coPset_universe
        (App (Val join) (Val (LitV (LitLoc l)))) Psi
    | W => mkProperWand Base P
    | K => mkProperSep (mkProperLater W) Base
    | Phi : Value -> iProp S => \lam loaded =>
        wp H coPset_universe (join_continue l loaded) Psi
    | Source => mkProperSep (mkProperLater W) Base
    | Duplicated => mkProperSep (mkProperLater W)
        (mkProperSep Tok (mkProperSep Inv Inv))
    | Ready => mkProperSep Inv K
    | duplicate : properUPred_ent Source Duplicated =>
        sep_mono_r_ent (mkProperLater W) Base
          (mkProperSep Tok (mkProperSep Inv Inv))
          (sep_mono_r_ent Tok Inv (mkProperSep Inv Inv)
            (persistent_consequence_frame_ent Inv Inv
              (inv_persistent H.iris_wsat spawnN Body)))
    | arrange : properUPred_ent Duplicated Ready =>
        sep_rotate_third_front (mkProperLater W) Tok Inv Inv
    | load : properUPred_ent Ready
        (wp H coPset_universe
          (Load (Val (LitV (LitLoc l)))) Phi) =>
        join_load_wp H SG gam l Psi
    | loop : properUPred_ent Ready
        (wp H coPset_universe (join_loop l) Psi) =>
        properUPred_ent_trans Ready
          (wp H coPset_universe
            (Load (Val (LitV (LitLoc l)))) Phi)
          (wp H coPset_universe (join_loop l) Psi) load
          (wp_letE H coPset_universe nCell
            (Load (Val (LitV (LitLoc l))))
            (If (Fst (Var nCell)) (Snd (Var nCell))
              (App (Val join) (Val (LitV (LitLoc l))))) Psi)
  \in properUPred_ent_trans Source Duplicated P duplicate
      (properUPred_ent_trans Duplicated Ready P arrange
        (properUPred_ent_trans Ready
          (wp H coPset_universe (join_loop l) Psi) P loop
          (wp_rec_beta H coPset_universe nJoin nHandle
            (letE nCell (Load (Var nHandle))
              (If (Fst (Var nCell)) (Snd (Var nCell))
                (App (Var nJoin) (Var nHandle))))
            (LitV (LitLoc l)) Psi)))

\lemma join_named_spec {S : gFunctors}
    (H : irisGS natCountable S) (SG : spawnG S)
    (gam : gname) (l : Loc) (Psi : Value -> iProp S) :
  properUPred_ent
    (mkProperSep (spawn_tok SG gam)
      (iris.base_logic.lib.invariants.inv H.iris_wsat spawnN
        (spawn_inv H SG gam l Psi)))
    (wp H coPset_universe
      (App (Val join) (Val (LitV (LitLoc l)))) Psi) =>
  \let
    | Body => spawn_inv H SG gam l Psi
    | Base => mkProperSep (spawn_tok SG gam)
        (iris.base_logic.lib.invariants.inv H.iris_wsat spawnN Body)
    | P => wp H coPset_universe
        (App (Val join) (Val (LitV (LitLoc l)))) Psi
  \in lob_wand_apply_ent Base P (join_lob_step H SG gam l Psi)

\lemma join_spec {S : gFunctors}
    (H : irisGS natCountable S) (SG : spawnG S)
    (l : Loc) (Psi : Value -> iProp S) :
  properUPred_ent (join_handle H SG l Psi)
    (wp H coPset_universe
      (App (Val join) (Val (LitV (LitLoc l)))) Psi) =>
  exist_elim_ent
    (\lam gam => mkProperSep (spawn_tok SG gam)
      (iris.base_logic.lib.invariants.inv H.iris_wsat spawnN
        (spawn_inv H SG gam l Psi)))
    (wp H coPset_universe
      (App (Val join) (Val (LitV (LitLoc l)))) Psi)
    (\lam gam => join_named_spec H SG gam l Psi)

\func par_pair_post {S : gFunctors}
    (Psi1 Psi2 : Value -> iProp S) (returned : Value) : iProp S =>
  mkProperExist Value (\lam v1 => mkProperExist Value (\lam v2 =>
    mkProperSep (mkProperPure (returned = PairV v1 v2))
      (mkProperSep (Psi1 v1) (Psi2 v2))))

\lemma par_pair_values {S : gFunctors}
    (H : irisGS natCountable S) (Psi1 Psi2 : Value -> iProp S)
    (v1 v2 : Value) :
  properUPred_ent (mkProperSep (Psi1 v1) (Psi2 v2))
    (wp H coPset_universe (Pair (Val v1) (Val v2))
      (par_pair_post Psi1 Psi2)) =>
  \let
    | Resources => mkProperSep (Psi1 v1) (Psi2 v2)
    | Post => par_pair_post Psi1 Psi2
    | AtPair => mkProperSep
        (mkProperPure {iResUR S} (PairV v1 v2 = PairV v1 v2)) Resources
    | make : properUPred_ent Resources (Post (PairV v1 v2)) =>
        properUPred_ent_trans Resources AtPair (Post (PairV v1 v2))
          (pure_intro_sep_ent (PairV v1 v2 = PairV v1 v2) idp Resources)
          (properUPred_ent_trans AtPair
            (mkProperExist Value (\lam w2 =>
              mkProperSep (mkProperPure (PairV v1 v2 = PairV v1 w2))
                (mkProperSep (Psi1 v1) (Psi2 w2))))
            (Post (PairV v1 v2))
            (exist_intro_ent (\lam w2 =>
              mkProperSep (mkProperPure (PairV v1 v2 = PairV v1 w2))
                (mkProperSep (Psi1 v1) (Psi2 w2))) v2)
            (exist_intro_ent (\lam w1 => mkProperExist Value (\lam w2 =>
              mkProperSep (mkProperPure (PairV v1 v2 = PairV w1 w2))
                (mkProperSep (Psi1 w1) (Psi2 w2)))) v1))
    | value : properUPred_ent Resources
        (wp H coPset_universe (Val (PairV v1 v2)) Post) =>
        properUPred_ent_trans Resources (Post (PairV v1 v2))
          (wp H coPset_universe (Val (PairV v1 v2)) Post) make
          (wp_value_intro H coPset_universe (PairV v1 v2) Post)
  \in properUPred_ent_trans Resources
      (wp H coPset_universe (Val (PairV v1 v2)) Post)
      (wp H coPset_universe (Pair (Val v1) (Val v2)) Post) value
      (wp_pair_values H coPset_universe v1 v2 Post)

\lemma par_after_handle {S : gFunctors}
    (H : irisGS natCountable S) (SG : spawnG S)
    (Psi1 Psi2 : Value -> iProp S) (f2 : Value) (l : Loc) :
  properUPred_ent
    (mkProperSep (join_handle H SG l Psi1)
      (wp H coPset_universe (App (Val f2) (Val unitV)) Psi2))
    (wp H coPset_universe
      (letE nY (App (Val f2) (Val unitV))
        (letE nX (App (Val join) (Val (LitV (LitLoc l))))
          (Pair (Var nX) (Var nY))))
      (par_pair_post Psi1 Psi2)) =>
  \let
    | Handle => join_handle H SG l Psi1
    | RightCall => App (Val f2) (Val unitV)
    | JoinCall => App (Val join) (Val (LitV (LitLoc l)))
    | Post => par_pair_post Psi1 Psi2
    | RightPost : Value -> iProp S => \lam v2 =>
        mkProperSep (Psi2 v2) Handle
    | afterJoin : \Pi (v2 : Value) -> properUPred_ent
        (mkProperSep Handle (Psi2 v2))
        (wp H coPset_universe
          (letE nX JoinCall (Pair (Var nX) (Val v2))) Post) => \lam v2 =>
        \let
          | JoinPost : Value -> iProp S => \lam v1 =>
              mkProperSep (Psi1 v1) (Psi2 v2)
          | joined : properUPred_ent (mkProperSep Handle (Psi2 v2))
              (wp H coPset_universe JoinCall JoinPost) =>
              properUPred_ent_trans (mkProperSep Handle (Psi2 v2))
                (mkProperSep
                  (wp H coPset_universe JoinCall Psi1) (Psi2 v2))
                (wp H coPset_universe JoinCall JoinPost)
                (sep_mono_l_ent Handle
                  (wp H coPset_universe JoinCall Psi1) (Psi2 v2)
                  (join_spec H SG l Psi1))
                (wp_frame_r H coPset_universe JoinCall Psi1 (Psi2 v2))
          | next : \Pi (v1 : Value) -> properUPred_ent (JoinPost v1)
              (wp H coPset_universe (Pair (Val v1) (Val v2)) Post) =>
              \lam v1 => par_pair_values H Psi1 Psi2 v1 v2
        \in properUPred_ent_trans (mkProperSep Handle (Psi2 v2))
            (wp H coPset_universe JoinCall (\lam v1 =>
              wp H coPset_universe (Pair (Val v1) (Val v2)) Post))
            (wp H coPset_universe
              (letE nX JoinCall (Pair (Var nX) (Val v2))) Post)
            (properUPred_ent_trans (mkProperSep Handle (Psi2 v2))
              (wp H coPset_universe JoinCall JoinPost)
              (wp H coPset_universe JoinCall (\lam v1 =>
                wp H coPset_universe (Pair (Val v1) (Val v2)) Post))
              joined (wp_mono H coPset_universe JoinCall JoinPost
                (\lam v1 => wp H coPset_universe
                  (Pair (Val v1) (Val v2)) Post) next))
            (wp_letE H coPset_universe nX JoinCall
              (Pair (Var nX) (Val v2)) Post)
    | rightFramed : properUPred_ent
        (mkProperSep Handle (wp H coPset_universe RightCall Psi2))
        (wp H coPset_universe RightCall RightPost) =>
        properUPred_ent_trans
          (mkProperSep Handle (wp H coPset_universe RightCall Psi2))
          (mkProperSep (wp H coPset_universe RightCall Psi2) Handle)
          (wp H coPset_universe RightCall RightPost)
          (sep_comm_ent Handle (wp H coPset_universe RightCall Psi2))
          (wp_frame_r H coPset_universe RightCall Psi2 Handle)
    | nextRight : \Pi (v2 : Value) -> properUPred_ent (RightPost v2)
        (wp H coPset_universe
          (letE nX JoinCall (Pair (Var nX) (Val v2))) Post) => \lam v2 =>
        properUPred_ent_trans (mkProperSep (Psi2 v2) Handle)
          (mkProperSep Handle (Psi2 v2))
          (wp H coPset_universe
            (letE nX JoinCall (Pair (Var nX) (Val v2))) Post)
          (sep_comm_ent (Psi2 v2) Handle) (afterJoin v2)
  \in properUPred_ent_trans
      (mkProperSep Handle (wp H coPset_universe RightCall Psi2))
      (wp H coPset_universe RightCall (\lam v2 =>
        wp H coPset_universe
          (letE nX JoinCall (Pair (Var nX) (Val v2))) Post))
      (wp H coPset_universe
        (letE nY RightCall
          (letE nX JoinCall (Pair (Var nX) (Var nY)))) Post)
      (properUPred_ent_trans
        (mkProperSep Handle (wp H coPset_universe RightCall Psi2))
        (wp H coPset_universe RightCall RightPost)
        (wp H coPset_universe RightCall (\lam v2 =>
          wp H coPset_universe
            (letE nX JoinCall (Pair (Var nX) (Val v2))) Post))
        rightFramed (wp_mono H coPset_universe RightCall RightPost
          (\lam v2 => wp H coPset_universe
            (letE nX JoinCall (Pair (Var nX) (Val v2))) Post)
          nextRight))
      (wp_letE H coPset_universe nY RightCall
        (letE nX JoinCall (Pair (Var nX) (Var nY))) Post)

\lemma par_after_spawn {S : gFunctors}
    (H : irisGS natCountable S) (SG : spawnG S)
    (Psi1 Psi2 : Value -> iProp S) (f2 returned : Value) :
  properUPred_ent
    (mkProperSep (spawn_post H SG Psi1 returned)
      (wp H coPset_universe (App (Val f2) (Val unitV)) Psi2))
    (wp H coPset_universe
      (letE nY (App (Val f2) (Val unitV))
        (letE nX (App (Val join) (Val returned))
          (Pair (Var nX) (Var nY))))
      (par_pair_post Psi1 Psi2)) =>
  \let
    | RightWP => wp H coPset_universe
        (App (Val f2) (Val unitV)) Psi2
    | Post => par_pair_post Psi1 Psi2
    | Goal => wp H coPset_universe
        (letE nY (App (Val f2) (Val unitV))
          (letE nX (App (Val join) (Val returned))
            (Pair (Var nX) (Var nY)))) Post
    | perLoc : \Pi (l : Loc) -> properUPred_ent
        (mkProperSep
          (mkProperAnd
            (mkProperPure (returned = LitV (LitLoc l)))
            (join_handle H SG l Psi1)) RightWP) Goal => \lam l =>
        \let
          | PairP => mkProperAnd
              (mkProperPure {iResUR S} (returned = LitV (LitLoc l)))
              (join_handle H SG l Psi1)
          | Eq => returned = LitV (LitLoc l)
          | ExactGoal => wp H coPset_universe
              (letE nY (App (Val f2) (Val unitV))
                (letE nX
                  (App (Val join) (Val (LitV (LitLoc l))))
                  (Pair (Var nX) (Var nY)))) Post
          | retainEq : properUPred_ent (mkProperSep PairP RightWP)
              (mkProperSep (mkProperPure Eq)
                (mkProperSep PairP RightWP)) =>
              pure_consequence_frame_ent (mkProperSep PairP RightWP) Eq
                (properUPred_ent_trans (mkProperSep PairP RightWP) PairP
                  (mkProperPure Eq)
                  (sep_elim_l_ent PairP RightWP)
                  (and_elim_l_ent (mkProperPure Eq)
                    (join_handle H SG l Psi1)))
          | exact : properUPred_ent (mkProperSep PairP RightWP)
              ExactGoal => properUPred_ent_trans
                (mkProperSep PairP RightWP)
                (mkProperSep (join_handle H SG l Psi1) RightWP)
                ExactGoal
                (sep_mono_l_ent PairP (join_handle H SG l Psi1) RightWP
                  (and_elim_r_ent (mkProperPure Eq)
                    (join_handle H SG l Psi1)))
                (par_after_handle H SG Psi1 Psi2 f2 l)
          | useEq : Eq -> properUPred_ent
              (mkProperSep PairP RightWP) Goal => \lam eq =>
              transport (\lam r => properUPred_ent
                (mkProperSep PairP RightWP)
                (wp H coPset_universe
                  (letE nY (App (Val f2) (Val unitV))
                    (letE nX (App (Val join) (Val r))
                      (Pair (Var nX) (Var nY)))) Post))
                (inv eq) exact
        \in properUPred_ent_trans (mkProperSep PairP RightWP)
            (mkProperSep (mkProperPure Eq)
              (mkProperSep PairP RightWP)) Goal retainEq
            (pure_sep_l_elim Eq (mkProperSep PairP RightWP) Goal useEq)
  \in sep_exist_l_elim
      (\lam l => mkProperAnd
        (mkProperPure (returned = LitV (LitLoc l)))
        (join_handle H SG l Psi1))
      RightWP Goal perLoc

\lemma par_body_spec {S : gFunctors}
    (H : irisGS natCountable S) (SG : spawnG S)
    (FPI : ForkPostInhabited H)
    (Psi1 Psi2 : Value -> iProp S) (f1 f2 : Value) :
  properUPred_ent
    (mkProperSep
      (wp H coPset_universe (App (Val f1) (Val unitV)) Psi1)
      (wp H coPset_universe (App (Val f2) (Val unitV)) Psi2))
    (wp H coPset_universe
      (letE nHandle (App (Val spawn) (Val f1))
        (letE nY (App (Val f2) (Val unitV))
          (letE nX (App (Val join) (Var nHandle))
            (Pair (Var nX) (Var nY)))))
      (par_pair_post Psi1 Psi2)) =>
  \let
    | LeftWP => wp H coPset_universe
        (App (Val f1) (Val unitV)) Psi1
    | RightWP => wp H coPset_universe
        (App (Val f2) (Val unitV)) Psi2
    | SpawnCall => App (Val spawn) (Val f1)
    | Post => par_pair_post Psi1 Psi2
    | SpawnFramed : Value -> iProp S => \lam returned =>
        mkProperSep (spawn_post H SG Psi1 returned) RightWP
    | spawned : properUPred_ent (mkProperSep LeftWP RightWP)
        (wp H coPset_universe SpawnCall SpawnFramed) =>
        properUPred_ent_trans (mkProperSep LeftWP RightWP)
          (mkProperSep
            (wp H coPset_universe SpawnCall (spawn_post H SG Psi1))
            RightWP)
          (wp H coPset_universe SpawnCall SpawnFramed)
          (sep_mono_l_ent LeftWP
            (wp H coPset_universe SpawnCall (spawn_post H SG Psi1))
            RightWP (spawn_spec H SG FPI Psi1 f1))
          (wp_frame_r H coPset_universe SpawnCall
            (spawn_post H SG Psi1) RightWP)
    | next : \Pi (returned : Value) -> properUPred_ent
        (SpawnFramed returned)
        (wp H coPset_universe
          (letE nY (App (Val f2) (Val unitV))
            (letE nX (App (Val join) (Val returned))
              (Pair (Var nX) (Var nY)))) Post) => \lam returned =>
        par_after_spawn H SG Psi1 Psi2 f2 returned
  \in properUPred_ent_trans (mkProperSep LeftWP RightWP)
      (wp H coPset_universe SpawnCall (\lam returned =>
        wp H coPset_universe
          (letE nY (App (Val f2) (Val unitV))
            (letE nX (App (Val join) (Val returned))
              (Pair (Var nX) (Var nY)))) Post))
      (wp H coPset_universe
        (letE nHandle SpawnCall
          (letE nY (App (Val f2) (Val unitV))
            (letE nX (App (Val join) (Var nHandle))
              (Pair (Var nX) (Var nY))))) Post)
      (properUPred_ent_trans (mkProperSep LeftWP RightWP)
        (wp H coPset_universe SpawnCall SpawnFramed)
        (wp H coPset_universe SpawnCall (\lam returned =>
          wp H coPset_universe
            (letE nY (App (Val f2) (Val unitV))
              (letE nX (App (Val join) (Val returned))
                (Pair (Var nX) (Var nY)))) Post))
        spawned (wp_mono H coPset_universe SpawnCall SpawnFramed
          (\lam returned => wp H coPset_universe
            (letE nY (App (Val f2) (Val unitV))
              (letE nX (App (Val join) (Val returned))
                (Pair (Var nX) (Var nY)))) Post) next))
      (wp_letE H coPset_universe nHandle SpawnCall
        (letE nY (App (Val f2) (Val unitV))
          (letE nX (App (Val join) (Var nHandle))
            (Pair (Var nX) (Var nY)))) Post)

\lemma par_spec {S : gFunctors}
    (H : irisGS natCountable S) (SG : spawnG S)
    (FPI : ForkPostInhabited H)
    (Psi1 Psi2 : Value -> iProp S) (f1 f2 : Value) :
  properUPred_ent
    (mkProperSep
      (wp H coPset_universe (App (Val f1) (Val unitV)) Psi1)
      (wp H coPset_universe (App (Val f2) (Val unitV)) Psi2))
    (wp H coPset_universe (app2 (Val par) (Val f1) (Val f2))
      (par_pair_post Psi1 Psi2)) =>
  \let
    | Pre => mkProperSep
        (wp H coPset_universe (App (Val f1) (Val unitV)) Psi1)
        (wp H coPset_universe (App (Val f2) (Val unitV)) Psi2)
    | BodyGeneric => letE nHandle (App (Val spawn) (Var nLeft))
        (letE nY (App (Var nRight) (Val unitV))
          (letE nX (App (Val join) (Var nHandle))
            (Pair (Var nX) (Var nY))))
    | BodyLeft => letE nHandle (App (Val spawn) (Val f1))
        (letE nY (App (Var nRight) (Val unitV))
          (letE nX (App (Val join) (Var nHandle))
            (Pair (Var nX) (Var nY))))
    | BodyAt => letE nHandle (App (Val spawn) (Val f1))
        (letE nY (App (Val f2) (Val unitV))
          (letE nX (App (Val join) (Var nHandle))
            (Pair (Var nX) (Var nY))))
    | InnerLam => LamV nRight BodyLeft
    | OuterApp => App (Val par) (Val f1)
    | Post => par_pair_post Psi1 Psi2
    | PhiOuter : Value -> iProp S => \lam vf =>
        wp H coPset_universe (App (Val vf) (Val f2)) Post
    | body : properUPred_ent Pre (wp H coPset_universe BodyAt Post) =>
        par_body_spec H SG FPI Psi1 Psi2 f1 f2
    | innerApp : properUPred_ent Pre (PhiOuter InnerLam) =>
        properUPred_ent_trans Pre (wp H coPset_universe BodyAt Post)
          (PhiOuter InnerLam) body
          (wp_lam_beta H coPset_universe nRight BodyLeft f2 Post)
    | innerValue : properUPred_ent Pre
        (wp H coPset_universe (Val InnerLam) PhiOuter) =>
        properUPred_ent_trans Pre (PhiOuter InnerLam)
          (wp H coPset_universe (Val InnerLam) PhiOuter) innerApp
          (wp_value_intro H coPset_universe InnerLam PhiOuter)
    | innerExpr : properUPred_ent Pre
        (wp H coPset_universe (Lam nRight BodyLeft) PhiOuter) =>
        properUPred_ent_trans Pre
          (wp H coPset_universe (Val InnerLam) PhiOuter)
          (wp H coPset_universe (Lam nRight BodyLeft) PhiOuter)
          innerValue (wp_lam_expr H coPset_universe nRight BodyLeft PhiOuter)
    | outerBeta : properUPred_ent Pre
        (wp H coPset_universe OuterApp PhiOuter) =>
        properUPred_ent_trans Pre
          (wp H coPset_universe (Lam nRight BodyLeft) PhiOuter)
          (wp H coPset_universe OuterApp PhiOuter) innerExpr
          (wp_lam_beta H coPset_universe nLeft
            (Lam nRight BodyGeneric) f1 PhiOuter)
  \in properUPred_ent_trans Pre
      (wp H coPset_universe OuterApp PhiOuter)
      (wp H coPset_universe (App OuterApp (Val f2)) Post)
      outerBeta
      (wp_bind_app_l H coPset_universe OuterApp (Val f2) Post)

-- Counter namespace and the public mask used by all three operations.
\func mscN : Namespace => ndot nroot (xI xH)
\func mscE : coPset => coPset_universe

\lemma mscN_subset_mscE : coPSubset (nclose mscN) mscE =>
  \lam p _ => coPmem_universe p

\func msc_open_mask : coPset => coPset_difference mscE (nclose mscN)

-- A sibling namespace for the client-side accounting invariant used by the
-- parallel example.  Its closure is disjoint from the counter invariant, so
-- the logically atomic counter updates may open it inside `msc_open_mask`.
\func msc_clientN : Namespace => ndot nroot (xO xH)

\lemma msc_clientN_subset_open :
  coPSubset (nclose msc_clientN) msc_open_mask =>
  coPSubset_difference_of_disjoint (nclose msc_clientN) (nclose mscN) mscE
    (\lam p _ => coPmem_universe p)
    (ndisjoint_implies_disjoint mscN msc_clientN
      (ndot_ne_disjoint nroot (xI xH) (xO xH) (\lam h => \case h \with {})))

-- Repackage the request-map inG witness with the concrete name allocated for
-- a particular counter.  This matches Rocq's name-parameterized ghost_map
-- notation while reusing Arend's gen_heap-backed implementation.
\func msc_requestGS {S : gFunctors} (G : mscG S) (gam : msc_name) :
  ghost_mapGS Nat natCountable (\Sigma Nat gname) S =>
  \new gen_heapGS {
    | gen_heap_inG => G.msc_request_mapG.gen_heap_inG
    | gen_heap_name => gam.msc_request_name
  }

\func msc_counter_auth {S : gFunctors} (G : mscG S)
    (gam : msc_name) (n : Nat) : iProp S =>
  msc_auth G.msc_modelG gam.msc_model_name n

\func msc_counter_frag {S : gFunctors} (G : mscG S)
    (gam : msc_name) (q : Qp) (n : Nat) : iProp S =>
  msc_frag G.msc_modelG gam.msc_model_name q n

\func msc_shard_auth {S : gFunctors} (H : irisGS natCountable S)
    (G : mscG S) (a i n : Nat) (gams : gname) : iProp S =>
  mkProperSep (pointsto_full H.iris_gen_heap (a Nat.+ i) (natV n))
    (mono_nat_auth_own G.msc_mono_natG gams qp_one n)

\func msc_shard_lb {S : gFunctors} (G : mscG S)
    (gams : gname) (n : Nat) : iProp S =>
  mono_nat_lb_own G.msc_mono_natG gams n

-- Zip two lists under separating conjunction.  A length mismatch is false,
-- just as Iris' big_sepL2 connective.
\func msc_mono_auths {S : gFunctors} (G : mscG S)
    (ns : List Nat) (gams : List gname) : iProp S \elim ns, gams
  | nil, nil => mkProperEmp
  | :: n ns, :: gam gams => mkProperSep
      (mono_nat_auth_own G.msc_mono_natG gam qp_one n)
      (msc_mono_auths G ns gams)
  | _, _ => mkProperPure Empty

\func msc_lbs {S : gFunctors} (G : mscG S)
    (ns : List Nat) (gams : List gname) : iProp S \elim ns, gams
  | nil, nil => mkProperEmp
  | :: n ns, :: gam gams => mkProperSep
      (msc_shard_lb G gam n) (msc_lbs G ns gams)
  | _, _ => mkProperPure Empty

\func msc_shards {S : gFunctors} (H : irisGS natCountable S)
    (G : mscG S) (a : Nat) (ns : List Nat) (gams : List gname) : iProp S =>
  mkProperSep
    (pointsto_array H.iris_gen_heap suc a (map natV ns))
    (msc_mono_auths G ns gams)

\func nat_sum (ns : List Nat) : Nat \elim ns
  | nil => 0
  | :: n ns => n Nat.+ nat_sum ns

\lemma map_natV_replicate_zero (T : Nat) :
  map natV (replicate T 0) = replicate T (natV 0) \elim T
  | 0 => idp
  | suc T => pmap ((natV 0) ::) (map_natV_replicate_zero T)

\lemma nat_sum_replicate_zero (T : Nat) :
  nat_sum (replicate T 0) = 0 \elim T
  | 0 => idp
  | suc T => nat_sum_replicate_zero T

\func nat_lt (n m : Nat) : \Prop => suc n <= m

\func msc_read_pending {S : gFunctors} (H : irisGS natCountable S)
    (G : mscG S) (gam : msc_name) (total r : Nat) (gamQ : gname) : iProp S =>
  mkProperExist1 (iProp S) (\lam P =>
    mkProperExist1 (Nat -> iProp S) (\lam Q =>
      mkProperSep
        (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
        (mkProperSep P
          (mkProperSep
            (mkProperPersistently
              (mkProperWand
                (mkProperSep (msc_counter_auth G gam r) P)
                (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                  (mkProperSep (msc_counter_auth G gam r) (Q r)))))
            (mkProperPure (nat_lt total r))))))

\func msc_read_done {S : gFunctors} (G : mscG S)
    (total r : Nat) (gamQ : gname) : iProp S =>
  mkProperExist1 (Nat -> iProp S) (\lam Q =>
    mkProperSep
      (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
      (mkProperSep (Q r) (mkProperPure (r <= total))))

\func msc_read_state {S : gFunctors} (H : irisGS natCountable S)
    (G : mscG S) (gam : msc_name) (total : Nat)
    (request : \Sigma Nat gname) : iProp S =>
  mkProperOr
    (msc_read_pending H G gam total request.1 request.2)
    (msc_read_done G total request.1 request.2)

\func msc_requests {S : gFunctors} (H : irisGS natCountable S)
    (G : mscG S) (gam : msc_name) (total : Nat)
    (requests : Gmap Nat natCountable (\Sigma Nat gname)) : iProp S =>
  mkProperSep
    (ghost_map_auth (msc_requestGS G gam) qp_one requests)
    (big_sepM requests (\lam _ request =>
      msc_read_state H G gam total request))

\func msc_inv_body_names {S : gFunctors} (H : irisGS natCountable S)
    (G : mscG S) (gam : msc_name) (a : Nat)
    (ns : List Nat) (names : List gname)
    (requests : Gmap Nat natCountable (\Sigma Nat gname)) : iProp S =>
  mkProperSep (mkProperPure (length ns = gam.msc_size))
    (mkProperSep
      (mkProperPure (length names = gam.msc_size))
      (mkProperSep (msc_counter_auth G gam (nat_sum ns))
        (mkProperSep (msc_shards H G a ns names)
          (msc_requests H G gam (nat_sum ns) requests))))

\func msc_inv {S : gFunctors} (H : irisGS natCountable S)
    (G : mscG S) (gam : msc_name) (a : Nat) : iProp S =>
  mkProperExist (List Nat) (\lam ns =>
    mkProperExist (Gmap Nat natCountable (\Sigma Nat gname)) (\lam requests =>
      msc_inv_body_names H G gam a ns gam.msc_shard_names requests))

\func msc_is_counter {S : gFunctors} (H : irisGS natCountable S)
    (G : mscG S) (gam : msc_name) (c : Value) : iProp S =>
  mkProperExist Nat (\lam a =>
    mkProperSep
      (mkProperPure (c = PairV (LitV (LitLoc a)) (natV gam.msc_size)))
      (iris.base_logic.lib.invariants.inv H.iris_wsat mscN (msc_inv H G gam a)))

\func msc_handle {S : gFunctors} (G : mscG S)
    (gam : msc_name) (h : Value) : iProp S =>
  mkProperExist Nat (\lam i =>
    mkProperSep (mkProperPure (h = natV i))
      (mkProperPure (nat_lt i gam.msc_size)))

\func nat_seq (start count : Nat) : List Nat \elim count
  | 0 => nil
  | suc count => start :: nat_seq (suc start) count

\func msc_handles {S : gFunctors} (G : mscG S)
    (gam : msc_name) : iProp S =>
  big_sepL (\lam i => msc_handle G gam (natV i))
    (nat_seq 0 gam.msc_size)

-- Small semantic BI laws used repeatedly below.  Iris exposes these through
-- proof-mode instances; the term-mode port states exactly the consumed laws.
\lemma persistently_elim_ent {M : UCMRA} (P : ProperUPred M) :
  properUPred_ent (mkProperPersistently P) P =>
  \lam n x _ hp =>
    P.upred_mono n n (ucmra_core x) x hp
      (inP (x, equiv_dist {M}
        (M.equiv_sym (M.op (ucmra_core x) x) x
          (ucmra_core_left_id x)) n)) <=-refl

\lemma persistently_wand_elim_ent {M : UCMRA}
    (P Q : ProperUPred M) :
  properUPred_ent
    (mkProperSep (mkProperPersistently (mkProperWand P Q)) P) Q =>
  properUPred_ent_trans
    (mkProperSep (mkProperPersistently (mkProperWand P Q)) P)
    (mkProperSep (mkProperWand P Q) P) Q
    (sep_mono_l_ent
      (mkProperPersistently (mkProperWand P Q)) (mkProperWand P Q) P
      (persistently_elim_ent (mkProperWand P Q)))
    (wand_elim_ent P Q)

\lemma msc_handle_persistent {S : gFunctors} (G : mscG S)
    (gam : msc_name) (h : Value) :
  properUPred_ent (msc_handle G gam h)
    (mkProperPersistently (msc_handle G gam h)) =>
  \lam n x _ hex => \case hex \with {
    | inP (i, hbody) => \case hbody \with {
      | inP (_, _, _, heq, hlt) => inP (i,
          inP ((iResUR S).unit, ucmra_core {iResUR S} x,
            (iResUR S).ofe_dist_sym n
              ((iResUR S).op (iResUR S).unit (ucmra_core {iResUR S} x))
              (ucmra_core {iResUR S} x)
              (ucmra_unit_left_id_dist {iResUR S} n (ucmra_core {iResUR S} x)),
            heq, hlt))
    }
  }

\lemma msc_is_counter_persistent {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (c : Value) :
  properUPred_ent (msc_is_counter H G gam c)
    (mkProperPersistently (msc_is_counter H G gam c)) =>
  \lam n x hx hex => \case hex \with {
    | inP (a, hbody) => \case hbody \with {
      | inP (xp, xi, dx, heq, hinv) =>
        \let
          | incl_i_x : inclN {iResUR S}
              {\new Op (iResUR S).E { | op => (iResUR S).op }} xi n x =>
              inP (xp, (iResUR S).ofe_dist_trans n x
                ((iResUR S).op xp xi) ((iResUR S).op xi xp) dx
                (cmra_comm_dist {iResUR S} n xp xi))
          | core_incl : inclN {iResUR S}
              {\new Op (iResUR S).E { | op => (iResUR S).op }}
              (ucmra_core {iResUR S} xi) n (ucmra_core {iResUR S} x) =>
              ucmra_core_monoN {iResUR S} n xi x incl_i_x
          | hinv_core_i : (iris.base_logic.lib.invariants.inv H.iris_wsat mscN (msc_inv H G gam a))
              .upred_holds n (ucmra_core {iResUR S} xi) =>
              inv_persistent H.iris_wsat mscN (msc_inv H G gam a)
                n xi (validN_sub_r {iResUR S} n x xp xi hx dx) hinv
          | hinv_core_x : (iris.base_logic.lib.invariants.inv H.iris_wsat mscN (msc_inv H G gam a))
              .upred_holds n (ucmra_core {iResUR S} x) =>
              (iris.base_logic.lib.invariants.inv H.iris_wsat mscN (msc_inv H G gam a)).upred_mono
                n n (ucmra_core {iResUR S} xi) (ucmra_core {iResUR S} x)
                hinv_core_i core_incl <=-refl
        \in inP (a,
          inP ((iResUR S).unit, ucmra_core {iResUR S} x,
            (iResUR S).ofe_dist_sym n
              ((iResUR S).op (iResUR S).unit (ucmra_core {iResUR S} x))
              (ucmra_core {iResUR S} x)
              (ucmra_unit_left_id_dist {iResUR S} n (ucmra_core {iResUR S} x)),
            heq, hinv_core_x))
    }
  }

\lemma nat_le_suc_self (n : Nat) : n <= suc n \elim n
  | 0 => zero<=_
  | suc n => suc<=suc (nat_le_suc_self n)

\lemma nat_le_suc_right (r n : Nat) (h : r <= n) : r <= suc n =>
  (NatSemiring.<=∘) h (nat_le_suc_self n)

\lemma nat_suc_not_le_zero (n : Nat) : suc n <= 0 -> Empty =>
  \lam h => h (NatOrder.zero<suc {n})

-- If n < r but r is not the immediate successor of n, then S n < r.
\lemma nat_lt_advance (n r : Nat) (h : suc n <= r)
    (hne : Not (r = suc n)) : suc (suc n) <= r \elim n, r
  | 0, 0 => absurd (nat_suc_not_le_zero 0 h)
  | 0, suc 0 => absurd (hne idp)
  | 0, suc (suc r) => suc<=suc (suc<=suc zero<=_)
  | suc n, 0 => absurd (nat_suc_not_le_zero (suc n) h)
  | suc n, suc r => suc<=suc
      (nat_lt_advance n r (suc<=suc.conv h)
        (\lam e => hne (pmap suc e)))

\lemma nat_order_lt_to_msc_lt {a b : Nat}
    (h : a NatOrder.< b) : nat_lt a b => suc_<_<= h

\lemma nat_le_ne_lt (n r : Nat) (hle : n <= r)
    (hne : Not (n = r)) : nat_lt n r =>
  \case LinearOrder.<=-dec hle \with {
    | inl hlt => nat_order_lt_to_msc_lt hlt
    | inr heq => absurd (hne heq)
  }

\func msc_fresh_id {V : \Set} (m : Gmap Nat natCountable V) : Nat =>
  pmap_depth' m.gtree.tree

\lemma nat_encode_pos_pad (n : Nat) : nat_encode n = pos_pad n \elim n
  | 0 => idp
  | suc n => pmap xO (nat_encode_pos_pad n)

\lemma msc_fresh_id_absent {V : \Set}
    (m : Gmap Nat natCountable V) :
  glookup m (msc_fresh_id m) = nothing =>
  \let
    | d => pmap_depth' m.gtree.tree
    | absent : plookup' m.gtree.tree (nat_encode d) = nothing =>
        plookup'_beyond_depth m.gtree.tree (nat_encode d)
          (transport (\lam p => suc d <= pos_len p)
            (Paths.inv (nat_encode_pos_pad d))
            (transport (\lam z => suc d <= z)
              (Paths.inv (pos_pad_len d)) <=-refl))
  \in path (\lam i => \case absent @ i \with {
    | nothing => nothing
    | just p => just p.2
  })

-- Complete a pending request exactly when the authoritative total reaches its
-- prediction.  This is the semantic counterpart of the first branch of
-- Rocq's `msc_read_state_advance` proof.
\lemma msc_pending_complete {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (n : Nat) (gamQ : gname)
    (P : iProp S) (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep (msc_counter_auth G gam (suc n))
      (mkProperSep
        (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
        (mkProperSep P
          (mkProperSep
            (mkProperPersistently
              (mkProperWand
                (mkProperSep (msc_counter_auth G gam (suc n)) P)
                (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                  (mkProperSep (msc_counter_auth G gam (suc n)) (Q (suc n))))))
            (mkProperPure (nat_lt n (suc n)))))))
    (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
      (mkProperSep (msc_counter_auth G gam (suc n))
        (msc_read_state H G gam (suc n) (suc n, gamQ)))) =>
  \let
    | A => msc_counter_auth G gam (suc n)
    | Saved => saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q
    | QR => Q (suc n)
    | OldPure => mkProperPure {iResUR S} (nat_lt n (suc n))
    | NewPure => mkProperPure {iResUR S} (suc n <= suc n)
    | Shift => mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
        (mkProperSep A QR)
    | Wd => mkProperPersistently
        (mkProperWand (mkProperSep A P) Shift)
    | Source0 => mkProperSep A
        (mkProperSep Saved (mkProperSep P (mkProperSep Wd OldPure)))
    | Source1 => mkProperSep A
        (mkProperSep Saved (mkProperSep P Wd))
    | Source2 => mkProperSep Saved (mkProperSep A (mkProperSep P Wd))
    | Source3 => mkProperSep Saved (mkProperSep (mkProperSep A P) Wd)
    | Source4 => mkProperSep Saved (mkProperSep Wd (mkProperSep A P))
    | Arranged => mkProperSep (mkProperSep Wd (mkProperSep A P)) Saved
    | dropPure : properUPred_ent Source0 Source1 =>
        sep_mono_r_ent A
          (mkProperSep Saved (mkProperSep P (mkProperSep Wd OldPure)))
          (mkProperSep Saved (mkProperSep P Wd))
          (sep_mono_r_ent Saved (mkProperSep P (mkProperSep Wd OldPure))
            (mkProperSep P Wd)
            (sep_mono_r_ent P (mkProperSep Wd OldPure) Wd
              (sep_elim_l_ent Wd OldPure)))
    | arrange : properUPred_ent Source1 Arranged =>
        properUPred_ent_trans Source1 Source2 Arranged
          (sep_swap_ent A Saved (mkProperSep P Wd))
          (properUPred_ent_trans Source2 Source3 Arranged
            (sep_mono_r_ent Saved (mkProperSep A (mkProperSep P Wd))
              (mkProperSep (mkProperSep A P) Wd)
              (sep_assoc_r_ent A P Wd))
            (properUPred_ent_trans Source3 Source4 Arranged
              (sep_mono_r_ent Saved (mkProperSep (mkProperSep A P) Wd)
                (mkProperSep Wd (mkProperSep A P))
                (sep_comm_ent (mkProperSep A P) Wd))
              (sep_comm_ent Saved (mkProperSep Wd (mkProperSep A P)))))
    | invoke : properUPred_ent Arranged (mkProperSep Shift Saved) =>
        sep_mono_l_ent (mkProperSep Wd (mkProperSep A P)) Shift Saved
          (persistently_wand_elim_ent (mkProperSep A P) Shift)
    | framed : properUPred_ent (mkProperSep Shift Saved)
        (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
          (mkProperSep (mkProperSep A QR) Saved)) =>
        fupd_frame_r H.iris_wsat msc_open_mask msc_open_mask
          (mkProperSep A QR) Saved
    | qPure : properUPred_ent QR (mkProperSep QR NewPure) =>
        properUPred_ent_trans QR (mkProperSep NewPure QR)
          (mkProperSep QR NewPure)
          (pure_intro_sep_ent (suc n <= suc n) <=-refl QR)
          (sep_comm_ent NewPure QR)
    | DoneBody => mkProperSep Saved (mkProperSep QR NewPure)
    | Done => msc_read_done G (suc n) (suc n) gamQ
    | State => msc_read_state H G gam (suc n) (suc n, gamQ)
    | Finish0 => mkProperSep A (mkProperSep QR Saved)
    | Finish1 => mkProperSep A (mkProperSep Saved QR)
    | Finish2 => mkProperSep A DoneBody
    | Finish3 => mkProperSep A Done
    | finish : properUPred_ent (mkProperSep (mkProperSep A QR) Saved)
        (mkProperSep A State) =>
        properUPred_ent_trans (mkProperSep (mkProperSep A QR) Saved)
          Finish0 (mkProperSep A State)
          (sep_assoc_l_ent A QR Saved)
          (properUPred_ent_trans Finish0 Finish1 (mkProperSep A State)
            (sep_mono_r_ent A (mkProperSep QR Saved)
              (mkProperSep Saved QR) (sep_comm_ent QR Saved))
            (properUPred_ent_trans Finish1 Finish2 (mkProperSep A State)
              (sep_mono_r_ent A (mkProperSep Saved QR) DoneBody
                (sep_mono_r_ent Saved QR (mkProperSep QR NewPure) qPure))
              (properUPred_ent_trans Finish2 Finish3 (mkProperSep A State)
                (sep_mono_r_ent A DoneBody Done
                  (exist1_intro_ent (\lam R =>
                    mkProperSep
                      (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded R)
                      (mkProperSep (R (suc n)) NewPure)) Q))
                (sep_mono_r_ent A Done State
                  (or_intro_r_ent
                    (msc_read_pending H G gam (suc n) (suc n) gamQ)
                    Done)))))
    | finishF : properUPred_ent
        (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
          (mkProperSep (mkProperSep A QR) Saved))
        (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
          (mkProperSep A State)) =>
        fupd_mono H.iris_wsat msc_open_mask msc_open_mask
          (mkProperSep (mkProperSep A QR) Saved) (mkProperSep A State) finish
  \in properUPred_ent_trans Source0 Source1
      (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
        (mkProperSep A State))
      dropPure
      (properUPred_ent_trans Source1 Arranged
        (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
          (mkProperSep A State))
        arrange
        (properUPred_ent_trans Arranged (mkProperSep Shift Saved)
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
            (mkProperSep A State))
          invoke
          (properUPred_ent_trans (mkProperSep Shift Saved)
            (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
              (mkProperSep (mkProperSep A QR) Saved))
            (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
              (mkProperSep A State))
            framed finishF)))

\lemma msc_pending_wait {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (n r : Nat) (gamQ : gname)
    (P : iProp S) (Q : Nat -> iProp S)
    (hne : Not (r = suc n)) :
  properUPred_ent
    (mkProperSep (msc_counter_auth G gam (suc n))
      (mkProperSep
        (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
        (mkProperSep P
          (mkProperSep
            (mkProperPersistently
              (mkProperWand
                (mkProperSep (msc_counter_auth G gam r) P)
                (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                  (mkProperSep (msc_counter_auth G gam r) (Q r)))))
            (mkProperPure (nat_lt n r))))))
    (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
      (mkProperSep (msc_counter_auth G gam (suc n))
        (msc_read_state H G gam (suc n) (r, gamQ)))) =>
  \let
    | A => msc_counter_auth G gam (suc n)
    | Saved => saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q
    | Wd => mkProperPersistently
        (mkProperWand
          (mkProperSep (msc_counter_auth G gam r) P)
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
            (mkProperSep (msc_counter_auth G gam r) (Q r))))
    | OldPure => mkProperPure {iResUR S} (nat_lt n r)
    | NewPure => mkProperPure {iResUR S} (nat_lt (suc n) r)
    | OldBody => mkProperSep Saved
        (mkProperSep P (mkProperSep Wd OldPure))
    | NewBody => mkProperSep Saved
        (mkProperSep P (mkProperSep Wd NewPure))
    | pureStep : properUPred_ent OldPure NewPure =>
        \lam _ _ _ hlt => nat_lt_advance n r hlt hne
    | bodyStep : properUPred_ent OldBody NewBody =>
        sep_mono_r_ent Saved
          (mkProperSep P (mkProperSep Wd OldPure))
          (mkProperSep P (mkProperSep Wd NewPure))
          (sep_mono_r_ent P (mkProperSep Wd OldPure)
            (mkProperSep Wd NewPure)
            (sep_mono_r_ent Wd OldPure NewPure pureStep))
    | Pending => msc_read_pending H G gam (suc n) r gamQ
    | State => msc_read_state H G gam (suc n) (r, gamQ)
    | bodyToPending : properUPred_ent NewBody Pending =>
        properUPred_ent_trans NewBody
          (mkProperExist1 (Nat -> iProp S) (\lam R =>
            mkProperSep
              (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded R)
              (mkProperSep P
                (mkProperSep
                  (mkProperPersistently
                    (mkProperWand
                      (mkProperSep (msc_counter_auth G gam r) P)
                      (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                        (mkProperSep (msc_counter_auth G gam r) (R r)))))
                  NewPure))))
          Pending
          (exist1_intro_ent (\lam R =>
            mkProperSep
              (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded R)
              (mkProperSep P
                (mkProperSep
                  (mkProperPersistently
                    (mkProperWand
                      (mkProperSep (msc_counter_auth G gam r) P)
                      (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                        (mkProperSep (msc_counter_auth G gam r) (R r)))))
                  NewPure))) Q)
          (exist1_intro_ent (\lam R =>
            mkProperExist1 (Nat -> iProp S) (\lam T =>
              mkProperSep
                (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded T)
                (mkProperSep R
                  (mkProperSep
                    (mkProperPersistently
                      (mkProperWand
                        (mkProperSep (msc_counter_auth G gam r) R)
                        (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                          (mkProperSep (msc_counter_auth G gam r) (T r)))))
                    NewPure)))) P)
    | plain : properUPred_ent (mkProperSep A OldBody)
        (mkProperSep A State) =>
        properUPred_ent_trans (mkProperSep A OldBody)
          (mkProperSep A NewBody) (mkProperSep A State)
          (sep_mono_r_ent A OldBody NewBody bodyStep)
          (properUPred_ent_trans (mkProperSep A NewBody)
            (mkProperSep A Pending) (mkProperSep A State)
            (sep_mono_r_ent A NewBody Pending bodyToPending)
            (sep_mono_r_ent A Pending State
              (or_intro_l_ent Pending (msc_read_done G (suc n) r gamQ))))
  \in properUPred_ent_trans (mkProperSep A OldBody)
      (mkProperSep A State)
      (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
        (mkProperSep A State))
      plain (fupd_intro H.iris_wsat msc_open_mask (mkProperSep A State))

\lemma msc_done_advance {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (n r : Nat) (gamQ : gname)
    (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep (msc_counter_auth G gam (suc n))
      (mkProperSep
        (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
        (mkProperSep (Q r) (mkProperPure (r <= n)))))
    (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
      (mkProperSep (msc_counter_auth G gam (suc n))
        (msc_read_state H G gam (suc n) (r, gamQ)))) =>
  \let
    | A => msc_counter_auth G gam (suc n)
    | Saved => saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q
    | OldPure => mkProperPure {iResUR S} (r <= n)
    | NewPure => mkProperPure {iResUR S} (r <= suc n)
    | OldBody => mkProperSep Saved (mkProperSep (Q r) OldPure)
    | NewBody => mkProperSep Saved (mkProperSep (Q r) NewPure)
    | Done => msc_read_done G (suc n) r gamQ
    | State => msc_read_state H G gam (suc n) (r, gamQ)
    | pureStep : properUPred_ent OldPure NewPure =>
        \lam _ _ _ hle => nat_le_suc_right r n hle
    | bodyStep : properUPred_ent OldBody NewBody =>
        sep_mono_r_ent Saved (mkProperSep (Q r) OldPure)
          (mkProperSep (Q r) NewPure)
          (sep_mono_r_ent (Q r) OldPure NewPure pureStep)
    | bodyDone : properUPred_ent NewBody Done =>
        exist1_intro_ent (\lam R =>
          mkProperSep
            (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded R)
            (mkProperSep (R r) NewPure)) Q
    | plain : properUPred_ent (mkProperSep A OldBody)
        (mkProperSep A State) =>
        properUPred_ent_trans (mkProperSep A OldBody)
          (mkProperSep A NewBody) (mkProperSep A State)
          (sep_mono_r_ent A OldBody NewBody bodyStep)
          (properUPred_ent_trans (mkProperSep A NewBody)
            (mkProperSep A Done) (mkProperSep A State)
            (sep_mono_r_ent A NewBody Done bodyDone)
            (sep_mono_r_ent A Done State
              (or_intro_r_ent (msc_read_pending H G gam (suc n) r gamQ) Done)))
  \in properUPred_ent_trans (mkProperSep A OldBody)
      (mkProperSep A State)
      (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
        (mkProperSep A State))
      plain (fupd_intro H.iris_wsat msc_open_mask (mkProperSep A State))

\lemma msc_read_state_advance_pair {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (n r : Nat) (gamQ : gname) :
  properUPred_ent
    (mkProperSep (msc_counter_auth G gam (suc n))
      (msc_read_state H G gam n (r, gamQ)))
    (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
      (mkProperSep (msc_counter_auth G gam (suc n))
        (msc_read_state H G gam (suc n) (r, gamQ)))) =>
  \lam step x hx hsource => \case hsource \with {
    | inP (a, b, dx, hauth, byLeft hpending) => \case hpending \with {
      | inP (P, inP (Q, hbody)) =>
        \case nameDecEq r (suc n) \with {
          | inl eq =>
            (transport (\lam rr => properUPred_ent
                (mkProperSep (msc_counter_auth G gam (suc n))
                  (mkProperSep
                    (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
                    (mkProperSep P
                      (mkProperSep
                        (mkProperPersistently
                          (mkProperWand
                            (mkProperSep (msc_counter_auth G gam rr) P)
                            (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                              (mkProperSep (msc_counter_auth G gam rr) (Q rr)))))
                        (mkProperPure (nat_lt n rr))))))
                (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                  (mkProperSep (msc_counter_auth G gam (suc n))
                    (msc_read_state H G gam (suc n) (rr, gamQ)))))
              (Paths.inv eq)
              (msc_pending_complete H G gam n gamQ P Q))
              step x hx (inP (a, b, dx, hauth, hbody))
          | inr neq => msc_pending_wait H G gam n r gamQ P Q neq
              step x hx (inP (a, b, dx, hauth, hbody))
        }
    }
    | inP (a, b, dx, hauth, byRight hdone) => \case hdone \with {
      | inP (Q, hbody) => msc_done_advance H G gam n r gamQ Q
          step x hx (inP (a, b, dx, hauth, hbody))
    }
  }

\lemma msc_read_state_advance {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (n : Nat) (request : \Sigma Nat gname) :
  properUPred_ent
    (mkProperSep (msc_counter_auth G gam (suc n))
      (msc_read_state H G gam n request))
    (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
      (mkProperSep (msc_counter_auth G gam (suc n))
        (msc_read_state H G gam (suc n) request))) =>
  msc_read_state_advance_pair H G gam n request.1 request.2

\lemma msc_read_states_list_advance {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (n : Nat)
    (entries : List (\Sigma Nat (\Sigma Nat gname))) :
  properUPred_ent
    (mkProperSep (msc_counter_auth G gam (suc n))
      (big_sepL (\lam entry =>
        msc_read_state H G gam n entry.2) entries))
    (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
      (mkProperSep (msc_counter_auth G gam (suc n))
        (big_sepL (\lam entry =>
          msc_read_state H G gam (suc n) entry.2) entries)))
  \elim entries
  | nil => fupd_intro H.iris_wsat msc_open_mask
      (mkProperSep (msc_counter_auth G gam (suc n)) mkProperEmp)
  | :: entry entries =>
    \let
      | A => msc_counter_auth G gam (suc n)
      | R => msc_read_state H G gam n entry.2
      | R' => msc_read_state H G gam (suc n) entry.2
      | Rs => big_sepL (\lam e => msc_read_state H G gam n e.2) entries
      | Rs' => big_sepL (\lam e => msc_read_state H G gam (suc n) e.2) entries
      | Source => mkProperSep A (mkProperSep R Rs)
      | Swapped => mkProperSep R (mkProperSep A Rs)
      | FirstIn => mkProperSep (mkProperSep A Rs) R
      | FirstOut => mkProperSep
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
            (mkProperSep A Rs')) R
      | FirstFramed => mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
          (mkProperSep (mkProperSep A Rs') R)
      | SecondIn => mkProperSep (mkProperSep A R) Rs'
      | SecondOut => mkProperSep
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
            (mkProperSep A R')) Rs'
      | SecondFramed => mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
          (mkProperSep (mkProperSep A R') Rs')
      | TargetBody => mkProperSep A (mkProperSep R' Rs')
      | first : properUPred_ent Source FirstFramed =>
          properUPred_ent_trans Source FirstIn FirstFramed
            (properUPred_ent_trans Source Swapped FirstIn
              (sep_swap_ent A R Rs)
              (sep_comm_ent R (mkProperSep A Rs)))
            (properUPred_ent_trans FirstIn FirstOut FirstFramed
              (sep_mono_l_ent (mkProperSep A Rs)
                (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                  (mkProperSep A Rs')) R
                (msc_read_states_list_advance H G gam n entries))
              (fupd_frame_r H.iris_wsat msc_open_mask msc_open_mask
                (mkProperSep A Rs') R))
      | second : properUPred_ent (mkProperSep (mkProperSep A Rs') R)
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask TargetBody) =>
          properUPred_ent_trans (mkProperSep (mkProperSep A Rs') R)
            SecondIn
            (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask TargetBody)
            (properUPred_ent_trans (mkProperSep (mkProperSep A Rs') R)
              (mkProperSep A (mkProperSep Rs' R)) SecondIn
              (sep_assoc_l_ent A Rs' R)
              (properUPred_ent_trans (mkProperSep A (mkProperSep Rs' R))
                (mkProperSep A (mkProperSep R Rs')) SecondIn
                (sep_mono_r_ent A (mkProperSep Rs' R)
                  (mkProperSep R Rs') (sep_comm_ent Rs' R))
                (sep_assoc_r_ent A R Rs')))
            (properUPred_ent_trans SecondIn SecondOut
              (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask TargetBody)
              (sep_mono_l_ent (mkProperSep A R)
                (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                  (mkProperSep A R')) Rs'
                (msc_read_state_advance H G gam n entry.2))
              (properUPred_ent_trans SecondOut SecondFramed
                (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask TargetBody)
                (fupd_frame_r H.iris_wsat msc_open_mask msc_open_mask
                  (mkProperSep A R') Rs')
                (fupd_mono H.iris_wsat msc_open_mask msc_open_mask
                  (mkProperSep (mkProperSep A R') Rs') TargetBody
                  (sep_assoc_l_ent A R' Rs'))))
      | nested : properUPred_ent FirstFramed
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
            (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask TargetBody)) =>
          fupd_mono H.iris_wsat msc_open_mask msc_open_mask
            (mkProperSep (mkProperSep A Rs') R)
            (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask TargetBody)
            second
    \in properUPred_ent_trans Source FirstFramed
        (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask TargetBody)
        first
        (properUPred_ent_trans FirstFramed
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
            (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask TargetBody))
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask TargetBody)
          nested
          (fupd_trans H.iris_wsat msc_open_mask msc_open_mask
            msc_open_mask TargetBody))

\lemma msc_read_states_advance {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (n : Nat)
    (requests : Gmap Nat natCountable (\Sigma Nat gname)) :
  properUPred_ent
    (mkProperSep (msc_counter_auth G gam (suc n))
      (big_sepM requests (\lam _ request =>
        msc_read_state H G gam n request)))
    (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
      (mkProperSep (msc_counter_auth G gam (suc n))
        (big_sepM requests (\lam _ request =>
          msc_read_state H G gam (suc n) request)))) =>
  msc_read_states_list_advance H G gam n (gmap_to_list requests)

\lemma msc_requests_advance {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (n : Nat)
    (requests : Gmap Nat natCountable (\Sigma Nat gname)) :
  properUPred_ent
    (mkProperSep (msc_counter_auth G gam (suc n))
      (msc_requests H G gam n requests))
    (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
      (mkProperSep (msc_counter_auth G gam (suc n))
        (msc_requests H G gam (suc n) requests))) =>
  \let
    | A => msc_counter_auth G gam (suc n)
    | Map => ghost_map_auth (msc_requestGS G gam) qp_one requests
    | States => big_sepM requests (\lam _ request =>
        msc_read_state H G gam n request)
    | States' => big_sepM requests (\lam _ request =>
        msc_read_state H G gam (suc n) request)
    | Source => mkProperSep A (mkProperSep Map States)
    | Swapped => mkProperSep Map (mkProperSep A States)
    | Arranged => mkProperSep (mkProperSep A States) Map
    | Updated => mkProperSep
        (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
          (mkProperSep A States')) Map
    | Framed => mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
        (mkProperSep (mkProperSep A States') Map)
    | Target => mkProperSep A (mkProperSep Map States')
    | rearrangeFinal : properUPred_ent
        (mkProperSep (mkProperSep A States') Map) Target =>
        properUPred_ent_trans (mkProperSep (mkProperSep A States') Map)
          (mkProperSep A (mkProperSep States' Map)) Target
          (sep_assoc_l_ent A States' Map)
          (sep_mono_r_ent A (mkProperSep States' Map)
            (mkProperSep Map States') (sep_comm_ent States' Map))
  \in properUPred_ent_trans Source Arranged
      (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask Target)
      (properUPred_ent_trans Source Swapped Arranged
        (sep_swap_ent A Map States)
        (sep_comm_ent Map (mkProperSep A States)))
      (properUPred_ent_trans Arranged Updated
        (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask Target)
        (sep_mono_l_ent (mkProperSep A States)
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
            (mkProperSep A States')) Map
          (msc_read_states_advance H G gam n requests))
        (properUPred_ent_trans Updated Framed
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask Target)
          (fupd_frame_r H.iris_wsat msc_open_mask msc_open_mask
            (mkProperSep A States') Map)
          (fupd_mono H.iris_wsat msc_open_mask msc_open_mask
            (mkProperSep (mkProperSep A States') Map) Target rearrangeFinal)))

-- Agreement of the persistent saved predicates rewrites the completed
-- request payload one step later, exactly as Iris' `iRewrite` under `▷`.
\lemma msc_saved_pred_apply {S : gFunctors} (G : mscG S)
    (gamQ : gname) (Q Q' : Nat -> iProp S) (r : Nat) :
  properUPred_ent
    (mkProperSep
      (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
      (mkProperSep
        (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q')
        (Q' r)))
    (mkProperLater (Q r)) =>
  \let
    | Saved => saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q
    | Saved' => saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q'
    | Eq => mkProperInternalEq {iResUR S} {iPropO S} (Q r) (Q' r)
    | Source => mkProperSep Saved (mkProperSep Saved' (Q' r))
    | Pair => mkProperSep (mkProperSep Saved Saved') (Q' r)
    | AfterEq => mkProperSep (mkProperLater Eq) (Q' r)
    | LaterPair => mkProperSep (mkProperLater Eq) (mkProperLater (Q' r))
  \in properUPred_ent_trans Source Pair (mkProperLater (Q r))
      (sep_assoc_r_ent Saved Saved' (Q' r))
      (properUPred_ent_trans Pair LaterPair (mkProperLater (Q r))
        (properUPred_ent_trans Pair AfterEq LaterPair
          (sep_mono_l_ent (mkProperSep Saved Saved') (mkProperLater Eq) (Q' r)
            (saved_pred_agree G.msc_saved_predG gamQ DfracDiscarded
              DfracDiscarded Q Q' r))
          (sep_mono_r_ent (mkProperLater Eq) (Q' r)
            (mkProperLater (Q' r)) (proper_later_intro (Q' r))))
        (properUPred_ent_trans LaterPair
          (mkProperLater (mkProperSep Eq (Q' r))) (mkProperLater (Q r))
          (proper_later_sep_2 Eq (Q' r))
          (proper_later_mono (mkProperSep Eq (Q' r)) (Q r)
            (internal_eq_elim_r_ent (Q r) (Q' r)))))

\lemma msc_pending_take_impossible {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (total r : Nat) (gamQ : gname) (Q : Nat -> iProp S)
    (hrtotal : r <= total) :
  properUPred_ent
    (mkProperSep
      (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
      (msc_read_pending H G gam total r gamQ))
    (mkProperLater (Q r)) =>
  \lam _ _ _ hs => \case hs \with {
    | inP (_, _, _, _, inP (_, inP (_, hbody))) => \case hbody \with {
      | inP (_, _, _, _, inP (_, _, _, _, inP (_, _, _, _, hlt))) =>
        absurd (not_suc_le_self total
          ((NatSemiring.<=∘) hlt hrtotal))
    }
  }

\lemma msc_done_take {S : gFunctors} (G : mscG S)
    (total r : Nat) (gamQ : gname) (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep
      (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
      (msc_read_done G total r gamQ))
    (mkProperLater (Q r)) =>
  \lam n x hv hs => \case hs \with {
    | inP (a, b, dab, hSaved, inP (Q', hbody)) =>
      \let
        | Saved => saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q
        | Saved' => saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q'
        | Body => mkProperSep Saved' (mkProperSep (Q' r)
            (mkProperPure {iResUR S} (r <= total)))
        | Body' => mkProperSep Saved' (Q' r)
        | dropPure : properUPred_ent Body Body' =>
            sep_mono_r_ent Saved' (mkProperSep (Q' r)
              (mkProperPure {iResUR S} (r <= total))) (Q' r)
              (sep_elim_l_ent (Q' r) (mkProperPure (r <= total)))
        | source : (mkProperSep Saved Body).upred_holds n x =>
            inP (a, b, dab, hSaved, hbody)
        | prepared : (mkProperSep Saved Body').upred_holds n x =>
            sep_mono_r_ent Saved Body Body' dropPure n x hv source
      \in msc_saved_pred_apply G gamQ Q Q' r n x hv prepared
  }

\lemma msc_read_state_take {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (total r : Nat) (gamQ : gname) (Q : Nat -> iProp S)
    (hrtotal : r <= total) :
  properUPred_ent
    (mkProperSep
      (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
      (msc_read_state H G gam total (r, gamQ)))
    (mkProperLater (Q r)) =>
  \lam n x hv hs => \case hs \with {
    | inP (a, b, dab, hSaved, byLeft hpending) =>
      msc_pending_take_impossible H G gam total r gamQ Q hrtotal
        n x hv (inP (a, b, dab, hSaved, hpending))
    | inP (a, b, dab, hSaved, byRight hdone) =>
      msc_done_take G total r gamQ Q n x hv
        (inP (a, b, dab, hSaved, hdone))
  }

-- Faithful port of Rocq's `msc_request_take`: the linear request token proves
-- membership, the completed state yields the promised postcondition, and the
-- same update consumes the token and deletes the request from the map.
\lemma msc_request_take {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (total r : Nat) (gamQ : gname) (id : Nat)
    (requests : Gmap Nat natCountable (\Sigma Nat gname))
    (Q : Nat -> iProp S) (hrtotal : r <= total) :
  properUPred_ent
    (mkProperSep
      (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
      (mkProperSep
        (ghost_map_elem (msc_requestGS G gam) id (r, gamQ))
        (msc_requests H G gam total requests)))
    (mkProperBUpd
      (mkProperSep
        (msc_requests H G gam total (gdelete id requests))
        (mkProperLater (Q r)))) =>
  \let
    | Saved => saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q
    | Elem => ghost_map_elem (msc_requestGS G gam) id (r, gamQ)
    | Map => ghost_map_auth (msc_requestGS G gam) qp_one requests
    | Map' => ghost_map_auth (msc_requestGS G gam) qp_one
        (gdelete id requests)
    | States => big_sepM requests (\lam _ request =>
        msc_read_state H G gam total request)
    | State => msc_read_state H G gam total (r, gamQ)
    | Rest => big_sepM (gdelete id requests) (\lam _ request =>
        msc_read_state H G gam total request)
    | Core => mkProperSep Map Elem
    | Tail => mkProperSep Saved States
    | Source => mkProperSep Saved (mkProperSep Elem (mkProperSep Map States))
    | S1 => mkProperSep Elem (mkProperSep Saved (mkProperSep Map States))
    | S2 => mkProperSep Elem (mkProperSep Map (mkProperSep Saved States))
    | S3 => mkProperSep (mkProperSep Elem Map) Tail
    | Arranged => mkProperSep Core Tail
    | arrange : properUPred_ent Source Arranged =>
        properUPred_ent_trans Source S1 Arranged
          (sep_swap_ent Saved Elem (mkProperSep Map States))
          (properUPred_ent_trans S1 S2 Arranged
            (sep_mono_r_ent Elem
              (mkProperSep Saved (mkProperSep Map States))
              (mkProperSep Map (mkProperSep Saved States))
              (sep_swap_ent Saved Map States))
            (properUPred_ent_trans S2 S3 Arranged
              (sep_assoc_r_ent Elem Map Tail)
              (sep_mono_l_ent (mkProperSep Elem Map) Core Tail
                (sep_comm_ent Elem Map))))
    | lookup => glookup requests id = just (r, gamQ)
    | WithCoreLookup => mkProperSep (mkProperSep (mkProperPure lookup) Core) Tail
    | WithLookup => mkProperSep (mkProperPure lookup) Arranged
    | retainLookup : properUPred_ent Arranged WithLookup =>
        properUPred_ent_trans Arranged WithCoreLookup WithLookup
          (sep_mono_l_ent Core (mkProperSep (mkProperPure lookup) Core) Tail
            (pure_consequence_frame_ent Core lookup
              (ghost_map_lookup (msc_requestGS G gam) requests id (r, gamQ))))
          (sep_assoc_l_ent (mkProperPure lookup) Core Tail)
    | target => mkProperBUpd
        (mkProperSep (mkProperSep Map' Rest) (mkProperLater (Q r)))
    | perLookup : lookup -> properUPred_ent Arranged target => \lam hlookup =>
        \let
          | Tail' => mkProperSep Saved (mkProperSep State Rest)
          | Split => mkProperSep Core Tail'
          | StateRest => mkProperSep (mkProperSep Saved State) Rest
          | Ready => mkProperSep Core (mkProperSep (mkProperLater (Q r)) Rest)
          | Updated => mkProperSep (mkProperBUpd Map')
              (mkProperSep (mkProperLater (Q r)) Rest)
          | Framed => mkProperBUpd
              (mkProperSep Map' (mkProperSep (mkProperLater (Q r)) Rest))
          | finalArrange : properUPred_ent
              (mkProperSep Map' (mkProperSep (mkProperLater (Q r)) Rest))
              (mkProperSep (mkProperSep Map' Rest) (mkProperLater (Q r))) =>
              properUPred_ent_trans
                (mkProperSep Map' (mkProperSep (mkProperLater (Q r)) Rest))
                (mkProperSep (mkProperLater (Q r)) (mkProperSep Map' Rest))
                (mkProperSep (mkProperSep Map' Rest) (mkProperLater (Q r)))
                (sep_swap_ent Map' (mkProperLater (Q r)) Rest)
                (sep_comm_ent (mkProperLater (Q r)) (mkProperSep Map' Rest))
        \in properUPred_ent_trans Arranged Split target
          (sep_mono_r_ent Core Tail Tail'
            (sep_mono_r_ent Saved States (mkProperSep State Rest)
              (big_sepM_delete requests
                (\lam _ request => msc_read_state H G gam total request)
                id (r, gamQ) hlookup).1))
          (properUPred_ent_trans Split Ready target
            (properUPred_ent_trans Split (mkProperSep Core StateRest) Ready
              (sep_mono_r_ent Core Tail' StateRest
                (sep_assoc_r_ent Saved State Rest))
              (sep_mono_r_ent Core StateRest
                (mkProperSep (mkProperLater (Q r)) Rest)
                (sep_mono_l_ent (mkProperSep Saved State)
                  (mkProperLater (Q r)) Rest
                  (msc_read_state_take H G gam total r gamQ Q hrtotal))))
            (properUPred_ent_trans Ready Updated target
              (sep_mono_l_ent Core (mkProperBUpd Map')
                (mkProperSep (mkProperLater (Q r)) Rest)
                (ghost_map_delete (msc_requestGS G gam)
                  requests id (r, gamQ)))
              (properUPred_ent_trans Updated Framed target
                (bupd_frame_r Map' (mkProperSep (mkProperLater (Q r)) Rest))
                (bupd_mono
                  (mkProperSep Map' (mkProperSep (mkProperLater (Q r)) Rest))
                  (mkProperSep (mkProperSep Map' Rest) (mkProperLater (Q r)))
                  finalArrange))))
  \in properUPred_ent_trans Source WithLookup target
      (properUPred_ent_trans Source Arranged WithLookup arrange retainLookup)
      (pure_sep_l_elim lookup Arranged target perLookup)

\lemma msc_pending_intro {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (total r : Nat) (gamQ : gname) (P : iProp S)
    (Q : Nat -> iProp S) (hlt : nat_lt total r) :
  properUPred_ent
    (mkProperSep
      (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
      (mkProperSep
        (mkProperPersistently
          (mkProperWand (mkProperSep (msc_counter_auth G gam r) P)
            (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
              (mkProperSep (msc_counter_auth G gam r) (Q r)))))
        P))
    (msc_read_state H G gam total (r, gamQ)) =>
  \let
    | Saved => saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q
    | W => mkProperPersistently
        (mkProperWand (mkProperSep (msc_counter_auth G gam r) P)
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
            (mkProperSep (msc_counter_auth G gam r) (Q r))))
    | Pure => mkProperPure {iResUR S} (nat_lt total r)
    | Source => mkProperSep Saved (mkProperSep W P)
    | Reordered => mkProperSep Saved (mkProperSep P W)
    | Body => mkProperSep Saved (mkProperSep P (mkProperSep W Pure))
  \in properUPred_ent_trans Source Reordered
      (msc_read_state H G gam total (r, gamQ))
      (sep_mono_r_ent Saved (mkProperSep W P) (mkProperSep P W)
        (sep_comm_ent W P))
      (properUPred_ent_trans Reordered Body
        (msc_read_state H G gam total (r, gamQ))
        (sep_mono_r_ent Saved (mkProperSep P W)
          (mkProperSep P (mkProperSep W Pure))
          (sep_mono_r_ent P W (mkProperSep W Pure)
            (properUPred_ent_trans W (mkProperSep Pure W)
              (mkProperSep W Pure)
              (pure_intro_sep_ent (nat_lt total r) hlt W)
              (sep_comm_ent Pure W))))
        (properUPred_ent_trans Body
          (msc_read_pending H G gam total r gamQ)
          (msc_read_state H G gam total (r, gamQ))
          (\lam _ _ _ hbody => inP (P, inP (Q, hbody)))
          (or_intro_l_ent (msc_read_pending H G gam total r gamQ)
            (msc_read_done G total r gamQ))))

\lemma msc_done_intro {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (total r : Nat) (gamQ : gname) (Q : Nat -> iProp S)
    (hle : r <= total) :
  properUPred_ent
    (mkProperSep
      (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q) (Q r))
    (msc_read_state H G gam total (r, gamQ)) =>
  \let
    | Saved => saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q
    | Pure => mkProperPure {iResUR S} (r <= total)
    | Source => mkProperSep Saved (Q r)
    | Body => mkProperSep Saved (mkProperSep (Q r) Pure)
  \in properUPred_ent_trans Source Body
      (msc_read_state H G gam total (r, gamQ))
      (sep_mono_r_ent Saved (Q r) (mkProperSep (Q r) Pure)
        (properUPred_ent_trans (Q r) (mkProperSep Pure (Q r))
          (mkProperSep (Q r) Pure)
          (pure_intro_sep_ent (r <= total) hle (Q r))
          (sep_comm_ent Pure (Q r))))
      (properUPred_ent_trans Body (msc_read_done G total r gamQ)
        (msc_read_state H G gam total (r, gamQ))
        (exist1_intro_ent (\lam T => mkProperSep
          (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded T)
          (mkProperSep (T r) Pure)) Q)
        (or_intro_r_ent (msc_read_pending H G gam total r gamQ)
          (msc_read_done G total r gamQ)))

\lemma msc_request_insert {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (A : iProp S) (total : Nat)
    (requests : Gmap Nat natCountable (\Sigma Nat gname))
    (id r : Nat) (gamQ : gname) (fresh : glookup requests id = nothing) :
  properUPred_ent
    (mkProperSep A
      (mkProperSep
        (ghost_map_auth (msc_requestGS G gam) qp_one requests)
        (mkProperSep (msc_read_state H G gam total (r, gamQ))
          (big_sepM requests (\lam _ request =>
            msc_read_state H G gam total request)))))
    (mkProperBUpd
      (mkProperSep A
        (mkProperSep
          (msc_requests H G gam total
            (ginsert id (r, gamQ) requests))
          (ghost_map_elem (msc_requestGS G gam) id (r, gamQ))))) =>
  \let
    | Map => ghost_map_auth (msc_requestGS G gam) qp_one requests
    | Map' => ghost_map_auth (msc_requestGS G gam) qp_one
        (ginsert id (r, gamQ) requests)
    | Elem => ghost_map_elem (msc_requestGS G gam) id (r, gamQ)
    | State => msc_read_state H G gam total (r, gamQ)
    | States => big_sepM requests (\lam _ request =>
        msc_read_state H G gam total request)
    | States' => big_sepM (ginsert id (r, gamQ) requests)
        (\lam _ request => msc_read_state H G gam total request)
    | Pair => mkProperSep State States
    | Source => mkProperSep A (mkProperSep Map Pair)
    | Arranged => mkProperSep Map (mkProperSep A Pair)
    | Updated => mkProperSep (mkProperBUpd (mkProperSep Map' Elem))
        (mkProperSep A Pair)
    | Framed => mkProperBUpd
        (mkProperSep (mkProperSep Map' Elem) (mkProperSep A Pair))
    | TargetBody => mkProperSep A (mkProperSep
        (mkProperSep Map' States') Elem)
    | Inner0 => mkProperSep (mkProperSep Map' Elem) Pair
    | Inner1 => mkProperSep Map' (mkProperSep Elem Pair)
    | Inner2 => mkProperSep Map' (mkProperSep Pair Elem)
    | Inner3 => mkProperSep (mkProperSep Map' Pair) Elem
    | Inner4 => mkProperSep (mkProperSep Map' States') Elem
    | innerArrange : properUPred_ent Inner0 Inner4 =>
        properUPred_ent_trans Inner0 Inner1 Inner4
          (sep_assoc_l_ent Map' Elem Pair)
          (properUPred_ent_trans Inner1 Inner2 Inner4
            (sep_mono_r_ent Map' (mkProperSep Elem Pair)
              (mkProperSep Pair Elem) (sep_comm_ent Elem Pair))
            (properUPred_ent_trans Inner2 Inner3 Inner4
              (sep_assoc_r_ent Map' Pair Elem)
              (sep_mono_l_ent (mkProperSep Map' Pair)
                (mkProperSep Map' States') Elem
                (sep_mono_r_ent Map' Pair States'
                  (big_sepM_insert requests
                    (\lam _ request => msc_read_state H G gam total request)
                    id (r, gamQ) fresh).2))))
    | finalArrange : properUPred_ent
        (mkProperSep (mkProperSep Map' Elem) (mkProperSep A Pair))
        TargetBody =>
        properUPred_ent_trans
          (mkProperSep (mkProperSep Map' Elem) (mkProperSep A Pair))
          (mkProperSep A Inner0) TargetBody
          (sep_swap_ent (mkProperSep Map' Elem) A Pair)
          (sep_mono_r_ent A Inner0 Inner4 innerArrange)
  \in properUPred_ent_trans Source Arranged
      (mkProperBUpd TargetBody)
      (sep_swap_ent A Map Pair)
      (properUPred_ent_trans Arranged Updated
        (mkProperBUpd TargetBody)
        (sep_mono_l_ent Map (mkProperBUpd (mkProperSep Map' Elem))
          (mkProperSep A Pair)
          (ghost_map_insert (msc_requestGS G gam) requests id (r, gamQ) fresh))
        (properUPred_ent_trans Updated Framed
          (mkProperBUpd TargetBody)
          (bupd_frame_r (mkProperSep Map' Elem) (mkProperSep A Pair))
          (bupd_mono
            (mkProperSep (mkProperSep Map' Elem) (mkProperSep A Pair))
            TargetBody finalArrange)))

\lemma msc_request_register_pending {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (total r : Nat) (gamQ : gname)
    (requests : Gmap Nat natCountable (\Sigma Nat gname))
    (P : iProp S) (Q : Nat -> iProp S) (hlt : nat_lt total r) :
  properUPred_ent
    (mkProperSep (msc_counter_auth G gam total)
      (mkProperSep
        (ghost_map_auth (msc_requestGS G gam) qp_one requests)
        (mkProperSep
          (mkProperSep
            (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
            (mkProperSep
              (mkProperPersistently
                (mkProperWand (mkProperSep (msc_counter_auth G gam r) P)
                  (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                    (mkProperSep (msc_counter_auth G gam r) (Q r)))))
              P))
          (big_sepM requests (\lam _ request =>
            msc_read_state H G gam total request)))))
    (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
      (mkProperExist Nat (\lam id =>
        mkProperSep (msc_counter_auth G gam total)
          (mkProperSep
            (msc_requests H G gam total
              (ginsert id (r, gamQ) requests))
            (ghost_map_elem (msc_requestGS G gam) id (r, gamQ)))))) =>
  \let
    | id => msc_fresh_id requests
    | fresh => msc_fresh_id_absent requests
    | A => msc_counter_auth G gam total
    | Map => ghost_map_auth (msc_requestGS G gam) qp_one requests
    | Input => mkProperSep
        (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
        (mkProperSep
          (mkProperPersistently
            (mkProperWand (mkProperSep (msc_counter_auth G gam r) P)
              (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                (mkProperSep (msc_counter_auth G gam r) (Q r))))) P)
    | State => msc_read_state H G gam total (r, gamQ)
    | States => big_sepM requests (\lam _ request =>
        msc_read_state H G gam total request)
    | Source => mkProperSep A (mkProperSep Map (mkProperSep Input States))
    | Prepared => mkProperSep A (mkProperSep Map (mkProperSep State States))
    | Body => mkProperSep A
        (mkProperSep
          (msc_requests H G gam total (ginsert id (r, gamQ) requests))
          (ghost_map_elem (msc_requestGS G gam) id (r, gamQ)))
    | Exists => mkProperExist Nat (\lam j => mkProperSep A
        (mkProperSep
          (msc_requests H G gam total (ginsert j (r, gamQ) requests))
          (ghost_map_elem (msc_requestGS G gam) j (r, gamQ))))
  \in properUPred_ent_trans Source Prepared
      (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask Exists)
      (sep_mono_r_ent A (mkProperSep Map (mkProperSep Input States))
        (mkProperSep Map (mkProperSep State States))
        (sep_mono_r_ent Map (mkProperSep Input States)
          (mkProperSep State States)
          (sep_mono_l_ent Input State States
            (msc_pending_intro H G gam total r gamQ P Q hlt))))
      (properUPred_ent_trans Prepared (mkProperBUpd Body)
        (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask Exists)
        (msc_request_insert H G gam A total requests id r gamQ fresh)
        (properUPred_ent_trans (mkProperBUpd Body)
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask Body)
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask Exists)
          (bupd_fupd H.iris_wsat msc_open_mask Body)
          (fupd_mono H.iris_wsat msc_open_mask msc_open_mask Body Exists
            (exist_intro_ent (\lam j => mkProperSep A
              (mkProperSep
                (msc_requests H G gam total
                  (ginsert j (r, gamQ) requests))
                (ghost_map_elem (msc_requestGS G gam) j (r, gamQ)))) id))))

\lemma msc_request_register_done {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (r : Nat) (gamQ : gname)
    (requests : Gmap Nat natCountable (\Sigma Nat gname))
    (P : iProp S) (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep (msc_counter_auth G gam r)
      (mkProperSep
        (ghost_map_auth (msc_requestGS G gam) qp_one requests)
        (mkProperSep
          (mkProperSep
            (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
            (mkProperSep
              (mkProperPersistently
                (mkProperWand (mkProperSep (msc_counter_auth G gam r) P)
                  (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                    (mkProperSep (msc_counter_auth G gam r) (Q r)))))
              P))
          (big_sepM requests (\lam _ request =>
            msc_read_state H G gam r request)))))
    (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
      (mkProperExist Nat (\lam id =>
        mkProperSep (msc_counter_auth G gam r)
          (mkProperSep
            (msc_requests H G gam r (ginsert id (r, gamQ) requests))
            (ghost_map_elem (msc_requestGS G gam) id (r, gamQ)))))) =>
  \let
    | id => msc_fresh_id requests
    | fresh => msc_fresh_id_absent requests
    | A => msc_counter_auth G gam r
    | Map => ghost_map_auth (msc_requestGS G gam) qp_one requests
    | Saved => saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q
    | W => mkProperPersistently
        (mkProperWand (mkProperSep A P)
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
            (mkProperSep A (Q r))))
    | States => big_sepM requests (\lam _ request =>
        msc_read_state H G gam r request)
    | Input0 => mkProperSep Saved (mkProperSep W P)
    | Input1 => mkProperSep W (mkProperSep P Saved)
    | X => mkProperSep (mkProperSep P Saved) States
    | Tail0 => mkProperSep Input0 States
    | Tail1 => mkProperSep W X
    | Source => mkProperSep A (mkProperSep Map Tail0)
    | S1 => mkProperSep A (mkProperSep Map Tail1)
    | S2 => mkProperSep A (mkProperSep W (mkProperSep Map X))
    | S3 => mkProperSep W (mkProperSep A (mkProperSep Map X))
    | Frame => mkProperSep Saved (mkProperSep Map States)
    | Rest0 => mkProperSep A (mkProperSep Map X)
    | Rest1 => mkProperSep A (mkProperSep Map
        (mkProperSep P (mkProperSep Saved States)))
    | Rest2 => mkProperSep A (mkProperSep P
        (mkProperSep Map (mkProperSep Saved States)))
    | Rest3 => mkProperSep A (mkProperSep P Frame)
    | Rest4 => mkProperSep (mkProperSep A P) Frame
    | Ready => mkProperSep W Rest4
    | SplitReady => mkProperSep (mkProperSep W (mkProperSep A P)) Frame
    | FirstUpdated => mkProperSep
        (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
          (mkProperSep A (Q r))) Frame
    | FirstFramed => mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
        (mkProperSep (mkProperSep A (Q r)) Frame)
    | Body0 => mkProperSep (mkProperSep A (Q r)) Frame
    | B1 => mkProperSep A (mkProperSep (Q r) Frame)
    | B2 => mkProperSep A (mkProperSep Saved
        (mkProperSep (Q r) (mkProperSep Map States)))
    | B3 => mkProperSep A (mkProperSep Saved
        (mkProperSep Map (mkProperSep (Q r) States)))
    | B4 => mkProperSep A (mkProperSep Map
        (mkProperSep Saved (mkProperSep (Q r) States)))
    | Prepared0 => mkProperSep A (mkProperSep Map
        (mkProperSep (mkProperSep Saved (Q r)) States))
    | State => msc_read_state H G gam r (r, gamQ)
    | Prepared => mkProperSep A (mkProperSep Map
        (mkProperSep State States))
    | Result => mkProperSep A
        (mkProperSep
          (msc_requests H G gam r (ginsert id (r, gamQ) requests))
          (ghost_map_elem (msc_requestGS G gam) id (r, gamQ)))
    | Exists => mkProperExist Nat (\lam j => mkProperSep A
        (mkProperSep
          (msc_requests H G gam r (ginsert j (r, gamQ) requests))
          (ghost_map_elem (msc_requestGS G gam) j (r, gamQ))))
    | inputArrange : properUPred_ent Input0 Input1 =>
        properUPred_ent_trans Input0 (mkProperSep W (mkProperSep Saved P)) Input1
          (sep_swap_ent Saved W P)
          (sep_mono_r_ent W (mkProperSep Saved P)
            (mkProperSep P Saved) (sep_comm_ent Saved P))
    | sourceStep1 : properUPred_ent Source S1 =>
        sep_mono_r_ent A (mkProperSep Map Tail0)
          (mkProperSep Map Tail1)
          (sep_mono_r_ent Map Tail0 Tail1
            (properUPred_ent_trans Tail0 (mkProperSep Input1 States) Tail1
              (sep_mono_l_ent Input0 Input1 States inputArrange)
              (sep_assoc_l_ent W (mkProperSep P Saved) States)))
    | rest01 : properUPred_ent Rest0 Rest1 =>
        sep_mono_r_ent A (mkProperSep Map X)
          (mkProperSep Map (mkProperSep P (mkProperSep Saved States)))
          (sep_mono_r_ent Map X
            (mkProperSep P (mkProperSep Saved States))
            (sep_assoc_l_ent P Saved States))
    | rest12 : properUPred_ent Rest1 Rest2 =>
        sep_mono_r_ent A
          (mkProperSep Map (mkProperSep P (mkProperSep Saved States)))
          (mkProperSep P (mkProperSep Map (mkProperSep Saved States)))
          (sep_swap_ent Map P (mkProperSep Saved States))
    | rest23 : properUPred_ent Rest2 Rest3 =>
        sep_mono_r_ent A
          (mkProperSep P (mkProperSep Map (mkProperSep Saved States)))
          (mkProperSep P Frame)
          (sep_mono_r_ent P
            (mkProperSep Map (mkProperSep Saved States)) Frame
            (sep_swap_ent Map Saved States))
    | rest34 : properUPred_ent Rest3 Rest4 => sep_assoc_r_ent A P Frame
    | rest02 : properUPred_ent Rest0 Rest2 =>
        properUPred_ent_trans Rest0 Rest1 Rest2 rest01 rest12
    | rest04 : properUPred_ent Rest0 Rest4 =>
        properUPred_ent_trans Rest0 Rest2 Rest4 rest02
          (properUPred_ent_trans Rest2 Rest3 Rest4 rest23 rest34)
    | source12 : properUPred_ent S1 S2 =>
        sep_mono_r_ent A (mkProperSep Map Tail1)
          (mkProperSep W (mkProperSep Map X)) (sep_swap_ent Map W X)
    | source23 : properUPred_ent S2 S3 => sep_swap_ent A W (mkProperSep Map X)
    | source3Ready : properUPred_ent S3 Ready =>
        sep_mono_r_ent W Rest0 Rest4 rest04
    | sourceReadySplit : properUPred_ent Ready SplitReady =>
        sep_assoc_r_ent W (mkProperSep A P) Frame
    | source2Split : properUPred_ent S2 SplitReady =>
        properUPred_ent_trans S2 S3 SplitReady source23
          (properUPred_ent_trans S3 Ready SplitReady source3Ready sourceReadySplit)
    | sourceRest : properUPred_ent S1 SplitReady =>
        properUPred_ent_trans S1 S2 SplitReady source12 source2Split
    | sourceArrange : properUPred_ent Source SplitReady =>
        properUPred_ent_trans Source S1 SplitReady sourceStep1 sourceRest
    | body01 : properUPred_ent Body0 B1 => sep_assoc_l_ent A (Q r) Frame
    | body12 : properUPred_ent B1 B2 =>
        sep_mono_r_ent A (mkProperSep (Q r) Frame)
          (mkProperSep Saved (mkProperSep (Q r) (mkProperSep Map States)))
          (sep_swap_ent (Q r) Saved (mkProperSep Map States))
    | body23 : properUPred_ent B2 B3 =>
        sep_mono_r_ent A
          (mkProperSep Saved (mkProperSep (Q r) (mkProperSep Map States)))
          (mkProperSep Saved (mkProperSep Map (mkProperSep (Q r) States)))
          (sep_mono_r_ent Saved
            (mkProperSep (Q r) (mkProperSep Map States))
            (mkProperSep Map (mkProperSep (Q r) States))
            (sep_swap_ent (Q r) Map States))
    | body34 : properUPred_ent B3 B4 =>
        sep_mono_r_ent A
          (mkProperSep Saved (mkProperSep Map (mkProperSep (Q r) States)))
          (mkProperSep Map (mkProperSep Saved (mkProperSep (Q r) States)))
          (sep_swap_ent Saved Map (mkProperSep (Q r) States))
    | body4Prepared0 : properUPred_ent B4 Prepared0 =>
        sep_mono_r_ent A
          (mkProperSep Map (mkProperSep Saved (mkProperSep (Q r) States)))
          (mkProperSep Map (mkProperSep (mkProperSep Saved (Q r)) States))
          (sep_mono_r_ent Map
            (mkProperSep Saved (mkProperSep (Q r) States))
            (mkProperSep (mkProperSep Saved (Q r)) States)
            (sep_assoc_r_ent Saved (Q r) States))
    | bodyPrepared : properUPred_ent Prepared0 Prepared =>
        sep_mono_r_ent A
          (mkProperSep Map (mkProperSep (mkProperSep Saved (Q r)) States))
          (mkProperSep Map (mkProperSep State States))
          (sep_mono_r_ent Map
            (mkProperSep (mkProperSep Saved (Q r)) States)
            (mkProperSep State States)
            (sep_mono_l_ent (mkProperSep Saved (Q r)) State States
              (msc_done_intro H G gam r r gamQ Q <=-refl)))
    | body02 : properUPred_ent Body0 B2 =>
        properUPred_ent_trans Body0 B1 B2 body01 body12
    | body24 : properUPred_ent B2 B4 =>
        properUPred_ent_trans B2 B3 B4 body23 body34
    | body0Prepared0 : properUPred_ent Body0 Prepared0 =>
        properUPred_ent_trans Body0 B2 Prepared0 body02
          (properUPred_ent_trans B2 B4 Prepared0 body24 body4Prepared0)
    | bodyArrange : properUPred_ent Body0 Prepared =>
        properUPred_ent_trans Body0 Prepared0 Prepared body0Prepared0 bodyPrepared
    | continue : properUPred_ent Body0
        (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask Exists) =>
        properUPred_ent_trans Body0 Prepared
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask Exists)
          bodyArrange
          (properUPred_ent_trans Prepared (mkProperBUpd Result)
            (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask Exists)
            (msc_request_insert H G gam A r requests id r gamQ fresh)
            (properUPred_ent_trans (mkProperBUpd Result)
              (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask Result)
              (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask Exists)
              (bupd_fupd H.iris_wsat msc_open_mask Result)
              (fupd_mono H.iris_wsat msc_open_mask msc_open_mask Result Exists
                (exist_intro_ent (\lam j => mkProperSep A
                  (mkProperSep
                    (msc_requests H G gam r
                      (ginsert j (r, gamQ) requests))
                    (ghost_map_elem (msc_requestGS G gam) j (r, gamQ)))) id))))
  \in properUPred_ent_trans Source SplitReady
      (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask Exists)
      sourceArrange
      (properUPred_ent_trans SplitReady FirstUpdated
        (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask Exists)
        (sep_mono_l_ent (mkProperSep W (mkProperSep A P))
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
            (mkProperSep A (Q r))) Frame
          (persistently_wand_elim_ent (mkProperSep A P)
            (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
              (mkProperSep A (Q r)))))
        (properUPred_ent_trans FirstUpdated FirstFramed
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask Exists)
          (fupd_frame_r H.iris_wsat msc_open_mask msc_open_mask
            (mkProperSep A (Q r)) Frame)
          (properUPred_ent_trans FirstFramed
            (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
              (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask Exists))
            (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask Exists)
            (fupd_mono H.iris_wsat msc_open_mask msc_open_mask Body0
              (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask Exists)
              continue)
            (fupd_trans H.iris_wsat msc_open_mask msc_open_mask
              msc_open_mask Exists))))

-- Rocq `msc_request_register`, with the spatial context grouped to expose the
-- exact state consumed by the two arithmetic branches.
\lemma msc_request_register {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (total r : Nat) (gamQ : gname)
    (requests : Gmap Nat natCountable (\Sigma Nat gname))
    (P : iProp S) (Q : Nat -> iProp S) (htotalr : total <= r) :
  properUPred_ent
    (mkProperSep (msc_counter_auth G gam total)
      (mkProperSep
        (ghost_map_auth (msc_requestGS G gam) qp_one requests)
        (mkProperSep
          (mkProperSep
            (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
            (mkProperSep
              (mkProperPersistently
                (mkProperWand (mkProperSep (msc_counter_auth G gam r) P)
                  (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                    (mkProperSep (msc_counter_auth G gam r) (Q r)))))
              P))
          (big_sepM requests (\lam _ request =>
            msc_read_state H G gam total request)))))
    (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
      (mkProperExist Nat (\lam id =>
        mkProperSep (msc_counter_auth G gam total)
          (mkProperSep
            (msc_requests H G gam total (ginsert id (r, gamQ) requests))
            (ghost_map_elem (msc_requestGS G gam) id (r, gamQ)))))) =>
  \let
    | Source => \lam t => mkProperSep (msc_counter_auth G gam t)
        (mkProperSep
          (ghost_map_auth (msc_requestGS G gam) qp_one requests)
          (mkProperSep
            (mkProperSep
              (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
              (mkProperSep
                (mkProperPersistently
                  (mkProperWand (mkProperSep (msc_counter_auth G gam r) P)
                    (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                      (mkProperSep (msc_counter_auth G gam r) (Q r))))) P))
            (big_sepM requests (\lam _ request =>
              msc_read_state H G gam t request))))
    | Target => \lam t => mkProperFUpd H.iris_wsat
        msc_open_mask msc_open_mask
        (mkProperExist Nat (\lam id =>
          mkProperSep (msc_counter_auth G gam t)
            (mkProperSep
              (msc_requests H G gam t (ginsert id (r, gamQ) requests))
              (ghost_map_elem (msc_requestGS G gam) id (r, gamQ)))))
  \in \case LinearOrder.<=-dec htotalr \with {
    | inl hlt => msc_request_register_pending H G gam total r gamQ
        requests P Q (nat_order_lt_to_msc_lt hlt)
    | inr heq => transport (\lam t => properUPred_ent (Source t) (Target t))
        (Paths.inv heq) (msc_request_register_done H G gam r gamQ requests P Q)
  }

-- Allocate one monotone authority for each shard, all initially zero.
\lemma msc_mono_alloc_zeros {S : gFunctors} (G : mscG S) (T : Nat) :
  properUPred_ent mkProperEmp
    (mkProperBUpd (mkProperExist (List gname) (\lam gams =>
      mkProperSep (mkProperPure (length gams = T))
        (msc_mono_auths G (replicate T 0) gams))))
  \elim T
  | 0 => properUPred_ent_trans mkProperEmp
      (mkProperExist (List gname) (\lam gams =>
        mkProperSep (mkProperPure (length gams = 0))
          (msc_mono_auths G nil gams)))
      (mkProperBUpd (mkProperExist (List gname) (\lam gams =>
        mkProperSep (mkProperPure (length gams = 0))
          (msc_mono_auths G nil gams))))
      (properUPred_ent_trans mkProperEmp
        (mkProperSep (mkProperPure {iResUR S} (length (nil {gname}) = 0))
          (msc_mono_auths G nil nil))
        (mkProperExist (List gname) (\lam gams =>
          mkProperSep (mkProperPure (length gams = 0))
            (msc_mono_auths G nil gams)))
        (pure_intro_sep_ent {iResUR S} (length (nil {gname}) = 0) idp
          (mkProperEmp {iResUR S}))
        (exist_intro_ent (\lam gams =>
          mkProperSep (mkProperPure (length gams = 0))
            (msc_mono_auths G nil gams)) nil))
      (bupd_intro (mkProperExist (List gname) (\lam gams =>
        mkProperSep (mkProperPure (length gams = 0))
          (msc_mono_auths G nil gams))))
  | suc T =>
      \let
        | Old => mkProperExist (List gname) (\lam gams =>
            mkProperSep (mkProperPure (length gams = T))
              (msc_mono_auths G (replicate T 0) gams))
        | New => mkProperExist gname (\lam gam => mkProperSep
            (mono_nat_auth_own G.msc_mono_natG gam qp_one 0)
            (mono_nat_lb_own G.msc_mono_natG gam 0))
        | Target => mkProperExist (List gname) (\lam gams =>
            mkProperSep (mkProperPure (length gams = suc T))
              (msc_mono_auths G (replicate (suc T) 0) gams))
        | combine : properUPred_ent (mkProperSep New Old) Target =>
            \lam n x hv hs => \case hs \with {
              | inP (newRes, oldRes, dx, inP (gam, hnew), inP (gams, hold)) =>
                \case hnew, hold \with {
                  | inP (ga, glb, dnew, hauth, _),
                      inP (gp, gas, dold, hlen, hauths) =>
                    \let
                      | combined : (msc_mono_auths G
                          (replicate (suc T) 0) (gam :: gams)).upred_holds n
                          ((iResUR S).op ga gas) =>
                          inP (ga, gas,
                            (iResUR S).ofe_dist_refl n
                              ((iResUR S).op ga gas), hauth, hauths)
                      | incl : inclN {iResUR S}
                          {\new Op (iResUR S).E { | op => (iResUR S).op }}
                          ((iResUR S).op ga gas) n x =>
                          inP ((iResUR S).op glb gp,
                            (iResUR S).ofe_dist_trans n x
                              ((iResUR S).op
                                ((iResUR S).op ga glb)
                                ((iResUR S).op gp gas))
                              ((iResUR S).op ((iResUR S).op ga gas)
                                ((iResUR S).op glb gp))
                              ((iResUR S).ofe_dist_trans n x
                                ((iResUR S).op newRes oldRes)
                                ((iResUR S).op
                                  ((iResUR S).op ga glb)
                                  ((iResUR S).op gp gas)) dx
                                ((iResUR S).ofe_dist_trans n
                                  ((iResUR S).op newRes oldRes)
                                  ((iResUR S).op ((iResUR S).op ga glb) oldRes)
                                  ((iResUR S).op
                                    ((iResUR S).op ga glb)
                                    ((iResUR S).op gp gas))
                                  ((iResUR S).cmra_op_ne_2 oldRes n newRes
                                    ((iResUR S).op ga glb) dnew)
                                  ((iResUR S).cmra_op_ne
                                    ((iResUR S).op ga glb) n oldRes
                                    ((iResUR S).op gp gas) dold)))
                              (op_regroup_swap {iResUR S} n ga glb gp gas))
                      | combinedAtX => (msc_mono_auths G
                          (replicate (suc T) 0) (gam :: gams)).upred_mono
                          n n ((iResUR S).op ga gas) x combined incl <=-refl
                    \in inP (gam :: gams,
                      inP ((iResUR S).unit, x,
                        (iResUR S).ofe_dist_sym n
                          ((iResUR S).op (iResUR S).unit x) x
                          (ucmra_unit_left_id_dist {iResUR S} n x),
                        pmap suc hlen, combinedAtX))
                }
            }
        | nested : properUPred_ent mkProperEmp
            (mkProperBUpd (mkProperBUpd (mkProperSep New Old))) =>
            properUPred_ent_trans mkProperEmp (mkProperBUpd Old)
              (mkProperBUpd (mkProperBUpd (mkProperSep New Old)))
              (msc_mono_alloc_zeros G T)
              (bupd_mono Old (mkProperBUpd (mkProperSep New Old))
                (bupd_alloc_frame New Old
                  (mono_nat_own_alloc G.msc_mono_natG 0)))
      \in properUPred_ent_trans mkProperEmp
          (mkProperBUpd (mkProperSep New Old)) (mkProperBUpd Target)
          (properUPred_ent_trans mkProperEmp
            (mkProperBUpd (mkProperBUpd (mkProperSep New Old)))
            (mkProperBUpd (mkProperSep New Old)) nested
            (bupd_trans (mkProperSep New Old)))
          (bupd_mono (mkProperSep New Old) Target combine)

-- Every list of monotone lower bounds is persistent.  This is the recursive
-- term-mode counterpart of Iris' type-class inference for `Persistent` under
-- `big_sepL2`.
\lemma msc_lbs_persistent {S : gFunctors} (G : mscG S)
    (ns : List Nat) (gams : List gname) :
  properUPred_ent (msc_lbs G ns gams)
    (mkProperPersistently (msc_lbs G ns gams))
  \elim ns, gams
  | nil, nil => \lam n x _ _ =>
      inP (ucmra_core {iResUR S} x,
        (iResUR S).ofe_dist_sym n
          ((iResUR S).op (iResUR S).unit (ucmra_core {iResUR S} x))
          (ucmra_core {iResUR S} x)
          (ucmra_unit_left_id_dist {iResUR S} n
            (ucmra_core {iResUR S} x)))
  | :: n ns, :: gam gams =>
      \let
        | Head => msc_shard_lb G gam n
        | Tail => msc_lbs G ns gams
        | Middle => mkProperSep
            (mkProperPersistently Head) (mkProperPersistently Tail)
        | left : properUPred_ent (mkProperSep Head Tail)
            (mkProperSep (mkProperPersistently Head) Tail) =>
            sep_mono_l_ent Head (mkProperPersistently Head) Tail
              (mono_nat_lb_own_persistent G.msc_mono_natG gam n)
        | right : properUPred_ent
            (mkProperSep (mkProperPersistently Head) Tail) Middle =>
            sep_mono_r_ent (mkProperPersistently Head) Tail
              (mkProperPersistently Tail) (msc_lbs_persistent G ns gams)
      \in properUPred_ent_trans (mkProperSep Head Tail) Middle
          (mkProperPersistently (mkProperSep Head Tail))
          (properUPred_ent_trans (mkProperSep Head Tail)
            (mkProperSep (mkProperPersistently Head) Tail) Middle left right)
          (persistently_sep_2_ent Head Tail)
  | nil, :: _ _ => properUPred_ent_refl (mkProperPure {iResUR S} Empty)
  | :: _ _, nil => properUPred_ent_refl (mkProperPure {iResUR S} Empty)

-- Snapshot all monotone authorities without consuming them.
\lemma msc_mono_auths_to_lbs {S : gFunctors} (G : mscG S)
    (ns : List Nat) (gams : List gname) :
  properUPred_ent (msc_mono_auths G ns gams) (msc_lbs G ns gams)
  \elim ns, gams
  | nil, nil => properUPred_ent_refl (mkProperEmp {iResUR S})
  | :: n ns, :: gam gams =>
      \let
        | Auth => mono_nat_auth_own G.msc_mono_natG gam qp_one n
        | LB => msc_shard_lb G gam n
        | Auths => msc_mono_auths G ns gams
        | LBs => msc_lbs G ns gams
        | middle : properUPred_ent (mkProperSep Auth Auths)
            (mkProperSep LB Auths) =>
            sep_mono_l_ent Auth LB Auths
              (mono_nat_lb_own_get G.msc_mono_natG gam qp_one n)
        | finish : properUPred_ent (mkProperSep LB Auths)
            (mkProperSep LB LBs) =>
            sep_mono_r_ent LB Auths LBs (msc_mono_auths_to_lbs G ns gams)
      \in properUPred_ent_trans (mkProperSep Auth Auths)
          (mkProperSep LB Auths) (mkProperSep LB LBs) middle finish
  | nil, :: _ _ => properUPred_ent_refl (mkProperPure {iResUR S} Empty)
  | :: _ _, nil => properUPred_ent_refl (mkProperPure {iResUR S} Empty)

\lemma msc_monos_snapshot {S : gFunctors} (G : mscG S)
    (ns : List Nat) (gams : List gname) :
  properUPred_ent (msc_mono_auths G ns gams)
    (mkProperSep (msc_mono_auths G ns gams) (msc_lbs G ns gams)) =>
  persistent_consequence_frame_ent
    (msc_mono_auths G ns gams) (msc_lbs G ns gams)
    (properUPred_ent_trans (msc_mono_auths G ns gams)
      (msc_lbs G ns gams)
      (mkProperPersistently (msc_lbs G ns gams))
      (msc_mono_auths_to_lbs G ns gams)
      (msc_lbs_persistent G ns gams))

-- Pointwise monotone lower bounds imply the corresponding bound on the sum.
-- The mismatched-list branches are uninhabited by the definition of the
-- big_sepL2-style assertions.
\lemma msc_lbs_sum_le {S : gFunctors} (G : mscG S)
    (xs ys : List Nat) (gams : List gname) :
  properUPred_ent
    (mkProperSep (msc_lbs G xs gams) (msc_mono_auths G ys gams))
    (mkProperPure (nat_sum xs <= nat_sum ys))
  \elim xs, ys, gams
  | nil, nil, nil => \lam _ _ _ _ => zero<=_
  | :: x xs, :: y ys, :: gam gams =>
      \let
        | LX => msc_shard_lb G gam x
        | LXS => msc_lbs G xs gams
        | AY => mono_nat_auth_own G.msc_mono_natG gam qp_one y
        | AYS => msc_mono_auths G ys gams
        | Head => mkProperSep AY LX
        | Tail => mkProperSep LXS AYS
        | Source => mkProperSep (mkProperSep LX LXS)
            (mkProperSep AY AYS)
        | S1 => mkProperSep LX (mkProperSep LXS (mkProperSep AY AYS))
        | S2 => mkProperSep LX (mkProperSep AY Tail)
        | S3 => mkProperSep AY (mkProperSep LX Tail)
        | Prepared => mkProperSep Head Tail
        | arrange01 : properUPred_ent Source S1 =>
            sep_assoc_l_ent LX LXS (mkProperSep AY AYS)
        | arrange12 : properUPred_ent S1 S2 =>
            sep_mono_r_ent LX (mkProperSep LXS (mkProperSep AY AYS))
              (mkProperSep AY Tail) (sep_swap_ent LXS AY AYS)
        | arrange23 : properUPred_ent S2 S3 =>
            sep_swap_ent LX AY Tail
        | arrange3P : properUPred_ent S3 Prepared =>
            sep_assoc_r_ent AY LX Tail
        | arrange : properUPred_ent Source Prepared =>
            properUPred_ent_trans Source S1 Prepared arrange01
              (properUPred_ent_trans S1 S2 Prepared arrange12
                (properUPred_ent_trans S2 S3 Prepared arrange23 arrange3P))
        | headBound : properUPred_ent Head
            (mkProperPure (\Sigma
              (qp_one.qp_val RatField.<= RatField.ide) (x <= y))) =>
            mono_nat_lb_own_valid G.msc_mono_natG gam qp_one y x
        | tailBound : properUPred_ent Tail
            (mkProperPure (nat_sum xs <= nat_sum ys)) =>
            msc_lbs_sum_le G xs ys gams
        | bounds : properUPred_ent Prepared
            (mkProperSep
              (mkProperPure (\Sigma
                (qp_one.qp_val RatField.<= RatField.ide) (x <= y)))
              (mkProperPure (nat_sum xs <= nat_sum ys))) =>
            properUPred_ent_trans Prepared
              (mkProperSep
                (mkProperPure (\Sigma
                  (qp_one.qp_val RatField.<= RatField.ide) (x <= y))) Tail)
              (mkProperSep
                (mkProperPure (\Sigma
                  (qp_one.qp_val RatField.<= RatField.ide) (x <= y)))
                (mkProperPure (nat_sum xs <= nat_sum ys)))
              (sep_mono_l_ent Head
                (mkProperPure (\Sigma
                  (qp_one.qp_val RatField.<= RatField.ide) (x <= y)))
                Tail headBound)
              (sep_mono_r_ent
                (mkProperPure (\Sigma
                  (qp_one.qp_val RatField.<= RatField.ide) (x <= y)))
                Tail (mkProperPure (nat_sum xs <= nat_sum ys)) tailBound)
        | conclude : properUPred_ent {iResUR S}
            (mkProperSep {iResUR S}
              (mkProperPure {iResUR S} (\Sigma
                (qp_one.qp_val RatField.<= RatField.ide) (x <= y)))
              (mkProperPure {iResUR S} (nat_sum xs <= nat_sum ys)))
            (mkProperPure {iResUR S}
              (x Nat.+ nat_sum xs <= y Nat.+ nat_sum ys)) =>
            \lam _ _ _ h => \case h \with {
              | inP (_, _, _, hxy, hsum) => NatSemiring.<=_+ hxy.2 hsum
            }
      \in properUPred_ent_trans Source Prepared
          (mkProperPure (x Nat.+ nat_sum xs <= y Nat.+ nat_sum ys))
          arrange (properUPred_ent_trans Prepared
            (mkProperSep
              (mkProperPure (\Sigma
                (qp_one.qp_val RatField.<= RatField.ide) (x <= y)))
              (mkProperPure (nat_sum xs <= nat_sum ys)))
            (mkProperPure (x Nat.+ nat_sum xs <= y Nat.+ nat_sum ys))
            bounds conclude)
  | nil, nil, :: _ _ => \lam _ _ _ h => \case h \with {
      | inP (_, _, _, impossible, _) => \case impossible \with {}
    }
  | nil, :: _ _, nil => \lam _ _ _ h => \case h \with {
      | inP (_, _, _, _, impossible) => \case impossible \with {}
    }
  | nil, :: _ _, :: _ _ => \lam _ _ _ h => \case h \with {
      | inP (_, _, _, impossible, _) => \case impossible \with {}
    }
  | :: _ _, nil, nil => \lam _ _ _ h => \case h \with {
      | inP (_, _, _, impossible, _) => \case impossible \with {}
    }
  | :: _ _, nil, :: _ _ => \lam _ _ _ h => \case h \with {
      | inP (_, _, _, _, impossible) => \case impossible \with {}
    }
  | :: _ _, :: _ _, nil => \lam _ _ _ h => \case h \with {
      | inP (_, _, _, impossible, _) => \case impossible \with {}
    }

\lemma nat_suc_le_add_suc (start count : Nat) :
  suc start <= start Nat.+ suc count \elim count
  | 0 => <=-refl
  | suc count => nat_le_suc_right (suc start)
      (start Nat.+ suc count) (nat_suc_le_add_suc start count)

\lemma nat_suc_add (start count : Nat) :
  suc start Nat.+ count = start Nat.+ suc count \elim count
  | 0 => idp
  | suc count => pmap suc (nat_suc_add start count)

\lemma nat_add_suc_right (x y : Nat) :
  x Nat.+ suc y = suc (x Nat.+ y) =>
  NatSemiring.+-comm {x} {suc y} *>
    pmap suc (NatSemiring.+-comm {y} {x})

\lemma msc_sum_list_insert_suc (prefix suffix : List Nat) (n : Nat) :
  nat_sum (prefix ++ suc n :: suffix) =
    suc (nat_sum (prefix ++ n :: suffix)) \elim prefix
  | nil => idp
  | :: x prefix => pmap (x Nat.+)
      (msc_sum_list_insert_suc prefix suffix n) *>
      nat_add_suc_right x (nat_sum (prefix ++ n :: suffix))

\lemma list_insert_length (prefix suffix : List Nat) (old new : Nat) :
  length (prefix ++ new :: suffix) =
    length (prefix ++ old :: suffix) \elim prefix
  | nil => idp
  | :: _ prefix => pmap suc
      (list_insert_length prefix suffix old new)

\lemma msc_handle_nat_intro {S : gFunctors} (G : mscG S)
    (gam : msc_name) (i : Nat) (hi : nat_lt i gam.msc_size) :
  properUPred_ent mkProperEmp (msc_handle G gam (natV i)) =>
  \lam n x _ _ => inP (i,
    inP ((iResUR S).unit, x,
      (iResUR S).ofe_dist_sym n
        ((iResUR S).op (iResUR S).unit x) x
        (ucmra_unit_left_id_dist {iResUR S} n x), idp, hi))

\lemma msc_make_handles_from {S : gFunctors} (G : mscG S)
    (gam : msc_name) (start count : Nat)
    (hbound : start Nat.+ count <= gam.msc_size) :
  properUPred_ent mkProperEmp
    (big_sepL (\lam i => msc_handle G gam (natV i))
      (nat_seq start count))
  \elim count
  | 0 => properUPred_ent_refl (mkProperEmp {iResUR S})
  | suc count =>
      \let
        | Head => msc_handle G gam (natV start)
        | Tail => big_sepL (\lam i => msc_handle G gam (natV i))
            (nat_seq (suc start) count)
        | headBound : nat_lt start gam.msc_size =>
            (NatSemiring.<=∘) (nat_suc_le_add_suc start count) hbound
        | tailBound : suc start Nat.+ count <= gam.msc_size =>
            transport (\lam z => z <= gam.msc_size)
              (inv (nat_suc_add start count)) hbound
        | head : properUPred_ent mkProperEmp Head =>
            msc_handle_nat_intro G gam start headBound
        | tail : properUPred_ent mkProperEmp Tail =>
            msc_make_handles_from G gam (suc start) count tailBound
      \in properUPred_ent_trans mkProperEmp Head (mkProperSep Head Tail)
          head (attach_valid_r_ent Head Tail tail)

\lemma msc_make_handles {S : gFunctors} (G : mscG S)
    (gam : msc_name) :
  properUPred_ent mkProperEmp (msc_handles G gam) =>
  msc_make_handles_from G gam 0 gam.msc_size <=-refl

\func list_decompose {A : \Set0} (xs : List A) (i : Nat)
    (hi : suc i <= length xs) :
  \Sigma (prefix : List A) (x : A) (suffix : List A)
    (xs = prefix ++ x :: suffix) (length prefix = i)
  \elim xs, i
  | nil, i => absurd (nat_suc_not_le_zero i hi)
  | :: x xs, 0 => (nil, x, xs, idp, idp)
  | :: x xs, suc i =>
      \let | d => list_decompose xs i (suc<=suc.conv hi)
      \in (x :: d.1, d.2, d.3, pmap (x ::) d.4, pmap suc d.5)

\func msc_mono_rest {S : gFunctors} (G : mscG S)
    (nPrefix : List Nat) (gamPrefix : List gname)
    (nSuffix : List Nat) (gamSuffix : List gname) : iProp S
    \elim nPrefix, gamPrefix
  | nil, nil => msc_mono_auths G nSuffix gamSuffix
  | :: n ns, :: gam gams => mkProperSep
      (mono_nat_auth_own G.msc_mono_natG gam qp_one n)
      (msc_mono_rest G ns gams nSuffix gamSuffix)
  | _, _ => mkProperPure Empty

\lemma msc_mono_auths_extract {S : gFunctors} (G : mscG S)
    (nPrefix : List Nat) (gamPrefix : List gname)
    (n : Nat) (gam : gname)
    (nSuffix : List Nat) (gamSuffix : List gname)
    (hlen : length nPrefix = length gamPrefix) :
  properUPred_ent
    (msc_mono_auths G (nPrefix ++ n :: nSuffix)
      (gamPrefix ++ gam :: gamSuffix))
    (mkProperSep
      (mono_nat_auth_own G.msc_mono_natG gam qp_one n)
      (msc_mono_rest G nPrefix gamPrefix nSuffix gamSuffix))
  \elim nPrefix, gamPrefix
  | nil, nil => properUPred_ent_refl
      (mkProperSep (mono_nat_auth_own G.msc_mono_natG gam qp_one n)
        (msc_mono_auths G nSuffix gamSuffix))
  | :: n0 nPrefix, :: gam0 gamPrefix =>
      properUPred_ent_trans
        (mkProperSep
          (mono_nat_auth_own G.msc_mono_natG gam0 qp_one n0)
          (msc_mono_auths G (nPrefix ++ n :: nSuffix)
            (gamPrefix ++ gam :: gamSuffix)))
        (mkProperSep
          (mono_nat_auth_own G.msc_mono_natG gam0 qp_one n0)
          (mkProperSep
            (mono_nat_auth_own G.msc_mono_natG gam qp_one n)
            (msc_mono_rest G nPrefix gamPrefix nSuffix gamSuffix)))
        (mkProperSep
          (mono_nat_auth_own G.msc_mono_natG gam qp_one n)
          (mkProperSep
            (mono_nat_auth_own G.msc_mono_natG gam0 qp_one n0)
            (msc_mono_rest G nPrefix gamPrefix nSuffix gamSuffix)))
        (sep_mono_r_ent
          (mono_nat_auth_own G.msc_mono_natG gam0 qp_one n0)
          (msc_mono_auths G (nPrefix ++ n :: nSuffix)
            (gamPrefix ++ gam :: gamSuffix))
          (mkProperSep
            (mono_nat_auth_own G.msc_mono_natG gam qp_one n)
            (msc_mono_rest G nPrefix gamPrefix nSuffix gamSuffix))
          (msc_mono_auths_extract G nPrefix gamPrefix n gam
            nSuffix gamSuffix (pmap pred hlen)))
        (sep_swap_ent
          (mono_nat_auth_own G.msc_mono_natG gam0 qp_one n0)
          (mono_nat_auth_own G.msc_mono_natG gam qp_one n)
          (msc_mono_rest G nPrefix gamPrefix nSuffix gamSuffix))
  | nil, :: _ _ => \case hlen \with {}
  | :: _ _, nil => \case hlen \with {}

\lemma msc_mono_auths_insert {S : gFunctors} (G : mscG S)
    (nPrefix : List Nat) (gamPrefix : List gname)
    (old new : Nat) (gam : gname)
    (nSuffix : List Nat) (gamSuffix : List gname)
    (hlen : length nPrefix = length gamPrefix) :
  properUPred_ent
    (mkProperSep
      (mono_nat_auth_own G.msc_mono_natG gam qp_one new)
      (msc_mono_rest G nPrefix gamPrefix nSuffix gamSuffix))
    (msc_mono_auths G (nPrefix ++ new :: nSuffix)
      (gamPrefix ++ gam :: gamSuffix))
  \elim nPrefix, gamPrefix
  | nil, nil => properUPred_ent_refl
      (mkProperSep (mono_nat_auth_own G.msc_mono_natG gam qp_one new)
        (msc_mono_auths G nSuffix gamSuffix))
  | :: n0 nPrefix, :: gam0 gamPrefix =>
      properUPred_ent_trans
        (mkProperSep
          (mono_nat_auth_own G.msc_mono_natG gam qp_one new)
          (mkProperSep
            (mono_nat_auth_own G.msc_mono_natG gam0 qp_one n0)
            (msc_mono_rest G nPrefix gamPrefix nSuffix gamSuffix)))
        (mkProperSep
          (mono_nat_auth_own G.msc_mono_natG gam0 qp_one n0)
          (mkProperSep
            (mono_nat_auth_own G.msc_mono_natG gam qp_one new)
            (msc_mono_rest G nPrefix gamPrefix nSuffix gamSuffix)))
        (mkProperSep
          (mono_nat_auth_own G.msc_mono_natG gam0 qp_one n0)
          (msc_mono_auths G (nPrefix ++ new :: nSuffix)
            (gamPrefix ++ gam :: gamSuffix)))
        (sep_swap_ent
          (mono_nat_auth_own G.msc_mono_natG gam qp_one new)
          (mono_nat_auth_own G.msc_mono_natG gam0 qp_one n0)
          (msc_mono_rest G nPrefix gamPrefix nSuffix gamSuffix))
        (sep_mono_r_ent
          (mono_nat_auth_own G.msc_mono_natG gam0 qp_one n0)
          (mkProperSep
            (mono_nat_auth_own G.msc_mono_natG gam qp_one new)
            (msc_mono_rest G nPrefix gamPrefix nSuffix gamSuffix))
          (msc_mono_auths G (nPrefix ++ new :: nSuffix)
            (gamPrefix ++ gam :: gamSuffix))
          (msc_mono_auths_insert G nPrefix gamPrefix old new gam
            nSuffix gamSuffix (pmap pred hlen)))
  | nil, :: _ _ => \case hlen \with {}
  | :: _ _, nil => \case hlen \with {}

\lemma pointsto_array_index_suc_add (a i : Nat) :
  pointsto_array_index_loc suc a i = a Nat.+ i \elim i
  | 0 => idp
  | suc i => pointsto_array_index_suc_add (suc a) i *>
      nat_suc_add a i

\func map_append_cons {A B : \Type} (f : A -> B)
    (prefix suffix : List A) (x : A) :
  map f (prefix ++ x :: suffix) =
    map f prefix ++ f x :: map f suffix \elim prefix
  | nil => idp
  | :: y prefix => pmap (f y ::)
      (map_append_cons f prefix suffix x)

\func map_length_eq {A B : \Type} (f : A -> B) (xs : List A) :
  length (map f xs) = length xs \elim xs
  | nil => idp
  | :: _ xs => pmap suc (map_length_eq f xs)

-- Everything chosen when the counter invariant is opened around one shard.
-- The physical cell is kept separate below so that the atomic FAA rule can
-- consume it immediately; all remaining resources cross the primitive step
-- under a single later.
\record msc_incr_witness {S : gFunctors} (gam : msc_name) (i : Nat)
  | incr_prefix : List Nat
  | incr_old : Nat
  | incr_suffix : List Nat
  | incr_name_prefix : List gname
  | incr_name : gname
  | incr_name_suffix : List gname
  | incr_requests : Gmap Nat natCountable (\Sigma Nat gname)
  | incr_names_eq : gam.msc_shard_names =
      incr_name_prefix ++ incr_name :: incr_name_suffix
  | incr_prefix_len : length incr_prefix = i
  | incr_name_prefix_len : length incr_name_prefix = i
  | incr_ns_len : length (incr_prefix ++ incr_old :: incr_suffix) =
      gam.msc_size
  | incr_names_len : length
      (incr_name_prefix ++ incr_name :: incr_name_suffix) = gam.msc_size

\func msc_incr_ns {S : gFunctors} {gam : msc_name} {i : Nat}
    (w : msc_incr_witness {S} gam i) : List Nat =>
  w.incr_prefix ++ w.incr_old :: w.incr_suffix

\func msc_incr_ns_next {S : gFunctors} {gam : msc_name} {i : Nat}
    (w : msc_incr_witness {S} gam i) : List Nat =>
  w.incr_prefix ++ suc w.incr_old :: w.incr_suffix

\func msc_incr_total {S : gFunctors} {gam : msc_name} {i : Nat}
    (w : msc_incr_witness {S} gam i) : Nat =>
  nat_sum (msc_incr_ns w)

\func msc_incr_now {S : gFunctors} (H : irisGS natCountable S)
    (G : mscG S) (gam : msc_name) (a i : Nat)
    (w : msc_incr_witness {S} gam i) : iProp S =>
  pointsto_full H.iris_gen_heap (a Nat.+ i) (natV w.incr_old)

\func msc_incr_after {S : gFunctors} (H : irisGS natCountable S)
    (G : mscG S) (gam : msc_name) (a i : Nat)
    (w : msc_incr_witness {S} gam i) : iProp S =>
  mkProperSep (msc_counter_auth G gam (msc_incr_total w))
    (mkProperSep
      (pointsto_array_rest H.iris_gen_heap suc a
        (map natV w.incr_prefix) (map natV w.incr_suffix))
      (mkProperSep
        (mono_nat_auth_own G.msc_mono_natG w.incr_name qp_one w.incr_old)
        (mkProperSep
          (msc_mono_rest G w.incr_prefix w.incr_name_prefix
            w.incr_suffix w.incr_name_suffix)
          (msc_requests H G gam (msc_incr_total w) w.incr_requests))))

\lemma msc_incr_now_timeless {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a i : Nat) (w : msc_incr_witness {S} gam i) :
  Timeless (msc_incr_now H G gam a i w) =>
  pointsto_full_timeless H.iris_gen_heap (a Nat.+ i) (natV w.incr_old)

\lemma msc_incr_focus_resources {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a i : Nat) (w : msc_incr_witness {S} gam i) :
  properUPred_ent
    (mkProperSep
      (msc_counter_auth G gam (msc_incr_total w))
      (mkProperSep
        (msc_shards H G a (msc_incr_ns w)
          (w.incr_name_prefix ++ w.incr_name :: w.incr_name_suffix))
        (msc_requests H G gam (msc_incr_total w) w.incr_requests)))
    (mkProperSep (msc_incr_now H G gam a i w)
      (msc_incr_after H G gam a i w)) =>
  \let
    | Auth => msc_counter_auth G gam (msc_incr_total w)
    | Cells => pointsto_array H.iris_gen_heap suc a
        (map natV (msc_incr_ns w))
    | Monos => msc_mono_auths G (msc_incr_ns w)
        (w.incr_name_prefix ++ w.incr_name :: w.incr_name_suffix)
    | Requests => msc_requests H G gam (msc_incr_total w) w.incr_requests
    | Now => msc_incr_now H G gam a i w
    | ArrayRest => pointsto_array_rest H.iris_gen_heap suc a
        (map natV w.incr_prefix) (map natV w.incr_suffix)
    | Mono => mono_nat_auth_own G.msc_mono_natG
        w.incr_name qp_one w.incr_old
    | MonoRest => msc_mono_rest G w.incr_prefix w.incr_name_prefix
        w.incr_suffix w.incr_name_suffix
    | FocusedShards => mkProperSep
        (mkProperSep Now ArrayRest) (mkProperSep Mono MonoRest)
    | Tail => mkProperSep (mkProperSep Mono MonoRest) Requests
    | Tail' => mkProperSep Mono (mkProperSep MonoRest Requests)
    | Core0 => mkProperSep Auth
        (mkProperSep (mkProperSep Cells Monos) Requests)
    | Core1 => mkProperSep Auth (mkProperSep FocusedShards Requests)
    | Core2 => mkProperSep Auth (mkProperSep (mkProperSep Now ArrayRest) Tail)
    | Core3 => mkProperSep (mkProperSep Now ArrayRest)
        (mkProperSep Auth Tail)
    | Core4 => mkProperSep Now
        (mkProperSep ArrayRest (mkProperSep Auth Tail))
    | Core5 => mkProperSep Now
        (mkProperSep Auth (mkProperSep ArrayRest Tail))
    | Target => mkProperSep Now
        (mkProperSep Auth (mkProperSep ArrayRest Tail'))
    | cells : properUPred_ent Cells (mkProperSep Now ArrayRest) =>
        transport (\lam values => properUPred_ent
          (pointsto_array H.iris_gen_heap suc a values)
          (mkProperSep Now ArrayRest))
          (inv (map_append_cons natV w.incr_prefix w.incr_suffix w.incr_old))
          (transport (\lam loc => properUPred_ent
              (pointsto_array H.iris_gen_heap suc a
                (map natV w.incr_prefix ++ natV w.incr_old ::
                  map natV w.incr_suffix))
              (mkProperSep
                (pointsto_full H.iris_gen_heap loc (natV w.incr_old))
                ArrayRest))
            (pointsto_array_index_suc_add a (length w.incr_prefix) *>
              pmap (a Nat.+) w.incr_prefix_len)
            (transport (\lam j => properUPred_ent
                (pointsto_array H.iris_gen_heap suc a
                  (map natV w.incr_prefix ++ natV w.incr_old ::
                    map natV w.incr_suffix))
                (mkProperSep
                  (pointsto_full H.iris_gen_heap
                    (pointsto_array_index_loc suc a j)
                    (natV w.incr_old)) ArrayRest))
              (map_length_eq natV w.incr_prefix)
              (pointsto_array_extract H.iris_gen_heap suc a
                (map natV w.incr_prefix) (natV w.incr_old)
                (map natV w.incr_suffix))))
    | monos : properUPred_ent Monos (mkProperSep Mono MonoRest) =>
        msc_mono_auths_extract G w.incr_prefix w.incr_name_prefix
          w.incr_old w.incr_name w.incr_suffix w.incr_name_suffix
          (w.incr_prefix_len *> inv w.incr_name_prefix_len)
    | focusShards : properUPred_ent (mkProperSep Cells Monos)
        FocusedShards =>
        properUPred_ent_trans (mkProperSep Cells Monos)
          (mkProperSep (mkProperSep Now ArrayRest) Monos) FocusedShards
          (sep_mono_l_ent Cells (mkProperSep Now ArrayRest) Monos cells)
          (sep_mono_r_ent (mkProperSep Now ArrayRest) Monos
            (mkProperSep Mono MonoRest) monos)
    | step01 : properUPred_ent Core0 Core1 =>
        sep_mono_r_ent Auth (mkProperSep (mkProperSep Cells Monos) Requests)
          (mkProperSep FocusedShards Requests)
          (sep_mono_l_ent (mkProperSep Cells Monos) FocusedShards Requests
            focusShards)
    | step12 : properUPred_ent Core1 Core2 =>
        sep_mono_r_ent Auth (mkProperSep FocusedShards Requests)
          (mkProperSep (mkProperSep Now ArrayRest) Tail)
          (sep_assoc_l_ent (mkProperSep Now ArrayRest)
            (mkProperSep Mono MonoRest) Requests)
    | step23 : properUPred_ent Core2 Core3 =>
        sep_swap_ent Auth (mkProperSep Now ArrayRest) Tail
    | step34 : properUPred_ent Core3 Core4 =>
        sep_assoc_l_ent Now ArrayRest (mkProperSep Auth Tail)
    | step45 : properUPred_ent Core4 Core5 =>
        sep_mono_r_ent Now
          (mkProperSep ArrayRest (mkProperSep Auth Tail))
          (mkProperSep Auth (mkProperSep ArrayRest Tail))
          (sep_swap_ent ArrayRest Auth Tail)
    | step5T : properUPred_ent Core5 Target =>
        sep_mono_r_ent Now
          (mkProperSep Auth (mkProperSep ArrayRest Tail))
          (mkProperSep Auth (mkProperSep ArrayRest Tail'))
          (sep_mono_r_ent Auth (mkProperSep ArrayRest Tail)
            (mkProperSep ArrayRest Tail')
            (sep_mono_r_ent ArrayRest Tail Tail'
              (sep_assoc_l_ent Mono MonoRest Requests)))
  \in properUPred_ent_trans Core0 Core1 Target step01
      (properUPred_ent_trans Core1 Core2 Target step12
        (properUPred_ent_trans Core2 Core3 Target step23
          (properUPred_ent_trans Core3 Core4 Target step34
            (properUPred_ent_trans Core4 Core5 Target step45 step5T))))

\lemma msc_inv_incr_split {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a i : Nat) (hi : nat_lt i gam.msc_size) :
  properUPred_ent (msc_inv H G gam a)
    (mkProperExist (msc_incr_witness {S} gam i) (\lam w =>
      mkProperSep (msc_incr_now H G gam a i w)
        (msc_incr_after H G gam a i w))) =>
  \lam step x hx hinv => \case hinv \with {
    | inP (ns, inP (requests, hbody)) => \case hbody \with {
      | inP (_, _, _, hlen, hrest) => \case hrest \with {
        | inP (_, _, _, hnames, _) =>
          \let
            | hiNs : suc i <= length ns =>
                transport (\lam z => suc i <= z) (inv hlen) hi
            | hiNames : suc i <= length gam.msc_shard_names =>
                transport (\lam z => suc i <= z) (inv hnames) hi
            | dns => list_decompose ns i hiNs
            | dnames => list_decompose gam.msc_shard_names i hiNames
            | w : msc_incr_witness {S} gam i =>
                \new msc_incr_witness {
                  | incr_prefix => dns.1
                  | incr_old => dns.2
                  | incr_suffix => dns.3
                  | incr_name_prefix => dnames.1
                  | incr_name => dnames.2
                  | incr_name_suffix => dnames.3
                  | incr_requests => requests
                  | incr_names_eq => dnames.4
                  | incr_prefix_len => dns.5
                  | incr_name_prefix_len => dnames.5
                  | incr_ns_len => inv (pmap length dns.4) *> hlen
                  | incr_names_len => inv (pmap length dnames.4) *> hnames
                }
            | BodyNs => msc_inv_body_names H G gam a
                (msc_incr_ns w) gam.msc_shard_names requests
            | BodyFocused => msc_inv_body_names H G gam a
                (msc_incr_ns w)
                (w.incr_name_prefix ++ w.incr_name :: w.incr_name_suffix)
                requests
            | Core => mkProperSep
                (msc_counter_auth G gam (msc_incr_total w))
                (mkProperSep
                  (msc_shards H G a (msc_incr_ns w)
                    (w.incr_name_prefix ++
                      w.incr_name :: w.incr_name_suffix))
                  (msc_requests H G gam (msc_incr_total w) requests))
            | Target => mkProperSep (msc_incr_now H G gam a i w)
                (msc_incr_after H G gam a i w)
            | focused : BodyFocused.upred_holds step x =>
                transport (\lam names =>
                  (msc_inv_body_names H G gam a
                    (msc_incr_ns w) names requests).upred_holds step x)
                  dnames.4
                  (transport (\lam zs =>
                    (msc_inv_body_names H G gam a zs
                      gam.msc_shard_names requests).upred_holds step x)
                    dns.4 hbody)
            | dropPure : properUPred_ent BodyFocused Core =>
                pure_sep_l_elim
                  (length (msc_incr_ns w) = gam.msc_size)
                  (mkProperSep
                    (mkProperPure
                      (length (w.incr_name_prefix ++
                        w.incr_name :: w.incr_name_suffix) = gam.msc_size))
                    Core) Core
                  (\lam _ => pure_sep_l_elim
                    (length (w.incr_name_prefix ++
                      w.incr_name :: w.incr_name_suffix) = gam.msc_size)
                    Core Core (\lam _ => properUPred_ent_refl Core))
            | result : Target.upred_holds step x =>
                properUPred_ent_trans BodyFocused Core Target dropPure
                  (msc_incr_focus_resources H G gam a i w)
                  step x hx focused
          \in inP (w, result)
      }
    }
  }

\func msc_load_witness {S : gFunctors} (gam : msc_name) (i : Nat)
    (name : gname) : \Set0 =>
  \Sigma (w : msc_incr_witness {S} gam i) (w.incr_name = name)

-- Variant used by the read loop.  The caller supplies the decomposition of
-- the public shard-name list, so the focused monotone authority has exactly
-- the name carried by the corresponding public lower-bound token.
\lemma msc_inv_split_given_name {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a i : Nat)
    (namePrefix : List gname) (name : gname)
    (nameSuffix : List gname)
    (namesEq : gam.msc_shard_names =
      namePrefix ++ name :: nameSuffix)
    (namePrefixLen : length namePrefix = i)
    (hi : nat_lt i gam.msc_size) :
  properUPred_ent (msc_inv H G gam a)
    (mkProperExist (msc_load_witness {S} gam i name) (\lam rw =>
      mkProperSep (msc_incr_now H G gam a i rw.1)
        (msc_incr_after H G gam a i rw.1))) =>
  \lam step x hx hinv => \case hinv \with {
    | inP (ns, inP (requests, hbody)) => \case hbody \with {
      | inP (_, _, _, hlen, hrest) => \case hrest \with {
        | inP (_, _, _, hnames, _) =>
          \let
            | hiNs : suc i <= length ns =>
                transport (\lam z => suc i <= z) (inv hlen) hi
            | dns => list_decompose ns i hiNs
            | w : msc_incr_witness {S} gam i =>
                \new msc_incr_witness {
                  | incr_prefix => dns.1
                  | incr_old => dns.2
                  | incr_suffix => dns.3
                  | incr_name_prefix => namePrefix
                  | incr_name => name
                  | incr_name_suffix => nameSuffix
                  | incr_requests => requests
                  | incr_names_eq => namesEq
                  | incr_prefix_len => dns.5
                  | incr_name_prefix_len => namePrefixLen
                  | incr_ns_len => inv (pmap length dns.4) *> hlen
                  | incr_names_len => inv (pmap length namesEq) *> hnames
                }
            | rw : msc_load_witness {S} gam i name => (w, idp)
            | BodyNs => msc_inv_body_names H G gam a
                (msc_incr_ns w) gam.msc_shard_names requests
            | BodyFocused => msc_inv_body_names H G gam a
                (msc_incr_ns w)
                (w.incr_name_prefix ++ w.incr_name :: w.incr_name_suffix)
                requests
            | Core => mkProperSep
                (msc_counter_auth G gam (msc_incr_total w))
                (mkProperSep
                  (msc_shards H G a (msc_incr_ns w)
                    (w.incr_name_prefix ++
                      w.incr_name :: w.incr_name_suffix))
                  (msc_requests H G gam (msc_incr_total w) requests))
            | Target => mkProperSep (msc_incr_now H G gam a i w)
                (msc_incr_after H G gam a i w)
            | focused : BodyFocused.upred_holds step x =>
                transport (\lam names =>
                  (msc_inv_body_names H G gam a
                    (msc_incr_ns w) names requests).upred_holds step x)
                  namesEq
                  (transport (\lam zs =>
                    (msc_inv_body_names H G gam a zs
                      gam.msc_shard_names requests).upred_holds step x)
                    dns.4 hbody)
            | dropPure : properUPred_ent BodyFocused Core =>
                pure_sep_l_elim
                  (length (msc_incr_ns w) = gam.msc_size)
                  (mkProperSep
                    (mkProperPure
                      (length (w.incr_name_prefix ++
                        w.incr_name :: w.incr_name_suffix) = gam.msc_size))
                    Core) Core
                  (\lam _ => pure_sep_l_elim
                    (length (w.incr_name_prefix ++
                      w.incr_name :: w.incr_name_suffix) = gam.msc_size)
                    Core Core (\lam _ => properUPred_ent_refl Core))
            | result : Target.upred_holds step x =>
                properUPred_ent_trans BodyFocused Core Target dropPure
                  (msc_incr_focus_resources H G gam a i w)
                  step x hx focused
          \in inP (rw, result)
      }
    }
  }

\lemma msc_incr_rebuild {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a i : Nat) (w : msc_incr_witness {S} gam i) :
  properUPred_ent
    (mkProperSep
      (pointsto_full H.iris_gen_heap (a Nat.+ i) (natV (suc w.incr_old)))
      (mkProperSep
        (msc_counter_auth G gam (nat_sum (msc_incr_ns_next w)))
        (mkProperSep
          (pointsto_array_rest H.iris_gen_heap suc a
            (map natV w.incr_prefix) (map natV w.incr_suffix))
          (mkProperSep
            (mono_nat_auth_own G.msc_mono_natG
              w.incr_name qp_one (suc w.incr_old))
            (mkProperSep
              (msc_mono_rest G w.incr_prefix w.incr_name_prefix
                w.incr_suffix w.incr_name_suffix)
              (msc_requests H G gam (nat_sum (msc_incr_ns_next w))
                w.incr_requests))))))
    (msc_inv H G gam a) =>
  \let
    | NextNs => msc_incr_ns_next w
    | NextTotal => nat_sum NextNs
    | Cell => pointsto_full H.iris_gen_heap
        (a Nat.+ i) (natV (suc w.incr_old))
    | ArrayRest => pointsto_array_rest H.iris_gen_heap suc a
        (map natV w.incr_prefix) (map natV w.incr_suffix)
    | Array => pointsto_array H.iris_gen_heap suc a (map natV NextNs)
    | Mono => mono_nat_auth_own G.msc_mono_natG
        w.incr_name qp_one (suc w.incr_old)
    | MonoRest => msc_mono_rest G w.incr_prefix w.incr_name_prefix
        w.incr_suffix w.incr_name_suffix
    | Names => w.incr_name_prefix ++ w.incr_name :: w.incr_name_suffix
    | MonosD => msc_mono_auths G NextNs Names
    | Monos => msc_mono_auths G NextNs gam.msc_shard_names
    | Auth => msc_counter_auth G gam NextTotal
    | Requests => msc_requests H G gam NextTotal w.incr_requests
    | Tail => mkProperSep Mono (mkProperSep MonoRest Requests)
    | Tail' => mkProperSep (mkProperSep Mono MonoRest) Requests
    | Source => mkProperSep Cell
        (mkProperSep Auth (mkProperSep ArrayRest Tail))
    | S1 => mkProperSep Auth
        (mkProperSep Cell (mkProperSep ArrayRest Tail))
    | S2 => mkProperSep Auth
        (mkProperSep (mkProperSep Cell ArrayRest) Tail)
    | S3 => mkProperSep Auth
        (mkProperSep (mkProperSep Cell ArrayRest) Tail')
    | S4 => mkProperSep Auth
        (mkProperSep Array (mkProperSep (mkProperSep Mono MonoRest) Requests))
    | S5 => mkProperSep Auth
        (mkProperSep Array (mkProperSep MonosD Requests))
    | Core => mkProperSep Auth (mkProperSep (mkProperSep Array Monos) Requests)
    | Body => msc_inv_body_names H G gam a NextNs
        gam.msc_shard_names w.incr_requests
    | cellLoc : pointsto_array_index_loc suc a
          (length w.incr_prefix) = a Nat.+ i =>
        pointsto_array_index_suc_add a (length w.incr_prefix) *>
          pmap (a Nat.+) w.incr_prefix_len
    | arrayInsert : properUPred_ent (mkProperSep Cell ArrayRest) Array =>
        transport (\lam loc => properUPred_ent
            (mkProperSep
              (pointsto_full H.iris_gen_heap loc (natV (suc w.incr_old)))
              ArrayRest)
            Array)
          cellLoc
          (transport (\lam values => properUPred_ent
              (mkProperSep
                (pointsto_full H.iris_gen_heap
                  (pointsto_array_index_loc suc a (length w.incr_prefix))
                  (natV (suc w.incr_old))) ArrayRest)
              (pointsto_array H.iris_gen_heap suc a values))
            (inv (map_append_cons natV w.incr_prefix w.incr_suffix
              (suc w.incr_old)))
            (transport (\lam j => properUPred_ent
                (mkProperSep
                  (pointsto_full H.iris_gen_heap
                    (pointsto_array_index_loc suc a j)
                    (natV (suc w.incr_old))) ArrayRest)
                (pointsto_array H.iris_gen_heap suc a
                  (map natV w.incr_prefix ++
                    natV (suc w.incr_old) :: map natV w.incr_suffix)))
              (map_length_eq natV w.incr_prefix)
              (pointsto_array_insert H.iris_gen_heap suc a
                (map natV w.incr_prefix) (natV w.incr_old)
                (natV (suc w.incr_old)) (map natV w.incr_suffix))))
    | monoInsert : properUPred_ent (mkProperSep Mono MonoRest) MonosD =>
        msc_mono_auths_insert G w.incr_prefix w.incr_name_prefix
          w.incr_old (suc w.incr_old) w.incr_name
          w.incr_suffix w.incr_name_suffix
          (w.incr_prefix_len *> inv w.incr_name_prefix_len)
    | monosNames : properUPred_ent MonosD Monos =>
        transport (\lam names => properUPred_ent MonosD
          (msc_mono_auths G NextNs names))
          (inv w.incr_names_eq) (properUPred_ent_refl MonosD)
    | step01 : properUPred_ent Source S1 =>
        sep_swap_ent Cell Auth (mkProperSep ArrayRest Tail)
    | step12 : properUPred_ent S1 S2 =>
        sep_mono_r_ent Auth
          (mkProperSep Cell (mkProperSep ArrayRest Tail))
          (mkProperSep (mkProperSep Cell ArrayRest) Tail)
          (sep_assoc_r_ent Cell ArrayRest Tail)
    | step23 : properUPred_ent S2 S3 =>
        sep_mono_r_ent Auth
          (mkProperSep (mkProperSep Cell ArrayRest) Tail)
          (mkProperSep (mkProperSep Cell ArrayRest) Tail')
          (sep_mono_r_ent (mkProperSep Cell ArrayRest) Tail Tail'
            (sep_assoc_r_ent Mono MonoRest Requests))
    | step34 : properUPred_ent S3 S4 =>
        sep_mono_r_ent Auth
          (mkProperSep (mkProperSep Cell ArrayRest) Tail')
          (mkProperSep Array (mkProperSep (mkProperSep Mono MonoRest) Requests))
          (sep_mono_l_ent (mkProperSep Cell ArrayRest) Array Tail' arrayInsert)
    | step45 : properUPred_ent S4 S5 =>
        sep_mono_r_ent Auth
          (mkProperSep Array (mkProperSep (mkProperSep Mono MonoRest) Requests))
          (mkProperSep Array (mkProperSep MonosD Requests))
          (sep_mono_r_ent Array
            (mkProperSep (mkProperSep Mono MonoRest) Requests)
            (mkProperSep MonosD Requests)
            (sep_mono_l_ent (mkProperSep Mono MonoRest) MonosD Requests
              monoInsert))
    | step5C : properUPred_ent S5 Core =>
        sep_mono_r_ent Auth (mkProperSep Array (mkProperSep MonosD Requests))
          (mkProperSep (mkProperSep Array Monos) Requests)
          (properUPred_ent_trans
            (mkProperSep Array (mkProperSep MonosD Requests))
            (mkProperSep Array (mkProperSep Monos Requests))
            (mkProperSep (mkProperSep Array Monos) Requests)
            (sep_mono_r_ent Array (mkProperSep MonosD Requests)
              (mkProperSep Monos Requests)
              (sep_mono_l_ent MonosD Monos Requests monosNames))
            (sep_assoc_r_ent Array Monos Requests))
    | coreBody : properUPred_ent Core Body =>
        \let
          | nextLen : length NextNs = gam.msc_size =>
              list_insert_length w.incr_prefix w.incr_suffix
                w.incr_old (suc w.incr_old) *> w.incr_ns_len
          | namesLen : length gam.msc_shard_names = gam.msc_size =>
              pmap length w.incr_names_eq *> w.incr_names_len
          | WithNames => mkProperSep
              (mkProperPure {iResUR S}
                (length gam.msc_shard_names = gam.msc_size)) Core
        \in properUPred_ent_trans Core WithNames Body
          (pure_intro_sep_ent
            (length gam.msc_shard_names = gam.msc_size) namesLen Core)
          (pure_intro_sep_ent (length NextNs = gam.msc_size)
            nextLen WithNames)
    | sourceCore : properUPred_ent Source Core =>
        properUPred_ent_trans Source S1 Core step01
          (properUPred_ent_trans S1 S2 Core step12
            (properUPred_ent_trans S2 S3 Core step23
              (properUPred_ent_trans S3 S4 Core step34
                (properUPred_ent_trans S4 S5 Core step45 step5C))))
    | bodyInv : properUPred_ent Body (msc_inv H G gam a) =>
        properUPred_ent_trans Body
          (mkProperExist (Gmap Nat natCountable (\Sigma Nat gname))
            (\lam requests => msc_inv_body_names H G gam a NextNs
              gam.msc_shard_names requests))
          (msc_inv H G gam a)
          (exist_intro_ent (\lam requests =>
            msc_inv_body_names H G gam a NextNs
              gam.msc_shard_names requests) w.incr_requests)
          (exist_intro_ent (\lam ns =>
            mkProperExist (Gmap Nat natCountable (\Sigma Nat gname))
              (\lam requests => msc_inv_body_names H G gam a ns
                gam.msc_shard_names requests)) NextNs)
  \in properUPred_ent_trans Source Core (msc_inv H G gam a)
      sourceCore (properUPred_ent_trans Core Body
        (msc_inv H G gam a) coreBody bodyInv)

-- Reinsert an unchanged focused shard after an atomic load.  This is the
-- inverse direction of `msc_incr_focus_resources`; unlike increment rebuild,
-- neither the list total nor the mono authority changes.
\lemma msc_incr_restore {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a i : Nat) (w : msc_incr_witness {S} gam i) :
  properUPred_ent
    (mkProperSep (msc_incr_now H G gam a i w)
      (msc_incr_after H G gam a i w))
    (msc_inv H G gam a) =>
  \let
    | Ns => msc_incr_ns w
    | Total => msc_incr_total w
    | Cell => msc_incr_now H G gam a i w
    | ArrayRest => pointsto_array_rest H.iris_gen_heap suc a
        (map natV w.incr_prefix) (map natV w.incr_suffix)
    | Array => pointsto_array H.iris_gen_heap suc a (map natV Ns)
    | Mono => mono_nat_auth_own G.msc_mono_natG
        w.incr_name qp_one w.incr_old
    | MonoRest => msc_mono_rest G w.incr_prefix w.incr_name_prefix
        w.incr_suffix w.incr_name_suffix
    | Names => w.incr_name_prefix ++ w.incr_name :: w.incr_name_suffix
    | MonosD => msc_mono_auths G Ns Names
    | Monos => msc_mono_auths G Ns gam.msc_shard_names
    | Auth => msc_counter_auth G gam Total
    | Requests => msc_requests H G gam Total w.incr_requests
    | Tail => mkProperSep Mono (mkProperSep MonoRest Requests)
    | Tail' => mkProperSep (mkProperSep Mono MonoRest) Requests
    | Source => mkProperSep Cell
        (mkProperSep Auth (mkProperSep ArrayRest Tail))
    | S1 => mkProperSep Auth
        (mkProperSep Cell (mkProperSep ArrayRest Tail))
    | S2 => mkProperSep Auth
        (mkProperSep (mkProperSep Cell ArrayRest) Tail)
    | S3 => mkProperSep Auth
        (mkProperSep (mkProperSep Cell ArrayRest) Tail')
    | S4 => mkProperSep Auth
        (mkProperSep Array (mkProperSep (mkProperSep Mono MonoRest) Requests))
    | S5 => mkProperSep Auth
        (mkProperSep Array (mkProperSep MonosD Requests))
    | Core => mkProperSep Auth (mkProperSep (mkProperSep Array Monos) Requests)
    | Body => msc_inv_body_names H G gam a Ns
        gam.msc_shard_names w.incr_requests
    | cellLoc : pointsto_array_index_loc suc a
          (length w.incr_prefix) = a Nat.+ i =>
        pointsto_array_index_suc_add a (length w.incr_prefix) *>
          pmap (a Nat.+) w.incr_prefix_len
    | arrayInsert : properUPred_ent (mkProperSep Cell ArrayRest) Array =>
        transport (\lam loc => properUPred_ent
            (mkProperSep
              (pointsto_full H.iris_gen_heap loc (natV w.incr_old))
              ArrayRest) Array)
          cellLoc
          (transport (\lam values => properUPred_ent
              (mkProperSep
                (pointsto_full H.iris_gen_heap
                  (pointsto_array_index_loc suc a (length w.incr_prefix))
                  (natV w.incr_old)) ArrayRest)
              (pointsto_array H.iris_gen_heap suc a values))
            (inv (map_append_cons natV w.incr_prefix w.incr_suffix
              w.incr_old))
            (transport (\lam j => properUPred_ent
                (mkProperSep
                  (pointsto_full H.iris_gen_heap
                    (pointsto_array_index_loc suc a j)
                    (natV w.incr_old)) ArrayRest)
                (pointsto_array H.iris_gen_heap suc a
                  (map natV w.incr_prefix ++
                    natV w.incr_old :: map natV w.incr_suffix)))
              (map_length_eq natV w.incr_prefix)
              (pointsto_array_insert H.iris_gen_heap suc a
                (map natV w.incr_prefix) (natV w.incr_old)
                (natV w.incr_old) (map natV w.incr_suffix))))
    | monoInsert : properUPred_ent (mkProperSep Mono MonoRest) MonosD =>
        msc_mono_auths_insert G w.incr_prefix w.incr_name_prefix
          w.incr_old w.incr_old w.incr_name
          w.incr_suffix w.incr_name_suffix
          (w.incr_prefix_len *> inv w.incr_name_prefix_len)
    | monosNames : properUPred_ent MonosD Monos =>
        transport (\lam names => properUPred_ent MonosD
          (msc_mono_auths G Ns names))
          (inv w.incr_names_eq) (properUPred_ent_refl MonosD)
    | step01 : properUPred_ent Source S1 =>
        sep_swap_ent Cell Auth (mkProperSep ArrayRest Tail)
    | step12 : properUPred_ent S1 S2 =>
        sep_mono_r_ent Auth
          (mkProperSep Cell (mkProperSep ArrayRest Tail))
          (mkProperSep (mkProperSep Cell ArrayRest) Tail)
          (sep_assoc_r_ent Cell ArrayRest Tail)
    | step23 : properUPred_ent S2 S3 =>
        sep_mono_r_ent Auth
          (mkProperSep (mkProperSep Cell ArrayRest) Tail)
          (mkProperSep (mkProperSep Cell ArrayRest) Tail')
          (sep_mono_r_ent (mkProperSep Cell ArrayRest) Tail Tail'
            (sep_assoc_r_ent Mono MonoRest Requests))
    | step34 : properUPred_ent S3 S4 =>
        sep_mono_r_ent Auth
          (mkProperSep (mkProperSep Cell ArrayRest) Tail')
          (mkProperSep Array (mkProperSep (mkProperSep Mono MonoRest) Requests))
          (sep_mono_l_ent (mkProperSep Cell ArrayRest) Array Tail' arrayInsert)
    | step45 : properUPred_ent S4 S5 =>
        sep_mono_r_ent Auth
          (mkProperSep Array (mkProperSep (mkProperSep Mono MonoRest) Requests))
          (mkProperSep Array (mkProperSep MonosD Requests))
          (sep_mono_r_ent Array
            (mkProperSep (mkProperSep Mono MonoRest) Requests)
            (mkProperSep MonosD Requests)
            (sep_mono_l_ent (mkProperSep Mono MonoRest) MonosD Requests
              monoInsert))
    | step5C : properUPred_ent S5 Core =>
        sep_mono_r_ent Auth (mkProperSep Array (mkProperSep MonosD Requests))
          (mkProperSep (mkProperSep Array Monos) Requests)
          (properUPred_ent_trans
            (mkProperSep Array (mkProperSep MonosD Requests))
            (mkProperSep Array (mkProperSep Monos Requests))
            (mkProperSep (mkProperSep Array Monos) Requests)
            (sep_mono_r_ent Array (mkProperSep MonosD Requests)
              (mkProperSep Monos Requests)
              (sep_mono_l_ent MonosD Monos Requests monosNames))
            (sep_assoc_r_ent Array Monos Requests))
    | coreBody : properUPred_ent Core Body =>
        \let
          | namesLen : length gam.msc_shard_names = gam.msc_size =>
              pmap length w.incr_names_eq *> w.incr_names_len
          | WithNames => mkProperSep
              (mkProperPure {iResUR S}
                (length gam.msc_shard_names = gam.msc_size)) Core
        \in properUPred_ent_trans Core WithNames Body
          (pure_intro_sep_ent
            (length gam.msc_shard_names = gam.msc_size) namesLen Core)
          (pure_intro_sep_ent (length Ns = gam.msc_size)
            w.incr_ns_len WithNames)
    | sourceCore : properUPred_ent Source Core =>
        properUPred_ent_trans Source S1 Core step01
          (properUPred_ent_trans S1 S2 Core step12
            (properUPred_ent_trans S2 S3 Core step23
              (properUPred_ent_trans S3 S4 Core step34
                (properUPred_ent_trans S4 S5 Core step45 step5C))))
    | bodyInv : properUPred_ent Body (msc_inv H G gam a) =>
        properUPred_ent_trans Body
          (mkProperExist (Gmap Nat natCountable (\Sigma Nat gname))
            (\lam requests => msc_inv_body_names H G gam a Ns
              gam.msc_shard_names requests))
          (msc_inv H G gam a)
          (exist_intro_ent (\lam requests =>
            msc_inv_body_names H G gam a Ns
              gam.msc_shard_names requests) w.incr_requests)
          (exist_intro_ent (\lam ns =>
            mkProperExist (Gmap Nat natCountable (\Sigma Nat gname))
              (\lam requests => msc_inv_body_names H G gam a ns
                gam.msc_shard_names requests)) Ns)
  \in properUPred_ent_trans Source Core (msc_inv H G gam a)
      sourceCore (properUPred_ent_trans Core Body
        (msc_inv H G gam a) coreBody bodyInv)

\func msc_load_post {S : gFunctors} (G : mscG S)
    (name : gname) (lower : Nat) (returned : Value) : iProp S =>
  mkProperExist Nat (\lam n =>
    mkProperSep (mkProperPure (returned = natV n))
      (mkProperSep (msc_shard_lb G name n)
        (mkProperPure (lower <= n))))

-- Observe the focused monotone authority without consuming it: retain all
-- resources needed to rebuild the invariant, snapshot the current value as a
-- persistent lower bound, and validate the caller's earlier lower bound.
\lemma msc_load_after_observe {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a i : Nat) (name : gname) (lower : Nat)
    (rw : msc_load_witness {S} gam i name) :
  properUPred_ent
    (mkProperSep
      (msc_incr_after H G gam a i rw.1)
      (msc_shard_lb G name lower))
    (mkProperSep
      (msc_incr_after H G gam a i rw.1)
      (mkProperSep
        (msc_shard_lb G name rw.1.incr_old)
        (mkProperPure (lower <= rw.1.incr_old)))) =>
  \let
    | w => rw.1
    | After => msc_incr_after H G gam a i w
    | Mono => mono_nat_auth_own G.msc_mono_natG
        w.incr_name qp_one w.incr_old
    | LB0 => msc_shard_lb G name lower
    | Current => msc_shard_lb G name w.incr_old
    | Bound => mkProperPure (lower <= w.incr_old)
    | Source => mkProperSep After LB0
    | MonoTail => mkProperSep Mono
        (mkProperSep
          (msc_mono_rest G w.incr_prefix w.incr_name_prefix
            w.incr_suffix w.incr_name_suffix)
          (msc_requests H G gam (msc_incr_total w) w.incr_requests))
    | ArrayTail => mkProperSep
        (pointsto_array_rest H.iris_gen_heap suc a
          (map natV w.incr_prefix) (map natV w.incr_suffix)) MonoTail
    | monoOf : properUPred_ent After Mono =>
        properUPred_ent_trans After ArrayTail Mono
          (sep_elim_r_ent (msc_counter_auth G gam (msc_incr_total w))
            ArrayTail)
          (properUPred_ent_trans ArrayTail MonoTail Mono
            (sep_elim_r_ent
              (pointsto_array_rest H.iris_gen_heap suc a
                (map natV w.incr_prefix) (map natV w.incr_suffix))
              MonoTail)
            (sep_elim_l_ent Mono
              (mkProperSep
                (msc_mono_rest G w.incr_prefix w.incr_name_prefix
                  w.incr_suffix w.incr_name_suffix)
                (msc_requests H G gam (msc_incr_total w)
                  w.incr_requests))))
    | currentOf : properUPred_ent After Current =>
        properUPred_ent_trans After Mono Current monoOf
          (transport (\lam nm => properUPred_ent Mono
              (msc_shard_lb G nm w.incr_old))
            rw.2
            (mono_nat_lb_own_get G.msc_mono_natG
              w.incr_name qp_one w.incr_old))
    | currentPersistent : properUPred_ent After
        (mkProperPersistently Current) =>
        properUPred_ent_trans After Current
          (mkProperPersistently Current) currentOf
          (mono_nat_lb_own_persistent G.msc_mono_natG
            name w.incr_old)
    | sourceCurrent : properUPred_ent Source
        (mkProperSep Source Current) =>
        persistent_consequence_frame_ent Source Current
          (properUPred_ent_trans Source After
            (mkProperPersistently Current)
            (sep_elim_l_ent After LB0) currentPersistent)
    | boundOf : properUPred_ent Source Bound =>
        properUPred_ent_trans Source
          (mkProperSep Mono
            (msc_shard_lb G w.incr_name lower)) Bound
          (properUPred_ent_trans Source (mkProperSep Mono LB0)
            (mkProperSep Mono
              (msc_shard_lb G w.incr_name lower))
            (sep_mono_l_ent After Mono LB0 monoOf)
            (sep_mono_r_ent Mono LB0
              (msc_shard_lb G w.incr_name lower)
              (transport (\lam nm => properUPred_ent LB0
                  (msc_shard_lb G nm lower))
                (inv rw.2)
                (properUPred_ent_refl LB0))))
          (properUPred_ent_trans
            (mkProperSep Mono
              (msc_shard_lb G w.incr_name lower))
            (mkProperPure
              (\Sigma (qp_one.qp_val RatField.<= RatField.ide)
                (lower <= w.incr_old))) Bound
            (mono_nat_lb_own_valid G.msc_mono_natG
              w.incr_name qp_one w.incr_old lower)
            (\lam _ _ _ h => h.2))
    | withBound : properUPred_ent
        (mkProperSep Source Current)
        (mkProperSep Bound (mkProperSep Source Current)) =>
        pure_consequence_frame_ent (mkProperSep Source Current)
          (lower <= w.incr_old)
          (properUPred_ent_trans (mkProperSep Source Current)
            Source Bound
            (sep_elim_l_ent Source Current) boundOf)
    | Arranged0 => mkProperSep
        (mkProperSep Source Current) Bound
    | Arranged1 => mkProperSep Source (mkProperSep Current Bound)
    | Arranged2 => mkProperSep After
        (mkProperSep LB0 (mkProperSep Current Bound))
    | Target => mkProperSep After (mkProperSep Current Bound)
  \in properUPred_ent_trans Source
      (mkProperSep Source Current) Target sourceCurrent
      (properUPred_ent_trans (mkProperSep Source Current)
        (mkProperSep Bound (mkProperSep Source Current)) Target withBound
        (properUPred_ent_trans
          (mkProperSep Bound (mkProperSep Source Current)) Arranged0 Target
          (sep_comm_ent Bound (mkProperSep Source Current))
          (properUPred_ent_trans Arranged0 Arranged1 Target
            (sep_assoc_l_ent Source Current Bound)
            (properUPred_ent_trans Arranged1 Arranged2 Target
              (sep_assoc_l_ent After LB0 (mkProperSep Current Bound))
              (sep_mono_r_ent After
                (mkProperSep LB0 (mkProperSep Current Bound))
                (mkProperSep Current Bound)
                (sep_elim_r_ent LB0 (mkProperSep Current Bound)))))))

\lemma msc_load_transition {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a i : Nat) (name : gname) (lower : Nat)
    (rw : msc_load_witness {S} gam i name) :
  properUPred_ent
    (mkProperSep
      (msc_incr_now H G gam a i rw.1)
      (mkProperSep
        (msc_incr_after H G gam a i rw.1)
        (mkProperSep
          (mkProperWand (mkProperLater (msc_inv H G gam a))
            (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp))
          (msc_shard_lb G name lower))))
    (mkProperBUpd
      (mkProperFUpd H.iris_wsat msc_open_mask mscE
        (msc_load_post G name lower (natV rw.1.incr_old)))) =>
  \let
    | w => rw.1
    | Cell => msc_incr_now H G gam a i w
    | After => msc_incr_after H G gam a i w
    | Inv => msc_inv H G gam a
    | LaterInv => mkProperLater Inv
    | Close => mkProperWand LaterInv
        (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp)
    | LB0 => msc_shard_lb G name lower
    | Current => msc_shard_lb G name w.incr_old
    | Bound => mkProperPure (lower <= w.incr_old)
    | ResultResources => mkProperSep Current Bound
    | Post => msc_load_post G name lower (natV w.incr_old)
    | Source => mkProperSep Cell
        (mkProperSep After (mkProperSep Close LB0))
    | FocusSource => mkProperSep After LB0
    | Rest => mkProperSep Cell Close
    | ReadyObserve => mkProperSep FocusSource Rest
    | Observed => mkProperSep
        (mkProperSep After ResultResources) Rest
    | O1 => mkProperSep After (mkProperSep ResultResources Rest)
    | O2 => mkProperSep After (mkProperSep Rest ResultResources)
    | O3 => mkProperSep (mkProperSep After Rest) ResultResources
    | O4 => mkProperSep
        (mkProperSep Rest After) ResultResources
    | O5 => mkProperSep
        (mkProperSep Cell (mkProperSep Close After)) ResultResources
    | O6 => mkProperSep
        (mkProperSep Cell (mkProperSep After Close)) ResultResources
    | ReadyClose => mkProperSep
        (mkProperSep (mkProperSep Cell After) Close) ResultResources
    | WithInv => mkProperSep
        (mkProperSep Inv Close) ResultResources
    | WithLater => mkProperSep
        (mkProperSep LaterInv Close) ResultResources
    | Invoked => mkProperSep
        (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp)
        ResultResources
    | Framed => mkProperFUpd H.iris_wsat msc_open_mask mscE
        (mkProperSep mkProperEmp ResultResources)
    | arrangeSource : properUPred_ent Source ReadyObserve =>
        properUPred_ent_trans Source
          (mkProperSep Cell (mkProperSep Close FocusSource)) ReadyObserve
          (sep_mono_r_ent Cell
            (mkProperSep After (mkProperSep Close LB0))
            (mkProperSep Close FocusSource)
            (sep_swap_ent After Close LB0))
          (properUPred_ent_trans
            (mkProperSep Cell (mkProperSep Close FocusSource))
            (mkProperSep Rest FocusSource) ReadyObserve
            (sep_assoc_r_ent Cell Close FocusSource)
            (sep_comm_ent Rest FocusSource))
    | observe : properUPred_ent ReadyObserve Observed =>
        sep_mono_l_ent FocusSource
          (mkProperSep After ResultResources) Rest
          (msc_load_after_observe H G gam a i name lower rw)
    | arrangeObserved : properUPred_ent Observed ReadyClose =>
        properUPred_ent_trans Observed O1 ReadyClose
          (sep_assoc_l_ent After ResultResources Rest)
          (properUPred_ent_trans O1 O2 ReadyClose
            (sep_mono_r_ent After
              (mkProperSep ResultResources Rest)
              (mkProperSep Rest ResultResources)
              (sep_comm_ent ResultResources Rest))
            (properUPred_ent_trans O2 O3 ReadyClose
              (sep_assoc_r_ent After Rest ResultResources)
              (properUPred_ent_trans O3 O4 ReadyClose
                (sep_mono_l_ent (mkProperSep After Rest)
                  (mkProperSep Rest After) ResultResources
                  (sep_comm_ent After Rest))
                (properUPred_ent_trans O4 O5 ReadyClose
                  (sep_mono_l_ent (mkProperSep Rest After)
                    (mkProperSep Cell (mkProperSep Close After))
                    ResultResources
                    (sep_assoc_l_ent Cell Close After))
                  (properUPred_ent_trans O5 O6 ReadyClose
                    (sep_mono_l_ent
                      (mkProperSep Cell (mkProperSep Close After))
                      (mkProperSep Cell (mkProperSep After Close))
                      ResultResources
                      (sep_mono_r_ent Cell
                        (mkProperSep Close After)
                        (mkProperSep After Close)
                        (sep_comm_ent Close After)))
                    (sep_mono_l_ent
                      (mkProperSep Cell (mkProperSep After Close))
                      (mkProperSep (mkProperSep Cell After) Close)
                      ResultResources
                      (sep_assoc_r_ent Cell After Close)))))))
    | restore : properUPred_ent ReadyClose WithInv =>
        sep_mono_l_ent
          (mkProperSep (mkProperSep Cell After) Close)
          (mkProperSep Inv Close) ResultResources
          (sep_mono_l_ent (mkProperSep Cell After) Inv Close
            (msc_incr_restore H G gam a i w))
    | delay : properUPred_ent WithInv WithLater =>
        sep_mono_l_ent (mkProperSep Inv Close)
          (mkProperSep LaterInv Close) ResultResources
          (sep_mono_l_ent Inv LaterInv Close (proper_later_intro Inv))
    | invoke : properUPred_ent WithLater Invoked =>
        sep_mono_l_ent (mkProperSep LaterInv Close)
          (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp)
          ResultResources
          (properUPred_ent_trans (mkProperSep LaterInv Close)
            (mkProperSep Close LaterInv)
            (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp)
            (sep_comm_ent LaterInv Close)
            (wand_elim_ent LaterInv
              (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp)))
    | frame : properUPred_ent Invoked Framed =>
        fupd_frame_r H.iris_wsat msc_open_mask mscE
          mkProperEmp ResultResources
    | makePost : properUPred_ent
        (mkProperSep mkProperEmp ResultResources) Post =>
        properUPred_ent_trans
          (mkProperSep mkProperEmp ResultResources) ResultResources Post
          (sep_elim_r_ent mkProperEmp ResultResources)
          (properUPred_ent_trans ResultResources
            (mkProperSep
              (mkProperPure (natV w.incr_old = natV w.incr_old))
              ResultResources) Post
            (pure_intro_sep_ent
              (natV w.incr_old = natV w.incr_old) idp ResultResources)
            (exist_intro_ent (\lam n =>
              mkProperSep
                (mkProperPure (natV w.incr_old = natV n))
                (mkProperSep (msc_shard_lb G name n)
                  (mkProperPure (lower <= n)))) w.incr_old))
    | close : properUPred_ent Source
        (mkProperFUpd H.iris_wsat msc_open_mask mscE Post) =>
        properUPred_ent_trans Source ReadyObserve
          (mkProperFUpd H.iris_wsat msc_open_mask mscE Post)
          arrangeSource
          (properUPred_ent_trans ReadyObserve Observed
            (mkProperFUpd H.iris_wsat msc_open_mask mscE Post) observe
            (properUPred_ent_trans Observed ReadyClose
              (mkProperFUpd H.iris_wsat msc_open_mask mscE Post)
              arrangeObserved
              (properUPred_ent_trans ReadyClose WithInv
                (mkProperFUpd H.iris_wsat msc_open_mask mscE Post) restore
                (properUPred_ent_trans WithInv WithLater
                  (mkProperFUpd H.iris_wsat msc_open_mask mscE Post) delay
                  (properUPred_ent_trans WithLater Invoked
                    (mkProperFUpd H.iris_wsat msc_open_mask mscE Post) invoke
                    (properUPred_ent_trans Invoked Framed
                      (mkProperFUpd H.iris_wsat msc_open_mask mscE Post)
                      frame
                      (fupd_mono H.iris_wsat msc_open_mask mscE
                        (mkProperSep mkProperEmp ResultResources) Post
                        makePost)))))))
  \in properUPred_ent_trans Source
      (mkProperFUpd H.iris_wsat msc_open_mask mscE Post)
      (mkProperBUpd
        (mkProperFUpd H.iris_wsat msc_open_mask mscE Post))
      close
      (bupd_intro
        (mkProperFUpd H.iris_wsat msc_open_mask mscE Post))

\lemma msc_load_opened {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a i : Nat) (name : gname) (lower : Nat)
    (rw : msc_load_witness {S} gam i name) :
  properUPred_ent
    (mkProperSep
      (mkProperSep
        (mkProperSep
          (msc_incr_now H G gam a i rw.1)
          (mkProperLater
            (msc_incr_after H G gam a i rw.1)))
        (mkProperWand (mkProperLater (msc_inv H G gam a))
          (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp)))
      (msc_shard_lb G name lower))
    (wp H msc_open_mask
      (Load (Val (LitV (LitLoc (a Nat.+ i)))))
      (\lam returned => mkProperFUpd H.iris_wsat
        msc_open_mask mscE (msc_load_post G name lower returned))) =>
  \let
    | w => rw.1
    | Now => msc_incr_now H G gam a i w
    | After => msc_incr_after H G gam a i w
    | Close => mkProperWand (mkProperLater (msc_inv H G gam a))
        (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp)
    | LB0 => msc_shard_lb G name lower
    | CloseLB => mkProperSep Close LB0
    | LoadAfter => mkProperSep After CloseLB
    | PhiLoad : Value -> iProp S => \lam returned =>
        mkProperFUpd H.iris_wsat msc_open_mask mscE
          (msc_load_post G name lower returned)
    | Source => mkProperSep
        (mkProperSep (mkProperSep Now (mkProperLater After)) Close) LB0
    | A1 => mkProperSep (mkProperSep Now (mkProperLater After)) CloseLB
    | A2 => mkProperSep Now (mkProperSep (mkProperLater After) CloseLB)
    | A3 => mkProperSep Now
        (mkProperSep (mkProperLater After) (mkProperLater CloseLB))
    | Ready => mkProperSep Now (mkProperLater LoadAfter)
    | arrange : properUPred_ent Source Ready =>
        properUPred_ent_trans Source A1 Ready
          (sep_assoc_l_ent (mkProperSep Now (mkProperLater After))
            Close LB0)
          (properUPred_ent_trans A1 A2 Ready
            (sep_assoc_l_ent Now (mkProperLater After) CloseLB)
            (properUPred_ent_trans A2 A3 Ready
              (sep_mono_r_ent Now
                (mkProperSep (mkProperLater After) CloseLB)
                (mkProperSep (mkProperLater After)
                  (mkProperLater CloseLB))
                (sep_mono_r_ent (mkProperLater After) CloseLB
                  (mkProperLater CloseLB) (proper_later_intro CloseLB)))
              (sep_mono_r_ent Now
                (mkProperSep (mkProperLater After)
                  (mkProperLater CloseLB))
                (mkProperLater LoadAfter)
                (proper_later_sep_2 After CloseLB))))
    | load : properUPred_ent Ready
        (wp H msc_open_mask
          (Load (Val (LitV (LitLoc (a Nat.+ i))))) PhiLoad) =>
        wp_load_later_frame H msc_open_mask (a Nat.+ i)
          (DfracOwn qp_one) (natV w.incr_old) LoadAfter PhiLoad
          (msc_load_transition H G gam a i name lower rw)
  \in properUPred_ent_trans Source Ready
      (wp H msc_open_mask
        (Load (Val (LitV (LitLoc (a Nat.+ i))))) PhiLoad)
      arrange load

\lemma msc_load_shard_wp {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a i : Nat)
    (namePrefix : List gname) (name : gname)
    (nameSuffix : List gname) (lower : Nat)
    (namesEq : gam.msc_shard_names =
      namePrefix ++ name :: nameSuffix)
    (namePrefixLen : length namePrefix = i)
    (hi : nat_lt i gam.msc_size) :
  properUPred_ent
    (mkProperSep
      (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a))
      (msc_shard_lb G name lower))
    (wp H mscE (Load (Val (LitV (LitLoc (a Nat.+ i)))))
      (msc_load_post G name lower)) =>
  wp_atomic_inv_acc_timeless_exist_frame H mscE mscN
    (msc_inv H G gam a)
    (\lam rw => msc_incr_now H G gam a i rw.1)
    (\lam rw => msc_incr_after H G gam a i rw.1)
    (msc_shard_lb G name lower)
    (Load (Val (LitV (LitLoc (a Nat.+ i)))))
    (msc_load_post G name lower)
    mscN_subset_mscE (load_strongly_atomic (a Nat.+ i))
    (\lam rw => msc_incr_now_timeless H G gam a i rw.1)
    (msc_inv_split_given_name H G gam a i
      namePrefix name nameSuffix namesEq namePrefixLen hi)
    (\lam rw => msc_load_opened H G gam a i name lower rw)

\func msc_sum_loop_unfold (a T i acc : Nat) : Expr =>
  If (NatEq (Val (natV i)) (Val (natV T)))
    (Val (natV acc))
    (letE nL
      (LocAdd (Val (LitV (LitLoc a))) (Val (natV i)))
      (letE nN (Load (Var nL))
        (letE nNextI
          (NatAdd (Val (natV i)) (Val (natV 1)))
          (letE nNextAcc
            (NatAdd (Val (natV acc)) (Var nN))
            (app4 (Val msc_sum_loop)
              (Val (LitV (LitLoc a))) (Val (natV T))
              (Var nNextI) (Var nNextAcc))))))

\func msc_sum_loop_unfold_acc (a T i : Nat) : Expr =>
  If (NatEq (Val (natV i)) (Val (natV T)))
    (Var nAcc)
    (letE nL
      (LocAdd (Val (LitV (LitLoc a))) (Val (natV i)))
      (letE nN (Load (Var nL))
        (letE nNextI
          (NatAdd (Val (natV i)) (Val (natV 1)))
          (letE nNextAcc
            (NatAdd (Var nAcc) (Var nN))
            (app4 (Val msc_sum_loop)
              (Val (LitV (LitLoc a))) (Val (natV T))
              (Var nNextI) (Var nNextAcc))))))

\lemma msc_sum_loop_unfold_eq (a T i acc : Nat) :
  msc_sum_loop_unfold a T i acc =
    If (NatEq (Val (natV i)) (Val (natV T)))
      (Val (natV acc))
      (letE nL
        (LocAdd (Val (LitV (LitLoc a))) (Val (natV i)))
        (letE nN (Load (Var nL))
          (letE nNextI
            (NatAdd (Val (natV i)) (Val (natV 1)))
            (letE nNextAcc
              (NatAdd (Val (natV acc)) (Var nN))
              (app4 (Val msc_sum_loop)
                (Val (LitV (LitLoc a))) (Val (natV T))
                (Var nNextI) (Var nNextAcc)))))) => idp

-- Call-by-value let sequencing, derived once so the operation proofs can
-- follow the source program instead of repeating the Lam/App plumbing.
\lemma wp_letE {S : gFunctors} (H : irisGS natCountable S)
    (E : coPset) (x : Name) (rhs body : Expr)
    (Phi : Value -> iProp S) :
  properUPred_ent
    (wp H E rhs (\lam v => wp H E (subst x v body) Phi))
    (wp H E (letE x rhs body) Phi) =>
  \let
    | LamV0 => LamV x body
    | AppPost : Value -> iProp S => \lam v =>
        wp H E (App (Val LamV0) (Val v)) Phi
    | LamPost : Value -> iProp S => \lam vf =>
        wp H E (App (Val vf) rhs) Phi
    | specialize : \Pi (v : Value) -> properUPred_ent
        (wp H E (subst x v body) Phi) (AppPost v) =>
        \lam v => wp_lam_beta H E x body v Phi
    | rhsToApp : properUPred_ent
        (wp H E rhs (\lam v => wp H E (subst x v body) Phi))
        (wp H E (App (Val LamV0) rhs) Phi) =>
        properUPred_ent_trans
          (wp H E rhs (\lam v => wp H E (subst x v body) Phi))
          (wp H E rhs AppPost)
          (wp H E (App (Val LamV0) rhs) Phi)
          (wp_mono H E rhs
            (\lam v => wp H E (subst x v body) Phi) AppPost specialize)
          (wp_bind_app_r H E LamV0 rhs Phi)
    | exposeLam : properUPred_ent
        (wp H E (App (Val LamV0) rhs) Phi)
        (wp H E (letE x rhs body) Phi) =>
        properUPred_ent_trans
          (wp H E (App (Val LamV0) rhs) Phi)
          (wp H E (Val LamV0) LamPost)
          (wp H E (letE x rhs body) Phi)
          (wp_value_intro H E LamV0 LamPost)
          (properUPred_ent_trans
            (wp H E (Val LamV0) LamPost)
            (wp H E (Lam x body) LamPost)
            (wp H E (letE x rhs body) Phi)
            (wp_lam_expr H E x body LamPost)
            (wp_bind_app_l H E (Lam x body) rhs Phi))
  \in properUPred_ent_trans
      (wp H E rhs (\lam v => wp H E (subst x v body) Phi))
      (wp H E (App (Val LamV0) rhs) Phi)
      (wp H E (letE x rhs body) Phi) rhsToApp exposeLam

-- Four beta steps expose one iteration of the concrete recursive scan.
\lemma msc_sum_loop_unfold_wp {S : gFunctors}
    (H : irisGS natCountable S) (a T i acc : Nat)
    (Phi : Value -> iProp S) :
  properUPred_ent (wp H mscE (msc_sum_loop_unfold a T i acc) Phi)
    (wp H mscE
      (app4 (Val msc_sum_loop)
        (Val (LitV (LitLoc a))) (Val (natV T))
        (Val (natV i)) (Val (natV acc))) Phi) =>
  \let
    | A => LitV (LitLoc a)
    | VT => natV T
    | VI => natV i
    | VAcc => natV acc
    | Iter : Expr -> Expr -> Expr -> Expr -> Expr -> Expr =>
        \lam sum av tv iv accv =>
          If (NatEq iv tv) accv
            (letE nL (LocAdd av iv)
              (letE nN (Load (Var nL))
                (letE nNextI (NatAdd iv (Val (natV 1)))
                  (letE nNextAcc (NatAdd accv (Var nN))
                    (app4 sum av tv
                      (Var nNextI) (Var nNextAcc))))))
    | Core => msc_sum_loop_unfold a T i acc
    | AccBody => msc_sum_loop_unfold_acc a T i
    | LamAcc => LamV nAcc AccBody
    | BodyI => Lam nAcc
        (Iter (Val msc_sum_loop) (Val A) (Val VT)
          (Var nI) (Var nAcc))
    | LamI => LamV nI BodyI
    | BodyT => Lam nI (Lam nAcc
        (Iter (Val msc_sum_loop) (Val A) (Var nT)
          (Var nI) (Var nAcc)))
    | LamT => LamV nT BodyT
    | BodyRec => Lam nT (Lam nI (Lam nAcc
        (Iter (Var nSum) (Var nA) (Var nT)
          (Var nI) (Var nAcc))))
    | F1 => App (Val msc_sum_loop) (Val A)
    | F2 => App F1 (Val VT)
    | F3 => App F2 (Val VI)
    | PsiAcc : Value -> iProp S => \lam vf =>
        wp H mscE (App (Val vf) (Val VAcc)) Phi
    | PsiI : Value -> iProp S => \lam vf =>
        wp H mscE (App (Val vf) (Val VI)) PsiAcc
    | PsiT : Value -> iProp S => \lam vf =>
        wp H mscE (App (Val vf) (Val VT)) PsiI
    | accBeta : properUPred_ent (wp H mscE Core Phi)
        (PsiAcc LamAcc) =>
        wp_lam_beta H mscE nAcc AccBody VAcc Phi
    | accLam : properUPred_ent (wp H mscE Core Phi)
        (wp H mscE (Lam nAcc AccBody) PsiAcc) =>
        properUPred_ent_trans (wp H mscE Core Phi)
          (wp H mscE (Val LamAcc) PsiAcc)
          (wp H mscE (Lam nAcc AccBody) PsiAcc)
          (properUPred_ent_trans (wp H mscE Core Phi)
            (PsiAcc LamAcc) (wp H mscE (Val LamAcc) PsiAcc)
            accBeta (wp_value_intro H mscE LamAcc PsiAcc))
          (wp_lam_expr H mscE nAcc AccBody PsiAcc)
    | iBeta : properUPred_ent (wp H mscE Core Phi)
        (PsiI LamI) =>
        properUPred_ent_trans (wp H mscE Core Phi)
          (wp H mscE (Lam nAcc AccBody) PsiAcc)
          (PsiI LamI) accLam
          (wp_lam_beta H mscE nI BodyI VI PsiAcc)
    | iLam : properUPred_ent (wp H mscE Core Phi)
        (wp H mscE (Lam nI BodyI) PsiI) =>
        properUPred_ent_trans (wp H mscE Core Phi)
          (PsiI LamI)
          (wp H mscE (Lam nI BodyI) PsiI)
          iBeta
          (properUPred_ent_trans (PsiI LamI)
            (wp H mscE (Val LamI) PsiI)
            (wp H mscE (Lam nI BodyI) PsiI)
            (wp_value_intro H mscE LamI PsiI)
            (wp_lam_expr H mscE nI BodyI PsiI))
    | tBeta : properUPred_ent (wp H mscE Core Phi)
        (PsiT LamT) =>
        properUPred_ent_trans (wp H mscE Core Phi)
          (wp H mscE (Lam nI BodyI) PsiI)
          (PsiT LamT) iLam
          (wp_lam_beta H mscE nT BodyT VT PsiI)
    | tLam : properUPred_ent (wp H mscE Core Phi)
        (wp H mscE (Lam nT BodyT) PsiT) =>
        properUPred_ent_trans (wp H mscE Core Phi) (PsiT LamT)
          (wp H mscE (Lam nT BodyT) PsiT)
          tBeta
          (properUPred_ent_trans (PsiT LamT)
            (wp H mscE (Val LamT) PsiT)
            (wp H mscE (Lam nT BodyT) PsiT)
            (wp_value_intro H mscE LamT PsiT)
            (wp_lam_expr H mscE nT BodyT PsiT))
    | recBeta : properUPred_ent (wp H mscE Core Phi)
        (wp H mscE F1 PsiT) =>
        properUPred_ent_trans (wp H mscE Core Phi)
          (wp H mscE (Lam nT BodyT) PsiT)
          (wp H mscE F1 PsiT) tLam
          (wp_rec_beta H mscE nSum nA BodyRec A PsiT)
    | f2 : properUPred_ent (wp H mscE Core Phi)
        (wp H mscE F2 PsiI) =>
        properUPred_ent_trans (wp H mscE Core Phi)
          (wp H mscE F1 PsiT) (wp H mscE F2 PsiI) recBeta
          (wp_bind_app_l H mscE F1 (Val VT) PsiI)
    | f3 : properUPred_ent (wp H mscE Core Phi)
        (wp H mscE F3 PsiAcc) =>
        properUPred_ent_trans (wp H mscE Core Phi)
          (wp H mscE F2 PsiI) (wp H mscE F3 PsiAcc) f2
          (wp_bind_app_l H mscE F2 (Val VI) PsiAcc)
  \in properUPred_ent_trans (wp H mscE Core Phi)
      (wp H mscE F3 PsiAcc)
      (wp H mscE (App F3 (Val VAcc)) Phi) f3
      (wp_bind_app_l H mscE F3 (Val VAcc) Phi)

\func append_snoc_cons {A : \Type} (prefix suffix : List A) (x : A) :
  (prefix ++ x :: nil) ++ suffix = prefix ++ x :: suffix \elim prefix
  | nil => idp
  | :: y prefix => pmap (y ::) (append_snoc_cons prefix suffix x)

\lemma length_snoc {A : \Type} (prefix : List A) (x : A) :
  length (prefix ++ x :: nil) = suc (length prefix) \elim prefix
  | nil => idp
  | :: y prefix => pmap suc (length_snoc prefix x)

\func msc_sum_post {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a : Nat)
    (lower : List Nat) (names : List gname) (acc : Nat)
    (v : Value) : iProp S =>
  mkProperSep
    (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
      (msc_inv H G gam a))
    (mkProperExist (List Nat) (\lam reads =>
      mkProperSep (mkProperPure (v = natV (acc Nat.+ nat_sum reads)))
        (mkProperSep (mkProperPure (length reads = length names))
          (mkProperSep
            (mkProperPure (nat_sum lower <= nat_sum reads))
            (msc_lbs G reads names)))))

\lemma msc_sum_post_prepend {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a acc n lowerHead : Nat)
    (lowerTail : List Nat) (name : gname) (names : List gname)
    (v : Value) (headLe : lowerHead <= n) :
  properUPred_ent
    (mkProperSep
      (msc_sum_post H G gam a lowerTail names (acc Nat.+ n) v)
      (msc_shard_lb G name n))
    (msc_sum_post H G gam a
      (lowerHead :: lowerTail) (name :: names) acc v) =>
  \let
    | Inv => iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a)
    | Head => msc_shard_lb G name n
    | TailExists => mkProperExist (List Nat) (\lam reads =>
        mkProperSep
          (mkProperPure
            (v = natV ((acc Nat.+ n) Nat.+ nat_sum reads)))
          (mkProperSep
            (mkProperPure (length reads = length names))
            (mkProperSep
              (mkProperPure (nat_sum lowerTail <= nat_sum reads))
              (msc_lbs G reads names))))
    | AllBody : List Nat -> iProp S => \lam reads =>
        mkProperSep
          (mkProperPure
            (v = natV (acc Nat.+ nat_sum reads)))
          (mkProperSep
            (mkProperPure (length reads = length (name :: names)))
            (mkProperSep
              (mkProperPure
                (nat_sum (lowerHead :: lowerTail) <= nat_sum reads))
              (msc_lbs G reads (name :: names))))
    | AllExists => mkProperExist (List Nat) AllBody
    | one : \Pi (reads : List Nat) -> properUPred_ent
        (mkProperSep
          (mkProperSep
            (mkProperPure
              (v = natV ((acc Nat.+ n) Nat.+ nat_sum reads)))
            (mkProperSep
              (mkProperPure (length reads = length names))
              (mkProperSep
                (mkProperPure (nat_sum lowerTail <= nat_sum reads))
                (msc_lbs G reads names)))) Head)
        AllExists =>
        \lam reads =>
          \let
            | PV => mkProperPure {iResUR S}
                (v = natV ((acc Nat.+ n) Nat.+ nat_sum reads))
            | PL => mkProperPure {iResUR S}
                (length reads = length names)
            | PB => mkProperPure {iResUR S}
                (nat_sum lowerTail <= nat_sum reads)
            | Tail => msc_lbs G reads names
            | Spatial => mkProperSep Head Tail
            | Prepared => mkProperSep PV
                (mkProperSep PL (mkProperSep PB Spatial))
            | arrange : properUPred_ent
                (mkProperSep
                  (mkProperSep PV (mkProperSep PL (mkProperSep PB Tail)))
                  Head) Prepared =>
                properUPred_ent_trans
                  (mkProperSep
                    (mkProperSep PV (mkProperSep PL (mkProperSep PB Tail)))
                    Head)
                  (mkProperSep PV
                    (mkProperSep (mkProperSep PL (mkProperSep PB Tail)) Head))
                  Prepared
                  (sep_assoc_l_ent PV (mkProperSep PL (mkProperSep PB Tail)) Head)
                  (sep_mono_r_ent PV
                    (mkProperSep (mkProperSep PL (mkProperSep PB Tail)) Head)
                    (mkProperSep PL (mkProperSep PB Spatial))
                    (properUPred_ent_trans
                      (mkProperSep (mkProperSep PL (mkProperSep PB Tail)) Head)
                      (mkProperSep PL
                        (mkProperSep (mkProperSep PB Tail) Head))
                      (mkProperSep PL (mkProperSep PB Spatial))
                      (sep_assoc_l_ent PL (mkProperSep PB Tail) Head)
                      (sep_mono_r_ent PL
                        (mkProperSep (mkProperSep PB Tail) Head)
                        (mkProperSep PB Spatial)
                        (properUPred_ent_trans
                          (mkProperSep (mkProperSep PB Tail) Head)
                          (mkProperSep PB (mkProperSep Tail Head))
                          (mkProperSep PB Spatial)
                          (sep_assoc_l_ent PB Tail Head)
                          (sep_mono_r_ent PB (mkProperSep Tail Head) Spatial
                            (sep_comm_ent Tail Head))))))
            | NewBound => mkProperPure {iResUR S}
                (nat_sum (lowerHead :: lowerTail) <= nat_sum (n :: reads))
            | NewLen => mkProperPure {iResUR S}
                (length (n :: reads) = length (name :: names))
            | NewVal => mkProperPure {iResUR S}
                (v = natV (acc Nat.+ nat_sum (n :: reads)))
            | pack : (v = natV ((acc Nat.+ n) Nat.+ nat_sum reads)) ->
                (length reads = length names) ->
                (nat_sum lowerTail <= nat_sum reads) ->
                properUPred_ent Spatial AllExists =>
                \lam hv hlen hbound =>
                  properUPred_ent_trans Spatial
                    (mkProperSep NewBound Spatial) AllExists
                    (pure_intro_sep_ent
                      (nat_sum (lowerHead :: lowerTail) <=
                        nat_sum (n :: reads))
                      (NatSemiring.<=_+ headLe hbound) Spatial)
                    (properUPred_ent_trans
                      (mkProperSep NewBound Spatial)
                      (mkProperSep NewLen (mkProperSep NewBound Spatial))
                      AllExists
                      (pure_intro_sep_ent
                        (length (n :: reads) = length (name :: names))
                        (pmap suc hlen) (mkProperSep NewBound Spatial))
                      (properUPred_ent_trans
                        (mkProperSep NewLen (mkProperSep NewBound Spatial))
                        (mkProperSep NewVal
                          (mkProperSep NewLen
                            (mkProperSep NewBound Spatial)))
                        AllExists
                        (pure_intro_sep_ent
                          (v = natV (acc Nat.+ nat_sum (n :: reads)))
                          (hv *> pmap natV NatSemiring.+-assoc)
                          (mkProperSep NewLen
                            (mkProperSep NewBound Spatial)))
                        (exist_intro_ent AllBody (n :: reads))))
            | conclude : properUPred_ent Prepared AllExists =>
                pure_sep_l_elim
                  (v = natV ((acc Nat.+ n) Nat.+ nat_sum reads))
                  (mkProperSep PL (mkProperSep PB Spatial)) AllExists
                  (\lam hv => pure_sep_l_elim
                    (length reads = length names)
                    (mkProperSep PB Spatial) AllExists
                    (\lam hlen => pure_sep_l_elim
                      (nat_sum lowerTail <= nat_sum reads)
                      Spatial AllExists (pack hv hlen)))
          \in properUPred_ent_trans
              (mkProperSep
                (mkProperSep PV (mkProperSep PL (mkProperSep PB Tail))) Head)
              Prepared AllExists arrange conclude
    | attachHead : properUPred_ent (mkProperSep TailExists Head) AllExists =>
        sep_exist_l_elim (\lam reads =>
          mkProperSep
            (mkProperPure
              (v = natV ((acc Nat.+ n) Nat.+ nat_sum reads)))
            (mkProperSep
              (mkProperPure (length reads = length names))
              (mkProperSep
                (mkProperPure (nat_sum lowerTail <= nat_sum reads))
                (msc_lbs G reads names)))) Head AllExists one
  \in properUPred_ent_trans
      (mkProperSep (mkProperSep Inv TailExists) Head)
      (mkProperSep Inv (mkProperSep TailExists Head))
      (mkProperSep Inv AllExists)
      (sep_assoc_l_ent Inv TailExists Head)
      (sep_mono_r_ent Inv (mkProperSep TailExists Head) AllExists attachHead)

\lemma msc_sum_loop_suffix_wp {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a acc : Nat)
    (prefix names : List gname) (lower : List Nat)
    (namesEq : gam.msc_shard_names = prefix ++ names)
    (sizeEq : gam.msc_size = length prefix Nat.+ length names) :
  properUPred_ent
    (mkProperSep
      (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a))
      (msc_lbs G lower names))
    (wp H mscE
      (app4 (Val msc_sum_loop)
        (Val (LitV (LitLoc a))) (Val (natV gam.msc_size))
        (Val (natV (length prefix))) (Val (natV acc)))
      (msc_sum_post H G gam a lower names acc))
  \elim names, lower
  | nil, nil =>
      \let
        | Inv => iris.base_logic.lib.invariants.inv H.iris_wsat mscN
            (msc_inv H G gam a)
        | Pre => mkProperSep Inv mkProperEmp
        | Post => msc_sum_post H G gam a nil nil acc
        | BodyNil => mkProperSep
            (mkProperPure {iResUR S}
              (natV acc = natV (acc Nat.+ nat_sum nil)))
            (mkProperSep
              (mkProperPure {iResUR S} (length (nil {Nat}) = length (nil {gname})))
              (mkProperSep
                (mkProperPure {iResUR S}
                  (nat_sum nil <= nat_sum (nil {Nat})))
                (msc_lbs G (nil {Nat}) (nil {gname}))))
        | bound : properUPred_ent mkProperEmp
            (mkProperSep
              (mkProperPure {iResUR S}
                (nat_sum nil <= nat_sum (nil {Nat})))
              (msc_lbs G (nil {Nat}) (nil {gname}))) =>
            pure_intro_sep_ent (nat_sum nil <= nat_sum (nil {Nat}))
              zero<=_ (msc_lbs G (nil {Nat}) (nil {gname}))
        | len : properUPred_ent mkProperEmp
            (mkProperSep
              (mkProperPure {iResUR S}
                (length (nil {Nat}) = length (nil {gname})))
              (mkProperSep
                (mkProperPure {iResUR S}
                  (nat_sum nil <= nat_sum (nil {Nat})))
                (msc_lbs G (nil {Nat}) (nil {gname})))) =>
            properUPred_ent_trans mkProperEmp
              (mkProperSep
                (mkProperPure {iResUR S}
                  (nat_sum nil <= nat_sum (nil {Nat})))
                (msc_lbs G (nil {Nat}) (nil {gname})))
              (mkProperSep
                (mkProperPure {iResUR S}
                  (length (nil {Nat}) = length (nil {gname})))
                (mkProperSep
                  (mkProperPure {iResUR S}
                    (nat_sum nil <= nat_sum (nil {Nat})))
                  (msc_lbs G (nil {Nat}) (nil {gname})))) bound
              (pure_intro_sep_ent
                (length (nil {Nat}) = length (nil {gname})) idp
                (mkProperSep
                  (mkProperPure {iResUR S}
                    (nat_sum nil <= nat_sum (nil {Nat})))
                  (msc_lbs G (nil {Nat}) (nil {gname}))))
        | body : properUPred_ent mkProperEmp BodyNil =>
            properUPred_ent_trans mkProperEmp
              (mkProperSep
                (mkProperPure {iResUR S}
                  (length (nil {Nat}) = length (nil {gname})))
                (mkProperSep
                  (mkProperPure {iResUR S}
                    (nat_sum nil <= nat_sum (nil {Nat})))
                  (msc_lbs G (nil {Nat}) (nil {gname}))))
              BodyNil len
              (pure_intro_sep_ent
                (natV acc = natV (acc Nat.+ nat_sum nil)) idp
                (mkProperSep
                  (mkProperPure {iResUR S}
                    (length (nil {Nat}) = length (nil {gname})))
                  (mkProperSep
                    (mkProperPure {iResUR S}
                      (nat_sum nil <= nat_sum (nil {Nat})))
                    (msc_lbs G (nil {Nat}) (nil {gname})))))
        | existsNil : properUPred_ent mkProperEmp
            (mkProperExist (List Nat) (\lam reads =>
              mkProperSep
                (mkProperPure
                  (natV acc = natV (acc Nat.+ nat_sum reads)))
                (mkProperSep
                  (mkProperPure (length reads = length (nil {gname})))
                  (mkProperSep
                    (mkProperPure (nat_sum nil <= nat_sum reads))
                    (msc_lbs G reads (nil {gname})))))) =>
            properUPred_ent_trans mkProperEmp BodyNil
              (mkProperExist (List Nat) (\lam reads =>
                mkProperSep
                  (mkProperPure
                    (natV acc = natV (acc Nat.+ nat_sum reads)))
                  (mkProperSep
                    (mkProperPure (length reads = length (nil {gname})))
                    (mkProperSep
                      (mkProperPure (nat_sum nil <= nat_sum reads))
                      (msc_lbs G reads (nil {gname}))))))
              body
              (exist_intro_ent (\lam reads =>
                mkProperSep
                  (mkProperPure
                    (natV acc = natV (acc Nat.+ nat_sum reads)))
                  (mkProperSep
                    (mkProperPure (length reads = length (nil {gname})))
                    (mkProperSep
                      (mkProperPure (nat_sum nil <= nat_sum reads))
                      (msc_lbs G reads (nil {gname}))))) (nil {Nat}))
        | postAt : properUPred_ent Pre (Post (natV acc)) =>
            sep_mono_r_ent Inv mkProperEmp
              (mkProperExist (List Nat) (\lam reads =>
                mkProperSep
                  (mkProperPure
                    (natV acc = natV (acc Nat.+ nat_sum reads)))
                  (mkProperSep
                    (mkProperPure (length reads = length (nil {gname})))
                    (mkProperSep
                      (mkProperPure (nat_sum nil <= nat_sum reads))
                      (msc_lbs G reads (nil {gname})))))) existsNil
        | value : properUPred_ent Pre
            (wp H mscE (Val (natV acc)) Post) =>
            properUPred_ent_trans Pre (Post (natV acc))
              (wp H mscE (Val (natV acc)) Post) postAt
              (wp_value_intro H mscE (natV acc) Post)
        | indexEq : length prefix = gam.msc_size => inv sizeEq
        | Then => Val (natV acc)
        | Else => letE nL
            (LocAdd (Val (LitV (LitLoc a)))
              (Val (natV (length prefix))))
            (letE nN (Load (Var nL))
              (letE nNextI
                (NatAdd (Val (natV (length prefix))) (Val (natV 1)))
                (letE nNextAcc
                  (NatAdd (Val (natV acc)) (Var nN))
                  (app4 (Val msc_sum_loop)
                    (Val (LitV (LitLoc a))) (Val (natV gam.msc_size))
                    (Var nNextI) (Var nNextAcc)))))
        | Cond => NatEq (Val (natV (length prefix)))
            (Val (natV gam.msc_size))
        | CondPost : Value -> iProp S => \lam v =>
            wp H mscE (If (Val v) Then Else) Post
        | afterIf : properUPred_ent Pre
            (wp H mscE (If (Val (boolV true)) Then Else) Post) =>
            properUPred_ent_trans Pre (wp H mscE Then Post)
              (wp H mscE (If (Val (boolV true)) Then Else) Post)
              value (wp_if_true H mscE Then Else Post)
        | afterEq : properUPred_ent Pre
            (wp H mscE Cond CondPost) =>
            properUPred_ent_trans Pre
              (wp H mscE (Val (boolV true)) CondPost)
              (wp H mscE Cond CondPost)
              (properUPred_ent_trans Pre
                (wp H mscE (If (Val (boolV true)) Then Else) Post)
                (wp H mscE (Val (boolV true)) CondPost)
                afterIf (wp_value_intro H mscE (boolV true) CondPost))
              (wp_nat_eq_true H mscE (length prefix)
                gam.msc_size indexEq CondPost)
        | core : properUPred_ent Pre
            (wp H mscE
              (If Cond Then Else) Post) =>
            properUPred_ent_trans Pre (wp H mscE Cond CondPost)
              (wp H mscE (If Cond Then Else) Post)
              afterEq (wp_bind_if H mscE Cond Then Else Post)
      \in properUPred_ent_trans Pre
          (wp H mscE
            (msc_sum_loop_unfold a gam.msc_size (length prefix) acc) Post)
          (wp H mscE
            (app4 (Val msc_sum_loop)
              (Val (LitV (LitLoc a))) (Val (natV gam.msc_size))
              (Val (natV (length prefix))) (Val (natV acc))) Post)
          core
          (msc_sum_loop_unfold_wp H a gam.msc_size
            (length prefix) acc Post)
  | nil, :: _ _ => \lam n x hx h => \case h \with {
      | inP (_, _, _, _, impossible) => \case impossible \with {}
    }
  | :: _ _, nil => \lam n x hx h => \case h \with {
      | inP (_, _, _, _, impossible) => \case impossible \with {}
    }
  | :: name names, :: lowerHead lowerTail =>
      \let
        | Inv => iris.base_logic.lib.invariants.inv H.iris_wsat mscN
            (msc_inv H G gam a)
        | Head0 => msc_shard_lb G name lowerHead
        | Tail => msc_lbs G lowerTail names
        | Rest => mkProperSep Inv Tail
        | Pre => mkProperSep Inv (mkProperSep Head0 Tail)
        | Post => msc_sum_post H G gam a
            (lowerHead :: lowerTail) (name :: names) acc
        | index => length prefix
        | nextPrefix => prefix ++ name :: nil
        | nextIndexEq : length nextPrefix = suc index =>
            length_snoc prefix name
        | namesEqTail : gam.msc_shard_names = nextPrefix ++ names =>
            namesEq *> inv (append_snoc_cons prefix names name)
        | sizeEqTail : gam.msc_size =
            length nextPrefix Nat.+ length names =>
            sizeEq *> inv (nat_suc_add index (length names)) *>
              inv (pmap (\lam z => z Nat.+ length names) nextIndexEq)
        | hi : nat_lt index gam.msc_size =>
            transport (\lam z => suc index <= z) (inv sizeEq)
              (nat_suc_le_add_suc index (length names))
        | indexNe : index = gam.msc_size -> Empty =>
            \lam heq => NatSemiring.<-irreflexive
              (suc_<=_< (transport (\lam z => suc index <= z)
                (inv heq) hi))
        | LocV => LitV (LitLoc (a Nat.+ index))
        | LoadExpr => Load (Val LocV)
        | LoadPost => msc_load_post G name lowerHead
        | BodyN => letE nNextI
            (NatAdd (Val (natV index)) (Val (natV 1)))
            (letE nNextAcc
              (NatAdd (Val (natV acc)) (Var nN))
              (app4 (Val msc_sum_loop)
                (Val (LitV (LitLoc a))) (Val (natV gam.msc_size))
                (Var nNextI) (Var nNextAcc)))
        | Else => letE nL
            (LocAdd (Val (LitV (LitLoc a))) (Val (natV index)))
            (letE nN (Load (Var nL)) BodyN)
        | Then => Val (natV acc)
        | Cond => NatEq (Val (natV index))
            (Val (natV gam.msc_size))
        | IHPhi : Value -> iProp S =>
            msc_sum_post H G gam a lowerTail names (acc Nat.+ lowerHead)
        | recurFor : \Pi (n : Nat) -> lowerHead <= n -> properUPred_ent
            (mkProperSep (msc_shard_lb G name n) Rest)
            (wp H mscE
              (app4 (Val msc_sum_loop)
                (Val (LitV (LitLoc a))) (Val (natV gam.msc_size))
                (Val (natV (length nextPrefix)))
                (Val (natV (acc Nat.+ n)))) Post) =>
            \lam n headLe =>
              \let
                | Head => msc_shard_lb G name n
                | TailPhi : Value -> iProp S =>
                    msc_sum_post H G gam a lowerTail names (acc Nat.+ n)
                | Call => app4 (Val msc_sum_loop)
                    (Val (LitV (LitLoc a))) (Val (natV gam.msc_size))
                    (Val (natV (length nextPrefix)))
                    (Val (natV (acc Nat.+ n)))
                | ih : properUPred_ent Rest (wp H mscE Call TailPhi) =>
                    msc_sum_loop_suffix_wp H G gam a (acc Nat.+ n)
                      nextPrefix names lowerTail namesEqTail sizeEqTail
                | headWP : properUPred_ent (mkProperSep Head Rest)
                    (mkProperSep Head (wp H mscE Call TailPhi)) =>
                    sep_mono_r_ent Head Rest (wp H mscE Call TailPhi) ih
                | framed : properUPred_ent (mkProperSep Head Rest)
                    (wp H mscE Call
                      (wp_frame_post TailPhi Head)) =>
                    properUPred_ent_trans (mkProperSep Head Rest)
                      (mkProperSep (wp H mscE Call TailPhi) Head)
                      (wp H mscE Call (wp_frame_post TailPhi Head))
                      (properUPred_ent_trans (mkProperSep Head Rest)
                        (mkProperSep Head (wp H mscE Call TailPhi))
                        (mkProperSep (wp H mscE Call TailPhi) Head)
                        headWP
                        (sep_comm_ent Head (wp H mscE Call TailPhi)))
                      (wp_frame_r H mscE Call TailPhi Head)
              \in properUPred_ent_trans (mkProperSep Head Rest)
                  (wp H mscE Call (wp_frame_post TailPhi Head))
                  (wp H mscE Call Post) framed
                  (wp_mono H mscE Call (wp_frame_post TailPhi Head) Post
                    (\lam v => msc_sum_post_prepend H G gam a acc n lowerHead
                      lowerTail name names v headLe))
        | afterN : \Pi (n : Nat) -> lowerHead <= n -> properUPred_ent
            (mkProperSep (msc_shard_lb G name n) Rest)
            (wp H mscE (subst nN (natV n) BodyN) Post) =>
            \lam n headLe =>
              \let
                | Head => msc_shard_lb G name n
                | AccBody => app4 (Val msc_sum_loop)
                    (Val (LitV (LitLoc a))) (Val (natV gam.msc_size))
                    (Val (natV (index Nat.+ 1))) (Var nNextAcc)
                | CallComputed => app4 (Val msc_sum_loop)
                    (Val (LitV (LitLoc a))) (Val (natV gam.msc_size))
                    (Val (natV (index Nat.+ 1)))
                    (Val (natV (acc Nat.+ n)))
                | callIndexEq : index Nat.+ 1 = length nextPrefix =>
                    nat_add_suc_right index 0 *> inv nextIndexEq
                | recurseComputed : properUPred_ent (mkProperSep Head Rest)
                    (wp H mscE CallComputed Post) =>
                    transport (\lam ix => properUPred_ent
                      (mkProperSep Head Rest)
                      (wp H mscE
                        (app4 (Val msc_sum_loop)
                          (Val (LitV (LitLoc a)))
                          (Val (natV gam.msc_size))
                          (Val (natV ix))
                          (Val (natV (acc Nat.+ n)))) Post))
                      (inv callIndexEq) (recurFor n headLe)
                | accValue : properUPred_ent (mkProperSep Head Rest)
                    (wp H mscE (Val (natV (acc Nat.+ n)))
                      (\lam v => wp H mscE
                        (subst nNextAcc v AccBody) Post)) =>
                    properUPred_ent_trans (mkProperSep Head Rest)
                      (wp H mscE CallComputed Post)
                      (wp H mscE (Val (natV (acc Nat.+ n)))
                        (\lam v => wp H mscE
                          (subst nNextAcc v AccBody) Post))
                      recurseComputed
                      (wp_value_intro H mscE (natV (acc Nat.+ n))
                        (\lam v => wp H mscE
                          (subst nNextAcc v AccBody) Post))
                | accAdd : properUPred_ent (mkProperSep Head Rest)
                    (wp H mscE
                      (NatAdd (Val (natV acc)) (Val (natV n)))
                      (\lam v => wp H mscE
                        (subst nNextAcc v AccBody) Post)) =>
                    properUPred_ent_trans (mkProperSep Head Rest)
                      (wp H mscE (Val (natV (acc Nat.+ n)))
                        (\lam v => wp H mscE
                          (subst nNextAcc v AccBody) Post))
                      (wp H mscE
                        (NatAdd (Val (natV acc)) (Val (natV n)))
                        (\lam v => wp H mscE
                          (subst nNextAcc v AccBody) Post))
                      accValue
                      (wp_nat_add H mscE acc n
                        (\lam v => wp H mscE
                          (subst nNextAcc v AccBody) Post))
                | accLet : properUPred_ent (mkProperSep Head Rest)
                    (wp H mscE
                      (letE nNextAcc
                        (NatAdd (Val (natV acc)) (Val (natV n))) AccBody)
                      Post) =>
                    properUPred_ent_trans (mkProperSep Head Rest)
                      (wp H mscE
                        (NatAdd (Val (natV acc)) (Val (natV n)))
                        (\lam v => wp H mscE
                          (subst nNextAcc v AccBody) Post))
                      (wp H mscE
                        (letE nNextAcc
                          (NatAdd (Val (natV acc)) (Val (natV n))) AccBody)
                        Post) accAdd
                      (wp_letE H mscE nNextAcc
                        (NatAdd (Val (natV acc)) (Val (natV n)))
                        AccBody Post)
                | NextIBody => letE nNextAcc
                    (NatAdd (Val (natV acc)) (Val (natV n)))
                    (app4 (Val msc_sum_loop)
                      (Val (LitV (LitLoc a))) (Val (natV gam.msc_size))
                      (Var nNextI) (Var nNextAcc))
                | iValue : properUPred_ent (mkProperSep Head Rest)
                    (wp H mscE (Val (natV (index Nat.+ 1)))
                      (\lam v => wp H mscE
                        (subst nNextI v NextIBody) Post)) =>
                    properUPred_ent_trans (mkProperSep Head Rest)
                      (wp H mscE
                        (subst nNextI (natV (index Nat.+ 1)) NextIBody) Post)
                      (wp H mscE (Val (natV (index Nat.+ 1)))
                        (\lam v => wp H mscE
                          (subst nNextI v NextIBody) Post))
                      accLet
                      (wp_value_intro H mscE (natV (index Nat.+ 1))
                        (\lam v => wp H mscE
                          (subst nNextI v NextIBody) Post))
                | iAdd : properUPred_ent (mkProperSep Head Rest)
                    (wp H mscE
                      (NatAdd (Val (natV index)) (Val (natV 1)))
                      (\lam v => wp H mscE
                        (subst nNextI v NextIBody) Post)) =>
                    properUPred_ent_trans (mkProperSep Head Rest)
                      (wp H mscE (Val (natV (index Nat.+ 1)))
                        (\lam v => wp H mscE
                          (subst nNextI v NextIBody) Post))
                      (wp H mscE
                        (NatAdd (Val (natV index)) (Val (natV 1)))
                        (\lam v => wp H mscE
                          (subst nNextI v NextIBody) Post))
                      iValue
                      (wp_nat_add H mscE index 1
                        (\lam v => wp H mscE
                          (subst nNextI v NextIBody) Post))
              \in properUPred_ent_trans (mkProperSep Head Rest)
                  (wp H mscE
                    (NatAdd (Val (natV index)) (Val (natV 1)))
                    (\lam v => wp H mscE
                      (subst nNextI v NextIBody) Post))
                  (wp H mscE (subst nN (natV n) BodyN) Post)
                  iAdd
                  (wp_letE H mscE nNextI
                    (NatAdd (Val (natV index)) (Val (natV 1)))
                    NextIBody Post)
        | loadContinue : \Pi (v : Value) -> properUPred_ent
            (mkProperSep (LoadPost v) Rest)
            (wp H mscE (subst nN v BodyN) Post) =>
            \lam v => sep_exist_l_elim
              (\lam n => mkProperSep (mkProperPure (v = natV n))
                (mkProperSep (msc_shard_lb G name n)
                  (mkProperPure (lowerHead <= n))))
              Rest (wp H mscE (subst nN v BodyN) Post)
              (\lam n =>
                \let
                  | PEq => mkProperPure {iResUR S} (v = natV n)
                  | Head => msc_shard_lb G name n
                  | PBound => mkProperPure {iResUR S} (lowerHead <= n)
                  | Prepared => mkProperSep PEq
                      (mkProperSep PBound (mkProperSep Head Rest))
                  | arrange : properUPred_ent
                      (mkProperSep
                        (mkProperSep PEq (mkProperSep Head PBound)) Rest)
                      Prepared =>
                      properUPred_ent_trans
                        (mkProperSep
                          (mkProperSep PEq (mkProperSep Head PBound)) Rest)
                        (mkProperSep PEq
                          (mkProperSep (mkProperSep Head PBound) Rest))
                        Prepared
                        (sep_assoc_l_ent PEq (mkProperSep Head PBound) Rest)
                        (sep_mono_r_ent PEq
                          (mkProperSep (mkProperSep Head PBound) Rest)
                          (mkProperSep PBound (mkProperSep Head Rest))
                          (properUPred_ent_trans
                            (mkProperSep (mkProperSep Head PBound) Rest)
                            (mkProperSep Head (mkProperSep PBound Rest))
                            (mkProperSep PBound (mkProperSep Head Rest))
                            (sep_assoc_l_ent Head PBound Rest)
                            (sep_swap_ent Head PBound Rest)))
                  | conclude : properUPred_ent Prepared
                      (wp H mscE (subst nN v BodyN) Post) =>
                      pure_sep_l_elim (v = natV n)
                        (mkProperSep PBound (mkProperSep Head Rest))
                        (wp H mscE (subst nN v BodyN) Post)
                        (\lam heq => pure_sep_l_elim (lowerHead <= n)
                          (mkProperSep Head Rest)
                          (wp H mscE (subst nN v BodyN) Post)
                          (\lam hbound => transport (\lam vv =>
                            properUPred_ent (mkProperSep Head Rest)
                              (wp H mscE (subst nN vv BodyN) Post))
                            (inv heq) (afterN n hbound)))
                \in properUPred_ent_trans
                    (mkProperSep
                      (mkProperSep PEq (mkProperSep Head PBound)) Rest)
                    Prepared (wp H mscE (subst nN v BodyN) Post)
                    arrange conclude)
        | dupInv : properUPred_ent Inv (mkProperSep Inv Inv) =>
            persistent_consequence_frame_ent Inv Inv
              (inv_persistent H.iris_wsat mscN (msc_inv H G gam a))
        | splitPre : properUPred_ent Pre
            (mkProperSep (mkProperSep Inv Head0) Rest) =>
            properUPred_ent_trans Pre
              (mkProperSep (mkProperSep Inv Inv) (mkProperSep Head0 Tail))
              (mkProperSep (mkProperSep Inv Head0) Rest)
              (sep_mono_l_ent Inv (mkProperSep Inv Inv)
                (mkProperSep Head0 Tail) dupInv)
              (properUPred_ent_trans
                (mkProperSep (mkProperSep Inv Inv) (mkProperSep Head0 Tail))
                (mkProperSep Inv
                  (mkProperSep Inv (mkProperSep Head0 Tail)))
                (mkProperSep (mkProperSep Inv Head0) Rest)
                (sep_assoc_l_ent Inv Inv (mkProperSep Head0 Tail))
                (properUPred_ent_trans
                  (mkProperSep Inv
                    (mkProperSep Inv (mkProperSep Head0 Tail)))
                  (mkProperSep Inv (mkProperSep Head0 Rest))
                  (mkProperSep (mkProperSep Inv Head0) Rest)
                  (sep_mono_r_ent Inv (mkProperSep Inv (mkProperSep Head0 Tail))
                    (mkProperSep Head0 Rest) (sep_swap_ent Inv Head0 Tail))
                  (sep_assoc_r_ent Inv Head0 Rest)))
        | loadSpec : properUPred_ent (mkProperSep Inv Head0)
            (wp H mscE LoadExpr LoadPost) =>
            msc_load_shard_wp H G gam a index prefix name names lowerHead
              namesEq idp hi
        | framedLoad : properUPred_ent Pre
            (wp H mscE LoadExpr (wp_frame_post LoadPost Rest)) =>
            properUPred_ent_trans Pre
              (mkProperSep (wp H mscE LoadExpr LoadPost) Rest)
              (wp H mscE LoadExpr (wp_frame_post LoadPost Rest))
              (properUPred_ent_trans Pre
                (mkProperSep (mkProperSep Inv Head0) Rest)
                (mkProperSep (wp H mscE LoadExpr LoadPost) Rest)
                splitPre
                (sep_mono_l_ent (mkProperSep Inv Head0)
                  (wp H mscE LoadExpr LoadPost) Rest loadSpec))
              (wp_frame_r H mscE LoadExpr LoadPost Rest)
        | loadWP : properUPred_ent Pre
            (wp H mscE LoadExpr
              (\lam v => wp H mscE (subst nN v BodyN) Post)) =>
            properUPred_ent_trans Pre
              (wp H mscE LoadExpr (wp_frame_post LoadPost Rest))
              (wp H mscE LoadExpr
                (\lam v => wp H mscE (subst nN v BodyN) Post))
              framedLoad
              (wp_mono H mscE LoadExpr (wp_frame_post LoadPost Rest)
                (\lam v => wp H mscE (subst nN v BodyN) Post)
                loadContinue)
        | loadLet : properUPred_ent Pre
            (wp H mscE (letE nN LoadExpr BodyN) Post) =>
            properUPred_ent_trans Pre
              (wp H mscE LoadExpr
                (\lam v => wp H mscE (subst nN v BodyN) Post))
              (wp H mscE (letE nN LoadExpr BodyN) Post)
              loadWP (wp_letE H mscE nN LoadExpr BodyN Post)
        | LocBody => letE nN (Load (Var nL)) BodyN
        | locValue : properUPred_ent Pre
            (wp H mscE (Val LocV)
              (\lam v => wp H mscE (subst nL v LocBody) Post)) =>
            properUPred_ent_trans Pre
              (wp H mscE (subst nL LocV LocBody) Post)
              (wp H mscE (Val LocV)
                (\lam v => wp H mscE (subst nL v LocBody) Post))
              loadLet
              (wp_value_intro H mscE LocV
                (\lam v => wp H mscE (subst nL v LocBody) Post))
        | locWP : properUPred_ent Pre
            (wp H mscE
              (LocAdd (Val (LitV (LitLoc a))) (Val (natV index)))
              (\lam v => wp H mscE (subst nL v LocBody) Post)) =>
            properUPred_ent_trans Pre
              (wp H mscE (Val LocV)
                (\lam v => wp H mscE (subst nL v LocBody) Post))
              (wp H mscE
                (LocAdd (Val (LitV (LitLoc a))) (Val (natV index)))
                (\lam v => wp H mscE (subst nL v LocBody) Post))
              locValue
              (wp_loc_add H mscE a index
                (\lam v => wp H mscE (subst nL v LocBody) Post))
        | elseWP : properUPred_ent Pre (wp H mscE Else Post) =>
            properUPred_ent_trans Pre
              (wp H mscE
                (LocAdd (Val (LitV (LitLoc a))) (Val (natV index)))
                (\lam v => wp H mscE (subst nL v LocBody) Post))
              (wp H mscE Else Post) locWP
              (wp_letE H mscE nL
                (LocAdd (Val (LitV (LitLoc a))) (Val (natV index)))
                LocBody Post)
        | afterIf : properUPred_ent Pre
            (wp H mscE (If (Val (boolV false)) Then Else) Post) =>
            properUPred_ent_trans Pre (wp H mscE Else Post)
              (wp H mscE (If (Val (boolV false)) Then Else) Post)
              elseWP (wp_if_false H mscE Then Else Post)
        | CondPost : Value -> iProp S => \lam v =>
            wp H mscE (If (Val v) Then Else) Post
        | condValue : properUPred_ent Pre
            (wp H mscE (Val (boolV false)) CondPost) =>
            properUPred_ent_trans Pre
              (wp H mscE (If (Val (boolV false)) Then Else) Post)
              (wp H mscE (Val (boolV false)) CondPost)
              afterIf (wp_value_intro H mscE (boolV false) CondPost)
        | condWP : properUPred_ent Pre (wp H mscE Cond CondPost) =>
            properUPred_ent_trans Pre
              (wp H mscE (Val (boolV false)) CondPost)
              (wp H mscE Cond CondPost) condValue
              (wp_nat_eq_false H mscE index gam.msc_size indexNe CondPost)
        | core : properUPred_ent Pre
            (wp H mscE (If Cond Then Else) Post) =>
            properUPred_ent_trans Pre (wp H mscE Cond CondPost)
              (wp H mscE (If Cond Then Else) Post) condWP
              (wp_bind_if H mscE Cond Then Else Post)
      \in properUPred_ent_trans Pre
          (wp H mscE
            (msc_sum_loop_unfold a gam.msc_size index acc) Post)
          (wp H mscE
            (app4 (Val msc_sum_loop)
              (Val (LitV (LitLoc a))) (Val (natV gam.msc_size))
              (Val (natV index)) (Val (natV acc))) Post)
          core
          (msc_sum_loop_unfold_wp H a gam.msc_size index acc Post)
-- The invariant witnesses retained across the atomic NewProph step.  Unlike
-- the shard-focused witnesses above, a read keeps the complete array and all
-- monotone authorities: the following scan only needs a persistent snapshot.
\record msc_read_witness (gam : msc_name)
  | read_initial : List Nat
  | read_requests : Gmap Nat natCountable (\Sigma Nat gname)
  | read_initial_len : length read_initial = gam.msc_size
  | read_names_len : length gam.msc_shard_names = gam.msc_size

\func msc_read_now {S : gFunctors} {gam : msc_name}
    (w : msc_read_witness gam) : iProp S =>
  mkProperEmp

\func msc_read_after {S : gFunctors} (H : irisGS natCountable S)
    (G : mscG S) (gam : msc_name) (a : Nat)
    (w : msc_read_witness gam) : iProp S =>
  msc_inv_body_names H G gam a w.read_initial gam.msc_shard_names
    w.read_requests

\lemma msc_read_now_timeless {S : gFunctors} (gam : msc_name)
    (w : msc_read_witness gam) : Timeless (msc_read_now {S} w) =>
  timeless_emp {iResUR S}

-- Expose the invariant in the dependent shape expected by the atomic
-- invariant-access rule.  The empty immediate component is intentional: all
-- resources are released from the invariant one step later by NewProph.
\lemma msc_inv_read_split {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a : Nat) :
  properUPred_ent (msc_inv H G gam a)
    (mkProperExist (msc_read_witness gam) (\lam w =>
      mkProperSep (msc_read_now {S} w) (msc_read_after H G gam a w))) =>
  \lam n x hx hinv => \case hinv \with {
    | inP (initial, inP (requests, hbody)) => \case hbody \with {
      | inP (_, _, _, hlen, hrest) => \case hrest \with {
        | inP (_, _, _, hnames, _) =>
          \let
            | w : msc_read_witness gam => \new msc_read_witness {
                | read_initial => initial
                | read_requests => requests
                | read_initial_len => hlen
                | read_names_len => hnames
              }
            | hemp : (msc_read_now {S} w).upred_holds n
                (iResUR S).unit => emp_holds_all {iResUR S} n (iResUR S).unit
          \in inP (w, inP ((iResUR S).unit, x,
            (iResUR S).ofe_dist_sym n
              ((iResUR S).op (iResUR S).unit x) x
              (ucmra_unit_left_id_dist {iResUR S} n x), hemp, hbody))
      }
    }
  }

\func msc_read_shift {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (P : iProp S) (Q : Nat -> iProp S) : iProp S =>
  mkProperForall Nat (\lam total =>
    mkProperPersistently
      (mkProperWand
        (mkProperSep (msc_counter_auth G gam total) P)
        (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
          (mkProperSep (msc_counter_auth G gam total) (Q total)))))

\func msc_read_registered {S : gFunctors} (G : mscG S)
    (gam : msc_name) (predicted initialTotal : Nat) (gamQ : gname) : iProp S =>
  mkProperSep (mkProperPure (initialTotal <= predicted))
    (mkProperExist Nat (\lam id =>
      ghost_map_elem (msc_requestGS G gam) id (predicted, gamQ)))

\func msc_read_unregistered {S : gFunctors} (predicted initialTotal : Nat)
    (P : iProp S) : iProp S =>
  mkProperSep (mkProperPure (nat_lt predicted initialTotal)) P

\func msc_read_case {S : gFunctors} (G : mscG S) (gam : msc_name)
    (predicted initialTotal : Nat) (gamQ : gname) (P : iProp S) : iProp S =>
  mkProperOr
    (msc_read_registered G gam predicted initialTotal gamQ)
    (msc_read_unregistered predicted initialTotal P)

-- The monotone snapshot is persistent, so it can be attached while retaining
-- the complete invariant body that will later be closed again.
\lemma msc_read_snapshot {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a : Nat) (w : msc_read_witness gam) :
  properUPred_ent (msc_read_after H G gam a w)
    (mkProperSep (msc_read_after H G gam a w)
      (msc_lbs G w.read_initial gam.msc_shard_names)) =>
  \let
    | LenN => mkProperPure {iResUR S}
        (length w.read_initial = gam.msc_size)
    | LenNames => mkProperPure {iResUR S}
        (length gam.msc_shard_names = gam.msc_size)
    | Auth => msc_counter_auth G gam (nat_sum w.read_initial)
    | Cells => pointsto_array H.iris_gen_heap suc a
        (map natV w.read_initial)
    | Monos => msc_mono_auths G w.read_initial gam.msc_shard_names
    | Requests => msc_requests H G gam (nat_sum w.read_initial)
        w.read_requests
    | Body => msc_read_after H G gam a w
    | LBs => msc_lbs G w.read_initial gam.msc_shard_names
    | toMonos : properUPred_ent Body Monos =>
        properUPred_ent_trans Body
          (mkProperSep Auth
            (mkProperSep (mkProperSep Cells Monos) Requests)) Monos
          (properUPred_ent_trans Body
            (mkProperSep LenNames
              (mkProperSep Auth
                (mkProperSep (mkProperSep Cells Monos) Requests)))
            (mkProperSep Auth
              (mkProperSep (mkProperSep Cells Monos) Requests))
            (sep_elim_r_ent LenN
              (mkProperSep LenNames
                (mkProperSep Auth
                  (mkProperSep (mkProperSep Cells Monos) Requests))))
            (sep_elim_r_ent LenNames
              (mkProperSep Auth
                (mkProperSep (mkProperSep Cells Monos) Requests))))
          (properUPred_ent_trans
            (mkProperSep Auth
              (mkProperSep (mkProperSep Cells Monos) Requests))
            (mkProperSep (mkProperSep Cells Monos) Requests) Monos
            (sep_elim_r_ent Auth
              (mkProperSep (mkProperSep Cells Monos) Requests))
            (properUPred_ent_trans
              (mkProperSep (mkProperSep Cells Monos) Requests)
              (mkProperSep Cells Monos) Monos
              (sep_elim_l_ent (mkProperSep Cells Monos) Requests)
              (sep_elim_r_ent Cells Monos)))
    | toPersistent : properUPred_ent Body (mkProperPersistently LBs) =>
        properUPred_ent_trans Body Monos
          (mkProperPersistently LBs) toMonos
          (properUPred_ent_trans Monos LBs (mkProperPersistently LBs)
            (msc_mono_auths_to_lbs G w.read_initial gam.msc_shard_names)
            (msc_lbs_persistent G w.read_initial gam.msc_shard_names))
  \in persistent_consequence_frame_ent Body LBs toPersistent

\lemma msc_read_rebuild {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a : Nat) (w : msc_read_witness gam)
    (requests : Gmap Nat natCountable (\Sigma Nat gname)) :
  properUPred_ent
    (msc_inv_body_names H G gam a w.read_initial
      gam.msc_shard_names requests)
    (msc_inv H G gam a) =>
  properUPred_ent_trans
    (msc_inv_body_names H G gam a w.read_initial
      gam.msc_shard_names requests)
    (mkProperExist (Gmap Nat natCountable (\Sigma Nat gname))
      (\lam requests0 => msc_inv_body_names H G gam a w.read_initial
        gam.msc_shard_names requests0))
    (msc_inv H G gam a)
    (exist_intro_ent
      (\lam requests0 => msc_inv_body_names H G gam a w.read_initial
        gam.msc_shard_names requests0) requests)
    (exist_intro_ent
      (\lam initial => mkProperExist
        (Gmap Nat natCountable (\Sigma Nat gname))
        (\lam requests0 => msc_inv_body_names H G gam a initial
          gam.msc_shard_names requests0)) w.read_initial)

-- Specialize the client's logically atomic read update and feed it, together
-- with the saved postcondition, to the request-registration protocol.
\lemma msc_read_register_core {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (total predicted : Nat) (gamQ : gname)
    (requests : Gmap Nat natCountable (\Sigma Nat gname))
    (P : iProp S) (Q : Nat -> iProp S) (hle : total <= predicted) :
  properUPred_ent
    (mkProperSep (msc_counter_auth G gam total)
      (mkProperSep (msc_requests H G gam total requests)
        (mkProperSep
          (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
          (mkProperSep (msc_read_shift H G gam P Q) P))))
    (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
      (mkProperExist Nat (\lam id =>
        mkProperSep (msc_counter_auth G gam total)
          (mkProperSep
            (msc_requests H G gam total
              (ginsert id (predicted, gamQ) requests))
            (ghost_map_elem (msc_requestGS G gam) id
              (predicted, gamQ)))))) =>
  \let
    | Auth => msc_counter_auth G gam total
    | Map => ghost_map_auth (msc_requestGS G gam) qp_one requests
    | States => big_sepM requests (\lam _ request =>
        msc_read_state H G gam total request)
    | Saved => saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q
    | VS => msc_read_shift H G gam P Q
    | Shift => mkProperPersistently
        (mkProperWand
          (mkProperSep (msc_counter_auth G gam predicted) P)
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
            (mkProperSep (msc_counter_auth G gam predicted) (Q predicted))))
    | Client => mkProperSep Saved (mkProperSep VS P)
    | Client' => mkProperSep Saved (mkProperSep Shift P)
    | Source => mkProperSep Auth
        (mkProperSep (mkProperSep Map States) Client)
    | Expected => mkProperSep Auth
        (mkProperSep Map (mkProperSep Client' States))
    | client : properUPred_ent Client Client' =>
        sep_mono_r_ent Saved (mkProperSep VS P) (mkProperSep Shift P)
          (sep_mono_l_ent VS Shift P
            (forall_elim_ent (\lam n =>
              mkProperPersistently
                (mkProperWand
                  (mkProperSep (msc_counter_auth G gam n) P)
                  (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                    (mkProperSep (msc_counter_auth G gam n) (Q n)))))
              predicted))
    | arrange : properUPred_ent Source Expected =>
        sep_mono_r_ent Auth
          (mkProperSep (mkProperSep Map States) Client)
          (mkProperSep Map (mkProperSep Client' States))
          (properUPred_ent_trans
            (mkProperSep (mkProperSep Map States) Client)
            (mkProperSep Map (mkProperSep States Client))
            (mkProperSep Map (mkProperSep Client' States))
            (sep_assoc_l_ent Map States Client)
            (sep_mono_r_ent Map (mkProperSep States Client)
              (mkProperSep Client' States)
              (properUPred_ent_trans (mkProperSep States Client)
                (mkProperSep Client States) (mkProperSep Client' States)
                (sep_comm_ent States Client)
                (sep_mono_l_ent Client Client' States client))))
  \in properUPred_ent_trans Source Expected
      (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
        (mkProperExist Nat (\lam id =>
          mkProperSep Auth
            (mkProperSep
              (msc_requests H G gam total
                (ginsert id (predicted, gamQ) requests))
              (ghost_map_elem (msc_requestGS G gam) id
                (predicted, gamQ))))))
      arrange
      (msc_request_register H G gam total predicted gamQ requests P Q hle)

-- Reassemble the invariant's canonical five-field body while leaving one
-- client-owned resource outside.  This small permutation replaces a sizeable
-- amount of `iFrame` bookkeeping in the Rocq proof.
\lemma msc_read_reorder_body {M : UCMRA}
    (A B C D E X : ProperUPred M) :
  properUPred_ent
    (mkProperSep (mkProperSep C (mkProperSep E X))
      (mkProperSep A (mkProperSep B D)))
    (mkProperSep
      (mkProperSep A (mkProperSep B
        (mkProperSep C (mkProperSep D E)))) X) =>
  \let
    | S0 => mkProperSep (mkProperSep C (mkProperSep E X))
        (mkProperSep A (mkProperSep B D))
    | S1 => mkProperSep (mkProperSep A (mkProperSep B D))
        (mkProperSep C (mkProperSep E X))
    | S2 => mkProperSep A
        (mkProperSep (mkProperSep B D)
          (mkProperSep C (mkProperSep E X)))
    | S3 => mkProperSep A (mkProperSep B
        (mkProperSep D (mkProperSep C (mkProperSep E X))))
    | S4 => mkProperSep A (mkProperSep B
        (mkProperSep C (mkProperSep D (mkProperSep E X))))
    | S5 => mkProperSep A (mkProperSep B
        (mkProperSep C (mkProperSep (mkProperSep D E) X)))
    | S6 => mkProperSep A (mkProperSep B
        (mkProperSep (mkProperSep C (mkProperSep D E)) X))
    | S7 => mkProperSep A
        (mkProperSep (mkProperSep B
          (mkProperSep C (mkProperSep D E))) X)
    | Target => mkProperSep
        (mkProperSep A (mkProperSep B
          (mkProperSep C (mkProperSep D E)))) X
  \in properUPred_ent_trans S0 S1 Target
      (sep_comm_ent (mkProperSep C (mkProperSep E X))
        (mkProperSep A (mkProperSep B D)))
      (properUPred_ent_trans S1 S2 Target
        (sep_assoc_l_ent A (mkProperSep B D)
          (mkProperSep C (mkProperSep E X)))
        (properUPred_ent_trans S2 S3 Target
          (sep_mono_r_ent A
            (mkProperSep (mkProperSep B D)
              (mkProperSep C (mkProperSep E X)))
            (mkProperSep B
              (mkProperSep D (mkProperSep C (mkProperSep E X))))
            (sep_assoc_l_ent B D (mkProperSep C (mkProperSep E X))))
          (properUPred_ent_trans S3 S4 Target
            (sep_mono_r_ent A
              (mkProperSep B
                (mkProperSep D (mkProperSep C (mkProperSep E X))))
              (mkProperSep B
                (mkProperSep C (mkProperSep D (mkProperSep E X))))
              (sep_mono_r_ent B
                (mkProperSep D (mkProperSep C (mkProperSep E X)))
                (mkProperSep C (mkProperSep D (mkProperSep E X)))
                (sep_swap_ent D C (mkProperSep E X))))
            (properUPred_ent_trans S4 S5 Target
              (sep_mono_r_ent A
                (mkProperSep B
                  (mkProperSep C (mkProperSep D (mkProperSep E X))))
                (mkProperSep B
                  (mkProperSep C (mkProperSep (mkProperSep D E) X)))
                (sep_mono_r_ent B
                  (mkProperSep C (mkProperSep D (mkProperSep E X)))
                  (mkProperSep C (mkProperSep (mkProperSep D E) X))
                  (sep_mono_r_ent C
                    (mkProperSep D (mkProperSep E X))
                    (mkProperSep (mkProperSep D E) X)
                    (sep_assoc_r_ent D E X))))
              (properUPred_ent_trans S5 S6 Target
                (sep_mono_r_ent A
                  (mkProperSep B
                    (mkProperSep C (mkProperSep (mkProperSep D E) X)))
                  (mkProperSep B
                    (mkProperSep (mkProperSep C (mkProperSep D E)) X))
                  (sep_mono_r_ent B
                    (mkProperSep C (mkProperSep (mkProperSep D E) X))
                    (mkProperSep (mkProperSep C (mkProperSep D E)) X)
                    (sep_assoc_r_ent C (mkProperSep D E) X)))
                (properUPred_ent_trans S6 S7 Target
                  (sep_mono_r_ent A
                    (mkProperSep B
                      (mkProperSep (mkProperSep C (mkProperSep D E)) X))
                    (mkProperSep (mkProperSep B
                      (mkProperSep C (mkProperSep D E))) X)
                    (sep_assoc_r_ent B
                      (mkProperSep C (mkProperSep D E)) X))
                  (sep_assoc_r_ent A
                    (mkProperSep B (mkProperSep C (mkProperSep D E))) X)))))))

\lemma msc_read_extract_body {M : UCMRA}
    (A B C D E X : ProperUPred M) :
  properUPred_ent
    (mkProperSep
      (mkProperSep A (mkProperSep B
        (mkProperSep C (mkProperSep D E)))) X)
    (mkProperSep (mkProperSep C (mkProperSep E X))
      (mkProperSep A (mkProperSep B D))) =>
  \let
    | S0 => mkProperSep
        (mkProperSep A (mkProperSep B
          (mkProperSep C (mkProperSep D E)))) X
    | S1 => mkProperSep A
        (mkProperSep (mkProperSep B
          (mkProperSep C (mkProperSep D E))) X)
    | S2 => mkProperSep A (mkProperSep B
        (mkProperSep (mkProperSep C (mkProperSep D E)) X))
    | S3 => mkProperSep A (mkProperSep B
        (mkProperSep C (mkProperSep (mkProperSep D E) X)))
    | S4 => mkProperSep A (mkProperSep B
        (mkProperSep C (mkProperSep D (mkProperSep E X))))
    | S5 => mkProperSep A (mkProperSep B
        (mkProperSep D (mkProperSep C (mkProperSep E X))))
    | S6 => mkProperSep A
        (mkProperSep (mkProperSep B D)
          (mkProperSep C (mkProperSep E X)))
    | S7 => mkProperSep (mkProperSep A (mkProperSep B D))
        (mkProperSep C (mkProperSep E X))
    | Target => mkProperSep (mkProperSep C (mkProperSep E X))
        (mkProperSep A (mkProperSep B D))
  \in properUPred_ent_trans S0 S1 Target
      (sep_assoc_l_ent A
        (mkProperSep B (mkProperSep C (mkProperSep D E))) X)
      (properUPred_ent_trans S1 S2 Target
        (sep_mono_r_ent A
          (mkProperSep (mkProperSep B
            (mkProperSep C (mkProperSep D E))) X)
          (mkProperSep B
            (mkProperSep (mkProperSep C (mkProperSep D E)) X))
          (sep_assoc_l_ent B (mkProperSep C (mkProperSep D E)) X))
        (properUPred_ent_trans S2 S3 Target
          (sep_mono_r_ent A
            (mkProperSep B
              (mkProperSep (mkProperSep C (mkProperSep D E)) X))
            (mkProperSep B
              (mkProperSep C (mkProperSep (mkProperSep D E) X)))
            (sep_mono_r_ent B
              (mkProperSep (mkProperSep C (mkProperSep D E)) X)
              (mkProperSep C (mkProperSep (mkProperSep D E) X))
              (sep_assoc_l_ent C (mkProperSep D E) X)))
          (properUPred_ent_trans S3 S4 Target
            (sep_mono_r_ent A
              (mkProperSep B
                (mkProperSep C (mkProperSep (mkProperSep D E) X)))
              (mkProperSep B
                (mkProperSep C (mkProperSep D (mkProperSep E X))))
              (sep_mono_r_ent B
                (mkProperSep C (mkProperSep (mkProperSep D E) X))
                (mkProperSep C (mkProperSep D (mkProperSep E X)))
                (sep_mono_r_ent C
                  (mkProperSep (mkProperSep D E) X)
                  (mkProperSep D (mkProperSep E X))
                  (sep_assoc_l_ent D E X))))
            (properUPred_ent_trans S4 S5 Target
              (sep_mono_r_ent A
                (mkProperSep B
                  (mkProperSep C (mkProperSep D (mkProperSep E X))))
                (mkProperSep B
                  (mkProperSep D (mkProperSep C (mkProperSep E X))))
                (sep_mono_r_ent B
                  (mkProperSep C (mkProperSep D (mkProperSep E X)))
                  (mkProperSep D (mkProperSep C (mkProperSep E X)))
                  (sep_swap_ent C D (mkProperSep E X))))
              (properUPred_ent_trans S5 S6 Target
                (sep_mono_r_ent A
                  (mkProperSep B
                    (mkProperSep D (mkProperSep C (mkProperSep E X))))
                  (mkProperSep (mkProperSep B D)
                    (mkProperSep C (mkProperSep E X)))
                  (sep_assoc_r_ent B D (mkProperSep C (mkProperSep E X))))
                (properUPred_ent_trans S6 S7 Target
                  (sep_assoc_r_ent A (mkProperSep B D)
                    (mkProperSep C (mkProperSep E X)))
                  (sep_comm_ent (mkProperSep A (mkProperSep B D))
                    (mkProperSep C (mkProperSep E X)))))))))

\lemma msc_read_register_or_keep {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (a predicted : Nat) (gamQ : gname) (w : msc_read_witness gam)
    (P : iProp S) (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep (msc_read_after H G gam a w)
      (mkProperSep
        (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
        (mkProperSep (msc_read_shift H G gam P Q) P)))
    (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
      (mkProperExist
        (Gmap Nat natCountable (\Sigma Nat gname)) (\lam requests =>
          mkProperSep
            (msc_inv_body_names H G gam a w.read_initial
              gam.msc_shard_names requests)
            (msc_read_case G gam predicted (nat_sum w.read_initial)
              gamQ P)))) =>
  \let
    | Total => nat_sum w.read_initial
    | LenN => mkProperPure {iResUR S}
        (length w.read_initial = gam.msc_size)
    | LenNames => mkProperPure {iResUR S}
        (length gam.msc_shard_names = gam.msc_size)
    | Auth => msc_counter_auth G gam Total
    | Shards => msc_shards H G a w.read_initial gam.msc_shard_names
    | Requests0 => msc_requests H G gam Total w.read_requests
    | Saved => saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q
    | VS => msc_read_shift H G gam P Q
    | Client => mkProperSep Saved (mkProperSep VS P)
    | Body0 => msc_read_after H G gam a w
    | Fixed => mkProperSep LenN (mkProperSep LenNames Shards)
    | Source => mkProperSep Body0 Client
    | Target => mkProperExist
        (Gmap Nat natCountable (\Sigma Nat gname)) (\lam requests =>
          mkProperSep
            (msc_inv_body_names H G gam a w.read_initial
              gam.msc_shard_names requests)
            (msc_read_case G gam predicted Total gamQ P))
  \in \case LinearOrder.dec<_<= predicted Total \with {
    | inl hlt =>
      \let
        | Unregistered => msc_read_unregistered {S} predicted Total P
        | keepP : properUPred_ent Client P =>
            properUPred_ent_trans Client (mkProperSep VS P) P
              (sep_elim_r_ent Saved (mkProperSep VS P))
              (sep_elim_r_ent VS P)
        | makeCase : properUPred_ent Client
            (msc_read_case G gam predicted Total gamQ P) =>
            properUPred_ent_trans Client Unregistered
              (msc_read_case G gam predicted Total gamQ P)
              (properUPred_ent_trans Client P Unregistered keepP
                (pure_intro_sep_ent (nat_lt predicted Total)
                  (suc_<_<= hlt) P))
              (or_intro_r_ent
                (msc_read_registered G gam predicted Total gamQ)
                Unregistered)
        | plain : properUPred_ent Source Target =>
            properUPred_ent_trans Source
              (mkProperSep Body0
                (msc_read_case G gam predicted Total gamQ P)) Target
              (sep_mono_r_ent Body0 Client
                (msc_read_case G gam predicted Total gamQ P) makeCase)
              (exist_intro_ent (\lam requests =>
                mkProperSep
                  (msc_inv_body_names H G gam a w.read_initial
                    gam.msc_shard_names requests)
                  (msc_read_case G gam predicted Total gamQ P))
                w.read_requests)
      \in properUPred_ent_trans Source Target
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask Target)
          plain (fupd_intro H.iris_wsat msc_open_mask Target)
    | inr hle =>
      \let
        | Core => mkProperSep Auth (mkProperSep Requests0 Client)
        | Ready => mkProperSep Core Fixed
        | arrange : properUPred_ent Source Ready =>
            msc_read_extract_body LenN LenNames Auth Shards Requests0 Client
        | Updated => mkProperExist Nat (\lam id =>
            mkProperSep Auth
              (mkProperSep
                (msc_requests H G gam Total
                  (ginsert id (predicted, gamQ) w.read_requests))
                (ghost_map_elem (msc_requestGS G gam) id
                  (predicted, gamQ))))
        | runCore : properUPred_ent Core
            (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask Updated) =>
            msc_read_register_core H G gam Total predicted gamQ
              w.read_requests P Q hle
        | runFramed : properUPred_ent Ready
            (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
              (mkProperSep Updated Fixed)) =>
            properUPred_ent_trans Ready
              (mkProperSep
                (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                  Updated) Fixed)
              (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                (mkProperSep Updated Fixed))
              (sep_mono_l_ent Core
                (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                  Updated) Fixed runCore)
              (fupd_frame_r H.iris_wsat msc_open_mask msc_open_mask
                Updated Fixed)
        | finish : properUPred_ent (mkProperSep Updated Fixed) Target =>
            sep_exist_l_elim (\lam id =>
              mkProperSep Auth
                (mkProperSep
                  (msc_requests H G gam Total
                    (ginsert id (predicted, gamQ) w.read_requests))
                  (ghost_map_elem (msc_requestGS G gam) id
                    (predicted, gamQ))))
              Fixed Target (\lam id =>
                \let
                  | Requests1 => msc_requests H G gam Total
                      (ginsert id (predicted, gamQ) w.read_requests)
                  | Elem => ghost_map_elem (msc_requestGS G gam) id
                      (predicted, gamQ)
                  | Body1 => msc_inv_body_names H G gam a w.read_initial
                      gam.msc_shard_names
                      (ginsert id (predicted, gamQ) w.read_requests)
                  | Registered => msc_read_registered G gam predicted
                      Total gamQ
                  | elemExists : properUPred_ent Elem
                      (mkProperExist Nat (\lam j =>
                        ghost_map_elem (msc_requestGS G gam) j
                          (predicted, gamQ))) =>
                      exist_intro_ent (\lam j =>
                        ghost_map_elem (msc_requestGS G gam) j
                          (predicted, gamQ)) id
                  | registered : properUPred_ent Elem Registered =>
                      properUPred_ent_trans Elem
                        (mkProperExist Nat (\lam j =>
                          ghost_map_elem (msc_requestGS G gam) j
                            (predicted, gamQ))) Registered elemExists
                        (pure_intro_sep_ent (Total <= predicted) hle
                          (mkProperExist Nat (\lam j =>
                            ghost_map_elem (msc_requestGS G gam) j
                              (predicted, gamQ))))
                  | bodyAndElem : properUPred_ent
                      (mkProperSep
                        (mkProperSep Auth (mkProperSep Requests1 Elem)) Fixed)
                      (mkProperSep Body1 Elem) =>
                      msc_read_reorder_body LenN LenNames Auth Shards
                        Requests1 Elem
                  | bodyAndCase : properUPred_ent
                      (mkProperSep Body1 Elem)
                      (mkProperSep Body1
                        (msc_read_case G gam predicted Total gamQ P)) =>
                      sep_mono_r_ent Body1 Elem
                        (msc_read_case G gam predicted Total gamQ P)
                        (properUPred_ent_trans Elem Registered
                          (msc_read_case G gam predicted Total gamQ P)
                          registered
                          (or_intro_l_ent Registered
                            (msc_read_unregistered predicted Total P)))
                  | chooseMap : properUPred_ent
                      (mkProperSep Body1
                        (msc_read_case G gam predicted Total gamQ P)) Target =>
                      exist_intro_ent (\lam requests =>
                        mkProperSep
                          (msc_inv_body_names H G gam a w.read_initial
                            gam.msc_shard_names requests)
                          (msc_read_case G gam predicted Total gamQ P))
                        (ginsert id (predicted, gamQ) w.read_requests)
                \in properUPred_ent_trans
                    (mkProperSep
                      (mkProperSep Auth (mkProperSep Requests1 Elem)) Fixed)
                    (mkProperSep Body1 Elem) Target bodyAndElem
                    (properUPred_ent_trans (mkProperSep Body1 Elem)
                      (mkProperSep Body1
                        (msc_read_case G gam predicted Total gamQ P))
                      Target bodyAndCase chooseMap))
      \in properUPred_ent_trans Source Ready
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask Target)
          arrange
          (properUPred_ent_trans Ready
            (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
              (mkProperSep Updated Fixed))
            (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask Target)
            runFramed
            (fupd_mono H.iris_wsat msc_open_mask msc_open_mask
              (mkProperSep Updated Fixed) Target finish))
  }

\lemma msc_read_stage_registration {M : UCMRA}
    (A B C D E F : ProperUPred M) :
  properUPred_ent
    (mkProperSep (mkProperSep A (mkProperSep B C))
      (mkProperSep D (mkProperSep E F)))
    (mkProperSep (mkProperSep B F)
      (mkProperSep C (mkProperSep A (mkProperSep D E)))) =>
  \let
    | S0 => mkProperSep (mkProperSep A (mkProperSep B C))
        (mkProperSep D (mkProperSep E F))
    | Flat => mkProperSep A (mkProperSep B
        (mkProperSep C (mkProperSep D (mkProperSep E F))))
    | Swapped => mkProperSep A (mkProperSep B
        (mkProperSep C (mkProperSep D (mkProperSep F E))))
    | FFront => mkProperSep F (mkProperSep A
        (mkProperSep B (mkProperSep C (mkProperSep D E))))
    | AFront => mkProperSep A (mkProperSep F
        (mkProperSep B (mkProperSep C (mkProperSep D E))))
    | BF => mkProperSep A (mkProperSep B
        (mkProperSep F (mkProperSep C (mkProperSep D E))))
    | Grouped => mkProperSep A
        (mkProperSep (mkProperSep B F) (mkProperSep C (mkProperSep D E)))
    | Moved => mkProperSep (mkProperSep B F)
        (mkProperSep A (mkProperSep C (mkProperSep D E)))
    | Target => mkProperSep (mkProperSep B F)
        (mkProperSep C (mkProperSep A (mkProperSep D E)))
    | flatten : properUPred_ent S0 Flat =>
        properUPred_ent_trans S0
          (mkProperSep A
            (mkProperSep (mkProperSep B C)
              (mkProperSep D (mkProperSep E F)))) Flat
          (sep_assoc_l_ent A (mkProperSep B C)
            (mkProperSep D (mkProperSep E F)))
          (sep_mono_r_ent A
            (mkProperSep (mkProperSep B C)
              (mkProperSep D (mkProperSep E F)))
            (mkProperSep B
              (mkProperSep C (mkProperSep D (mkProperSep E F))))
            (sep_assoc_l_ent B C (mkProperSep D (mkProperSep E F))))
  \in properUPred_ent_trans S0 Flat Target flatten
      (properUPred_ent_trans Flat Swapped Target
        (sep_mono_r_ent A
          (mkProperSep B
            (mkProperSep C (mkProperSep D (mkProperSep E F))))
          (mkProperSep B
            (mkProperSep C (mkProperSep D (mkProperSep F E))))
          (sep_mono_r_ent B
            (mkProperSep C (mkProperSep D (mkProperSep E F)))
            (mkProperSep C (mkProperSep D (mkProperSep F E)))
            (sep_mono_r_ent C
              (mkProperSep D (mkProperSep E F))
              (mkProperSep D (mkProperSep F E))
              (sep_mono_r_ent D (mkProperSep E F)
                (mkProperSep F E) (sep_comm_ent E F)))))
        (properUPred_ent_trans Swapped FFront Target
          (sep_move_fifth_front A B C D F E)
          (properUPred_ent_trans FFront AFront Target
            (sep_swap_ent F A
              (mkProperSep B (mkProperSep C (mkProperSep D E))))
            (properUPred_ent_trans AFront BF Target
              (sep_mono_r_ent A
                (mkProperSep F
                  (mkProperSep B (mkProperSep C (mkProperSep D E))))
                (mkProperSep B
                  (mkProperSep F (mkProperSep C (mkProperSep D E))))
                (sep_swap_ent F B (mkProperSep C (mkProperSep D E))))
              (properUPred_ent_trans BF Grouped Target
                (sep_mono_r_ent A
                  (mkProperSep B
                    (mkProperSep F (mkProperSep C (mkProperSep D E))))
                  (mkProperSep (mkProperSep B F)
                    (mkProperSep C (mkProperSep D E)))
                  (sep_assoc_r_ent B F (mkProperSep C (mkProperSep D E))))
                (properUPred_ent_trans Grouped Moved Target
                  (sep_swap_ent A (mkProperSep B F)
                    (mkProperSep C (mkProperSep D E)))
                  (sep_mono_r_ent (mkProperSep B F)
                    (mkProperSep A (mkProperSep C (mkProperSep D E)))
                    (mkProperSep C (mkProperSep A (mkProperSep D E)))
                    (sep_swap_ent A C (mkProperSep D E)))))))))

\lemma msc_read_stage_close {M : UCMRA}
    (A B C D E F : ProperUPred M) :
  properUPred_ent
    (mkProperSep (mkProperSep A B)
      (mkProperSep C (mkProperSep D (mkProperSep E F))))
    (mkProperSep (mkProperSep A E)
      (mkProperSep F (mkProperSep C (mkProperSep D B)))) =>
  \let
    | S0 => mkProperSep (mkProperSep A B)
        (mkProperSep C (mkProperSep D (mkProperSep E F)))
    | Flat => mkProperSep A (mkProperSep B
        (mkProperSep C (mkProperSep D (mkProperSep E F))))
    | EFront => mkProperSep E (mkProperSep A
        (mkProperSep B (mkProperSep C (mkProperSep D F))))
    | AFront => mkProperSep A (mkProperSep E
        (mkProperSep B (mkProperSep C (mkProperSep D F))))
    | S1 => mkProperSep A (mkProperSep E
        (mkProperSep B (mkProperSep C (mkProperSep F D))))
    | S2 => mkProperSep A (mkProperSep E
        (mkProperSep B (mkProperSep F (mkProperSep C D))))
    | S3 => mkProperSep A (mkProperSep E
        (mkProperSep F (mkProperSep B (mkProperSep C D))))
    | S4 => mkProperSep A (mkProperSep E
        (mkProperSep F (mkProperSep C (mkProperSep B D))))
    | S5 => mkProperSep A (mkProperSep E
        (mkProperSep F (mkProperSep C (mkProperSep D B))))
    | Target => mkProperSep (mkProperSep A E)
        (mkProperSep F (mkProperSep C (mkProperSep D B)))
    | flatten : properUPred_ent S0 Flat =>
        sep_assoc_l_ent A B
          (mkProperSep C (mkProperSep D (mkProperSep E F)))
  \in properUPred_ent_trans S0 Flat Target flatten
      (properUPred_ent_trans Flat EFront Target
        (sep_move_fifth_front A B C D E F)
        (properUPred_ent_trans EFront AFront Target
          (sep_swap_ent E A
            (mkProperSep B (mkProperSep C (mkProperSep D F))))
          (properUPred_ent_trans AFront S1 Target
            (sep_mono_r_ent A
              (mkProperSep E
                (mkProperSep B (mkProperSep C (mkProperSep D F))))
              (mkProperSep E
                (mkProperSep B (mkProperSep C (mkProperSep F D))))
              (sep_mono_r_ent E
                (mkProperSep B (mkProperSep C (mkProperSep D F)))
                (mkProperSep B (mkProperSep C (mkProperSep F D)))
                (sep_mono_r_ent B
                  (mkProperSep C (mkProperSep D F))
                  (mkProperSep C (mkProperSep F D))
                  (sep_mono_r_ent C (mkProperSep D F)
                    (mkProperSep F D) (sep_comm_ent D F)))))
            (properUPred_ent_trans S1 S2 Target
              (sep_mono_r_ent A
                (mkProperSep E
                  (mkProperSep B (mkProperSep C (mkProperSep F D))))
                (mkProperSep E
                  (mkProperSep B (mkProperSep F (mkProperSep C D))))
                (sep_mono_r_ent E
                  (mkProperSep B (mkProperSep C (mkProperSep F D)))
                  (mkProperSep B (mkProperSep F (mkProperSep C D)))
                  (sep_mono_r_ent B
                    (mkProperSep C (mkProperSep F D))
                    (mkProperSep F (mkProperSep C D))
                    (sep_swap_ent C F D))))
              (properUPred_ent_trans S2 S3 Target
                (sep_mono_r_ent A
                  (mkProperSep E
                    (mkProperSep B (mkProperSep F (mkProperSep C D))))
                  (mkProperSep E
                    (mkProperSep F (mkProperSep B (mkProperSep C D))))
                  (sep_mono_r_ent E
                    (mkProperSep B (mkProperSep F (mkProperSep C D)))
                    (mkProperSep F (mkProperSep B (mkProperSep C D)))
                    (sep_swap_ent B F (mkProperSep C D))))
                (properUPred_ent_trans S3 S4 Target
                  (sep_mono_r_ent A
                    (mkProperSep E
                      (mkProperSep F (mkProperSep B (mkProperSep C D))))
                    (mkProperSep E
                      (mkProperSep F (mkProperSep C (mkProperSep B D))))
                    (sep_mono_r_ent E
                      (mkProperSep F (mkProperSep B (mkProperSep C D)))
                      (mkProperSep F (mkProperSep C (mkProperSep B D)))
                      (sep_mono_r_ent F
                        (mkProperSep B (mkProperSep C D))
                        (mkProperSep C (mkProperSep B D))
                        (sep_swap_ent B C D))))
                  (properUPred_ent_trans S4 S5 Target
                    (sep_mono_r_ent A
                      (mkProperSep E
                        (mkProperSep F (mkProperSep C (mkProperSep B D))))
                      (mkProperSep E
                        (mkProperSep F (mkProperSep C (mkProperSep D B))))
                      (sep_mono_r_ent E
                        (mkProperSep F (mkProperSep C (mkProperSep B D)))
                        (mkProperSep F (mkProperSep C (mkProperSep D B)))
                        (sep_mono_r_ent F
                          (mkProperSep C (mkProperSep B D))
                          (mkProperSep C (mkProperSep D B))
                          (sep_mono_r_ent C (mkProperSep B D)
                            (mkProperSep D B) (sep_comm_ent B D)))))
                    (sep_assoc_r_ent A E
                      (mkProperSep F
                        (mkProperSep C (mkProperSep D B)))))))))))

\func msc_read_new_raw {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (a : Nat) (w : msc_read_witness gam) (v : Value) : iProp S =>
  mkProperExist ProphId (\lam p =>
    mkProperExist (List ProphPayload) (\lam resolves =>
      mkProperSep (mkProperPure (v = LitV (LitProphecy p)))
        (mkProperSep (proph H.iris_proph_map p resolves)
          (msc_read_after H G gam a w))))

\lemma msc_read_new_raw_intro {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (a : Nat) (w : msc_read_witness gam)
    (p : ProphId) (resolves : List ProphPayload) :
  properUPred_ent
    (mkProperSep (proph H.iris_proph_map p resolves)
      (msc_read_after H G gam a w))
    (mkProperBUpd
      (msc_read_new_raw H G gam a w (LitV (LitProphecy p)))) =>
  \let
    | Resources => mkProperSep (proph H.iris_proph_map p resolves)
        (msc_read_after H G gam a w)
    | Body => mkProperSep
        (mkProperPure {iResUR S}
          (LitV (LitProphecy p) = LitV (LitProphecy p))) Resources
    | raw : properUPred_ent Resources
        (msc_read_new_raw H G gam a w (LitV (LitProphecy p))) =>
        properUPred_ent_trans Resources Body
          (msc_read_new_raw H G gam a w (LitV (LitProphecy p)))
          (pure_intro_sep_ent
            (LitV (LitProphecy p) = LitV (LitProphecy p)) idp Resources)
          (properUPred_ent_trans Body
            (mkProperExist (List ProphPayload) (\lam rs =>
              mkProperSep
                (mkProperPure
                  (LitV (LitProphecy p) = LitV (LitProphecy p)))
                (mkProperSep (proph H.iris_proph_map p rs)
                  (msc_read_after H G gam a w))))
            (msc_read_new_raw H G gam a w (LitV (LitProphecy p)))
            (exist_intro_ent (\lam rs =>
              mkProperSep
                (mkProperPure
                  (LitV (LitProphecy p) = LitV (LitProphecy p)))
                (mkProperSep (proph H.iris_proph_map p rs)
                  (msc_read_after H G gam a w))) resolves)
            (exist_intro_ent (\lam p0 =>
              mkProperExist (List ProphPayload) (\lam rs =>
                mkProperSep
                  (mkProperPure
                    (LitV (LitProphecy p) = LitV (LitProphecy p0)))
                  (mkProperSep (proph H.iris_proph_map p0 rs)
                    (msc_read_after H G gam a w)))) p))
  \in properUPred_ent_trans Resources
      (msc_read_new_raw H G gam a w (LitV (LitProphecy p)))
      (mkProperBUpd
        (msc_read_new_raw H G gam a w (LitV (LitProphecy p))))
      raw (bupd_intro (msc_read_new_raw H G gam a w
        (LitV (LitProphecy p))))

-- Flatten eight resources and select C,G,H as the active client group.  The
-- remaining A,B,D,E,F resources stay available for rebuilding and closing.
\lemma msc_read_select_client8 {M : UCMRA}
    (A B C D E F G H : ProperUPred M) :
  properUPred_ent
    (mkProperSep (mkProperSep A (mkProperSep B C))
      (mkProperSep D (mkProperSep E (mkProperSep F (mkProperSep G H)))))
    (mkProperSep (mkProperSep C (mkProperSep G H))
      (mkProperSep A (mkProperSep B (mkProperSep D (mkProperSep E F))))) =>
  \let
    | R0 => mkProperSep A (mkProperSep B
        (mkProperSep C (mkProperSep D
          (mkProperSep E (mkProperSep F (mkProperSep G H))))))
    | R1 => mkProperSep C (mkProperSep A (mkProperSep B
        (mkProperSep D (mkProperSep E (mkProperSep F (mkProperSep G H))))))
    | R2 => mkProperSep C (mkProperSep A (mkProperSep B
        (mkProperSep D (mkProperSep E (mkProperSep G (mkProperSep F H))))))
    | R3 => mkProperSep C (mkProperSep A (mkProperSep B
        (mkProperSep D (mkProperSep G (mkProperSep E (mkProperSep F H))))))
    | R4 => mkProperSep C (mkProperSep A (mkProperSep B
        (mkProperSep G (mkProperSep D (mkProperSep E (mkProperSep F H))))))
    | R5 => mkProperSep C (mkProperSep A (mkProperSep G
        (mkProperSep B (mkProperSep D (mkProperSep E (mkProperSep F H))))))
    | R6 => mkProperSep C (mkProperSep G (mkProperSep A
        (mkProperSep B (mkProperSep D (mkProperSep E (mkProperSep F H))))))
    | R7 => mkProperSep C (mkProperSep G (mkProperSep A
        (mkProperSep B (mkProperSep D (mkProperSep E (mkProperSep H F))))))
    | R8 => mkProperSep C (mkProperSep G (mkProperSep A
        (mkProperSep B (mkProperSep D (mkProperSep H (mkProperSep E F))))))
    | R9 => mkProperSep C (mkProperSep G (mkProperSep A
        (mkProperSep B (mkProperSep H (mkProperSep D (mkProperSep E F))))))
    | R10 => mkProperSep C (mkProperSep G (mkProperSep A
        (mkProperSep H (mkProperSep B (mkProperSep D (mkProperSep E F))))))
    | R11 => mkProperSep C (mkProperSep G (mkProperSep H
        (mkProperSep A (mkProperSep B (mkProperSep D (mkProperSep E F))))))
    | R12 => mkProperSep C (mkProperSep (mkProperSep G H)
        (mkProperSep A (mkProperSep B (mkProperSep D (mkProperSep E F)))))
    | Target => mkProperSep (mkProperSep C (mkProperSep G H))
        (mkProperSep A (mkProperSep B (mkProperSep D (mkProperSep E F))))
    | flatten : properUPred_ent
        (mkProperSep (mkProperSep A (mkProperSep B C))
          (mkProperSep D (mkProperSep E (mkProperSep F (mkProperSep G H)))))
        R0 =>
        properUPred_ent_trans
          (mkProperSep (mkProperSep A (mkProperSep B C))
            (mkProperSep D (mkProperSep E (mkProperSep F (mkProperSep G H)))))
          (mkProperSep A (mkProperSep (mkProperSep B C)
            (mkProperSep D (mkProperSep E (mkProperSep F (mkProperSep G H))))))
          R0
          (sep_assoc_l_ent A (mkProperSep B C)
            (mkProperSep D (mkProperSep E (mkProperSep F (mkProperSep G H)))))
          (sep_mono_r_ent A
            (mkProperSep (mkProperSep B C)
              (mkProperSep D (mkProperSep E (mkProperSep F (mkProperSep G H)))))
            (mkProperSep B (mkProperSep C
              (mkProperSep D (mkProperSep E (mkProperSep F (mkProperSep G H))))))
            (sep_assoc_l_ent B C
              (mkProperSep D (mkProperSep E (mkProperSep F (mkProperSep G H))))))
    | moveC : properUPred_ent R0 R1 =>
        sep_rotate_third_front A B C
          (mkProperSep D (mkProperSep E (mkProperSep F (mkProperSep G H))))
    | swapFG : properUPred_ent R1 R2 =>
        sep_mono_r_ent C
          (mkProperSep A (mkProperSep B
            (mkProperSep D (mkProperSep E (mkProperSep F (mkProperSep G H))))))
          (mkProperSep A (mkProperSep B
            (mkProperSep D (mkProperSep E (mkProperSep G (mkProperSep F H))))))
          (sep_mono_r_ent A
            (mkProperSep B
              (mkProperSep D (mkProperSep E (mkProperSep F (mkProperSep G H)))))
            (mkProperSep B
              (mkProperSep D (mkProperSep E (mkProperSep G (mkProperSep F H)))))
            (sep_mono_r_ent B
              (mkProperSep D (mkProperSep E (mkProperSep F (mkProperSep G H))))
              (mkProperSep D (mkProperSep E (mkProperSep G (mkProperSep F H))))
              (sep_mono_r_ent D
                (mkProperSep E (mkProperSep F (mkProperSep G H)))
                (mkProperSep E (mkProperSep G (mkProperSep F H)))
                (sep_mono_r_ent E
                  (mkProperSep F (mkProperSep G H))
                  (mkProperSep G (mkProperSep F H))
                  (sep_swap_ent F G H)))))
    | swapEG : properUPred_ent R2 R3 =>
        sep_mono_r_ent C (mkProperSep A (mkProperSep B
          (mkProperSep D (mkProperSep E (mkProperSep G (mkProperSep F H))))))
          (mkProperSep A (mkProperSep B
            (mkProperSep D (mkProperSep G (mkProperSep E (mkProperSep F H))))))
          (sep_mono_r_ent A
            (mkProperSep B
              (mkProperSep D (mkProperSep E (mkProperSep G (mkProperSep F H)))))
            (mkProperSep B
              (mkProperSep D (mkProperSep G (mkProperSep E (mkProperSep F H)))))
            (sep_mono_r_ent B
              (mkProperSep D (mkProperSep E (mkProperSep G (mkProperSep F H))))
              (mkProperSep D (mkProperSep G (mkProperSep E (mkProperSep F H))))
              (sep_mono_r_ent D
                (mkProperSep E (mkProperSep G (mkProperSep F H)))
                (mkProperSep G (mkProperSep E (mkProperSep F H)))
                (sep_swap_ent E G (mkProperSep F H)))))
    | swapDG : properUPred_ent R3 R4 =>
        sep_mono_r_ent C (mkProperSep A (mkProperSep B
          (mkProperSep D (mkProperSep G (mkProperSep E (mkProperSep F H))))))
          (mkProperSep A (mkProperSep B
            (mkProperSep G (mkProperSep D (mkProperSep E (mkProperSep F H))))))
          (sep_mono_r_ent A
            (mkProperSep B
              (mkProperSep D (mkProperSep G (mkProperSep E (mkProperSep F H)))))
            (mkProperSep B
              (mkProperSep G (mkProperSep D (mkProperSep E (mkProperSep F H)))))
            (sep_mono_r_ent B
              (mkProperSep D (mkProperSep G (mkProperSep E (mkProperSep F H))))
              (mkProperSep G (mkProperSep D (mkProperSep E (mkProperSep F H))))
              (sep_swap_ent D G (mkProperSep E (mkProperSep F H)))))
    | swapBG : properUPred_ent R4 R5 =>
        sep_mono_r_ent C
          (mkProperSep A (mkProperSep B
            (mkProperSep G (mkProperSep D (mkProperSep E (mkProperSep F H))))))
          (mkProperSep A (mkProperSep G
            (mkProperSep B (mkProperSep D (mkProperSep E (mkProperSep F H))))))
          (sep_mono_r_ent A
            (mkProperSep B
              (mkProperSep G (mkProperSep D (mkProperSep E (mkProperSep F H)))))
            (mkProperSep G
              (mkProperSep B (mkProperSep D (mkProperSep E (mkProperSep F H)))))
            (sep_swap_ent B G
              (mkProperSep D (mkProperSep E (mkProperSep F H)))))
    | swapAG : properUPred_ent R5 R6 =>
        sep_mono_r_ent C
          (mkProperSep A (mkProperSep G
            (mkProperSep B (mkProperSep D (mkProperSep E (mkProperSep F H))))))
          (mkProperSep G (mkProperSep A
            (mkProperSep B (mkProperSep D (mkProperSep E (mkProperSep F H))))))
          (sep_swap_ent A G
            (mkProperSep B (mkProperSep D (mkProperSep E (mkProperSep F H)))))
    | swapFH : properUPred_ent R6 R7 =>
        sep_mono_r_ent C (mkProperSep G (mkProperSep A (mkProperSep B
          (mkProperSep D (mkProperSep E (mkProperSep F H))))))
          (mkProperSep G (mkProperSep A (mkProperSep B
            (mkProperSep D (mkProperSep E (mkProperSep H F))))))
          (sep_mono_r_ent G
            (mkProperSep A (mkProperSep B
              (mkProperSep D (mkProperSep E (mkProperSep F H)))))
            (mkProperSep A (mkProperSep B
              (mkProperSep D (mkProperSep E (mkProperSep H F)))))
            (sep_mono_r_ent A
              (mkProperSep B (mkProperSep D (mkProperSep E (mkProperSep F H))))
              (mkProperSep B (mkProperSep D (mkProperSep E (mkProperSep H F))))
              (sep_mono_r_ent B
                (mkProperSep D (mkProperSep E (mkProperSep F H)))
                (mkProperSep D (mkProperSep E (mkProperSep H F)))
                (sep_mono_r_ent D
                  (mkProperSep E (mkProperSep F H))
                  (mkProperSep E (mkProperSep H F))
                  (sep_mono_r_ent E (mkProperSep F H)
                    (mkProperSep H F) (sep_comm_ent F H))))))
    | swapEH : properUPred_ent R7 R8 =>
        sep_mono_r_ent C (mkProperSep G (mkProperSep A (mkProperSep B
          (mkProperSep D (mkProperSep E (mkProperSep H F))))))
          (mkProperSep G (mkProperSep A (mkProperSep B
            (mkProperSep D (mkProperSep H (mkProperSep E F))))))
          (sep_mono_r_ent G (mkProperSep A (mkProperSep B
            (mkProperSep D (mkProperSep E (mkProperSep H F)))))
            (mkProperSep A (mkProperSep B
              (mkProperSep D (mkProperSep H (mkProperSep E F)))))
            (sep_mono_r_ent A
              (mkProperSep B (mkProperSep D (mkProperSep E (mkProperSep H F))))
              (mkProperSep B (mkProperSep D (mkProperSep H (mkProperSep E F))))
              (sep_mono_r_ent B
                (mkProperSep D (mkProperSep E (mkProperSep H F)))
                (mkProperSep D (mkProperSep H (mkProperSep E F)))
                (sep_mono_r_ent D
                  (mkProperSep E (mkProperSep H F))
                  (mkProperSep H (mkProperSep E F))
                  (sep_swap_ent E H F)))))
    | swapDH : properUPred_ent R8 R9 =>
        sep_mono_r_ent C (mkProperSep G (mkProperSep A (mkProperSep B
          (mkProperSep D (mkProperSep H (mkProperSep E F))))))
          (mkProperSep G (mkProperSep A (mkProperSep B
            (mkProperSep H (mkProperSep D (mkProperSep E F))))))
          (sep_mono_r_ent G (mkProperSep A (mkProperSep B
            (mkProperSep D (mkProperSep H (mkProperSep E F)))))
            (mkProperSep A (mkProperSep B
              (mkProperSep H (mkProperSep D (mkProperSep E F)))))
            (sep_mono_r_ent A
              (mkProperSep B (mkProperSep D (mkProperSep H (mkProperSep E F))))
              (mkProperSep B (mkProperSep H (mkProperSep D (mkProperSep E F))))
              (sep_mono_r_ent B
                (mkProperSep D (mkProperSep H (mkProperSep E F)))
                (mkProperSep H (mkProperSep D (mkProperSep E F)))
                (sep_swap_ent D H (mkProperSep E F)))))
    | swapBH : properUPred_ent R9 R10 =>
        sep_mono_r_ent C (mkProperSep G (mkProperSep A
          (mkProperSep B (mkProperSep H (mkProperSep D (mkProperSep E F))))))
          (mkProperSep G (mkProperSep A
            (mkProperSep H (mkProperSep B (mkProperSep D (mkProperSep E F))))))
          (sep_mono_r_ent G
            (mkProperSep A
              (mkProperSep B (mkProperSep H (mkProperSep D (mkProperSep E F)))))
            (mkProperSep A
              (mkProperSep H (mkProperSep B (mkProperSep D (mkProperSep E F)))))
            (sep_mono_r_ent A
              (mkProperSep B (mkProperSep H (mkProperSep D (mkProperSep E F))))
              (mkProperSep H (mkProperSep B (mkProperSep D (mkProperSep E F))))
              (sep_swap_ent B H (mkProperSep D (mkProperSep E F)))))
    | swapAH : properUPred_ent R10 R11 =>
        sep_mono_r_ent C
          (mkProperSep G (mkProperSep A
            (mkProperSep H (mkProperSep B (mkProperSep D (mkProperSep E F))))))
          (mkProperSep G (mkProperSep H
            (mkProperSep A (mkProperSep B (mkProperSep D (mkProperSep E F))))))
          (sep_mono_r_ent G
            (mkProperSep A
              (mkProperSep H (mkProperSep B (mkProperSep D (mkProperSep E F)))))
            (mkProperSep H
              (mkProperSep A (mkProperSep B (mkProperSep D (mkProperSep E F)))))
            (sep_swap_ent A H (mkProperSep B (mkProperSep D (mkProperSep E F)))))
    | groupGH : properUPred_ent R11 R12 =>
        sep_mono_r_ent C
          (mkProperSep G (mkProperSep H
            (mkProperSep A (mkProperSep B (mkProperSep D (mkProperSep E F))))))
          (mkProperSep (mkProperSep G H)
            (mkProperSep A (mkProperSep B (mkProperSep D (mkProperSep E F)))))
          (sep_assoc_r_ent G H
            (mkProperSep A (mkProperSep B (mkProperSep D (mkProperSep E F)))))
    | groupC : properUPred_ent R12 Target =>
        sep_assoc_r_ent C (mkProperSep G H)
          (mkProperSep A (mkProperSep B (mkProperSep D (mkProperSep E F))))
  \in properUPred_ent_trans
      (mkProperSep (mkProperSep A (mkProperSep B C))
        (mkProperSep D (mkProperSep E (mkProperSep F (mkProperSep G H)))))
      R0 Target flatten
      (properUPred_ent_trans R0 R1 Target moveC
        (properUPred_ent_trans R1 R2 Target swapFG
          (properUPred_ent_trans R2 R3 Target swapEG
            (properUPred_ent_trans R3 R4 Target swapDG
              (properUPred_ent_trans R4 R5 Target swapBG
                (properUPred_ent_trans R5 R6 Target swapAG
                  (properUPred_ent_trans R6 R7 Target swapFH
                    (properUPred_ent_trans R7 R8 Target swapEH
                      (properUPred_ent_trans R8 R9 Target swapDH
                        (properUPred_ent_trans R9 R10 Target swapBH
                          (properUPred_ent_trans R10 R11 Target swapAH
                            (properUPred_ent_trans R11 R12 Target
                              groupGH groupC))))))))))))

\func msc_read_prepared {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (a : Nat) (w : msc_read_witness gam) (gamQ : gname)
    (P : iProp S) (Q : Nat -> iProp S) (v : Value) : iProp S =>
  mkProperExist ProphId (\lam p =>
    mkProperExist (List ProphPayload) (\lam resolves =>
      mkProperSep
        (mkProperSep
          (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
            (msc_inv H G gam a))
          (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded
            Q))
        (mkProperSep
          (mkProperPure (v = LitV (LitProphecy p)))
          (mkProperSep
            (mkProperSep (proph H.iris_proph_map p resolves)
              (msc_lbs G w.read_initial gam.msc_shard_names))
            (msc_read_case G gam (msc_proph_total resolves)
              (nat_sum w.read_initial) gamQ P)))))

-- Close the counter invariant after registration while retaining the prophecy
-- token, lower-bound snapshot, public invariant, and saved postcondition.
\lemma msc_read_close_prepared {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (a : Nat) (w : msc_read_witness gam) (gamQ : gname)
    (P : iProp S) (Q : Nat -> iProp S)
    (p : ProphId) (resolves : List ProphPayload)
    (requests : Gmap Nat natCountable (\Sigma Nat gname))
    (Close : iProp S)
    (closeEq : Close = mkProperWand
      (mkProperLater (msc_inv H G gam a))
      (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp)) :
  properUPred_ent
    (mkProperSep
      (mkProperSep
        (msc_inv_body_names H G gam a w.read_initial
          gam.msc_shard_names requests)
        (msc_read_case G gam (msc_proph_total resolves)
          (nat_sum w.read_initial) gamQ P))
      (mkProperSep
        (mkProperPure
          (LitV (LitProphecy p) = LitV (LitProphecy p)))
        (mkProperSep
          (mkProperSep (proph H.iris_proph_map p resolves)
            (msc_lbs G w.read_initial gam.msc_shard_names))
          (mkProperSep Close
            (mkProperSep
              (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
                (msc_inv H G gam a))
              (saved_pred_own G.msc_saved_predG gamQ
                DfracDiscarded Q))))))
    (mkProperFUpd H.iris_wsat msc_open_mask mscE
      (mkProperExist ProphId (\lam p0 =>
        mkProperExist (List ProphPayload) (\lam resolves0 =>
          mkProperSep
            (mkProperSep
              (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
                (msc_inv H G gam a))
              (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q))
            (mkProperSep
              (mkProperPure
                (LitV (LitProphecy p) = LitV (LitProphecy p0)))
              (mkProperSep
                (mkProperSep (proph H.iris_proph_map p0 resolves0)
                  (msc_lbs G w.read_initial gam.msc_shard_names))
                (msc_read_case G gam (msc_proph_total resolves0)
                  (nat_sum w.read_initial) gamQ P))))))) =>
  \let
    | Body => msc_inv_body_names H G gam a w.read_initial
        gam.msc_shard_names requests
    | Case => msc_read_case G gam (msc_proph_total resolves)
        (nat_sum w.read_initial) gamQ P
    | Eq => mkProperPure {iResUR S}
        (LitV (LitProphecy p) = LitV (LitProphecy p))
    | Token => proph H.iris_proph_map p resolves
    | LBs => msc_lbs G w.read_initial gam.msc_shard_names
    | PublicInv => iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a)
    | Saved => saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q
    | InvP => msc_inv H G gam a
    | Payload => mkProperSep (mkProperSep PublicInv Saved)
        (mkProperSep Eq (mkProperSep (mkProperSep Token LBs) Case))
    | Staged => mkProperSep (mkProperSep Body Close) Payload
    | stage : properUPred_ent
        (mkProperSep (mkProperSep Body Case)
          (mkProperSep Eq
            (mkProperSep (mkProperSep Token LBs)
              (mkProperSep Close (mkProperSep PublicInv Saved))))) Staged =>
        msc_read_stage_close Body Case Eq (mkProperSep Token LBs)
          Close (mkProperSep PublicInv Saved)
    | bodyLater : properUPred_ent Body (mkProperLater InvP) =>
        properUPred_ent_trans Body InvP (mkProperLater InvP)
          (msc_read_rebuild H G gam a w requests)
          (proper_later_intro InvP)
    | closePair : properUPred_ent (mkProperSep Body Close)
        (mkProperSep Close (mkProperLater InvP)) =>
        properUPred_ent_trans (mkProperSep Body Close)
          (mkProperSep Close Body)
          (mkProperSep Close (mkProperLater InvP))
          (sep_comm_ent Body Close)
          (sep_mono_r_ent Close Body (mkProperLater InvP) bodyLater)
    | closeShift : properUPred_ent (mkProperSep Close (mkProperLater InvP))
        (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp) =>
        transport (\lam C => properUPred_ent
          (mkProperSep C (mkProperLater InvP))
          (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp))
          (Paths.inv closeEq)
          (wand_elim_ent (mkProperLater InvP)
            (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp))
    | closeFramed : properUPred_ent Staged
        (mkProperFUpd H.iris_wsat msc_open_mask mscE
          (mkProperSep mkProperEmp Payload)) =>
        properUPred_ent_trans Staged
          (mkProperSep
            (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp)
            Payload)
          (mkProperFUpd H.iris_wsat msc_open_mask mscE
            (mkProperSep mkProperEmp Payload))
          (sep_mono_l_ent (mkProperSep Body Close)
            (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp)
            Payload
            (properUPred_ent_trans (mkProperSep Body Close)
              (mkProperSep Close (mkProperLater InvP))
              (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp)
              closePair closeShift))
          (fupd_frame_r H.iris_wsat msc_open_mask mscE mkProperEmp Payload)
    | post : properUPred_ent (mkProperSep mkProperEmp Payload)
        (mkProperExist ProphId (\lam p0 =>
          mkProperExist (List ProphPayload) (\lam resolves0 =>
            mkProperSep (mkProperSep PublicInv Saved)
              (mkProperSep
                (mkProperPure
                  (LitV (LitProphecy p) = LitV (LitProphecy p0)))
                (mkProperSep
                  (mkProperSep (proph H.iris_proph_map p0 resolves0) LBs)
                  (msc_read_case G gam (msc_proph_total resolves0)
                    (nat_sum w.read_initial) gamQ P)))))) =>
        properUPred_ent_trans (mkProperSep mkProperEmp Payload) Payload
          (mkProperExist ProphId (\lam p0 =>
            mkProperExist (List ProphPayload) (\lam resolves0 =>
              mkProperSep (mkProperSep PublicInv Saved)
                (mkProperSep
                  (mkProperPure
                    (LitV (LitProphecy p) = LitV (LitProphecy p0)))
                  (mkProperSep
                    (mkProperSep (proph H.iris_proph_map p0 resolves0) LBs)
                    (msc_read_case G gam (msc_proph_total resolves0)
                      (nat_sum w.read_initial) gamQ P))))))
          (sep_elim_r_ent mkProperEmp Payload)
          (properUPred_ent_trans Payload
            (mkProperExist (List ProphPayload) (\lam resolves0 =>
              mkProperSep (mkProperSep PublicInv Saved)
                (mkProperSep
                  (mkProperPure
                    (LitV (LitProphecy p) = LitV (LitProphecy p)))
                  (mkProperSep
                    (mkProperSep (proph H.iris_proph_map p resolves0) LBs)
                    (msc_read_case G gam (msc_proph_total resolves0)
                      (nat_sum w.read_initial) gamQ P)))))
            (mkProperExist ProphId (\lam p0 =>
              mkProperExist (List ProphPayload) (\lam resolves0 =>
                mkProperSep (mkProperSep PublicInv Saved)
                  (mkProperSep
                    (mkProperPure
                      (LitV (LitProphecy p) = LitV (LitProphecy p0)))
                    (mkProperSep
                      (mkProperSep (proph H.iris_proph_map p0 resolves0) LBs)
                      (msc_read_case G gam (msc_proph_total resolves0)
                        (nat_sum w.read_initial) gamQ P))))))
            (exist_intro_ent (\lam resolves0 =>
              mkProperSep (mkProperSep PublicInv Saved)
                (mkProperSep
                  (mkProperPure
                    (LitV (LitProphecy p) = LitV (LitProphecy p)))
                  (mkProperSep
                    (mkProperSep (proph H.iris_proph_map p resolves0) LBs)
                    (msc_read_case G gam (msc_proph_total resolves0)
                      (nat_sum w.read_initial) gamQ P)))) resolves)
            (exist_intro_ent (\lam p0 =>
              mkProperExist (List ProphPayload) (\lam resolves0 =>
                mkProperSep (mkProperSep PublicInv Saved)
                  (mkProperSep
                    (mkProperPure
                      (LitV (LitProphecy p) = LitV (LitProphecy p0)))
                    (mkProperSep
                      (mkProperSep (proph H.iris_proph_map p0 resolves0) LBs)
                      (msc_read_case G gam (msc_proph_total resolves0)
                        (nat_sum w.read_initial) gamQ P))))) p))
  \in properUPred_ent_trans
      (mkProperSep (mkProperSep Body Case)
        (mkProperSep Eq
          (mkProperSep (mkProperSep Token LBs)
            (mkProperSep Close (mkProperSep PublicInv Saved)))))
      Staged
      (mkProperFUpd H.iris_wsat msc_open_mask mscE
        (mkProperExist ProphId (\lam p0 =>
          mkProperExist (List ProphPayload) (\lam resolves0 =>
            mkProperSep (mkProperSep PublicInv Saved)
              (mkProperSep
                (mkProperPure
                  (LitV (LitProphecy p) = LitV (LitProphecy p0)))
                (mkProperSep
                  (mkProperSep (proph H.iris_proph_map p0 resolves0) LBs)
                  (msc_read_case G gam (msc_proph_total resolves0)
                    (nat_sum w.read_initial) gamQ P)))))))
      stage
      (properUPred_ent_trans Staged
        (mkProperFUpd H.iris_wsat msc_open_mask mscE
          (mkProperSep mkProperEmp Payload))
        (mkProperFUpd H.iris_wsat msc_open_mask mscE
          (mkProperExist ProphId (\lam p0 =>
            mkProperExist (List ProphPayload) (\lam resolves0 =>
              mkProperSep (mkProperSep PublicInv Saved)
                (mkProperSep
                  (mkProperPure
                    (LitV (LitProphecy p) = LitV (LitProphecy p0)))
                  (mkProperSep
                    (mkProperSep (proph H.iris_proph_map p0 resolves0) LBs)
                    (msc_read_case G gam (msc_proph_total resolves0)
                      (nat_sum w.read_initial) gamQ P)))))))
        closeFramed
        (fupd_mono H.iris_wsat msc_open_mask mscE
          (mkProperSep mkProperEmp Payload)
          (mkProperExist ProphId (\lam p0 =>
            mkProperExist (List ProphPayload) (\lam resolves0 =>
              mkProperSep (mkProperSep PublicInv Saved)
                (mkProperSep
                  (mkProperPure
                    (LitV (LitProphecy p) = LitV (LitProphecy p0)))
                  (mkProperSep
                    (mkProperSep (proph H.iris_proph_map p0 resolves0) LBs)
                    (msc_read_case G gam (msc_proph_total resolves0)
                      (nat_sum w.read_initial) gamQ P)))))) post))

\lemma msc_read_raw_continue {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (a : Nat) (w : msc_read_witness gam) (gamQ : gname)
    (P : iProp S) (Q : Nat -> iProp S) (v : Value)
    (Close : iProp S)
    (closeEq : Close = mkProperWand
      (mkProperLater (msc_inv H G gam a))
      (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp)) :
  properUPred_ent
    (mkProperSep (msc_read_new_raw H G gam a w v)
      (mkProperSep Close
        (mkProperSep
          (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
            (msc_inv H G gam a))
          (mkProperSep
            (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
            (mkProperSep
              (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
              (mkProperSep (msc_read_shift H G gam P Q) P))))))
    (mkProperFUpd H.iris_wsat msc_open_mask mscE
      (msc_read_prepared H G gam a w gamQ P Q v)) =>
  sep_exist_l_elim (\lam p =>
    mkProperExist (List ProphPayload) (\lam resolves =>
      mkProperSep (mkProperPure (v = LitV (LitProphecy p)))
        (mkProperSep (proph H.iris_proph_map p resolves)
          (msc_read_after H G gam a w))))
    (mkProperSep Close
      (mkProperSep
        (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
          (msc_inv H G gam a))
        (mkProperSep
          (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
          (mkProperSep
            (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
            (mkProperSep (msc_read_shift H G gam P Q) P)))))
    (mkProperFUpd H.iris_wsat msc_open_mask mscE
      (msc_read_prepared H G gam a w gamQ P Q v)) (\lam p =>
      sep_exist_l_elim (\lam resolves =>
        mkProperSep (mkProperPure (v = LitV (LitProphecy p)))
          (mkProperSep (proph H.iris_proph_map p resolves)
            (msc_read_after H G gam a w)))
        (mkProperSep Close
          (mkProperSep
            (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
              (msc_inv H G gam a))
            (mkProperSep
              (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
              (mkProperSep
                (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
                (mkProperSep (msc_read_shift H G gam P Q) P)))))
        (mkProperFUpd H.iris_wsat msc_open_mask mscE
          (msc_read_prepared H G gam a w gamQ P Q v)) (\lam resolves =>
        \let
          | EqV => mkProperPure {iResUR S}
              (v = LitV (LitProphecy p))
          | Token => proph H.iris_proph_map p resolves
          | Body => msc_read_after H G gam a w
          | LBs => msc_lbs G w.read_initial gam.msc_shard_names
          | PublicInv => iris.base_logic.lib.invariants.inv
              H.iris_wsat mscN (msc_inv H G gam a)
          | Saved => saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q
          | Client => mkProperSep Saved
              (mkProperSep (msc_read_shift H G gam P Q) P)
          | Frame => mkProperSep Close
              (mkProperSep PublicInv (mkProperSep Saved Client))
          | Source => mkProperSep (mkProperSep EqV
              (mkProperSep Token Body)) Frame
          | SourcePure => mkProperSep EqV
              (mkProperSep (mkProperSep Token Body) Frame)
          | afterEq : properUPred_ent
              (mkProperSep (mkProperSep Token Body) Frame)
              (mkProperFUpd H.iris_wsat msc_open_mask mscE
                (msc_read_prepared H G gam a w gamQ P Q
                  (LitV (LitProphecy p)))) =>
              \let
                | SnapLeft => mkProperSep Token (mkProperSep Body LBs)
                | Snap => mkProperSep SnapLeft Frame
                | GroupedLeft => mkProperSep (mkProperSep Token LBs) Body
                | Grouped => mkProperSep GroupedLeft Frame
                | GroupedEq => mkProperSep
                    (mkProperSep
                      (mkProperPure {iResUR S}
                        (LitV (LitProphecy p) = LitV (LitProphecy p)))
                      GroupedLeft) Frame
                | RegSource => mkProperSep Body
                    (mkProperSep Saved
                      (mkProperSep (msc_read_shift H G gam P Q) P))
                | Rest => mkProperSep
                    (mkProperPure {iResUR S}
                      (LitV (LitProphecy p) = LitV (LitProphecy p)))
                    (mkProperSep (mkProperSep Token LBs)
                      (mkProperSep Close (mkProperSep PublicInv Saved)))
                | Selected => mkProperSep RegSource Rest
                | snap : properUPred_ent
                    (mkProperSep (mkProperSep Token Body) Frame) Snap =>
                    sep_mono_l_ent (mkProperSep Token Body) SnapLeft Frame
                      (sep_mono_r_ent Token Body (mkProperSep Body LBs)
                        (msc_read_snapshot H G gam a w))
                | group : properUPred_ent Snap Grouped =>
                    sep_mono_l_ent SnapLeft GroupedLeft Frame
                      (properUPred_ent_trans SnapLeft
                        (mkProperSep Token (mkProperSep LBs Body)) GroupedLeft
                        (sep_mono_r_ent Token (mkProperSep Body LBs)
                          (mkProperSep LBs Body) (sep_comm_ent Body LBs))
                        (sep_assoc_r_ent Token LBs Body))
                | addEq : properUPred_ent Grouped GroupedEq =>
                    sep_mono_l_ent GroupedLeft
                      (mkProperSep
                        (mkProperPure {iResUR S}
                          (LitV (LitProphecy p) = LitV (LitProphecy p)))
                        GroupedLeft) Frame
                      (pure_intro_sep_ent
                        (LitV (LitProphecy p) = LitV (LitProphecy p))
                        idp GroupedLeft)
                | select : properUPred_ent GroupedEq Selected =>
                    msc_read_select_client8
                      (mkProperPure {iResUR S}
                        (LitV (LitProphecy p) = LitV (LitProphecy p)))
                      (mkProperSep Token LBs) Body Close PublicInv Saved
                      Saved (mkProperSep (msc_read_shift H G gam P Q) P)
                | Registered => mkProperExist
                    (Gmap Nat natCountable (\Sigma Nat gname))
                    (\lam requests => mkProperSep
                      (msc_inv_body_names H G gam a w.read_initial
                        gam.msc_shard_names requests)
                      (msc_read_case G gam (msc_proph_total resolves)
                        (nat_sum w.read_initial) gamQ P))
                | register : properUPred_ent RegSource
                    (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                      Registered) =>
                    msc_read_register_or_keep H G gam a
                      (msc_proph_total resolves) gamQ w P Q
                | registeredFramed : properUPred_ent Selected
                    (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                      (mkProperSep Registered Rest)) =>
                    properUPred_ent_trans Selected
                      (mkProperSep
                        (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                          Registered) Rest)
                      (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                        (mkProperSep Registered Rest))
                      (sep_mono_l_ent RegSource
                        (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                          Registered) Rest register)
                      (fupd_frame_r H.iris_wsat msc_open_mask msc_open_mask
                        Registered Rest)
                | closeEach : properUPred_ent (mkProperSep Registered Rest)
                    (mkProperFUpd H.iris_wsat msc_open_mask mscE
                      (msc_read_prepared H G gam a w gamQ P Q
                        (LitV (LitProphecy p)))) =>
                    sep_exist_l_elim (\lam requests => mkProperSep
                      (msc_inv_body_names H G gam a w.read_initial
                        gam.msc_shard_names requests)
                      (msc_read_case G gam (msc_proph_total resolves)
                        (nat_sum w.read_initial) gamQ P)) Rest
                      (mkProperFUpd H.iris_wsat msc_open_mask mscE
                        (msc_read_prepared H G gam a w gamQ P Q
                          (LitV (LitProphecy p)))) (\lam requests =>
                        msc_read_close_prepared H G gam a w gamQ P Q
                          p resolves requests Close closeEq)
                | closeNested : properUPred_ent
                    (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                      (mkProperSep Registered Rest))
                    (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                      (mkProperFUpd H.iris_wsat msc_open_mask mscE
                        (msc_read_prepared H G gam a w gamQ P Q
                          (LitV (LitProphecy p))))) =>
                    fupd_mono H.iris_wsat msc_open_mask msc_open_mask
                      (mkProperSep Registered Rest)
                      (mkProperFUpd H.iris_wsat msc_open_mask mscE
                        (msc_read_prepared H G gam a w gamQ P Q
                          (LitV (LitProphecy p)))) closeEach
              \in properUPred_ent_trans
                  (mkProperSep (mkProperSep Token Body) Frame) Snap
                  (mkProperFUpd H.iris_wsat msc_open_mask mscE
                    (msc_read_prepared H G gam a w gamQ P Q
                      (LitV (LitProphecy p)))) snap
                    (properUPred_ent_trans Snap Grouped
                      (mkProperFUpd H.iris_wsat msc_open_mask mscE
                        (msc_read_prepared H G gam a w gamQ P Q
                          (LitV (LitProphecy p)))) group
                    (properUPred_ent_trans Grouped GroupedEq
                      (mkProperFUpd H.iris_wsat msc_open_mask mscE
                        (msc_read_prepared H G gam a w gamQ P Q
                          (LitV (LitProphecy p)))) addEq
                    (properUPred_ent_trans GroupedEq Selected
                      (mkProperFUpd H.iris_wsat msc_open_mask mscE
                        (msc_read_prepared H G gam a w gamQ P Q
                          (LitV (LitProphecy p)))) select
                      (properUPred_ent_trans Selected
                        (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                          (mkProperSep Registered Rest))
                        (mkProperFUpd H.iris_wsat msc_open_mask mscE
                          (msc_read_prepared H G gam a w gamQ P Q
                            (LitV (LitProphecy p)))) registeredFramed
                        (properUPred_ent_trans
                          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                            (mkProperSep Registered Rest))
                          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                            (mkProperFUpd H.iris_wsat msc_open_mask mscE
                              (msc_read_prepared H G gam a w gamQ P Q
                                (LitV (LitProphecy p)))))
                          (mkProperFUpd H.iris_wsat msc_open_mask mscE
                            (msc_read_prepared H G gam a w gamQ P Q
                              (LitV (LitProphecy p)))) closeNested
                          (fupd_trans H.iris_wsat msc_open_mask
                            msc_open_mask mscE
                            (msc_read_prepared H G gam a w gamQ P Q
                              (LitV (LitProphecy p)))))))))
          | pure : properUPred_ent SourcePure
              (mkProperFUpd H.iris_wsat msc_open_mask mscE
                (msc_read_prepared H G gam a w gamQ P Q v)) =>
              pure_sep_l_elim (v = LitV (LitProphecy p))
                (mkProperSep (mkProperSep Token Body) Frame)
                (mkProperFUpd H.iris_wsat msc_open_mask mscE
                  (msc_read_prepared H G gam a w gamQ P Q v))
                (\lam heq => transport (\lam z => properUPred_ent
                  (mkProperSep (mkProperSep Token Body) Frame)
                  (mkProperFUpd H.iris_wsat msc_open_mask mscE
                    (msc_read_prepared H G gam a w gamQ P Q z)))
                  (Paths.inv heq) afterEq)
        \in properUPred_ent_trans Source SourcePure
            (mkProperFUpd H.iris_wsat msc_open_mask mscE
              (msc_read_prepared H G gam a w gamQ P Q v))
            (sep_assoc_l_ent EqV (mkProperSep Token Body) Frame) pure))

\lemma msc_read_opened_new {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (a : Nat) (w : msc_read_witness gam) (gamQ : gname)
    (P : iProp S) (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep
      (mkProperSep
        (mkProperSep (msc_read_now {S} w)
          (mkProperLater (msc_read_after H G gam a w)))
        (mkProperWand
          (mkProperLater (msc_inv H G gam a))
          (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp)))
      (mkProperSep
        (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
          (msc_inv H G gam a))
        (mkProperSep
          (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
          (mkProperSep
            (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
            (mkProperSep (msc_read_shift H G gam P Q) P)))))
    (wp H msc_open_mask NewProph (\lam v =>
      mkProperFUpd H.iris_wsat msc_open_mask mscE
        (msc_read_prepared H G gam a w gamQ P Q v))) =>
  \let
    | Body => msc_read_after H G gam a w
    | PreNew => mkProperSep (msc_read_now {S} w) (mkProperLater Body)
    | Close => mkProperWand
        (mkProperLater (msc_inv H G gam a))
        (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp)
    | PublicInv => iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a)
    | Saved => saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q
    | K => mkProperSep PublicInv
        (mkProperSep Saved
          (mkProperSep Saved (mkProperSep (msc_read_shift H G gam P Q) P)))
    | Frame => mkProperSep Close K
    | Raw : Value -> iProp S => msc_read_new_raw H G gam a w
    | base : properUPred_ent PreNew (wp H msc_open_mask NewProph Raw) =>
        wp_new_proph_later_frame H msc_open_mask Body Raw
          (\lam p resolves => msc_read_new_raw_intro H G gam a w p resolves)
    | arrange : properUPred_ent
        (mkProperSep (mkProperSep PreNew Close) K)
        (mkProperSep PreNew Frame) =>
        sep_assoc_l_ent PreNew Close K
    | framed : properUPred_ent (mkProperSep PreNew Frame)
        (wp H msc_open_mask NewProph (wp_frame_post Raw Frame)) =>
        properUPred_ent_trans (mkProperSep PreNew Frame)
          (mkProperSep (wp H msc_open_mask NewProph Raw) Frame)
          (wp H msc_open_mask NewProph (wp_frame_post Raw Frame))
          (sep_mono_l_ent PreNew (wp H msc_open_mask NewProph Raw)
            Frame base)
          (wp_frame_r H msc_open_mask NewProph Raw Frame)
  \in properUPred_ent_trans
      (mkProperSep (mkProperSep PreNew Close) K)
      (mkProperSep PreNew Frame)
      (wp H msc_open_mask NewProph (\lam v =>
        mkProperFUpd H.iris_wsat msc_open_mask mscE
          (msc_read_prepared H G gam a w gamQ P Q v))) arrange
      (properUPred_ent_trans (mkProperSep PreNew Frame)
        (wp H msc_open_mask NewProph (wp_frame_post Raw Frame))
        (wp H msc_open_mask NewProph (\lam v =>
          mkProperFUpd H.iris_wsat msc_open_mask mscE
            (msc_read_prepared H G gam a w gamQ P Q v))) framed
        (wp_mono H msc_open_mask NewProph (wp_frame_post Raw Frame)
          (\lam v => mkProperFUpd H.iris_wsat msc_open_mask mscE
            (msc_read_prepared H G gam a w gamQ P Q v))
          (\lam v => msc_read_raw_continue H G gam a w gamQ P Q v
            Close idp)))

\lemma msc_read_new_wp {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (a : Nat) (gamQ : gname) (P : iProp S) (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep
      (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a))
      (mkProperSep
        (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
          (msc_inv H G gam a))
        (mkProperSep
          (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
          (mkProperSep
            (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
            (mkProperSep (msc_read_shift H G gam P Q) P)))))
    (wp H mscE NewProph (\lam v =>
      mkProperExist (msc_read_witness gam) (\lam w =>
        msc_read_prepared H G gam a w gamQ P Q v))) =>
  \let
    | InvP => msc_inv H G gam a
    | PublicInv => iris.base_logic.lib.invariants.inv H.iris_wsat mscN InvP
    | Saved => saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q
    | K => mkProperSep PublicInv
        (mkProperSep Saved
          (mkProperSep Saved (mkProperSep (msc_read_shift H G gam P Q) P)))
    | Phi : Value -> iProp S => \lam v =>
        mkProperExist (msc_read_witness gam) (\lam w =>
          msc_read_prepared H G gam a w gamQ P Q v)
    | opened : \Pi (w : msc_read_witness gam) -> properUPred_ent
        (mkProperSep
          (mkProperSep
            (mkProperSep (msc_read_now {S} w)
              (mkProperLater (msc_read_after H G gam a w)))
            (mkProperWand (mkProperLater InvP)
              (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp))) K)
        (wp H msc_open_mask NewProph (\lam v =>
          mkProperFUpd H.iris_wsat msc_open_mask mscE (Phi v))) =>
        \lam w => properUPred_ent_trans
          (mkProperSep
            (mkProperSep
              (mkProperSep (msc_read_now {S} w)
                (mkProperLater (msc_read_after H G gam a w)))
              (mkProperWand (mkProperLater InvP)
                (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp))) K)
          (wp H msc_open_mask NewProph (\lam v =>
            mkProperFUpd H.iris_wsat msc_open_mask mscE
              (msc_read_prepared H G gam a w gamQ P Q v)))
          (wp H msc_open_mask NewProph (\lam v =>
            mkProperFUpd H.iris_wsat msc_open_mask mscE (Phi v)))
          (msc_read_opened_new H G gam a w gamQ P Q)
          (wp_mono H msc_open_mask NewProph
            (\lam v => mkProperFUpd H.iris_wsat msc_open_mask mscE
              (msc_read_prepared H G gam a w gamQ P Q v))
            (\lam v => mkProperFUpd H.iris_wsat msc_open_mask mscE (Phi v))
            (\lam v => fupd_mono H.iris_wsat msc_open_mask mscE
              (msc_read_prepared H G gam a w gamQ P Q v) (Phi v)
              (exist_intro_ent (\lam w0 =>
                msc_read_prepared H G gam a w0 gamQ P Q v) w)))
  \in wp_atomic_inv_acc_timeless_exist_frame H mscE mscN InvP
      (\lam w => msc_read_now {S} w)
      (\lam w => msc_read_after H G gam a w) K NewProph Phi
      mscN_subset_mscE new_proph_strongly_atomic
      (msc_read_now_timeless gam) (msc_inv_read_split H G gam a) opened

\lemma msc_read_duplicate_public {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (a : Nat) (gamQ : gname) (P : iProp S) (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep
      (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a))
      (mkProperSep
        (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
        (mkProperSep (msc_read_shift H G gam P Q) P)))
    (mkProperSep
      (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a))
      (mkProperSep
        (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
          (msc_inv H G gam a))
        (mkProperSep
          (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
          (mkProperSep
            (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
            (mkProperSep (msc_read_shift H G gam P Q) P))))) =>
  \let
    | Inv => iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a)
    | Saved => saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q
    | Client => mkProperSep (msc_read_shift H G gam P Q) P
    | invDup : properUPred_ent Inv (mkProperSep Inv Inv) =>
        persistent_consequence_frame_ent Inv Inv
          (inv_persistent H.iris_wsat mscN (msc_inv H G gam a))
    | savedDup : properUPred_ent Saved (mkProperSep Saved Saved) =>
        persistent_consequence_frame_ent Saved Saved
          (saved_pred_discarded_persistent G.msc_saved_predG gamQ Q)
  \in properUPred_ent_trans
      (mkProperSep Inv (mkProperSep Saved Client))
      (mkProperSep (mkProperSep Inv Inv) (mkProperSep Saved Client))
      (mkProperSep Inv
        (mkProperSep Inv
          (mkProperSep Saved (mkProperSep Saved Client))))
      (sep_mono_l_ent Inv (mkProperSep Inv Inv)
        (mkProperSep Saved Client) invDup)
      (properUPred_ent_trans
        (mkProperSep (mkProperSep Inv Inv) (mkProperSep Saved Client))
        (mkProperSep Inv (mkProperSep Inv (mkProperSep Saved Client)))
        (mkProperSep Inv
          (mkProperSep Inv
            (mkProperSep Saved (mkProperSep Saved Client))))
        (sep_assoc_l_ent Inv Inv (mkProperSep Saved Client))
          (sep_mono_r_ent Inv
            (mkProperSep Inv (mkProperSep Saved Client))
            (mkProperSep Inv
              (mkProperSep Saved (mkProperSep Saved Client)))
            (sep_mono_r_ent Inv (mkProperSep Saved Client)
              (mkProperSep Saved (mkProperSep Saved Client))
              (properUPred_ent_trans (mkProperSep Saved Client)
                (mkProperSep (mkProperSep Saved Saved) Client)
                (mkProperSep Saved (mkProperSep Saved Client))
                (sep_mono_l_ent Saved (mkProperSep Saved Saved)
                  Client savedDup)
                (sep_assoc_l_ent Saved Saved Client)))))

\func msc_read_new_post {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (a : Nat) (P : iProp S) (Q : Nat -> iProp S) (v : Value) : iProp S =>
  mkProperExist gname (\lam gamQ =>
    mkProperExist (msc_read_witness gam) (\lam w =>
      msc_read_prepared H G gam a w gamQ P Q v))

\lemma msc_read_start_new {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (a : Nat) (P : iProp S) (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep
      (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a))
      (mkProperSep (msc_read_shift H G gam P Q) P))
    (wp H mscE NewProph (msc_read_new_post H G gam a P Q)) =>
  \let
    | Inv => iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a)
    | Client => mkProperSep (msc_read_shift H G gam P Q) P
    | Source => mkProperSep Inv Client
    | SavedF : gname -> iProp S => \lam gamQ =>
        saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q
    | SavedExists => mkProperExist gname SavedF
    | allocated : properUPred_ent Source
        (mkProperBUpd (mkProperSep SavedExists Source)) =>
        bupd_alloc_frame SavedExists Source
          (saved_pred_alloc G.msc_saved_predG Q DfracDiscarded ())
    | afterAlloc : properUPred_ent (mkProperSep SavedExists Source)
        (wp H mscE NewProph (msc_read_new_post H G gam a P Q)) =>
        sep_exist_l_elim SavedF Source
          (wp H mscE NewProph (msc_read_new_post H G gam a P Q))
          (\lam gamQ =>
            \let
              | Saved => SavedF gamQ
              | arranged : properUPred_ent (mkProperSep Saved Source)
                  (mkProperSep Inv (mkProperSep Saved Client)) =>
                  properUPred_ent_trans (mkProperSep Saved (mkProperSep Inv Client))
                    (mkProperSep Inv (mkProperSep Saved Client))
                    (mkProperSep Inv (mkProperSep Saved Client))
                    (sep_swap_ent Saved Inv Client)
                    (properUPred_ent_refl
                      (mkProperSep Inv (mkProperSep Saved Client)))
              | ready : properUPred_ent (mkProperSep Saved Source)
                  (mkProperSep Inv
                    (mkProperSep Inv
                      (mkProperSep Saved
                        (mkProperSep Saved Client)))) =>
                  properUPred_ent_trans (mkProperSep Saved Source)
                    (mkProperSep Inv (mkProperSep Saved Client))
                    (mkProperSep Inv
                      (mkProperSep Inv
                        (mkProperSep Saved (mkProperSep Saved Client))))
                    arranged
                    (msc_read_duplicate_public H G gam a gamQ P Q)
              | core : properUPred_ent
                  (mkProperSep Inv
                    (mkProperSep Inv
                      (mkProperSep Saved
                        (mkProperSep Saved Client))))
                  (wp H mscE NewProph (\lam v =>
                    mkProperExist (msc_read_witness gam) (\lam w =>
                      msc_read_prepared H G gam a w gamQ P Q v))) =>
                  msc_read_new_wp H G gam a gamQ P Q
              | hideName : properUPred_ent
                  (wp H mscE NewProph (\lam v =>
                    mkProperExist (msc_read_witness gam) (\lam w =>
                      msc_read_prepared H G gam a w gamQ P Q v)))
                  (wp H mscE NewProph
                    (msc_read_new_post H G gam a P Q)) =>
                  wp_mono H mscE NewProph
                    (\lam v => mkProperExist (msc_read_witness gam) (\lam w =>
                      msc_read_prepared H G gam a w gamQ P Q v))
                    (msc_read_new_post H G gam a P Q)
                    (\lam v => exist_intro_ent (\lam gamQ0 =>
                      mkProperExist (msc_read_witness gam) (\lam w =>
                        msc_read_prepared H G gam a w gamQ0 P Q v)) gamQ)
            \in properUPred_ent_trans (mkProperSep Saved Source)
                (mkProperSep Inv
                  (mkProperSep Inv
                    (mkProperSep Saved (mkProperSep Saved Client))))
                (wp H mscE NewProph (msc_read_new_post H G gam a P Q))
                ready (properUPred_ent_trans
                  (mkProperSep Inv
                    (mkProperSep Inv
                      (mkProperSep Saved (mkProperSep Saved Client))))
                  (wp H mscE NewProph (\lam v =>
                    mkProperExist (msc_read_witness gam) (\lam w =>
                      msc_read_prepared H G gam a w gamQ P Q v)))
                  (wp H mscE NewProph (msc_read_new_post H G gam a P Q))
                  core hideName))
    | updated : properUPred_ent (mkProperBUpd (mkProperSep SavedExists Source))
        (mkProperBUpd
          (wp H mscE NewProph (msc_read_new_post H G gam a P Q))) =>
        bupd_mono (mkProperSep SavedExists Source)
          (wp H mscE NewProph (msc_read_new_post H G gam a P Q)) afterAlloc
  \in properUPred_ent_trans Source
      (mkProperBUpd (mkProperSep SavedExists Source))
      (wp H mscE NewProph (msc_read_new_post H G gam a P Q)) allocated
      (properUPred_ent_trans
        (mkProperBUpd (mkProperSep SavedExists Source))
        (mkProperBUpd
          (wp H mscE NewProph (msc_read_new_post H G gam a P Q)))
        (wp H mscE NewProph (msc_read_new_post H G gam a P Q)) updated
        (wp_bupd H mscE NewProph (msc_read_new_post H G gam a P Q)))

\lemma msc_read_stage_scan {M : UCMRA}
    (A B C D E : ProperUPred M) :
  properUPred_ent
    (mkProperSep (mkProperSep A B) (mkProperSep (mkProperSep C D) E))
    (mkProperSep (mkProperSep A D) (mkProperSep B (mkProperSep C E))) =>
  \let
    | Flat => mkProperSep A (mkProperSep B (mkProperSep C (mkProperSep D E)))
    | Moved => mkProperSep A (mkProperSep D
        (mkProperSep B (mkProperSep C E)))
    | Target => mkProperSep (mkProperSep A D)
        (mkProperSep B (mkProperSep C E))
    | flatten : properUPred_ent
        (mkProperSep (mkProperSep A B) (mkProperSep (mkProperSep C D) E))
        Flat =>
        properUPred_ent_trans
          (mkProperSep (mkProperSep A B) (mkProperSep (mkProperSep C D) E))
          (mkProperSep A (mkProperSep B (mkProperSep (mkProperSep C D) E)))
          Flat
          (sep_assoc_l_ent A B (mkProperSep (mkProperSep C D) E))
          (sep_mono_r_ent A
            (mkProperSep B (mkProperSep (mkProperSep C D) E))
            (mkProperSep B (mkProperSep C (mkProperSep D E)))
            (sep_mono_r_ent B (mkProperSep (mkProperSep C D) E)
              (mkProperSep C (mkProperSep D E))
              (sep_assoc_l_ent C D E)))
    | move : properUPred_ent Flat Moved =>
        sep_mono_r_ent A
          (mkProperSep B (mkProperSep C (mkProperSep D E)))
          (mkProperSep D (mkProperSep B (mkProperSep C E)))
          (sep_rotate_third_front B C D E)
  \in properUPred_ent_trans
      (mkProperSep (mkProperSep A B) (mkProperSep (mkProperSep C D) E))
      Flat Target flatten
      (properUPred_ent_trans Flat Moved Target move
        (sep_assoc_r_ent A D (mkProperSep B (mkProperSep C E))))

\func msc_read_scan_post {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (a : Nat) (w : msc_read_witness gam) (gamQ : gname)
    (P : iProp S) (Q : Nat -> iProp S)
    (p : ProphId) (resolves : List ProphPayload) (v : Value) : iProp S =>
  mkProperSep
    (msc_sum_post H G gam a w.read_initial gam.msc_shard_names 0 v)
    (mkProperSep
      (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
      (mkProperSep (proph H.iris_proph_map p resolves)
        (msc_read_case G gam (msc_proph_total resolves)
          (nat_sum w.read_initial) gamQ P)))

\lemma msc_read_scan_wp {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (a : Nat) (w : msc_read_witness gam) (gamQ : gname)
    (P : iProp S) (Q : Nat -> iProp S)
    (p : ProphId) (resolves : List ProphPayload) :
  properUPred_ent
    (mkProperSep
      (mkProperSep
        (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
          (msc_inv H G gam a))
        (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q))
      (mkProperSep
        (mkProperPure
          (LitV (LitProphecy p) = LitV (LitProphecy p)))
        (mkProperSep
          (mkProperSep (proph H.iris_proph_map p resolves)
            (msc_lbs G w.read_initial gam.msc_shard_names))
          (msc_read_case G gam (msc_proph_total resolves)
            (nat_sum w.read_initial) gamQ P))))
    (wp H mscE
      (app4 (Val msc_sum_loop)
        (Val (LitV (LitLoc a))) (Val (natV gam.msc_size))
        (Val (natV 0)) (Val (natV 0)))
      (msc_read_scan_post H G gam a w gamQ P Q p resolves)) =>
  \let
    | Inv => iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a)
    | Saved => saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q
    | Token => proph H.iris_proph_map p resolves
    | LBs => msc_lbs G w.read_initial gam.msc_shard_names
    | Case => msc_read_case G gam (msc_proph_total resolves)
        (nat_sum w.read_initial) gamQ P
    | Eq => mkProperPure {iResUR S}
        (LitV (LitProphecy p) = LitV (LitProphecy p))
    | Source => mkProperSep (mkProperSep Inv Saved)
        (mkProperSep Eq (mkProperSep (mkProperSep Token LBs) Case))
    | NoEq => mkProperSep (mkProperSep Inv Saved)
        (mkProperSep (mkProperSep Token LBs) Case)
    | PreScan => mkProperSep (mkProperSep Inv LBs)
        (mkProperSep Saved (mkProperSep Token Case))
    | Rest => mkProperSep Saved (mkProperSep Token Case)
    | SumPhi => msc_sum_post H G gam a w.read_initial
        gam.msc_shard_names 0
    | Call => app4 (Val msc_sum_loop)
        (Val (LitV (LitLoc a))) (Val (natV gam.msc_size))
        (Val (natV 0)) (Val (natV 0))
    | dropEq : properUPred_ent Source NoEq =>
        sep_mono_r_ent (mkProperSep Inv Saved)
          (mkProperSep Eq (mkProperSep (mkProperSep Token LBs) Case))
          (mkProperSep (mkProperSep Token LBs) Case)
          (sep_elim_r_ent Eq (mkProperSep (mkProperSep Token LBs) Case))
    | arrange : properUPred_ent NoEq PreScan =>
        msc_read_stage_scan Inv Saved Token LBs Case
    | scan : properUPred_ent (mkProperSep Inv LBs)
        (wp H mscE Call SumPhi) =>
        msc_sum_loop_suffix_wp H G gam a 0 nil gam.msc_shard_names
          w.read_initial idp (Paths.inv w.read_names_len)
    | framed : properUPred_ent PreScan
        (wp H mscE Call (wp_frame_post SumPhi Rest)) =>
        properUPred_ent_trans PreScan
          (mkProperSep (wp H mscE Call SumPhi) Rest)
          (wp H mscE Call (wp_frame_post SumPhi Rest))
          (sep_mono_l_ent (mkProperSep Inv LBs)
            (wp H mscE Call SumPhi) Rest scan)
          (wp_frame_r H mscE Call SumPhi Rest)
  \in properUPred_ent_trans Source NoEq
      (wp H mscE Call
        (msc_read_scan_post H G gam a w gamQ P Q p resolves)) dropEq
      (properUPred_ent_trans NoEq PreScan
        (wp H mscE Call
          (msc_read_scan_post H G gam a w gamQ P Q p resolves)) arrange
        framed)

\lemma msc_read_after_monos {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a : Nat) (w : msc_read_witness gam) :
  properUPred_ent (msc_read_after H G gam a w)
    (msc_mono_auths G w.read_initial gam.msc_shard_names) =>
  \let
    | LenN => mkProperPure {iResUR S}
        (length w.read_initial = gam.msc_size)
    | LenNames => mkProperPure {iResUR S}
        (length gam.msc_shard_names = gam.msc_size)
    | Auth => msc_counter_auth G gam (nat_sum w.read_initial)
    | Cells => pointsto_array H.iris_gen_heap suc a
        (map natV w.read_initial)
    | Monos => msc_mono_auths G w.read_initial gam.msc_shard_names
    | Requests => msc_requests H G gam (nat_sum w.read_initial)
        w.read_requests
  \in properUPred_ent_trans (msc_read_after H G gam a w)
      (mkProperSep Auth
        (mkProperSep (mkProperSep Cells Monos) Requests)) Monos
      (properUPred_ent_trans (msc_read_after H G gam a w)
        (mkProperSep LenNames
          (mkProperSep Auth
            (mkProperSep (mkProperSep Cells Monos) Requests)))
        (mkProperSep Auth
          (mkProperSep (mkProperSep Cells Monos) Requests))
        (sep_elim_r_ent LenN
          (mkProperSep LenNames
            (mkProperSep Auth
              (mkProperSep (mkProperSep Cells Monos) Requests))))
        (sep_elim_r_ent LenNames
          (mkProperSep Auth
            (mkProperSep (mkProperSep Cells Monos) Requests))))
      (properUPred_ent_trans
        (mkProperSep Auth
          (mkProperSep (mkProperSep Cells Monos) Requests))
        (mkProperSep Cells Monos) Monos
        (properUPred_ent_trans
          (mkProperSep Auth
            (mkProperSep (mkProperSep Cells Monos) Requests))
          (mkProperSep (mkProperSep Cells Monos) Requests)
          (mkProperSep Cells Monos)
          (sep_elim_r_ent Auth
            (mkProperSep (mkProperSep Cells Monos) Requests))
          (sep_elim_l_ent (mkProperSep Cells Monos) Requests))
        (sep_elim_r_ent Cells Monos))

\lemma msc_read_after_focus_requests {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a : Nat) (w : msc_read_witness gam) :
  properUPred_ent (msc_read_after H G gam a w)
    (mkProperSep
      (mkProperSep
        (mkProperPure (length w.read_initial = gam.msc_size))
        (mkProperSep
          (mkProperPure (length gam.msc_shard_names = gam.msc_size))
          (mkProperSep
            (msc_counter_auth G gam (nat_sum w.read_initial))
            (msc_shards H G a w.read_initial gam.msc_shard_names))))
      (msc_requests H G gam (nat_sum w.read_initial) w.read_requests)) =>
  \let
    | A => mkProperPure {iResUR S}
        (length w.read_initial = gam.msc_size)
    | B => mkProperPure {iResUR S}
        (length gam.msc_shard_names = gam.msc_size)
    | C => msc_counter_auth G gam (nat_sum w.read_initial)
    | D => msc_shards H G a w.read_initial gam.msc_shard_names
    | E => msc_requests H G gam (nat_sum w.read_initial) w.read_requests
  \in properUPred_ent_trans
      (mkProperSep A (mkProperSep B (mkProperSep C (mkProperSep D E))))
      (mkProperSep A
        (mkProperSep B (mkProperSep (mkProperSep C D) E)))
      (mkProperSep (mkProperSep A
        (mkProperSep B (mkProperSep C D))) E)
      (sep_mono_r_ent A
        (mkProperSep B (mkProperSep C (mkProperSep D E)))
        (mkProperSep B (mkProperSep (mkProperSep C D) E))
        (sep_mono_r_ent B (mkProperSep C (mkProperSep D E))
          (mkProperSep (mkProperSep C D) E)
          (sep_assoc_r_ent C D E)))
      (properUPred_ent_trans
        (mkProperSep A
          (mkProperSep B (mkProperSep (mkProperSep C D) E)))
        (mkProperSep A
          (mkProperSep (mkProperSep B (mkProperSep C D)) E))
        (mkProperSep (mkProperSep A
          (mkProperSep B (mkProperSep C D))) E)
        (sep_mono_r_ent A
          (mkProperSep B (mkProperSep (mkProperSep C D) E))
          (mkProperSep (mkProperSep B (mkProperSep C D)) E)
          (sep_assoc_r_ent B (mkProperSep C D) E))
        (sep_assoc_r_ent A (mkProperSep B (mkProperSep C D)) E))

\lemma msc_read_scan_final_bound {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a : Nat)
    (reads : List Nat) (final : msc_read_witness gam) :
  properUPred_ent
    (mkProperSep (msc_lbs G reads gam.msc_shard_names)
      (msc_read_after H G gam a final))
    (mkProperPure (nat_sum reads <= nat_sum final.read_initial)) =>
  properUPred_ent_trans
    (mkProperSep (msc_lbs G reads gam.msc_shard_names)
      (msc_read_after H G gam a final))
    (mkProperSep (msc_lbs G reads gam.msc_shard_names)
      (msc_mono_auths G final.read_initial gam.msc_shard_names))
    (mkProperPure (nat_sum reads <= nat_sum final.read_initial))
    (sep_mono_r_ent (msc_lbs G reads gam.msc_shard_names)
      (msc_read_after H G gam a final)
      (msc_mono_auths G final.read_initial gam.msc_shard_names)
      (msc_read_after_monos H G gam a final))
    (msc_lbs_sum_le G reads final.read_initial gam.msc_shard_names)

\lemma msc_read_rebuild_focused {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a : Nat) (w : msc_read_witness gam)
    (requests : Gmap Nat natCountable (\Sigma Nat gname)) :
  properUPred_ent
    (mkProperSep
      (mkProperSep
        (mkProperPure (length w.read_initial = gam.msc_size))
        (mkProperSep
          (mkProperPure (length gam.msc_shard_names = gam.msc_size))
          (mkProperSep
            (msc_counter_auth G gam (nat_sum w.read_initial))
            (msc_shards H G a w.read_initial gam.msc_shard_names))))
      (msc_requests H G gam (nat_sum w.read_initial) requests))
    (msc_inv H G gam a) =>
  \let
    | A => mkProperPure {iResUR S}
        (length w.read_initial = gam.msc_size)
    | B => mkProperPure {iResUR S}
        (length gam.msc_shard_names = gam.msc_size)
    | C => msc_counter_auth G gam (nat_sum w.read_initial)
    | D => msc_shards H G a w.read_initial gam.msc_shard_names
    | E => msc_requests H G gam (nat_sum w.read_initial) requests
    | Focused => mkProperSep
        (mkProperSep A (mkProperSep B (mkProperSep C D))) E
    | Canonical => mkProperSep A
        (mkProperSep B (mkProperSep C (mkProperSep D E)))
    | unfoldFocus : properUPred_ent Focused Canonical =>
        properUPred_ent_trans Focused
          (mkProperSep A
            (mkProperSep (mkProperSep B (mkProperSep C D)) E)) Canonical
          (sep_assoc_l_ent A (mkProperSep B (mkProperSep C D)) E)
          (sep_mono_r_ent A
            (mkProperSep (mkProperSep B (mkProperSep C D)) E)
            (mkProperSep B (mkProperSep C (mkProperSep D E)))
            (properUPred_ent_trans
              (mkProperSep (mkProperSep B (mkProperSep C D)) E)
              (mkProperSep B
                (mkProperSep (mkProperSep C D) E))
              (mkProperSep B (mkProperSep C (mkProperSep D E)))
              (sep_assoc_l_ent B (mkProperSep C D) E)
              (sep_mono_r_ent B (mkProperSep (mkProperSep C D) E)
                (mkProperSep C (mkProperSep D E))
                (sep_assoc_l_ent C D E))))
  \in properUPred_ent_trans Focused Canonical (msc_inv H G gam a)
      unfoldFocus (msc_read_rebuild H G gam a w requests)

\lemma msc_read_finish_registered {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a : Nat) (final : msc_read_witness gam)
    (reads : List Nat) (gamQ : gname) (id : Nat)
    (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep
      (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
      (mkProperSep
        (ghost_map_elem (msc_requestGS G gam) id (nat_sum reads, gamQ))
        (mkProperSep
          (msc_lbs G reads gam.msc_shard_names)
          (msc_read_after H G gam a final))))
    (mkProperBUpd
      (mkProperSep (msc_inv H G gam a)
        (mkProperLater (Q (nat_sum reads))))) =>
  \let
    | Actual => nat_sum reads
    | Saved => saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q
    | Elem => ghost_map_elem (msc_requestGS G gam) id (Actual, gamQ)
    | LBs => msc_lbs G reads gam.msc_shard_names
    | Body => msc_read_after H G gam a final
    | Requests => msc_requests H G gam (nat_sum final.read_initial)
        final.read_requests
    | Requests' => msc_requests H G gam (nat_sum final.read_initial)
        (gdelete id final.read_requests)
    | Fixed => mkProperSep
        (mkProperPure {iResUR S}
          (length final.read_initial = gam.msc_size))
        (mkProperSep
          (mkProperPure (length gam.msc_shard_names = gam.msc_size))
          (mkProperSep
            (msc_counter_auth G gam (nat_sum final.read_initial))
            (msc_shards H G a final.read_initial gam.msc_shard_names)))
    | Source => mkProperSep Saved
        (mkProperSep Elem (mkProperSep LBs Body))
    | Bound => mkProperPure {iResUR S}
        (Actual <= nat_sum final.read_initial)
    | Target => mkProperBUpd
        (mkProperSep (msc_inv H G gam a)
          (mkProperLater (Q Actual)))
    | deriveBound : properUPred_ent Source Bound =>
        properUPred_ent_trans Source (mkProperSep LBs Body) Bound
          (properUPred_ent_trans Source
            (mkProperSep Elem (mkProperSep LBs Body))
            (mkProperSep LBs Body)
            (sep_elim_r_ent Saved
              (mkProperSep Elem (mkProperSep LBs Body)))
            (sep_elim_r_ent Elem (mkProperSep LBs Body)))
          (msc_read_scan_final_bound H G gam a reads final)
    | withBound : properUPred_ent Source (mkProperSep Bound Source) =>
        pure_consequence_frame_ent Source
          (Actual <= nat_sum final.read_initial) deriveBound
    | perBound : Actual <= nat_sum final.read_initial ->
        properUPred_ent Source Target => \lam hbound =>
        \let
          | Ready => mkProperSep Fixed
              (mkProperSep Saved (mkProperSep Elem Requests))
          | Updated => mkProperSep Fixed
              (mkProperBUpd
                (mkProperSep Requests' (mkProperLater (Q Actual))))
          | Framed => mkProperBUpd
              (mkProperSep Fixed
                (mkProperSep Requests' (mkProperLater (Q Actual))))
          | arrange : properUPred_ent Source Ready =>
              properUPred_ent_trans Source
                (mkProperSep Saved
                  (mkProperSep Elem (mkProperSep Fixed Requests))) Ready
                (sep_mono_r_ent Saved
                  (mkProperSep Elem (mkProperSep LBs Body))
                  (mkProperSep Elem (mkProperSep Fixed Requests))
                  (sep_mono_r_ent Elem (mkProperSep LBs Body)
                    (mkProperSep Fixed Requests)
                    (properUPred_ent_trans
                      (mkProperSep LBs Body)
                      (mkProperSep LBs (mkProperSep Fixed Requests))
                      (mkProperSep Fixed Requests)
                      (sep_mono_r_ent LBs Body
                        (mkProperSep Fixed Requests)
                        (msc_read_after_focus_requests H G gam a final))
                      (sep_elim_r_ent LBs
                        (mkProperSep Fixed Requests)))))
                (properUPred_ent_trans
                  (mkProperSep Saved
                    (mkProperSep Elem (mkProperSep Fixed Requests)))
                  (mkProperSep Saved
                    (mkProperSep Fixed (mkProperSep Elem Requests))) Ready
                  (sep_mono_r_ent Saved
                    (mkProperSep Elem (mkProperSep Fixed Requests))
                    (mkProperSep Fixed (mkProperSep Elem Requests))
                    (sep_swap_ent Elem Fixed Requests))
                  (sep_swap_ent Saved Fixed
                    (mkProperSep Elem Requests)))
          | update : properUPred_ent Ready Framed =>
              properUPred_ent_trans Ready Updated Framed
                (sep_mono_r_ent Fixed
                  (mkProperSep Saved (mkProperSep Elem Requests))
                  (mkProperBUpd
                    (mkProperSep Requests' (mkProperLater (Q Actual))))
                  (msc_request_take H G gam
                    (nat_sum final.read_initial) Actual gamQ id
                    final.read_requests Q hbound))
                (bupd_frame_l {UPredBiBUpd (iResUR S)} Fixed
                  (mkProperSep Requests' (mkProperLater (Q Actual))))
          | finish : properUPred_ent
              (mkProperSep Fixed
                (mkProperSep Requests' (mkProperLater (Q Actual))))
              (mkProperSep (msc_inv H G gam a)
                (mkProperLater (Q Actual))) =>
              properUPred_ent_trans
                (mkProperSep Fixed
                  (mkProperSep Requests' (mkProperLater (Q Actual))))
                (mkProperSep (mkProperSep Fixed Requests')
                  (mkProperLater (Q Actual)))
                (mkProperSep (msc_inv H G gam a)
                  (mkProperLater (Q Actual)))
                (sep_assoc_r_ent Fixed Requests'
                  (mkProperLater (Q Actual)))
                (sep_mono_l_ent (mkProperSep Fixed Requests')
                  (msc_inv H G gam a) (mkProperLater (Q Actual))
                  (msc_read_rebuild_focused H G gam a final
                    (gdelete id final.read_requests)))
        \in properUPred_ent_trans Source Ready Target arrange
            (properUPred_ent_trans Ready Framed Target update
              (bupd_mono
                (mkProperSep Fixed
                  (mkProperSep Requests' (mkProperLater (Q Actual))))
                (mkProperSep (msc_inv H G gam a)
                  (mkProperLater (Q Actual))) finish))
  \in properUPred_ent_trans Source (mkProperSep Bound Source) Target
      withBound
      (pure_sep_l_elim (Actual <= nat_sum final.read_initial)
        Source Target perBound)

\lemma msc_read_stage_resolve_finish {M : UCMRA}
    (Body Close Public Saved Elem LBs : ProperUPred M) :
  properUPred_ent
    (mkProperSep Body
      (mkProperSep Close
        (mkProperSep Public
          (mkProperSep Saved (mkProperSep Elem LBs)))))
    (mkProperSep
      (mkProperSep Saved
        (mkProperSep Elem (mkProperSep LBs Body)))
      (mkProperSep Close Public)) =>
  \let
    | Tail0 => mkProperSep Elem LBs
    | S0 => mkProperSep Body
        (mkProperSep Close
          (mkProperSep Public (mkProperSep Saved Tail0)))
    | S1 => mkProperSep Body
        (mkProperSep Saved
          (mkProperSep Close (mkProperSep Public Tail0)))
    | S2 => mkProperSep Saved
        (mkProperSep Body
          (mkProperSep Close (mkProperSep Public Tail0)))
    | Tail1 => mkProperSep Close (mkProperSep Public LBs)
    | S3 => mkProperSep Saved
        (mkProperSep Body (mkProperSep Elem Tail1))
    | S4 => mkProperSep Saved
        (mkProperSep Elem (mkProperSep Body Tail1))
    | Tail2 => mkProperSep Body
        (mkProperSep Close (mkProperSep Public LBs))
    | Tail3 => mkProperSep Body
        (mkProperSep Close (mkProperSep LBs Public))
    | Tail4 => mkProperSep Body
        (mkProperSep LBs (mkProperSep Close Public))
    | Tail5 => mkProperSep LBs
        (mkProperSep Body (mkProperSep Close Public))
    | S5 => mkProperSep Saved (mkProperSep Elem Tail5)
    | S6 => mkProperSep Saved
        (mkProperSep Elem
          (mkProperSep (mkProperSep LBs Body)
            (mkProperSep Close Public)))
    | S7 => mkProperSep Saved
        (mkProperSep (mkProperSep Elem (mkProperSep LBs Body))
          (mkProperSep Close Public))
    | Target => mkProperSep
        (mkProperSep Saved
          (mkProperSep Elem (mkProperSep LBs Body)))
        (mkProperSep Close Public)
  \in properUPred_ent_trans S0 S1 Target
      (sep_mono_r_ent Body
        (mkProperSep Close
          (mkProperSep Public (mkProperSep Saved Tail0)))
        (mkProperSep Saved
          (mkProperSep Close (mkProperSep Public Tail0)))
        (sep_rotate_third_front Close Public Saved Tail0))
      (properUPred_ent_trans S1 S2 Target
        (sep_swap_ent Body Saved
          (mkProperSep Close (mkProperSep Public Tail0)))
        (properUPred_ent_trans S2 S3 Target
          (sep_mono_r_ent Saved
            (mkProperSep Body
              (mkProperSep Close (mkProperSep Public Tail0)))
            (mkProperSep Body (mkProperSep Elem Tail1))
            (sep_mono_r_ent Body
              (mkProperSep Close (mkProperSep Public (mkProperSep Elem LBs)))
              (mkProperSep Elem Tail1)
              (sep_rotate_third_front Close Public Elem LBs)))
          (properUPred_ent_trans S3 S4 Target
            (sep_mono_r_ent Saved
              (mkProperSep Body (mkProperSep Elem Tail1))
              (mkProperSep Elem (mkProperSep Body Tail1))
              (sep_swap_ent Body Elem Tail1))
            (properUPred_ent_trans S4 S5 Target
              (sep_mono_r_ent Saved
                (mkProperSep Elem Tail2)
                (mkProperSep Elem Tail5)
                (sep_mono_r_ent Elem Tail2 Tail5
                  (properUPred_ent_trans Tail2 Tail3 Tail5
                    (sep_mono_r_ent Body
                      (mkProperSep Close (mkProperSep Public LBs))
                      (mkProperSep Close (mkProperSep LBs Public))
                      (sep_mono_r_ent Close
                        (mkProperSep Public LBs)
                        (mkProperSep LBs Public)
                        (sep_comm_ent Public LBs)))
                    (properUPred_ent_trans Tail3 Tail4 Tail5
                      (sep_mono_r_ent Body
                        (mkProperSep Close (mkProperSep LBs Public))
                        (mkProperSep LBs (mkProperSep Close Public))
                        (sep_swap_ent Close LBs Public))
                      (sep_swap_ent Body LBs
                        (mkProperSep Close Public))))))
              (properUPred_ent_trans S5 S6 Target
                (sep_mono_r_ent Saved
                  (mkProperSep Elem
                    (mkProperSep LBs
                      (mkProperSep Body (mkProperSep Close Public))))
                  (mkProperSep Elem
                    (mkProperSep (mkProperSep LBs Body)
                      (mkProperSep Close Public)))
                  (sep_mono_r_ent Elem
                    (mkProperSep LBs
                      (mkProperSep Body (mkProperSep Close Public)))
                    (mkProperSep (mkProperSep LBs Body)
                      (mkProperSep Close Public))
                    (sep_assoc_r_ent LBs Body
                      (mkProperSep Close Public))))
                (properUPred_ent_trans S6 S7 Target
                  (sep_mono_r_ent Saved
                    (mkProperSep Elem
                      (mkProperSep (mkProperSep LBs Body)
                        (mkProperSep Close Public)))
                    (mkProperSep
                      (mkProperSep Elem (mkProperSep LBs Body))
                      (mkProperSep Close Public))
                    (sep_assoc_r_ent Elem (mkProperSep LBs Body)
                      (mkProperSep Close Public)))
                  (sep_assoc_r_ent Saved
                    (mkProperSep Elem (mkProperSep LBs Body))
                    (mkProperSep Close Public))))))))

\lemma msc_read_close_registered {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a actual : Nat) (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep
      (mkProperSep (msc_inv H G gam a) (mkProperLater (Q actual)))
      (mkProperSep
        (mkProperWand (mkProperLater (msc_inv H G gam a))
          (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp))
        (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
          (msc_inv H G gam a))))
    (mkProperFUpd H.iris_wsat msc_open_mask mscE
      (mkProperSep
        (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
          (msc_inv H G gam a))
        (mkProperLater (Q actual)))) =>
  \let
    | InvP => msc_inv H G gam a
    | LaterInv => mkProperLater InvP
    | QR => mkProperLater (Q actual)
    | Close => mkProperWand LaterInv
        (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp)
    | Public => iris.base_logic.lib.invariants.inv H.iris_wsat mscN InvP
    | Result => mkProperSep Public QR
    | A0 => mkProperSep (mkProperSep InvP QR)
        (mkProperSep Close Public)
    | A1 => mkProperSep (mkProperSep LaterInv QR)
        (mkProperSep Close Public)
    | A2 => mkProperSep LaterInv
        (mkProperSep QR (mkProperSep Close Public))
    | A3 => mkProperSep LaterInv
        (mkProperSep Close (mkProperSep QR Public))
    | A4 => mkProperSep Close
        (mkProperSep LaterInv (mkProperSep QR Public))
    | A5 => mkProperSep Close
        (mkProperSep LaterInv (mkProperSep Public QR))
    | Ready => mkProperSep (mkProperSep Close LaterInv) Result
    | Invoked => mkProperSep
        (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp) Result
    | Framed => mkProperFUpd H.iris_wsat msc_open_mask mscE
        (mkProperSep mkProperEmp Result)
    | h01 : properUPred_ent A0 A1 =>
        sep_mono_l_ent (mkProperSep InvP QR)
          (mkProperSep LaterInv QR) (mkProperSep Close Public)
          (sep_mono_l_ent InvP LaterInv QR (proper_later_intro InvP))
    | h12 : properUPred_ent A1 A2 =>
        sep_assoc_l_ent LaterInv QR (mkProperSep Close Public)
    | h23 : properUPred_ent A2 A3 =>
        sep_mono_r_ent LaterInv
          (mkProperSep QR (mkProperSep Close Public))
          (mkProperSep Close (mkProperSep QR Public))
          (sep_swap_ent QR Close Public)
    | h34 : properUPred_ent A3 A4 =>
        sep_swap_ent LaterInv Close (mkProperSep QR Public)
    | h45 : properUPred_ent A4 A5 =>
        sep_mono_r_ent Close
          (mkProperSep LaterInv (mkProperSep QR Public))
          (mkProperSep LaterInv (mkProperSep Public QR))
          (sep_mono_r_ent LaterInv
            (mkProperSep QR Public) (mkProperSep Public QR)
            (sep_comm_ent QR Public))
    | h5Ready : properUPred_ent A5 Ready =>
        sep_assoc_r_ent Close LaterInv Result
    | hReadyInvoked : properUPred_ent Ready Invoked =>
        sep_mono_l_ent (mkProperSep Close LaterInv)
          (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp)
          Result
          (wand_elim_ent LaterInv
            (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp))
    | hInvokedFramed : properUPred_ent Invoked Framed =>
        fupd_frame_r H.iris_wsat msc_open_mask mscE mkProperEmp Result
    | closeCore : properUPred_ent A0 Framed => \lam n x hx h =>
        hInvokedFramed n x hx
          (hReadyInvoked n x hx
            (h5Ready n x hx
              (h45 n x hx (h34 n x hx
                (h23 n x hx (h12 n x hx (h01 n x hx h)))))))
  \in properUPred_ent_trans A0 Framed
      (mkProperFUpd H.iris_wsat msc_open_mask mscE Result) closeCore
      (fupd_mono H.iris_wsat msc_open_mask mscE
        (mkProperSep mkProperEmp Result) Result
        (sep_elim_r_ent mkProperEmp Result))

\lemma msc_read_resolve_transition {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a : Nat) (final : msc_read_witness gam)
    (reads : List Nat) (gamQ : gname) (id : Nat)
    (Q : Nat -> iProp S) (p : ProphId)
    (resolves remaining : List ProphPayload) :
  properUPred_ent
    (mkProperSep
      (mkProperSep
        (mkProperPure
          (resolves = (unitV, natV (nat_sum reads)) :: remaining))
        (proph H.iris_proph_map p remaining))
      (mkProperSep (msc_read_after H G gam a final)
        (mkProperSep
          (mkProperWand (mkProperLater (msc_inv H G gam a))
            (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp))
          (mkProperSep
            (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
              (msc_inv H G gam a))
            (mkProperSep
              (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
              (mkProperSep
                (ghost_map_elem (msc_requestGS G gam) id
                  (msc_proph_total resolves, gamQ))
                (msc_lbs G reads gam.msc_shard_names)))))))
    (mkProperBUpd
      (mkProperFUpd H.iris_wsat msc_open_mask mscE
        (mkProperSep
          (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
            (msc_inv H G gam a))
          (mkProperLater (Q (nat_sum reads)))))) =>
  \let
    | Actual => nat_sum reads
    | PureResolve => mkProperPure {iResUR S}
        (resolves = (unitV, natV Actual) :: remaining)
    | Remaining => proph H.iris_proph_map p remaining
    | Body => msc_read_after H G gam a final
    | Close => mkProperWand (mkProperLater (msc_inv H G gam a))
        (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp)
    | Public => iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a)
    | Saved => saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q
    | ElemPred => ghost_map_elem (msc_requestGS G gam) id
        (msc_proph_total resolves, gamQ)
    | ElemActual => ghost_map_elem (msc_requestGS G gam) id (Actual, gamQ)
    | LBs => msc_lbs G reads gam.msc_shard_names
    | RestPred => mkProperSep Body
        (mkProperSep Close
          (mkProperSep Public
            (mkProperSep Saved (mkProperSep ElemPred LBs))))
    | RestActual => mkProperSep Body
        (mkProperSep Close
          (mkProperSep Public
            (mkProperSep Saved (mkProperSep ElemActual LBs))))
    | Source => mkProperSep (mkProperSep PureResolve Remaining) RestPred
    | FinishSource => mkProperSep Saved
        (mkProperSep ElemActual (mkProperSep LBs Body))
    | ClosePublic => mkProperSep Close Public
    | Staged => mkProperSep FinishSource ClosePublic
    | RequestResult => mkProperSep
        (msc_inv H G gam a) (mkProperLater (Q Actual))
    | Updated => mkProperSep (mkProperBUpd RequestResult) ClosePublic
    | Framed => mkProperBUpd (mkProperSep RequestResult ClosePublic)
    | TargetF => mkProperFUpd H.iris_wsat msc_open_mask mscE
        (mkProperSep Public (mkProperLater (Q Actual)))
    | Target => mkProperBUpd TargetF
    | dropRemaining : properUPred_ent Source
        (mkProperSep PureResolve RestPred) =>
        sep_mono_l_ent (mkProperSep PureResolve Remaining) PureResolve RestPred
          (sep_elim_l_ent PureResolve Remaining)
    | perResolve :
        resolves = (unitV, natV Actual) :: remaining ->
        properUPred_ent RestPred Target => \lam hresolve =>
        \let
          | predictedActual : msc_proph_total resolves = Actual =>
              pmap msc_proph_total hresolve
              *> msc_proph_total_cons Actual remaining
          | convertElem : properUPred_ent ElemPred ElemActual =>
              transport (\lam r => properUPred_ent ElemPred
                (ghost_map_elem (msc_requestGS G gam) id (r, gamQ)))
                predictedActual (properUPred_ent_refl ElemPred)
          | convertRest : properUPred_ent RestPred RestActual =>
              sep_mono_r_ent Body
                (mkProperSep Close
                  (mkProperSep Public
                    (mkProperSep Saved (mkProperSep ElemPred LBs))))
                (mkProperSep Close
                  (mkProperSep Public
                    (mkProperSep Saved (mkProperSep ElemActual LBs))))
                (sep_mono_r_ent Close
                  (mkProperSep Public
                    (mkProperSep Saved (mkProperSep ElemPred LBs)))
                  (mkProperSep Public
                    (mkProperSep Saved (mkProperSep ElemActual LBs)))
                  (sep_mono_r_ent Public
                    (mkProperSep Saved (mkProperSep ElemPred LBs))
                    (mkProperSep Saved (mkProperSep ElemActual LBs))
                    (sep_mono_r_ent Saved (mkProperSep ElemPred LBs)
                      (mkProperSep ElemActual LBs)
                      (sep_mono_l_ent ElemPred ElemActual LBs convertElem))))
          | stage : properUPred_ent RestActual Staged =>
              msc_read_stage_resolve_finish Body Close Public
                Saved ElemActual LBs
          | update : properUPred_ent Staged Framed =>
              properUPred_ent_trans Staged Updated Framed
                (sep_mono_l_ent FinishSource
                  (mkProperBUpd RequestResult) ClosePublic
                  (msc_read_finish_registered H G gam a final
                    reads gamQ id Q))
                (bupd_frame_r RequestResult ClosePublic)
          | close : properUPred_ent
              (mkProperSep RequestResult ClosePublic) TargetF =>
              msc_read_close_registered H G gam a Actual Q
        \in properUPred_ent_trans RestPred RestActual Target convertRest
            (properUPred_ent_trans RestActual Staged Target stage
              (properUPred_ent_trans Staged Framed Target update
                (bupd_mono
                  (mkProperSep RequestResult ClosePublic) TargetF close)))
  \in properUPred_ent_trans Source
      (mkProperSep PureResolve RestPred) Target dropRemaining
      (pure_sep_l_elim
        (resolves = (unitV, natV Actual) :: remaining)
        RestPred Target perResolve)

\lemma msc_read_opened_resolve {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a : Nat) (final : msc_read_witness gam)
    (reads : List Nat) (gamQ : gname) (id : Nat)
    (Q : Nat -> iProp S) (p : ProphId)
    (resolves : List ProphPayload) :
  properUPred_ent
    (mkProperSep
      (mkProperSep
        (mkProperSep (msc_read_now {S} final)
          (mkProperLater (msc_read_after H G gam a final)))
        (mkProperWand (mkProperLater (msc_inv H G gam a))
          (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp)))
      (mkProperSep
        (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
          (msc_inv H G gam a))
        (mkProperSep
          (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
          (mkProperSep (proph H.iris_proph_map p resolves)
            (mkProperSep
              (ghost_map_elem (msc_requestGS G gam) id
                (msc_proph_total resolves, gamQ))
              (msc_lbs G reads gam.msc_shard_names))))))
    (wp H msc_open_mask
      (resolveProphE (Val (LitV (LitProphecy p)))
        (Val (natV (nat_sum reads))))
      (\lam _ => mkProperFUpd H.iris_wsat msc_open_mask mscE
        (mkProperSep
          (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
            (msc_inv H G gam a))
          (mkProperLater (Q (nat_sum reads)))))) =>
  \let
    | Body => msc_read_after H G gam a final
    | LaterBody => mkProperLater Body
    | Close => mkProperWand (mkProperLater (msc_inv H G gam a))
        (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp)
    | Public => iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a)
    | Saved => saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q
    | Token => proph H.iris_proph_map p resolves
    | Elem => ghost_map_elem (msc_requestGS G gam) id
        (msc_proph_total resolves, gamQ)
    | LBs => msc_lbs G reads gam.msc_shard_names
    | Rest => mkProperSep Close
        (mkProperSep Public
          (mkProperSep Saved (mkProperSep Elem LBs)))
    | After => mkProperSep Body Rest
    | Phi : Value -> iProp S => \lam _ =>
        mkProperFUpd H.iris_wsat msc_open_mask mscE
          (mkProperSep Public (mkProperLater (Q (nat_sum reads))))
    | Source => mkProperSep
        (mkProperSep
          (mkProperSep (msc_read_now {S} final) LaterBody) Close)
        (mkProperSep Public
          (mkProperSep Saved
            (mkProperSep Token (mkProperSep Elem LBs))))
    | Flat => mkProperSep LaterBody
        (mkProperSep Close
          (mkProperSep Public
            (mkProperSep Saved (mkProperSep Token (mkProperSep Elem LBs)))))
    | Moved => mkProperSep Token
        (mkProperSep LaterBody Rest)
    | Ready => mkProperSep Token (mkProperLater After)
    | flatten : properUPred_ent Source Flat =>
        properUPred_ent_trans Source
          (mkProperSep
            (mkProperSep (msc_read_now {S} final) LaterBody)
            (mkProperSep Close
              (mkProperSep Public
                (mkProperSep Saved
                  (mkProperSep Token (mkProperSep Elem LBs)))))) Flat
          (sep_assoc_l_ent
            (mkProperSep (msc_read_now {S} final) LaterBody) Close
            (mkProperSep Public
              (mkProperSep Saved
                (mkProperSep Token (mkProperSep Elem LBs)))))
          (properUPred_ent_trans
            (mkProperSep
              (mkProperSep (msc_read_now {S} final) LaterBody)
              (mkProperSep Close
                (mkProperSep Public
                  (mkProperSep Saved
                    (mkProperSep Token (mkProperSep Elem LBs))))))
            (mkProperSep (msc_read_now {S} final)
              (mkProperSep LaterBody
                (mkProperSep Close
                  (mkProperSep Public
                    (mkProperSep Saved
                      (mkProperSep Token (mkProperSep Elem LBs))))))) Flat
            (sep_assoc_l_ent (msc_read_now {S} final) LaterBody
              (mkProperSep Close
                (mkProperSep Public
                  (mkProperSep Saved
                    (mkProperSep Token (mkProperSep Elem LBs))))))
            (sep_elim_r_ent (msc_read_now {S} final) Flat))
    | moveToken : properUPred_ent Flat Moved =>
        sep_move_fifth_front LaterBody Close Public Saved Token
          (mkProperSep Elem LBs)
    | combineLater : properUPred_ent Moved Ready =>
        sep_mono_r_ent Token (mkProperSep LaterBody Rest)
          (mkProperLater After)
          (properUPred_ent_trans (mkProperSep LaterBody Rest)
            (mkProperSep LaterBody (mkProperLater Rest))
            (mkProperLater After)
            (sep_mono_r_ent LaterBody Rest (mkProperLater Rest)
              (proper_later_intro Rest))
            (proper_later_sep_2 Body Rest))
    | resolve : properUPred_ent Ready
        (wp H msc_open_mask
          (resolveProphE (Val (LitV (LitProphecy p)))
            (Val (natV (nat_sum reads)))) Phi) =>
        wp_resolve_skip_later_frame H msc_open_mask nIgnore unitV p
          (natV (nat_sum reads)) resolves After Phi
          (\lam remaining => msc_read_resolve_transition H G gam a final
            reads gamQ id Q p resolves remaining)
  \in properUPred_ent_trans Source Flat
      (wp H msc_open_mask
        (resolveProphE (Val (LitV (LitProphecy p)))
          (Val (natV (nat_sum reads)))) Phi) flatten
      (properUPred_ent_trans Flat Moved
        (wp H msc_open_mask
          (resolveProphE (Val (LitV (LitProphecy p)))
            (Val (natV (nat_sum reads)))) Phi) moveToken
        (properUPred_ent_trans Moved Ready
          (wp H msc_open_mask
            (resolveProphE (Val (LitV (LitProphecy p)))
              (Val (natV (nat_sum reads)))) Phi) combineLater resolve))

\lemma msc_read_resolve_registered_wp {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a : Nat) (reads : List Nat)
    (gamQ : gname) (id : Nat) (Q : Nat -> iProp S)
    (p : ProphId) (resolves : List ProphPayload) :
  properUPred_ent
    (mkProperSep
      (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a))
      (mkProperSep
        (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
          (msc_inv H G gam a))
        (mkProperSep
          (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
          (mkProperSep (proph H.iris_proph_map p resolves)
            (mkProperSep
              (ghost_map_elem (msc_requestGS G gam) id
                (msc_proph_total resolves, gamQ))
              (msc_lbs G reads gam.msc_shard_names))))))
    (wp H mscE
      (resolveProphE (Val (LitV (LitProphecy p)))
        (Val (natV (nat_sum reads))))
      (\lam _ => mkProperSep
        (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
          (msc_inv H G gam a))
        (mkProperLater (Q (nat_sum reads))))) =>
  \let
    | InvP => msc_inv H G gam a
    | Public => iris.base_logic.lib.invariants.inv H.iris_wsat mscN InvP
    | K => mkProperSep Public
        (mkProperSep
          (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
          (mkProperSep (proph H.iris_proph_map p resolves)
            (mkProperSep
              (ghost_map_elem (msc_requestGS G gam) id
                (msc_proph_total resolves, gamQ))
              (msc_lbs G reads gam.msc_shard_names))))
    | Expr0 => resolveProphE (Val (LitV (LitProphecy p)))
        (Val (natV (nat_sum reads)))
    | Post : Value -> iProp S => \lam _ =>
        mkProperSep Public (mkProperLater (Q (nat_sum reads)))
    | opened : \Pi (final : msc_read_witness gam) -> properUPred_ent
        (mkProperSep
          (mkProperSep
            (mkProperSep (msc_read_now {S} final)
              (mkProperLater (msc_read_after H G gam a final)))
            (mkProperWand (mkProperLater InvP)
              (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp))) K)
        (wp H msc_open_mask Expr0 (\lam v =>
          mkProperFUpd H.iris_wsat msc_open_mask mscE (Post v))) =>
        \lam final => msc_read_opened_resolve H G gam a final reads
          gamQ id Q p resolves
  \in wp_atomic_inv_acc_timeless_exist_frame H mscE mscN InvP
      (\lam final => msc_read_now {S} final)
      (\lam final => msc_read_after H G gam a final) K Expr0 Post
      mscN_subset_mscE
      (resolve_strongly_atomic (resolve_skip_expr nIgnore unitV)
        (resolve_skip_strongly_atomic nIgnore unitV) p
        (natV (nat_sum reads)))
      (msc_read_now_timeless gam) (msc_inv_read_split H G gam a) opened

\lemma msc_read_resolve_unregistered_wp {S : gFunctors}
    (H : irisGS natCountable S) (p : ProphId)
    (resolves : List ProphPayload) (initial actual : Nat)
    (R : Value -> iProp S) :
  properUPred_ent
    (mkProperSep (proph H.iris_proph_map p resolves)
      (mkProperSep
        (mkProperPure (initial <= actual))
        (mkProperPure (nat_lt (msc_proph_total resolves) initial))))
    (wp H mscE
      (resolveProphE (Val (LitV (LitProphecy p))) (Val (natV actual)))
      R) =>
  \let
    | Token => proph H.iris_proph_map p resolves
    | Bounds => mkProperSep
        (mkProperPure {iResUR S} (initial <= actual))
        (mkProperPure (nat_lt (msc_proph_total resolves) initial))
    | Expr0 => resolveProphE (Val (LitV (LitProphecy p)))
        (Val (natV actual))
    | Base : Value -> iProp S => \lam returned =>
        mkProperExist (List ProphPayload) (\lam remaining =>
          mkProperSep
            (mkProperPure
              (\Sigma (returned = unitV)
                (resolves = (unitV, natV actual) :: remaining)))
            (proph H.iris_proph_map p remaining))
    | base : properUPred_ent Token (wp H mscE Expr0 Base) =>
        wp_resolve_skip H mscE nIgnore unitV p (natV actual) resolves
    | framed : properUPred_ent (mkProperSep Token Bounds)
        (wp H mscE Expr0 (wp_frame_post Base Bounds)) =>
        properUPred_ent_trans (mkProperSep Token Bounds)
          (mkProperSep (wp H mscE Expr0 Base) Bounds)
          (wp H mscE Expr0 (wp_frame_post Base Bounds))
          (sep_mono_l_ent Token (wp H mscE Expr0 Base) Bounds base)
          (wp_frame_r H mscE Expr0 Base Bounds)
    | impossible : \Pi (returned : Value) -> properUPred_ent
        (wp_frame_post Base Bounds returned) (R returned) =>
        \lam returned n x _ hs => \case hs \with {
          | inP (_, _, _, inP (remaining, hbody), hbounds) =>
            \case hbody \with {
              | inP (_, _, _, hpure, _) => \case hbounds \with {
                | inP (_, _, _, hinitialactual, hpredinitial) =>
                  \let
                    | predictedActual :
                        msc_proph_total resolves = actual =>
                        pmap msc_proph_total hpure.2
                        *> msc_proph_total_cons actual remaining
                    | actualInitial : nat_lt actual initial =>
                        transport (\lam z => nat_lt z initial)
                          predictedActual hpredinitial
                  \in absurd (not_suc_le_self actual
                    ((NatSemiring.<=∘) actualInitial hinitialactual))
              }
        }
      }
  \in properUPred_ent_trans (mkProperSep Token Bounds)
      (wp H mscE Expr0 (wp_frame_post Base Bounds))
      (wp H mscE Expr0 R) framed
      (wp_mono H mscE Expr0 (wp_frame_post Base Bounds)
        R impossible)

\func msc_read_core_post {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a : Nat) (Q : Nat -> iProp S)
    (v : Value) : iProp S =>
  mkProperExist Nat (\lam total =>
    mkProperSep (mkProperPure (v = natV total))
      (mkProperSep
        (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
          (msc_inv H G gam a))
        (Q total)))

\lemma msc_read_finish_sequence {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a actual : Nat) (Q : Nat -> iProp S)
    (ignored : Value) :
  properUPred_ent
    (mkProperSep
      (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a))
      (mkProperLater (Q actual)))
    (wp H mscE
      (App (Val (LamV nIgnore (Val (natV actual)))) (Val ignored))
      (msc_read_core_post H G gam a Q)) =>
  \let
    | Public => iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a)
    | Rafter => mkProperSep Public (Q actual)
    | Post => msc_read_core_post H G gam a Q
    | Source => mkProperSep Public (mkProperLater (Q actual))
    | LaterPair => mkProperLater Rafter
    | Ready => mkProperSep (mkProperEmp {iResUR S}) LaterPair
    | combine : properUPred_ent Source LaterPair =>
        properUPred_ent_trans Source
          (mkProperSep (mkProperLater Public) (mkProperLater (Q actual)))
          LaterPair
          (sep_mono_l_ent Public (mkProperLater Public)
            (mkProperLater (Q actual)) (proper_later_intro Public))
          (proper_later_sep_2 Public (Q actual))
    | prepare : properUPred_ent Source Ready =>
        properUPred_ent_trans Source LaterPair Ready combine
          ((BIuPredMixin (iResUR S)).bi_mixin_emp_sep_1 LaterPair)
    | makePost : properUPred_ent Rafter (Post (natV actual)) =>
        properUPred_ent_trans Rafter
          (mkProperSep
            (mkProperPure {iResUR S} (natV actual = natV actual)) Rafter)
          (Post (natV actual))
          (pure_intro_sep_ent (natV actual = natV actual) idp Rafter)
          (exist_intro_ent (\lam total =>
            mkProperSep (mkProperPure (natV actual = natV total))
              (mkProperSep Public (Q total))) actual)
    | transition : properUPred_ent Rafter
        (mkProperBUpd (Post (natV actual))) =>
        properUPred_ent_trans Rafter (Post (natV actual))
          (mkProperBUpd (Post (natV actual))) makePost
          (bupd_intro (Post (natV actual)))
  \in properUPred_ent_trans Source Ready
      (wp H mscE
        (App (Val (LamV nIgnore (Val (natV actual)))) (Val ignored)) Post)
      prepare
      (wp_lam_beta_value_later_frame H mscE nIgnore
        (natV actual) ignored Rafter Post transition)

\lemma msc_read_seq_bind {S : gFunctors}
    (H : irisGS natCountable S) (resolveExpr : Expr)
    (actual : Nat) (Post : Value -> iProp S) :
  properUPred_ent
    (wp H mscE resolveExpr (\lam ignored =>
      wp H mscE
        (App (Val (LamV nIgnore (Val (natV actual)))) (Val ignored)) Post))
    (wp H mscE (seqE resolveExpr (Val (natV actual))) Post) =>
  \let
    | LetLam => LamV nIgnore (Val (natV actual))
    | LetExpr => App (Val LetLam) resolveExpr
    | Bound => wp H mscE resolveExpr (\lam ignored =>
        wp H mscE (App (Val LetLam) (Val ignored)) Post)
    | valueLet : properUPred_ent Bound (wp H mscE LetExpr Post) =>
        wp_bind_app_r H mscE LetLam resolveExpr Post
    | surface : properUPred_ent (wp H mscE LetExpr Post)
        (wp H mscE (App (Lam nIgnore (Val (natV actual))) resolveExpr) Post) =>
        \let
          | LamPost : Value -> iProp S => \lam vf =>
              wp H mscE (App (Val vf) resolveExpr) Post
        \in properUPred_ent_trans (wp H mscE LetExpr Post)
            (wp H mscE (Val LetLam) LamPost)
            (wp H mscE
              (App (Lam nIgnore (Val (natV actual))) resolveExpr) Post)
            (wp_value_intro H mscE LetLam LamPost)
            (properUPred_ent_trans
              (wp H mscE (Val LetLam) LamPost)
              (wp H mscE (Lam nIgnore (Val (natV actual))) LamPost)
              (wp H mscE
                (App (Lam nIgnore (Val (natV actual))) resolveExpr) Post)
              (wp_lam_expr H mscE nIgnore (Val (natV actual)) LamPost)
              (wp_bind_app_l H mscE
                (Lam nIgnore (Val (natV actual))) resolveExpr Post))
  \in properUPred_ent_trans Bound (wp H mscE LetExpr Post)
      (wp H mscE (seqE resolveExpr (Val (natV actual))) Post)
      valueLet surface

\lemma msc_read_registered_sequence_wp {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a : Nat) (reads : List Nat)
    (gamQ : gname) (id : Nat) (Q : Nat -> iProp S)
    (p : ProphId) (resolves : List ProphPayload) :
  properUPred_ent
    (mkProperSep
      (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a))
      (mkProperSep
        (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
          (msc_inv H G gam a))
        (mkProperSep
          (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
          (mkProperSep (proph H.iris_proph_map p resolves)
            (mkProperSep
              (ghost_map_elem (msc_requestGS G gam) id
                (msc_proph_total resolves, gamQ))
              (msc_lbs G reads gam.msc_shard_names))))))
    (wp H mscE
      (seqE
        (resolveProphE (Val (LitV (LitProphecy p)))
          (Val (natV (nat_sum reads))))
        (Val (natV (nat_sum reads))))
      (msc_read_core_post H G gam a Q)) =>
  \let
    | Pre => mkProperSep
        (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
          (msc_inv H G gam a))
        (mkProperSep
          (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
            (msc_inv H G gam a))
          (mkProperSep
            (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
            (mkProperSep (proph H.iris_proph_map p resolves)
              (mkProperSep
                (ghost_map_elem (msc_requestGS G gam) id
                  (msc_proph_total resolves, gamQ))
                (msc_lbs G reads gam.msc_shard_names)))))
    | Public => iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a)
    | Resources => mkProperSep Public
        (mkProperLater (Q (nat_sum reads)))
    | ResolveExpr => resolveProphE (Val (LitV (LitProphecy p)))
        (Val (natV (nat_sum reads)))
    | Post => msc_read_core_post H G gam a Q
    | resolve : properUPred_ent Pre
        (wp H mscE ResolveExpr (\lam _ => Resources)) =>
        msc_read_resolve_registered_wp H G gam a reads gamQ id Q p resolves
    | continue : \Pi (ignored : Value) -> properUPred_ent Resources
        (wp H mscE
          (App (Val (LamV nIgnore (Val (natV (nat_sum reads)))))
            (Val ignored)) Post) =>
        \lam ignored => msc_read_finish_sequence H G gam a (nat_sum reads) Q ignored
    | bound : properUPred_ent Pre
        (wp H mscE ResolveExpr (\lam ignored =>
          wp H mscE
            (App (Val (LamV nIgnore (Val (natV (nat_sum reads)))))
              (Val ignored)) Post)) =>
        properUPred_ent_trans Pre
          (wp H mscE ResolveExpr (\lam _ => Resources))
          (wp H mscE ResolveExpr (\lam ignored =>
            wp H mscE
              (App (Val (LamV nIgnore (Val (natV (nat_sum reads)))))
                (Val ignored)) Post)) resolve
          (wp_mono H mscE ResolveExpr (\lam _ => Resources)
            (\lam ignored => wp H mscE
              (App (Val (LamV nIgnore (Val (natV (nat_sum reads)))))
                (Val ignored)) Post) continue)
  \in properUPred_ent_trans Pre
      (wp H mscE ResolveExpr (\lam ignored =>
        wp H mscE
          (App (Val (LamV nIgnore (Val (natV (nat_sum reads)))))
            (Val ignored)) Post))
      (wp H mscE
        (seqE ResolveExpr (Val (natV (nat_sum reads)))) Post) bound
      (msc_read_seq_bind H ResolveExpr (nat_sum reads) Post)

\lemma msc_read_unregistered_sequence_wp {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a initial actual : Nat)
    (Q : Nat -> iProp S) (p : ProphId)
    (resolves : List ProphPayload) :
  properUPred_ent
    (mkProperSep (proph H.iris_proph_map p resolves)
      (mkProperSep
        (mkProperPure (initial <= actual))
        (mkProperPure (nat_lt (msc_proph_total resolves) initial))))
    (wp H mscE
      (seqE
        (resolveProphE (Val (LitV (LitProphecy p)))
          (Val (natV actual)))
        (Val (natV actual)))
      (msc_read_core_post H G gam a Q)) =>
  \let
    | ResolveExpr => resolveProphE (Val (LitV (LitProphecy p)))
        (Val (natV actual))
    | Post => msc_read_core_post H G gam a Q
    | Continue : Value -> iProp S => \lam ignored =>
        wp H mscE
          (App (Val (LamV nIgnore (Val (natV actual)))) (Val ignored)) Post
    | resolve : properUPred_ent
        (mkProperSep (proph H.iris_proph_map p resolves)
          (mkProperSep
            (mkProperPure (initial <= actual))
            (mkProperPure (nat_lt (msc_proph_total resolves) initial))))
        (wp H mscE ResolveExpr Continue) =>
        msc_read_resolve_unregistered_wp H p resolves initial actual Continue
  \in properUPred_ent_trans
      (mkProperSep (proph H.iris_proph_map p resolves)
        (mkProperSep
          (mkProperPure (initial <= actual))
          (mkProperPure (nat_lt (msc_proph_total resolves) initial))))
      (wp H mscE ResolveExpr Continue)
      (wp H mscE (seqE ResolveExpr (Val (natV actual))) Post)
      resolve (msc_read_seq_bind H ResolveExpr actual Post)

\lemma sep_or_frame_elim_ent {M : UCMRA}
    (A B R Z : ProperUPred M)
    (left : properUPred_ent (mkProperSep A R) Z)
    (right : properUPred_ent (mkProperSep B R) Z) :
  properUPred_ent (mkProperSep (mkProperOr A B) R) Z =>
  \lam n x hv hs => \case hs \with {
    | inP (xa, xr, dx, byLeft ha, hr) =>
      left n x hv (inP (xa, xr, dx, ha, hr))
    | inP (xb, xr, dx, byRight hb, hr) =>
      right n x hv (inP (xb, xr, dx, hb, hr))
  }

-- Put the read-registration case in front of the resources retained by both
-- branches.  Keeping this permutation separate makes the semantic branch
-- proof below shallow enough for Arend's surface parser and elaborator.
\lemma msc_read_scan_case_front {M : UCMRA}
    (PB LBs Inv Saved Token Case : ProperUPred M) :
  properUPred_ent
    (mkProperSep (mkProperSep PB LBs)
      (mkProperSep Inv (mkProperSep Saved (mkProperSep Token Case))))
    (mkProperSep Case
      (mkProperSep Inv
        (mkProperSep Saved
          (mkProperSep Token (mkProperSep PB LBs))))) =>
  \let
    | Flat => mkProperSep PB (mkProperSep LBs
        (mkProperSep Inv (mkProperSep Saved (mkProperSep Token Case))))
    | CaseFifth => mkProperSep PB (mkProperSep LBs
        (mkProperSep Inv (mkProperSep Saved (mkProperSep Case Token))))
    | Front => mkProperSep Case (mkProperSep PB
        (mkProperSep LBs (mkProperSep Inv (mkProperSep Saved Token))))
    | R1 => mkProperSep Case (mkProperSep Inv
        (mkProperSep PB (mkProperSep LBs (mkProperSep Saved Token))))
    | R2 => mkProperSep Case (mkProperSep Inv
        (mkProperSep Saved (mkProperSep PB (mkProperSep LBs Token))))
    | Target => mkProperSep Case (mkProperSep Inv
        (mkProperSep Saved (mkProperSep Token (mkProperSep PB LBs))))
    | flatten : properUPred_ent
        (mkProperSep (mkProperSep PB LBs)
          (mkProperSep Inv (mkProperSep Saved (mkProperSep Token Case))))
        Flat => sep_assoc_l_ent PB LBs
          (mkProperSep Inv (mkProperSep Saved (mkProperSep Token Case)))
    | swapLast : properUPred_ent Flat CaseFifth =>
        sep_mono_r_ent PB
          (mkProperSep LBs
            (mkProperSep Inv (mkProperSep Saved (mkProperSep Token Case))))
          (mkProperSep LBs
            (mkProperSep Inv (mkProperSep Saved (mkProperSep Case Token))))
          (sep_mono_r_ent LBs
            (mkProperSep Inv (mkProperSep Saved (mkProperSep Token Case)))
            (mkProperSep Inv (mkProperSep Saved (mkProperSep Case Token)))
            (sep_mono_r_ent Inv
              (mkProperSep Saved (mkProperSep Token Case))
              (mkProperSep Saved (mkProperSep Case Token))
              (sep_mono_r_ent Saved (mkProperSep Token Case)
                (mkProperSep Case Token) (sep_comm_ent Token Case))))
    | moveCase : properUPred_ent CaseFifth Front =>
        sep_move_fifth_front PB LBs Inv Saved Case Token
    | moveInv : properUPred_ent Front R1 =>
        sep_mono_r_ent Case
          (mkProperSep PB
            (mkProperSep LBs (mkProperSep Inv (mkProperSep Saved Token))))
          (mkProperSep Inv
            (mkProperSep PB (mkProperSep LBs (mkProperSep Saved Token))))
          (sep_rotate_third_front PB LBs Inv (mkProperSep Saved Token))
    | moveSaved : properUPred_ent R1 R2 =>
        sep_mono_r_ent Case
          (mkProperSep Inv
            (mkProperSep PB (mkProperSep LBs (mkProperSep Saved Token))))
          (mkProperSep Inv
            (mkProperSep Saved (mkProperSep PB (mkProperSep LBs Token))))
          (sep_mono_r_ent Inv
            (mkProperSep PB (mkProperSep LBs (mkProperSep Saved Token)))
            (mkProperSep Saved (mkProperSep PB (mkProperSep LBs Token)))
            (sep_rotate_third_front PB LBs Saved Token))
    | moveToken : properUPred_ent R2 Target =>
        sep_mono_r_ent Case
          (mkProperSep Inv
            (mkProperSep Saved (mkProperSep PB (mkProperSep LBs Token))))
            (mkProperSep Inv
              (mkProperSep Saved (mkProperSep Token (mkProperSep PB LBs))))
          (sep_mono_r_ent Inv
            (mkProperSep Saved (mkProperSep PB (mkProperSep LBs Token)))
            (mkProperSep Saved (mkProperSep Token (mkProperSep PB LBs)))
            (sep_mono_r_ent Saved (mkProperSep PB (mkProperSep LBs Token))
              (mkProperSep Token (mkProperSep PB LBs))
              (properUPred_ent_trans
                (mkProperSep PB (mkProperSep LBs Token))
                (mkProperSep (mkProperSep PB LBs) Token)
                (mkProperSep Token (mkProperSep PB LBs))
                (sep_assoc_r_ent PB LBs Token)
                (sep_comm_ent (mkProperSep PB LBs) Token))))
  \in properUPred_ent_trans
      (mkProperSep (mkProperSep PB LBs)
        (mkProperSep Inv (mkProperSep Saved (mkProperSep Token Case))))
      Flat Target flatten
      (properUPred_ent_trans Flat CaseFifth Target swapLast
        (properUPred_ent_trans CaseFifth Front Target moveCase
          (properUPred_ent_trans Front R1 Target moveInv
            (properUPred_ent_trans R1 R2 Target moveSaved moveToken))))

\lemma msc_read_registered_scan_branch {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a initial : Nat)
    (reads : List Nat) (gamQ : gname) (Q : Nat -> iProp S)
    (p : ProphId) (resolves : List ProphPayload) :
  properUPred_ent
    (mkProperSep
      (msc_read_registered G gam (msc_proph_total resolves) initial gamQ)
      (mkProperSep
        (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
          (msc_inv H G gam a))
        (mkProperSep
          (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
          (mkProperSep (proph H.iris_proph_map p resolves)
            (mkProperSep (mkProperPure (initial <= nat_sum reads))
              (msc_lbs G reads gam.msc_shard_names))))))
    (wp H mscE
      (seqE
        (resolveProphE (Val (LitV (LitProphecy p)))
          (Val (natV (nat_sum reads))))
        (Val (natV (nat_sum reads))))
      (msc_read_core_post H G gam a Q)) =>
  \let
    | Inv => iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a)
    | Saved => saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q
    | Token => proph H.iris_proph_map p resolves
    | Bound => mkProperPure {iResUR S} (initial <= nat_sum reads)
    | LBs => msc_lbs G reads gam.msc_shard_names
    | Common => mkProperSep Inv
        (mkProperSep Saved (mkProperSep Token (mkProperSep Bound LBs)))
    | ElemF : Nat -> iProp S => \lam id =>
        ghost_map_elem (msc_requestGS G gam) id
          (msc_proph_total resolves, gamQ)
    | Elems => mkProperExist Nat ElemF
    | Registered => msc_read_registered G gam
        (msc_proph_total resolves) initial gamQ
    | Goal => wp H mscE
        (seqE
          (resolveProphE (Val (LitV (LitProphecy p)))
            (Val (natV (nat_sum reads))))
          (Val (natV (nat_sum reads))))
        (msc_read_core_post H G gam a Q)
    | stripPred : properUPred_ent Registered Elems =>
        pure_sep_l_elim (initial <= msc_proph_total resolves)
          Elems Elems (\lam _ => properUPred_ent_refl Elems)
    | expose : properUPred_ent (mkProperSep Registered Common)
        (mkProperSep Elems Common) =>
        sep_mono_l_ent Registered Elems Common stripPred
    | perId : \Pi (id : Nat) ->
        properUPred_ent (mkProperSep (ElemF id) Common) Goal =>
        \lam id =>
          \let
            | Elem => ElemF id
            | Inner0 => mkProperSep Elem
                (mkProperSep Inv
                  (mkProperSep Saved
                    (mkProperSep Token (mkProperSep Bound LBs))))
            | Inner1 => mkProperSep Elem
                (mkProperSep Inv
                  (mkProperSep Saved (mkProperSep Token LBs)))
            | Ordered => mkProperSep Inv
                (mkProperSep Elem (mkProperSep Saved (mkProperSep Token LBs)))
            | Inner => mkProperSep Saved
                (mkProperSep Token (mkProperSep Elem LBs))
            | Ready => mkProperSep Inv (mkProperSep Inv Inner)
            | dropBound : properUPred_ent Inner0 Inner1 =>
                sep_mono_r_ent Elem
                  (mkProperSep Inv
                    (mkProperSep Saved
                      (mkProperSep Token (mkProperSep Bound LBs))))
                  (mkProperSep Inv
                    (mkProperSep Saved (mkProperSep Token LBs)))
                  (sep_mono_r_ent Inv
                    (mkProperSep Saved
                      (mkProperSep Token (mkProperSep Bound LBs)))
                    (mkProperSep Saved (mkProperSep Token LBs))
                    (sep_mono_r_ent Saved
                      (mkProperSep Token (mkProperSep Bound LBs))
                      (mkProperSep Token LBs)
                      (sep_mono_r_ent Token (mkProperSep Bound LBs) LBs
                        (pure_sep_l_elim (initial <= nat_sum reads) LBs LBs
                          (\lam _ => properUPred_ent_refl LBs)))))
            | putInvFirst : properUPred_ent Inner1 Ordered =>
                sep_swap_ent Elem Inv
                  (mkProperSep Saved (mkProperSep Token LBs))
            | reorderInner : properUPred_ent
                (mkProperSep Elem (mkProperSep Saved (mkProperSep Token LBs)))
                Inner =>
                properUPred_ent_trans
                  (mkProperSep Elem (mkProperSep Saved (mkProperSep Token LBs)))
                  (mkProperSep Saved (mkProperSep Elem (mkProperSep Token LBs)))
                  Inner
                  (sep_swap_ent Elem Saved (mkProperSep Token LBs))
                  (sep_mono_r_ent Saved
                    (mkProperSep Elem (mkProperSep Token LBs))
                    (mkProperSep Token (mkProperSep Elem LBs))
                    (sep_swap_ent Elem Token LBs))
            | duplicate : properUPred_ent Ordered Ready =>
                properUPred_ent_trans Ordered
                  (mkProperSep Inv Inner) Ready
                  (sep_mono_r_ent Inv
                    (mkProperSep Elem (mkProperSep Saved (mkProperSep Token LBs)))
                    Inner reorderInner)
                  (properUPred_ent_trans (mkProperSep Inv Inner)
                    (mkProperSep (mkProperSep Inv Inv) Inner) Ready
                    (sep_mono_l_ent Inv (mkProperSep Inv Inv) Inner
                      (inv_dup_ent H.iris_wsat mscN (msc_inv H G gam a)))
                    (sep_assoc_l_ent Inv Inv Inner))
          \in properUPred_ent_trans Inner0 Inner1 Goal dropBound
              (properUPred_ent_trans Inner1 Ordered Goal putInvFirst
                (properUPred_ent_trans Ordered Ready Goal duplicate
                  (msc_read_registered_sequence_wp H G gam a reads gamQ id
                    Q p resolves)))
  \in properUPred_ent_trans (mkProperSep Registered Common)
      (mkProperSep Elems Common) Goal expose
      (sep_exist_l_elim ElemF Common Goal perId)

\lemma msc_read_unregistered_scan_branch {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a initial : Nat)
    (reads : List Nat) (gamQ : gname) (P : iProp S)
    (Q : Nat -> iProp S) (p : ProphId)
    (resolves : List ProphPayload) :
  properUPred_ent
    (mkProperSep
      (msc_read_unregistered (msc_proph_total resolves) initial P)
      (mkProperSep
        (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
          (msc_inv H G gam a))
        (mkProperSep
          (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
          (mkProperSep (proph H.iris_proph_map p resolves)
            (mkProperSep (mkProperPure (initial <= nat_sum reads))
              (msc_lbs G reads gam.msc_shard_names))))))
    (wp H mscE
      (seqE
        (resolveProphE (Val (LitV (LitProphecy p)))
          (Val (natV (nat_sum reads))))
        (Val (natV (nat_sum reads))))
      (msc_read_core_post H G gam a Q)) =>
  \let
    | Pred => mkProperPure {iResUR S}
        (nat_lt (msc_proph_total resolves) initial)
    | Token => proph H.iris_proph_map p resolves
    | Bound => mkProperPure {iResUR S} (initial <= nat_sum reads)
    | Inv => iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a)
    | Saved => saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q
    | LBs => msc_lbs G reads gam.msc_shard_names
    | Flat => mkProperSep Pred (mkProperSep P
        (mkProperSep Inv
          (mkProperSep Saved
            (mkProperSep Token (mkProperSep Bound LBs)))))
    | TokenFront => mkProperSep Token (mkProperSep Pred
        (mkProperSep P
          (mkProperSep Inv
            (mkProperSep Saved (mkProperSep Bound LBs)))))
    | BoundFront => mkProperSep Token (mkProperSep Bound
        (mkProperSep Pred
          (mkProperSep P (mkProperSep Inv (mkProperSep Saved LBs)))))
    | Ready => mkProperSep Token (mkProperSep Bound Pred)
    | Source => mkProperSep (mkProperSep Pred P)
        (mkProperSep Inv
          (mkProperSep Saved
            (mkProperSep Token (mkProperSep Bound LBs))))
    | flatten : properUPred_ent Source Flat =>
        sep_assoc_l_ent Pred P
          (mkProperSep Inv
            (mkProperSep Saved
              (mkProperSep Token (mkProperSep Bound LBs))))
    | moveToken : properUPred_ent Flat TokenFront =>
        sep_move_fifth_front Pred P Inv Saved Token
          (mkProperSep Bound LBs)
    | moveBound : properUPred_ent TokenFront BoundFront =>
        sep_mono_r_ent Token
          (mkProperSep Pred
            (mkProperSep P
              (mkProperSep Inv (mkProperSep Saved (mkProperSep Bound LBs)))))
          (mkProperSep Bound
            (mkProperSep Pred
              (mkProperSep P (mkProperSep Inv (mkProperSep Saved LBs)))))
          (sep_move_fifth_front Pred P Inv Saved Bound LBs)
    | discard : properUPred_ent BoundFront Ready =>
        sep_mono_r_ent Token
          (mkProperSep Bound
            (mkProperSep Pred
              (mkProperSep P (mkProperSep Inv (mkProperSep Saved LBs)))))
          (mkProperSep Bound Pred)
          (sep_mono_r_ent Bound
            (mkProperSep Pred
              (mkProperSep P (mkProperSep Inv (mkProperSep Saved LBs))))
            Pred
            (sep_elim_l_ent Pred
              (mkProperSep P (mkProperSep Inv (mkProperSep Saved LBs)))))
  \in properUPred_ent_trans Source Flat
      (wp H mscE
        (seqE
          (resolveProphE (Val (LitV (LitProphecy p)))
            (Val (natV (nat_sum reads))))
          (Val (natV (nat_sum reads))))
        (msc_read_core_post H G gam a Q)) flatten
      (properUPred_ent_trans Flat TokenFront
        (wp H mscE
          (seqE
            (resolveProphE (Val (LitV (LitProphecy p)))
              (Val (natV (nat_sum reads))))
            (Val (natV (nat_sum reads))))
          (msc_read_core_post H G gam a Q)) moveToken
        (properUPred_ent_trans TokenFront BoundFront
          (wp H mscE
            (seqE
              (resolveProphE (Val (LitV (LitProphecy p)))
                (Val (natV (nat_sum reads))))
              (Val (natV (nat_sum reads))))
            (msc_read_core_post H G gam a Q)) moveBound
          (properUPred_ent_trans BoundFront Ready
            (wp H mscE
              (seqE
                (resolveProphE (Val (LitV (LitProphecy p)))
                  (Val (natV (nat_sum reads))))
                (Val (natV (nat_sum reads))))
              (msc_read_core_post H G gam a Q)) discard
            (msc_read_unregistered_sequence_wp H G gam a initial
              (nat_sum reads) Q p resolves))))

\lemma msc_read_after_scan_wp {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (a : Nat) (w : msc_read_witness gam) (gamQ : gname)
    (P : iProp S) (Q : Nat -> iProp S)
    (p : ProphId) (resolves : List ProphPayload) (v : Value) :
  properUPred_ent
    (msc_read_scan_post H G gam a w gamQ P Q p resolves v)
    (wp H mscE
      (seqE
        (resolveProphE (Val (LitV (LitProphecy p))) (Val v))
        (Val v))
      (msc_read_core_post H G gam a Q)) =>
  \let
    | Inv => iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a)
    | Saved => saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q
    | Token => proph H.iris_proph_map p resolves
    | Case => msc_read_case G gam (msc_proph_total resolves)
        (nat_sum w.read_initial) gamQ P
    | Rest => mkProperSep Saved (mkProperSep Token Case)
    | ReadsBody : List Nat -> iProp S => \lam reads =>
        mkProperSep
          (mkProperPure (v = natV (nat_sum reads)))
          (mkProperSep
            (mkProperPure (length reads = length gam.msc_shard_names))
            (mkProperSep
              (mkProperPure
                (nat_sum w.read_initial <= nat_sum reads))
              (msc_lbs G reads gam.msc_shard_names)))
    | Reads => mkProperExist (List Nat) ReadsBody
    | Source => mkProperSep (mkProperSep Inv Reads) Rest
    | Exposed => mkProperSep Reads (mkProperSep Inv Rest)
    | Goal : Value -> iProp S => \lam result =>
        wp H mscE
          (seqE
            (resolveProphE (Val (LitV (LitProphecy p))) (Val result))
            (Val result))
          (msc_read_core_post H G gam a Q)
    | expose : properUPred_ent Source Exposed =>
        properUPred_ent_trans Source
          (mkProperSep Inv (mkProperSep Reads Rest)) Exposed
          (sep_assoc_l_ent Inv Reads Rest)
          (sep_swap_ent Inv Reads Rest)
    | perReads : \Pi (reads : List Nat) -> properUPred_ent
        (mkProperSep (ReadsBody reads) (mkProperSep Inv Rest)) (Goal v) =>
        \lam reads =>
          \let
            | PV => mkProperPure {iResUR S}
                (v = natV (nat_sum reads))
            | PL => mkProperPure {iResUR S}
                (length reads = length gam.msc_shard_names)
            | PB => mkProperPure {iResUR S}
                (nat_sum w.read_initial <= nat_sum reads)
            | LBs => msc_lbs G reads gam.msc_shard_names
            | Tail => mkProperSep PL (mkProperSep PB LBs)
            | R => mkProperSep Inv Rest
            | WithoutValue => mkProperSep Tail R
            | WithoutLength => mkProperSep (mkProperSep PB LBs) R
            | Common => mkProperSep Inv
                (mkProperSep Saved
                  (mkProperSep Token (mkProperSep PB LBs)))
            | CaseFront => mkProperSep Case Common
            | Concrete => Goal (natV (nat_sum reads))
            | dropLength : properUPred_ent WithoutValue WithoutLength =>
                properUPred_ent_trans WithoutValue
                  (mkProperSep PL (mkProperSep (mkProperSep PB LBs) R))
                  WithoutLength
                  (sep_assoc_l_ent PL (mkProperSep PB LBs) R)
                  (pure_sep_l_elim
                    (length reads = length gam.msc_shard_names)
                    WithoutLength WithoutLength
                    (\lam _ => properUPred_ent_refl WithoutLength))
            | caseFront : properUPred_ent WithoutLength CaseFront =>
                msc_read_scan_case_front PB LBs Inv Saved Token Case
            | registered : properUPred_ent
                (mkProperSep
                  (msc_read_registered G gam (msc_proph_total resolves)
                    (nat_sum w.read_initial) gamQ) Common)
                Concrete =>
                msc_read_registered_scan_branch H G gam a
                  (nat_sum w.read_initial) reads gamQ Q p resolves
            | unregistered : properUPred_ent
                (mkProperSep
                  (msc_read_unregistered (msc_proph_total resolves)
                    (nat_sum w.read_initial) P) Common)
                Concrete =>
                msc_read_unregistered_scan_branch H G gam a
                  (nat_sum w.read_initial) reads gamQ P Q p resolves
            | branch : properUPred_ent CaseFront Concrete =>
                sep_or_frame_elim_ent
                  (msc_read_registered G gam (msc_proph_total resolves)
                    (nat_sum w.read_initial) gamQ)
                  (msc_read_unregistered (msc_proph_total resolves)
                    (nat_sum w.read_initial) P)
                  Common Concrete registered unregistered
            | afterValue : properUPred_ent
                (mkProperSep PV WithoutValue) (Goal v) =>
                pure_sep_l_elim (v = natV (nat_sum reads))
                  WithoutValue (Goal v) (\lam valueEq =>
                    transport (\lam z => properUPred_ent WithoutValue (Goal z))
                      (Paths.inv valueEq)
                      (properUPred_ent_trans WithoutValue WithoutLength
                        Concrete dropLength
                        (properUPred_ent_trans WithoutLength CaseFront
                          Concrete caseFront branch)))
          \in properUPred_ent_trans
              (mkProperSep (ReadsBody reads) R)
              (mkProperSep PV WithoutValue) (Goal v)
              (sep_assoc_l_ent PV Tail R) afterValue
  \in properUPred_ent_trans Source Exposed (Goal v) expose
      (sep_exist_l_elim ReadsBody (mkProperSep Inv Rest) (Goal v) perReads)

\lemma msc_read_scan_bound_wp {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (a : Nat) (w : msc_read_witness gam) (gamQ : gname)
    (P : iProp S) (Q : Nat -> iProp S)
    (p : ProphId) (resolves : List ProphPayload) :
  properUPred_ent
    (mkProperSep
      (mkProperSep
        (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
          (msc_inv H G gam a))
        (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q))
      (mkProperSep
        (mkProperPure
          (LitV (LitProphecy p) = LitV (LitProphecy p)))
        (mkProperSep
          (mkProperSep (proph H.iris_proph_map p resolves)
            (msc_lbs G w.read_initial gam.msc_shard_names))
          (msc_read_case G gam (msc_proph_total resolves)
            (nat_sum w.read_initial) gamQ P))))
    (wp H mscE
      (letE nR
        (app4 (Val msc_sum_loop)
          (Val (LitV (LitLoc a))) (Val (natV gam.msc_size))
          (Val (natV 0)) (Val (natV 0)))
        (seqE
          (resolveProphE (Val (LitV (LitProphecy p))) (Var nR))
          (Var nR)))
      (msc_read_core_post H G gam a Q)) =>
  \let
    | Call => app4 (Val msc_sum_loop)
        (Val (LitV (LitLoc a))) (Val (natV gam.msc_size))
        (Val (natV 0)) (Val (natV 0))
    | Body => seqE
        (resolveProphE (Val (LitV (LitProphecy p))) (Var nR))
        (Var nR)
    | Post => msc_read_core_post H G gam a Q
    | ScanPost => msc_read_scan_post H G gam a w gamQ P Q p resolves
    | scan : properUPred_ent
        (mkProperSep
          (mkProperSep
            (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
              (msc_inv H G gam a))
            (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q))
          (mkProperSep
            (mkProperPure
              (LitV (LitProphecy p) = LitV (LitProphecy p)))
            (mkProperSep
              (mkProperSep (proph H.iris_proph_map p resolves)
                (msc_lbs G w.read_initial gam.msc_shard_names))
              (msc_read_case G gam (msc_proph_total resolves)
                (nat_sum w.read_initial) gamQ P))))
        (wp H mscE Call ScanPost) =>
        msc_read_scan_wp H G gam a w gamQ P Q p resolves
    | continue : \Pi (result : Value) -> properUPred_ent
        (ScanPost result)
        (wp H mscE (subst nR result Body) Post) =>
        \lam result => msc_read_after_scan_wp H G gam a w gamQ P Q p
          resolves result
    | scanned : properUPred_ent
        (mkProperSep
          (mkProperSep
            (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
              (msc_inv H G gam a))
            (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q))
          (mkProperSep
            (mkProperPure
              (LitV (LitProphecy p) = LitV (LitProphecy p)))
            (mkProperSep
              (mkProperSep (proph H.iris_proph_map p resolves)
                (msc_lbs G w.read_initial gam.msc_shard_names))
              (msc_read_case G gam (msc_proph_total resolves)
                (nat_sum w.read_initial) gamQ P))))
        (wp H mscE Call (\lam result =>
          wp H mscE (subst nR result Body) Post)) =>
        properUPred_ent_trans
          (mkProperSep
            (mkProperSep
              (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
                (msc_inv H G gam a))
              (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q))
            (mkProperSep
              (mkProperPure
                (LitV (LitProphecy p) = LitV (LitProphecy p)))
              (mkProperSep
                (mkProperSep (proph H.iris_proph_map p resolves)
                  (msc_lbs G w.read_initial gam.msc_shard_names))
                (msc_read_case G gam (msc_proph_total resolves)
                  (nat_sum w.read_initial) gamQ P))))
          (wp H mscE Call ScanPost)
          (wp H mscE Call (\lam result =>
            wp H mscE (subst nR result Body) Post)) scan
          (wp_mono H mscE Call ScanPost
            (\lam result => wp H mscE (subst nR result Body) Post) continue)
  \in properUPred_ent_trans
      (mkProperSep
        (mkProperSep
          (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
            (msc_inv H G gam a))
          (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q))
        (mkProperSep
          (mkProperPure
            (LitV (LitProphecy p) = LitV (LitProphecy p)))
          (mkProperSep
            (mkProperSep (proph H.iris_proph_map p resolves)
              (msc_lbs G w.read_initial gam.msc_shard_names))
            (msc_read_case G gam (msc_proph_total resolves)
              (nat_sum w.read_initial) gamQ P))))
      (wp H mscE Call (\lam result =>
        wp H mscE (subst nR result Body) Post))
      (wp H mscE (letE nR Call Body) Post) scanned
      (wp_letE H mscE nR Call Body Post)

\lemma msc_read_prepared_scan_wp {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (a : Nat) (w : msc_read_witness gam) (gamQ : gname)
    (P : iProp S) (Q : Nat -> iProp S) (prophValue : Value) :
  properUPred_ent
    (msc_read_prepared H G gam a w gamQ P Q prophValue)
    (wp H mscE
      (letE nR
        (app4 (Val msc_sum_loop)
          (Val (LitV (LitLoc a))) (Val (natV gam.msc_size))
          (Val (natV 0)) (Val (natV 0)))
        (seqE
          (resolveProphE (Val prophValue) (Var nR))
          (Var nR)))
      (msc_read_core_post H G gam a Q)) =>
  \let
    | ProphBody : ProphId -> iProp S => \lam p =>
        mkProperExist (List ProphPayload) (\lam resolves =>
          mkProperSep
            (mkProperSep
              (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
                (msc_inv H G gam a))
              (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q))
            (mkProperSep
              (mkProperPure (prophValue = LitV (LitProphecy p)))
              (mkProperSep
                (mkProperSep (proph H.iris_proph_map p resolves)
                  (msc_lbs G w.read_initial gam.msc_shard_names))
                (msc_read_case G gam (msc_proph_total resolves)
                  (nat_sum w.read_initial) gamQ P))))
    | Goal : Value -> iProp S => \lam pv =>
        wp H mscE
          (letE nR
            (app4 (Val msc_sum_loop)
              (Val (LitV (LitLoc a))) (Val (natV gam.msc_size))
              (Val (natV 0)) (Val (natV 0)))
            (seqE (resolveProphE (Val pv) (Var nR)) (Var nR)))
          (msc_read_core_post H G gam a Q)
    | perP : \Pi (p : ProphId) -> properUPred_ent (ProphBody p)
        (Goal prophValue) =>
        \lam p => exist_elim_ent (\lam resolves =>
          mkProperSep
            (mkProperSep
              (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
                (msc_inv H G gam a))
              (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q))
            (mkProperSep
              (mkProperPure (prophValue = LitV (LitProphecy p)))
              (mkProperSep
                (mkProperSep (proph H.iris_proph_map p resolves)
                  (msc_lbs G w.read_initial gam.msc_shard_names))
                (msc_read_case G gam (msc_proph_total resolves)
                  (nat_sum w.read_initial) gamQ P))))
          (Goal prophValue) (\lam resolves =>
            \let
              | Head => mkProperSep
                  (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
                    (msc_inv H G gam a))
                  (saved_pred_own G.msc_saved_predG gamQ DfracDiscarded Q)
              | EqV => mkProperPure {iResUR S}
                  (prophValue = LitV (LitProphecy p))
              | Tail => mkProperSep
                  (mkProperSep (proph H.iris_proph_map p resolves)
                    (msc_lbs G w.read_initial gam.msc_shard_names))
                  (msc_read_case G gam (msc_proph_total resolves)
                    (nat_sum w.read_initial) gamQ P)
              | Source => mkProperSep Head (mkProperSep EqV Tail)
              | EqFront => mkProperSep EqV (mkProperSep Head Tail)
              | Spatial => mkProperSep Head Tail
              | Reflexive => mkProperPure {iResUR S}
                  (LitV (LitProphecy p) = LitV (LitProphecy p))
              | ConcretePre => mkProperSep Head
                  (mkProperSep Reflexive Tail)
              | concrete : properUPred_ent ConcretePre
                  (Goal (LitV (LitProphecy p))) =>
                  msc_read_scan_bound_wp H G gam a w gamQ P Q p resolves
              | prepare : properUPred_ent Spatial ConcretePre =>
                  sep_mono_r_ent Head Tail (mkProperSep Reflexive Tail)
                    (pure_intro_sep_ent
                      (LitV (LitProphecy p) = LitV (LitProphecy p)) idp Tail)
              | afterEq : prophValue = LitV (LitProphecy p) ->
                  properUPred_ent Spatial (Goal prophValue) =>
                  \lam valueEq => transport
                    (\lam z => properUPred_ent Spatial (Goal z))
                    (Paths.inv valueEq)
                    (properUPred_ent_trans Spatial ConcretePre
                      (Goal (LitV (LitProphecy p))) prepare concrete)
            \in properUPred_ent_trans Source EqFront
                (Goal prophValue)
                (sep_swap_ent Head EqV Tail)
                (pure_sep_l_elim
                  (prophValue = LitV (LitProphecy p)) Spatial
                  (Goal prophValue) afterEq))
  \in exist_elim_ent ProphBody (Goal prophValue) perP

\lemma msc_read_size_let_wp {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (a : Nat) (w : msc_read_witness gam) (gamQ : gname)
    (P : iProp S) (Q : Nat -> iProp S) (prophValue : Value) :
  properUPred_ent
    (msc_read_prepared H G gam a w gamQ P Q prophValue)
    (wp H mscE
      (letE nT
        (Snd (Val
          (PairV (LitV (LitLoc a)) (natV gam.msc_size))))
        (letE nR
          (app4 (Val msc_sum_loop)
            (Val (LitV (LitLoc a))) (Var nT)
            (Val (natV 0)) (Val (natV 0)))
          (seqE (resolveProphE (Val prophValue) (Var nR)) (Var nR))))
      (msc_read_core_post H G gam a Q)) =>
  \let
    | CounterV => PairV (LitV (LitLoc a)) (natV gam.msc_size)
    | Body => letE nR
        (app4 (Val msc_sum_loop)
          (Val (LitV (LitLoc a))) (Var nT)
          (Val (natV 0)) (Val (natV 0)))
        (seqE (resolveProphE (Val prophValue) (Var nR)) (Var nR))
    | Post => msc_read_core_post H G gam a Q
    | PhiT : Value -> iProp S => \lam sizeValue =>
        wp H mscE (subst nT sizeValue Body) Post
    | atSize : properUPred_ent
        (msc_read_prepared H G gam a w gamQ P Q prophValue)
        (PhiT (natV gam.msc_size)) =>
        msc_read_prepared_scan_wp H G gam a w gamQ P Q prophValue
    | sizeValue : properUPred_ent
        (msc_read_prepared H G gam a w gamQ P Q prophValue)
        (wp H mscE (Val (natV gam.msc_size)) PhiT) =>
        properUPred_ent_trans
          (msc_read_prepared H G gam a w gamQ P Q prophValue)
          (PhiT (natV gam.msc_size))
          (wp H mscE (Val (natV gam.msc_size)) PhiT) atSize
          (wp_value_intro H mscE (natV gam.msc_size) PhiT)
    | sizeRead : properUPred_ent
        (msc_read_prepared H G gam a w gamQ P Q prophValue)
        (wp H mscE (Snd (Val CounterV)) PhiT) =>
        properUPred_ent_trans
          (msc_read_prepared H G gam a w gamQ P Q prophValue)
          (wp H mscE (Val (natV gam.msc_size)) PhiT)
          (wp H mscE (Snd (Val CounterV)) PhiT) sizeValue
          (wp_snd_pair H mscE (LitV (LitLoc a))
            (natV gam.msc_size) PhiT)
  \in properUPred_ent_trans
      (msc_read_prepared H G gam a w gamQ P Q prophValue)
      (wp H mscE (Snd (Val CounterV)) PhiT)
      (wp H mscE (letE nT (Snd (Val CounterV)) Body) Post)
      sizeRead (wp_letE H mscE nT (Snd (Val CounterV)) Body Post)

\lemma msc_read_fields_wp {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (a : Nat) (w : msc_read_witness gam) (gamQ : gname)
    (P : iProp S) (Q : Nat -> iProp S) (prophValue : Value) :
  properUPred_ent
    (msc_read_prepared H G gam a w gamQ P Q prophValue)
    (wp H mscE
      (letE nA
        (Fst (Val
          (PairV (LitV (LitLoc a)) (natV gam.msc_size))))
        (letE nT
          (Snd (Val
            (PairV (LitV (LitLoc a)) (natV gam.msc_size))))
          (letE nR
            (app4 (Val msc_sum_loop)
              (Var nA) (Var nT) (Val (natV 0)) (Val (natV 0)))
            (seqE
              (resolveProphE (Val prophValue) (Var nR))
              (Var nR)))))
      (msc_read_core_post H G gam a Q)) =>
  \let
    | CounterV => PairV (LitV (LitLoc a)) (natV gam.msc_size)
    | Body => letE nT (Snd (Val CounterV))
        (letE nR
          (app4 (Val msc_sum_loop)
            (Var nA) (Var nT) (Val (natV 0)) (Val (natV 0)))
          (seqE (resolveProphE (Val prophValue) (Var nR)) (Var nR)))
    | Post => msc_read_core_post H G gam a Q
    | PhiA : Value -> iProp S => \lam addressValue =>
        wp H mscE (subst nA addressValue Body) Post
    | atAddress : properUPred_ent
        (msc_read_prepared H G gam a w gamQ P Q prophValue)
        (PhiA (LitV (LitLoc a))) =>
        msc_read_size_let_wp H G gam a w gamQ P Q prophValue
    | addressValue : properUPred_ent
        (msc_read_prepared H G gam a w gamQ P Q prophValue)
        (wp H mscE (Val (LitV (LitLoc a))) PhiA) =>
        properUPred_ent_trans
          (msc_read_prepared H G gam a w gamQ P Q prophValue)
          (PhiA (LitV (LitLoc a)))
          (wp H mscE (Val (LitV (LitLoc a))) PhiA) atAddress
          (wp_value_intro H mscE (LitV (LitLoc a)) PhiA)
    | addressRead : properUPred_ent
        (msc_read_prepared H G gam a w gamQ P Q prophValue)
        (wp H mscE (Fst (Val CounterV)) PhiA) =>
        properUPred_ent_trans
          (msc_read_prepared H G gam a w gamQ P Q prophValue)
          (wp H mscE (Val (LitV (LitLoc a))) PhiA)
          (wp H mscE (Fst (Val CounterV)) PhiA) addressValue
          (wp_fst_pair H mscE (LitV (LitLoc a))
            (natV gam.msc_size) PhiA)
  \in properUPred_ent_trans
      (msc_read_prepared H G gam a w gamQ P Q prophValue)
      (wp H mscE (Fst (Val CounterV)) PhiA)
      (wp H mscE (letE nA (Fst (Val CounterV)) Body) Post)
      addressRead (wp_letE H mscE nA (Fst (Val CounterV)) Body Post)

\lemma msc_read_after_new_wp {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (a : Nat) (P : iProp S) (Q : Nat -> iProp S)
    (prophValue : Value) :
  properUPred_ent
    (msc_read_new_post H G gam a P Q prophValue)
    (wp H mscE
      (letE nA
        (Fst (Val
          (PairV (LitV (LitLoc a)) (natV gam.msc_size))))
        (letE nT
          (Snd (Val
            (PairV (LitV (LitLoc a)) (natV gam.msc_size))))
          (letE nR
            (app4 (Val msc_sum_loop)
              (Var nA) (Var nT) (Val (natV 0)) (Val (natV 0)))
            (seqE
              (resolveProphE (Val prophValue) (Var nR))
              (Var nR)))))
      (msc_read_core_post H G gam a Q)) =>
  \let
    | Goal => wp H mscE
        (letE nA
          (Fst (Val
            (PairV (LitV (LitLoc a)) (natV gam.msc_size))))
          (letE nT
            (Snd (Val
              (PairV (LitV (LitLoc a)) (natV gam.msc_size))))
            (letE nR
              (app4 (Val msc_sum_loop)
                (Var nA) (Var nT) (Val (natV 0)) (Val (natV 0)))
              (seqE
                (resolveProphE (Val prophValue) (Var nR))
                (Var nR)))))
        (msc_read_core_post H G gam a Q)
    | SavedBody : gname -> iProp S => \lam gamQ =>
        mkProperExist (msc_read_witness gam) (\lam w =>
          msc_read_prepared H G gam a w gamQ P Q prophValue)
    | perSaved : \Pi (gamQ : gname) -> properUPred_ent
        (SavedBody gamQ) Goal =>
        \lam gamQ => exist_elim_ent (\lam w =>
          msc_read_prepared H G gam a w gamQ P Q prophValue) Goal
          (\lam w => msc_read_fields_wp H G gam a w gamQ P Q prophValue)
  \in exist_elim_ent SavedBody Goal perSaved

\lemma msc_read_body_wp {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (a : Nat) (P : iProp S) (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep
      (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a))
      (mkProperSep (msc_read_shift H G gam P Q) P))
    (wp H mscE
      (letE nP NewProph
        (letE nA
          (Fst (Val
            (PairV (LitV (LitLoc a)) (natV gam.msc_size))))
          (letE nT
            (Snd (Val
              (PairV (LitV (LitLoc a)) (natV gam.msc_size))))
            (letE nR
              (app4 (Val msc_sum_loop)
                (Var nA) (Var nT) (Val (natV 0)) (Val (natV 0)))
              (seqE
                (resolveProphE (Var nP) (Var nR))
                (Var nR))))))
      (msc_read_core_post H G gam a Q)) =>
  \let
    | Pre => mkProperSep
        (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
          (msc_inv H G gam a))
        (mkProperSep (msc_read_shift H G gam P Q) P)
    | Body => letE nA
        (Fst (Val
          (PairV (LitV (LitLoc a)) (natV gam.msc_size))))
        (letE nT
          (Snd (Val
            (PairV (LitV (LitLoc a)) (natV gam.msc_size))))
          (letE nR
            (app4 (Val msc_sum_loop)
              (Var nA) (Var nT) (Val (natV 0)) (Val (natV 0)))
            (seqE (resolveProphE (Var nP) (Var nR)) (Var nR))))
    | Post => msc_read_core_post H G gam a Q
    | NewPost => msc_read_new_post H G gam a P Q
    | start : properUPred_ent Pre (wp H mscE NewProph NewPost) =>
        msc_read_start_new H G gam a P Q
    | continue : \Pi (prophValue : Value) -> properUPred_ent
        (NewPost prophValue)
        (wp H mscE (subst nP prophValue Body) Post) =>
        \lam prophValue => msc_read_after_new_wp H G gam a P Q prophValue
    | newThenBody : properUPred_ent Pre
        (wp H mscE NewProph (\lam prophValue =>
          wp H mscE (subst nP prophValue Body) Post)) =>
        properUPred_ent_trans Pre (wp H mscE NewProph NewPost)
          (wp H mscE NewProph (\lam prophValue =>
            wp H mscE (subst nP prophValue Body) Post)) start
          (wp_mono H mscE NewProph NewPost
            (\lam prophValue => wp H mscE (subst nP prophValue Body) Post)
            continue)
  \in properUPred_ent_trans Pre
      (wp H mscE NewProph (\lam prophValue =>
        wp H mscE (subst nP prophValue Body) Post))
      (wp H mscE (letE nP NewProph Body) Post) newThenBody
      (wp_letE H mscE nP NewProph Body Post)

\lemma msc_read_specialized_wp {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (a : Nat) (P : iProp S) (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep
      (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a))
      (mkProperSep (msc_read_shift H G gam P Q) P))
    (wp H mscE
      (App (Val msc_read)
        (Val (PairV (LitV (LitLoc a)) (natV gam.msc_size))))
      (msc_read_core_post H G gam a Q)) =>
  \let
    | Pre => mkProperSep
        (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
          (msc_inv H G gam a))
        (mkProperSep (msc_read_shift H G gam P Q) P)
    | CounterV => PairV (LitV (LitLoc a)) (natV gam.msc_size)
    | Body => letE nP NewProph
        (letE nA (Fst (Var nC))
          (letE nT (Snd (Var nC))
            (letE nR
              (app4 (Val msc_sum_loop)
                (Var nA) (Var nT) (Val (natV 0)) (Val (natV 0)))
              (seqE
                (resolveProphE (Var nP) (Var nR))
                (Var nR)))))
    | Post => msc_read_core_post H G gam a Q
    | body : properUPred_ent Pre
        (wp H mscE (subst nC CounterV Body) Post) =>
        msc_read_body_wp H G gam a P Q
  \in properUPred_ent_trans Pre
      (wp H mscE (subst nC CounterV Body) Post)
      (wp H mscE (App (Val msc_read) (Val CounterV)) Post) body
      (wp_lam_beta H mscE nC Body CounterV Post)

\func msc_read_post {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (c : Value) (Q : Nat -> iProp S) (v : Value) : iProp S =>
  mkProperExist Nat (\lam total =>
    mkProperSep (mkProperPure (v = natV total))
      (mkProperSep (msc_is_counter H G gam c) (Q total)))

\lemma msc_read_post_frame {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (a : Nat) (c : Value) (Q : Nat -> iProp S) (v : Value) :
  properUPred_ent
    (mkProperSep (msc_read_core_post H G gam a Q v)
      (msc_is_counter H G gam c))
    (msc_read_post H G gam c Q v) =>
  \let
    | Public => msc_is_counter H G gam c
    | Body : Nat -> iProp S => \lam total =>
        mkProperSep (mkProperPure (v = natV total))
          (mkProperSep
            (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
              (msc_inv H G gam a))
            (Q total))
    | Goal => msc_read_post H G gam c Q v
    | perTotal : \Pi (total : Nat) -> properUPred_ent
        (mkProperSep (Body total) Public) Goal =>
        \lam total =>
          \let
            | PureV => mkProperPure {iResUR S} (v = natV total)
            | Inv => iris.base_logic.lib.invariants.inv H.iris_wsat mscN
                (msc_inv H G gam a)
            | QT => Q total
            | TargetBody => mkProperSep PureV (mkProperSep Public QT)
            | arrange : properUPred_ent
                (mkProperSep (mkProperSep PureV (mkProperSep Inv QT)) Public)
                TargetBody =>
                properUPred_ent_trans
                  (mkProperSep (mkProperSep PureV (mkProperSep Inv QT)) Public)
                  (mkProperSep PureV
                    (mkProperSep (mkProperSep Inv QT) Public)) TargetBody
                  (sep_assoc_l_ent PureV (mkProperSep Inv QT) Public)
                  (sep_mono_r_ent PureV
                    (mkProperSep (mkProperSep Inv QT) Public)
                    (mkProperSep Public QT)
                    (properUPred_ent_trans
                      (mkProperSep (mkProperSep Inv QT) Public)
                      (mkProperSep Public (mkProperSep Inv QT))
                      (mkProperSep Public QT)
                      (sep_comm_ent (mkProperSep Inv QT) Public)
                      (sep_mono_r_ent Public (mkProperSep Inv QT) QT
                        (sep_elim_r_ent Inv QT))))
          \in properUPred_ent_trans
              (mkProperSep (Body total) Public) TargetBody Goal arrange
              (exist_intro_ent (\lam total0 =>
                mkProperSep (mkProperPure (v = natV total0))
                  (mkProperSep Public (Q total0))) total)
  \in sep_exist_l_elim Body Public Goal perTotal

\lemma msc_read_prepare_public {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (c : Value) (P : iProp S) (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep (msc_read_shift H G gam P Q)
      (mkProperSep (msc_is_counter H G gam c) P))
    (mkProperSep (msc_is_counter H G gam c)
      (mkProperSep (msc_read_shift H G gam P Q)
        (mkProperSep P (msc_is_counter H G gam c)))) =>
  \let
    | Shift => msc_read_shift H G gam P Q
    | Public => msc_is_counter H G gam c
    | Source => mkProperSep Shift (mkProperSep Public P)
    | WithCopy => mkProperSep Source Public
    | A1 => mkProperSep Shift
        (mkProperSep (mkProperSep Public P) Public)
    | A2 => mkProperSep Shift
        (mkProperSep Public (mkProperSep P Public))
    | Target => mkProperSep Public
        (mkProperSep Shift (mkProperSep P Public))
    | sourceToPublic : properUPred_ent Source Public =>
        properUPred_ent_trans Source (mkProperSep Public P) Public
          (sep_elim_r_ent Shift (mkProperSep Public P))
          (sep_elim_l_ent Public P)
    | copy : properUPred_ent Source WithCopy =>
        persistent_consequence_frame_ent Source Public
          (properUPred_ent_trans Source Public
            (mkProperPersistently Public) sourceToPublic
            (msc_is_counter_persistent H G gam c))
  \in properUPred_ent_trans Source WithCopy Target copy
      (properUPred_ent_trans WithCopy A1 Target
        (sep_assoc_l_ent Shift (mkProperSep Public P) Public)
        (properUPred_ent_trans A1 A2 Target
          (sep_mono_r_ent Shift
            (mkProperSep (mkProperSep Public P) Public)
            (mkProperSep Public (mkProperSep P Public))
            (sep_assoc_l_ent Public P Public))
          (sep_swap_ent Shift Public (mkProperSep P Public))))

\lemma msc_read_spec {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (c : Value) (P : iProp S) (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep (msc_read_shift H G gam P Q)
      (mkProperSep (msc_is_counter H G gam c) P))
    (wp H mscE (App (Val msc_read) (Val c))
      (msc_read_post H G gam c Q)) =>
  \let
    | Shift => msc_read_shift H G gam P Q
    | Public => msc_is_counter H G gam c
    | Source => mkProperSep Shift (mkProperSep Public P)
    | Prepared => mkProperSep Public
        (mkProperSep Shift (mkProperSep P Public))
    | Goal => wp H mscE (App (Val msc_read) (Val c))
        (msc_read_post H G gam c Q)
    | CounterBody : Nat -> iProp S => \lam a =>
        mkProperSep
          (mkProperPure
            (c = PairV (LitV (LitLoc a)) (natV gam.msc_size)))
          (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
            (msc_inv H G gam a))
    | CounterRest => mkProperSep Shift (mkProperSep P Public)
    | perCounter : \Pi (a : Nat) -> properUPred_ent
        (mkProperSep (CounterBody a) CounterRest) Goal =>
        \lam a =>
          \let
            | CounterV => PairV (LitV (LitLoc a)) (natV gam.msc_size)
            | Inv => iris.base_logic.lib.invariants.inv H.iris_wsat mscN
                (msc_inv H G gam a)
            | AfterPure => mkProperSep Inv CounterRest
            | CorePre => mkProperSep Inv (mkProperSep Shift P)
            | Ready => mkProperSep CorePre Public
            | CorePost => msc_read_core_post H G gam a Q
            | runConcrete : properUPred_ent CorePre
                (wp H mscE (App (Val msc_read) (Val CounterV)) CorePost) =>
                msc_read_specialized_wp H G gam a P Q
            | runFramed : properUPred_ent Ready
                (wp H mscE (App (Val msc_read) (Val CounterV))
                  (wp_frame_post CorePost Public)) =>
                properUPred_ent_trans Ready
                  (mkProperSep
                    (wp H mscE (App (Val msc_read) (Val CounterV)) CorePost)
                    Public)
                  (wp H mscE (App (Val msc_read) (Val CounterV))
                    (wp_frame_post CorePost Public))
                  (sep_mono_l_ent CorePre
                    (wp H mscE (App (Val msc_read) (Val CounterV)) CorePost)
                    Public runConcrete)
                  (wp_frame_r H mscE
                    (App (Val msc_read) (Val CounterV)) CorePost Public)
            | finish : properUPred_ent
                (wp H mscE (App (Val msc_read) (Val CounterV))
                  (wp_frame_post CorePost Public))
                (wp H mscE (App (Val msc_read) (Val CounterV))
                  (msc_read_post H G gam c Q)) =>
                wp_mono H mscE (App (Val msc_read) (Val CounterV))
                  (wp_frame_post CorePost Public)
                  (msc_read_post H G gam c Q)
                  (\lam v => msc_read_post_frame H G gam a c Q v)
            | concrete : properUPred_ent Ready
                (wp H mscE (App (Val msc_read) (Val CounterV))
                  (msc_read_post H G gam c Q)) =>
                properUPred_ent_trans Ready
                  (wp H mscE (App (Val msc_read) (Val CounterV))
                    (wp_frame_post CorePost Public))
                  (wp H mscE (App (Val msc_read) (Val CounterV))
                    (msc_read_post H G gam c Q)) runFramed finish
            | arrange : properUPred_ent AfterPure Ready =>
                properUPred_ent_trans AfterPure
                  (mkProperSep Inv
                    (mkProperSep (mkProperSep Shift P) Public)) Ready
                  (sep_mono_r_ent Inv
                    (mkProperSep Shift (mkProperSep P Public))
                    (mkProperSep (mkProperSep Shift P) Public)
                    (sep_assoc_r_ent Shift P Public))
                  (sep_assoc_r_ent Inv (mkProperSep Shift P) Public)
            | afterEq : c = CounterV -> properUPred_ent AfterPure Goal =>
                \lam counterEq => transport
                  (\lam cv => properUPred_ent AfterPure
                    (wp H mscE (App (Val msc_read) (Val cv))
                      (msc_read_post H G gam c Q)))
                  (Paths.inv counterEq)
                  (properUPred_ent_trans AfterPure Ready
                    (wp H mscE (App (Val msc_read) (Val CounterV))
                      (msc_read_post H G gam c Q)) arrange concrete)
          \in properUPred_ent_trans
              (mkProperSep (CounterBody a) CounterRest)
              (mkProperSep
                (mkProperPure (c = CounterV)) AfterPure) Goal
              (sep_assoc_l_ent (mkProperPure (c = CounterV)) Inv CounterRest)
              (pure_sep_l_elim (c = CounterV) AfterPure Goal afterEq)
    | prepared : properUPred_ent Source Prepared =>
        msc_read_prepare_public H G gam c P Q
  \in properUPred_ent_trans Source Prepared Goal prepared
      (sep_exist_l_elim CounterBody CounterRest Goal perCounter)

\func msc_incr_result {S : gFunctors} (Q : Nat -> iProp S) : iProp S =>
  mkProperExist Nat Q

\func msc_incr_shift {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (P : iProp S) (Q : Nat -> iProp S) : iProp S =>
  mkProperForall Nat (\lam total =>
    mkProperPersistently
      (mkProperWand
        (mkProperSep (msc_counter_auth G gam total) P)
        (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
          (mkProperSep (msc_counter_auth G gam (suc total)) (Q total)))))

\lemma msc_incr_mono_step {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a i : Nat) (w : msc_incr_witness {S} gam i)
    (X : iProp S) :
  properUPred_ent
    (mkProperSep (msc_incr_after H G gam a i w) X)
    (mkProperBUpd
      (mkProperSep
        (mkProperSep (msc_counter_auth G gam (msc_incr_total w))
          (mkProperSep
            (pointsto_array_rest H.iris_gen_heap suc a
              (map natV w.incr_prefix) (map natV w.incr_suffix))
            (mkProperSep
              (mono_nat_auth_own G.msc_mono_natG
                w.incr_name qp_one (suc w.incr_old))
              (mkProperSep
                (msc_mono_rest G w.incr_prefix w.incr_name_prefix
                  w.incr_suffix w.incr_name_suffix)
                (msc_requests H G gam (msc_incr_total w)
                  w.incr_requests))))) X)) =>
  \let
    | Auth => msc_counter_auth G gam (msc_incr_total w)
    | ArrayRest => pointsto_array_rest H.iris_gen_heap suc a
        (map natV w.incr_prefix) (map natV w.incr_suffix)
    | Mono0 => mono_nat_auth_own G.msc_mono_natG
        w.incr_name qp_one w.incr_old
    | Mono1 => mono_nat_auth_own G.msc_mono_natG
        w.incr_name qp_one (suc w.incr_old)
    | LB => mono_nat_lb_own G.msc_mono_natG w.incr_name (suc w.incr_old)
    | MonoRest => msc_mono_rest G w.incr_prefix w.incr_name_prefix
        w.incr_suffix w.incr_name_suffix
    | Requests => msc_requests H G gam (msc_incr_total w) w.incr_requests
    | Tail => mkProperSep MonoRest Requests
    | Rest0 => mkProperSep Auth (mkProperSep ArrayRest Tail)
    | Rest => mkProperSep Rest0 X
    | Source => mkProperSep (mkProperSep Auth
        (mkProperSep ArrayRest (mkProperSep Mono0 Tail))) X
    | S1 => mkProperSep (mkProperSep Auth
        (mkProperSep Mono0 (mkProperSep ArrayRest Tail))) X
    | S2 => mkProperSep (mkProperSep Mono0 Rest0) X
    | Ready => mkProperSep Mono0 Rest
    | Updated => mkProperSep (mkProperBUpd (mkProperSep Mono1 LB)) Rest
    | Framed => mkProperBUpd (mkProperSep (mkProperSep Mono1 LB) Rest)
    | TargetBody => mkProperSep
        (mkProperSep Auth (mkProperSep ArrayRest (mkProperSep Mono1 Tail))) X
    | arrange : properUPred_ent Source Ready =>
        properUPred_ent_trans Source S1 Ready
          (sep_mono_l_ent
            (mkProperSep Auth (mkProperSep ArrayRest (mkProperSep Mono0 Tail)))
            (mkProperSep Auth (mkProperSep Mono0 (mkProperSep ArrayRest Tail)))
            X
            (sep_mono_r_ent Auth
              (mkProperSep ArrayRest (mkProperSep Mono0 Tail))
              (mkProperSep Mono0 (mkProperSep ArrayRest Tail))
              (sep_swap_ent ArrayRest Mono0 Tail)))
          (properUPred_ent_trans S1 S2 Ready
            (sep_mono_l_ent
              (mkProperSep Auth (mkProperSep Mono0 (mkProperSep ArrayRest Tail)))
              (mkProperSep Mono0 Rest0) X
              (sep_swap_ent Auth Mono0 (mkProperSep ArrayRest Tail)))
            (sep_assoc_l_ent Mono0 Rest0 X))
    | update : properUPred_ent Ready Framed =>
        properUPred_ent_trans Ready Updated Framed
          (sep_mono_l_ent Mono0 (mkProperBUpd (mkProperSep Mono1 LB)) Rest
            (mono_nat_own_update G.msc_mono_natG w.incr_name
              w.incr_old (suc w.incr_old) (nat_le_suc_self w.incr_old)))
          (bupd_frame_r (mkProperSep Mono1 LB) Rest)
    | finish : properUPred_ent (mkProperSep (mkProperSep Mono1 LB) Rest)
        TargetBody =>
        \let
          | DropLB => mkProperSep Mono1 Rest
          | Moved => mkProperSep Mono1 (mkProperSep Rest0 X)
          | Back0 => mkProperSep (mkProperSep Mono1 Rest0) X
          | Back1 => mkProperSep (mkProperSep Auth
              (mkProperSep Mono1 (mkProperSep ArrayRest Tail))) X
        \in properUPred_ent_trans
          (mkProperSep (mkProperSep Mono1 LB) Rest) DropLB TargetBody
          (sep_mono_l_ent (mkProperSep Mono1 LB) Mono1 Rest
            (sep_elim_l_ent Mono1 LB))
          (properUPred_ent_trans DropLB Moved TargetBody
            (properUPred_ent_refl DropLB)
            (properUPred_ent_trans Moved Back0 TargetBody
              (sep_assoc_r_ent Mono1 Rest0 X)
              (properUPred_ent_trans Back0 Back1 TargetBody
                (sep_mono_l_ent (mkProperSep Mono1 Rest0)
                  (mkProperSep Auth
                    (mkProperSep Mono1 (mkProperSep ArrayRest Tail))) X
                  (sep_swap_ent Mono1 Auth (mkProperSep ArrayRest Tail)))
                (sep_mono_l_ent
                  (mkProperSep Auth
                    (mkProperSep Mono1 (mkProperSep ArrayRest Tail)))
                  (mkProperSep Auth
                    (mkProperSep ArrayRest (mkProperSep Mono1 Tail))) X
                  (sep_mono_r_ent Auth
                    (mkProperSep Mono1 (mkProperSep ArrayRest Tail))
                    (mkProperSep ArrayRest (mkProperSep Mono1 Tail))
                    (sep_swap_ent Mono1 ArrayRest Tail))))))
  \in properUPred_ent_trans Source Ready (mkProperBUpd TargetBody)
      arrange (properUPred_ent_trans Ready Framed
        (mkProperBUpd TargetBody) update (bupd_mono
          (mkProperSep (mkProperSep Mono1 LB) Rest) TargetBody finish))

\lemma msc_incr_client_requests_step {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a i : Nat) (w : msc_incr_witness {S} gam i)
    (P : iProp S) (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep
      (mkProperSep (msc_counter_auth G gam (msc_incr_total w))
        (mkProperSep
          (pointsto_array_rest H.iris_gen_heap suc a
            (map natV w.incr_prefix) (map natV w.incr_suffix))
          (mkProperSep
            (mono_nat_auth_own G.msc_mono_natG
              w.incr_name qp_one (suc w.incr_old))
            (mkProperSep
              (msc_mono_rest G w.incr_prefix w.incr_name_prefix
                w.incr_suffix w.incr_name_suffix)
              (msc_requests H G gam (msc_incr_total w)
                w.incr_requests)))))
      (mkProperSep (msc_incr_shift H G gam P Q) P))
    (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
      (mkProperSep
        (mkProperSep (msc_counter_auth G gam (suc (msc_incr_total w)))
          (mkProperSep
            (pointsto_array_rest H.iris_gen_heap suc a
              (map natV w.incr_prefix) (map natV w.incr_suffix))
            (mkProperSep
              (mono_nat_auth_own G.msc_mono_natG
                w.incr_name qp_one (suc w.incr_old))
              (mkProperSep
                (msc_mono_rest G w.incr_prefix w.incr_name_prefix
                  w.incr_suffix w.incr_name_suffix)
                (msc_requests H G gam (suc (msc_incr_total w))
                  w.incr_requests)))))
        (Q (msc_incr_total w)))) =>
  \let
    | Total => msc_incr_total w
    | Auth0 => msc_counter_auth G gam Total
    | Auth1 => msc_counter_auth G gam (suc Total)
    | ArrayRest => pointsto_array_rest H.iris_gen_heap suc a
        (map natV w.incr_prefix) (map natV w.incr_suffix)
    | Mono => mono_nat_auth_own G.msc_mono_natG
        w.incr_name qp_one (suc w.incr_old)
    | MonoRest => msc_mono_rest G w.incr_prefix w.incr_name_prefix
        w.incr_suffix w.incr_name_suffix
    | Requests0 => msc_requests H G gam Total w.incr_requests
    | Requests1 => msc_requests H G gam (suc Total) w.incr_requests
    | VS => msc_incr_shift H G gam P Q
    | QR => Q Total
    | Rest => mkProperSep ArrayRest
        (mkProperSep Mono (mkProperSep MonoRest Requests0))
    | RestNoReq => mkProperSep ArrayRest (mkProperSep Mono MonoRest)
    | X => mkProperSep VS P
    | Source => mkProperSep (mkProperSep Auth0 Rest) X
    | A1 => mkProperSep X (mkProperSep Auth0 Rest)
    | A2 => mkProperSep VS (mkProperSep P (mkProperSep Auth0 Rest))
    | A3 => mkProperSep VS (mkProperSep Auth0 (mkProperSep P Rest))
    | ReadyClient => mkProperSep (mkProperSep VS (mkProperSep Auth0 P)) Rest
    | ClientShift => mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
        (mkProperSep Auth1 QR)
    | ClientFramed => mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
        (mkProperSep (mkProperSep Auth1 QR) Rest)
    | invokeClient : properUPred_ent
        (mkProperSep VS (mkProperSep Auth0 P)) ClientShift =>
        properUPred_ent_trans
          (mkProperSep VS (mkProperSep Auth0 P))
          (mkProperSep
            (mkProperPersistently
              (mkProperWand (mkProperSep Auth0 P) ClientShift))
            (mkProperSep Auth0 P)) ClientShift
          (sep_mono_l_ent VS
            (mkProperPersistently
              (mkProperWand (mkProperSep Auth0 P) ClientShift))
            (mkProperSep Auth0 P)
            (forall_elim_ent (\lam total =>
              mkProperPersistently
                (mkProperWand
                  (mkProperSep (msc_counter_auth G gam total) P)
                  (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                    (mkProperSep
                      (msc_counter_auth G gam (suc total)) (Q total)))))
              Total))
          (persistently_wand_elim_ent (mkProperSep Auth0 P) ClientShift)
    | arrangeClient : properUPred_ent Source ReadyClient =>
        properUPred_ent_trans Source A1 ReadyClient
          (sep_comm_ent (mkProperSep Auth0 Rest) X)
          (properUPred_ent_trans A1 A2 ReadyClient
            (sep_assoc_l_ent VS P (mkProperSep Auth0 Rest))
            (properUPred_ent_trans A2 A3 ReadyClient
              (sep_mono_r_ent VS
                (mkProperSep P (mkProperSep Auth0 Rest))
                (mkProperSep Auth0 (mkProperSep P Rest))
                (sep_swap_ent P Auth0 Rest))
              (properUPred_ent_trans A3
                (mkProperSep VS
                  (mkProperSep (mkProperSep Auth0 P) Rest)) ReadyClient
                (sep_mono_r_ent VS
                  (mkProperSep Auth0 (mkProperSep P Rest))
                  (mkProperSep (mkProperSep Auth0 P) Rest)
                  (sep_assoc_r_ent Auth0 P Rest))
                (sep_assoc_r_ent VS (mkProperSep Auth0 P) Rest))))
    | runClient : properUPred_ent ReadyClient ClientFramed =>
        properUPred_ent_trans ReadyClient
          (mkProperSep ClientShift Rest) ClientFramed
          (sep_mono_l_ent (mkProperSep VS (mkProperSep Auth0 P))
            ClientShift Rest invokeClient)
          (fupd_frame_r H.iris_wsat msc_open_mask msc_open_mask
            (mkProperSep Auth1 QR) Rest)
    | B0 => mkProperSep (mkProperSep Auth1 QR) Rest
    | R1 => mkProperSep ArrayRest
        (mkProperSep Mono (mkProperSep Requests0 MonoRest))
    | R2 => mkProperSep ArrayRest
        (mkProperSep Requests0 (mkProperSep Mono MonoRest))
    | R3 => mkProperSep Requests0 RestNoReq
    | B1 => mkProperSep (mkProperSep Auth1 QR) R3
    | B2 => mkProperSep Auth1 (mkProperSep QR (mkProperSep Requests0 RestNoReq))
    | B3 => mkProperSep Auth1 (mkProperSep Requests0
        (mkProperSep QR RestNoReq))
    | ReadyRequests => mkProperSep (mkProperSep Auth1 Requests0)
        (mkProperSep QR RestNoReq)
    | arrangeRest : properUPred_ent Rest R3 =>
        properUPred_ent_trans Rest R1 R3
          (sep_mono_r_ent ArrayRest
            (mkProperSep Mono (mkProperSep MonoRest Requests0))
            (mkProperSep Mono (mkProperSep Requests0 MonoRest))
            (sep_mono_r_ent Mono (mkProperSep MonoRest Requests0)
              (mkProperSep Requests0 MonoRest)
              (sep_comm_ent MonoRest Requests0)))
          (properUPred_ent_trans R1 R2 R3
            (sep_mono_r_ent ArrayRest
              (mkProperSep Mono (mkProperSep Requests0 MonoRest))
              (mkProperSep Requests0 (mkProperSep Mono MonoRest))
              (sep_swap_ent Mono Requests0 MonoRest))
            (sep_swap_ent ArrayRest Requests0 (mkProperSep Mono MonoRest)))
    | arrangeRequests : properUPred_ent B0 ReadyRequests =>
        properUPred_ent_trans B0 B1 ReadyRequests
          (sep_mono_r_ent (mkProperSep Auth1 QR) Rest R3 arrangeRest)
          (properUPred_ent_trans B1 B2 ReadyRequests
            (sep_assoc_l_ent Auth1 QR R3)
            (properUPred_ent_trans B2 B3 ReadyRequests
              (sep_mono_r_ent Auth1
                (mkProperSep QR (mkProperSep Requests0 RestNoReq))
                (mkProperSep Requests0 (mkProperSep QR RestNoReq))
                (sep_swap_ent QR Requests0 RestNoReq))
              (sep_assoc_r_ent Auth1 Requests0
                (mkProperSep QR RestNoReq))))
    | RequestsShift => mkProperFUpd H.iris_wsat
        msc_open_mask msc_open_mask (mkProperSep Auth1 Requests1)
    | RequestsFramed => mkProperFUpd H.iris_wsat
        msc_open_mask msc_open_mask
        (mkProperSep (mkProperSep Auth1 Requests1)
          (mkProperSep QR RestNoReq))
    | runRequests : properUPred_ent ReadyRequests RequestsFramed =>
        properUPred_ent_trans ReadyRequests
          (mkProperSep RequestsShift (mkProperSep QR RestNoReq))
          RequestsFramed
          (sep_mono_l_ent (mkProperSep Auth1 Requests0) RequestsShift
            (mkProperSep QR RestNoReq)
            (msc_requests_advance H G gam Total w.incr_requests))
          (fupd_frame_r H.iris_wsat msc_open_mask msc_open_mask
            (mkProperSep Auth1 Requests1) (mkProperSep QR RestNoReq))
    | C0 => mkProperSep (mkProperSep Auth1 Requests1)
        (mkProperSep QR RestNoReq)
    | C1 => mkProperSep (mkProperSep QR RestNoReq)
        (mkProperSep Auth1 Requests1)
    | C2 => mkProperSep QR (mkProperSep RestNoReq
        (mkProperSep Auth1 Requests1))
    | C3 => mkProperSep QR (mkProperSep Auth1
        (mkProperSep RestNoReq Requests1))
    | C4 => mkProperSep QR (mkProperSep Auth1
        (mkProperSep ArrayRest
          (mkProperSep (mkProperSep Mono MonoRest) Requests1)))
    | C5 => mkProperSep QR
        (mkProperSep Auth1
          (mkProperSep ArrayRest
            (mkProperSep Mono (mkProperSep MonoRest Requests1))))
    | TargetBody => mkProperSep
        (mkProperSep Auth1
          (mkProperSep ArrayRest
            (mkProperSep Mono (mkProperSep MonoRest Requests1)))) QR
    | c01 : properUPred_ent C0 C1 =>
        sep_comm_ent (mkProperSep Auth1 Requests1)
          (mkProperSep QR RestNoReq)
    | c12 : properUPred_ent C1 C2 =>
        sep_assoc_l_ent QR RestNoReq (mkProperSep Auth1 Requests1)
    | c23 : properUPred_ent C2 C3 =>
        sep_mono_r_ent QR
          (mkProperSep RestNoReq (mkProperSep Auth1 Requests1))
          (mkProperSep Auth1 (mkProperSep RestNoReq Requests1))
          (sep_swap_ent RestNoReq Auth1 Requests1)
    | c34 : properUPred_ent C3 C4 =>
        sep_mono_r_ent QR
          (mkProperSep Auth1 (mkProperSep RestNoReq Requests1))
          (mkProperSep Auth1
            (mkProperSep ArrayRest
              (mkProperSep (mkProperSep Mono MonoRest) Requests1)))
          (sep_mono_r_ent Auth1
            (mkProperSep RestNoReq Requests1)
            (mkProperSep ArrayRest
              (mkProperSep (mkProperSep Mono MonoRest) Requests1))
            (sep_assoc_l_ent ArrayRest
              (mkProperSep Mono MonoRest) Requests1))
    | c45 : properUPred_ent C4 C5 =>
        sep_mono_r_ent QR
          (mkProperSep Auth1
            (mkProperSep ArrayRest
              (mkProperSep (mkProperSep Mono MonoRest) Requests1)))
          (mkProperSep Auth1
            (mkProperSep ArrayRest
              (mkProperSep Mono (mkProperSep MonoRest Requests1))))
          (sep_mono_r_ent Auth1
            (mkProperSep ArrayRest
              (mkProperSep (mkProperSep Mono MonoRest) Requests1))
            (mkProperSep ArrayRest
              (mkProperSep Mono (mkProperSep MonoRest Requests1)))
            (sep_mono_r_ent ArrayRest
              (mkProperSep (mkProperSep Mono MonoRest) Requests1)
              (mkProperSep Mono (mkProperSep MonoRest Requests1))
              (sep_assoc_l_ent Mono MonoRest Requests1)))
    | c5T : properUPred_ent C5 TargetBody =>
        sep_comm_ent QR
          (mkProperSep Auth1
            (mkProperSep ArrayRest
              (mkProperSep Mono (mkProperSep MonoRest Requests1))))
    | arrangeFinal : properUPred_ent C0 TargetBody =>
        properUPred_ent_trans C0 C1 TargetBody c01
          (properUPred_ent_trans C1 C2 TargetBody c12
            (properUPred_ent_trans C2 C3 TargetBody c23
              (properUPred_ent_trans C3 C4 TargetBody c34
                (properUPred_ent_trans C4 C5 TargetBody c45 c5T))))
    | requestNested : properUPred_ent ClientFramed
        (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
            TargetBody)) =>
        fupd_mono H.iris_wsat msc_open_mask msc_open_mask B0
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask TargetBody)
          (properUPred_ent_trans B0 ReadyRequests
            (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask TargetBody)
            arrangeRequests
            (properUPred_ent_trans ReadyRequests RequestsFramed
              (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask TargetBody)
              runRequests
              (fupd_mono H.iris_wsat msc_open_mask msc_open_mask
                C0 TargetBody arrangeFinal)))
  \in properUPred_ent_trans Source ReadyClient
      (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask TargetBody)
      arrangeClient
      (properUPred_ent_trans ReadyClient ClientFramed
        (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask TargetBody)
        runClient
        (properUPred_ent_trans ClientFramed
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
            (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask TargetBody))
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask TargetBody)
          requestNested
          (fupd_trans H.iris_wsat msc_open_mask msc_open_mask
            msc_open_mask TargetBody)))

\lemma msc_incr_after_step {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a i : Nat) (w : msc_incr_witness {S} gam i)
    (P : iProp S) (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep (msc_incr_after H G gam a i w)
      (mkProperSep (msc_incr_shift H G gam P Q) P))
    (mkProperBUpd
      (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
        (mkProperSep
          (mkProperSep
            (msc_counter_auth G gam (suc (msc_incr_total w)))
            (mkProperSep
              (pointsto_array_rest H.iris_gen_heap suc a
                (map natV w.incr_prefix) (map natV w.incr_suffix))
              (mkProperSep
                (mono_nat_auth_own G.msc_mono_natG
                  w.incr_name qp_one (suc w.incr_old))
                (mkProperSep
                  (msc_mono_rest G w.incr_prefix w.incr_name_prefix
                    w.incr_suffix w.incr_name_suffix)
                  (msc_requests H G gam (suc (msc_incr_total w))
                    w.incr_requests)))))
          (Q (msc_incr_total w))))) =>
  \let
    | X => mkProperSep (msc_incr_shift H G gam P Q) P
    | After1 => mkProperSep
        (msc_counter_auth G gam (msc_incr_total w))
        (mkProperSep
          (pointsto_array_rest H.iris_gen_heap suc a
            (map natV w.incr_prefix) (map natV w.incr_suffix))
          (mkProperSep
            (mono_nat_auth_own G.msc_mono_natG
              w.incr_name qp_one (suc w.incr_old))
            (mkProperSep
              (msc_mono_rest G w.incr_prefix w.incr_name_prefix
                w.incr_suffix w.incr_name_suffix)
              (msc_requests H G gam (msc_incr_total w)
                w.incr_requests))))
    | Updated => mkProperSep
        (mkProperSep
          (msc_counter_auth G gam (suc (msc_incr_total w)))
          (mkProperSep
            (pointsto_array_rest H.iris_gen_heap suc a
              (map natV w.incr_prefix) (map natV w.incr_suffix))
            (mkProperSep
              (mono_nat_auth_own G.msc_mono_natG
                w.incr_name qp_one (suc w.incr_old))
              (mkProperSep
                (msc_mono_rest G w.incr_prefix w.incr_name_prefix
                  w.incr_suffix w.incr_name_suffix)
                (msc_requests H G gam (suc (msc_incr_total w))
                  w.incr_requests)))))
        (Q (msc_incr_total w))
  \in properUPred_ent_trans
      (mkProperSep (msc_incr_after H G gam a i w) X)
      (mkProperBUpd (mkProperSep After1 X))
      (mkProperBUpd
        (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask Updated))
      (msc_incr_mono_step H G gam a i w X)
      (bupd_mono (mkProperSep After1 X)
        (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask Updated)
        (msc_incr_client_requests_step H G gam a i w P Q))

\lemma msc_incr_close {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a i : Nat) (w : msc_incr_witness {S} gam i)
    (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep
      (mkProperSep
        (pointsto_full H.iris_gen_heap (a Nat.+ i)
          (natV (suc w.incr_old)))
        (mkProperSep
          (msc_counter_auth G gam (suc (msc_incr_total w)))
          (mkProperSep
            (pointsto_array_rest H.iris_gen_heap suc a
              (map natV w.incr_prefix) (map natV w.incr_suffix))
            (mkProperSep
              (mono_nat_auth_own G.msc_mono_natG
                w.incr_name qp_one (suc w.incr_old))
              (mkProperSep
                (msc_mono_rest G w.incr_prefix w.incr_name_prefix
                  w.incr_suffix w.incr_name_suffix)
                (msc_requests H G gam (suc (msc_incr_total w))
                  w.incr_requests))))))
      (mkProperSep
        (mkProperWand (mkProperLater (msc_inv H G gam a))
          (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp))
        (Q (msc_incr_total w))))
    (mkProperFUpd H.iris_wsat msc_open_mask mscE
      (msc_incr_result Q)) =>
  \let
    | OldTotal => msc_incr_total w
    | NextTotal => nat_sum (msc_incr_ns_next w)
    | Cell => pointsto_full H.iris_gen_heap (a Nat.+ i)
        (natV (suc w.incr_old))
    | ArrayRest => pointsto_array_rest H.iris_gen_heap suc a
        (map natV w.incr_prefix) (map natV w.incr_suffix)
    | Mono => mono_nat_auth_own G.msc_mono_natG
        w.incr_name qp_one (suc w.incr_old)
    | MonoRest => msc_mono_rest G w.incr_prefix w.incr_name_prefix
        w.incr_suffix w.incr_name_suffix
    | CoreAt : Nat -> iProp S => \lam total =>
        mkProperSep Cell
          (mkProperSep (msc_counter_auth G gam total)
            (mkProperSep ArrayRest
              (mkProperSep Mono
                (mkProperSep MonoRest
                  (msc_requests H G gam total w.incr_requests)))))
    | CoreOld => CoreAt (suc OldTotal)
    | CoreNext => CoreAt NextTotal
    | Inv => msc_inv H G gam a
    | LaterInv => mkProperLater Inv
    | Close => mkProperWand LaterInv
        (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp)
    | QR => Q OldTotal
    | Source => mkProperSep CoreOld (mkProperSep Close QR)
    | WithInv => mkProperSep Inv (mkProperSep Close QR)
    | WithLater => mkProperSep LaterInv (mkProperSep Close QR)
    | Swapped => mkProperSep Close (mkProperSep LaterInv QR)
    | Ready => mkProperSep (mkProperSep Close LaterInv) QR
    | Invoked => mkProperSep
        (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp) QR
    | Framed => mkProperFUpd H.iris_wsat msc_open_mask mscE
        (mkProperSep mkProperEmp QR)
    | totalEq : NextTotal = suc OldTotal =>
        msc_sum_list_insert_suc w.incr_prefix w.incr_suffix w.incr_old
    | convert : properUPred_ent CoreOld CoreNext =>
        \lam n x _ hcore => transport (\lam total =>
          (CoreAt total).upred_holds n x) (inv totalEq) hcore
    | rebuild : properUPred_ent CoreOld Inv =>
        properUPred_ent_trans CoreOld CoreNext Inv convert
          (msc_incr_rebuild H G gam a i w)
    | stepInv : properUPred_ent Source WithInv =>
        sep_mono_l_ent CoreOld Inv (mkProperSep Close QR) rebuild
    | stepLater : properUPred_ent WithInv WithLater =>
        sep_mono_l_ent Inv LaterInv (mkProperSep Close QR)
          (proper_later_intro Inv)
    | stepSwap : properUPred_ent WithLater Swapped =>
        sep_swap_ent LaterInv Close QR
    | stepReady : properUPred_ent Swapped Ready =>
        sep_assoc_r_ent Close LaterInv QR
    | stepInvoke : properUPred_ent Ready Invoked =>
        sep_mono_l_ent (mkProperSep Close LaterInv)
          (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp) QR
          (wand_elim_ent LaterInv
            (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp))
    | stepFrame : properUPred_ent Invoked Framed =>
        fupd_frame_r H.iris_wsat msc_open_mask mscE mkProperEmp QR
    | finish : properUPred_ent (mkProperSep mkProperEmp QR)
        (msc_incr_result Q) =>
        properUPred_ent_trans (mkProperSep mkProperEmp QR) QR
          (msc_incr_result Q)
          (sep_elim_r_ent mkProperEmp QR)
          (exist_intro_ent Q OldTotal)
  \in properUPred_ent_trans Source WithInv
      (mkProperFUpd H.iris_wsat msc_open_mask mscE (msc_incr_result Q))
      stepInv
      (properUPred_ent_trans WithInv WithLater
        (mkProperFUpd H.iris_wsat msc_open_mask mscE (msc_incr_result Q))
        stepLater
        (properUPred_ent_trans WithLater Swapped
          (mkProperFUpd H.iris_wsat msc_open_mask mscE (msc_incr_result Q))
          stepSwap
          (properUPred_ent_trans Swapped Ready
            (mkProperFUpd H.iris_wsat msc_open_mask mscE (msc_incr_result Q))
            stepReady
            (properUPred_ent_trans Ready Invoked
              (mkProperFUpd H.iris_wsat msc_open_mask mscE
                (msc_incr_result Q))
              stepInvoke
              (properUPred_ent_trans Invoked Framed
                (mkProperFUpd H.iris_wsat msc_open_mask mscE
                  (msc_incr_result Q))
                stepFrame
                (fupd_mono H.iris_wsat msc_open_mask mscE
                  (mkProperSep mkProperEmp QR) (msc_incr_result Q)
                  finish))))))

\lemma msc_incr_finish_after_step {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a i : Nat) (w : msc_incr_witness {S} gam i)
    (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep
      (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
        (mkProperSep
          (mkProperSep
            (msc_counter_auth G gam (suc (msc_incr_total w)))
            (mkProperSep
              (pointsto_array_rest H.iris_gen_heap suc a
                (map natV w.incr_prefix) (map natV w.incr_suffix))
              (mkProperSep
                (mono_nat_auth_own G.msc_mono_natG
                  w.incr_name qp_one (suc w.incr_old))
                (mkProperSep
                  (msc_mono_rest G w.incr_prefix w.incr_name_prefix
                    w.incr_suffix w.incr_name_suffix)
                  (msc_requests H G gam (suc (msc_incr_total w))
                    w.incr_requests)))))
          (Q (msc_incr_total w))))
      (mkProperSep
        (pointsto_full H.iris_gen_heap (a Nat.+ i)
          (natV (suc w.incr_old)))
        (mkProperWand (mkProperLater (msc_inv H G gam a))
          (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp))))
    (mkProperFUpd H.iris_wsat msc_open_mask mscE
      (msc_incr_result Q)) =>
  \let
    | Total => msc_incr_total w
    | Cell => pointsto_full H.iris_gen_heap (a Nat.+ i)
        (natV (suc w.incr_old))
    | Close => mkProperWand (mkProperLater (msc_inv H G gam a))
        (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp)
    | Core => mkProperSep
        (msc_counter_auth G gam (suc Total))
        (mkProperSep
          (pointsto_array_rest H.iris_gen_heap suc a
            (map natV w.incr_prefix) (map natV w.incr_suffix))
          (mkProperSep
            (mono_nat_auth_own G.msc_mono_natG
              w.incr_name qp_one (suc w.incr_old))
            (mkProperSep
              (msc_mono_rest G w.incr_prefix w.incr_name_prefix
                w.incr_suffix w.incr_name_suffix)
              (msc_requests H G gam (suc Total) w.incr_requests))))
    | QR => Q Total
    | FCore => mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
        (mkProperSep Core QR)
    | CellClose => mkProperSep Cell Close
    | Source => mkProperSep FCore CellClose
    | Framed => mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
        (mkProperSep (mkProperSep Core QR) CellClose)
    | A0 => mkProperSep (mkProperSep Core QR) CellClose
    | A1 => mkProperSep Core (mkProperSep QR CellClose)
    | A2 => mkProperSep Core (mkProperSep Cell (mkProperSep QR Close))
    | A3 => mkProperSep Cell (mkProperSep Core (mkProperSep QR Close))
    | A4 => mkProperSep Cell (mkProperSep Core (mkProperSep Close QR))
    | CloseSource => mkProperSep (mkProperSep Cell Core)
        (mkProperSep Close QR)
    | arrange : properUPred_ent A0 CloseSource =>
        properUPred_ent_trans A0 A1 CloseSource
          (sep_assoc_l_ent Core QR CellClose)
          (properUPred_ent_trans A1 A2 CloseSource
            (sep_mono_r_ent Core (mkProperSep QR CellClose)
              (mkProperSep Cell (mkProperSep QR Close))
              (sep_swap_ent QR Cell Close))
            (properUPred_ent_trans A2 A3 CloseSource
              (sep_swap_ent Core Cell (mkProperSep QR Close))
              (properUPred_ent_trans A3 A4 CloseSource
                (sep_mono_r_ent Cell (mkProperSep Core (mkProperSep QR Close))
                  (mkProperSep Core (mkProperSep Close QR))
                  (sep_mono_r_ent Core (mkProperSep QR Close)
                    (mkProperSep Close QR) (sep_comm_ent QR Close)))
                (sep_assoc_r_ent Cell Core (mkProperSep Close QR)))))
    | nested : properUPred_ent Framed
        (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
          (mkProperFUpd H.iris_wsat msc_open_mask mscE
            (msc_incr_result Q))) =>
        fupd_mono H.iris_wsat msc_open_mask msc_open_mask A0
          (mkProperFUpd H.iris_wsat msc_open_mask mscE
            (msc_incr_result Q))
          (properUPred_ent_trans A0 CloseSource
            (mkProperFUpd H.iris_wsat msc_open_mask mscE
              (msc_incr_result Q)) arrange
            (msc_incr_close H G gam a i w Q))
  \in properUPred_ent_trans Source Framed
      (mkProperFUpd H.iris_wsat msc_open_mask mscE (msc_incr_result Q))
      (fupd_frame_r H.iris_wsat msc_open_mask msc_open_mask
        (mkProperSep Core QR) CellClose)
      (properUPred_ent_trans Framed
        (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
          (mkProperFUpd H.iris_wsat msc_open_mask mscE
            (msc_incr_result Q)))
        (mkProperFUpd H.iris_wsat msc_open_mask mscE (msc_incr_result Q))
        nested
        (fupd_trans H.iris_wsat msc_open_mask msc_open_mask mscE
          (msc_incr_result Q)))

\func msc_incr_faa_after {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a i : Nat) (w : msc_incr_witness {S} gam i)
    (P : iProp S) (Q : Nat -> iProp S) : iProp S =>
  mkProperSep (msc_incr_after H G gam a i w)
    (mkProperSep
      (mkProperWand (mkProperLater (msc_inv H G gam a))
        (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp))
      (mkProperSep (msc_incr_shift H G gam P Q) P))

\lemma msc_incr_faa_transition {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a i : Nat) (w : msc_incr_witness {S} gam i)
    (P : iProp S) (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep
      (pointsto_full H.iris_gen_heap (a Nat.+ i)
        (natV (suc w.incr_old)))
      (msc_incr_faa_after H G gam a i w P Q))
    (mkProperBUpd
      (mkProperFUpd H.iris_wsat msc_open_mask mscE
        (msc_incr_result Q))) =>
  \let
    | Cell => pointsto_full H.iris_gen_heap (a Nat.+ i)
        (natV (suc w.incr_old))
    | After => msc_incr_after H G gam a i w
    | Close => mkProperWand (mkProperLater (msc_inv H G gam a))
        (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp)
    | X => mkProperSep (msc_incr_shift H G gam P Q) P
    | CellClose => mkProperSep Cell Close
    | Source => mkProperSep Cell (mkProperSep After (mkProperSep Close X))
    | A1 => mkProperSep Cell (mkProperSep After (mkProperSep X Close))
    | A2 => mkProperSep Cell (mkProperSep (mkProperSep After X) Close)
    | Ready => mkProperSep (mkProperSep After X) CellClose
    | Step => mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
        (mkProperSep
          (mkProperSep
            (msc_counter_auth G gam (suc (msc_incr_total w)))
            (mkProperSep
              (pointsto_array_rest H.iris_gen_heap suc a
                (map natV w.incr_prefix) (map natV w.incr_suffix))
              (mkProperSep
                (mono_nat_auth_own G.msc_mono_natG
                  w.incr_name qp_one (suc w.incr_old))
                (mkProperSep
                  (msc_mono_rest G w.incr_prefix w.incr_name_prefix
                    w.incr_suffix w.incr_name_suffix)
                  (msc_requests H G gam (suc (msc_incr_total w))
                    w.incr_requests)))))
          (Q (msc_incr_total w)))
    | Updated => mkProperSep Step CellClose
    | Framed => mkProperBUpd Updated
    | arrange : properUPred_ent Source Ready =>
        properUPred_ent_trans Source A1 Ready
          (sep_mono_r_ent Cell (mkProperSep After (mkProperSep Close X))
            (mkProperSep After (mkProperSep X Close))
            (sep_mono_r_ent After (mkProperSep Close X)
              (mkProperSep X Close) (sep_comm_ent Close X)))
          (properUPred_ent_trans A1 A2 Ready
            (sep_mono_r_ent Cell (mkProperSep After (mkProperSep X Close))
              (mkProperSep (mkProperSep After X) Close)
              (sep_assoc_r_ent After X Close))
            (sep_swap_ent Cell (mkProperSep After X) Close))
    | run : properUPred_ent Ready Framed =>
        properUPred_ent_trans Ready
          (mkProperSep (mkProperBUpd Step) CellClose) Framed
          (sep_mono_l_ent (mkProperSep After X) (mkProperBUpd Step)
            CellClose (msc_incr_after_step H G gam a i w P Q))
          (bupd_frame_r Step CellClose)
    | finish : properUPred_ent Updated
        (mkProperFUpd H.iris_wsat msc_open_mask mscE
          (msc_incr_result Q)) =>
        msc_incr_finish_after_step H G gam a i w Q
  \in properUPred_ent_trans Source Ready
      (mkProperBUpd
        (mkProperFUpd H.iris_wsat msc_open_mask mscE
          (msc_incr_result Q))) arrange
      (properUPred_ent_trans Ready Framed
        (mkProperBUpd
          (mkProperFUpd H.iris_wsat msc_open_mask mscE
            (msc_incr_result Q))) run
        (bupd_mono Updated
          (mkProperFUpd H.iris_wsat msc_open_mask mscE
            (msc_incr_result Q)) finish))

\lemma msc_incr_opened_faa {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a i : Nat) (w : msc_incr_witness {S} gam i)
    (P : iProp S) (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep
      (mkProperSep
        (mkProperSep
          (msc_incr_now H G gam a i w)
          (mkProperLater (msc_incr_after H G gam a i w)))
        (mkProperWand (mkProperLater (msc_inv H G gam a))
          (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp)))
      (mkProperSep (msc_incr_shift H G gam P Q) P))
    (wp H msc_open_mask
      (FAA (Val (LitV (LitLoc (a Nat.+ i)))) (Val (natV 1)))
      (\lam _ => mkProperFUpd H.iris_wsat msc_open_mask mscE
        (msc_incr_result Q))) =>
  \let
    | Now => msc_incr_now H G gam a i w
    | After => msc_incr_after H G gam a i w
    | Close => mkProperWand (mkProperLater (msc_inv H G gam a))
        (mkProperFUpd H.iris_wsat msc_open_mask mscE mkProperEmp)
    | K => mkProperSep (msc_incr_shift H G gam P Q) P
    | CloseK => mkProperSep Close K
    | FaaAfter => msc_incr_faa_after H G gam a i w P Q
    | PhiFAA : Value -> iProp S => \lam _ =>
        mkProperFUpd H.iris_wsat msc_open_mask mscE (msc_incr_result Q)
    | Source => mkProperSep
        (mkProperSep (mkProperSep Now (mkProperLater After)) Close) K
    | A1 => mkProperSep (mkProperSep Now (mkProperLater After)) CloseK
    | A2 => mkProperSep Now (mkProperSep (mkProperLater After) CloseK)
    | A3 => mkProperSep Now
        (mkProperSep (mkProperLater After) (mkProperLater CloseK))
    | Ready => mkProperSep Now (mkProperLater FaaAfter)
    | arrange : properUPred_ent Source Ready =>
        properUPred_ent_trans Source A1 Ready
          (sep_assoc_l_ent (mkProperSep Now (mkProperLater After)) Close K)
          (properUPred_ent_trans A1 A2 Ready
            (sep_assoc_l_ent Now (mkProperLater After) CloseK)
            (properUPred_ent_trans A2 A3 Ready
              (sep_mono_r_ent Now (mkProperSep (mkProperLater After) CloseK)
                (mkProperSep (mkProperLater After) (mkProperLater CloseK))
                (sep_mono_r_ent (mkProperLater After) CloseK
                  (mkProperLater CloseK) (proper_later_intro CloseK)))
              (sep_mono_r_ent Now
                (mkProperSep (mkProperLater After) (mkProperLater CloseK))
                (mkProperLater FaaAfter)
                (proper_later_sep_2 After CloseK))))
    | faa : properUPred_ent Ready
        (wp H msc_open_mask
          (FAA (Val (LitV (LitLoc (a Nat.+ i)))) (Val (natV 1)))
          PhiFAA) =>
        wp_faa_later_frame H msc_open_mask (a Nat.+ i)
          w.incr_old 1 FaaAfter PhiFAA
          (msc_incr_faa_transition H G gam a i w P Q)
  \in properUPred_ent_trans Source Ready
      (wp H msc_open_mask
        (FAA (Val (LitV (LitLoc (a Nat.+ i)))) (Val (natV 1))) PhiFAA)
      arrange faa

\lemma msc_incr_faa_wp {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a i : Nat) (hi : nat_lt i gam.msc_size)
    (P : iProp S) (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep
      (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a))
      (mkProperSep (msc_incr_shift H G gam P Q) P))
    (wp H mscE
      (FAA (Val (LitV (LitLoc (a Nat.+ i)))) (Val (natV 1)))
      (\lam _ => msc_incr_result Q)) =>
  wp_atomic_inv_acc_timeless_exist_frame H mscE mscN
    (msc_inv H G gam a)
    (\lam w => msc_incr_now H G gam a i w)
    (\lam w => msc_incr_after H G gam a i w)
    (mkProperSep (msc_incr_shift H G gam P Q) P)
    (FAA (Val (LitV (LitLoc (a Nat.+ i)))) (Val (natV 1)))
    (\lam _ => msc_incr_result Q)
    mscN_subset_mscE (faa_strongly_atomic (a Nat.+ i) 1)
    (\lam w => msc_incr_now_timeless H G gam a i w)
    (msc_inv_incr_split H G gam a i hi)
    (\lam w => msc_incr_opened_faa H G gam a i w P Q)

\func msc_incr_core_post {S : gFunctors}
    (Q : Nat -> iProp S) (v : Value) : iProp S =>
  mkProperAnd (mkProperPure (v = unitV)) (msc_incr_result Q)

\lemma msc_incr_seq_wp {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a i : Nat) (hi : nat_lt i gam.msc_size)
    (P : iProp S) (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep
      (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a))
      (mkProperSep (msc_incr_shift H G gam P Q) P))
    (wp H mscE
      (seqE
        (FAA (Val (LitV (LitLoc (a Nat.+ i)))) (Val (natV 1)))
        (Val unitV))
      (msc_incr_core_post Q)) =>
  \let
    | Result => msc_incr_result Q
    | Post => msc_incr_core_post Q
    | FAAExpr => FAA (Val (LitV (LitLoc (a Nat.+ i)))) (Val (natV 1))
    | LetLam => LamV nIgnore (Val unitV)
    | LetExpr => App (Val LetLam) FAAExpr
    | resultPost : properUPred_ent Result (Post unitV) =>
        (BIuPredMixin (iResUR S)).bi_mixin_and_intro Result
          (mkProperPure (unitV = unitV)) Result
          (\lam _ _ _ _ => idp) (properUPred_ent_refl Result)
    | continue : \Pi (old : Value) -> properUPred_ent Result
        (wp H mscE (App (Val LetLam) (Val old)) Post) =>
        \lam old => properUPred_ent_trans Result
          (wp H mscE (Val unitV) Post)
          (wp H mscE (App (Val LetLam) (Val old)) Post)
          (properUPred_ent_trans Result (Post unitV)
            (wp H mscE (Val unitV) Post) resultPost
            (wp_value_intro H mscE unitV Post))
          (wp_lam_beta H mscE nIgnore (Val unitV) old Post)
    | faaToLet : properUPred_ent
        (wp H mscE FAAExpr (\lam _ => Result))
        (wp H mscE LetExpr Post) =>
        properUPred_ent_trans
          (wp H mscE FAAExpr (\lam _ => Result))
          (wp H mscE FAAExpr (\lam old =>
            wp H mscE (App (Val LetLam) (Val old)) Post))
          (wp H mscE LetExpr Post)
          (wp_mono H mscE FAAExpr (\lam _ => Result)
            (\lam old => wp H mscE
              (App (Val LetLam) (Val old)) Post) continue)
          (wp_bind_app_r H mscE LetLam FAAExpr Post)
    | surface : properUPred_ent (wp H mscE LetExpr Post)
        (wp H mscE (App (Lam nIgnore (Val unitV)) FAAExpr) Post) =>
        \let
          | LamPost : Value -> iProp S => \lam vf =>
              wp H mscE (App (Val vf) FAAExpr) Post
        \in properUPred_ent_trans (wp H mscE LetExpr Post)
          (wp H mscE (Val LetLam) LamPost)
          (wp H mscE (App (Lam nIgnore (Val unitV)) FAAExpr) Post)
          (wp_value_intro H mscE LetLam LamPost)
          (properUPred_ent_trans (wp H mscE (Val LetLam) LamPost)
            (wp H mscE (Lam nIgnore (Val unitV)) LamPost)
            (wp H mscE (App (Lam nIgnore (Val unitV)) FAAExpr) Post)
            (wp_lam_expr H mscE nIgnore (Val unitV) LamPost)
            (wp_bind_app_l H mscE (Lam nIgnore (Val unitV)) FAAExpr Post))
  \in properUPred_ent_trans
      (mkProperSep
        (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
          (msc_inv H G gam a))
        (mkProperSep (msc_incr_shift H G gam P Q) P))
      (wp H mscE FAAExpr (\lam _ => Result))
      (wp H mscE (seqE FAAExpr (Val unitV)) Post)
      (msc_incr_faa_wp H G gam a i hi P Q)
      (properUPred_ent_trans
        (wp H mscE FAAExpr (\lam _ => Result))
        (wp H mscE LetExpr Post)
        (wp H mscE (seqE FAAExpr (Val unitV)) Post)
        faaToLet surface)

\lemma msc_incr_loc_let_wp {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a i : Nat) (hi : nat_lt i gam.msc_size)
    (P : iProp S) (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep
      (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a))
      (mkProperSep (msc_incr_shift H G gam P Q) P))
    (wp H mscE
      (letE nL
        (LocAdd (Val (LitV (LitLoc a))) (Val (natV i)))
        (seqE (FAA (Var nL) (Val (natV 1))) (Val unitV)))
      (msc_incr_core_post Q)) =>
  \let
    | Pre => mkProperSep
        (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
          (msc_inv H G gam a))
        (mkProperSep (msc_incr_shift H G gam P Q) P)
    | Post => msc_incr_core_post Q
    | LocV => LitV (LitLoc (a Nat.+ i))
    | SeqBody => seqE (FAA (Var nL) (Val (natV 1))) (Val unitV)
    | SeqAt => seqE
        (FAA (Val LocV) (Val (natV 1))) (Val unitV)
    | LetLam => LamV nL SeqBody
    | LocExpr => LocAdd (Val (LitV (LitLoc a))) (Val (natV i))
    | PhiLoc : Value -> iProp S => \lam v =>
        wp H mscE (App (Val LetLam) (Val v)) Post
    | seqAt : properUPred_ent Pre (wp H mscE SeqAt Post) =>
        msc_incr_seq_wp H G gam a i hi P Q
    | continue : properUPred_ent Pre (PhiLoc LocV) =>
        properUPred_ent_trans Pre (wp H mscE SeqAt Post)
          (PhiLoc LocV) seqAt
          (wp_lam_beta H mscE nL SeqBody LocV Post)
    | locValue : properUPred_ent Pre
        (wp H mscE (Val LocV) PhiLoc) =>
        properUPred_ent_trans Pre (PhiLoc LocV)
          (wp H mscE (Val LocV) PhiLoc) continue
          (wp_value_intro H mscE LocV PhiLoc)
    | locExpr : properUPred_ent Pre (wp H mscE LocExpr PhiLoc) =>
        properUPred_ent_trans Pre (wp H mscE (Val LocV) PhiLoc)
          (wp H mscE LocExpr PhiLoc) locValue
          (wp_loc_add H mscE a i PhiLoc)
    | valueLet : properUPred_ent Pre
        (wp H mscE (App (Val LetLam) LocExpr) Post) =>
        properUPred_ent_trans Pre (wp H mscE LocExpr PhiLoc)
          (wp H mscE (App (Val LetLam) LocExpr) Post) locExpr
          (wp_bind_app_r H mscE LetLam LocExpr Post)
    | surface : properUPred_ent
        (wp H mscE (App (Val LetLam) LocExpr) Post)
        (wp H mscE (App (Lam nL SeqBody) LocExpr) Post) =>
        \let | LamPost : Value -> iProp S => \lam vf =>
          wp H mscE (App (Val vf) LocExpr) Post
        \in properUPred_ent_trans
          (wp H mscE (App (Val LetLam) LocExpr) Post)
          (wp H mscE (Val LetLam) LamPost)
          (wp H mscE (App (Lam nL SeqBody) LocExpr) Post)
          (wp_value_intro H mscE LetLam LamPost)
          (properUPred_ent_trans (wp H mscE (Val LetLam) LamPost)
            (wp H mscE (Lam nL SeqBody) LamPost)
            (wp H mscE (App (Lam nL SeqBody) LocExpr) Post)
            (wp_lam_expr H mscE nL SeqBody LamPost)
            (wp_bind_app_l H mscE (Lam nL SeqBody) LocExpr Post))
  \in properUPred_ent_trans Pre
      (wp H mscE (App (Val LetLam) LocExpr) Post)
      (wp H mscE (letE nL LocExpr SeqBody) Post)
      valueLet surface

\lemma msc_incr_body_wp {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a i : Nat) (hi : nat_lt i gam.msc_size)
    (P : iProp S) (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep
      (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a))
      (mkProperSep (msc_incr_shift H G gam P Q) P))
    (wp H mscE
      (letE nA
        (Fst (Val (PairV (LitV (LitLoc a)) (natV gam.msc_size))))
        (letE nL (LocAdd (Var nA) (Val (natV i)))
          (seqE (FAA (Var nL) (Val (natV 1))) (Val unitV))))
      (msc_incr_core_post Q)) =>
  \let
    | Pre => mkProperSep
        (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
          (msc_inv H G gam a))
        (mkProperSep (msc_incr_shift H G gam P Q) P)
    | Post => msc_incr_core_post Q
    | LocV => LitV (LitLoc a)
    | PairV0 => PairV LocV (natV gam.msc_size)
    | BodyA => letE nL (LocAdd (Var nA) (Val (natV i)))
        (seqE (FAA (Var nL) (Val (natV 1))) (Val unitV))
    | BodyAt => letE nL (LocAdd (Val LocV) (Val (natV i)))
        (seqE (FAA (Var nL) (Val (natV 1))) (Val unitV))
    | LetLam => LamV nA BodyA
    | FstExpr => Fst (Val PairV0)
    | PhiFst : Value -> iProp S => \lam v =>
        wp H mscE (App (Val LetLam) (Val v)) Post
    | bodyAt : properUPred_ent Pre (wp H mscE BodyAt Post) =>
        msc_incr_loc_let_wp H G gam a i hi P Q
    | continue : properUPred_ent Pre (PhiFst LocV) =>
        properUPred_ent_trans Pre (wp H mscE BodyAt Post)
          (PhiFst LocV) bodyAt
          (wp_lam_beta H mscE nA BodyA LocV Post)
    | fstValue : properUPred_ent Pre
        (wp H mscE (Val LocV) PhiFst) =>
        properUPred_ent_trans Pre (PhiFst LocV)
          (wp H mscE (Val LocV) PhiFst) continue
          (wp_value_intro H mscE LocV PhiFst)
    | fstExpr : properUPred_ent Pre (wp H mscE FstExpr PhiFst) =>
        properUPred_ent_trans Pre (wp H mscE (Val LocV) PhiFst)
          (wp H mscE FstExpr PhiFst) fstValue
          (wp_fst_pair H mscE LocV (natV gam.msc_size) PhiFst)
    | valueLet : properUPred_ent Pre
        (wp H mscE (App (Val LetLam) FstExpr) Post) =>
        properUPred_ent_trans Pre (wp H mscE FstExpr PhiFst)
          (wp H mscE (App (Val LetLam) FstExpr) Post) fstExpr
          (wp_bind_app_r H mscE LetLam FstExpr Post)
    | surface : properUPred_ent
        (wp H mscE (App (Val LetLam) FstExpr) Post)
        (wp H mscE (App (Lam nA BodyA) FstExpr) Post) =>
        \let | LamPost : Value -> iProp S => \lam vf =>
          wp H mscE (App (Val vf) FstExpr) Post
        \in properUPred_ent_trans
          (wp H mscE (App (Val LetLam) FstExpr) Post)
          (wp H mscE (Val LetLam) LamPost)
          (wp H mscE (App (Lam nA BodyA) FstExpr) Post)
          (wp_value_intro H mscE LetLam LamPost)
          (properUPred_ent_trans (wp H mscE (Val LetLam) LamPost)
            (wp H mscE (Lam nA BodyA) LamPost)
            (wp H mscE (App (Lam nA BodyA) FstExpr) Post)
            (wp_lam_expr H mscE nA BodyA LamPost)
            (wp_bind_app_l H mscE (Lam nA BodyA) FstExpr Post))
  \in properUPred_ent_trans Pre
      (wp H mscE (App (Val LetLam) FstExpr) Post)
      (wp H mscE (letE nA FstExpr BodyA) Post)
      valueLet surface

\lemma msc_incr_specialized_wp {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (a i : Nat) (hi : nat_lt i gam.msc_size)
    (P : iProp S) (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep
      (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
        (msc_inv H G gam a))
      (mkProperSep (msc_incr_shift H G gam P Q) P))
    (wp H mscE
      (app2 (Val msc_incr)
        (Val (PairV (LitV (LitLoc a)) (natV gam.msc_size)))
        (Val (natV i)))
      (msc_incr_core_post Q)) =>
  \let
    | Pre => mkProperSep
        (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
          (msc_inv H G gam a))
        (mkProperSep (msc_incr_shift H G gam P Q) P)
    | Post => msc_incr_core_post Q
    | CounterV => PairV (LitV (LitLoc a)) (natV gam.msc_size)
    | HandleV => natV i
    | BodyGeneric => letE nA (Fst (Var nC))
        (letE nL (LocAdd (Var nA) (Var nK))
          (seqE (FAA (Var nL) (Val (natV 1))) (Val unitV)))
    | BodyC => letE nA (Fst (Val CounterV))
        (letE nL (LocAdd (Var nA) (Var nK))
          (seqE (FAA (Var nL) (Val (natV 1))) (Val unitV)))
    | BodyAt => letE nA (Fst (Val CounterV))
        (letE nL (LocAdd (Var nA) (Val HandleV))
          (seqE (FAA (Var nL) (Val (natV 1))) (Val unitV)))
    | InnerLam => LamV nK BodyC
    | OuterApp => App (Val msc_incr) (Val CounterV)
    | PhiOuter : Value -> iProp S => \lam vf =>
        wp H mscE (App (Val vf) (Val HandleV)) Post
    | body : properUPred_ent Pre (wp H mscE BodyAt Post) =>
        msc_incr_body_wp H G gam a i hi P Q
    | innerApp : properUPred_ent Pre (PhiOuter InnerLam) =>
        properUPred_ent_trans Pre (wp H mscE BodyAt Post)
          (PhiOuter InnerLam) body
          (wp_lam_beta H mscE nK BodyC HandleV Post)
    | innerValue : properUPred_ent Pre
        (wp H mscE (Val InnerLam) PhiOuter) =>
        properUPred_ent_trans Pre (PhiOuter InnerLam)
          (wp H mscE (Val InnerLam) PhiOuter) innerApp
          (wp_value_intro H mscE InnerLam PhiOuter)
    | innerExpr : properUPred_ent Pre
        (wp H mscE (Lam nK BodyC) PhiOuter) =>
        properUPred_ent_trans Pre (wp H mscE (Val InnerLam) PhiOuter)
          (wp H mscE (Lam nK BodyC) PhiOuter) innerValue
          (wp_lam_expr H mscE nK BodyC PhiOuter)
    | outerBeta : properUPred_ent Pre (wp H mscE OuterApp PhiOuter) =>
        properUPred_ent_trans Pre (wp H mscE (Lam nK BodyC) PhiOuter)
          (wp H mscE OuterApp PhiOuter) innerExpr
          (wp_lam_beta H mscE nC (Lam nK BodyGeneric) CounterV PhiOuter)
  \in properUPred_ent_trans Pre (wp H mscE OuterApp PhiOuter)
      (wp H mscE (App OuterApp (Val HandleV)) Post)
      outerBeta
      (wp_bind_app_l H mscE OuterApp (Val HandleV) Post)

\func msc_incr_post {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (c h : Value) (Q : Nat -> iProp S) (v : Value) : iProp S =>
  mkProperAnd (mkProperPure (v = unitV))
    (mkProperSep (msc_is_counter H G gam c)
      (mkProperSep (msc_handle G gam h) (msc_incr_result Q)))

\lemma msc_incr_post_frame {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (c h : Value) (Q : Nat -> iProp S) (v : Value) :
  properUPred_ent
    (mkProperSep (msc_incr_core_post Q v)
      (mkProperSep (msc_is_counter H G gam c) (msc_handle G gam h)))
    (msc_incr_post H G gam c h Q v) =>
  \let
    | PureV => mkProperPure {iResUR S} (v = unitV)
    | Result => msc_incr_result Q
    | CorePost => mkProperAnd PureV Result
    | Public => mkProperSep (msc_is_counter H G gam c) (msc_handle G gam h)
    | Source => mkProperSep CorePost Public
    | TargetBody => mkProperSep (msc_is_counter H G gam c)
        (mkProperSep (msc_handle G gam h) Result)
    | left : properUPred_ent Source PureV =>
        properUPred_ent_trans Source CorePost PureV
          (sep_elim_l_ent CorePost Public)
          (and_elim_l_ent PureV Result)
    | right : properUPred_ent Source TargetBody =>
        properUPred_ent_trans Source (mkProperSep Public CorePost) TargetBody
          (sep_comm_ent CorePost Public)
          (properUPred_ent_trans (mkProperSep Public CorePost)
            (mkProperSep Public Result) TargetBody
            (sep_mono_r_ent Public CorePost Result
              (and_elim_r_ent PureV Result))
            (sep_assoc_l_ent (msc_is_counter H G gam c)
              (msc_handle G gam h) Result))
  \in (BIuPredMixin (iResUR S)).bi_mixin_and_intro Source
      PureV TargetBody left right

\lemma msc_incr_prepare_public {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (c h : Value) (P : iProp S) (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep (msc_incr_shift H G gam P Q)
      (mkProperSep (msc_is_counter H G gam c)
        (mkProperSep (msc_handle G gam h) P)))
    (mkProperSep (msc_is_counter H G gam c)
      (mkProperSep (msc_handle G gam h)
        (mkProperSep (msc_incr_shift H G gam P Q)
          (mkProperSep P
            (mkProperSep (msc_is_counter H G gam c)
              (msc_handle G gam h)))))) =>
  \let
    | VS => msc_incr_shift H G gam P Q
    | C => msc_is_counter H G gam c
    | Hd => msc_handle G gam h
    | Source => mkProperSep VS (mkProperSep C (mkProperSep Hd P))
    | Public => mkProperSep C Hd
    | D1 => mkProperSep Source C
    | D2 => mkProperSep D1 Hd
    | A1 => mkProperSep Source Public
    | A2 => mkProperSep VS (mkProperSep (mkProperSep C (mkProperSep Hd P)) Public)
    | A3 => mkProperSep VS (mkProperSep C
        (mkProperSep (mkProperSep Hd P) Public))
    | A4 => mkProperSep C (mkProperSep VS
        (mkProperSep (mkProperSep Hd P) Public))
    | A5 => mkProperSep C (mkProperSep VS
        (mkProperSep Hd (mkProperSep P Public)))
    | Target => mkProperSep C (mkProperSep Hd
        (mkProperSep VS (mkProperSep P Public)))
    | sourceToC : properUPred_ent Source C =>
        properUPred_ent_trans Source (mkProperSep C (mkProperSep Hd P)) C
          (sep_elim_r_ent VS (mkProperSep C (mkProperSep Hd P)))
          (sep_elim_l_ent C (mkProperSep Hd P))
    | sourceToPC : properUPred_ent Source (mkProperPersistently C) =>
        properUPred_ent_trans Source C (mkProperPersistently C)
          sourceToC (msc_is_counter_persistent H G gam c)
    | duplicateC : properUPred_ent Source D1 =>
        persistent_consequence_frame_ent Source C sourceToPC
    | d1ToH : properUPred_ent D1 Hd =>
        properUPred_ent_trans D1 Source Hd
          (sep_elim_l_ent Source C)
          (properUPred_ent_trans Source (mkProperSep C (mkProperSep Hd P)) Hd
            (sep_elim_r_ent VS (mkProperSep C (mkProperSep Hd P)))
            (properUPred_ent_trans (mkProperSep C (mkProperSep Hd P))
              (mkProperSep Hd P) Hd
              (sep_elim_r_ent C (mkProperSep Hd P))
              (sep_elim_l_ent Hd P)))
    | d1ToPH : properUPred_ent D1 (mkProperPersistently Hd) =>
        properUPred_ent_trans D1 Hd (mkProperPersistently Hd)
          d1ToH (msc_handle_persistent G gam h)
    | duplicateH : properUPred_ent D1 D2 =>
        persistent_consequence_frame_ent D1 Hd d1ToPH
    | arrange : properUPred_ent D2 Target =>
        properUPred_ent_trans D2 A1 Target
          (sep_assoc_l_ent Source C Hd)
          (properUPred_ent_trans A1 A2 Target
            (sep_assoc_l_ent VS (mkProperSep C (mkProperSep Hd P)) Public)
            (properUPred_ent_trans A2 A3 Target
              (sep_mono_r_ent VS
                (mkProperSep (mkProperSep C (mkProperSep Hd P)) Public)
                (mkProperSep C (mkProperSep (mkProperSep Hd P) Public))
                (sep_assoc_l_ent C (mkProperSep Hd P) Public))
              (properUPred_ent_trans A3 A4 Target
                (sep_swap_ent VS C (mkProperSep (mkProperSep Hd P) Public))
                (properUPred_ent_trans A4 A5 Target
                  (sep_mono_r_ent C
                    (mkProperSep VS (mkProperSep (mkProperSep Hd P) Public))
                    (mkProperSep VS (mkProperSep Hd (mkProperSep P Public)))
                    (sep_mono_r_ent VS
                      (mkProperSep (mkProperSep Hd P) Public)
                      (mkProperSep Hd (mkProperSep P Public))
                      (sep_assoc_l_ent Hd P Public)))
                  (sep_mono_r_ent C
                    (mkProperSep VS (mkProperSep Hd (mkProperSep P Public)))
                    (mkProperSep Hd (mkProperSep VS (mkProperSep P Public)))
                    (sep_swap_ent VS Hd (mkProperSep P Public)))))))
  \in properUPred_ent_trans Source D1 Target duplicateC
      (properUPred_ent_trans D1 D2 Target duplicateH arrange)

\lemma msc_incr_spec {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (c h : Value) (P : iProp S) (Q : Nat -> iProp S) :
  properUPred_ent
    (mkProperSep (msc_incr_shift H G gam P Q)
      (mkProperSep (msc_is_counter H G gam c)
        (mkProperSep (msc_handle G gam h) P)))
    (wp H mscE (app2 (Val msc_incr) (Val c) (Val h))
      (msc_incr_post H G gam c h Q)) =>
  \let
    | VS => msc_incr_shift H G gam P Q
    | C => msc_is_counter H G gam c
    | Hd => msc_handle G gam h
    | Public => mkProperSep C Hd
    | Prepared => mkProperSep C
        (mkProperSep Hd (mkProperSep VS (mkProperSep P Public)))
    | Goal => wp H mscE (app2 (Val msc_incr) (Val c) (Val h))
        (msc_incr_post H G gam c h Q)
    | CounterBody : Nat -> iProp S => \lam a =>
        mkProperSep
          (mkProperPure
            (c = PairV (LitV (LitLoc a)) (natV gam.msc_size)))
          (iris.base_logic.lib.invariants.inv H.iris_wsat mscN
            (msc_inv H G gam a))
    | CounterRest => mkProperSep Hd
        (mkProperSep VS (mkProperSep P Public))
    | perCounter : \Pi (a : Nat) -> properUPred_ent
        (mkProperSep (CounterBody a) CounterRest) Goal =>
        \lam a =>
          \let
            | CounterV => PairV (LitV (LitLoc a)) (natV gam.msc_size)
            | Inv => iris.base_logic.lib.invariants.inv H.iris_wsat mscN
                (msc_inv H G gam a)
            | Tail => mkProperSep VS (mkProperSep P Public)
            | AfterCounterPure => mkProperSep Inv (mkProperSep Hd Tail)
            | HandleReady => mkProperSep Hd (mkProperSep Inv Tail)
            | HandleBody : Nat -> iProp S => \lam i =>
                mkProperSep (mkProperPure (h = natV i))
                  (mkProperPure (nat_lt i gam.msc_size))
            | HandleRest => mkProperSep Inv Tail
            | afterCounter : properUPred_ent
                (mkProperSep (CounterBody a) CounterRest)
                (mkProperSep
                  (mkProperPure (c = CounterV)) AfterCounterPure) =>
                sep_assoc_l_ent (mkProperPure (c = CounterV)) Inv CounterRest
            | useCounterEq : (c = CounterV) -> properUPred_ent
                AfterCounterPure Goal => \lam eqC =>
                \let
                  | toHandle : properUPred_ent AfterCounterPure HandleReady =>
                      sep_swap_ent Inv Hd Tail
                  | perHandle : \Pi (i : Nat) -> properUPred_ent
                      (mkProperSep (HandleBody i) HandleRest) Goal =>
                      \lam i =>
                        \let
                          | HandleV => natV i
                          | A0 => mkProperSep (HandleBody i) HandleRest
                          | A1 => mkProperSep (mkProperPure (h = HandleV))
                              (mkProperSep
                                (mkProperPure (nat_lt i gam.msc_size))
                                HandleRest)
                          | useHandleEq : (h = HandleV) -> properUPred_ent
                              (mkProperSep
                                (mkProperPure (nat_lt i gam.msc_size))
                                HandleRest) Goal => \lam eqH =>
                              pure_sep_l_elim (nat_lt i gam.msc_size)
                                HandleRest Goal (\lam hi =>
                                  \let
                                    | Core => mkProperSep Inv
                                        (mkProperSep VS P)
                                    | Ready => mkProperSep Core Public
                                    | Specialized => app2 (Val msc_incr)
                                        (Val CounterV) (Val HandleV)
                                    | CorePost => msc_incr_core_post Q
                                    | PublicPost => msc_incr_post H G gam c h Q
                                    | FramePost => wp_frame_post CorePost Public
                                    | arrangeCore : properUPred_ent HandleRest Ready =>
                                        properUPred_ent_trans HandleRest
                                          (mkProperSep Inv
                                            (mkProperSep (mkProperSep VS P) Public))
                                          Ready
                                          (sep_mono_r_ent Inv
                                            (mkProperSep VS (mkProperSep P Public))
                                            (mkProperSep (mkProperSep VS P) Public)
                                            (sep_assoc_r_ent VS P Public))
                                          (sep_assoc_r_ent Inv
                                            (mkProperSep VS P) Public)
                                    | framedWP : properUPred_ent Ready
                                        (wp H mscE Specialized FramePost) =>
                                        properUPred_ent_trans Ready
                                          (mkProperSep
                                            (wp H mscE Specialized CorePost) Public)
                                          (wp H mscE Specialized FramePost)
                                          (sep_mono_l_ent Core
                                            (wp H mscE Specialized CorePost) Public
                                            (msc_incr_specialized_wp H G gam
                                              a i hi P Q))
                                          (wp_frame_r H mscE Specialized
                                            CorePost Public)
                                    | postMono : properUPred_ent
                                        (wp H mscE Specialized FramePost)
                                        (wp H mscE Specialized PublicPost) =>
                                        wp_mono H mscE Specialized FramePost
                                          PublicPost (\lam v =>
                                            msc_incr_post_frame H G gam c h Q v)
                                    | specializedProgram : properUPred_ent
                                        HandleRest
                                        (wp H mscE Specialized PublicPost) =>
                                        properUPred_ent_trans HandleRest Ready
                                          (wp H mscE Specialized PublicPost)
                                          arrangeCore
                                          (properUPred_ent_trans Ready
                                            (wp H mscE Specialized FramePost)
                                            (wp H mscE Specialized PublicPost)
                                            framedWP postMono)
                                  \in transport2 (\lam cc hh => properUPred_ent
                                      HandleRest
                                      (wp H mscE
                                        (app2 (Val msc_incr) (Val cc) (Val hh))
                                        PublicPost))
                                    (inv eqC) (inv eqH) specializedProgram)
                        \in properUPred_ent_trans A0 A1 Goal
                            (sep_assoc_l_ent
                              (mkProperPure (h = HandleV))
                              (mkProperPure (nat_lt i gam.msc_size)) HandleRest)
                            (pure_sep_l_elim (h = HandleV)
                              (mkProperSep
                                (mkProperPure (nat_lt i gam.msc_size))
                                HandleRest) Goal useHandleEq)
                \in properUPred_ent_trans AfterCounterPure HandleReady Goal
                    toHandle
                    (sep_exist_l_elim HandleBody HandleRest Goal perHandle)
          \in properUPred_ent_trans
              (mkProperSep (CounterBody a) CounterRest)
              (mkProperSep (mkProperPure (c = CounterV)) AfterCounterPure)
              Goal afterCounter
              (pure_sep_l_elim (c = CounterV) AfterCounterPure Goal useCounterEq)
  \in properUPred_ent_trans
      (mkProperSep VS (mkProperSep C (mkProperSep Hd P))) Prepared Goal
      (msc_incr_prepare_public H G gam c h P Q)
      (sep_exist_l_elim CounterBody CounterRest Goal perCounter)

-- All non-physical resources created by `msc_new_counter`, packaged around
-- one counter name.  Keeping this allocation independent of WP is useful for
-- both the constructor proof and closed adequacy initialization.
\func msc_initial_ghosts {S : gFunctors} (G : mscG S)
    (T : Nat) : iProp S =>
  mkProperExist1 msc_name (\lam gam =>
    mkProperSep (mkProperPure (gam.msc_size = T))
      (mkProperSep
        (mkProperSep
          (mkProperPure (length gam.msc_shard_names = T))
          (msc_mono_auths G (replicate T 0) gam.msc_shard_names))
        (mkProperSep
          (ghost_map_auth (msc_requestGS G gam) qp_one gempty)
          (mkProperSep (msc_counter_auth G gam 0)
            (msc_counter_frag G gam qp_one 0)))))

\lemma msc_initial_ghosts_alloc {S : gFunctors} (G : mscG S)
    (T : Nat) :
  properUPred_ent mkProperEmp (mkProperBUpd (msc_initial_ghosts G T)) =>
  \let
    | Model => mkProperExist gname (\lam gam =>
        mkProperSep (msc_auth G.msc_modelG gam 0)
          (msc_frag G.msc_modelG gam qp_one 0))
    | Requests => mkProperExist gname (\lam gamR =>
        ghost_map_auth
          (\new gen_heapGS {
            | gen_heap_inG => G.msc_request_mapG.gen_heap_inG
            | gen_heap_name => gamR
          }) qp_one gempty)
    | Shards => mkProperExist (List gname) (\lam gams =>
        mkProperSep (mkProperPure (length gams = T))
          (msc_mono_auths G (replicate T 0) gams))
    | assemble : properUPred_ent
        (mkProperSep Shards (mkProperSep Requests Model))
        (msc_initial_ghosts G T) =>
        \lam n x hx hall => \case hall \with {
          | inP (xs, xrest, dx, inP (gams, hshards), hrest) =>
            \case hrest \with {
              | inP (xr, xm, drest, inP (gamR, hreq), inP (gamM, hmodel)) =>
                \let
                  | gam : msc_name => \new msc_name {
                      | msc_model_name => gamM
                      | msc_size => T
                      | msc_shard_names => gams
                      | msc_request_name => gamR
                    }
                  | M => iResUR S
                  | dtotal : M.dist n x
                      (M.op xs (M.op xr xm)) =>
                      M.ofe_dist_trans n x (M.op xs xrest)
                        (M.op xs (M.op xr xm)) dx
                        (M.cmra_op_ne xs n xrest (M.op xr xm) drest)
                \in inP (gam,
                  inP (M.unit, x,
                    M.ofe_dist_sym n (M.op M.unit x) x
                      (ucmra_unit_left_id_dist {M} n x), idp,
                    inP (xs, M.op xr xm, dtotal, hshards,
                      inP (xr, xm, M.ofe_dist_refl n (M.op xr xm),
                        hreq, hmodel))))
            }
        }
  \in bupd_alloc_three_then Model Requests Shards
      (msc_initial_ghosts G T)
      (msc_model_alloc G.msc_modelG 0)
      (ghost_map_alloc_empty_name G.msc_request_mapG)
      (msc_mono_alloc_zeros G T)
      assemble

-- The resource permutation used when the constructor seals its initial
-- physical and ghost state into the invariant.  `P` is a pure length fact
-- which is deliberately discarded here and reintroduced from its proof.
\lemma msc_initial_resource_reorder {M : UCMRA}
    (P Q R S T U : ProperUPred M) :
  properUPred_ent
    (mkProperSep
      (mkProperSep (mkProperSep P Q)
        (mkProperSep R (mkProperSep S T))) U)
    (mkProperSep T
      (mkProperSep S
        (mkProperSep (mkProperSep U Q) R))) =>
  \let
    | A0 => mkProperSep
        (mkProperSep (mkProperSep P Q)
          (mkProperSep R (mkProperSep S T))) U
    | A1 => mkProperSep
        (mkProperSep Q (mkProperSep R (mkProperSep S T))) U
    | QR => mkProperSep Q R
    | ST => mkProperSep S T
    | TS => mkProperSep T S
    | A2 => mkProperSep (mkProperSep QR ST) U
    | A3 => mkProperSep QR (mkProperSep ST U)
    | A4 => mkProperSep ST (mkProperSep QR U)
    | A5 => mkProperSep ST (mkProperSep U QR)
    | A6 => mkProperSep TS (mkProperSep U QR)
    | A7 => mkProperSep T (mkProperSep S (mkProperSep U QR))
    | A8 => mkProperSep T
        (mkProperSep S (mkProperSep (mkProperSep U Q) R))
    | drop : properUPred_ent A0 A1 =>
        sep_mono_l_ent
          (mkProperSep (mkProperSep P Q)
            (mkProperSep R (mkProperSep S T)))
          (mkProperSep Q (mkProperSep R (mkProperSep S T))) U
          (sep_mono_l_ent (mkProperSep P Q) Q
            (mkProperSep R (mkProperSep S T))
            (sep_elim_r_ent P Q))
    | group : properUPred_ent A1 A2 =>
        sep_mono_l_ent
          (mkProperSep Q (mkProperSep R ST))
          (mkProperSep QR ST) U
          (sep_assoc_r_ent Q R ST)
    | rotate : properUPred_ent A2 A4 =>
        properUPred_ent_trans A2 A3 A4
          (sep_assoc_l_ent QR ST U)
          (sep_swap_ent QR ST U)
    | swapRight : properUPred_ent A4 A5 =>
        sep_mono_r_ent ST (mkProperSep QR U)
          (mkProperSep U QR) (sep_comm_ent QR U)
    | swapLeft : properUPred_ent A5 A6 =>
        sep_mono_l_ent ST TS (mkProperSep U QR)
          (sep_comm_ent S T)
    | associateLeft : properUPred_ent A6 A7 =>
        sep_assoc_l_ent T S (mkProperSep U QR)
    | associateRight : properUPred_ent A7 A8 =>
        sep_mono_r_ent T
          (mkProperSep S (mkProperSep U QR))
          (mkProperSep S (mkProperSep (mkProperSep U Q) R))
          (sep_mono_r_ent S (mkProperSep U QR)
            (mkProperSep (mkProperSep U Q) R)
            (sep_assoc_r_ent U Q R))
  \in properUPred_ent_trans A0 A1 A8 drop
      (properUPred_ent_trans A1 A2 A8 group
        (properUPred_ent_trans A2 A4 A8 rotate
          (properUPred_ent_trans A4 A5 A8 swapRight
            (properUPred_ent_trans A5 A6 A8 swapLeft
              (properUPred_ent_trans A6 A7 A8 associateLeft
                associateRight)))))

\func msc_initial_fixed {S : gFunctors} (G : mscG S)
    (gam : msc_name) (T : Nat) : iProp S =>
  mkProperSep
    (mkProperSep
      (mkProperPure (length gam.msc_shard_names = T))
      (msc_mono_auths G (replicate T 0) gam.msc_shard_names))
    (mkProperSep
      (ghost_map_auth (msc_requestGS G gam) qp_one gempty)
      (mkProperSep (msc_counter_auth G gam 0)
        (msc_counter_frag G gam qp_one 0)))

\lemma msc_initial_fixed_to_frag_inv {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (T a : Nat)
    (hsize : gam.msc_size = T) :
  properUPred_ent
    (mkProperSep (msc_initial_fixed G gam T)
      (pointsto_array H.iris_gen_heap suc a
        (replicate T (natV 0))))
    (mkProperSep (msc_counter_frag G gam qp_one 0)
      (msc_inv H G gam a)) =>
  \let
    | Len => mkProperPure {iResUR S}
        (length gam.msc_shard_names = T)
    | Mono => msc_mono_auths G (replicate T 0) gam.msc_shard_names
    | Req => ghost_map_auth (msc_requestGS G gam) qp_one gempty
    | Auth => msc_counter_auth G gam 0
    | Frag => msc_counter_frag G gam qp_one 0
    | Array0 => pointsto_array H.iris_gen_heap suc a
        (replicate T (natV 0))
    | ArrayN => pointsto_array H.iris_gen_heap suc a
        (map natV (replicate T 0))
    | Requests0 => msc_requests H G gam 0 gempty
    | Core0 => mkProperSep Frag
        (mkProperSep Auth
          (mkProperSep (mkProperSep Array0 Mono) Req))
    | Core1 => mkProperSep Frag
        (mkProperSep Auth
          (mkProperSep (mkProperSep ArrayN Mono) Requests0))
    | InvBody => mkProperSep
        (mkProperPure {iResUR S} (length (replicate T 0) = gam.msc_size))
        (mkProperSep
          (mkProperPure (length gam.msc_shard_names = gam.msc_size))
          (mkProperSep
            (msc_counter_auth G gam (nat_sum (replicate T 0)))
            (mkProperSep
              (msc_shards H G a (replicate T 0) gam.msc_shard_names)
              (msc_requests H G gam (nat_sum (replicate T 0)) gempty))))
    | reordered : properUPred_ent
        (mkProperSep (msc_initial_fixed G gam T) Array0) Core0 =>
        msc_initial_resource_reorder Len Mono Req Auth Frag Array0
    | reqEmp : properUPred_ent Req Requests0 =>
        attach_valid_r_ent Req (mkProperEmp {iResUR S})
          (properUPred_ent_refl (mkProperEmp {iResUR S}))
    | arrayConvert : properUPred_ent Array0 ArrayN =>
        transport (\lam values => properUPred_ent Array0
          (pointsto_array H.iris_gen_heap suc a values))
          (inv (map_natV_replicate_zero T))
          (properUPred_ent_refl Array0)
    | converted : properUPred_ent Core0 Core1 =>
        sep_mono_r_ent Frag
          (mkProperSep Auth (mkProperSep (mkProperSep Array0 Mono) Req))
          (mkProperSep Auth
            (mkProperSep (mkProperSep ArrayN Mono) Requests0))
          (sep_mono_r_ent Auth
            (mkProperSep (mkProperSep Array0 Mono) Req)
            (mkProperSep (mkProperSep ArrayN Mono) Requests0)
            (properUPred_ent_trans
              (mkProperSep (mkProperSep Array0 Mono) Req)
              (mkProperSep (mkProperSep ArrayN Mono) Req)
              (mkProperSep (mkProperSep ArrayN Mono) Requests0)
              (sep_mono_l_ent (mkProperSep Array0 Mono)
                (mkProperSep ArrayN Mono) Req
                (sep_mono_l_ent Array0 ArrayN Mono arrayConvert))
              (sep_mono_r_ent (mkProperSep ArrayN Mono) Req
                Requests0 reqEmp)))
    | hlenNs : length (replicate T 0) = gam.msc_size =>
        length_replicate *> inv hsize
    | hlenGams : length gam.msc_shard_names = T ->
        length gam.msc_shard_names = gam.msc_size =>
        \lam h => h *> inv hsize
    | authConvert : properUPred_ent Auth
        (msc_counter_auth G gam (nat_sum (replicate T 0))) =>
        transport (\lam total => properUPred_ent Auth
          (msc_counter_auth G gam total))
          (inv (nat_sum_replicate_zero T))
          (properUPred_ent_refl Auth)
    | coreToInvBody : length gam.msc_shard_names = T ->
        properUPred_ent
          (mkProperSep Auth
            (mkProperSep (mkProperSep ArrayN Mono) Requests0)) InvBody =>
        \lam hlen =>
        properUPred_ent_trans
          (mkProperSep Auth
            (mkProperSep (mkProperSep ArrayN Mono) Requests0))
          (mkProperSep
            (msc_counter_auth G gam (nat_sum (replicate T 0)))
            (mkProperSep (mkProperSep ArrayN Mono) Requests0)) InvBody
          (sep_mono_l_ent Auth
            (msc_counter_auth G gam (nat_sum (replicate T 0)))
            (mkProperSep (mkProperSep ArrayN Mono) Requests0)
            authConvert)
          (properUPred_ent_trans
            (mkProperSep
              (msc_counter_auth G gam (nat_sum (replicate T 0)))
              (mkProperSep (mkProperSep ArrayN Mono) Requests0))
            (mkProperSep
              (mkProperPure
                (length gam.msc_shard_names = gam.msc_size))
              (mkProperSep
                (msc_counter_auth G gam (nat_sum (replicate T 0)))
                (mkProperSep (mkProperSep ArrayN Mono) Requests0)))
            InvBody
            (pure_intro_sep_ent
              (length gam.msc_shard_names = gam.msc_size)
              (hlenGams hlen)
              (mkProperSep
                (msc_counter_auth G gam (nat_sum (replicate T 0)))
                (mkProperSep (mkProperSep ArrayN Mono) Requests0)))
            (pure_intro_sep_ent
              (length (replicate T 0) = gam.msc_size) hlenNs
              (mkProperSep
                (mkProperPure
                  (length gam.msc_shard_names = gam.msc_size))
                (mkProperSep
                  (msc_counter_auth G gam (nat_sum (replicate T 0)))
                  (mkProperSep (mkProperSep ArrayN Mono) Requests0)))))
    | finish : length gam.msc_shard_names = T ->
        properUPred_ent Core1
          (mkProperSep Frag (msc_inv H G gam a)) =>
        \lam hlen =>
        sep_mono_r_ent Frag
          (mkProperSep Auth
            (mkProperSep (mkProperSep ArrayN Mono) Requests0))
          (msc_inv H G gam a)
          (properUPred_ent_trans
            (mkProperSep Auth
              (mkProperSep (mkProperSep ArrayN Mono) Requests0))
            InvBody (msc_inv H G gam a) (coreToInvBody hlen)
            (properUPred_ent_trans InvBody
              (mkProperExist (Gmap Nat natCountable (\Sigma Nat gname))
                (\lam requests => mkProperSep
                  (mkProperPure (length (replicate T 0) = gam.msc_size))
                  (mkProperSep
                    (mkProperPure
                      (length gam.msc_shard_names = gam.msc_size))
                    (mkProperSep
                      (msc_counter_auth G gam (nat_sum (replicate T 0)))
                      (mkProperSep
                        (msc_shards H G a (replicate T 0)
                          gam.msc_shard_names)
                        (msc_requests H G gam
                          (nat_sum (replicate T 0)) requests))))))
              (msc_inv H G gam a)
              (exist_intro_ent (\lam requests => mkProperSep
                (mkProperPure (length (replicate T 0) = gam.msc_size))
                (mkProperSep
                  (mkProperPure
                    (length gam.msc_shard_names = gam.msc_size))
                  (mkProperSep
                    (msc_counter_auth G gam (nat_sum (replicate T 0)))
                    (mkProperSep
                      (msc_shards H G a (replicate T 0)
                        gam.msc_shard_names)
                      (msc_requests H G gam
                        (nat_sum (replicate T 0)) requests))))) gempty)
              (exist_intro_ent (\lam ns => mkProperExist
                (Gmap Nat natCountable (\Sigma Nat gname))
                (\lam requests => mkProperSep
                  (mkProperPure (length ns = gam.msc_size))
                  (mkProperSep
                    (mkProperPure
                      (length gam.msc_shard_names = gam.msc_size))
                    (mkProperSep (msc_counter_auth G gam (nat_sum ns))
                      (mkProperSep
                        (msc_shards H G a ns gam.msc_shard_names)
                        (msc_requests H G gam
                          (nat_sum ns) requests))))))
                (replicate T 0))))
    | conclude : length gam.msc_shard_names = T ->
        properUPred_ent
          (mkProperSep (msc_initial_fixed G gam T) Array0)
          (mkProperSep Frag (msc_inv H G gam a)) =>
        \lam hlen => properUPred_ent_trans
          (mkProperSep (msc_initial_fixed G gam T) Array0)
          Core0 (mkProperSep Frag (msc_inv H G gam a)) reordered
          (properUPred_ent_trans Core0 Core1
            (mkProperSep Frag (msc_inv H G gam a)) converted
            (finish hlen))
  \in \lam n x hx hsource => \case hsource \with {
    | inP (_, _, _, hfixed, _) => \case hfixed \with {
      | inP (_, _, _, hleft, _) => \case hleft \with {
        | inP (_, _, _, hlen, _) => conclude hlen n x hx hsource
      }
    }
  }

\lemma msc_initial_ghosts_array_to_frag_inv {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (T a : Nat) :
  properUPred_ent
    (mkProperSep (msc_initial_ghosts G T)
      (pointsto_array H.iris_gen_heap suc a
        (replicate T (natV 0))))
    (mkProperExist1 msc_name (\lam gam =>
      mkProperSep (mkProperPure (gam.msc_size = T))
        (mkProperSep (msc_counter_frag G gam qp_one 0)
          (msc_inv H G gam a)))) =>
  sep_exist1_l_elim
    (\lam gam => mkProperSep (mkProperPure (gam.msc_size = T))
      (msc_initial_fixed G gam T))
    (pointsto_array H.iris_gen_heap suc a (replicate T (natV 0)))
    (mkProperExist1 msc_name (\lam gam =>
      mkProperSep (mkProperPure (gam.msc_size = T))
        (mkProperSep (msc_counter_frag G gam qp_one 0)
          (msc_inv H G gam a))))
    (\lam gam =>
      \let
        | Array0 => pointsto_array H.iris_gen_heap suc a
            (replicate T (natV 0))
        | Source => mkProperSep
            (mkProperSep (mkProperPure (gam.msc_size = T))
              (msc_initial_fixed G gam T)) Array0
        | strip : properUPred_ent Source
            (mkProperSep (msc_initial_fixed G gam T) Array0) =>
            sep_mono_l_ent
              (mkProperSep (mkProperPure (gam.msc_size = T))
                (msc_initial_fixed G gam T))
              (msc_initial_fixed G gam T) Array0
              (sep_elim_r_ent (mkProperPure (gam.msc_size = T))
                (msc_initial_fixed G gam T))
        | conclude : gam.msc_size = T -> properUPred_ent Source
            (mkProperExist1 msc_name (\lam gam0 =>
              mkProperSep (mkProperPure (gam0.msc_size = T))
                (mkProperSep (msc_counter_frag G gam0 qp_one 0)
                  (msc_inv H G gam0 a)))) =>
            \lam hsize => properUPred_ent_trans Source
              (mkProperSep (msc_initial_fixed G gam T) Array0)
              (mkProperExist1 msc_name (\lam gam0 =>
                mkProperSep (mkProperPure (gam0.msc_size = T))
                  (mkProperSep (msc_counter_frag G gam0 qp_one 0)
                    (msc_inv H G gam0 a)))) strip
              (properUPred_ent_trans
                (mkProperSep (msc_initial_fixed G gam T) Array0)
                (mkProperSep (msc_counter_frag G gam qp_one 0)
                  (msc_inv H G gam a))
                (mkProperExist1 msc_name (\lam gam0 =>
                  mkProperSep (mkProperPure (gam0.msc_size = T))
                    (mkProperSep (msc_counter_frag G gam0 qp_one 0)
                      (msc_inv H G gam0 a))))
                (msc_initial_fixed_to_frag_inv H G gam T a hsize)
                (properUPred_ent_trans
                  (mkProperSep (msc_counter_frag G gam qp_one 0)
                    (msc_inv H G gam a))
                  (mkProperSep (mkProperPure (gam.msc_size = T))
                    (mkProperSep (msc_counter_frag G gam qp_one 0)
                      (msc_inv H G gam a)))
                  (mkProperExist1 msc_name (\lam gam0 =>
                    mkProperSep (mkProperPure (gam0.msc_size = T))
                      (mkProperSep (msc_counter_frag G gam0 qp_one 0)
                        (msc_inv H G gam0 a))))
                  (pure_intro_sep_ent (gam.msc_size = T) hsize
                    (mkProperSep (msc_counter_frag G gam qp_one 0)
                      (msc_inv H G gam a)))
                  (exist_intro_ent (\lam gam0 =>
                    mkProperSep (mkProperPure (gam0.msc_size = T))
                      (mkProperSep (msc_counter_frag G gam0 qp_one 0)
                        (msc_inv H G gam0 a))) gam)))
      \in \lam n x hx hsource => \case hsource \with {
        | inP (_, _, _, hleft, _) => \case hleft \with {
          | inP (_, _, _, hsize, _) => conclude hsize n x hx hsource
        }
      })

\func msc_new_counter_post {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (T : Nat) (c : Value) : iProp S =>
  mkProperExist1 msc_name (\lam gam =>
    mkProperSep (mkProperPure (gam.msc_size = T))
      (mkProperSep (msc_is_counter H G gam c)
        (mkProperSep (msc_handles G gam)
          (msc_counter_frag G gam qp_one 0))))

-- Seal the allocated array and ghost authorities into the counter invariant.
\lemma msc_initialize_counter {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (T a : Nat) :
  properUPred_ent
    (mkProperSep (msc_initial_ghosts G T)
      (pointsto_array H.iris_gen_heap suc a
        (replicate T (natV 0))))
    (mkProperFUpd H.iris_wsat mscE mscE
      (msc_new_counter_post H G T
        (PairV (LitV (LitLoc a)) (natV T)))) =>
  \let
    | Initial => mkProperSep (msc_initial_ghosts G T)
        (pointsto_array H.iris_gen_heap suc a
          (replicate T (natV 0)))
    | Mid => mkProperExist1 msc_name (\lam gam =>
      mkProperSep (mkProperPure (gam.msc_size = T))
        (mkProperSep (msc_counter_frag G gam qp_one 0)
          (msc_inv H G gam a)))
    | Target => mkProperFUpd H.iris_wsat mscE mscE
        (msc_new_counter_post H G T
          (PairV (LitV (LitLoc a)) (natV T)))
    | finish : properUPred_ent Mid Target =>
        exist_elim_ent (\lam gam =>
          mkProperSep (mkProperPure (gam.msc_size = T))
            (mkProperSep (msc_counter_frag G gam qp_one 0)
              (msc_inv H G gam a))) Target (\lam gam =>
        \let
          | Size => mkProperPure {iResUR S} (gam.msc_size = T)
          | Frag => msc_counter_frag G gam qp_one 0
          | Body => msc_inv H G gam a
          | Inv => iris.base_logic.lib.invariants.inv
              H.iris_wsat mscN Body
          | PairResult => PairV (LitV (LitLoc a)) (natV T)
          | Source => mkProperSep Size (mkProperSep Frag Body)
          | strip : properUPred_ent Source (mkProperSep Frag Body) =>
              sep_elim_r_ent Size (mkProperSep Frag Body)
          | enterLater : properUPred_ent (mkProperSep Frag Body)
              (mkProperSep (mkProperLater Body) Frag) =>
              properUPred_ent_trans (mkProperSep Frag Body)
                (mkProperSep Frag (mkProperLater Body))
                (mkProperSep (mkProperLater Body) Frag)
                (sep_mono_r_ent Frag Body (mkProperLater Body)
                  (proper_later_intro Body))
                (sep_comm_ent Frag (mkProperLater Body))
          | allocate : properUPred_ent
              (mkProperSep (mkProperLater Body) Frag)
              (mkProperFUpd H.iris_wsat mscE mscE
                (mkProperSep Inv Frag)) =>
              properUPred_ent_trans
                (mkProperSep (mkProperLater Body) Frag)
                (mkProperSep
                  (mkProperFUpd H.iris_wsat mscE mscE Inv) Frag)
                (mkProperFUpd H.iris_wsat mscE mscE
                  (mkProperSep Inv Frag))
                (sep_mono_l_ent (mkProperLater Body)
                  (mkProperFUpd H.iris_wsat mscE mscE Inv) Frag
                  (inv_alloc H.iris_wsat mscN mscE Body))
                (fupd_frame_r H.iris_wsat mscE mscE Inv Frag)
          | counterIntro : gam.msc_size = T -> properUPred_ent Inv
              (msc_is_counter H G gam PairResult) =>
              \lam hsize => properUPred_ent_trans Inv
                (mkProperSep
                  (mkProperPure
                    (PairResult = PairV (LitV (LitLoc a))
                      (natV gam.msc_size))) Inv)
                (msc_is_counter H G gam PairResult)
                (pure_intro_sep_ent
                  (PairResult = PairV (LitV (LitLoc a))
                    (natV gam.msc_size))
                  (pmap (PairV (LitV (LitLoc a)))
                    (pmap natV (inv hsize))) Inv)
                (exist_intro_ent (\lam l => mkProperSep
                  (mkProperPure
                    (PairResult = PairV (LitV (LitLoc l))
                      (natV gam.msc_size)))
                  (iris.base_logic.lib.invariants.inv H.iris_wsat
                    mscN (msc_inv H G gam l))) a)
          | assemble : gam.msc_size = T -> properUPred_ent
              (mkProperSep Inv Frag)
              (msc_new_counter_post H G T PairResult) =>
              \lam hsize =>
                \let
                  | Handles => msc_handles G gam
                  | WithHandles => mkProperSep
                      (msc_is_counter H G gam PairResult)
                      (mkProperSep Handles Frag)
                  | WithSize => mkProperSep Size WithHandles
                  | addHandles : properUPred_ent
                      (mkProperSep Inv Frag)
                      (mkProperSep Inv (mkProperSep Handles Frag)) =>
                      properUPred_ent_trans
                        (mkProperSep Inv Frag)
                        (mkProperSep Inv (mkProperSep Frag Handles))
                        (mkProperSep Inv (mkProperSep Handles Frag))
                        (sep_mono_r_ent Inv Frag
                          (mkProperSep Frag Handles)
                          (attach_valid_r_ent Frag Handles
                            (msc_make_handles G gam)))
                        (sep_mono_r_ent Inv
                          (mkProperSep Frag Handles)
                          (mkProperSep Handles Frag)
                          (sep_comm_ent Frag Handles))
                \in properUPred_ent_trans
                    (mkProperSep Inv Frag)
                    (mkProperSep Inv (mkProperSep Handles Frag))
                    (msc_new_counter_post H G T PairResult) addHandles
                    (properUPred_ent_trans
                      (mkProperSep Inv (mkProperSep Handles Frag))
                      WithHandles
                      (msc_new_counter_post H G T PairResult)
                      (sep_mono_l_ent Inv
                        (msc_is_counter H G gam PairResult)
                        (mkProperSep Handles Frag)
                        (counterIntro hsize))
                      (properUPred_ent_trans WithHandles WithSize
                        (msc_new_counter_post H G T PairResult)
                        (pure_intro_sep_ent (gam.msc_size = T) hsize
                          WithHandles)
                        (exist_intro_ent (\lam gam0 =>
                          mkProperSep
                            (mkProperPure (gam0.msc_size = T))
                            (mkProperSep
                              (msc_is_counter H G gam0 PairResult)
                              (mkProperSep (msc_handles G gam0)
                                (msc_counter_frag G gam0 qp_one 0)))) gam)))
          | conclude : gam.msc_size = T -> properUPred_ent Source
              (mkProperFUpd H.iris_wsat mscE mscE
                (msc_new_counter_post H G T PairResult)) =>
              \lam hsize => properUPred_ent_trans Source
                (mkProperSep Frag Body)
                (mkProperFUpd H.iris_wsat mscE mscE
                  (msc_new_counter_post H G T PairResult)) strip
                (properUPred_ent_trans (mkProperSep Frag Body)
                  (mkProperSep (mkProperLater Body) Frag)
                  (mkProperFUpd H.iris_wsat mscE mscE
                    (msc_new_counter_post H G T PairResult)) enterLater
                  (properUPred_ent_trans
                    (mkProperSep (mkProperLater Body) Frag)
                    (mkProperFUpd H.iris_wsat mscE mscE
                      (mkProperSep Inv Frag))
                    (mkProperFUpd H.iris_wsat mscE mscE
                      (msc_new_counter_post H G T PairResult)) allocate
                    (fupd_mono H.iris_wsat mscE mscE
                      (mkProperSep Inv Frag)
                      (msc_new_counter_post H G T PairResult)
                      (assemble hsize))))
        \in \lam n x hx hsource => \case hsource \with {
          | inP (_, _, _, hsize, _) => conclude hsize n x hx hsource
        }
      )
  \in properUPred_ent_trans Initial Mid Target
      (msc_initial_ghosts_array_to_frag_inv H G T a) finish

\lemma msc_new_counter_with_ghosts {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (T : Nat)
    (positive : \Sigma (k : Nat) (T = suc k)) :
  properUPred_ent (msc_initial_ghosts G T)
    (wp H mscE
      (letE nA
        (AllocN (Val (natV T)) (Val (natV 0)))
        (Pair (Var nA) (Val (natV T))))
      (msc_new_counter_post H G T)) =>
  \let
    | Ghosts => msc_initial_ghosts G T
    | AllocExpr => AllocN (Val (natV T)) (Val (natV 0))
    | PairBody => Pair (Var nA) (Val (natV T))
    | LetLam => LamV nA PairBody
    | Post => msc_new_counter_post H G T
    | AllocPost : Value -> iProp S => \lam w =>
        mkProperExist Loc (\lam l =>
          mkProperAnd
            (mkProperPure (w = LitV (LitLoc l)))
            (pointsto_block H.iris_gen_heap suc l T (natV 0)))
    | framedAlloc : properUPred_ent Ghosts
        (wp H mscE AllocExpr (wp_frame_post AllocPost Ghosts)) =>
        properUPred_ent_trans Ghosts
          (mkProperSep Ghosts (wp H mscE AllocExpr AllocPost))
          (wp H mscE AllocExpr (wp_frame_post AllocPost Ghosts))
          (attach_valid_r_ent Ghosts (wp H mscE AllocExpr AllocPost)
            (wp_allocN H mscE T (natV 0) positive))
          (properUPred_ent_trans
            (mkProperSep Ghosts (wp H mscE AllocExpr AllocPost))
            (mkProperSep (wp H mscE AllocExpr AllocPost) Ghosts)
            (wp H mscE AllocExpr (wp_frame_post AllocPost Ghosts))
            (sep_comm_ent Ghosts (wp H mscE AllocExpr AllocPost))
            (wp_frame_r H mscE AllocExpr AllocPost Ghosts))
    | continue : \Pi (w : Value) -> properUPred_ent
        (wp_frame_post AllocPost Ghosts w)
        (wp H mscE (App (Val LetLam) (Val w)) Post) =>
        \lam w => sep_exist_l_elim
          (\lam l => mkProperAnd
            (mkProperPure (w = LitV (LitLoc l)))
            (pointsto_block H.iris_gen_heap suc l T (natV 0)))
          Ghosts (wp H mscE (App (Val LetLam) (Val w)) Post)
          (\lam l =>
            \let
              | locV => LitV (LitLoc l)
              | Block => pointsto_block H.iris_gen_heap suc l T (natV 0)
              | Array => pointsto_array H.iris_gen_heap suc l
                  (replicate T (natV 0))
              | Resources => mkProperSep Ghosts Array
              | Source => mkProperSep
                  (mkProperAnd (mkProperPure (w = locV)) Block) Ghosts
              | stripBlock : properUPred_ent Source Resources =>
                  properUPred_ent_trans Source
                    (mkProperSep Block Ghosts) Resources
                    (sep_mono_l_ent
                      (mkProperAnd (mkProperPure (w = locV)) Block)
                      Block Ghosts
                      (and_elim_r_ent (mkProperPure (w = locV)) Block))
                    (properUPred_ent_trans
                      (mkProperSep Block Ghosts)
                      (mkProperSep Ghosts Block) Resources
                      (sep_comm_ent Block Ghosts)
                      (sep_mono_r_ent Ghosts Block Array
                        (transport (\lam A => properUPred_ent Block A)
                          (pointsto_block_replicate
                            H.iris_gen_heap suc l T (natV 0))
                          (properUPred_ent_refl Block))))
              | pairProgram : properUPred_ent (Post (PairV locV (natV T)))
                  (wp H mscE (App (Val LetLam) (Val locV)) Post) =>
                  properUPred_ent_trans (Post (PairV locV (natV T)))
                    (wp H mscE
                      (Pair (Val locV) (Val (natV T))) Post)
                    (wp H mscE (App (Val LetLam) (Val locV)) Post)
                    (properUPred_ent_trans (Post (PairV locV (natV T)))
                      (wp H mscE (Val (PairV locV (natV T))) Post)
                      (wp H mscE
                        (Pair (Val locV) (Val (natV T))) Post)
                      (wp_value_intro H mscE (PairV locV (natV T)) Post)
                      (wp_pair_values H mscE locV (natV T) Post))
                    (wp_lam_beta H mscE nA PairBody locV Post)
              | initialized : properUPred_ent Resources
                  (wp H mscE (App (Val LetLam) (Val locV)) Post) =>
                  properUPred_ent_trans Resources
                    (mkProperFUpd H.iris_wsat mscE mscE
                      (Post (PairV locV (natV T))))
                    (wp H mscE (App (Val LetLam) (Val locV)) Post)
                    (msc_initialize_counter H G T l)
                    (properUPred_ent_trans
                      (mkProperFUpd H.iris_wsat mscE mscE
                        (Post (PairV locV (natV T))))
                      (mkProperFUpd H.iris_wsat mscE mscE
                        (wp H mscE
                          (App (Val LetLam) (Val locV)) Post))
                      (wp H mscE
                        (App (Val LetLam) (Val locV)) Post)
                      (fupd_mono H.iris_wsat mscE mscE
                        (Post (PairV locV (natV T)))
                        (wp H mscE
                          (App (Val LetLam) (Val locV)) Post)
                        pairProgram)
                      (fupd_wp H mscE
                        (App (Val LetLam) (Val locV)) Post))
              | conclude : w = locV -> properUPred_ent Source
                  (wp H mscE (App (Val LetLam) (Val w)) Post) =>
                  \lam heq => properUPred_ent_trans Source Resources
                    (wp H mscE (App (Val LetLam) (Val w)) Post)
                    stripBlock
                    (transport (\lam z => properUPred_ent Resources
                      (wp H mscE (App (Val LetLam) (Val z)) Post))
                      (inv heq) initialized)
            \in \lam n x hx hsource => conclude
                (\case hsource \with {
                  | inP (_, _, _, hand, _) => hand.1
                }) n x hx hsource)
    | allocToLet : properUPred_ent
        (wp H mscE AllocExpr (wp_frame_post AllocPost Ghosts))
        (wp H mscE
          (App (Val LetLam) AllocExpr) Post) =>
        properUPred_ent_trans
          (wp H mscE AllocExpr (wp_frame_post AllocPost Ghosts))
          (wp H mscE AllocExpr (\lam w =>
            wp H mscE (App (Val LetLam) (Val w)) Post))
          (wp H mscE (App (Val LetLam) AllocExpr) Post)
          (wp_mono H mscE AllocExpr
            (wp_frame_post AllocPost Ghosts)
            (\lam w => wp H mscE
              (App (Val LetLam) (Val w)) Post) continue)
          (wp_bind_app_r H mscE LetLam AllocExpr Post)
    | surfaceLet : properUPred_ent
        (wp H mscE (App (Val LetLam) AllocExpr) Post)
        (wp H mscE (App (Lam nA PairBody) AllocExpr) Post) =>
        \let
          | LamPost : Value -> iProp S => \lam vf =>
              wp H mscE (App (Val vf) AllocExpr) Post
        \in properUPred_ent_trans
            (wp H mscE (App (Val LetLam) AllocExpr) Post)
            (wp H mscE (Val LetLam) LamPost)
            (wp H mscE (App (Lam nA PairBody) AllocExpr) Post)
            (wp_value_intro H mscE LetLam LamPost)
            (properUPred_ent_trans
              (wp H mscE (Val LetLam) LamPost)
              (wp H mscE (Lam nA PairBody) LamPost)
              (wp H mscE (App (Lam nA PairBody) AllocExpr) Post)
              (wp_lam_expr H mscE nA PairBody LamPost)
              (wp_bind_app_l H mscE (Lam nA PairBody)
                AllocExpr Post))
  \in properUPred_ent_trans Ghosts
      (wp H mscE AllocExpr (wp_frame_post AllocPost Ghosts))
      (wp H mscE (App (Lam nA PairBody) AllocExpr) Post)
      framedAlloc
      (properUPred_ent_trans
        (wp H mscE AllocExpr (wp_frame_post AllocPost Ghosts))
        (wp H mscE (App (Val LetLam) AllocExpr) Post)
        (wp H mscE (App (Lam nA PairBody) AllocExpr) Post)
        allocToLet surfaceLet)

\lemma msc_new_counter_spec {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (T : Nat)
    (positive : \Sigma (k : Nat) (T = suc k)) :
  properUPred_ent mkProperEmp
    (wp H mscE
      (App (Val msc_new_counter) (Val (natV T)))
      (msc_new_counter_post H G T)) =>
  \let
    | Body => letE nA
        (AllocN (Val (natV T)) (Val (natV 0)))
        (Pair (Var nA) (Val (natV T)))
    | Post => msc_new_counter_post H G T
    | bodyWP : properUPred_ent mkProperEmp (wp H mscE Body Post) =>
        properUPred_ent_trans mkProperEmp
          (mkProperBUpd (msc_initial_ghosts G T))
          (wp H mscE Body Post)
          (msc_initial_ghosts_alloc G T)
          (properUPred_ent_trans
            (mkProperBUpd (msc_initial_ghosts G T))
            (mkProperBUpd (wp H mscE Body Post))
            (wp H mscE Body Post)
            (bupd_mono (msc_initial_ghosts G T)
              (wp H mscE Body Post)
              (msc_new_counter_with_ghosts H G T positive))
            (wp_bupd H mscE Body Post))
  \in properUPred_ent_trans mkProperEmp
      (wp H mscE Body Post)
      (wp H mscE
        (App (Val msc_new_counter) (Val (natV T))) Post)
      bodyWP
      (wp_lam_beta H mscE nT
        (letE nA
          (AllocN (Var nT) (Val (natV 0)))
          (Pair (Var nA) (Var nT)))
        (natV T) Post)

-- Client-side ghost accounting for the parallel four-increment example.
-- The map itself is existentially tracked together with its two lookup facts.
-- This is extensionally the same state as the two concrete inserts in the
-- Rocq proof, but avoids making every update depend on map normalization.
\func msc_clientGS {S : gFunctors} (G : mscG S) (gamM : gname) :
  ghost_mapGS Nat natCountable (\Sigma Nat gname) S =>
  \new gen_heapGS {
    | gen_heap_inG => G.msc_request_mapG.gen_heap_inG
    | gen_heap_name => gamM
  }

\func msc_client_pending_at {S : gFunctors} (G : mscG S)
    (gam : msc_name) (gamM gamD : gname) (base k1 k2 : Nat)
    (m : Gmap Nat natCountable (\Sigma Nat gname)) : iProp S =>
  mkProperSep (mkProperPure (glookup m 1 = just (k1, gamD)))
    (mkProperSep (mkProperPure (glookup m 2 = just (k2, gamD)))
      (mkProperSep
        (ghost_map_auth (msc_clientGS G gamM) qp_one m)
        (msc_counter_frag G gam qp_one (base Nat.+ k1 Nat.+ k2))))

\func msc_client_pending {S : gFunctors} (G : mscG S)
    (gam : msc_name) (gamM gamD : gname) (base : Nat) : iProp S =>
  mkProperExist Nat (\lam k1 =>
    mkProperExist Nat (\lam k2 =>
      mkProperExist (Gmap Nat natCountable (\Sigma Nat gname))
        (msc_client_pending_at G gam gamM gamD base k1 k2)))

\func msc_client_done {S : gFunctors} (G : mscG S)
    (gamM : gname) : iProp S =>
  mkProperExist (Gmap Nat natCountable (\Sigma Nat gname)) (\lam m =>
    mkProperSep (mkProperPure (glookup m 1 = nothing))
      (mkProperSep (mkProperPure (glookup m 2 = nothing))
        (ghost_map_auth (msc_clientGS G gamM) qp_one m)))

\func msc_client_inv {S : gFunctors} (G : mscG S)
    (gam : msc_name) (gamM gamD : gname) (base : Nat) : iProp S =>
  mkProperOr (msc_client_pending G gam gamM gamD base)
    (msc_client_done G gamM)

\lemma msc_counter_frag_timeless {S : gFunctors} (G : mscG S)
    (gam : msc_name) (q : Qp) (n : Nat) :
  Timeless (msc_counter_frag G gam q n) =>
  msc_frag_timeless G.msc_modelG gam.msc_model_name q n

\lemma msc_client_pending_at_timeless {S : gFunctors} (G : mscG S)
    (gam : msc_name) (gamM gamD : gname) (base k1 k2 : Nat)
    (m : Gmap Nat natCountable (\Sigma Nat gname)) :
  Timeless (msc_client_pending_at G gam gamM gamD base k1 k2 m) =>
  timeless_sep
    (mkProperPure (glookup m 1 = just (k1, gamD)))
    (mkProperSep (mkProperPure (glookup m 2 = just (k2, gamD)))
      (mkProperSep
        (ghost_map_auth (msc_clientGS G gamM) qp_one m)
        (msc_counter_frag G gam qp_one (base Nat.+ k1 Nat.+ k2))))
    (timeless_pure {iResUR S} (glookup m 1 = just (k1, gamD)))
    (timeless_sep
      (mkProperPure (glookup m 2 = just (k2, gamD)))
      (mkProperSep
        (ghost_map_auth (msc_clientGS G gamM) qp_one m)
        (msc_counter_frag G gam qp_one (base Nat.+ k1 Nat.+ k2)))
      (timeless_pure {iResUR S} (glookup m 2 = just (k2, gamD)))
      (timeless_sep
        (ghost_map_auth (msc_clientGS G gamM) qp_one m)
        (msc_counter_frag G gam qp_one (base Nat.+ k1 Nat.+ k2))
        (ghost_map_auth_timeless (msc_clientGS G gamM) qp_one m)
        (msc_counter_frag_timeless G gam qp_one
          (base Nat.+ k1 Nat.+ k2))))

\lemma msc_client_pending_timeless {S : gFunctors} (G : mscG S)
    (gam : msc_name) (gamM gamD : gname) (base : Nat) :
  Timeless (msc_client_pending G gam gamM gamD base) =>
  timeless_exist (\lam k1 =>
    mkProperExist Nat (\lam k2 =>
      mkProperExist (Gmap Nat natCountable (\Sigma Nat gname))
        (msc_client_pending_at G gam gamM gamD base k1 k2)))
    (\lam k1 => timeless_exist (\lam k2 =>
      mkProperExist (Gmap Nat natCountable (\Sigma Nat gname))
        (msc_client_pending_at G gam gamM gamD base k1 k2))
      (\lam k2 => timeless_exist
        (msc_client_pending_at G gam gamM gamD base k1 k2)
        (msc_client_pending_at_timeless G gam gamM gamD base k1 k2)))

\lemma msc_client_done_timeless {S : gFunctors} (G : mscG S)
    (gamM : gname) : Timeless (msc_client_done G gamM) =>
  timeless_exist (\lam m =>
    mkProperSep (mkProperPure (glookup m 1 = nothing))
      (mkProperSep (mkProperPure (glookup m 2 = nothing))
        (ghost_map_auth (msc_clientGS G gamM) qp_one m)))
    (\lam m => timeless_sep
      (mkProperPure (glookup m 1 = nothing))
      (mkProperSep (mkProperPure (glookup m 2 = nothing))
        (ghost_map_auth (msc_clientGS G gamM) qp_one m))
      (timeless_pure {iResUR S} (glookup m 1 = nothing))
      (timeless_sep
        (mkProperPure (glookup m 2 = nothing))
        (ghost_map_auth (msc_clientGS G gamM) qp_one m)
        (timeless_pure {iResUR S} (glookup m 2 = nothing))
        (ghost_map_auth_timeless (msc_clientGS G gamM) qp_one m)))

\lemma msc_client_inv_timeless {S : gFunctors} (G : mscG S)
    (gam : msc_name) (gamM gamD : gname) (base : Nat) :
  Timeless (msc_client_inv G gam gamM gamD base) =>
  timeless_or
    (msc_client_pending G gam gamM gamD base)
    (msc_client_done G gamM)
    (msc_client_pending_timeless G gam gamM gamD base)
    (msc_client_done_timeless G gamM)

\lemma sep_cross4_ent {M : UCMRA} (A B C D : ProperUPred M) :
  properUPred_ent
    (mkProperSep (mkProperSep A B) (mkProperSep C D))
    (mkProperSep (mkProperSep A D) (mkProperSep C B)) =>
  \let
    | S0 => mkProperSep (mkProperSep A B) (mkProperSep C D)
    | S1 => mkProperSep A (mkProperSep B (mkProperSep C D))
    | S2 => mkProperSep A (mkProperSep C (mkProperSep B D))
    | S3 => mkProperSep A (mkProperSep C (mkProperSep D B))
    | S4 => mkProperSep A (mkProperSep D (mkProperSep C B))
    | S5 => mkProperSep (mkProperSep A D) (mkProperSep C B)
  \in properUPred_ent_trans S0 S1 S5
      (sep_assoc_l_ent A B (mkProperSep C D))
      (properUPred_ent_trans S1 S2 S5
        (sep_mono_r_ent A (mkProperSep B (mkProperSep C D))
          (mkProperSep C (mkProperSep B D))
          (sep_swap_ent B C D))
        (properUPred_ent_trans S2 S3 S5
          (sep_mono_r_ent A (mkProperSep C (mkProperSep B D))
            (mkProperSep C (mkProperSep D B))
            (sep_mono_r_ent C (mkProperSep B D)
              (mkProperSep D B) (sep_comm_ent B D)))
          (properUPred_ent_trans S3 S4 S5
            (sep_mono_r_ent A (mkProperSep C (mkProperSep D B))
              (mkProperSep D (mkProperSep C B))
              (sep_swap_ent C D B))
            (sep_assoc_r_ent A D (mkProperSep C B)))))

\lemma bupd_pair_ent {M : UCMRA} (A B A' B' : ProperUPred M)
    (ha : properUPred_ent A (mkProperBUpd A'))
    (hb : properUPred_ent B (mkProperBUpd B')) :
  properUPred_ent (mkProperSep A B)
    (mkProperBUpd (mkProperSep A' B')) =>
  properUPred_ent_trans (mkProperSep A B)
    (mkProperSep (mkProperBUpd A') (mkProperBUpd B'))
    (mkProperBUpd (mkProperSep A' B'))
    (properUPred_ent_trans (mkProperSep A B)
      (mkProperSep (mkProperBUpd A') B)
      (mkProperSep (mkProperBUpd A') (mkProperBUpd B'))
      (sep_mono_l_ent A (mkProperBUpd A') B ha)
      (sep_mono_r_ent (mkProperBUpd A') B (mkProperBUpd B') hb))
    (bupd_sep {UPredBiBUpd M} A' B')

\lemma msc_client_pending_intro {S : gFunctors} (G : mscG S)
    (gam : msc_name) (gamM gamD : gname) (base k1 k2 : Nat)
    (m : Gmap Nat natCountable (\Sigma Nat gname))
    (h1 : glookup m 1 = just (k1, gamD))
    (h2 : glookup m 2 = just (k2, gamD)) :
  properUPred_ent
    (mkProperSep
      (ghost_map_auth (msc_clientGS G gamM) qp_one m)
      (msc_counter_frag G gam qp_one (base Nat.+ k1 Nat.+ k2)))
    (msc_client_inv G gam gamM gamD base) =>
  \let
    | Core => mkProperSep
        (ghost_map_auth (msc_clientGS G gamM) qp_one m)
        (msc_counter_frag G gam qp_one (base Nat.+ k1 Nat.+ k2))
    | At => msc_client_pending_at G gam gamM gamD base k1 k2 m
    | addPure : properUPred_ent Core At =>
        properUPred_ent_trans Core
          (mkProperSep (mkProperPure (glookup m 2 = just (k2, gamD))) Core)
          At
          (pure_intro_sep_ent (glookup m 2 = just (k2, gamD)) h2 Core)
          (pure_intro_sep_ent (glookup m 1 = just (k1, gamD)) h1
            (mkProperSep (mkProperPure
              (glookup m 2 = just (k2, gamD))) Core))
    | introduce : properUPred_ent At
        (msc_client_pending G gam gamM gamD base) =>
        properUPred_ent_trans At
          (mkProperExist (Gmap Nat natCountable (\Sigma Nat gname))
            (msc_client_pending_at G gam gamM gamD base k1 k2))
          (msc_client_pending G gam gamM gamD base)
          (exist_intro_ent
            (msc_client_pending_at G gam gamM gamD base k1 k2) m)
          (properUPred_ent_trans
            (mkProperExist (Gmap Nat natCountable (\Sigma Nat gname))
              (msc_client_pending_at G gam gamM gamD base k1 k2))
            (mkProperExist Nat (\lam k2' =>
              mkProperExist (Gmap Nat natCountable (\Sigma Nat gname))
                (msc_client_pending_at G gam gamM gamD base k1 k2')))
            (msc_client_pending G gam gamM gamD base)
            (exist_intro_ent (\lam k2' =>
              mkProperExist (Gmap Nat natCountable (\Sigma Nat gname))
                (msc_client_pending_at G gam gamM gamD base k1 k2')) k2)
            (exist_intro_ent (\lam k1' =>
              mkProperExist Nat (\lam k2' =>
                mkProperExist (Gmap Nat natCountable (\Sigma Nat gname))
                  (msc_client_pending_at G gam gamM gamD base k1' k2'))) k1))
  \in properUPred_ent_trans Core At
      (msc_client_inv G gam gamM gamD base) addPure
      (properUPred_ent_trans At
        (msc_client_pending G gam gamM gamD base)
        (msc_client_inv G gam gamM gamD base) introduce
        (or_intro_l_ent (msc_client_pending G gam gamM gamD base)
          (msc_client_done G gamM)))

\lemma msc_client_suc_first (base k1 k2 : Nat) :
  base Nat.+ suc k1 Nat.+ k2 = suc (base Nat.+ k1 Nat.+ k2) =>
  pmap (\lam z => z Nat.+ k2) (nat_add_suc_right base k1) *>
    nat_suc_add (base Nat.+ k1) k2 *>
    nat_add_suc_right (base Nat.+ k1) k2

\lemma nat_one_ne_two : Not (1 = 2) => \lam h => \case h \with {}
\lemma nat_two_ne_one : Not (2 = 1) => \lam h => \case h \with {}

\lemma msc_client_pending1_commit {S : gFunctors}
    (G : mscG S) (gam : msc_name) (gamM gamD : gname)
    (base total old k1 k2 : Nat)
    (m : Gmap Nat natCountable (\Sigma Nat gname))
    (h2 : glookup m 2 = just (k2, gamD))
    (hold : k1 = old) (htotal : total = base Nat.+ k1 Nat.+ k2) :
  properUPred_ent
    (mkProperSep
      (mkProperSep
        (ghost_map_auth (msc_clientGS G gamM) qp_one m)
        (ghost_map_elem (msc_clientGS G gamM) 1 (old, gamD)))
      (mkProperSep (msc_counter_auth G gam total)
        (msc_counter_frag G gam qp_one (base Nat.+ k1 Nat.+ k2))))
    (mkProperBUpd
      (mkProperSep (msc_client_inv G gam gamM gamD base)
        (mkProperSep (msc_counter_auth G gam (suc total))
          (ghost_map_elem (msc_clientGS G gamM) 1 (suc old, gamD))))) =>
  \let
    | A => ghost_map_auth (msc_clientGS G gamM) qp_one m
    | B => msc_counter_frag G gam qp_one (base Nat.+ k1 Nat.+ k2)
    | C => msc_counter_auth G gam total
    | D => ghost_map_elem (msc_clientGS G gamM) 1 (old, gamD)
    | m' => ginsert 1 (suc old, gamD) m
    | K => base Nat.+ suc old Nat.+ k2
    | A' => ghost_map_auth (msc_clientGS G gamM) qp_one m'
    | B' => msc_counter_frag G gam qp_one K
    | C' => msc_counter_auth G gam K
    | D' => ghost_map_elem (msc_clientGS G gamM) 1 (suc old, gamD)
    | Source => mkProperSep (mkProperSep A D) (mkProperSep C B)
    | Updated => mkProperSep (mkProperSep A' D') (mkProperSep C' B')
    | Grouped => mkProperSep (mkProperSep A' B') (mkProperSep C' D')
    | TargetK => mkProperSep (msc_client_inv G gam gamM gamD base)
        (mkProperSep C' D')
    | update : properUPred_ent Source (mkProperBUpd Updated) =>
        bupd_pair_ent (mkProperSep A D) (mkProperSep C B)
          (mkProperSep A' D') (mkProperSep C' B')
          (ghost_map_update (msc_clientGS G gamM) m 1
            (old, gamD) (suc old, gamD))
          (msc_auth_frag_update G.msc_modelG gam.msc_model_name
            total (base Nat.+ k1 Nat.+ k2) K)
    | regroup : properUPred_ent Updated Grouped =>
        sep_cross4_ent A' D' C' B'
    | new1 : glookup m' 1 = just (suc old, gamD) =>
        glookup_insert_eq 1 (suc old, gamD) m
    | new2 : glookup m' 2 = just (k2, gamD) =>
        glookup_insert_ne 1 2 (suc old, gamD) m nat_one_ne_two *> h2
    | finish : properUPred_ent Grouped TargetK =>
        sep_mono_l_ent (mkProperSep A' B')
          (msc_client_inv G gam gamM gamD base)
          (mkProperSep C' D')
          (msc_client_pending_intro G gam gamM gamD base
            (suc old) k2 m' new1 new2)
    | atK : properUPred_ent Source (mkProperBUpd TargetK) =>
        properUPred_ent_trans Source (mkProperBUpd Updated)
          (mkProperBUpd TargetK) update
          (bupd_mono Updated TargetK
            (properUPred_ent_trans Updated Grouped TargetK regroup finish))
    | kEq : K = suc total =>
        inv (pmap (\lam z => base Nat.+ suc z Nat.+ k2) hold) *>
          msc_client_suc_first base k1 k2 *>
          pmap suc (inv htotal)
  \in transport (\lam z => properUPred_ent Source
      (mkProperBUpd
        (mkProperSep (msc_client_inv G gam gamM gamD base)
          (mkProperSep (msc_counter_auth G gam z) D'))))
    kEq atK

\lemma msc_client_pending2_commit {S : gFunctors}
    (G : mscG S) (gam : msc_name) (gamM gamD : gname)
    (base total old k1 k2 : Nat)
    (m : Gmap Nat natCountable (\Sigma Nat gname))
    (h1 : glookup m 1 = just (k1, gamD))
    (hold : k2 = old) (htotal : total = base Nat.+ k1 Nat.+ k2) :
  properUPred_ent
    (mkProperSep
      (mkProperSep
        (ghost_map_auth (msc_clientGS G gamM) qp_one m)
        (ghost_map_elem (msc_clientGS G gamM) 2 (old, gamD)))
      (mkProperSep (msc_counter_auth G gam total)
        (msc_counter_frag G gam qp_one (base Nat.+ k1 Nat.+ k2))))
    (mkProperBUpd
      (mkProperSep (msc_client_inv G gam gamM gamD base)
        (mkProperSep (msc_counter_auth G gam (suc total))
          (ghost_map_elem (msc_clientGS G gamM) 2 (suc old, gamD))))) =>
  \let
    | A => ghost_map_auth (msc_clientGS G gamM) qp_one m
    | B => msc_counter_frag G gam qp_one (base Nat.+ k1 Nat.+ k2)
    | C => msc_counter_auth G gam total
    | D => ghost_map_elem (msc_clientGS G gamM) 2 (old, gamD)
    | m' => ginsert 2 (suc old, gamD) m
    | K => base Nat.+ k1 Nat.+ suc old
    | A' => ghost_map_auth (msc_clientGS G gamM) qp_one m'
    | B' => msc_counter_frag G gam qp_one K
    | C' => msc_counter_auth G gam K
    | D' => ghost_map_elem (msc_clientGS G gamM) 2 (suc old, gamD)
    | Source => mkProperSep (mkProperSep A D) (mkProperSep C B)
    | Updated => mkProperSep (mkProperSep A' D') (mkProperSep C' B')
    | Grouped => mkProperSep (mkProperSep A' B') (mkProperSep C' D')
    | TargetK => mkProperSep (msc_client_inv G gam gamM gamD base)
        (mkProperSep C' D')
    | update : properUPred_ent Source (mkProperBUpd Updated) =>
        bupd_pair_ent (mkProperSep A D) (mkProperSep C B)
          (mkProperSep A' D') (mkProperSep C' B')
          (ghost_map_update (msc_clientGS G gamM) m 2
            (old, gamD) (suc old, gamD))
          (msc_auth_frag_update G.msc_modelG gam.msc_model_name
            total (base Nat.+ k1 Nat.+ k2) K)
    | regroup : properUPred_ent Updated Grouped =>
        sep_cross4_ent A' D' C' B'
    | new1 : glookup m' 1 = just (k1, gamD) =>
        glookup_insert_ne 2 1 (suc old, gamD) m nat_two_ne_one *> h1
    | new2 : glookup m' 2 = just (suc old, gamD) =>
        glookup_insert_eq 2 (suc old, gamD) m
    | finish : properUPred_ent Grouped TargetK =>
        sep_mono_l_ent (mkProperSep A' B')
          (msc_client_inv G gam gamM gamD base)
          (mkProperSep C' D')
          (msc_client_pending_intro G gam gamM gamD base
            k1 (suc old) m' new1 new2)
    | atK : properUPred_ent Source (mkProperBUpd TargetK) =>
        properUPred_ent_trans Source (mkProperBUpd Updated)
          (mkProperBUpd TargetK) update
          (bupd_mono Updated TargetK
            (properUPred_ent_trans Updated Grouped TargetK regroup finish))
    | kEq : K = suc total =>
        inv (pmap (\lam z => base Nat.+ k1 Nat.+ suc z) hold) *>
          nat_add_suc_right (base Nat.+ k1) k2 *>
          pmap suc (inv htotal)
  \in transport (\lam z => properUPred_ent Source
      (mkProperBUpd
        (mkProperSep (msc_client_inv G gam gamM gamD base)
          (mkProperSep (msc_counter_auth G gam z) D'))))
    kEq atK

\func msc_lookup_nat (o : Maybe (\Sigma Nat gname)) : Nat \elim o
  | nothing => 0
  | just p => p.1

\lemma msc_client_lookup_nat_agree (m : Gmap Nat natCountable
    (\Sigma Nat gname)) (key k old : Nat) (gamD : gname)
    (stored : glookup m key = just (k, gamD))
    (external : glookup m key = just (old, gamD)) : k = old =>
  pmap msc_lookup_nat (inv stored *> external)

\lemma msc_client_pending1_step {S : gFunctors}
    (G : mscG S) (gam : msc_name) (gamM gamD : gname)
    (base total old : Nat) :
  properUPred_ent
    (mkProperSep (msc_client_pending G gam gamM gamD base)
      (mkProperSep (msc_counter_auth G gam total)
        (ghost_map_elem (msc_clientGS G gamM) 1 (old, gamD))))
    (mkProperBUpd
      (mkProperSep (msc_client_inv G gam gamM gamD base)
        (mkProperSep (msc_counter_auth G gam (suc total))
          (ghost_map_elem (msc_clientGS G gamM) 1 (suc old, gamD))))) =>
  \let
    | X => mkProperSep (msc_counter_auth G gam total)
        (ghost_map_elem (msc_clientGS G gamM) 1 (old, gamD))
    | Target => mkProperBUpd
        (mkProperSep (msc_client_inv G gam gamM gamD base)
          (mkProperSep (msc_counter_auth G gam (suc total))
            (ghost_map_elem (msc_clientGS G gamM) 1 (suc old, gamD))))
    | perK1 : \Pi (k1 : Nat) -> properUPred_ent
        (mkProperSep
          (mkProperExist Nat (\lam k2 =>
            mkProperExist (Gmap Nat natCountable (\Sigma Nat gname))
              (msc_client_pending_at G gam gamM gamD base k1 k2))) X)
        Target => \lam k1 =>
      sep_exist_l_elim (\lam k2 =>
        mkProperExist (Gmap Nat natCountable (\Sigma Nat gname))
          (msc_client_pending_at G gam gamM gamD base k1 k2)) X Target
        (\lam k2 => sep_exist_l_elim
          (msc_client_pending_at G gam gamM gamD base k1 k2) X Target
          (\lam m =>
            \let
              | A => ghost_map_auth (msc_clientGS G gamM) qp_one m
              | B => msc_counter_frag G gam qp_one
                  (base Nat.+ k1 Nat.+ k2)
              | C => msc_counter_auth G gam total
              | D => ghost_map_elem (msc_clientGS G gamM) 1 (old, gamD)
              | Core => mkProperSep (mkProperSep A B) (mkProperSep C D)
              | Ready => mkProperSep (mkProperSep A D) (mkProperSep C B)
              | lookupFact => glookup m 1 = just (old, gamD)
              | totalFact => total = base Nat.+ k1 Nat.+ k2
              | lookupEnt : properUPred_ent Ready
                  (mkProperPure lookupFact) =>
                  properUPred_ent_trans Ready (mkProperSep A D)
                    (mkProperPure lookupFact)
                    (sep_elim_l_ent (mkProperSep A D) (mkProperSep C B))
                    (ghost_map_lookup (msc_clientGS G gamM) m 1 (old, gamD))
              | totalEnt : properUPred_ent Ready
                  (mkProperPure totalFact) =>
                  properUPred_ent_trans Ready (mkProperSep C B)
                    (mkProperPure totalFact)
                    (sep_elim_r_ent (mkProperSep A D) (mkProperSep C B))
                    (msc_auth_frag_agree G.msc_modelG
                      gam.msc_model_name total (base Nat.+ k1 Nat.+ k2))
              | finish : (glookup m 1 = just (k1, gamD)) ->
                  (glookup m 2 = just (k2, gamD)) ->
                  properUPred_ent Core Target => \lam h1 h2 =>
                  properUPred_ent_trans Core Ready Target
                    (sep_cross4_ent A B C D)
                    (properUPred_ent_trans Ready
                      (mkProperSep (mkProperPure lookupFact) Ready) Target
                      (pure_consequence_frame_ent Ready lookupFact lookupEnt)
                      (pure_sep_l_elim lookupFact Ready Target (\lam hl =>
                        properUPred_ent_trans Ready
                          (mkProperSep (mkProperPure totalFact) Ready) Target
                          (pure_consequence_frame_ent Ready totalFact totalEnt)
                          (pure_sep_l_elim totalFact Ready Target (\lam ht =>
                            msc_client_pending1_commit G gam gamM gamD
                              base total old k1 k2 m h2
                              (msc_client_lookup_nat_agree m 1 k1 old
                                gamD h1 hl) ht)))))
            \in properUPred_ent_trans
                (mkProperSep
                  (msc_client_pending_at G gam gamM gamD base k1 k2 m) X)
                (mkProperSep (mkProperPure
                    (glookup m 1 = just (k1, gamD)))
                  (mkProperSep
                    (mkProperSep (mkProperPure
                      (glookup m 2 = just (k2, gamD)))
                      (mkProperSep A B)) X)) Target
                (sep_assoc_l_ent
                  (mkProperPure (glookup m 1 = just (k1, gamD)))
                  (mkProperSep (mkProperPure
                    (glookup m 2 = just (k2, gamD))) (mkProperSep A B)) X)
                (pure_sep_l_elim (glookup m 1 = just (k1, gamD))
                  (mkProperSep
                    (mkProperSep (mkProperPure
                      (glookup m 2 = just (k2, gamD))) (mkProperSep A B)) X)
                  Target (\lam h1 =>
                    properUPred_ent_trans
                      (mkProperSep
                        (mkProperSep (mkProperPure
                          (glookup m 2 = just (k2, gamD)))
                          (mkProperSep A B)) X)
                      (mkProperSep (mkProperPure
                        (glookup m 2 = just (k2, gamD))) Core) Target
                      (sep_assoc_l_ent
                        (mkProperPure (glookup m 2 = just (k2, gamD)))
                        (mkProperSep A B) X)
                      (pure_sep_l_elim
                        (glookup m 2 = just (k2, gamD)) Core Target
                        (finish h1))))))
  \in sep_exist_l_elim (\lam k1 =>
      mkProperExist Nat (\lam k2 =>
        mkProperExist (Gmap Nat natCountable (\Sigma Nat gname))
          (msc_client_pending_at G gam gamM gamD base k1 k2)))
    X Target perK1

\lemma msc_client_pending2_step {S : gFunctors}
    (G : mscG S) (gam : msc_name) (gamM gamD : gname)
    (base total old : Nat) :
  properUPred_ent
    (mkProperSep (msc_client_pending G gam gamM gamD base)
      (mkProperSep (msc_counter_auth G gam total)
        (ghost_map_elem (msc_clientGS G gamM) 2 (old, gamD))))
    (mkProperBUpd
      (mkProperSep (msc_client_inv G gam gamM gamD base)
        (mkProperSep (msc_counter_auth G gam (suc total))
          (ghost_map_elem (msc_clientGS G gamM) 2 (suc old, gamD))))) =>
  \let
    | X => mkProperSep (msc_counter_auth G gam total)
        (ghost_map_elem (msc_clientGS G gamM) 2 (old, gamD))
    | Target => mkProperBUpd
        (mkProperSep (msc_client_inv G gam gamM gamD base)
          (mkProperSep (msc_counter_auth G gam (suc total))
            (ghost_map_elem (msc_clientGS G gamM) 2 (suc old, gamD))))
    | perK1 : \Pi (k1 : Nat) -> properUPred_ent
        (mkProperSep
          (mkProperExist Nat (\lam k2 =>
            mkProperExist (Gmap Nat natCountable (\Sigma Nat gname))
              (msc_client_pending_at G gam gamM gamD base k1 k2))) X)
        Target => \lam k1 =>
      sep_exist_l_elim (\lam k2 =>
        mkProperExist (Gmap Nat natCountable (\Sigma Nat gname))
          (msc_client_pending_at G gam gamM gamD base k1 k2)) X Target
        (\lam k2 => sep_exist_l_elim
          (msc_client_pending_at G gam gamM gamD base k1 k2) X Target
          (\lam m =>
            \let
              | A => ghost_map_auth (msc_clientGS G gamM) qp_one m
              | B => msc_counter_frag G gam qp_one
                  (base Nat.+ k1 Nat.+ k2)
              | C => msc_counter_auth G gam total
              | D => ghost_map_elem (msc_clientGS G gamM) 2 (old, gamD)
              | Core => mkProperSep (mkProperSep A B) (mkProperSep C D)
              | Ready => mkProperSep (mkProperSep A D) (mkProperSep C B)
              | lookupFact => glookup m 2 = just (old, gamD)
              | totalFact => total = base Nat.+ k1 Nat.+ k2
              | lookupEnt : properUPred_ent Ready
                  (mkProperPure lookupFact) =>
                  properUPred_ent_trans Ready (mkProperSep A D)
                    (mkProperPure lookupFact)
                    (sep_elim_l_ent (mkProperSep A D) (mkProperSep C B))
                    (ghost_map_lookup (msc_clientGS G gamM) m 2 (old, gamD))
              | totalEnt : properUPred_ent Ready
                  (mkProperPure totalFact) =>
                  properUPred_ent_trans Ready (mkProperSep C B)
                    (mkProperPure totalFact)
                    (sep_elim_r_ent (mkProperSep A D) (mkProperSep C B))
                    (msc_auth_frag_agree G.msc_modelG
                      gam.msc_model_name total (base Nat.+ k1 Nat.+ k2))
              | finish : (glookup m 1 = just (k1, gamD)) ->
                  (glookup m 2 = just (k2, gamD)) ->
                  properUPred_ent Core Target => \lam h1 h2 =>
                  properUPred_ent_trans Core Ready Target
                    (sep_cross4_ent A B C D)
                    (properUPred_ent_trans Ready
                      (mkProperSep (mkProperPure lookupFact) Ready) Target
                      (pure_consequence_frame_ent Ready lookupFact lookupEnt)
                      (pure_sep_l_elim lookupFact Ready Target (\lam hl =>
                        properUPred_ent_trans Ready
                          (mkProperSep (mkProperPure totalFact) Ready) Target
                          (pure_consequence_frame_ent Ready totalFact totalEnt)
                          (pure_sep_l_elim totalFact Ready Target (\lam ht =>
                            msc_client_pending2_commit G gam gamM gamD
                              base total old k1 k2 m h1
                              (msc_client_lookup_nat_agree m 2 k2 old
                                gamD h2 hl) ht)))))
            \in properUPred_ent_trans
                (mkProperSep
                  (msc_client_pending_at G gam gamM gamD base k1 k2 m) X)
                (mkProperSep (mkProperPure
                    (glookup m 1 = just (k1, gamD)))
                  (mkProperSep
                    (mkProperSep (mkProperPure
                      (glookup m 2 = just (k2, gamD)))
                      (mkProperSep A B)) X)) Target
                (sep_assoc_l_ent
                  (mkProperPure (glookup m 1 = just (k1, gamD)))
                  (mkProperSep (mkProperPure
                    (glookup m 2 = just (k2, gamD))) (mkProperSep A B)) X)
                (pure_sep_l_elim (glookup m 1 = just (k1, gamD))
                  (mkProperSep
                    (mkProperSep (mkProperPure
                      (glookup m 2 = just (k2, gamD))) (mkProperSep A B)) X)
                  Target (\lam h1 =>
                    properUPred_ent_trans
                      (mkProperSep
                        (mkProperSep (mkProperPure
                          (glookup m 2 = just (k2, gamD)))
                          (mkProperSep A B)) X)
                      (mkProperSep (mkProperPure
                        (glookup m 2 = just (k2, gamD))) Core) Target
                      (sep_assoc_l_ent
                        (mkProperPure (glookup m 2 = just (k2, gamD)))
                        (mkProperSep A B) X)
                      (pure_sep_l_elim
                        (glookup m 2 = just (k2, gamD)) Core Target
                        (finish h1))))))
  \in sep_exist_l_elim (\lam k1 =>
      mkProperExist Nat (\lam k2 =>
        mkProperExist (Gmap Nat natCountable (\Sigma Nat gname))
          (msc_client_pending_at G gam gamM gamD base k1 k2)))
    X Target perK1

\lemma msc_client_done_core_conflict {S : gFunctors}
    (G : mscG S) (gamM : gname) (m : Gmap Nat natCountable
      (\Sigma Nat gname)) (key old : Nat) (gamD : gname)
    (X Target : iProp S) (absent : glookup m key = nothing) :
  properUPred_ent
    (mkProperSep (ghost_map_auth (msc_clientGS G gamM) qp_one m)
      (mkProperSep X
        (ghost_map_elem (msc_clientGS G gamM) key (old, gamD))))
    Target =>
  \let
    | A => ghost_map_auth (msc_clientGS G gamM) qp_one m
    | D => ghost_map_elem (msc_clientGS G gamM) key (old, gamD)
    | Ready => mkProperSep X (mkProperSep A D)
    | lookupFact => glookup m key = just (old, gamD)
    | lookupEnt : properUPred_ent Ready (mkProperPure lookupFact) =>
        properUPred_ent_trans Ready (mkProperSep A D)
          (mkProperPure lookupFact)
          (sep_elim_r_ent X (mkProperSep A D))
          (ghost_map_lookup (msc_clientGS G gamM) m key (old, gamD))
    | absurdEnt : properUPred_ent (mkProperPure lookupFact) Target =>
        \lam _ _ _ present => \case inv absent *> present \with {}
  \in properUPred_ent_trans
      (mkProperSep A (mkProperSep X D)) Ready Target
      (sep_swap_ent A X D)
      (properUPred_ent_trans Ready (mkProperPure lookupFact) Target
        lookupEnt absurdEnt)

\lemma msc_client_done1_step {S : gFunctors}
    (G : mscG S) (gam : msc_name) (gamM gamD : gname)
    (base total old : Nat) :
  properUPred_ent
    (mkProperSep (msc_client_done G gamM)
      (mkProperSep (msc_counter_auth G gam total)
        (ghost_map_elem (msc_clientGS G gamM) 1 (old, gamD))))
    (mkProperBUpd
      (mkProperSep (msc_client_inv G gam gamM gamD base)
        (mkProperSep (msc_counter_auth G gam (suc total))
          (ghost_map_elem (msc_clientGS G gamM) 1 (suc old, gamD))))) =>
  \let
    | X => msc_counter_auth G gam total
    | D => ghost_map_elem (msc_clientGS G gamM) 1 (old, gamD)
    | Target => mkProperBUpd
        (mkProperSep (msc_client_inv G gam gamM gamD base)
          (mkProperSep (msc_counter_auth G gam (suc total))
            (ghost_map_elem (msc_clientGS G gamM) 1 (suc old, gamD))))
  \in sep_exist_l_elim (\lam m =>
      mkProperSep (mkProperPure (glookup m 1 = nothing))
        (mkProperSep (mkProperPure (glookup m 2 = nothing))
          (ghost_map_auth (msc_clientGS G gamM) qp_one m)))
    (mkProperSep X D) Target (\lam m =>
      properUPred_ent_trans
        (mkProperSep
          (mkProperSep (mkProperPure (glookup m 1 = nothing))
            (mkProperSep (mkProperPure (glookup m 2 = nothing))
              (ghost_map_auth (msc_clientGS G gamM) qp_one m)))
          (mkProperSep X D))
        (mkProperSep (mkProperPure (glookup m 1 = nothing))
          (mkProperSep
            (mkProperSep (mkProperPure (glookup m 2 = nothing))
              (ghost_map_auth (msc_clientGS G gamM) qp_one m))
            (mkProperSep X D))) Target
        (sep_assoc_l_ent (mkProperPure (glookup m 1 = nothing))
          (mkProperSep (mkProperPure (glookup m 2 = nothing))
            (ghost_map_auth (msc_clientGS G gamM) qp_one m))
          (mkProperSep X D))
        (pure_sep_l_elim (glookup m 1 = nothing)
          (mkProperSep
            (mkProperSep (mkProperPure (glookup m 2 = nothing))
              (ghost_map_auth (msc_clientGS G gamM) qp_one m))
            (mkProperSep X D)) Target (\lam absent =>
              properUPred_ent_trans
                (mkProperSep
                  (mkProperSep (mkProperPure (glookup m 2 = nothing))
                    (ghost_map_auth (msc_clientGS G gamM) qp_one m))
                  (mkProperSep X D))
                (mkProperSep (ghost_map_auth (msc_clientGS G gamM) qp_one m)
                  (mkProperSep X D)) Target
                (sep_mono_l_ent
                  (mkProperSep (mkProperPure (glookup m 2 = nothing))
                    (ghost_map_auth (msc_clientGS G gamM) qp_one m))
                  (ghost_map_auth (msc_clientGS G gamM) qp_one m)
                  (mkProperSep X D)
                  (sep_elim_r_ent (mkProperPure (glookup m 2 = nothing))
                    (ghost_map_auth (msc_clientGS G gamM) qp_one m)))
                (msc_client_done_core_conflict G gamM m 1 old gamD
                  X Target absent))))

\lemma msc_client_done2_step {S : gFunctors}
    (G : mscG S) (gam : msc_name) (gamM gamD : gname)
    (base total old : Nat) :
  properUPred_ent
    (mkProperSep (msc_client_done G gamM)
      (mkProperSep (msc_counter_auth G gam total)
        (ghost_map_elem (msc_clientGS G gamM) 2 (old, gamD))))
    (mkProperBUpd
      (mkProperSep (msc_client_inv G gam gamM gamD base)
        (mkProperSep (msc_counter_auth G gam (suc total))
          (ghost_map_elem (msc_clientGS G gamM) 2 (suc old, gamD))))) =>
  \let
    | X => msc_counter_auth G gam total
    | D => ghost_map_elem (msc_clientGS G gamM) 2 (old, gamD)
    | Target => mkProperBUpd
        (mkProperSep (msc_client_inv G gam gamM gamD base)
          (mkProperSep (msc_counter_auth G gam (suc total))
            (ghost_map_elem (msc_clientGS G gamM) 2 (suc old, gamD))))
  \in sep_exist_l_elim (\lam m =>
      mkProperSep (mkProperPure (glookup m 1 = nothing))
        (mkProperSep (mkProperPure (glookup m 2 = nothing))
          (ghost_map_auth (msc_clientGS G gamM) qp_one m)))
    (mkProperSep X D) Target (\lam m =>
      properUPred_ent_trans
        (mkProperSep
          (mkProperSep (mkProperPure (glookup m 1 = nothing))
            (mkProperSep (mkProperPure (glookup m 2 = nothing))
              (ghost_map_auth (msc_clientGS G gamM) qp_one m)))
          (mkProperSep X D))
        (mkProperSep (mkProperPure (glookup m 1 = nothing))
          (mkProperSep
            (mkProperSep (mkProperPure (glookup m 2 = nothing))
              (ghost_map_auth (msc_clientGS G gamM) qp_one m))
            (mkProperSep X D))) Target
        (sep_assoc_l_ent (mkProperPure (glookup m 1 = nothing))
          (mkProperSep (mkProperPure (glookup m 2 = nothing))
            (ghost_map_auth (msc_clientGS G gamM) qp_one m))
          (mkProperSep X D))
        (properUPred_ent_trans
          (mkProperSep (mkProperPure (glookup m 1 = nothing))
            (mkProperSep
              (mkProperSep (mkProperPure (glookup m 2 = nothing))
                (ghost_map_auth (msc_clientGS G gamM) qp_one m))
              (mkProperSep X D)))
          (mkProperSep
            (mkProperSep (mkProperPure (glookup m 2 = nothing))
              (ghost_map_auth (msc_clientGS G gamM) qp_one m))
            (mkProperSep X D)) Target
          (sep_elim_r_ent (mkProperPure (glookup m 1 = nothing))
            (mkProperSep
              (mkProperSep (mkProperPure (glookup m 2 = nothing))
                (ghost_map_auth (msc_clientGS G gamM) qp_one m))
              (mkProperSep X D)))
          (properUPred_ent_trans
            (mkProperSep
              (mkProperSep (mkProperPure (glookup m 2 = nothing))
                (ghost_map_auth (msc_clientGS G gamM) qp_one m))
              (mkProperSep X D))
            (mkProperSep (mkProperPure (glookup m 2 = nothing))
              (mkProperSep
                (ghost_map_auth (msc_clientGS G gamM) qp_one m)
                (mkProperSep X D))) Target
            (sep_assoc_l_ent (mkProperPure (glookup m 2 = nothing))
              (ghost_map_auth (msc_clientGS G gamM) qp_one m)
              (mkProperSep X D))
            (pure_sep_l_elim (glookup m 2 = nothing)
              (mkProperSep
                (ghost_map_auth (msc_clientGS G gamM) qp_one m)
                (mkProperSep X D)) Target (\lam absent =>
                msc_client_done_core_conflict G gamM m 2 old gamD
                  X Target absent)))))

-- The two public shard transitions.  The pending branch performs the joint
-- ghost-map/model update; the done branch is impossible because it owns a
-- full ghost map in which the corresponding key is absent.
\lemma msc_client1_state_step {S : gFunctors}
    (G : mscG S) (gam : msc_name) (gamM gamD : gname)
    (base total old : Nat) :
  properUPred_ent
    (mkProperSep (msc_client_inv G gam gamM gamD base)
      (mkProperSep (msc_counter_auth G gam total)
        (ghost_map_elem (msc_clientGS G gamM) 1 (old, gamD))))
    (mkProperBUpd
      (mkProperSep (msc_client_inv G gam gamM gamD base)
        (mkProperSep (msc_counter_auth G gam (suc total))
          (ghost_map_elem (msc_clientGS G gamM) 1 (suc old, gamD))))) =>
  sep_or_frame_elim_ent
    (msc_client_pending G gam gamM gamD base)
    (msc_client_done G gamM)
    (mkProperSep (msc_counter_auth G gam total)
      (ghost_map_elem (msc_clientGS G gamM) 1 (old, gamD)))
    (mkProperBUpd
      (mkProperSep (msc_client_inv G gam gamM gamD base)
        (mkProperSep (msc_counter_auth G gam (suc total))
          (ghost_map_elem (msc_clientGS G gamM) 1 (suc old, gamD)))))
    (msc_client_pending1_step G gam gamM gamD base total old)
    (msc_client_done1_step G gam gamM gamD base total old)

\lemma msc_client2_state_step {S : gFunctors}
    (G : mscG S) (gam : msc_name) (gamM gamD : gname)
    (base total old : Nat) :
  properUPred_ent
    (mkProperSep (msc_client_inv G gam gamM gamD base)
      (mkProperSep (msc_counter_auth G gam total)
        (ghost_map_elem (msc_clientGS G gamM) 2 (old, gamD))))
    (mkProperBUpd
      (mkProperSep (msc_client_inv G gam gamM gamD base)
        (mkProperSep (msc_counter_auth G gam (suc total))
          (ghost_map_elem (msc_clientGS G gamM) 2 (suc old, gamD))))) =>
  sep_or_frame_elim_ent
    (msc_client_pending G gam gamM gamD base)
    (msc_client_done G gamM)
    (mkProperSep (msc_counter_auth G gam total)
      (ghost_map_elem (msc_clientGS G gamM) 2 (old, gamD)))
    (mkProperBUpd
      (mkProperSep (msc_client_inv G gam gamM gamD base)
        (mkProperSep (msc_counter_auth G gam (suc total))
          (ghost_map_elem (msc_clientGS G gamM) 2 (suc old, gamD)))))
    (msc_client_pending2_step G gam gamM gamD base total old)
    (msc_client_done2_step G gam gamM gamD base total old)

\func msc_client_public {S : gFunctors} (H : irisGS natCountable S)
    (G : mscG S) (gam : msc_name) (gamM gamD : gname)
    (base : Nat) : iProp S =>
  iris.base_logic.lib.invariants.inv H.iris_wsat msc_clientN
    (msc_client_inv G gam gamM gamD base)

\lemma msc_client1_update {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (gamM gamD : gname) (base total old : Nat) :
  properUPred_ent
    (mkProperSep (msc_client_public H G gam gamM gamD base)
      (mkProperSep (msc_counter_auth G gam total)
        (ghost_map_elem (msc_clientGS G gamM) 1 (old, gamD))))
    (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
      (mkProperSep (msc_counter_auth G gam (suc total))
        (ghost_map_elem (msc_clientGS G gamM) 1 (suc old, gamD)))) =>
  inv_timeless_bupd_update H.iris_wsat msc_open_mask msc_clientN
    (msc_client_inv G gam gamM gamD base)
    (mkProperSep (msc_counter_auth G gam total)
      (ghost_map_elem (msc_clientGS G gamM) 1 (old, gamD)))
    (mkProperSep (msc_counter_auth G gam (suc total))
      (ghost_map_elem (msc_clientGS G gamM) 1 (suc old, gamD)))
    msc_clientN_subset_open
    (msc_client_inv_timeless G gam gamM gamD base)
    (msc_client1_state_step G gam gamM gamD base total old)

\lemma msc_client2_update {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (gamM gamD : gname) (base total old : Nat) :
  properUPred_ent
    (mkProperSep (msc_client_public H G gam gamM gamD base)
      (mkProperSep (msc_counter_auth G gam total)
        (ghost_map_elem (msc_clientGS G gamM) 2 (old, gamD))))
    (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
      (mkProperSep (msc_counter_auth G gam (suc total))
        (ghost_map_elem (msc_clientGS G gamM) 2 (suc old, gamD)))) =>
  inv_timeless_bupd_update H.iris_wsat msc_open_mask msc_clientN
    (msc_client_inv G gam gamM gamD base)
    (mkProperSep (msc_counter_auth G gam total)
      (ghost_map_elem (msc_clientGS G gamM) 2 (old, gamD)))
    (mkProperSep (msc_counter_auth G gam (suc total))
      (ghost_map_elem (msc_clientGS G gamM) 2 (suc old, gamD)))
    msc_clientN_subset_open
    (msc_client_inv_timeless G gam gamM gamD base)
    (msc_client2_state_step G gam gamM gamD base total old)

\lemma msc_client1_shift {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (gamM gamD : gname) (base old : Nat) :
  properUPred_ent (msc_client_public H G gam gamM gamD base)
    (msc_incr_shift H G gam
      (ghost_map_elem (msc_clientGS G gamM) 1 (old, gamD))
      (\lam _ => ghost_map_elem (msc_clientGS G gamM) 1
        (suc old, gamD))) =>
  \let
    | Public => msc_client_public H G gam gamM gamD base
    | P => ghost_map_elem (msc_clientGS G gamM) 1 (old, gamD)
    | Q : Nat -> iProp S => \lam _ =>
        ghost_map_elem (msc_clientGS G gamM) 1 (suc old, gamD)
    | perTotal : \Pi (total : Nat) -> properUPred_ent Public
        (mkProperPersistently
          (mkProperWand
            (mkProperSep (msc_counter_auth G gam total) P)
            (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
              (mkProperSep (msc_counter_auth G gam (suc total))
                (Q total))))) => \lam total =>
        properUPred_ent_trans Public (mkProperPersistently Public)
          (mkProperPersistently
            (mkProperWand
              (mkProperSep (msc_counter_auth G gam total) P)
              (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                (mkProperSep (msc_counter_auth G gam (suc total))
                  (Q total)))))
          (inv_persistent H.iris_wsat msc_clientN
            (msc_client_inv G gam gamM gamD base))
          ((BIuPredPersistentlyMixin (iResUR S)).persistently_mono
            Public
            (mkProperWand
              (mkProperSep (msc_counter_auth G gam total) P)
              (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                (mkProperSep (msc_counter_auth G gam (suc total))
                  (Q total))))
            (wand_intro_ent Public
              (mkProperSep (msc_counter_auth G gam total) P)
              (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                (mkProperSep (msc_counter_auth G gam (suc total))
                  (Q total)))
              (msc_client1_update H G gam gamM gamD base total old)))
  \in forall_intro_ent Public
      (\lam total => mkProperPersistently
        (mkProperWand
          (mkProperSep (msc_counter_auth G gam total) P)
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
            (mkProperSep (msc_counter_auth G gam (suc total))
              (Q total))))) perTotal

\lemma msc_client2_shift {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (gamM gamD : gname) (base old : Nat) :
  properUPred_ent (msc_client_public H G gam gamM gamD base)
    (msc_incr_shift H G gam
      (ghost_map_elem (msc_clientGS G gamM) 2 (old, gamD))
      (\lam _ => ghost_map_elem (msc_clientGS G gamM) 2
        (suc old, gamD))) =>
  \let
    | Public => msc_client_public H G gam gamM gamD base
    | P => ghost_map_elem (msc_clientGS G gamM) 2 (old, gamD)
    | Q : Nat -> iProp S => \lam _ =>
        ghost_map_elem (msc_clientGS G gamM) 2 (suc old, gamD)
    | perTotal : \Pi (total : Nat) -> properUPred_ent Public
        (mkProperPersistently
          (mkProperWand
            (mkProperSep (msc_counter_auth G gam total) P)
            (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
              (mkProperSep (msc_counter_auth G gam (suc total))
                (Q total))))) => \lam total =>
        properUPred_ent_trans Public (mkProperPersistently Public)
          (mkProperPersistently
            (mkProperWand
              (mkProperSep (msc_counter_auth G gam total) P)
              (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                (mkProperSep (msc_counter_auth G gam (suc total))
                  (Q total)))))
          (inv_persistent H.iris_wsat msc_clientN
            (msc_client_inv G gam gamM gamD base))
          ((BIuPredPersistentlyMixin (iResUR S)).persistently_mono
            Public
            (mkProperWand
              (mkProperSep (msc_counter_auth G gam total) P)
              (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                (mkProperSep (msc_counter_auth G gam (suc total))
                  (Q total))))
            (wand_intro_ent Public
              (mkProperSep (msc_counter_auth G gam total) P)
              (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                (mkProperSep (msc_counter_auth G gam (suc total))
                  (Q total)))
              (msc_client2_update H G gam gamM gamD base total old)))
  \in forall_intro_ent Public
      (\lam total => mkProperPersistently
        (mkProperWand
          (mkProperSep (msc_counter_auth G gam total) P)
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
            (mkProperSep (msc_counter_auth G gam (suc total))
              (Q total))))) perTotal

-- Keep a persistent premise as a frame while replacing one logical copy by
-- a consequence.  This is the small proof-mode pattern behind `#H` reuse.
\lemma persistent_keep_transform_ent {M : UCMRA}
    (P R Y : ProperUPred M)
    (persistentP : properUPred_ent P (mkProperPersistently P))
    (toY : properUPred_ent P Y) :
  properUPred_ent (mkProperSep P R)
    (mkProperSep (mkProperSep Y R) P) =>
  \let
    | Source => mkProperSep P R
    | WithCopy => mkProperSep Source P
    | Target => mkProperSep (mkProperSep Y R) P
    | sourcePersistent : properUPred_ent Source
        (mkProperPersistently P) =>
        properUPred_ent_trans Source P (mkProperPersistently P)
          (sep_elim_l_ent P R) persistentP
  \in properUPred_ent_trans Source WithCopy Target
      (persistent_consequence_frame_ent Source P sourcePersistent)
      (sep_mono_l_ent Source (mkProperSep Y R) P
        (sep_mono_l_ent P Y R toY))

\func msc_client1_incr_post {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (gamM gamD : gname) (base old : Nat) (c h : Value)
    (v : Value) : iProp S =>
  mkProperSep
    (msc_incr_post H G gam c h
      (\lam _ => ghost_map_elem (msc_clientGS G gamM) 1
        (suc old, gamD)) v)
    (msc_client_public H G gam gamM gamD base)

\func msc_client2_incr_post {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (gamM gamD : gname) (base old : Nat) (c h : Value)
    (v : Value) : iProp S =>
  mkProperSep
    (msc_incr_post H G gam c h
      (\lam _ => ghost_map_elem (msc_clientGS G gamM) 2
        (suc old, gamD)) v)
    (msc_client_public H G gam gamM gamD base)

\lemma msc_client1_incr_spec {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (gamM gamD : gname) (base old : Nat) (c h : Value) :
  properUPred_ent
    (mkProperSep (msc_client_public H G gam gamM gamD base)
      (mkProperSep (msc_is_counter H G gam c)
        (mkProperSep (msc_handle G gam h)
          (ghost_map_elem (msc_clientGS G gamM) 1 (old, gamD)))))
    (wp H mscE (app2 (Val msc_incr) (Val c) (Val h))
      (msc_client1_incr_post H G gam gamM gamD base old c h)) =>
  \let
    | Public => msc_client_public H G gam gamM gamD base
    | Elem => ghost_map_elem (msc_clientGS G gamM) 1 (old, gamD)
    | Next : Nat -> iProp S => \lam _ =>
        ghost_map_elem (msc_clientGS G gamM) 1 (suc old, gamD)
    | Shift => msc_incr_shift H G gam Elem Next
    | Rest => mkProperSep (msc_is_counter H G gam c)
        (mkProperSep (msc_handle G gam h) Elem)
    | CorePre => mkProperSep Shift Rest
    | CorePost => msc_incr_post H G gam c h Next
    | Expr => app2 (Val msc_incr) (Val c) (Val h)
  \in properUPred_ent_trans (mkProperSep Public Rest)
      (mkProperSep CorePre Public)
      (wp H mscE Expr (msc_client1_incr_post H G gam gamM gamD
        base old c h))
      (persistent_keep_transform_ent Public Rest Shift
        (inv_persistent H.iris_wsat msc_clientN
          (msc_client_inv G gam gamM gamD base))
        (msc_client1_shift H G gam gamM gamD base old))
      (properUPred_ent_trans (mkProperSep CorePre Public)
        (mkProperSep (wp H mscE Expr CorePost) Public)
        (wp H mscE Expr (wp_frame_post CorePost Public))
        (sep_mono_l_ent CorePre (wp H mscE Expr CorePost) Public
          (msc_incr_spec H G gam c h Elem Next))
        (wp_frame_r H mscE Expr CorePost Public))

\lemma msc_client2_incr_spec {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (gamM gamD : gname) (base old : Nat) (c h : Value) :
  properUPred_ent
    (mkProperSep (msc_client_public H G gam gamM gamD base)
      (mkProperSep (msc_is_counter H G gam c)
        (mkProperSep (msc_handle G gam h)
          (ghost_map_elem (msc_clientGS G gamM) 2 (old, gamD)))))
    (wp H mscE (app2 (Val msc_incr) (Val c) (Val h))
      (msc_client2_incr_post H G gam gamM gamD base old c h)) =>
  \let
    | Public => msc_client_public H G gam gamM gamD base
    | Elem => ghost_map_elem (msc_clientGS G gamM) 2 (old, gamD)
    | Next : Nat -> iProp S => \lam _ =>
        ghost_map_elem (msc_clientGS G gamM) 2 (suc old, gamD)
    | Shift => msc_incr_shift H G gam Elem Next
    | Rest => mkProperSep (msc_is_counter H G gam c)
        (mkProperSep (msc_handle G gam h) Elem)
    | CorePre => mkProperSep Shift Rest
    | CorePost => msc_incr_post H G gam c h Next
    | Expr => app2 (Val msc_incr) (Val c) (Val h)
  \in properUPred_ent_trans (mkProperSep Public Rest)
      (mkProperSep CorePre Public)
      (wp H mscE Expr (msc_client2_incr_post H G gam gamM gamD
        base old c h))
      (persistent_keep_transform_ent Public Rest Shift
        (inv_persistent H.iris_wsat msc_clientN
          (msc_client_inv G gam gamM gamD base))
        (msc_client2_shift H G gam gamM gamD base old))
      (properUPred_ent_trans (mkProperSep CorePre Public)
        (mkProperSep (wp H mscE Expr CorePost) Public)
        (wp H mscE Expr (wp_frame_post CorePost Public))
        (sep_mono_l_ent CorePre (wp H mscE Expr CorePost) Public
          (msc_incr_spec H G gam c h Elem Next))
        (wp_frame_r H mscE Expr CorePost Public))

\lemma msc_client1_incr_post_resources {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (gamM gamD : gname) (base old : Nat) (c h v : Value) :
  properUPred_ent
    (msc_client1_incr_post H G gam gamM gamD base old c h v)
    (mkProperSep (msc_client_public H G gam gamM gamD base)
      (mkProperSep (msc_is_counter H G gam c)
        (mkProperSep (msc_handle G gam h)
          (ghost_map_elem (msc_clientGS G gamM) 1
            (suc old, gamD))))) =>
  \let
    | Public => msc_client_public H G gam gamM gamD base
    | Elem => ghost_map_elem (msc_clientGS G gamM) 1 (suc old, gamD)
    | Result => msc_incr_result (\lam _ => Elem)
    | Resources => mkProperSep (msc_is_counter H G gam c)
        (mkProperSep (msc_handle G gam h) Result)
    | Ready => mkProperSep (msc_is_counter H G gam c)
        (mkProperSep (msc_handle G gam h) Elem)
    | coreToReady : properUPred_ent
        (msc_incr_post H G gam c h (\lam _ => Elem) v) Ready =>
        properUPred_ent_trans
          (msc_incr_post H G gam c h (\lam _ => Elem) v)
          Resources Ready
          (and_elim_r_ent (mkProperPure {iResUR S} (v = unitV)) Resources)
          (sep_mono_r_ent (msc_is_counter H G gam c)
            (mkProperSep (msc_handle G gam h) Result)
            (mkProperSep (msc_handle G gam h) Elem)
            (sep_mono_r_ent (msc_handle G gam h) Result Elem
              (exist_elim_ent (\lam _ => Elem) Elem
                (\lam _ => properUPred_ent_refl Elem))))
  \in properUPred_ent_trans
      (msc_client1_incr_post H G gam gamM gamD base old c h v)
      (mkProperSep Ready Public) (mkProperSep Public Ready)
      (sep_mono_l_ent
        (msc_incr_post H G gam c h (\lam _ => Elem) v)
        Ready Public coreToReady)
      (sep_comm_ent Ready Public)

\lemma msc_client2_incr_post_resources {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (gamM gamD : gname) (base old : Nat) (c h v : Value) :
  properUPred_ent
    (msc_client2_incr_post H G gam gamM gamD base old c h v)
    (mkProperSep (msc_client_public H G gam gamM gamD base)
      (mkProperSep (msc_is_counter H G gam c)
        (mkProperSep (msc_handle G gam h)
          (ghost_map_elem (msc_clientGS G gamM) 2
            (suc old, gamD))))) =>
  \let
    | Public => msc_client_public H G gam gamM gamD base
    | Elem => ghost_map_elem (msc_clientGS G gamM) 2 (suc old, gamD)
    | Result => msc_incr_result (\lam _ => Elem)
    | Resources => mkProperSep (msc_is_counter H G gam c)
        (mkProperSep (msc_handle G gam h) Result)
    | Ready => mkProperSep (msc_is_counter H G gam c)
        (mkProperSep (msc_handle G gam h) Elem)
    | coreToReady : properUPred_ent
        (msc_incr_post H G gam c h (\lam _ => Elem) v) Ready =>
        properUPred_ent_trans
          (msc_incr_post H G gam c h (\lam _ => Elem) v)
          Resources Ready
          (and_elim_r_ent (mkProperPure {iResUR S} (v = unitV)) Resources)
          (sep_mono_r_ent (msc_is_counter H G gam c)
            (mkProperSep (msc_handle G gam h) Result)
            (mkProperSep (msc_handle G gam h) Elem)
            (sep_mono_r_ent (msc_handle G gam h) Result Elem
              (exist_elim_ent (\lam _ => Elem) Elem
                (\lam _ => properUPred_ent_refl Elem))))
  \in properUPred_ent_trans
      (msc_client2_incr_post H G gam gamM gamD base old c h v)
      (mkProperSep Ready Public) (mkProperSep Public Ready)
      (sep_mono_l_ent
        (msc_incr_post H G gam c h (\lam _ => Elem) v)
        Ready Public coreToReady)
      (sep_comm_ent Ready Public)

\lemma msc_client1_incr_twice_body_spec {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (gamM gamD : gname) (base old : Nat) (c h : Value) :
  properUPred_ent
    (mkProperSep (msc_client_public H G gam gamM gamD base)
      (mkProperSep (msc_is_counter H G gam c)
        (mkProperSep (msc_handle G gam h)
          (ghost_map_elem (msc_clientGS G gamM) 1 (old, gamD)))))
    (wp H mscE
      (seqE (app2 (Val msc_incr) (Val c) (Val h))
        (app2 (Val msc_incr) (Val c) (Val h)))
      (msc_client1_incr_post H G gam gamM gamD base
        (suc old) c h)) =>
  \let
    | Incr => app2 (Val msc_incr) (Val c) (Val h)
    | FirstPost => msc_client1_incr_post H G gam gamM gamD base old c h
    | SecondPost => msc_client1_incr_post H G gam gamM gamD base
        (suc old) c h
    | first : properUPred_ent
        (mkProperSep (msc_client_public H G gam gamM gamD base)
          (mkProperSep (msc_is_counter H G gam c)
            (mkProperSep (msc_handle G gam h)
              (ghost_map_elem (msc_clientGS G gamM) 1 (old, gamD)))))
        (wp H mscE Incr FirstPost) =>
        msc_client1_incr_spec H G gam gamM gamD base old c h
    | continue : \Pi (v : Value) -> properUPred_ent (FirstPost v)
        (wp H mscE Incr SecondPost) => \lam v =>
        properUPred_ent_trans (FirstPost v)
          (mkProperSep (msc_client_public H G gam gamM gamD base)
            (mkProperSep (msc_is_counter H G gam c)
              (mkProperSep (msc_handle G gam h)
                (ghost_map_elem (msc_clientGS G gamM) 1
                  (suc old, gamD)))))
          (wp H mscE Incr SecondPost)
          (msc_client1_incr_post_resources H G gam gamM gamD
            base old c h v)
          (msc_client1_incr_spec H G gam gamM gamD base
            (suc old) c h)
  \in properUPred_ent_trans
      (mkProperSep (msc_client_public H G gam gamM gamD base)
        (mkProperSep (msc_is_counter H G gam c)
          (mkProperSep (msc_handle G gam h)
            (ghost_map_elem (msc_clientGS G gamM) 1 (old, gamD)))))
      (wp H mscE Incr (\lam v => wp H mscE Incr SecondPost))
      (wp H mscE (seqE Incr Incr) SecondPost)
      (properUPred_ent_trans
        (mkProperSep (msc_client_public H G gam gamM gamD base)
          (mkProperSep (msc_is_counter H G gam c)
            (mkProperSep (msc_handle G gam h)
              (ghost_map_elem (msc_clientGS G gamM) 1 (old, gamD)))))
        (wp H mscE Incr FirstPost)
        (wp H mscE Incr (\lam v => wp H mscE Incr SecondPost))
        first (wp_mono H mscE Incr FirstPost
          (\lam v => wp H mscE Incr SecondPost) continue))
      (wp_letE H mscE nIgnore Incr Incr SecondPost)

\lemma msc_client1_incr_twice_spec {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (gamM gamD : gname) (base old : Nat) (c h : Value) :
  properUPred_ent
    (mkProperSep (msc_client_public H G gam gamM gamD base)
      (mkProperSep (msc_is_counter H G gam c)
        (mkProperSep (msc_handle G gam h)
          (ghost_map_elem (msc_clientGS G gamM) 1 (old, gamD)))))
    (wp H mscE (app2 (Val msc_incr_twice) (Val c) (Val h))
      (msc_client1_incr_post H G gam gamM gamD base
        (suc old) c h)) =>
  \let
    | Pre => mkProperSep (msc_client_public H G gam gamM gamD base)
        (mkProperSep (msc_is_counter H G gam c)
          (mkProperSep (msc_handle G gam h)
            (ghost_map_elem (msc_clientGS G gamM) 1 (old, gamD))))
    | Incr => app2 (Val msc_incr) (Val c) (Val h)
    | BodyGeneric => seqE
        (app2 (Val msc_incr) (Var nC) (Var nK))
        (app2 (Val msc_incr) (Var nC) (Var nK))
    | BodyC => seqE
        (app2 (Val msc_incr) (Val c) (Var nK))
        (app2 (Val msc_incr) (Val c) (Var nK))
    | BodyAt => seqE Incr Incr
    | InnerLam => LamV nK BodyC
    | OuterApp => App (Val msc_incr_twice) (Val c)
    | Post => msc_client1_incr_post H G gam gamM gamD base
        (suc old) c h
    | PhiOuter : Value -> iProp S => \lam vf =>
        wp H mscE (App (Val vf) (Val h)) Post
    | body : properUPred_ent Pre (wp H mscE BodyAt Post) =>
        msc_client1_incr_twice_body_spec H G gam gamM gamD
          base old c h
    | innerApp : properUPred_ent Pre (PhiOuter InnerLam) =>
        properUPred_ent_trans Pre (wp H mscE BodyAt Post)
          (PhiOuter InnerLam) body
          (wp_lam_beta H mscE nK BodyC h Post)
    | innerValue : properUPred_ent Pre
        (wp H mscE (Val InnerLam) PhiOuter) =>
        properUPred_ent_trans Pre (PhiOuter InnerLam)
          (wp H mscE (Val InnerLam) PhiOuter) innerApp
          (wp_value_intro H mscE InnerLam PhiOuter)
    | innerExpr : properUPred_ent Pre
        (wp H mscE (Lam nK BodyC) PhiOuter) =>
        properUPred_ent_trans Pre (wp H mscE (Val InnerLam) PhiOuter)
          (wp H mscE (Lam nK BodyC) PhiOuter) innerValue
          (wp_lam_expr H mscE nK BodyC PhiOuter)
    | outerBeta : properUPred_ent Pre
        (wp H mscE OuterApp PhiOuter) =>
        properUPred_ent_trans Pre (wp H mscE (Lam nK BodyC) PhiOuter)
          (wp H mscE OuterApp PhiOuter) innerExpr
          (wp_lam_beta H mscE nC (Lam nK BodyGeneric) c PhiOuter)
  \in properUPred_ent_trans Pre (wp H mscE OuterApp PhiOuter)
      (wp H mscE (App OuterApp (Val h)) Post)
      outerBeta (wp_bind_app_l H mscE OuterApp (Val h) Post)

\lemma msc_client2_incr_twice_body_spec {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (gamM gamD : gname) (base old : Nat) (c h : Value) :
  properUPred_ent
    (mkProperSep (msc_client_public H G gam gamM gamD base)
      (mkProperSep (msc_is_counter H G gam c)
        (mkProperSep (msc_handle G gam h)
          (ghost_map_elem (msc_clientGS G gamM) 2 (old, gamD)))))
    (wp H mscE
      (seqE (app2 (Val msc_incr) (Val c) (Val h))
        (app2 (Val msc_incr) (Val c) (Val h)))
      (msc_client2_incr_post H G gam gamM gamD base
        (suc old) c h)) =>
  \let
    | Incr => app2 (Val msc_incr) (Val c) (Val h)
    | FirstPost => msc_client2_incr_post H G gam gamM gamD base old c h
    | SecondPost => msc_client2_incr_post H G gam gamM gamD base
        (suc old) c h
    | Pre => mkProperSep (msc_client_public H G gam gamM gamD base)
        (mkProperSep (msc_is_counter H G gam c)
          (mkProperSep (msc_handle G gam h)
            (ghost_map_elem (msc_clientGS G gamM) 2 (old, gamD))))
    | first : properUPred_ent Pre (wp H mscE Incr FirstPost) =>
        msc_client2_incr_spec H G gam gamM gamD base old c h
    | continue : \Pi (v : Value) -> properUPred_ent (FirstPost v)
        (wp H mscE Incr SecondPost) => \lam v =>
        properUPred_ent_trans (FirstPost v)
          (mkProperSep (msc_client_public H G gam gamM gamD base)
            (mkProperSep (msc_is_counter H G gam c)
              (mkProperSep (msc_handle G gam h)
                (ghost_map_elem (msc_clientGS G gamM) 2
                  (suc old, gamD)))))
          (wp H mscE Incr SecondPost)
          (msc_client2_incr_post_resources H G gam gamM gamD
            base old c h v)
          (msc_client2_incr_spec H G gam gamM gamD base
            (suc old) c h)
  \in properUPred_ent_trans Pre
      (wp H mscE Incr (\lam v => wp H mscE Incr SecondPost))
      (wp H mscE (seqE Incr Incr) SecondPost)
      (properUPred_ent_trans Pre (wp H mscE Incr FirstPost)
        (wp H mscE Incr (\lam v => wp H mscE Incr SecondPost))
        first (wp_mono H mscE Incr FirstPost
          (\lam v => wp H mscE Incr SecondPost) continue))
      (wp_letE H mscE nIgnore Incr Incr SecondPost)

\lemma msc_client2_incr_twice_spec {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (gamM gamD : gname) (base old : Nat) (c h : Value) :
  properUPred_ent
    (mkProperSep (msc_client_public H G gam gamM gamD base)
      (mkProperSep (msc_is_counter H G gam c)
        (mkProperSep (msc_handle G gam h)
          (ghost_map_elem (msc_clientGS G gamM) 2 (old, gamD)))))
    (wp H mscE (app2 (Val msc_incr_twice) (Val c) (Val h))
      (msc_client2_incr_post H G gam gamM gamD base
        (suc old) c h)) =>
  \let
    | Pre => mkProperSep (msc_client_public H G gam gamM gamD base)
        (mkProperSep (msc_is_counter H G gam c)
          (mkProperSep (msc_handle G gam h)
            (ghost_map_elem (msc_clientGS G gamM) 2 (old, gamD))))
    | Incr => app2 (Val msc_incr) (Val c) (Val h)
    | BodyGeneric => seqE
        (app2 (Val msc_incr) (Var nC) (Var nK))
        (app2 (Val msc_incr) (Var nC) (Var nK))
    | BodyC => seqE
        (app2 (Val msc_incr) (Val c) (Var nK))
        (app2 (Val msc_incr) (Val c) (Var nK))
    | BodyAt => seqE Incr Incr
    | InnerLam => LamV nK BodyC
    | OuterApp => App (Val msc_incr_twice) (Val c)
    | Post => msc_client2_incr_post H G gam gamM gamD base
        (suc old) c h
    | PhiOuter : Value -> iProp S => \lam vf =>
        wp H mscE (App (Val vf) (Val h)) Post
    | body : properUPred_ent Pre (wp H mscE BodyAt Post) =>
        msc_client2_incr_twice_body_spec H G gam gamM gamD
          base old c h
    | innerApp : properUPred_ent Pre (PhiOuter InnerLam) =>
        properUPred_ent_trans Pre (wp H mscE BodyAt Post)
          (PhiOuter InnerLam) body
          (wp_lam_beta H mscE nK BodyC h Post)
    | innerValue : properUPred_ent Pre
        (wp H mscE (Val InnerLam) PhiOuter) =>
        properUPred_ent_trans Pre (PhiOuter InnerLam)
          (wp H mscE (Val InnerLam) PhiOuter) innerApp
          (wp_value_intro H mscE InnerLam PhiOuter)
    | innerExpr : properUPred_ent Pre
        (wp H mscE (Lam nK BodyC) PhiOuter) =>
        properUPred_ent_trans Pre (wp H mscE (Val InnerLam) PhiOuter)
          (wp H mscE (Lam nK BodyC) PhiOuter) innerValue
          (wp_lam_expr H mscE nK BodyC PhiOuter)
    | outerBeta : properUPred_ent Pre
        (wp H mscE OuterApp PhiOuter) =>
        properUPred_ent_trans Pre (wp H mscE (Lam nK BodyC) PhiOuter)
          (wp H mscE OuterApp PhiOuter) innerExpr
          (wp_lam_beta H mscE nC (Lam nK BodyGeneric) c PhiOuter)
  \in properUPred_ent_trans Pre (wp H mscE OuterApp PhiOuter)
      (wp H mscE (App OuterApp (Val h)) Post)
      outerBeta (wp_bind_app_l H mscE OuterApp (Val h) Post)

\func msc_client1_twice_post {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (gamM gamD : gname) (base : Nat) (c h : Value) : Value -> iProp S =>
  msc_client1_incr_post H G gam gamM gamD base 1 c h

\func msc_client2_twice_post {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (gamM gamD : gname) (base : Nat) (c h : Value) : Value -> iProp S =>
  msc_client2_incr_post H G gam gamM gamD base 1 c h

\lemma msc_client1_thunk_spec {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (gamM gamD : gname) (base : Nat) (c h : Value) :
  properUPred_ent
    (mkProperSep (msc_client_public H G gam gamM gamD base)
      (mkProperSep (msc_is_counter H G gam c)
        (mkProperSep (msc_handle G gam h)
          (ghost_map_elem (msc_clientGS G gamM) 1 (0, gamD)))))
    (wp H mscE
      (App
        (Val (LamV nIgnore
          (app2 (Val msc_incr_twice) (Val c) (Val h))))
        (Val unitV))
      (msc_client1_twice_post H G gam gamM gamD base c h)) =>
  properUPred_ent_trans
    (mkProperSep (msc_client_public H G gam gamM gamD base)
      (mkProperSep (msc_is_counter H G gam c)
        (mkProperSep (msc_handle G gam h)
          (ghost_map_elem (msc_clientGS G gamM) 1 (0, gamD)))))
    (wp H mscE (app2 (Val msc_incr_twice) (Val c) (Val h))
      (msc_client1_twice_post H G gam gamM gamD base c h))
    (wp H mscE
      (App
        (Val (LamV nIgnore
          (app2 (Val msc_incr_twice) (Val c) (Val h))))
        (Val unitV))
      (msc_client1_twice_post H G gam gamM gamD base c h))
    (msc_client1_incr_twice_spec H G gam gamM gamD base 0 c h)
    (wp_lam_beta H mscE nIgnore
      (app2 (Val msc_incr_twice) (Val c) (Val h)) unitV
      (msc_client1_twice_post H G gam gamM gamD base c h))

\lemma msc_client2_thunk_spec {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (gamM gamD : gname) (base : Nat) (c h : Value) :
  properUPred_ent
    (mkProperSep (msc_client_public H G gam gamM gamD base)
      (mkProperSep (msc_is_counter H G gam c)
        (mkProperSep (msc_handle G gam h)
          (ghost_map_elem (msc_clientGS G gamM) 2 (0, gamD)))))
    (wp H mscE
      (App
        (Val (LamV nIgnore
          (app2 (Val msc_incr_twice) (Val c) (Val h))))
        (Val unitV))
      (msc_client2_twice_post H G gam gamM gamD base c h)) =>
  properUPred_ent_trans
    (mkProperSep (msc_client_public H G gam gamM gamD base)
      (mkProperSep (msc_is_counter H G gam c)
        (mkProperSep (msc_handle G gam h)
          (ghost_map_elem (msc_clientGS G gamM) 2 (0, gamD)))))
    (wp H mscE (app2 (Val msc_incr_twice) (Val c) (Val h))
      (msc_client2_twice_post H G gam gamM gamD base c h))
    (wp H mscE
      (App
        (Val (LamV nIgnore
          (app2 (Val msc_incr_twice) (Val c) (Val h))))
        (Val unitV))
      (msc_client2_twice_post H G gam gamM gamD base c h))
    (msc_client2_incr_twice_spec H G gam gamM gamD base 0 c h)
    (wp_lam_beta H mscE nIgnore
      (app2 (Val msc_incr_twice) (Val c) (Val h)) unitV
      (msc_client2_twice_post H G gam gamM gamD base c h))

\lemma msc_parallel_increments_spec {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (SG : spawnG S)
    (FPI : ForkPostInhabited H) (gam : msc_name)
    (gamM gamD : gname) (base : Nat) (c h1 h2 : Value) :
  \let
    | Pre1 => mkProperSep (msc_client_public H G gam gamM gamD base)
        (mkProperSep (msc_is_counter H G gam c)
          (mkProperSep (msc_handle G gam h1)
            (ghost_map_elem (msc_clientGS G gamM) 1 (0, gamD))))
    | Pre2 => mkProperSep (msc_client_public H G gam gamM gamD base)
        (mkProperSep (msc_is_counter H G gam c)
          (mkProperSep (msc_handle G gam h2)
            (ghost_map_elem (msc_clientGS G gamM) 2 (0, gamD))))
    | F1 => LamV nIgnore
        (app2 (Val msc_incr_twice) (Val c) (Val h1))
    | F2 => LamV nIgnore
        (app2 (Val msc_incr_twice) (Val c) (Val h2))
  \in properUPred_ent (mkProperSep Pre1 Pre2)
      (wp H mscE (app2 (Val par) (Val F1) (Val F2))
        (par_pair_post
          (msc_client1_twice_post H G gam gamM gamD base c h1)
          (msc_client2_twice_post H G gam gamM gamD base c h2))) =>
  \let
    | Pre1 => mkProperSep (msc_client_public H G gam gamM gamD base)
        (mkProperSep (msc_is_counter H G gam c)
          (mkProperSep (msc_handle G gam h1)
            (ghost_map_elem (msc_clientGS G gamM) 1 (0, gamD))))
    | Pre2 => mkProperSep (msc_client_public H G gam gamM gamD base)
        (mkProperSep (msc_is_counter H G gam c)
          (mkProperSep (msc_handle G gam h2)
            (ghost_map_elem (msc_clientGS G gamM) 2 (0, gamD))))
    | F1 => LamV nIgnore
        (app2 (Val msc_incr_twice) (Val c) (Val h1))
    | F2 => LamV nIgnore
        (app2 (Val msc_incr_twice) (Val c) (Val h2))
    | WP1 => wp H mscE (App (Val F1) (Val unitV))
        (msc_client1_twice_post H G gam gamM gamD base c h1)
    | WP2 => wp H mscE (App (Val F2) (Val unitV))
        (msc_client2_twice_post H G gam gamM gamD base c h2)
  \in properUPred_ent_trans (mkProperSep Pre1 Pre2)
      (mkProperSep WP1 WP2)
      (wp H mscE (app2 (Val par) (Val F1) (Val F2))
        (par_pair_post
          (msc_client1_twice_post H G gam gamM gamD base c h1)
          (msc_client2_twice_post H G gam gamM gamD base c h2)) )
      (properUPred_ent_trans (mkProperSep Pre1 Pre2)
        (mkProperSep WP1 Pre2) (mkProperSep WP1 WP2)
        (sep_mono_l_ent Pre1 WP1 Pre2
          (msc_client1_thunk_spec H G gam gamM gamD base c h1))
        (sep_mono_r_ent WP1 Pre2 WP2
          (msc_client2_thunk_spec H G gam gamM gamD base c h2)))
      (par_spec H SG FPI
        (msc_client1_twice_post H G gam gamM gamD base c h1)
        (msc_client2_twice_post H G gam gamM gamD base c h2) F1 F2)

\lemma msc_client_insert_two {S : gFunctors}
    (G : mscG S) (gam : msc_name) (gamM gamD : gname)
    (base : Nat) :
  properUPred_ent
    (mkProperSep
      (ghost_map_auth (msc_clientGS G gamM) qp_one gempty)
      (msc_counter_frag G gam qp_one base))
    (mkProperBUpd
      (mkProperSep (msc_client_inv G gam gamM gamD base)
        (mkProperSep
          (ghost_map_elem (msc_clientGS G gamM) 1 (0, gamD))
          (ghost_map_elem (msc_clientGS G gamM) 2 (0, gamD))))) =>
  \let
    | GM => msc_clientGS G gamM
    | m0 : Gmap Nat natCountable (\Sigma Nat gname) => gempty
    | m2 => ginsert 2 (0, gamD) m0
    | m21 => ginsert 1 (0, gamD) m2
    | A0 => ghost_map_auth GM qp_one m0
    | A2 => ghost_map_auth GM qp_one m2
    | A21 => ghost_map_auth GM qp_one m21
    | E1 => ghost_map_elem GM 1 (0, gamD)
    | E2 => ghost_map_elem GM 2 (0, gamD)
    | Frag => msc_counter_frag G gam qp_one base
    | Mid2 => mkProperSep (mkProperSep A2 E2) Frag
    | Ready2 => mkProperSep A2 (mkProperSep E2 Frag)
    | Mid21 => mkProperSep (mkProperSep A21 E1)
        (mkProperSep E2 Frag)
    | Grouped => mkProperSep (mkProperSep A21 Frag)
        (mkProperSep E2 E1)
    | Target => mkProperSep (msc_client_inv G gam gamM gamD base)
        (mkProperSep E1 E2)
    | first : properUPred_ent (mkProperSep A0 Frag)
        (mkProperBUpd Mid2) =>
        properUPred_ent_trans (mkProperSep A0 Frag)
          (mkProperSep (mkProperBUpd (mkProperSep A2 E2)) Frag)
          (mkProperBUpd Mid2)
          (sep_mono_l_ent A0 (mkProperBUpd (mkProperSep A2 E2)) Frag
            (ghost_map_insert GM m0 2 (0, gamD) (glookup_empty 2)))
          (bupd_frame_r (mkProperSep A2 E2) Frag)
    | secondCore : properUPred_ent Ready2
        (mkProperBUpd Mid21) =>
        properUPred_ent_trans Ready2
          (mkProperSep (mkProperBUpd (mkProperSep A21 E1))
            (mkProperSep E2 Frag))
          (mkProperBUpd Mid21)
          (sep_mono_l_ent A2 (mkProperBUpd (mkProperSep A21 E1))
            (mkProperSep E2 Frag)
            (ghost_map_insert GM m2 1 (0, gamD)
              (glookup_insert_ne 2 1 (0, gamD) m0 nat_two_ne_one *>
                glookup_empty 1)))
          (bupd_frame_r (mkProperSep A21 E1) (mkProperSep E2 Frag))
    | h1 : glookup m21 1 = just (0, gamD) =>
        glookup_insert_eq 1 (0, gamD) m2
    | h2 : glookup m21 2 = just (0, gamD) =>
        glookup_insert_ne 1 2 (0, gamD) m2 nat_one_ne_two *>
          glookup_insert_eq 2 (0, gamD) m0
    | finish : properUPred_ent Mid21 Target =>
        properUPred_ent_trans Mid21 Grouped Target
          (sep_cross4_ent A21 E1 E2 Frag)
          (properUPred_ent_trans Grouped
            (mkProperSep (msc_client_inv G gam gamM gamD base)
              (mkProperSep E2 E1)) Target
            (sep_mono_l_ent (mkProperSep A21 Frag)
              (msc_client_inv G gam gamM gamD base)
              (mkProperSep E2 E1)
              (msc_client_pending_intro G gam gamM gamD base 0 0 m21 h1 h2))
            (sep_mono_r_ent (msc_client_inv G gam gamM gamD base)
              (mkProperSep E2 E1) (mkProperSep E1 E2)
              (sep_comm_ent E2 E1)))
    | second : properUPred_ent Mid2 (mkProperBUpd Mid21) =>
        properUPred_ent_trans Mid2 Ready2 (mkProperBUpd Mid21)
          (sep_assoc_l_ent A2 E2 Frag) secondCore
    | both : properUPred_ent (mkProperSep A0 Frag)
        (mkProperBUpd Mid21) =>
        properUPred_ent_trans (mkProperSep A0 Frag)
          (mkProperBUpd (mkProperBUpd Mid21)) (mkProperBUpd Mid21)
          (properUPred_ent_trans (mkProperSep A0 Frag)
            (mkProperBUpd Mid2) (mkProperBUpd (mkProperBUpd Mid21))
            first (bupd_mono Mid2 (mkProperBUpd Mid21) second))
          (bupd_trans Mid21)
  \in properUPred_ent_trans (mkProperSep A0 Frag)
      (mkProperBUpd Mid21) (mkProperBUpd Target) both
      (bupd_mono Mid21 Target finish)

\func msc_client_linear_ready {S : gFunctors}
    (G : mscG S) (gam : msc_name) (gamM gamD : gname)
    (base : Nat) : iProp S =>
  mkProperSep (msc_client_inv G gam gamM gamD base)
    (mkProperSep
      (ghost_map_elem (msc_clientGS G gamM) 1 (0, gamD))
      (ghost_map_elem (msc_clientGS G gamM) 2 (0, gamD)))

\func msc_client_ready {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (gamM gamD : gname) (base : Nat) : iProp S =>
  mkProperSep (msc_client_public H G gam gamM gamD base)
    (mkProperSep
      (ghost_map_elem (msc_clientGS G gamM) 1 (0, gamD))
      (ghost_map_elem (msc_clientGS G gamM) 2 (0, gamD)))

\lemma msc_client_ghost_setup {S : gFunctors}
    (G : mscG S) (gam : msc_name) (gamD : gname) (base : Nat) :
  properUPred_ent (msc_counter_frag G gam qp_one base)
    (mkProperBUpd (mkProperExist gname (\lam gamM =>
      msc_client_linear_ready G gam gamM gamD base))) =>
  \let
    | Frag => msc_counter_frag G gam qp_one base
    | Maps => mkProperExist gname (\lam gamM =>
        ghost_map_auth (msc_clientGS G gamM) qp_one gempty)
    | Target => mkProperExist gname (\lam gamM =>
        msc_client_linear_ready G gam gamM gamD base)
    | allocated : properUPred_ent Frag
        (mkProperBUpd (mkProperSep Maps Frag)) =>
        bupd_alloc_frame Maps Frag
          (ghost_map_alloc_empty_name G.msc_request_mapG)
    | continue : properUPred_ent (mkProperSep Maps Frag)
        (mkProperBUpd Target) =>
        sep_exist_l_elim
          (\lam gamM => ghost_map_auth
            (msc_clientGS G gamM) qp_one gempty)
          Frag (mkProperBUpd Target) (\lam gamM =>
            properUPred_ent_trans
              (mkProperSep
                (ghost_map_auth (msc_clientGS G gamM) qp_one gempty) Frag)
              (mkProperBUpd
                (msc_client_linear_ready G gam gamM gamD base))
              (mkProperBUpd Target)
              (msc_client_insert_two G gam gamM gamD base)
              (bupd_mono
                (msc_client_linear_ready G gam gamM gamD base) Target
                (exist_intro_ent (\lam name =>
                  msc_client_linear_ready G gam name gamD base) gamM)))
  \in properUPred_ent_trans Frag
      (mkProperBUpd (mkProperBUpd Target)) (mkProperBUpd Target)
      (properUPred_ent_trans Frag (mkProperBUpd (mkProperSep Maps Frag))
        (mkProperBUpd (mkProperBUpd Target)) allocated
        (bupd_mono (mkProperSep Maps Frag) (mkProperBUpd Target) continue))
      (bupd_trans Target)

\lemma msc_client_allocate_public {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (gamM gamD : gname) (base : Nat) :
  properUPred_ent (msc_client_linear_ready G gam gamM gamD base)
    (mkProperFUpd H.iris_wsat mscE mscE
      (msc_client_ready H G gam gamM gamD base)) =>
  \let
    | Body => msc_client_inv G gam gamM gamD base
    | Public => msc_client_public H G gam gamM gamD base
    | Elems => mkProperSep
        (ghost_map_elem (msc_clientGS G gamM) 1 (0, gamD))
        (ghost_map_elem (msc_clientGS G gamM) 2 (0, gamD))
    | Source => mkProperSep Body Elems
    | Delayed => mkProperSep (mkProperLater Body) Elems
    | InvF => mkProperFUpd H.iris_wsat mscE mscE Public
    | delay : properUPred_ent Source Delayed =>
        sep_mono_l_ent Body (mkProperLater Body) Elems
          (proper_later_intro Body)
    | allocate : properUPred_ent Delayed
        (mkProperFUpd H.iris_wsat mscE mscE
          (mkProperSep Public Elems)) =>
        properUPred_ent_trans Delayed (mkProperSep InvF Elems)
          (mkProperFUpd H.iris_wsat mscE mscE
            (mkProperSep Public Elems))
          (sep_mono_l_ent (mkProperLater Body) InvF Elems
            (inv_alloc H.iris_wsat msc_clientN mscE Body))
          (fupd_frame_r H.iris_wsat mscE mscE Public Elems)
  \in properUPred_ent_trans Source Delayed
      (mkProperFUpd H.iris_wsat mscE mscE
        (msc_client_ready H G gam gamM gamD base)) delay allocate

\lemma msc_client_setup {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (gamD : gname) (base : Nat) :
  properUPred_ent (msc_counter_frag G gam qp_one base)
    (mkProperFUpd H.iris_wsat mscE mscE
      (mkProperExist gname (\lam gamM =>
        msc_client_ready H G gam gamM gamD base))) =>
  \let
    | Frag => msc_counter_frag G gam qp_one base
    | Linear => mkProperExist gname (\lam gamM =>
        msc_client_linear_ready G gam gamM gamD base)
    | Ready => mkProperExist gname (\lam gamM =>
        msc_client_ready H G gam gamM gamD base)
    | allocatePublic : properUPred_ent Linear
        (mkProperFUpd H.iris_wsat mscE mscE Ready) =>
        exist_elim_ent (\lam gamM =>
          msc_client_linear_ready G gam gamM gamD base)
          (mkProperFUpd H.iris_wsat mscE mscE Ready) (\lam gamM =>
            properUPred_ent_trans
              (msc_client_linear_ready G gam gamM gamD base)
              (mkProperFUpd H.iris_wsat mscE mscE
                (msc_client_ready H G gam gamM gamD base))
              (mkProperFUpd H.iris_wsat mscE mscE Ready)
              (msc_client_allocate_public H G gam gamM gamD base)
              (fupd_mono H.iris_wsat mscE mscE
                (msc_client_ready H G gam gamM gamD base) Ready
                (exist_intro_ent (\lam name =>
                  msc_client_ready H G gam name gamD base) gamM)))
  \in properUPred_ent_trans Frag
      (mkProperBUpd
        (mkProperFUpd H.iris_wsat mscE mscE Ready))
      (mkProperFUpd H.iris_wsat mscE mscE Ready)
      (properUPred_ent_trans Frag (mkProperBUpd Linear)
        (mkProperBUpd
          (mkProperFUpd H.iris_wsat mscE mscE Ready))
        (msc_client_ghost_setup G gam gamD base)
        (bupd_mono Linear
          (mkProperFUpd H.iris_wsat mscE mscE Ready) allocatePublic))
      (bupd_fupd_flatten H.iris_wsat mscE mscE Ready)

\lemma msc_parallel_post_resources {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (gamM gamD : gname) (base : Nat) (c h1 h2 returned : Value) :
  properUPred_ent
    (par_pair_post
      (msc_client1_twice_post H G gam gamM gamD base c h1)
      (msc_client2_twice_post H G gam gamM gamD base c h2) returned)
    (mkProperSep
      (mkProperSep (msc_client_public H G gam gamM gamD base)
        (mkProperSep (msc_is_counter H G gam c)
          (mkProperSep (msc_handle G gam h1)
            (ghost_map_elem (msc_clientGS G gamM) 1 (2, gamD)))))
      (mkProperSep (msc_client_public H G gam gamM gamD base)
        (mkProperSep (msc_is_counter H G gam c)
          (mkProperSep (msc_handle G gam h2)
            (ghost_map_elem (msc_clientGS G gamM) 2 (2, gamD)))))) =>
  \let
    | Psi1 => msc_client1_twice_post H G gam gamM gamD base c h1
    | Psi2 => msc_client2_twice_post H G gam gamM gamD base c h2
    | R1 => mkProperSep (msc_client_public H G gam gamM gamD base)
        (mkProperSep (msc_is_counter H G gam c)
          (mkProperSep (msc_handle G gam h1)
            (ghost_map_elem (msc_clientGS G gamM) 1 (2, gamD))))
    | R2 => mkProperSep (msc_client_public H G gam gamM gamD base)
        (mkProperSep (msc_is_counter H G gam c)
          (mkProperSep (msc_handle G gam h2)
            (ghost_map_elem (msc_clientGS G gamM) 2 (2, gamD))))
    | perV1 : \Pi (v1 : Value) -> properUPred_ent
        (mkProperExist Value (\lam v2 =>
          mkProperSep (mkProperPure (returned = PairV v1 v2))
            (mkProperSep (Psi1 v1) (Psi2 v2))))
        (mkProperSep R1 R2) => \lam v1 =>
        exist_elim_ent (\lam v2 =>
          mkProperSep (mkProperPure (returned = PairV v1 v2))
            (mkProperSep (Psi1 v1) (Psi2 v2)))
          (mkProperSep R1 R2) (\lam v2 =>
            properUPred_ent_trans
              (mkProperSep (mkProperPure (returned = PairV v1 v2))
                (mkProperSep (Psi1 v1) (Psi2 v2)))
              (mkProperSep (Psi1 v1) (Psi2 v2))
              (mkProperSep R1 R2)
              (sep_elim_r_ent
                (mkProperPure (returned = PairV v1 v2))
                (mkProperSep (Psi1 v1) (Psi2 v2)))
              (properUPred_ent_trans
                (mkProperSep (Psi1 v1) (Psi2 v2))
                (mkProperSep R1 (Psi2 v2)) (mkProperSep R1 R2)
                (sep_mono_l_ent (Psi1 v1) R1 (Psi2 v2)
                  (msc_client1_incr_post_resources H G gam gamM gamD
                    base 1 c h1 v1))
                (sep_mono_r_ent R1 (Psi2 v2) R2
                  (msc_client2_incr_post_resources H G gam gamM gamD
                    base 1 c h2 v2))))
  \in exist_elim_ent (\lam v1 => mkProperExist Value (\lam v2 =>
      mkProperSep (mkProperPure (returned = PairV v1 v2))
        (mkProperSep (Psi1 v1) (Psi2 v2))))
    (mkProperSep R1 R2) perV1

\func msc_client_read_Q {S : gFunctors} (G : mscG S)
    (gam : msc_name) (base total : Nat) : iProp S =>
  mkProperSep (mkProperPure (total = base Nat.+ 4))
    (msc_counter_frag G gam qp_one (base Nat.+ 4))

\lemma msc_client_read_commit {S : gFunctors}
    (G : mscG S) (gam : msc_name) (gamM gamD : gname)
    (base total k1 k2 : Nat)
    (m : Gmap Nat natCountable (\Sigma Nat gname))
    (hk1 : k1 = 2) (hk2 : k2 = 2)
    (htotal : total = base Nat.+ k1 Nat.+ k2) :
  properUPred_ent
    (mkProperSep
      (mkProperSep
        (ghost_map_auth (msc_clientGS G gamM) qp_one m)
        (mkProperSep
          (ghost_map_elem (msc_clientGS G gamM) 1 (2, gamD))
          (ghost_map_elem (msc_clientGS G gamM) 2 (2, gamD))))
      (mkProperSep (msc_counter_auth G gam total)
        (msc_counter_frag G gam qp_one (base Nat.+ k1 Nat.+ k2))))
    (mkProperBUpd
      (mkProperSep (msc_client_inv G gam gamM gamD base)
        (mkProperSep (msc_counter_auth G gam total)
          (msc_client_read_Q G gam base total)))) =>
  \let
    | GM => msc_clientGS G gamM
    | A => ghost_map_auth GM qp_one m
    | E1 => ghost_map_elem GM 1 (2, gamD)
    | E2 => ghost_map_elem GM 2 (2, gamD)
    | m1 => gdelete 1 m
    | m12 => gdelete 2 m1
    | A1 => ghost_map_auth GM qp_one m1
    | A12 => ghost_map_auth GM qp_one m12
    | C => msc_counter_auth G gam total
    | F => msc_counter_frag G gam qp_one (base Nat.+ k1 Nat.+ k2)
    | CF => mkProperSep C F
    | Source => mkProperSep (mkProperSep A (mkProperSep E1 E2)) CF
    | Ready1 => mkProperSep (mkProperSep A E1) (mkProperSep E2 CF)
    | After1 => mkProperSep A1 (mkProperSep E2 CF)
    | Ready2 => mkProperSep (mkProperSep A1 E2) CF
    | After2 => mkProperSep A12 CF
    | first : properUPred_ent Ready1 (mkProperBUpd After1) =>
        properUPred_ent_trans Ready1
          (mkProperSep (mkProperBUpd A1) (mkProperSep E2 CF))
          (mkProperBUpd After1)
          (sep_mono_l_ent (mkProperSep A E1) (mkProperBUpd A1)
            (mkProperSep E2 CF) (ghost_map_delete GM m 1 (2, gamD)))
          (bupd_frame_r A1 (mkProperSep E2 CF))
    | second : properUPred_ent Ready2 (mkProperBUpd After2) =>
        properUPred_ent_trans Ready2
          (mkProperSep (mkProperBUpd A12) CF)
          (mkProperBUpd After2)
          (sep_mono_l_ent (mkProperSep A1 E2) (mkProperBUpd A12) CF
            (ghost_map_delete GM m1 2 (2, gamD)))
          (bupd_frame_r A12 CF)
    | deleted : properUPred_ent Source (mkProperBUpd After2) =>
        properUPred_ent_trans Source Ready1 (mkProperBUpd After2)
          (properUPred_ent_trans Source
            (mkProperSep (mkProperSep (mkProperSep A E1) E2) CF) Ready1
            (sep_mono_l_ent (mkProperSep A (mkProperSep E1 E2))
              (mkProperSep (mkProperSep A E1) E2) CF
              (sep_assoc_r_ent A E1 E2))
            (sep_assoc_l_ent (mkProperSep A E1) E2 CF))
          (properUPred_ent_trans Ready1
            (mkProperBUpd (mkProperBUpd After2)) (mkProperBUpd After2)
            (properUPred_ent_trans Ready1 (mkProperBUpd After1)
              (mkProperBUpd (mkProperBUpd After2)) first
              (bupd_mono After1 (mkProperBUpd After2)
                (properUPred_ent_trans After1 Ready2
                  (mkProperBUpd After2)
                  (sep_assoc_r_ent A1 E2 CF) second)))
            (bupd_trans After2))
    | absent1 : glookup m12 1 = nothing =>
        glookup_delete_ne 2 1 m1 nat_two_ne_one *>
          glookup_delete_eq 1 m
    | absent2 : glookup m12 2 = nothing => glookup_delete_eq 2 m1
    | Done => msc_client_done G gamM
    | makeDone : properUPred_ent A12
        (msc_client_inv G gam gamM gamD base) =>
        properUPred_ent_trans A12
          (mkProperSep (mkProperPure (glookup m12 2 = nothing)) A12)
          (msc_client_inv G gam gamM gamD base)
          (pure_intro_sep_ent (glookup m12 2 = nothing) absent2 A12)
          (properUPred_ent_trans
            (mkProperSep (mkProperPure (glookup m12 2 = nothing)) A12)
            (mkProperSep (mkProperPure (glookup m12 1 = nothing))
              (mkProperSep (mkProperPure (glookup m12 2 = nothing)) A12))
            (msc_client_inv G gam gamM gamD base)
            (pure_intro_sep_ent (glookup m12 1 = nothing) absent1
              (mkProperSep (mkProperPure (glookup m12 2 = nothing)) A12))
            (properUPred_ent_trans
              (mkProperSep (mkProperPure (glookup m12 1 = nothing))
                (mkProperSep (mkProperPure (glookup m12 2 = nothing)) A12))
              Done (msc_client_inv G gam gamM gamD base)
              (exist_intro_ent (\lam map =>
                mkProperSep (mkProperPure (glookup map 1 = nothing))
                  (mkProperSep (mkProperPure (glookup map 2 = nothing))
                    (ghost_map_auth (msc_clientGS G gamM) qp_one map))) m12)
              (or_intro_r_ent
                (msc_client_pending G gam gamM gamD base) Done)))
    | totalEq : total = base Nat.+ 4 =>
        htotal *> pmap (\lam z => base Nat.+ z Nat.+ k2) hk1 *>
          pmap (\lam z => base Nat.+ 2 Nat.+ z) hk2
    | indexEq : base Nat.+ k1 Nat.+ k2 = base Nat.+ 4 =>
        pmap (\lam z => base Nat.+ z Nat.+ k2) hk1 *>
          pmap (\lam z => base Nat.+ 2 Nat.+ z) hk2
    | makeQ : properUPred_ent CF
        (mkProperSep C (msc_client_read_Q G gam base total)) =>
        sep_mono_r_ent C F (msc_client_read_Q G gam base total)
          (transport
            (\lam n => properUPred_ent
              (msc_counter_frag G gam qp_one n)
              (mkProperSep (mkProperPure (total = base Nat.+ 4))
                (msc_counter_frag G gam qp_one (base Nat.+ 4))))
            (inv indexEq)
            (pure_intro_sep_ent (total = base Nat.+ 4) totalEq
              (msc_counter_frag G gam qp_one (base Nat.+ 4))))
    | finish : properUPred_ent After2
        (mkProperSep (msc_client_inv G gam gamM gamD base)
          (mkProperSep C (msc_client_read_Q G gam base total))) =>
        properUPred_ent_trans After2
          (mkProperSep (msc_client_inv G gam gamM gamD base) CF)
          (mkProperSep (msc_client_inv G gam gamM gamD base)
            (mkProperSep C (msc_client_read_Q G gam base total)))
          (sep_mono_l_ent A12
            (msc_client_inv G gam gamM gamD base) CF makeDone)
          (sep_mono_r_ent (msc_client_inv G gam gamM gamD base) CF
            (mkProperSep C (msc_client_read_Q G gam base total)) makeQ)
  \in properUPred_ent_trans Source (mkProperBUpd After2)
      (mkProperBUpd
        (mkProperSep (msc_client_inv G gam gamM gamD base)
          (mkProperSep C (msc_client_read_Q G gam base total))))
      deleted (bupd_mono After2
        (mkProperSep (msc_client_inv G gam gamM gamD base)
          (mkProperSep C (msc_client_read_Q G gam base total))) finish)

\lemma msc_client_read_pending_step {S : gFunctors}
    (G : mscG S) (gam : msc_name) (gamM gamD : gname)
    (base total : Nat) :
  \let
    | E1 => ghost_map_elem (msc_clientGS G gamM) 1 (2, gamD)
    | E2 => ghost_map_elem (msc_clientGS G gamM) 2 (2, gamD)
    | X => mkProperSep (msc_counter_auth G gam total)
        (mkProperSep E1 E2)
    | Target => mkProperBUpd
        (mkProperSep (msc_client_inv G gam gamM gamD base)
          (mkProperSep (msc_counter_auth G gam total)
            (msc_client_read_Q G gam base total)))
  \in properUPred_ent
      (mkProperSep (msc_client_pending G gam gamM gamD base) X) Target =>
  \let
    | GM => msc_clientGS G gamM
    | E1 => ghost_map_elem GM 1 (2, gamD)
    | E2 => ghost_map_elem GM 2 (2, gamD)
    | C => msc_counter_auth G gam total
    | X => mkProperSep C (mkProperSep E1 E2)
    | Target => mkProperBUpd
        (mkProperSep (msc_client_inv G gam gamM gamD base)
          (mkProperSep C (msc_client_read_Q G gam base total)))
    | perK1 : \Pi (k1 : Nat) -> properUPred_ent
        (mkProperSep
          (mkProperExist Nat (\lam k2 =>
            mkProperExist (Gmap Nat natCountable (\Sigma Nat gname))
              (msc_client_pending_at G gam gamM gamD base k1 k2))) X)
        Target => \lam k1 =>
        sep_exist_l_elim (\lam k2 =>
          mkProperExist (Gmap Nat natCountable (\Sigma Nat gname))
            (msc_client_pending_at G gam gamM gamD base k1 k2))
          X Target (\lam k2 =>
            sep_exist_l_elim
              (msc_client_pending_at G gam gamM gamD base k1 k2)
              X Target (\lam m =>
                \let
                  | H1 => mkProperPure {iResUR S}
                      (glookup m 1 = just (k1, gamD))
                  | H2 => mkProperPure {iResUR S}
                      (glookup m 2 = just (k2, gamD))
                  | A => ghost_map_auth GM qp_one m
                  | F => msc_counter_frag G gam qp_one
                      (base Nat.+ k1 Nat.+ k2)
                  | Core => mkProperSep (mkProperSep A F) X
                  | Ready => mkProperSep (mkProperSep A (mkProperSep E1 E2))
                      (mkProperSep C F)
                  | lookup1 => glookup m 1 = just (2, gamD)
                  | lookup2 => glookup m 2 = just (2, gamD)
                  | totalFact => total = base Nat.+ k1 Nat.+ k2
                  | lookup1Ent : properUPred_ent Ready
                      (mkProperPure lookup1) =>
                      properUPred_ent_trans Ready
                        (mkProperSep A E1) (mkProperPure lookup1)
                        (properUPred_ent_trans Ready
                          (mkProperSep A (mkProperSep E1 E2))
                          (mkProperSep A E1)
                          (sep_elim_l_ent
                            (mkProperSep A (mkProperSep E1 E2))
                            (mkProperSep C F))
                          (sep_mono_r_ent A (mkProperSep E1 E2) E1
                            (sep_elim_l_ent E1 E2)))
                        (ghost_map_lookup GM m 1 (2, gamD))
                  | lookup2Ent : properUPred_ent Ready
                      (mkProperPure lookup2) =>
                      properUPred_ent_trans Ready
                        (mkProperSep A E2) (mkProperPure lookup2)
                        (properUPred_ent_trans Ready
                          (mkProperSep A (mkProperSep E1 E2))
                          (mkProperSep A E2)
                          (sep_elim_l_ent
                            (mkProperSep A (mkProperSep E1 E2))
                            (mkProperSep C F))
                          (sep_mono_r_ent A (mkProperSep E1 E2) E2
                            (sep_elim_r_ent E1 E2)))
                        (ghost_map_lookup GM m 2 (2, gamD))
                  | totalEnt : properUPred_ent Ready
                      (mkProperPure totalFact) =>
                      properUPred_ent_trans Ready (mkProperSep C F)
                        (mkProperPure totalFact)
                        (sep_elim_r_ent
                          (mkProperSep A (mkProperSep E1 E2))
                          (mkProperSep C F))
                        (msc_auth_frag_agree G.msc_modelG
                          gam.msc_model_name total
                          (base Nat.+ k1 Nat.+ k2))
                  | finish : (glookup m 1 = just (k1, gamD)) ->
                      (glookup m 2 = just (k2, gamD)) ->
                      properUPred_ent Core Target => \lam stored1 stored2 =>
                      properUPred_ent_trans Core Ready Target
                        (sep_cross4_ent A F C (mkProperSep E1 E2))
                        (properUPred_ent_trans Ready
                          (mkProperSep (mkProperPure lookup1) Ready) Target
                          (pure_consequence_frame_ent Ready lookup1 lookup1Ent)
                          (pure_sep_l_elim lookup1 Ready Target (\lam ext1 =>
                            properUPred_ent_trans Ready
                              (mkProperSep (mkProperPure lookup2) Ready) Target
                              (pure_consequence_frame_ent Ready lookup2 lookup2Ent)
                              (pure_sep_l_elim lookup2 Ready Target (\lam ext2 =>
                                properUPred_ent_trans Ready
                                  (mkProperSep (mkProperPure totalFact) Ready)
                                  Target
                                  (pure_consequence_frame_ent Ready totalFact
                                    totalEnt)
                                  (pure_sep_l_elim totalFact Ready Target
                                    (\lam ht =>
                                      msc_client_read_commit G gam gamM gamD
                                        base total k1 k2 m
                                        (msc_client_lookup_nat_agree m 1 k1 2
                                          gamD stored1 ext1)
                                        (msc_client_lookup_nat_agree m 2 k2 2
                                          gamD stored2 ext2) ht)))))))
                \in properUPred_ent_trans
                    (mkProperSep
                      (msc_client_pending_at G gam gamM gamD base k1 k2 m) X)
                    (mkProperSep H1
                      (mkProperSep (mkProperSep H2 (mkProperSep A F)) X))
                    Target
                    (sep_assoc_l_ent H1
                      (mkProperSep H2 (mkProperSep A F)) X)
                    (pure_sep_l_elim
                      (glookup m 1 = just (k1, gamD))
                      (mkProperSep (mkProperSep H2 (mkProperSep A F)) X)
                      Target (\lam stored1 =>
                        properUPred_ent_trans
                          (mkProperSep (mkProperSep H2 (mkProperSep A F)) X)
                          (mkProperSep H2 Core) Target
                          (sep_assoc_l_ent H2 (mkProperSep A F) X)
                          (pure_sep_l_elim
                            (glookup m 2 = just (k2, gamD)) Core Target
                            (finish stored1))))))
  \in sep_exist_l_elim (\lam k1 =>
      mkProperExist Nat (\lam k2 =>
        mkProperExist (Gmap Nat natCountable (\Sigma Nat gname))
          (msc_client_pending_at G gam gamM gamD base k1 k2)))
    X Target perK1

\lemma msc_client_read_done_step {S : gFunctors}
    (G : mscG S) (gam : msc_name) (gamM gamD : gname)
    (base total : Nat) :
  \let
    | E1 => ghost_map_elem (msc_clientGS G gamM) 1 (2, gamD)
    | E2 => ghost_map_elem (msc_clientGS G gamM) 2 (2, gamD)
    | X => mkProperSep (msc_counter_auth G gam total)
        (mkProperSep E1 E2)
    | Target => mkProperBUpd
        (mkProperSep (msc_client_inv G gam gamM gamD base)
          (mkProperSep (msc_counter_auth G gam total)
            (msc_client_read_Q G gam base total)))
  \in properUPred_ent
      (mkProperSep (msc_client_done G gamM) X) Target =>
  \let
    | GM => msc_clientGS G gamM
    | E1 => ghost_map_elem GM 1 (2, gamD)
    | E2 => ghost_map_elem GM 2 (2, gamD)
    | C => msc_counter_auth G gam total
    | X => mkProperSep C (mkProperSep E1 E2)
    | Target => mkProperBUpd
        (mkProperSep (msc_client_inv G gam gamM gamD base)
          (mkProperSep C (msc_client_read_Q G gam base total)))
  \in sep_exist_l_elim (\lam m =>
      mkProperSep (mkProperPure (glookup m 1 = nothing))
        (mkProperSep (mkProperPure (glookup m 2 = nothing))
          (ghost_map_auth GM qp_one m))) X Target (\lam m =>
      properUPred_ent_trans
        (mkProperSep
          (mkProperSep (mkProperPure (glookup m 1 = nothing))
            (mkProperSep (mkProperPure (glookup m 2 = nothing))
              (ghost_map_auth GM qp_one m))) X)
        (mkProperSep (mkProperPure (glookup m 1 = nothing))
          (mkProperSep
            (mkProperSep (mkProperPure (glookup m 2 = nothing))
              (ghost_map_auth GM qp_one m)) X)) Target
        (sep_assoc_l_ent (mkProperPure (glookup m 1 = nothing))
          (mkProperSep (mkProperPure (glookup m 2 = nothing))
            (ghost_map_auth GM qp_one m)) X)
        (pure_sep_l_elim (glookup m 1 = nothing)
          (mkProperSep
            (mkProperSep (mkProperPure (glookup m 2 = nothing))
              (ghost_map_auth GM qp_one m)) X) Target (\lam absent =>
            properUPred_ent_trans
              (mkProperSep
                (mkProperSep (mkProperPure (glookup m 2 = nothing))
                  (ghost_map_auth GM qp_one m)) X)
              (mkProperSep (ghost_map_auth GM qp_one m)
                (mkProperSep (mkProperSep C E2) E1)) Target
              (properUPred_ent_trans
                (mkProperSep
                  (mkProperSep (mkProperPure (glookup m 2 = nothing))
                    (ghost_map_auth GM qp_one m)) X)
                (mkProperSep (ghost_map_auth GM qp_one m) X)
                (mkProperSep (ghost_map_auth GM qp_one m)
                  (mkProperSep (mkProperSep C E2) E1))
                (sep_mono_l_ent
                  (mkProperSep (mkProperPure (glookup m 2 = nothing))
                    (ghost_map_auth GM qp_one m))
                  (ghost_map_auth GM qp_one m) X
                  (sep_elim_r_ent
                    (mkProperPure (glookup m 2 = nothing))
                    (ghost_map_auth GM qp_one m)))
                (sep_mono_r_ent (ghost_map_auth GM qp_one m) X
                  (mkProperSep (mkProperSep C E2) E1)
                  (properUPred_ent_trans X
                    (mkProperSep C (mkProperSep E2 E1))
                    (mkProperSep (mkProperSep C E2) E1)
                    (sep_mono_r_ent C (mkProperSep E1 E2)
                      (mkProperSep E2 E1) (sep_comm_ent E1 E2))
                    (sep_assoc_r_ent C E2 E1))))
              (msc_client_done_core_conflict G gamM m 1 2 gamD
                (mkProperSep C E2) Target absent))))

\lemma msc_client_read_state_step {S : gFunctors}
    (G : mscG S) (gam : msc_name) (gamM gamD : gname)
    (base total : Nat) :
  \let
    | E1 => ghost_map_elem (msc_clientGS G gamM) 1 (2, gamD)
    | E2 => ghost_map_elem (msc_clientGS G gamM) 2 (2, gamD)
    | X => mkProperSep (msc_counter_auth G gam total)
        (mkProperSep E1 E2)
    | Target => mkProperBUpd
        (mkProperSep (msc_client_inv G gam gamM gamD base)
          (mkProperSep (msc_counter_auth G gam total)
            (msc_client_read_Q G gam base total)))
  \in properUPred_ent
      (mkProperSep (msc_client_inv G gam gamM gamD base) X) Target =>
  sep_or_frame_elim_ent
    (msc_client_pending G gam gamM gamD base)
    (msc_client_done G gamM)
    (mkProperSep (msc_counter_auth G gam total)
      (mkProperSep
        (ghost_map_elem (msc_clientGS G gamM) 1 (2, gamD))
        (ghost_map_elem (msc_clientGS G gamM) 2 (2, gamD))))
    (mkProperBUpd
      (mkProperSep (msc_client_inv G gam gamM gamD base)
        (mkProperSep (msc_counter_auth G gam total)
          (msc_client_read_Q G gam base total))))
    (msc_client_read_pending_step G gam gamM gamD base total)
    (msc_client_read_done_step G gam gamM gamD base total)

\lemma msc_client_read_update {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (gamM gamD : gname) (base total : Nat) :
  \let
    | P => mkProperSep
        (ghost_map_elem (msc_clientGS G gamM) 1 (2, gamD))
        (ghost_map_elem (msc_clientGS G gamM) 2 (2, gamD))
  \in properUPred_ent
      (mkProperSep (msc_client_public H G gam gamM gamD base)
        (mkProperSep (msc_counter_auth G gam total) P))
      (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
        (mkProperSep (msc_counter_auth G gam total)
          (msc_client_read_Q G gam base total))) =>
  \let
    | P => mkProperSep
        (ghost_map_elem (msc_clientGS G gamM) 1 (2, gamD))
        (ghost_map_elem (msc_clientGS G gamM) 2 (2, gamD))
  \in inv_timeless_bupd_update H.iris_wsat msc_open_mask msc_clientN
      (msc_client_inv G gam gamM gamD base)
      (mkProperSep (msc_counter_auth G gam total) P)
      (mkProperSep (msc_counter_auth G gam total)
        (msc_client_read_Q G gam base total))
      msc_clientN_subset_open
      (msc_client_inv_timeless G gam gamM gamD base)
      (msc_client_read_state_step G gam gamM gamD base total)

\lemma msc_client_read_shift {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S)
    (gam : msc_name) (gamM gamD : gname) (base : Nat) :
  \let
    | P => mkProperSep
        (ghost_map_elem (msc_clientGS G gamM) 1 (2, gamD))
        (ghost_map_elem (msc_clientGS G gamM) 2 (2, gamD))
    | Q : Nat -> iProp S => msc_client_read_Q G gam base
  \in properUPred_ent (msc_client_public H G gam gamM gamD base)
      (msc_read_shift H G gam P Q) =>
  \let
    | Public => msc_client_public H G gam gamM gamD base
    | P => mkProperSep
        (ghost_map_elem (msc_clientGS G gamM) 1 (2, gamD))
        (ghost_map_elem (msc_clientGS G gamM) 2 (2, gamD))
    | Q : Nat -> iProp S => msc_client_read_Q G gam base
    | perTotal : \Pi (total : Nat) -> properUPred_ent Public
        (mkProperPersistently
          (mkProperWand
            (mkProperSep (msc_counter_auth G gam total) P)
            (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
              (mkProperSep (msc_counter_auth G gam total) (Q total))))) =>
        \lam total => properUPred_ent_trans Public
          (mkProperPersistently Public)
          (mkProperPersistently
            (mkProperWand
              (mkProperSep (msc_counter_auth G gam total) P)
              (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                (mkProperSep (msc_counter_auth G gam total) (Q total)))))
          (inv_persistent H.iris_wsat msc_clientN
            (msc_client_inv G gam gamM gamD base))
          ((BIuPredPersistentlyMixin (iResUR S)).persistently_mono
            Public
            (mkProperWand
              (mkProperSep (msc_counter_auth G gam total) P)
              (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                (mkProperSep (msc_counter_auth G gam total) (Q total))))
            (wand_intro_ent Public
              (mkProperSep (msc_counter_auth G gam total) P)
              (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
                (mkProperSep (msc_counter_auth G gam total) (Q total)))
              (msc_client_read_update H G gam gamM gamD base total)))
  \in forall_intro_ent Public
      (\lam total => mkProperPersistently
        (mkProperWand
          (mkProperSep (msc_counter_auth G gam total) P)
          (mkProperFUpd H.iris_wsat msc_open_mask msc_open_mask
            (mkProperSep (msc_counter_auth G gam total) (Q total)))))
      perTotal

\lemma sep_prepare_read6 {M : UCMRA}
    (A B C D E F : ProperUPred M) :
  properUPred_ent
    (mkProperSep (mkProperSep A (mkProperSep B (mkProperSep C D)))
      (mkProperSep E F))
    (mkProperSep (mkProperSep A (mkProperSep B (mkProperSep D F)))
      (mkProperSep C E)) =>
  \let
    | S0 => mkProperSep (mkProperSep A (mkProperSep B (mkProperSep C D)))
        (mkProperSep E F)
    | S1 => mkProperSep A
        (mkProperSep (mkProperSep B (mkProperSep C D)) (mkProperSep E F))
    | S2 => mkProperSep A (mkProperSep B
        (mkProperSep (mkProperSep C D) (mkProperSep E F)))
    | S3 => mkProperSep A (mkProperSep B
        (mkProperSep C (mkProperSep D (mkProperSep E F))))
    | S4 => mkProperSep A (mkProperSep B
        (mkProperSep D (mkProperSep C (mkProperSep E F))))
    | S5 => mkProperSep A (mkProperSep B
        (mkProperSep D (mkProperSep C (mkProperSep F E))))
    | S6 => mkProperSep A (mkProperSep B
        (mkProperSep D (mkProperSep F (mkProperSep C E))))
    | S7 => mkProperSep A (mkProperSep B
        (mkProperSep (mkProperSep D F) (mkProperSep C E)))
    | S8 => mkProperSep A
        (mkProperSep (mkProperSep B (mkProperSep D F)) (mkProperSep C E))
    | S9 => mkProperSep (mkProperSep A (mkProperSep B (mkProperSep D F)))
        (mkProperSep C E)
  \in properUPred_ent_trans S0 S1 S9
      (sep_assoc_l_ent A (mkProperSep B (mkProperSep C D))
        (mkProperSep E F))
      (properUPred_ent_trans S1 S2 S9
        (sep_mono_r_ent A
          (mkProperSep (mkProperSep B (mkProperSep C D)) (mkProperSep E F))
          (mkProperSep B
            (mkProperSep (mkProperSep C D) (mkProperSep E F)))
          (sep_assoc_l_ent B (mkProperSep C D) (mkProperSep E F)))
        (properUPred_ent_trans S2 S3 S9
          (sep_mono_r_ent A
            (mkProperSep B
              (mkProperSep (mkProperSep C D) (mkProperSep E F)))
            (mkProperSep B
              (mkProperSep C (mkProperSep D (mkProperSep E F))))
            (sep_mono_r_ent B
              (mkProperSep (mkProperSep C D) (mkProperSep E F))
              (mkProperSep C (mkProperSep D (mkProperSep E F)))
              (sep_assoc_l_ent C D (mkProperSep E F))))
          (properUPred_ent_trans S3 S4 S9
            (sep_mono_r_ent A
              (mkProperSep B
                (mkProperSep C (mkProperSep D (mkProperSep E F))))
              (mkProperSep B
                (mkProperSep D (mkProperSep C (mkProperSep E F))))
              (sep_mono_r_ent B
                (mkProperSep C (mkProperSep D (mkProperSep E F)))
                (mkProperSep D (mkProperSep C (mkProperSep E F)))
                (sep_swap_ent C D (mkProperSep E F))))
            (properUPred_ent_trans S4 S5 S9
              (sep_mono_r_ent A
                (mkProperSep B
                  (mkProperSep D (mkProperSep C (mkProperSep E F))))
                (mkProperSep B
                  (mkProperSep D (mkProperSep C (mkProperSep F E))))
                (sep_mono_r_ent B
                  (mkProperSep D (mkProperSep C (mkProperSep E F)))
                  (mkProperSep D (mkProperSep C (mkProperSep F E)))
                  (sep_mono_r_ent D
                    (mkProperSep C (mkProperSep E F))
                    (mkProperSep C (mkProperSep F E))
                    (sep_mono_r_ent C (mkProperSep E F)
                      (mkProperSep F E) (sep_comm_ent E F)))))
              (properUPred_ent_trans S5 S6 S9
                (sep_mono_r_ent A
                  (mkProperSep B
                    (mkProperSep D (mkProperSep C (mkProperSep F E))))
                  (mkProperSep B
                    (mkProperSep D (mkProperSep F (mkProperSep C E))))
                  (sep_mono_r_ent B
                    (mkProperSep D (mkProperSep C (mkProperSep F E)))
                    (mkProperSep D (mkProperSep F (mkProperSep C E)))
                    (sep_mono_r_ent D
                      (mkProperSep C (mkProperSep F E))
                      (mkProperSep F (mkProperSep C E))
                      (sep_swap_ent C F E))))
                (properUPred_ent_trans S6 S7 S9
                  (sep_mono_r_ent A
                    (mkProperSep B
                      (mkProperSep D (mkProperSep F (mkProperSep C E))))
                    (mkProperSep B
                      (mkProperSep (mkProperSep D F) (mkProperSep C E)))
                    (sep_mono_r_ent B
                      (mkProperSep D (mkProperSep F (mkProperSep C E)))
                      (mkProperSep (mkProperSep D F) (mkProperSep C E))
                      (sep_assoc_r_ent D F (mkProperSep C E))))
                  (properUPred_ent_trans S7 S8 S9
                    (sep_mono_r_ent A
                      (mkProperSep B
                        (mkProperSep (mkProperSep D F) (mkProperSep C E)))
                      (mkProperSep (mkProperSep B (mkProperSep D F))
                        (mkProperSep C E))
                      (sep_assoc_r_ent B (mkProperSep D F)
                        (mkProperSep C E)))
                    (sep_assoc_r_ent A (mkProperSep B (mkProperSep D F))
                      (mkProperSep C E)))))))))

\lemma msc_parallel_then_read {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (gam : msc_name)
    (gamM gamD : gname) (base : Nat) (c h1 h2 returned : Value) :
  \let
    | Q : Nat -> iProp S => msc_client_read_Q G gam base
    | Handles => mkProperSep (msc_handle G gam h1) (msc_handle G gam h2)
  \in properUPred_ent
      (par_pair_post
        (msc_client1_twice_post H G gam gamM gamD base c h1)
        (msc_client2_twice_post H G gam gamM gamD base c h2) returned)
      (wp H mscE (App (Val msc_read) (Val c))
        (wp_frame_post (msc_read_post H G gam c Q) Handles)) =>
  \let
    | Public => msc_client_public H G gam gamM gamD base
    | C => msc_is_counter H G gam c
    | H1 => msc_handle G gam h1
    | H2 => msc_handle G gam h2
    | E1 => ghost_map_elem (msc_clientGS G gamM) 1 (2, gamD)
    | E2 => ghost_map_elem (msc_clientGS G gamM) 2 (2, gamD)
    | P => mkProperSep E1 E2
    | Q : Nat -> iProp S => msc_client_read_Q G gam base
    | Handles => mkProperSep H1 H2
    | R1 => mkProperSep Public (mkProperSep C (mkProperSep H1 E1))
    | R2 => mkProperSep Public (mkProperSep C (mkProperSep H2 E2))
    | Selected2 => mkProperSep H2 E2
    | Selected => mkProperSep R1 Selected2
    | Prepared => mkProperSep
        (mkProperSep Public (mkProperSep C P)) Handles
    | Shifted => mkProperSep
        (mkProperSep (msc_read_shift H G gam P Q)
          (mkProperSep C P)) Handles
    | select : properUPred_ent (mkProperSep R1 R2) Selected =>
        sep_mono_r_ent R1 R2 Selected2
          (properUPred_ent_trans R2 (mkProperSep C (mkProperSep H2 E2))
            Selected2 (sep_elim_r_ent Public
              (mkProperSep C (mkProperSep H2 E2)))
            (sep_elim_r_ent C (mkProperSep H2 E2)))
    | prepare : properUPred_ent Selected Prepared =>
        sep_prepare_read6 Public C H1 E1 H2 E2
    | shift : properUPred_ent Prepared Shifted =>
        sep_mono_l_ent (mkProperSep Public (mkProperSep C P))
          (mkProperSep (msc_read_shift H G gam P Q)
            (mkProperSep C P)) Handles
          (sep_mono_l_ent Public
            (msc_read_shift H G gam P Q)
            (mkProperSep C P)
            (msc_client_read_shift H G gam gamM gamD base))
    | readCore : properUPred_ent
        (mkProperSep (msc_read_shift H G gam P Q)
          (mkProperSep C P))
        (wp H mscE (App (Val msc_read) (Val c))
          (msc_read_post H G gam c Q)) =>
        msc_read_spec H G gam c P Q
    | framed : properUPred_ent Shifted
        (wp H mscE (App (Val msc_read) (Val c))
          (wp_frame_post (msc_read_post H G gam c Q) Handles)) =>
        properUPred_ent_trans Shifted
          (mkProperSep
            (wp H mscE (App (Val msc_read) (Val c))
              (msc_read_post H G gam c Q)) Handles)
          (wp H mscE (App (Val msc_read) (Val c))
            (wp_frame_post (msc_read_post H G gam c Q) Handles))
          (sep_mono_l_ent
            (mkProperSep (msc_read_shift H G gam P Q)
              (mkProperSep C P))
            (wp H mscE (App (Val msc_read) (Val c))
              (msc_read_post H G gam c Q)) Handles readCore)
          (wp_frame_r H mscE (App (Val msc_read) (Val c))
            (msc_read_post H G gam c Q) Handles)
  \in properUPred_ent_trans
      (par_pair_post
        (msc_client1_twice_post H G gam gamM gamD base c h1)
        (msc_client2_twice_post H G gam gamM gamD base c h2) returned)
      (mkProperSep R1 R2)
      (wp H mscE (App (Val msc_read) (Val c))
        (wp_frame_post (msc_read_post H G gam c Q) Handles))
      (msc_parallel_post_resources H G gam gamM gamD base c h1 h2 returned)
      (properUPred_ent_trans (mkProperSep R1 R2) Selected
        (wp H mscE (App (Val msc_read) (Val c))
          (wp_frame_post (msc_read_post H G gam c Q) Handles)) select
        (properUPred_ent_trans Selected Prepared
          (wp H mscE (App (Val msc_read) (Val c))
            (wp_frame_post (msc_read_post H G gam c Q) Handles)) prepare
          (properUPred_ent_trans Prepared Shifted
            (wp H mscE (App (Val msc_read) (Val c))
              (wp_frame_post (msc_read_post H G gam c Q) Handles))
            shift framed)))

\lemma msc_two_incr_twice_read_body_spec {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (SG : spawnG S)
    (FPI : ForkPostInhabited H) (gam : msc_name)
    (gamM gamD : gname) (base : Nat) (c h1 h2 : Value) :
  \let
    | Public => msc_client_public H G gam gamM gamD base
    | C => msc_is_counter H G gam c
    | H1 => msc_handle G gam h1
    | H2 => msc_handle G gam h2
    | E1 => ghost_map_elem (msc_clientGS G gamM) 1 (0, gamD)
    | E2 => ghost_map_elem (msc_clientGS G gamM) 2 (0, gamD)
    | Pre1 => mkProperSep Public (mkProperSep C (mkProperSep H1 E1))
    | Pre2 => mkProperSep Public (mkProperSep C (mkProperSep H2 E2))
    | F1 => LamV nIgnore
        (app2 (Val msc_incr_twice) (Val c) (Val h1))
    | F2 => LamV nIgnore
        (app2 (Val msc_incr_twice) (Val c) (Val h2))
    | ParE => app2 (Val par) (Val F1) (Val F2)
    | ReadE => App (Val msc_read) (Val c)
    | Q : Nat -> iProp S => msc_client_read_Q G gam base
    | Handles => mkProperSep H1 H2
    | Post => wp_frame_post (msc_read_post H G gam c Q) Handles
  \in properUPred_ent (mkProperSep Pre1 Pre2)
      (wp H mscE (seqE ParE ReadE) Post) =>
  \let
    | Public => msc_client_public H G gam gamM gamD base
    | C => msc_is_counter H G gam c
    | H1 => msc_handle G gam h1
    | H2 => msc_handle G gam h2
    | E1 => ghost_map_elem (msc_clientGS G gamM) 1 (0, gamD)
    | E2 => ghost_map_elem (msc_clientGS G gamM) 2 (0, gamD)
    | Pre1 => mkProperSep Public (mkProperSep C (mkProperSep H1 E1))
    | Pre2 => mkProperSep Public (mkProperSep C (mkProperSep H2 E2))
    | Pre => mkProperSep Pre1 Pre2
    | F1 => LamV nIgnore
        (app2 (Val msc_incr_twice) (Val c) (Val h1))
    | F2 => LamV nIgnore
        (app2 (Val msc_incr_twice) (Val c) (Val h2))
    | ParE => app2 (Val par) (Val F1) (Val F2)
    | ReadE => App (Val msc_read) (Val c)
    | PairPost => par_pair_post
        (msc_client1_twice_post H G gam gamM gamD base c h1)
        (msc_client2_twice_post H G gam gamM gamD base c h2)
    | Q : Nat -> iProp S => msc_client_read_Q G gam base
    | Handles => mkProperSep H1 H2
    | Post => wp_frame_post (msc_read_post H G gam c Q) Handles
    | parallel : properUPred_ent Pre (wp H mscE ParE PairPost) =>
        msc_parallel_increments_spec H G SG FPI gam gamM gamD
          base c h1 h2
    | continue : \Pi (returned : Value) -> properUPred_ent
        (PairPost returned) (wp H mscE ReadE Post) => \lam returned =>
        msc_parallel_then_read H G gam gamM gamD base c h1 h2 returned
    | chained : properUPred_ent Pre
        (wp H mscE ParE (\lam returned => wp H mscE ReadE Post)) =>
        properUPred_ent_trans Pre (wp H mscE ParE PairPost)
          (wp H mscE ParE (\lam returned => wp H mscE ReadE Post))
          parallel
          (wp_mono H mscE ParE PairPost
            (\lam returned => wp H mscE ReadE Post) continue)
  \in properUPred_ent_trans Pre
      (wp H mscE ParE (\lam returned => wp H mscE ReadE Post))
      (wp H mscE (seqE ParE ReadE) Post) chained
      (wp_letE H mscE nIgnore ParE ReadE Post)

-- Lambda literals that mention an enclosing binder must remain expressions
-- until that binder has been substituted.  This wrapper evaluates the two
-- resulting closed lambda expressions before invoking the value-level `par`
-- rule above.
\lemma par_lam_spec {S : gFunctors}
    (H : irisGS natCountable S) (SG : spawnG S)
    (FPI : ForkPostInhabited H)
    (Psi1 Psi2 : Value -> iProp S)
    (x1 x2 : Name) (body1 body2 : Expr) :
  \let
    | f1 => LamV x1 body1
    | f2 => LamV x2 body2
    | Pre => mkProperSep
        (wp H mscE (App (Val f1) (Val unitV)) Psi1)
        (wp H mscE (App (Val f2) (Val unitV)) Psi2)
  \in properUPred_ent Pre
      (wp H mscE
        (app2 (Val par) (Lam x1 body1) (Lam x2 body2))
        (par_pair_post Psi1 Psi2)) =>
  \let
    | f1 => LamV x1 body1
    | f2 => LamV x2 body2
    | Pre => mkProperSep
        (wp H mscE (App (Val f1) (Val unitV)) Psi1)
        (wp H mscE (App (Val f2) (Val unitV)) Psi2)
    | Post => par_pair_post Psi1 Psi2
    | LeftV => App (Val par) (Val f1)
    | LeftE => App (Val par) (Lam x1 body1)
    | PhiV : Value -> iProp S => \lam vf =>
        wp H mscE (App (Val vf) (Val f2)) Post
    | PhiE : Value -> iProp S => \lam vf =>
        wp H mscE (App (Val vf) (Lam x2 body2)) Post
    | Arg2Post : Value -> Value -> iProp S => \lam vf v =>
        wp H mscE (App (Val vf) (Val v)) Post
    | valueCore : properUPred_ent Pre (wp H mscE LeftV PhiV) =>
        \let
          | BodyGeneric => letE nHandle (App (Val spawn) (Var nLeft))
              (letE nY (App (Var nRight) (Val unitV))
                (letE nX (App (Val join) (Var nHandle))
                  (Pair (Var nX) (Var nY))))
          | BodyLeft => letE nHandle (App (Val spawn) (Val f1))
              (letE nY (App (Var nRight) (Val unitV))
                (letE nX (App (Val join) (Var nHandle))
                  (Pair (Var nX) (Var nY))))
          | BodyAt => letE nHandle (App (Val spawn) (Val f1))
              (letE nY (App (Val f2) (Val unitV))
                (letE nX (App (Val join) (Var nHandle))
                  (Pair (Var nX) (Var nY))))
          | InnerLam => LamV nRight BodyLeft
          | body : properUPred_ent Pre (wp H mscE BodyAt Post) =>
              par_body_spec H SG FPI Psi1 Psi2 f1 f2
          | innerApp : properUPred_ent Pre (PhiV InnerLam) =>
              properUPred_ent_trans Pre (wp H mscE BodyAt Post)
                (PhiV InnerLam) body
                (wp_lam_beta H mscE nRight BodyLeft f2 Post)
          | innerValue : properUPred_ent Pre
              (wp H mscE (Val InnerLam) PhiV) =>
              properUPred_ent_trans Pre (PhiV InnerLam)
                (wp H mscE (Val InnerLam) PhiV) innerApp
                (wp_value_intro H mscE InnerLam PhiV)
          | innerExpr : properUPred_ent Pre
              (wp H mscE (Lam nRight BodyLeft) PhiV) =>
              properUPred_ent_trans Pre
                (wp H mscE (Val InnerLam) PhiV)
                (wp H mscE (Lam nRight BodyLeft) PhiV) innerValue
                (wp_lam_expr H mscE nRight BodyLeft PhiV)
        \in properUPred_ent_trans Pre
            (wp H mscE (Lam nRight BodyLeft) PhiV)
            (wp H mscE LeftV PhiV) innerExpr
            (wp_lam_beta H mscE nLeft
              (Lam nRight BodyGeneric) f1 PhiV)
    | exposeArg2 : \Pi (vf : Value) -> properUPred_ent
        (PhiV vf) (PhiE vf) => \lam vf =>
        properUPred_ent_trans (PhiV vf)
          (wp H mscE (Val f2) (Arg2Post vf)) (PhiE vf)
          (wp_value_intro H mscE f2 (Arg2Post vf))
          (properUPred_ent_trans
            (wp H mscE (Val f2) (Arg2Post vf))
            (wp H mscE (Lam x2 body2) (Arg2Post vf)) (PhiE vf)
            (wp_lam_expr H mscE x2 body2 (Arg2Post vf))
            (wp_bind_app_r H mscE vf (Lam x2 body2) Post))
    | leftValue : properUPred_ent Pre (wp H mscE LeftV PhiE) =>
        properUPred_ent_trans Pre (wp H mscE LeftV PhiV)
          (wp H mscE LeftV PhiE) valueCore
          (wp_mono H mscE LeftV PhiV PhiE exposeArg2)
    | Arg1Post : Value -> iProp S => \lam v =>
        wp H mscE (App (Val par) (Val v)) PhiE
    | firstValue : properUPred_ent Pre
        (wp H mscE (Val f1) Arg1Post) =>
        properUPred_ent_trans Pre (Arg1Post f1)
          (wp H mscE (Val f1) Arg1Post) leftValue
          (wp_value_intro H mscE f1 Arg1Post)
    | firstExpr : properUPred_ent Pre
        (wp H mscE (Lam x1 body1) Arg1Post) =>
        properUPred_ent_trans Pre (wp H mscE (Val f1) Arg1Post)
          (wp H mscE (Lam x1 body1) Arg1Post) firstValue
          (wp_lam_expr H mscE x1 body1 Arg1Post)
    | leftExpr : properUPred_ent Pre (wp H mscE LeftE PhiE) =>
        properUPred_ent_trans Pre
          (wp H mscE (Lam x1 body1) Arg1Post)
          (wp H mscE LeftE PhiE) firstExpr
          (wp_bind_app_r H mscE par (Lam x1 body1) PhiE)
  \in properUPred_ent_trans Pre (wp H mscE LeftE PhiE)
      (wp H mscE (App LeftE (Lam x2 body2)) Post) leftExpr
      (wp_bind_app_l H mscE LeftE (Lam x2 body2) Post)

\lemma msc_two_incr_twice_read_source_body_spec {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (SG : spawnG S)
    (FPI : ForkPostInhabited H) (gam : msc_name)
    (gamM gamD : gname) (base : Nat) (c h1 h2 : Value) :
  \let
    | Public => msc_client_public H G gam gamM gamD base
    | C => msc_is_counter H G gam c
    | H1 => msc_handle G gam h1
    | H2 => msc_handle G gam h2
    | E1 => ghost_map_elem (msc_clientGS G gamM) 1 (0, gamD)
    | E2 => ghost_map_elem (msc_clientGS G gamM) 2 (0, gamD)
    | Pre1 => mkProperSep Public (mkProperSep C (mkProperSep H1 E1))
    | Pre2 => mkProperSep Public (mkProperSep C (mkProperSep H2 E2))
    | B1 => app2 (Val msc_incr_twice) (Val c) (Val h1)
    | B2 => app2 (Val msc_incr_twice) (Val c) (Val h2)
    | ParE => app2 (Val par) (Lam nIgnore B1) (Lam nIgnore B2)
    | ReadE => App (Val msc_read) (Val c)
    | Q : Nat -> iProp S => msc_client_read_Q G gam base
    | Handles => mkProperSep H1 H2
    | Post => wp_frame_post (msc_read_post H G gam c Q) Handles
  \in properUPred_ent (mkProperSep Pre1 Pre2)
      (wp H mscE (seqE ParE ReadE) Post) =>
  \let
    | Public => msc_client_public H G gam gamM gamD base
    | C => msc_is_counter H G gam c
    | H1 => msc_handle G gam h1
    | H2 => msc_handle G gam h2
    | E1 => ghost_map_elem (msc_clientGS G gamM) 1 (0, gamD)
    | E2 => ghost_map_elem (msc_clientGS G gamM) 2 (0, gamD)
    | Pre1 => mkProperSep Public (mkProperSep C (mkProperSep H1 E1))
    | Pre2 => mkProperSep Public (mkProperSep C (mkProperSep H2 E2))
    | Pre => mkProperSep Pre1 Pre2
    | B1 => app2 (Val msc_incr_twice) (Val c) (Val h1)
    | B2 => app2 (Val msc_incr_twice) (Val c) (Val h2)
    | V1 => LamV nIgnore B1
    | V2 => LamV nIgnore B2
    | ParE => app2 (Val par) (Lam nIgnore B1) (Lam nIgnore B2)
    | ReadE => App (Val msc_read) (Val c)
    | PairPost => par_pair_post
        (msc_client1_twice_post H G gam gamM gamD base c h1)
        (msc_client2_twice_post H G gam gamM gamD base c h2)
    | Q : Nat -> iProp S => msc_client_read_Q G gam base
    | Handles => mkProperSep H1 H2
    | Post => wp_frame_post (msc_read_post H G gam c Q) Handles
    | PreWP => mkProperSep
        (wp H mscE (App (Val V1) (Val unitV))
          (msc_client1_twice_post H G gam gamM gamD base c h1))
        (wp H mscE (App (Val V2) (Val unitV))
          (msc_client2_twice_post H G gam gamM gamD base c h2))
    | thunks : properUPred_ent Pre PreWP =>
        properUPred_ent_trans Pre
          (mkProperSep
            (wp H mscE (App (Val V1) (Val unitV))
              (msc_client1_twice_post H G gam gamM gamD base c h1)) Pre2)
          PreWP
          (sep_mono_l_ent Pre1
            (wp H mscE (App (Val V1) (Val unitV))
              (msc_client1_twice_post H G gam gamM gamD base c h1))
            Pre2 (msc_client1_thunk_spec H G gam gamM gamD base c h1))
          (sep_mono_r_ent
            (wp H mscE (App (Val V1) (Val unitV))
              (msc_client1_twice_post H G gam gamM gamD base c h1))
            Pre2
            (wp H mscE (App (Val V2) (Val unitV))
              (msc_client2_twice_post H G gam gamM gamD base c h2))
            (msc_client2_thunk_spec H G gam gamM gamD base c h2))
    | parallel : properUPred_ent Pre (wp H mscE ParE PairPost) =>
        properUPred_ent_trans Pre PreWP (wp H mscE ParE PairPost)
          thunks
          (par_lam_spec H SG FPI
            (msc_client1_twice_post H G gam gamM gamD base c h1)
            (msc_client2_twice_post H G gam gamM gamD base c h2)
            nIgnore nIgnore B1 B2)
    | continue : \Pi (returned : Value) -> properUPred_ent
        (PairPost returned) (wp H mscE ReadE Post) => \lam returned =>
        msc_parallel_then_read H G gam gamM gamD base c h1 h2 returned
    | chained : properUPred_ent Pre
        (wp H mscE ParE (\lam returned => wp H mscE ReadE Post)) =>
        properUPred_ent_trans Pre (wp H mscE ParE PairPost)
          (wp H mscE ParE (\lam returned => wp H mscE ReadE Post))
          parallel
          (wp_mono H mscE ParE PairPost
            (\lam returned => wp H mscE ReadE Post) continue)
  \in properUPred_ent_trans Pre
      (wp H mscE ParE (\lam returned => wp H mscE ReadE Post))
      (wp H mscE (seqE ParE ReadE) Post) chained
      (wp_letE H mscE nIgnore ParE ReadE Post)

\lemma msc_nC_ne_nH1 : Not (nC = nH1) =>
  \lam p => \case p \with {}

\lemma msc_nC_ne_nH2 : Not (nC = nH2) =>
  \lam p => \case p \with {}

\lemma msc_nC_ne_nIgnore : Not (nC = nIgnore) =>
  \lam p => \case p \with {}

\lemma msc_nH1_ne_nH2 : Not (nH1 = nH2) =>
  \lam p => \case p \with {}

\lemma msc_nH1_ne_nIgnore : Not (nH1 = nIgnore) =>
  \lam p => \case p \with {}

\lemma msc_nH2_ne_nIgnore : Not (nH2 = nIgnore) =>
  \lam p => \case p \with {}

\func msc_client_program_body : Expr => seqE
  (app2 (Val par)
    (Lam nIgnore
      (app2 (Val msc_incr_twice) (Var nC) (Var nH1)))
    (Lam nIgnore
      (app2 (Val msc_incr_twice) (Var nC) (Var nH2))))
  (App (Val msc_read) (Var nC))

\func msc_client_program_body_c (c : Value) : Expr => seqE
  (app2 (Val par)
    (Lam nIgnore
      (app2 (Val msc_incr_twice) (Val c) (Var nH1)))
    (Lam nIgnore
      (app2 (Val msc_incr_twice) (Val c) (Var nH2))))
  (App (Val msc_read) (Val c))

\func msc_client_program_body_ch1 (c h1 : Value) : Expr => seqE
  (app2 (Val par)
    (Lam nIgnore
      (app2 (Val msc_incr_twice) (Val c) (Val h1)))
    (Lam nIgnore
      (app2 (Val msc_incr_twice) (Val c) (Var nH2))))
  (App (Val msc_read) (Val c))

\func msc_client_program_body_at (c h1 h2 : Value) : Expr => seqE
  (app2 (Val par)
    (Lam nIgnore
      (app2 (Val msc_incr_twice) (Val c) (Val h1)))
    (Lam nIgnore
      (app2 (Val msc_incr_twice) (Val c) (Val h2))))
  (App (Val msc_read) (Val c))

\lemma msc_client_program_subst_h2 (c h1 h2 : Value) :
  subst nH2 h2 (msc_client_program_body_ch1 c h1) =
    msc_client_program_body_at c h1 h2 =>
  \case nameDecEq nH2 nIgnore \as d, idp :
      nameDecEq nH2 nIgnore = d
      \return subst nH2 h2 (msc_client_program_body_ch1 c h1) =
        msc_client_program_body_at c h1 h2
  \with {
    | inl eq, _ => absurd (msc_nH2_ne_nIgnore eq)
    | inr _, hni =>
      \case nameDecEq nH2 nH2 \as ds, idp : nameDecEq nH2 nH2 = ds
      \return subst nH2 h2 (msc_client_program_body_ch1 c h1) =
        msc_client_program_body_at c h1 h2
      \with {
        | inl _, hs => idp
        | inr neq, _ => absurd (neq idp)
      }
  }

\lemma msc_client_program_subst_h1 (c h1 : Value) :
  subst nH1 h1 (Lam nH2 (msc_client_program_body_c c)) =
    Lam nH2 (msc_client_program_body_ch1 c h1) =>
  \case nameDecEq nH1 nH2 \as d12, idp : nameDecEq nH1 nH2 = d12
  \return subst nH1 h1 (Lam nH2 (msc_client_program_body_c c)) =
    Lam nH2 (msc_client_program_body_ch1 c h1)
  \with {
    | inl eq, _ => absurd (msc_nH1_ne_nH2 eq)
    | inr _, h12 =>
      \case nameDecEq nH1 nIgnore \as di, idp :
          nameDecEq nH1 nIgnore = di
      \return subst nH1 h1 (Lam nH2 (msc_client_program_body_c c)) =
        Lam nH2 (msc_client_program_body_ch1 c h1)
      \with {
        | inl eq, _ => absurd (msc_nH1_ne_nIgnore eq)
        | inr _, hi =>
          \case nameDecEq nH1 nH1 \as ds, idp :
              nameDecEq nH1 nH1 = ds
          \return subst nH1 h1
              (Lam nH2 (msc_client_program_body_c c)) =
            Lam nH2 (msc_client_program_body_ch1 c h1)
          \with {
            | inl _, hs => idp
            | inr neq, _ => absurd (neq idp)
          }
      }
  }

\lemma msc_client_program_subst_c (c : Value) :
  subst nC c (Lam nH1 (Lam nH2 msc_client_program_body)) =
    Lam nH1 (Lam nH2 (msc_client_program_body_c c)) =>
  \case nameDecEq nC nH1 \as d1, idp : nameDecEq nC nH1 = d1
  \return subst nC c (Lam nH1 (Lam nH2 msc_client_program_body)) =
    Lam nH1 (Lam nH2 (msc_client_program_body_c c))
  \with {
    | inl eq, _ => absurd (msc_nC_ne_nH1 eq)
    | inr _, h1 =>
      \case nameDecEq nC nH2 \as d2, idp : nameDecEq nC nH2 = d2
      \return subst nC c (Lam nH1 (Lam nH2 msc_client_program_body)) =
        Lam nH1 (Lam nH2 (msc_client_program_body_c c))
      \with {
        | inl eq, _ => absurd (msc_nC_ne_nH2 eq)
        | inr _, h2 =>
          \case nameDecEq nC nIgnore \as di, idp :
              nameDecEq nC nIgnore = di
          \return subst nC c
              (Lam nH1 (Lam nH2 msc_client_program_body)) =
            Lam nH1 (Lam nH2 (msc_client_program_body_c c))
          \with {
            | inl eq, _ => absurd (msc_nC_ne_nIgnore eq)
            | inr _, hi =>
              \case nameDecEq nC nC \as ds, idp : nameDecEq nC nC = ds
              \return subst nC c
                  (Lam nH1 (Lam nH2 msc_client_program_body)) =
                Lam nH1 (Lam nH2 (msc_client_program_body_c c))
              \with {
                | inl _, hs => idp
                | inr neq, _ => absurd (neq idp)
              }
          }
      }
  }

\lemma msc_two_incr_twice_read_spec {S : gFunctors}
    (H : irisGS natCountable S) (G : mscG S) (SG : spawnG S)
    (FPI : ForkPostInhabited H) (gam : msc_name)
    (gamM gamD : gname) (base : Nat) (c h1 h2 : Value) :
  \let
    | Public => msc_client_public H G gam gamM gamD base
    | C => msc_is_counter H G gam c
    | H1 => msc_handle G gam h1
    | H2 => msc_handle G gam h2
    | E1 => ghost_map_elem (msc_clientGS G gamM) 1 (0, gamD)
    | E2 => ghost_map_elem (msc_clientGS G gamM) 2 (0, gamD)
    | Pre1 => mkProperSep Public (mkProperSep C (mkProperSep H1 E1))
    | Pre2 => mkProperSep Public (mkProperSep C (mkProperSep H2 E2))
    | Q : Nat -> iProp S => msc_client_read_Q G gam base
    | Handles => mkProperSep H1 H2
    | Post => wp_frame_post (msc_read_post H G gam c Q) Handles
  \in properUPred_ent (mkProperSep Pre1 Pre2)
      (wp H mscE
        (app3 (Val msc_two_incr_twice_read)
          (Val c) (Val h1) (Val h2)) Post) =>
  \let
    | Public => msc_client_public H G gam gamM gamD base
    | C => msc_is_counter H G gam c
    | H1 => msc_handle G gam h1
    | H2 => msc_handle G gam h2
    | E1 => ghost_map_elem (msc_clientGS G gamM) 1 (0, gamD)
    | E2 => ghost_map_elem (msc_clientGS G gamM) 2 (0, gamD)
    | Pre1 => mkProperSep Public (mkProperSep C (mkProperSep H1 E1))
    | Pre2 => mkProperSep Public (mkProperSep C (mkProperSep H2 E2))
    | Pre => mkProperSep Pre1 Pre2
    | Q : Nat -> iProp S => msc_client_read_Q G gam base
    | Handles => mkProperSep H1 H2
    | Post => wp_frame_post (msc_read_post H G gam c Q) Handles
    | BodyGeneric => msc_client_program_body
    | BodyC => msc_client_program_body_c c
    | BodyCH1 => msc_client_program_body_ch1 c h1
    | BodyAt => msc_client_program_body_at c h1 h2
    | LastLam => LamV nH2 BodyCH1
    | MiddleLam => LamV nH1 (Lam nH2 BodyC)
    | OuterApp => App (Val msc_two_incr_twice_read) (Val c)
    | MiddleApp => App OuterApp (Val h1)
    | PhiLast : Value -> iProp S => \lam vf =>
        wp H mscE (App (Val vf) (Val h2)) Post
    | PhiMiddle : Value -> iProp S => \lam vf =>
        wp H mscE (App (Val vf) (Val h1)) PhiLast
    | body : properUPred_ent Pre (wp H mscE BodyAt Post) =>
        msc_two_incr_twice_read_source_body_spec H G SG FPI gam gamM gamD
          base c h1 h2
    | lastSub : properUPred_ent Pre
        (wp H mscE (subst nH2 h2 BodyCH1) Post) =>
        transport (\lam z => properUPred_ent Pre (wp H mscE z Post))
          (inv (msc_client_program_subst_h2 c h1 h2)) body
    | lastApp : properUPred_ent Pre (PhiLast LastLam) =>
        properUPred_ent_trans Pre
          (wp H mscE (subst nH2 h2 BodyCH1) Post)
          (PhiLast LastLam) lastSub
          (wp_lam_beta H mscE nH2 BodyCH1 h2 Post)
    | lastValue : properUPred_ent Pre
        (wp H mscE (Val LastLam) PhiLast) =>
        properUPred_ent_trans Pre (PhiLast LastLam)
          (wp H mscE (Val LastLam) PhiLast) lastApp
          (wp_value_intro H mscE LastLam PhiLast)
    | lastExpr : properUPred_ent Pre
        (wp H mscE (Lam nH2 BodyCH1) PhiLast) =>
        properUPred_ent_trans Pre (wp H mscE (Val LastLam) PhiLast)
          (wp H mscE (Lam nH2 BodyCH1) PhiLast) lastValue
          (wp_lam_expr H mscE nH2 BodyCH1 PhiLast)
    | middleSub : properUPred_ent Pre
        (wp H mscE (subst nH1 h1 (Lam nH2 BodyC)) PhiLast) =>
        transport (\lam z => properUPred_ent Pre (wp H mscE z PhiLast))
          (inv (msc_client_program_subst_h1 c h1)) lastExpr
    | middleBeta : properUPred_ent Pre
        (wp H mscE (App (Val MiddleLam) (Val h1)) PhiLast) =>
        properUPred_ent_trans Pre
          (wp H mscE (subst nH1 h1 (Lam nH2 BodyC)) PhiLast)
          (wp H mscE (App (Val MiddleLam) (Val h1)) PhiLast) middleSub
          (wp_lam_beta H mscE nH1 (Lam nH2 BodyC) h1 PhiLast)
    | middleValue : properUPred_ent Pre
        (wp H mscE (Val MiddleLam) PhiMiddle) =>
        properUPred_ent_trans Pre (PhiMiddle MiddleLam)
          (wp H mscE (Val MiddleLam) PhiMiddle) middleBeta
          (wp_value_intro H mscE MiddleLam PhiMiddle)
    | middleExpr : properUPred_ent Pre
        (wp H mscE (Lam nH1 (Lam nH2 BodyC)) PhiMiddle) =>
        properUPred_ent_trans Pre (wp H mscE (Val MiddleLam) PhiMiddle)
          (wp H mscE (Lam nH1 (Lam nH2 BodyC)) PhiMiddle) middleValue
          (wp_lam_expr H mscE nH1 (Lam nH2 BodyC) PhiMiddle)
    | outerSub : properUPred_ent Pre
        (wp H mscE
          (subst nC c (Lam nH1 (Lam nH2 BodyGeneric))) PhiMiddle) =>
        transport (\lam z => properUPred_ent Pre (wp H mscE z PhiMiddle))
          (inv (msc_client_program_subst_c c)) middleExpr
    | outerBeta : properUPred_ent Pre (wp H mscE OuterApp PhiMiddle) =>
        properUPred_ent_trans Pre
          (wp H mscE
            (subst nC c (Lam nH1 (Lam nH2 BodyGeneric))) PhiMiddle)
          (wp H mscE OuterApp PhiMiddle) outerSub
          (wp_lam_beta H mscE nC
            (Lam nH1 (Lam nH2 BodyGeneric)) c PhiMiddle)
    | bindMiddle : properUPred_ent Pre (wp H mscE MiddleApp PhiLast) =>
        properUPred_ent_trans Pre (wp H mscE OuterApp PhiMiddle)
          (wp H mscE MiddleApp PhiLast) outerBeta
          (wp_bind_app_l H mscE OuterApp (Val h1) PhiLast)
  \in properUPred_ent_trans Pre (wp H mscE MiddleApp PhiLast)
      (wp H mscE (App MiddleApp (Val h2)) Post) bindMiddle
      (wp_bind_app_l H mscE MiddleApp (Val h2) Post)
