\import Arith.Nat
\import Logic
\import Function.Iterate
\import Order.PartialOrder
\import Order.LinearOrder
\import Paths
\import Set
\import Data.Or
\import Data.Maybe
\import Logic.Meta


-- =================================================================================
-- OFE
-- =================================================================================


-- Ordered Famaly of Equivalance extends the Basic set with the notion of a dist
\class OFE \extends BaseSet {
  | dist : Nat -> E -> E -> \Prop

  | equiv : E -> E -> \Prop
  | equiv_refl (x : E) : equiv x x
  | equiv_sym (x y : E) : equiv x y -> equiv y x
  | equiv_trans (x y z : E) : equiv x y -> equiv y z -> equiv x z

  | ofe_equiv_dist (x y : E) : equiv x y <-> (\Pi (n : Nat) -> dist n x y)

  | ofe_dist_refl (n : Nat) (x : E) : dist n x x
  | ofe_dist_sym (n : Nat) (x y : E) : dist n x y -> dist n y x
  | ofe_dist_trans (n : Nat) (x y z : E) : dist n x y -> dist n y z -> dist n x z

  | ofe_dist_le (n m : Nat) (x y : E) : dist n x y -> m <= n -> dist m x y
}


\class LeibnizOFE \extends OFE
  | equiv => \lam x y => x = y
  | equiv_refl _ => idp
  | equiv_sym _ _ => inv
  | equiv_trans _ _ _ => *>

\record DistLater {A : OFE} (n : Nat) (x y : A.E)
  | dist_later_lt : \Pi (m : Nat) -> m NatOrder.< n -> A.dist m x y

\func NonExpansive {A B : OFE} (f : A.E -> B.E) : \Prop =>
  \Pi (n : Nat) (x y : A.E) -> A.dist n x y -> B.dist n (f x) (f y)

\func NonExpansive2 {A B C : OFE} (f : A.E -> B.E -> C.E) : \Prop =>
  \Pi (n : Nat) (x y : A.E) (x' y' : B.E) ->
    A.dist n x y -> B.dist n x' y' -> C.dist n (f x x') (f y y')

\func ContractiveMap {A B : OFE} (f : A.E -> B.E) : \Prop =>
  \Pi (n : Nat) (x y : A.E) -> DistLater {A} n x y -> B.dist n (f x) (f y)


\func Discrete {O : OFE} (x : O.E) : \Prop =>
  \Pi (y : O.E) -> O.dist 0 x y -> x = y

\func OFEDiscrete (O : OFE) : \Prop =>
  \Pi (x : O.E) -> Discrete x

\record Chain {O : OFE} (c : Nat -> O.E)
  | chain_cauchy (n m : Nat) : n <= m -> O.dist n (c m) (c n)


-- =================================================================================
-- COFE
-- =================================================================================


\class COFE \extends OFE {
  | compl : \Pi (c : Nat -> E) -> Chain c -> E
  | cofe_conv_compl (c : Nat -> E) (hc : Chain c) (n : Nat) :
  dist n (compl c hc) (c n)
}


-- =================================================================================
-- OFE, COFE and dist lemmas
-- =================================================================================


\lemma n<=sucn (n : Nat) : n <= suc n \elim n
  | 0 => zero<=_
  | suc n => suc<=suc (n<=sucn n)

\lemma dist_S {O : OFE} (n : Nat) (x y : O.E) : O.dist (suc n) x y -> O.dist n x y =>
  \lam h => O.ofe_dist_le (suc n) n x y h (n<=sucn n)

\lemma equiv_dist_n {O : OFE} (x y : O.E) : x = y -> \Pi (n : Nat) -> O.dist n x y =>
  \lam eq n => transport (\lam z => O.dist n x z) eq (O.ofe_dist_refl n x)

\lemma ne_proper {A B : OFE} (f : A.E -> B.E) (hf : NonExpansive f)
                 (x y : A.E) : x = y -> f x = f y =>
  \lam eq => pmap f eq

\func chain_const {O : OFE} (a : O.E) : \Sigma (c : Nat -> O.E) (Chain c) =>
  (\lam _ => a, \new Chain {
    | chain_cauchy => \lam n m _ => O.ofe_dist_refl n a
  })

\lemma compl_chain_const {O : COFE} (a : O.E) :
  \let cc => chain_const {O} a
  \in O.equiv (O.compl cc.1 cc.2) a =>
  \let cc => chain_const {O} a \in
    (O.ofe_equiv_dist _ _).2 (\lam n => O.cofe_conv_compl cc.1 cc.2 n)

\func chain_map {A B : OFE} (f : A.E -> B.E) (hf : NonExpansive f)
                (c : Nat -> A.E) (hc : Chain c) : \Sigma (c' : Nat -> B.E) (Chain c') =>
  (\lam n => f (c n), \new Chain {
    | chain_cauchy => \lam n m le => hf n (c m) (c n) (hc.chain_cauchy n m le)
  })

\lemma compl_chain_map {A B : COFE} (f : A.E -> B.E) (hf : NonExpansive f)
                       (c : Nat -> A.E) (hc : Chain c) :
  B.equiv (f (A.compl c hc)) (B.compl (chain_map f hf c hc).1 (chain_map f hf c hc).2) =>
  \let cm => chain_map f hf c hc \in
    (B.ofe_equiv_dist _ _).2 (\lam n =>
        B.ofe_dist_trans n (f (A.compl c hc)) (f (c n)) (B.compl cm.1 cm.2)
            (hf n (A.compl c hc) (c n) (A.cofe_conv_compl c hc n))
            (B.ofe_dist_sym n (B.compl cm.1 cm.2) (cm.1 n) (B.cofe_conv_compl cm.1 cm.2 n)))


\lemma dist_later_zero {A : OFE} (x y : A.E) : DistLater {A} 0 x y \cowith
  | dist_later_lt => \lam m h => \case h \with {}


\lemma dist_to_dist_later_suc {A : OFE} (n : Nat) (x y : A.E) (h : A.dist n x y)
  : DistLater {A} (suc n) x y \cowith
  | dist_later_lt => \lam m hm => A.ofe_dist_le n m x y h (<_suc_<= hm)

\lemma dist_later_suc_to_dist {A : OFE} (n : Nat) (x y : A.E) (h : DistLater {A} (suc n) x y)
  : A.dist n x y => h.dist_later_lt n id<suc


-- =================================================================================
-- OFE Morphisms (non-expansive functions)
-- =================================================================================

\record OFEMor (A B : OFE)
  | ofe_mor_car : A.E -> B.E
  | ofe_mor_ne : NonExpansive ofe_mor_car

\instance OFEMorOFE (A B : OFE) : OFE \cowith
  | E => OFEMor A B
  | dist => \lam n f g => \Pi (x : A.E) -> B.dist n (f.ofe_mor_car x) (g.ofe_mor_car x)
  | equiv => \lam f g => \Pi (x : A.E) -> B.equiv (f.ofe_mor_car x) (g.ofe_mor_car x)
  | equiv_refl => \lam f x => B.equiv_refl (f.ofe_mor_car x)
  | equiv_sym => \lam f g h x => B.equiv_sym (f.ofe_mor_car x) (g.ofe_mor_car x) (h x)
  | equiv_trans => \lam f g h hfg hgh x =>
      B.equiv_trans (f.ofe_mor_car x) (g.ofe_mor_car x) (h.ofe_mor_car x) (hfg x) (hgh x)
  | ofe_equiv_dist => \lam f g => (
      \lam he n x => (B.ofe_equiv_dist (f.ofe_mor_car x) (g.ofe_mor_car x)).1 (he x) n,
      \lam hd x => (B.ofe_equiv_dist (f.ofe_mor_car x) (g.ofe_mor_car x)).2 (\lam n => hd n x)
    )
  | ofe_dist_refl => \lam n f x => B.ofe_dist_refl n (f.ofe_mor_car x)
  | ofe_dist_sym => \lam n f g h x => B.ofe_dist_sym n (f.ofe_mor_car x) (g.ofe_mor_car x) (h x)
  | ofe_dist_trans => \lam n f g h hfg hgh x =>
      B.ofe_dist_trans n (f.ofe_mor_car x) (g.ofe_mor_car x) (h.ofe_mor_car x) (hfg x) (hgh x)
  | ofe_dist_le => \lam n m f g h le x =>
      B.ofe_dist_le n m (f.ofe_mor_car x) (g.ofe_mor_car x) (h x) le

\instance OFEMorCOFE (A : OFE) (B : COFE) : COFE \cowith
  | OFE => OFEMorOFE A B
  | compl => \lam c hc => \new OFEMor A B {
      | ofe_mor_car => \lam x =>
          B.compl
            (\lam n => (c n).ofe_mor_car x)
            (\new Chain { | chain_cauchy => \lam n m le => hc.chain_cauchy n m le x })
      | ofe_mor_ne => \lam n x y hxy =>
          \let
            | cx : Nat -> B.E => \lam k => (c k).ofe_mor_car x
            | cy : Nat -> B.E => \lam k => (c k).ofe_mor_car y
            | hcx : Chain cx => \new Chain { | chain_cauchy => \lam k l le => hc.chain_cauchy k l le x }
            | hcy : Chain cy => \new Chain { | chain_cauchy => \lam k l le => hc.chain_cauchy k l le y }
          \in B.ofe_dist_trans n
              (B.compl cx hcx)
              ((c n).ofe_mor_car x)
              (B.compl cy hcy)
              (B.cofe_conv_compl cx hcx n)
              (B.ofe_dist_trans n
                ((c n).ofe_mor_car x)
                ((c n).ofe_mor_car y)
                (B.compl cy hcy)
                ((c n).ofe_mor_ne n x y hxy)
                (B.ofe_dist_sym n (B.compl cy hcy) ((c n).ofe_mor_car y)
                  (B.cofe_conv_compl cy hcy n)))
    }
  | cofe_conv_compl => \lam c hc n x =>
      B.cofe_conv_compl
        (\lam k => (c k).ofe_mor_car x)
        (\new Chain { | chain_cauchy => \lam k l le => hc.chain_cauchy k l le x })
        n

\func ofe_mor_id {A : OFE} : OFEMor A A \cowith
  | ofe_mor_car => \lam x => x
  | ofe_mor_ne => \lam n x y h => h

\func ofe_mor_comp {A B C : OFE} (g : OFEMor B C) (f : OFEMor A B) : OFEMor A C \cowith
  | ofe_mor_car => \lam x => g.ofe_mor_car (f.ofe_mor_car x)
  | ofe_mor_ne => \lam n x y h => g.ofe_mor_ne n (f.ofe_mor_car x) (f.ofe_mor_car y) (f.ofe_mor_ne n x y h)

\func ofe_mor_const {A B : OFE} (b : B.E) : OFEMor A B \cowith
  | ofe_mor_car => \lam _ => b
  | ofe_mor_ne => \lam n x y h => B.ofe_dist_refl n b

\lemma ofe_mor_car_ne {A B : OFE} (n : Nat) (f g : OFEMor A B) (x y : A.E)
                       (hfg : (OFEMorOFE A B).dist n f g) (hxy : A.dist n x y)
  : B.dist n (f.ofe_mor_car x) (g.ofe_mor_car y) =>
  B.ofe_dist_trans n
    (f.ofe_mor_car x)
    (f.ofe_mor_car y)
    (g.ofe_mor_car y)
    (f.ofe_mor_ne n x y hxy)
    (hfg y)

\lemma ofe_mor_comp_ne {A B C : OFE} (n : Nat)
                       (g1 g2 : OFEMor B C) (f1 f2 : OFEMor A B)
                       (hg : (OFEMorOFE B C).dist n g1 g2)
                       (hf : (OFEMorOFE A B).dist n f1 f2)
  : (OFEMorOFE A C).dist n (ofe_mor_comp g1 f1) (ofe_mor_comp g2 f2) =>
  \lam x =>
    C.ofe_dist_trans n
      (g1.ofe_mor_car (f1.ofe_mor_car x))
      (g1.ofe_mor_car (f2.ofe_mor_car x))
      (g2.ofe_mor_car (f2.ofe_mor_car x))
      (g1.ofe_mor_ne n (f1.ofe_mor_car x) (f2.ofe_mor_car x) (hf x))
      (hg (f2.ofe_mor_car x))

\lemma ofe_mor_proper {A B : OFE} (f : OFEMor A B) (x y : A.E)
                      (h : A.equiv x y) :
  B.equiv (f.ofe_mor_car x) (f.ofe_mor_car y) =>
  (B.ofe_equiv_dist (f.ofe_mor_car x) (f.ofe_mor_car y)).2
    (\lam n => f.ofe_mor_ne n x y ((A.ofe_equiv_dist x y).1 h n))

\func ofe_mor_ext {A B : OFE} (f g : OFEMor A B)
  : (OFEMorOFE A B).equiv f g <-> (\Pi (x : A.E) -> B.equiv (f.ofe_mor_car x) (g.ofe_mor_car x)) =>
  (\lam h => h, \lam h => h)


-- =================================================================================
-- OFE Isomorphisms
-- =================================================================================

\record OFEIso (A B : OFE)
  | ofe_iso_1 : OFEMor A B
  | ofe_iso_2 : OFEMor B A
  | ofe_iso_12 (y : B.E) : B.equiv (ofe_iso_1.ofe_mor_car (ofe_iso_2.ofe_mor_car y)) y
  | ofe_iso_21 (x : A.E) : A.equiv (ofe_iso_2.ofe_mor_car (ofe_iso_1.ofe_mor_car x)) x

\instance OFEIsoOFE (A B : OFE) : OFE \cowith
  | E => OFEIso A B
  | dist => \lam n I J => \Sigma
      ((OFEMorOFE A B).dist n I.ofe_iso_1 J.ofe_iso_1)
      ((OFEMorOFE B A).dist n I.ofe_iso_2 J.ofe_iso_2)
  | equiv => \lam I J => \Sigma
      ((OFEMorOFE A B).equiv I.ofe_iso_1 J.ofe_iso_1)
      ((OFEMorOFE B A).equiv I.ofe_iso_2 J.ofe_iso_2)
  | equiv_refl => \lam I => ((OFEMorOFE A B).equiv_refl I.ofe_iso_1, (OFEMorOFE B A).equiv_refl I.ofe_iso_2)
  | equiv_sym => \lam I J h => ((OFEMorOFE A B).equiv_sym I.ofe_iso_1 J.ofe_iso_1 h.1,
                                (OFEMorOFE B A).equiv_sym I.ofe_iso_2 J.ofe_iso_2 h.2)
  | equiv_trans => \lam I J K hIJ hJK =>
      ((OFEMorOFE A B).equiv_trans I.ofe_iso_1 J.ofe_iso_1 K.ofe_iso_1 hIJ.1 hJK.1,
       (OFEMorOFE B A).equiv_trans I.ofe_iso_2 J.ofe_iso_2 K.ofe_iso_2 hIJ.2 hJK.2)
  | ofe_equiv_dist => \lam I J => (
      \lam he n => (((OFEMorOFE A B).ofe_equiv_dist I.ofe_iso_1 J.ofe_iso_1).1 he.1 n,
                    ((OFEMorOFE B A).ofe_equiv_dist I.ofe_iso_2 J.ofe_iso_2).1 he.2 n),
      \lam hd => (((OFEMorOFE A B).ofe_equiv_dist I.ofe_iso_1 J.ofe_iso_1).2 (\lam n => (hd n).1),
                  ((OFEMorOFE B A).ofe_equiv_dist I.ofe_iso_2 J.ofe_iso_2).2 (\lam n => (hd n).2))
    )
  | ofe_dist_refl => \lam n I => ((OFEMorOFE A B).ofe_dist_refl n I.ofe_iso_1,
                                  (OFEMorOFE B A).ofe_dist_refl n I.ofe_iso_2)
  | ofe_dist_sym => \lam n I J h => ((OFEMorOFE A B).ofe_dist_sym n I.ofe_iso_1 J.ofe_iso_1 h.1,
                                     (OFEMorOFE B A).ofe_dist_sym n I.ofe_iso_2 J.ofe_iso_2 h.2)
  | ofe_dist_trans => \lam n I J K hIJ hJK =>
      ((OFEMorOFE A B).ofe_dist_trans n I.ofe_iso_1 J.ofe_iso_1 K.ofe_iso_1 hIJ.1 hJK.1,
       (OFEMorOFE B A).ofe_dist_trans n I.ofe_iso_2 J.ofe_iso_2 K.ofe_iso_2 hIJ.2 hJK.2)
  | ofe_dist_le => \lam n m I J h le => ((OFEMorOFE A B).ofe_dist_le n m I.ofe_iso_1 J.ofe_iso_1 h.1 le,
                                         (OFEMorOFE B A).ofe_dist_le n m I.ofe_iso_2 J.ofe_iso_2 h.2 le)

\func iso_ofe_refl {A : OFE} : OFEIso A A \cowith
  | ofe_iso_1 => ofe_mor_id
  | ofe_iso_2 => ofe_mor_id
  | ofe_iso_12 => \lam y => A.equiv_refl y
  | ofe_iso_21 => \lam x => A.equiv_refl x

\func iso_ofe_sym {A B : OFE} (I : OFEIso A B) : OFEIso B A \cowith
  | ofe_iso_1 => I.ofe_iso_2
  | ofe_iso_2 => I.ofe_iso_1
  | ofe_iso_12 => I.ofe_iso_21
  | ofe_iso_21 => I.ofe_iso_12


-- =================================================================================
-- OFE Examples
-- =================================================================================


\instance UnitOFE : LeibnizOFE \cowith
  | E => \Sigma
  | dist => \lam _ _ _ => \Sigma
  | ofe_equiv_dist => \lam _ _ => (\lam _ _ => (), \lam _ => idp)
  | ofe_dist_refl => \lam _ _ => ()
  | ofe_dist_sym => \lam _ _ _ _ => ()
  | ofe_dist_trans => \lam _ _ _ _ _ _ => ()
  | ofe_dist_le => \lam _ _ _ _ _ _ => ()

\instance UnitCOFE : COFE \cowith
  | OFE => UnitOFE
  | compl => \lam _ _ => ()
  | cofe_conv_compl => \lam _ _ _ => ()

\instance EmptyOFE : LeibnizOFE \cowith
  | E => Empty
  | dist => \lam _ e _ => \case e \with {}
  | ofe_equiv_dist => \lam e => \case e \with {}
  | ofe_dist_refl => \lam _ e => \case e \with {}
  | ofe_dist_sym => \lam _ e => \case e \with {}
  | ofe_dist_trans => \lam _ e => \case e \with {}
  | ofe_dist_le => \lam _ _ e => \case e \with {}

\instance ProdOFE (A B : OFE) : OFE \cowith
  | E => \Sigma A.E B.E
  | dist => \lam n p q => \Sigma (A.dist n p.1 q.1) (B.dist n p.2 q.2)
  | equiv => \lam p q => \Sigma (A.equiv p.1 q.1) (B.equiv p.2 q.2)
  | equiv_refl => \lam p => (A.equiv_refl p.1, B.equiv_refl p.2)
  | equiv_sym => \lam p q h => (A.equiv_sym p.1 q.1 h.1, B.equiv_sym p.2 q.2 h.2)
  | equiv_trans => \lam p q r h1 h2 =>
      (A.equiv_trans p.1 q.1 r.1 h1.1 h2.1, B.equiv_trans p.2 q.2 r.2 h1.2 h2.2)
  | ofe_equiv_dist => \lam p q => (
    \lam eq n => ((A.ofe_equiv_dist p.1 q.1).1 eq.1 n, (B.ofe_equiv_dist p.2 q.2).1 eq.2 n),
    \lam h => ((A.ofe_equiv_dist p.1 q.1).2 (\lam n => (h n).1),
               (B.ofe_equiv_dist p.2 q.2).2 (\lam n => (h n).2))
  )
  | ofe_dist_refl => \lam n p => (A.ofe_dist_refl n p.1, B.ofe_dist_refl n p.2)
  | ofe_dist_sym => \lam n p q h => (A.ofe_dist_sym n p.1 q.1 h.1, B.ofe_dist_sym n p.2 q.2 h.2)
  | ofe_dist_trans => \lam n p q r h1 h2 => (A.ofe_dist_trans n p.1 q.1 r.1 h1.1 h2.1, B.ofe_dist_trans n p.2 q.2 r.2 h1.2 h2.2)
  | ofe_dist_le => \lam n m p q h le => (A.ofe_dist_le n m p.1 q.1 h.1 le, B.ofe_dist_le n m p.2 q.2 h.2 le)


\instance ProdCOFE (A B : COFE) : COFE \cowith
  | OFE => ProdOFE A B
  | compl => \lam c hc => (A.compl (\lam n => (c n).1) (\new Chain {
    | chain_cauchy => \lam n m le => (hc.chain_cauchy n m le).1
  }), B.compl (\lam n => (c n).2) (\new Chain {
    | chain_cauchy => \lam n m le => (hc.chain_cauchy n m le).2
  }))
  | cofe_conv_compl => \lam c hc n => (
    A.cofe_conv_compl (\lam n => (c n).1) _ n,
    B.cofe_conv_compl (\lam n => (c n).2) _ n
  )

-- =================================================================================
-- COFE -> OFE Functors
-- =================================================================================

\record OFunctor
  | oFunctor_car (A B : COFE) : OFE
  | oFunctor_map {A1 A2 B1 B2 : COFE} :
      \Sigma (OFEMor A2 A1) (OFEMor B1 B2) ->
      OFEMor (oFunctor_car A1 B1) (oFunctor_car A2 B2)
  | oFunctor_map_ne {A1 A2 B1 B2 : COFE} :
      NonExpansive
        {ProdOFE (OFEMorOFE A2 A1) (OFEMorOFE B1 B2)}
        {OFEMorOFE (oFunctor_car A1 B1) (oFunctor_car A2 B2)}
        oFunctor_map
  | oFunctor_map_id {A B : COFE} (x : (oFunctor_car A B).E) :
      (oFunctor_car A B).equiv
        ((oFunctor_map (ofe_mor_id, ofe_mor_id)).ofe_mor_car x)
        x
  | oFunctor_map_compose {A1 A2 A3 B1 B2 B3 : COFE}
      (f : OFEMor A2 A1) (g : OFEMor A3 A2)
      (f' : OFEMor B1 B2) (g' : OFEMor B2 B3)
      (x : (oFunctor_car A1 B1).E) :
      (oFunctor_car A3 B3).equiv
        ((oFunctor_map (g, g')).ofe_mor_car
          ((oFunctor_map (f, f')).ofe_mor_car x))
        ((oFunctor_map (ofe_mor_comp f g, ofe_mor_comp g' f')).ofe_mor_car x)

\record OFunctorContractive (F : OFunctor)
  | oFunctor_map_contractive {A1 A2 B1 B2 : COFE} :
      ContractiveMap
        {ProdOFE (OFEMorOFE A2 A1) (OFEMorOFE B1 B2)}
        {OFEMorOFE (F.oFunctor_car A1 B1) (F.oFunctor_car A2 B2)}
        (F.oFunctor_map {A1} {A2} {B1} {B2})

\func oFunctor_apply (F : OFunctor) (A : COFE) : OFE =>
  F.oFunctor_car A A

\func constOF (B : OFE) : OFunctor \cowith
  | oFunctor_car => \lam _ _ => B
  | oFunctor_map => \lam _ => ofe_mor_id
  | oFunctor_map_ne => \lam n fg fg' hfg x => B.ofe_dist_refl n x
  | oFunctor_map_id => \lam x => B.equiv_refl x
  | oFunctor_map_compose {A1} {A2} {A3} {B1} {B2} {B3} => \lam f g f' g' x => B.equiv_refl x

\func idOF : OFunctor \cowith
  | oFunctor_car => \lam _ B => B
  | oFunctor_map => \lam fg => fg.2
  | oFunctor_map_ne => \lam n fg fg' hfg => hfg.2
  | oFunctor_map_id {A} {B} => \lam x => B.equiv_refl x
  | oFunctor_map_compose {A1} {A2} {A3} {B1} {B2} {B3} =>
      \lam f g f' g' x => B3.equiv_refl (g'.ofe_mor_car (f'.ofe_mor_car x))

\func prodOF (F1 F2 : OFunctor) : OFunctor \cowith
  | oFunctor_car => \lam A B => ProdOFE (F1.oFunctor_car A B) (F2.oFunctor_car A B)
  | oFunctor_map => \lam fg => \new OFEMor _ _ {
      | ofe_mor_car => \lam x =>
          ((F1.oFunctor_map fg).ofe_mor_car x.1,
           (F2.oFunctor_map fg).ofe_mor_car x.2)
      | ofe_mor_ne => \lam n x y hxy =>
          ((F1.oFunctor_map fg).ofe_mor_ne n x.1 y.1 hxy.1,
           (F2.oFunctor_map fg).ofe_mor_ne n x.2 y.2 hxy.2)
    }
  | oFunctor_map_ne => \lam n fg fg' hfg x =>
      (F1.oFunctor_map_ne n fg fg' hfg x.1,
       F2.oFunctor_map_ne n fg fg' hfg x.2)
  | oFunctor_map_id => \lam x =>
      (F1.oFunctor_map_id x.1, F2.oFunctor_map_id x.2)
  | oFunctor_map_compose => \lam f g f' g' x =>
      (F1.oFunctor_map_compose f g f' g' x.1,
       F2.oFunctor_map_compose f g f' g' x.2)

\func constOF_contractive (B : OFE) : OFunctorContractive (constOF B) \cowith
  | oFunctor_map_contractive => \lam n fg fg' hfg x => B.ofe_dist_refl n x

\func prodOF_contractive (F1 F2 : OFunctor)
                         (h1 : OFunctorContractive F1)
                         (h2 : OFunctorContractive F2)
  : OFunctorContractive (prodOF F1 F2) \cowith
  | oFunctor_map_contractive => \lam n fg fg' hfg x =>
      (h1.oFunctor_map_contractive n fg fg' hfg x.1,
       h2.oFunctor_map_contractive n fg fg' hfg x.2)

\record OFunctorCOFE (F : OFunctor)
  | oFunctor_cofe (A B : COFE) : COFE
  | oFunctor_cofe_OFE (A B : COFE) : oFunctor_cofe A B = F.oFunctor_car A B

\func constOF_cofe (B : COFE) : OFunctorCOFE (constOF B) \cowith
  | oFunctor_cofe => \lam _ _ => B
  | oFunctor_cofe_OFE => \lam _ _ => idp

\func idOF_cofe : OFunctorCOFE idOF \cowith
  | oFunctor_cofe => \lam _ B => B
  | oFunctor_cofe_OFE => \lam _ _ => idp

\func prodOF_cofe (F1 F2 : OFunctor)
                  (h1 : OFunctorCOFE F1)
                  (h2 : OFunctorCOFE F2)
  : OFunctorCOFE (prodOF F1 F2) \cowith
  | oFunctor_cofe => \lam A B => ProdCOFE (h1.oFunctor_cofe A B) (h2.oFunctor_cofe A B)
  | oFunctor_cofe_OFE => \lam A B =>
      pmap2 ProdOFE (h1.oFunctor_cofe_OFE A B) (h2.oFunctor_cofe_OFE A B)

\instance SumOFE (A B : OFE) : OFE \cowith
  | E => Or A.E B.E
  | dist => \lam n s1 s2 => \case s1, s2 \with {
    | inl a1, inl a2 => A.dist n a1 a2
    | inr b1, inr b2 => B.dist n b1 b2
    | _, _ => Empty
  }
  | equiv => \lam s1 s2 => \case s1, s2 \with {
    | inl a1, inl a2 => A.equiv a1 a2
    | inr b1, inr b2 => B.equiv b1 b2
    | _, _ => Empty
  }
  | equiv_refl => \lam s => \case \elim s \with {
    | inl a => A.equiv_refl a
    | inr b => B.equiv_refl b
  }
  | equiv_sym => \lam s1 s2 => \case \elim s1, \elim s2 \with {
    | inl a1, inl a2 => \lam h => A.equiv_sym a1 a2 h
    | inr b1, inr b2 => \lam h => B.equiv_sym b1 b2 h
    | inl _, inr _ => \lam e => \case e \with {}
    | inr _, inl _ => \lam e => \case e \with {}
  }
  | equiv_trans => \lam s1 s2 s3 => \case \elim s1, \elim s2, \elim s3 \with {
    | inl a1, inl a2, inl a3 => \lam h1 h2 => A.equiv_trans a1 a2 a3 h1 h2
    | inr b1, inr b2, inr b3 => \lam h1 h2 => B.equiv_trans b1 b2 b3 h1 h2
    | inl _, inr _, _ => \lam e => \case e \with {}
    | inr _, inl _, _ => \lam e => \case e \with {}
    | _, inl _, inr _ => \lam _ e => \case e \with {}
    | _, inr _, inl _ => \lam _ e => \case e \with {}
  }
  | ofe_equiv_dist => \lam s1 s2 => \case \elim s1, \elim s2 \with {
    | inl a1, inl a2 => (
      \lam he n => (A.ofe_equiv_dist a1 a2).1 he n,
      \lam h => (A.ofe_equiv_dist a1 a2).2 h
    )
    | inr b1, inr b2 => (
      \lam he n => (B.ofe_equiv_dist b1 b2).1 he n,
      \lam h => (B.ofe_equiv_dist b1 b2).2 h
    )
    | inl _, inr _ => (\lam e => \case e \with {}, \lam h => \case h 0)
    | inr _, inl _ => (\lam e => \case e \with {}, \lam h => \case h 0)
  }
  | ofe_dist_refl => \lam n s => \case \elim s \with {
    | inl a => A.ofe_dist_refl n a
    | inr b => B.ofe_dist_refl n b
  }
  | ofe_dist_sym => \lam n s1 s2 => \case \elim s1, \elim s2 \with {
    | inl a1, inl a2 => \lam h => A.ofe_dist_sym n a1 a2 h
    | inr b1, inr b2 => \lam h => B.ofe_dist_sym n b1 b2 h
    | inl _, inr _ => \lam e => \case e \with {}
    | inr _, inl _ => \lam e => \case e \with {}
  }
  | ofe_dist_trans => \lam n s1 s2 s3 => \case \elim s1, \elim s2, \elim s3 \with {
    | inl a1, inl a2, inl a3 => \lam h1 h2 => A.ofe_dist_trans n a1 a2 a3 h1 h2
    | inr b1, inr b2, inr b3 => \lam h1 h2 => B.ofe_dist_trans n b1 b2 b3 h1 h2
    | inl _, inr _, _ => \lam e => \case e \with {}
    | inr _, inl _, _ => \lam e => \case e \with {}
    | _, inl _, inr _ => \lam _ e => \case e \with {}
    | _, inr _, inl _ => \lam _ e => \case e \with {}
  }
  | ofe_dist_le => \lam n m s1 s2 => \case \elim s1, \elim s2 \with {
    | inl a1, inl a2 => \lam h le => A.ofe_dist_le n m a1 a2 h le
    | inr b1, inr b2 => \lam h le => B.ofe_dist_le n m b1 b2 h le
    | inl _, inr _ => \lam e => \case e \with {}
    | inr _, inl _ => \lam e => \case e \with {}
  }

\instance OptionOFE (A : OFE) : OFE \cowith
  | E => Maybe A.E
  | dist => \lam n o1 o2 => \case o1, o2 \with {
    | nothing, nothing => \Sigma
    | just a1, just a2 => A.dist n a1 a2
    | _, _ => Empty
  }
  | equiv => \lam o1 o2 => \case o1, o2 \with {
    | nothing, nothing => \Sigma
    | just a1, just a2 => A.equiv a1 a2
    | _, _ => Empty
  }
  | equiv_refl => \lam o => \case \elim o \with {
    | nothing => ()
    | just a => A.equiv_refl a
  }
  | equiv_sym => \lam o1 o2 => \case \elim o1, \elim o2 \with {
    | nothing, nothing => \lam _ => ()
    | just a1, just a2 => \lam h => A.equiv_sym a1 a2 h
    | nothing, just _ => \lam e => \case e \with {}
    | just _, nothing => \lam e => \case e \with {}
  }
  | equiv_trans => \lam o1 o2 o3 => \case \elim o1, \elim o2, \elim o3 \with {
    | nothing, nothing, nothing => \lam _ _ => ()
    | just a1, just a2, just a3 => \lam h1 h2 => A.equiv_trans a1 a2 a3 h1 h2
    | nothing, just _, _ => \lam e => \case e \with {}
    | just _, nothing, _ => \lam e => \case e \with {}
    | _, nothing, just _ => \lam _ e => \case e \with {}
    | _, just _, nothing => \lam _ e => \case e \with {}
  }
  | ofe_equiv_dist => \lam o1 o2 => \case \elim o1, \elim o2 \with {
    | nothing, nothing => (\lam _ _ => (), \lam _ => ())
    | just a1, just a2 => (
      \lam he n => (A.ofe_equiv_dist a1 a2).1 he n,
      \lam h => (A.ofe_equiv_dist a1 a2).2 h
    )
    | nothing, just _ => (\lam e => \case e \with {}, \lam h => \case h 0)
    | just _, nothing => (\lam e => \case e \with {}, \lam h => \case h 0)
  }
  | ofe_dist_refl => \lam n o => \case \elim o \with {
    | nothing => ()
    | just a => A.ofe_dist_refl n a
  }
  | ofe_dist_sym => \lam n o1 o2 => \case \elim o1, \elim o2 \with {
    | nothing, nothing => \lam _ => ()
    | just a1, just a2 => \lam h => A.ofe_dist_sym n a1 a2 h
    | nothing, just _ => \lam e => \case e \with {}
    | just _, nothing => \lam e => \case e \with {}
  }
  | ofe_dist_trans => \lam n o1 o2 o3 => \case \elim o1, \elim o2, \elim o3 \with {
    | nothing, nothing, nothing => \lam _ _ => ()
    | just a1, just a2, just a3 => \lam h1 h2 => A.ofe_dist_trans n a1 a2 a3 h1 h2
    | nothing, just _, _ => \lam e => \case e \with {}
    | just _, nothing, _ => \lam e => \case e \with {}
    | _, nothing, just _ => \lam _ e => \case e \with {}
    | _, just _, nothing => \lam _ e => \case e \with {}
  }
  | ofe_dist_le => \lam n m o1 o2 => \case \elim o1, \elim o2 \with {
    | nothing, nothing => \lam _ _ => ()
    | just a1, just a2 => \lam h le => A.ofe_dist_le n m a1 a2 h le
    | nothing, just _ => \lam e => \case e \with {}
    | just _, nothing => \lam e => \case e \with {}
  }

-- =================================================================================
-- Later OFE: the step-indexed shift
-- =================================================================================
--
-- `Later A` wraps an `A` value so that distance is shifted down by one:
-- `dist n (next x) (next y) ↔ dist_later n x y`. The constructor `next` is
-- *contractive*, which is the key fact that breaks the recursion when
-- defining `iProp` via `Agree (Later iProp)`-style algebras.

\data Later (A : \Set)
  | next A

\func laterUnNext {A : \Set} (l : Later A) : A \elim l
  | next x => x

\instance LaterOFE (A : OFE) : OFE \cowith
  | E => Later A.E
  | dist => \lam n l1 l2 => DistLater {A} n (laterUnNext l1) (laterUnNext l2)
  | equiv => \lam l1 l2 => A.equiv (laterUnNext l1) (laterUnNext l2)
  | equiv_refl => \lam l => A.equiv_refl (laterUnNext l)
  | equiv_sym => \lam l1 l2 => A.equiv_sym (laterUnNext l1) (laterUnNext l2)
  | equiv_trans => \lam l1 l2 l3 =>
      A.equiv_trans (laterUnNext l1) (laterUnNext l2) (laterUnNext l3)
  | ofe_equiv_dist => \lam l1 l2 =>
      (\lam he n => \new DistLater {
         | dist_later_lt m _ => (A.ofe_equiv_dist (laterUnNext l1) (laterUnNext l2)).1 he m
       },
       \lam h => (A.ofe_equiv_dist (laterUnNext l1) (laterUnNext l2)).2
                 (\lam m => (h (suc m)).dist_later_lt m id<suc))
  | ofe_dist_refl => \lam n l => \new DistLater {
      | dist_later_lt m _ => A.ofe_dist_refl m (laterUnNext l)
    }
  | ofe_dist_sym => \lam n l1 l2 h => \new DistLater {
      | dist_later_lt m hm =>
        A.ofe_dist_sym m (laterUnNext l1) (laterUnNext l2) (h.dist_later_lt m hm)
    }
  | ofe_dist_trans => \lam n l1 l2 l3 h1 h2 => \new DistLater {
      | dist_later_lt m hm =>
        A.ofe_dist_trans m (laterUnNext l1) (laterUnNext l2) (laterUnNext l3)
            (h1.dist_later_lt m hm) (h2.dist_later_lt m hm)
    }
  | ofe_dist_le => \lam n k l1 l2 h le => \new DistLater {
      | dist_later_lt m hm =>
        h.dist_later_lt m (NatSemiring.<-transitive-left hm le)
    }

\instance LaterCOFE (A : COFE) : COFE \cowith
  | OFE => LaterOFE A
  | compl => \lam c hc => next (A.compl
      (\lam n => laterUnNext (c (suc n)))
      (\new Chain {
        | chain_cauchy => \lam n m le =>
            dist_later_suc_to_dist n
              (laterUnNext (c (suc m)))
              (laterUnNext (c (suc n)))
              (hc.chain_cauchy (suc n) (suc m) (suc<=suc le))
      }))
  | cofe_conv_compl => \lam c hc n => \new DistLater {
      | dist_later_lt => \lam m hm =>
          \let
            | d : Nat -> A.E => \lam k => laterUnNext (c (suc k))
            | hd : Chain d => \new Chain {
                | chain_cauchy => \lam k l le =>
                    dist_later_suc_to_dist k
                      (laterUnNext (c (suc l)))
                      (laterUnNext (c (suc k)))
                      (hc.chain_cauchy (suc k) (suc l) (suc<=suc le))
              }
            | left : A.dist m (A.compl d hd) (d m) =>
                A.cofe_conv_compl d hd m
            | right : A.dist m (d m) (laterUnNext (c n)) =>
                A.ofe_dist_sym m
                  (laterUnNext (c n))
                  (d m)
                  ((hc.chain_cauchy (suc m) n (suc_<_<= hm)).dist_later_lt m id<suc)
          \in A.ofe_dist_trans m (A.compl d hd) (d m) (laterUnNext (c n)) left right
    }

-- `next` shifts distance down by one: `dist n x y → dist (suc n) (next x) (next y)`.
-- This is the contractivity fact about `next : A.E → Later A.E`.
\lemma dist_later_next {A : OFE} (n : Nat) (x y : A.E) (h : A.dist n x y)
  : (LaterOFE A).dist (suc n) (next x) (next y) =>
  dist_to_dist_later_suc n x y h

-- A `DistLater` witness on the underlying values lifts to a `dist` on `next`.
\lemma next_dist {A : OFE} (n : Nat) (x y : A.E) (h : DistLater {A} n x y)
  : (LaterOFE A).dist n (next x) (next y) => h

\func later_map {A B : OFE} (f : OFEMor A B) : OFEMor (LaterOFE A) (LaterOFE B) \cowith
  | ofe_mor_car => \lam l => next (f.ofe_mor_car (laterUnNext l))
  | ofe_mor_ne => \lam n l1 l2 h => \new DistLater {
      | dist_later_lt => \lam m hm =>
          f.ofe_mor_ne m (laterUnNext l1) (laterUnNext l2) (h.dist_later_lt m hm)
    }

\lemma later_map_id {A : OFE} (l : (LaterOFE A).E) :
  (LaterOFE A).equiv ((later_map ofe_mor_id).ofe_mor_car l) l =>
  A.equiv_refl (laterUnNext l)

\lemma later_map_compose {A B C : OFE} (f : OFEMor A B) (g : OFEMor B C)
  (l : (LaterOFE A).E) :
  (LaterOFE C).equiv
    ((later_map (ofe_mor_comp g f)).ofe_mor_car l)
    ((later_map g).ofe_mor_car ((later_map f).ofe_mor_car l)) =>
  C.equiv_refl (g.ofe_mor_car (f.ofe_mor_car (laterUnNext l)))

\lemma later_map_ext {A B : OFE} (f g : OFEMor A B) (l : (LaterOFE A).E)
                     (h : (OFEMorOFE A B).equiv f g) :
  (LaterOFE B).equiv ((later_map f).ofe_mor_car l) ((later_map g).ofe_mor_car l) =>
  h (laterUnNext l)

\func laterOF (F : OFunctor) : OFunctor \cowith
  | oFunctor_car => \lam A B => LaterOFE (F.oFunctor_car A B)
  | oFunctor_map => \lam fg => later_map (F.oFunctor_map fg)
  | oFunctor_map_ne => \lam n fg fg' hfg l => \new DistLater {
      | dist_later_lt => \lam m hm =>
          F.oFunctor_map_ne m fg fg'
            ((ProdOFE _ _).ofe_dist_le n m fg fg' hfg (LinearOrder.<_<= hm))
            (laterUnNext l)
    }
  | oFunctor_map_id => \lam l =>
      later_map_ext (F.oFunctor_map (ofe_mor_id, ofe_mor_id)) ofe_mor_id l
        (\lam x => F.oFunctor_map_id x)
  | oFunctor_map_compose => \lam f g f' g' l =>
      (F.oFunctor_map_compose f g f' g' (laterUnNext l))

\func laterOF_contractive (F : OFunctor) : OFunctorContractive (laterOF F) \cowith
  | oFunctor_map_contractive => \lam n fg fg' hfg l => \new DistLater {
      | dist_later_lt => \lam m hm =>
          F.oFunctor_map_ne m fg fg' (hfg.dist_later_lt m hm) (laterUnNext l)
    }

\func laterOF_cofe (F : OFunctor) (h : OFunctorCOFE F) : OFunctorCOFE (laterOF F) \cowith
  | oFunctor_cofe => \lam A B => LaterCOFE (h.oFunctor_cofe A B)
  | oFunctor_cofe_OFE => \lam A B => pmap LaterOFE (h.oFunctor_cofe_OFE A B)


\func DiscreteOFE (S : \Set) : LeibnizOFE \cowith
  | E => S
  | dist => \lam _ x y => x = y
  | ofe_equiv_dist => \lam x y => (\lam eq _ => eq, \lam h => h 0)
  | ofe_dist_refl => \lam _ x => idp
  | ofe_dist_sym => \lam _ x y => inv
  | ofe_dist_trans => \lam _ x y z p q => p *> q
  | ofe_dist_le => \lam _ _ _ _ h _ => h

\instance FunOFE (A : \Type) (B : OFE) : OFE \cowith
  | E => A -> B.E
  | dist => \lam n f g => \Pi (x : A) -> B.dist n (f x) (g x)
  | equiv => \lam f g => \Pi (x : A) -> B.equiv (f x) (g x)
  | equiv_refl => \lam f x => B.equiv_refl (f x)
  | equiv_sym => \lam f g h x => B.equiv_sym (f x) (g x) (h x)
  | equiv_trans => \lam f g h h1 h2 x => B.equiv_trans (f x) (g x) (h x) (h1 x) (h2 x)
  | ofe_equiv_dist => \lam f g => (
    \lam he n x => (B.ofe_equiv_dist (f x) (g x)).1 (he x) n,
    \lam h x => (B.ofe_equiv_dist (f x) (g x)).2 (\lam n => h n x)
  )
  | ofe_dist_refl => \lam n f x => B.ofe_dist_refl n (f x)
  | ofe_dist_sym => \lam n f g h x => B.ofe_dist_sym n (f x) (g x) (h x)
  | ofe_dist_trans => \lam n f g h h1 h2 x => B.ofe_dist_trans n (f x) (g x) (h x) (h1 x) (h2 x)
  | ofe_dist_le => \lam n m f g h le x => B.ofe_dist_le n m (f x) (g x) (h x) le

\instance FunCOFE (A : \Type) (B : COFE) : COFE \cowith
  | OFE => FunOFE A B
  | compl => \lam c hc x =>
      B.compl
          (\lam n => c n x)
          (\new Chain { | chain_cauchy => \lam n m le => hc.chain_cauchy n m le x })
  | cofe_conv_compl => \lam c hc n x =>
      B.cofe_conv_compl
          (\lam k => c k x)
          (\new Chain { | chain_cauchy => \lam n m le => hc.chain_cauchy n m le x })
          n


-- =================================================================================
-- Support lemmas for OFE's
-- =================================================================================


\lemma discrete_dist_to_eq
  (V : \Set) (n : Nat) (a b : V)
  (h : (DiscreteOFE V).dist n a b)
  : a = b
  => h


-- =================================================================================
-- Contractive
-- =================================================================================

\func Contractive {A : OFE} (f : A.E -> A.E) : \Prop =>
  ContractiveMap {A} {A} f

\lemma contractive_zero {A : OFE} (f : A.E -> A.E) (hf : Contractive f) (x y : A.E)
  : A.dist 0 (f x) (f y) => hf 0 x y (dist_later_zero x y)

\lemma contractive_implies_contractive2 {A : OFE} (f : A.E -> A.E) (hf : Contractive f)
  : Contractive f => \lam n x y dl => hf n x y dl

\lemma contractive_ne {A : OFE} (f : A.E -> A.E) (hf : Contractive f) : NonExpansive f =>
  \lam n x y h =>
      dist_S n (f x) (f y)
          (hf (suc n) x y (dist_to_dist_later_suc n x y h))

\lemma contractiveMap_ne {A B : OFE} (f : A.E -> B.E) (hf : ContractiveMap f) : NonExpansive f =>
  \lam n x y h =>
      B.ofe_dist_le (suc n) n (f x) (f y)
          (hf (suc n) x y (dist_to_dist_later_suc n x y h))
          (n<=sucn n)

\class Inhabited (A : \Type)
  | default : A


-- =================================================================================
-- Banach Thm
-- =================================================================================


\func fp_approx {A : COFE} {inh : Inhabited A.E} (f : A.E -> A.E) (hf : Contractive f)
                (n : Nat) : A.E \elim n
  | 0 => f inh.default
  | suc n => f (fp_approx f hf n)

\lemma fp_approx_cauchy {A : COFE} {inh : Inhabited A.E} (f : A.E -> A.E) (hf : Contractive f)
                        (n m : Nat) (le : n <= m)
  : A.dist n (fp_approx f hf m) (fp_approx f hf n) \elim n, m
  | 0, 0 => A.ofe_dist_refl 0 (f inh.default)
  | 0, suc m' => contractive_zero f hf (fp_approx f hf m') inh.default
  | suc n', suc m' =>
    hf (suc n')
        (fp_approx f hf m')
        (fp_approx f hf n')
        (dist_to_dist_later_suc n'
            (fp_approx f hf m')
            (fp_approx f hf n')
            (fp_approx_cauchy f hf n' m' (suc<=suc.conv le)))
  | suc n', 0 => absurd (le NatOrder.zero<suc)

\func fixpoint {A : COFE} {inh : Inhabited A.E} (f : A.E -> A.E) (hf : Contractive f) : A.E =>
  A.compl (fp_approx f hf) (\new Chain { | chain_cauchy => fp_approx_cauchy f hf })

\lemma fixpoint_unfold {A : COFE} {inh : Inhabited A.E} (f : A.E -> A.E) (hf : Contractive f)
  : A.equiv (fixpoint f hf) (f (fixpoint f hf)) =>
  \let | c => fp_approx f hf
       | hc : Chain c => \new Chain c { | chain_cauchy => fp_approx_cauchy f hf }
       | fp => fixpoint f hf
  \in (A.ofe_equiv_dist fp (f fp)).2 (\lam n =>
      A.ofe_dist_trans n fp (f (c n)) (f fp)
          (A.ofe_dist_le (suc n) n fp (c (suc n)) (A.cofe_conv_compl c hc (suc n)) (n<=sucn n))
          (hf n (c n) fp (\new DistLater {
            | dist_later_lt => \lam m m<n =>
                A.ofe_dist_trans m (c n) (c m) fp
                    (hc.chain_cauchy m n (LinearOrder.<_<= m<n))
                    (A.ofe_dist_sym m fp (c m) (A.cofe_conv_compl c hc m))
          })))

\lemma fixpoint_unique {A : COFE} {inh : Inhabited A.E} (f : A.E -> A.E) (hf : Contractive f)
                       (x : A.E) (hx : A.equiv x (f x)) : A.equiv x (fixpoint f hf) =>
  (A.ofe_equiv_dist x (fixpoint f hf)).2 (\lam n => fixpoint_unique_aux f hf x hx n)

  \where {
    \lemma fixpoint_unique_aux {A : COFE} {inh : Inhabited A.E} (f : A.E -> A.E) (hf : Contractive f)
                               (x : A.E) (hx : A.equiv x (f x)) (n : Nat)
      : A.dist n x (fixpoint f hf) \elim n
      | 0 =>
        \let | fp => fixpoint f hf
             | unfold_fp : A.equiv fp (f fp) => fixpoint_unfold f hf
             | hx_dist : A.dist 0 x (f x) => (A.ofe_equiv_dist x (f x)).1 hx 0
             | unfold_dist : A.dist 0 fp (f fp) => (A.ofe_equiv_dist fp (f fp)).1 unfold_fp 0
        \in A.ofe_dist_trans 0 x (f x) fp hx_dist
            (A.ofe_dist_trans 0 (f x) (f fp) fp
                (contractive_zero f hf x fp)
                (A.ofe_dist_sym 0 fp (f fp) unfold_dist))
      | suc n' =>
        \let | fp => fixpoint f hf
             | unfold_fp : A.equiv fp (f fp) => fixpoint_unfold f hf
             | ih : A.dist n' x fp => fixpoint_unique_aux f hf x hx n'
             | step : A.dist (suc n') (f x) (f fp) =>
               hf (suc n') x fp (dist_to_dist_later_suc n' x fp ih)
             | hx_dist : A.dist (suc n') x (f x) => (A.ofe_equiv_dist x (f x)).1 hx (suc n')
             | unfold_dist : A.dist (suc n') fp (f fp) =>
               (A.ofe_equiv_dist fp (f fp)).1 unfold_fp (suc n')
        \in A.ofe_dist_trans (suc n') x (f x) fp hx_dist
            (A.ofe_dist_trans (suc n') (f x) (f fp) fp step
                (A.ofe_dist_sym (suc n') fp (f fp) unfold_dist))
  }
