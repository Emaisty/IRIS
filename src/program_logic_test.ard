\import Data.Maybe
\import uPred
\import iprop
\import fupd
\import lang
\import lang_ectx
\import weakestpre
\import lifting
\import hoare
\import adequacy
\import iris_sigma
\import lib.coPset
\import lib.gFunctors
\import lib.gmap_cmra
\import lib.dfrac_cmra
\import lib.gen_heap

-- Signature-level smoke tests for the non-String A12 program-logic surface.

\lemma wp_value_test {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (v : Value) (Phi : Value -> iProp S)
  : properUPred_ent (Phi v) (wp H E (Val v) Phi) =>
  wp_value_intro H E v Phi

\lemma wp_value_elim_test {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (v : Value) (Phi : Value -> iProp S)
  : properUPred_ent (wp H E (Val v) Phi)
      (mkProperFUpd H.iris_wsat E E (Phi v)) =>
  wp_value_elim H E v Phi

\lemma wp_mono_test {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e : Expr)
    (Phi Psi : Value -> iProp S)
    (hpost : \Pi (v : Value) -> properUPred_ent (Phi v) (Psi v))
  : properUPred_ent (wp H E e Phi) (wp H E e Psi) =>
  wp_mono H E e Phi Psi hpost

\lemma wp_ready_test {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (e : Expr) (Phi : Value -> iProp S) (sigma : State cnt)
    (notVal : to_val e = nothing)
  : properUPred_ent
      (mkProperSep (wp H E e Phi) (state_interp H sigma))
      (mkProperFUpd H.iris_wsat E coPset_empty
        (mkProperAnd (mkProperPure (Reducible e sigma))
          (mkProperLater
            (wp_steps H E (wp H E) e Phi sigma)))) =>
  wp_nonval_ready H E e Phi sigma notVal

\lemma wp_step_test {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (e e2 : Expr) (Phi : Value -> iProp S)
    (sigma sigma2 : State cnt) (hstep : PrimStep e sigma e2 sigma2)
  : properUPred_ent
      (mkProperSep (wp H E e Phi) (state_interp H sigma))
      (wp_step_result H E e2 Phi sigma2) =>
  wp_prim_step H E e e2 Phi sigma sigma2 hstep

\lemma fupd_wp_test {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (e : Expr) (Phi : Value -> iProp S)
  : properUPred_ent
      (mkProperFUpd H.iris_wsat E E (wp H E e Phi))
      (wp H E e Phi) =>
  fupd_wp H E e Phi

\lemma wp_bind_test {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (K : Ectx)
    (e : Expr) (Phi : Value -> iProp S)
  : properUPred_ent
      (wp H E e (\lam v => wp H E (fill K (Val v)) Phi))
      (wp H E (fill K e) Phi) =>
  wp_bind H E K e Phi

\lemma ht_pre_test {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (P P' : iProp S) (e : Expr) (Phi : Value -> iProp S)
    (hP : properUPred_ent P' P)
  : properUPred_ent (ht H E P e Phi) (ht H E P' e Phi) =>
  ht_pre_conseq H E P P' e Phi hP

\lemma ht_conseq_test {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (P P' : iProp S) (e : Expr) (Phi Psi : Value -> iProp S)
    (hP : properUPred_ent P' P)
    (hPhi : \Pi (v : Value) -> properUPred_ent (Phi v) (Psi v))
  : properUPred_ent (ht H E P e Phi) (ht H E P' e Psi) =>
  ht_conseq H E P P' e Phi Psi hP hPhi

\lemma wp_pure_step_test {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e e' : Expr)
    (pure : \Pi (sigma : State cnt) -> PrimStep e sigma e' sigma)
    (det : \Pi (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt) ->
      PrimStep e sigma e2 sigma2 -> \Sigma (e2 = e') (sigma2 = sigma))
    (notVal : to_val e = nothing) (Phi : Value -> iProp S)
  : properUPred_ent (wp H E e' Phi) (wp H E e Phi) =>
  wp_pure_step H E e e' pure det notVal Phi

\lemma wp_load_test {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (l : Loc) (dq : Dfrac) (v : Value)
  : properUPred_ent (pointsto H.iris_gen_heap l dq v)
      (wp H E (Load (Val (LitV (LitLoc l))))
        (\lam w => mkProperAnd (mkProperPure (w = v))
          (pointsto H.iris_gen_heap l dq v))) =>
  wp_load H E l dq v

\lemma wp_store_test {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (l : Loc) (old new : Value)
  : properUPred_ent (pointsto_full H.iris_gen_heap l old)
      (wp H E (Store (Val (LitV (LitLoc l))) (Val new))
        (\lam w => mkProperAnd (mkProperPure (w = LitV LitUnit))
          (pointsto_full H.iris_gen_heap l new))) =>
  wp_store H E l old new

\lemma wp_alloc_test {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (v : Value)
  : properUPred_ent mkProperEmp
      (wp H E (Alloc (Val v))
        (\lam w => mkProperExist Loc (\lam l =>
          mkProperAnd (mkProperPure (w = LitV (LitLoc l)))
            (pointsto_full H.iris_gen_heap l v)))) =>
  wp_alloc H E v

\lemma ht_bind_ent_test {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (K : Ectx)
    (P : iProp S) (e : Expr) (Phi Psi : Value -> iProp S)
    (hK : \Pi (v : Value) -> properUPred_ent (Phi v)
      (wp H E (fill K (Val v)) Psi))
  : properUPred_ent (ht H E P e Phi)
      (ht H E P (fill K e) Psi) =>
  ht_bind_ent H E K P e Phi Psi hK

\lemma ht_alloc_test {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (v : Value)
  : properUPred_ent mkProperEmp
      (ht H E mkProperEmp (Alloc (Val v))
        (\lam w => mkProperExist Loc (\lam l =>
          mkProperAnd (mkProperPure (w = LitV (LitLoc l)))
            (pointsto_full H.iris_gen_heap l v)))) =>
  ht_alloc H E v

\lemma ht_pure_step_test {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (P : iProp S)
    (e e' : Expr)
    (pure : \Pi (sigma : State cnt) -> PrimStep e sigma e' sigma)
    (det : \Pi (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt) ->
      PrimStep e sigma e2 sigma2 -> \Sigma (e2 = e') (sigma2 = sigma))
    (notVal : to_val e = nothing) (Phi : Value -> iProp S)
  : properUPred_ent (ht H E P e' Phi) (ht H E P e Phi) =>
  ht_pure_step H E P e e' pure det notVal Phi

\lemma wp_adequacy_test {cnt : Countable Loc} {S : gFunctors}
    (Hpre : irisGpreS cnt S) (e : Expr) (phi : Value -> \Prop)
    (sigma : State cnt) (k : Nat) (v : Value) (sigma' : State cnt)
    (hwp : \Pi (H : irisGS cnt S) -> properUPred_ent mkProperEmp
      (wp H coPset_universe e (\lam w => mkProperPure (phi w))))
    (steps : Steps k e sigma (Val v) sigma')
  : phi v =>
  wp_adequacy Hpre e phi sigma k v sigma' hwp steps
