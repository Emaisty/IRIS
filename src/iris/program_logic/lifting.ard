-- The fundamental Rocq-shaped lifting rule for the masked generic WP.  A
-- concrete operational step consumes the state interpretation while the mask
-- is changed E -> empty, and returns the successor state/WP under a later and
-- the restoring update empty -> E.
\func wp_step_result {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e2 : Expr)
    (Phi : Value -> iProp S) (sigma2 : State cnt)
    (efs : List Expr) (futureObservations : List Observation) : iProp S =>
  mkProperFUpd H.iris_wsat E coPset_empty
    (|>
      (mkProperFUpd H.iris_wsat coPset_empty E
        ((state_interp H sigma2 futureObservations) ∗
          ((WP H E e2 Phi) ∗
            (wp_forks H.iris_fork_post (wp H) efs)))))

-- Expose the non-value branch of WP after supplying the physical state.  This
-- is the generic analogue of the "step-ready" fact used by adequacy: before a
-- concrete successor is selected, WP already guarantees reducibility and all
-- successor obligations under the E -> empty mask change.
\lemma wp_nonval_ready {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (e : Expr) (Phi : Value -> iProp S) (sigma : State cnt)
    (observations futureObservations : List Observation)
    (notVal : to_val e = nothing)
  : ((WP H E e Phi) ∗
        (state_interp H sigma (observations ++ futureObservations))) ⊢
      (mkProperFUpd H.iris_wsat E coPset_empty
        ((mkProperPure (Reducible e sigma)) ∧
          (|>
            (wp_steps H E (wp H) e Phi sigma observations futureObservations)))) =>
  \lam n a ha hsep =>
  \let M => iResUR S
  \in \scase hsep \with {
    | inP (a_wp, a_state, da, hwp, hstate) =>
      \let
        | ha_parts : M.validN n (M.op a_wp a_state) =>
            M.cmra_validN_ne n a (M.op a_wp a_state) da ha
        | ha_wp : M.validN n a_wp => M.cmra_validN_op_l n a_wp a_state ha_parts
        | unfolded : (wp_pre H (wp H) E e Phi).upred_holds n a_wp =>
            (wp_unfold H E e Phi n a_wp ha_wp).1 hwp
        | nonval : (wp_nonval H E (wp H) e Phi).upred_holds n a_wp =>
            transport
              (\lam tv => (wp_pre_body H E (wp H) e Phi tv)
                .upred_holds n a_wp)
              notVal unfolded
        | onParts : (mkProperFUpd H.iris_wsat E coPset_empty
            ((mkProperPure (Reducible e sigma)) ∧
              (|>
                (wp_steps H E (wp H) e Phi sigma observations futureObservations))))
            .upred_holds n (M.op a_wp a_state) =>
            nonval sigma observations futureObservations n <=-refl a_state ha_parts hstate
        | daUnit : M.dist n a (M.op (M.op a_wp a_state) M.unit) =>
            M.ofe_dist_trans n a (M.op a_wp a_state)
              (M.op (M.op a_wp a_state) M.unit) da
              (M.ofe_dist_sym n (M.op (M.op a_wp a_state) M.unit)
                (M.op a_wp a_state)
                (ucmra_unit_right_id_dist {M} n (M.op a_wp a_state)))
      \in (mkProperFUpd H.iris_wsat E coPset_empty
            ((mkProperPure (Reducible e sigma)) ∧
              (|>
                (wp_steps H E (wp H) e Phi sigma observations futureObservations))))
          .upred_mono n n (M.op a_wp a_state) a onParts
            (inP (M.unit, daUnit)) <=-refl
  }

\lemma wp_reducible {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (e : Expr) (Phi : Value -> iProp S) (sigma : State cnt)
    (observations futureObservations : List Observation)
    (notVal : to_val e = nothing)
  : ((WP H E e Phi) ∗
        (state_interp H sigma (observations ++ futureObservations))) ⊢
      (mkProperFUpd H.iris_wsat E coPset_empty
        (mkProperPure (Reducible e sigma))) =>
  properUPred_ent_trans
    ((WP H E e Phi) ∗
      (state_interp H sigma (observations ++ futureObservations)))
    (mkProperFUpd H.iris_wsat E coPset_empty
      ((mkProperPure (Reducible e sigma)) ∧
        (|>
          (wp_steps H E (wp H) e Phi sigma observations futureObservations))))
    (mkProperFUpd H.iris_wsat E coPset_empty
      (mkProperPure (Reducible e sigma)))
    (wp_nonval_ready H E e Phi sigma observations futureObservations notVal)
    (fupd_mono H.iris_wsat E coPset_empty
      ((mkProperPure (Reducible e sigma)) ∧
        (|>
          (wp_steps H E (wp H) e Phi sigma observations futureObservations)))
      (mkProperPure (Reducible e sigma))
      (\lam _ _ _ h => h.1))

\lemma wp_prim_step {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (e e2 : Expr) (Phi : Value -> iProp S)
    (sigma sigma2 : State cnt) (efs : List Expr)
    (observations futureObservations : List Observation)
    (hstep : PrimStep e sigma e2 sigma2 efs observations)
  : ((WP H E e Phi) ∗
        (state_interp H sigma (observations ++ futureObservations))) ⊢
      (wp_step_result H E e2 Phi sigma2 efs futureObservations) =>
  \lam n a ha hsep =>
  \let M => iResUR S
  \in \scase hsep \with {
    | inP (a_wp, a_state, da, hwp, hstate) =>
      \let
        | notVal : to_val e = nothing =>
            val_stuck e sigma e2 sigma2 efs observations hstep
        | ha_parts : M.validN n (M.op a_wp a_state) =>
            M.cmra_validN_ne n a (M.op a_wp a_state) da ha
        | ha_wp : M.validN n a_wp => M.cmra_validN_op_l n a_wp a_state ha_parts
        | unfolded : (wp_pre H (wp H) E e Phi).upred_holds n a_wp =>
            (wp_unfold H E e Phi n a_wp ha_wp).1 hwp
        | nonval : (wp_nonval H E (wp H) e Phi).upred_holds n a_wp =>
            transport
              (\lam tv => (wp_pre_body H E (wp H) e Phi tv)
                .upred_holds n a_wp)
              notVal unfolded
        | onParts : (mkProperFUpd H.iris_wsat E coPset_empty
            ((mkProperPure (Reducible e sigma)) ∧
              (|>
                (wp_steps H E (wp H) e Phi sigma observations futureObservations))))
            .upred_holds n (M.op a_wp a_state) =>
            nonval sigma observations futureObservations n <=-refl a_state ha_parts hstate
        | daUnit : M.dist n a (M.op (M.op a_wp a_state) M.unit) =>
            M.ofe_dist_trans n a (M.op a_wp a_state)
              (M.op (M.op a_wp a_state) M.unit) da
              (M.ofe_dist_sym n (M.op (M.op a_wp a_state) M.unit)
                (M.op a_wp a_state)
                (ucmra_unit_right_id_dist {M} n (M.op a_wp a_state)))
        | onA : (mkProperFUpd H.iris_wsat E coPset_empty
            ((mkProperPure (Reducible e sigma)) ∧
              (|>
                (wp_steps H E (wp H) e Phi sigma observations futureObservations))))
            .upred_holds n a =>
            (mkProperFUpd H.iris_wsat E coPset_empty
              ((mkProperPure (Reducible e sigma)) ∧
                (|>
                  (wp_steps H E (wp H) e Phi sigma observations futureObservations))))
              .upred_mono n n (M.op a_wp a_state) a onParts
                (inP (M.unit, daUnit)) <=-refl
        | core => (mkProperPure (Reducible e sigma)) ∧
            (|>
              (wp_steps H E (wp H) e Phi sigma observations futureObservations))
        | target => |>
            (mkProperFUpd H.iris_wsat coPset_empty E
              ((state_interp H sigma2 futureObservations) ∗
                ((WP H E e2 Phi) ∗
                  (wp_forks H.iris_fork_post (wp H) efs))))
      \in fupd_mono H.iris_wsat E coPset_empty core target
        (\lam n' x hx hand =>
          \case n' \as k, hx \as hx' : M.validN k x,
              hand \as hand' : core.upred_holds k x
            \return target.upred_holds k x
          \with {
            | 0, _, _ => ()
            | suc k, hx', hand' =>
              \let hsteps : (wp_steps H E (wp H) e Phi sigma observations futureObservations)
                    .upred_holds k x => hand'.2
              \in hsteps e2 sigma2 efs k <=-refl x
                (inP (M.unit,
                  M.ofe_dist_sym k (M.op x M.unit) x
                    (ucmra_unit_right_id_dist {M} k x)))
                (M.cmra_validN_le (suc k) k x hx' (n<=sucn k))
                hstep
          }) n a ha onA
  }

-- A same-mask fancy update in front of WP can be absorbed by WP.  In the
-- non-value branch the update is framed with the physical state, then
-- composed with the ordinary step-readiness rule.  This is Rocq Iris'
-- `fupd_wp`, stated directly for the concrete uPred model.
\lemma fupd_wp_pre {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (e : Expr) (Phi : Value -> iProp S)
    (tv : Maybe Value) (peq : to_val e = tv)
    (n : Nat) (x : iResUR S) (hx : (iResUR S).validN n x)
    (hf : (mkProperFUpd H.iris_wsat E E (WP H E e Phi)).upred_holds n x)
  : (wp_pre_body H E (wp H) e Phi tv).upred_holds n x
  \elim tv
        | just v =>
          \let
            | nested : (mkProperFUpd H.iris_wsat E E
                (mkProperFUpd H.iris_wsat E E (Phi v)))
                .upred_holds n x =>
                fupd_mono H.iris_wsat E E
                  (WP H E e Phi)
                  (mkProperFUpd H.iris_wsat E E (Phi v))
                  (\lam k a ha hwp =>
                    transport
                      (\lam ee => (WP H E ee Phi).upred_holds k a ->
                        (mkProperFUpd H.iris_wsat E E (Phi v)).upred_holds k a)
                      (of_to_val e v peq)
                      (\lam hval => wp_value_elim H E v Phi k a ha hval)
                      hwp)
                  n x hx hf
          \in fupd_trans H.iris_wsat E E E (Phi v) n x hx nested
        | nothing =>
          \let
            | Core : State cnt -> List Observation -> List Observation -> iProp S =>
              \lam sigma observations futureObservations =>
                (mkProperPure (Reducible e sigma)) ∧
                  (|>
                    (wp_steps H E (wp H) e Phi sigma observations futureObservations))
            | ready : \Pi (sigma : State cnt)
                (observations futureObservations : List Observation) -> ((WP H E e Phi) ∗
                  (state_interp H sigma (observations ++ futureObservations))) ⊢
                (mkProperFUpd H.iris_wsat E coPset_empty
                  (Core sigma observations futureObservations)) =>
                \lam sigma observations futureObservations =>
                  wp_nonval_ready H E e Phi sigma observations futureObservations peq
            | absorb : \Pi (sigma : State cnt)
                (observations futureObservations : List Observation) -> ((mkProperFUpd H.iris_wsat E E (WP H E e Phi)) ∗
                  (state_interp H sigma (observations ++ futureObservations))) ⊢
                (mkProperFUpd H.iris_wsat E coPset_empty
                  (Core sigma observations futureObservations)) =>
                \lam sigma observations futureObservations => properUPred_ent_trans
                  ((mkProperFUpd H.iris_wsat E E (WP H E e Phi)) ∗
                    (state_interp H sigma (observations ++ futureObservations)))
                  (mkProperFUpd H.iris_wsat E E
                    ((WP H E e Phi) ∗
                      (state_interp H sigma (observations ++ futureObservations))))
                  (mkProperFUpd H.iris_wsat E coPset_empty
                    (Core sigma observations futureObservations))
                  (fupd_frame_r H.iris_wsat E E
                    (WP H E e Phi)
                    (state_interp H sigma (observations ++ futureObservations)))
                  (properUPred_ent_trans
                    (mkProperFUpd H.iris_wsat E E
                      ((WP H E e Phi) ∗
                        (state_interp H sigma (observations ++ futureObservations))))
                    (mkProperFUpd H.iris_wsat E E
                      (mkProperFUpd H.iris_wsat E coPset_empty
                        (Core sigma observations futureObservations)))
                    (mkProperFUpd H.iris_wsat E coPset_empty
                      (Core sigma observations futureObservations))
                    (fupd_mono H.iris_wsat E E
                      ((WP H E e Phi) ∗
                        (state_interp H sigma (observations ++ futureObservations)))
                      (mkProperFUpd H.iris_wsat E coPset_empty
                        (Core sigma observations futureObservations))
                      (ready sigma observations futureObservations))
                    (fupd_trans H.iris_wsat E E coPset_empty
                      (Core sigma observations futureObservations)))
          \in \lam sigma observations futureObservations m mle frame hop hstate =>
                absorb sigma observations futureObservations
                  m ((iResUR S).op x frame) hop
                  (inP (x, frame,
                    (iResUR S).ofe_dist_refl m
                      ((iResUR S).op x frame),
                    (mkProperFUpd H.iris_wsat E E (WP H E e Phi))
                      .upred_mono n m x x hf
                        (inclN_refl_ucmra {iResUR S} m x) mle,
                    hstate))

\lemma fupd_wp {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (e : Expr) (Phi : Value -> iProp S)
  : (mkProperFUpd H.iris_wsat E E (WP H E e Phi)) ⊢
      (WP H E e Phi) =>
  \lam n x hx hf =>
  \let hpre => fupd_wp_pre H E e Phi (to_val e) idp n x hx hf
  \in (wp_unfold H E e Phi n x hx).2 hpre

-- Open an invariant around a strongly atomic expression.  The client-facing
-- premise receives the later invariant body, its close continuation, and an
-- arbitrary frame; `wp_atomic` handles the two mask changes.
\lemma wp_atomic_inv_acc {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (N : Namespace)
    (P K : iProp S) (e : Expr) (Phi : Value -> iProp S)
    (hNE : coPSubset (nclose N) E)
    (atomic : StronglyAtomic {cnt} e)
    (opened : (((|> P) ∗
          ((|> P) -∗
            (mkProperFUpd H.iris_wsat
              (coPset_difference E (nclose N)) E mkProperEmp))) ∗ K) ⊢
      (WP H (coPset_difference E (nclose N)) e
        (\lam v => mkProperFUpd H.iris_wsat
          (coPset_difference E (nclose N)) E (Phi v)))) :
  ((iris.base_logic.lib.invariants.inv H.iris_wsat N P) ∗ K) ⊢
    (WP H E e Phi) =>
  \let
    | D => coPset_difference E (nclose N)
    | OpenBody => (|> P) ∗
        ((|> P) -∗
          (mkProperFUpd H.iris_wsat D E mkProperEmp))
    | WPInner => WP H D e
        (\lam v => mkProperFUpd H.iris_wsat D E (Phi v))
    | access : ((iris.base_logic.lib.invariants.inv H.iris_wsat N P) ∗ K) ⊢
        (mkProperFUpd H.iris_wsat E D
          (OpenBody ∗ K)) =>
        properUPred_ent_trans
          ((iris.base_logic.lib.invariants.inv H.iris_wsat N P) ∗ K)
          ((mkProperFUpd H.iris_wsat E D OpenBody) ∗ K)
          (mkProperFUpd H.iris_wsat E D
            (OpenBody ∗ K))
          (sep_mono_l_ent
            (iris.base_logic.lib.invariants.inv H.iris_wsat N P)
            (mkProperFUpd H.iris_wsat E D OpenBody) K
            (inv_acc H.iris_wsat E N P hNE))
          (fupd_frame_r H.iris_wsat E D OpenBody K)
  \in properUPred_ent_trans
      ((iris.base_logic.lib.invariants.inv H.iris_wsat N P) ∗ K)
      (mkProperFUpd H.iris_wsat E D WPInner)
      (WP H E e Phi)
      (properUPred_ent_trans
        ((iris.base_logic.lib.invariants.inv H.iris_wsat N P) ∗ K)
        (mkProperFUpd H.iris_wsat E D (OpenBody ∗ K))
        (mkProperFUpd H.iris_wsat E D WPInner) access
        (fupd_mono H.iris_wsat E D
          (OpenBody ∗ K) WPInner opened))
      (wp_atomic H E D e Phi atomic)

-- Open an invariant whose body is split into one timeless component needed
-- for reducibility and a delayed transition frame.  `fupd_except_0` removes
-- the zero-index exception before `wp_atomic` exposes the inner WP.  This is
-- the term-mode form of Rocq's `iInv ... as (>Hnow & Hlater)` pattern.
\lemma wp_atomic_inv_acc_timeless_frame {cnt : Countable Loc}
    {S : gFunctors} (H : irisGS cnt S) (E : coPset) (N : Namespace)
    (P Rnow Rafter K : iProp S) (e : Expr) (Phi : Value -> iProp S)
    (hNE : coPSubset (nclose N) E)
    (atomic : StronglyAtomic {cnt} e)
    (hNow : Timeless Rnow)
    (split : P ⊢ (Rnow ∗ Rafter))
    (opened : (((Rnow ∗ (|> Rafter)) ∗
          ((|> P) -∗
            (mkProperFUpd H.iris_wsat
              (coPset_difference E (nclose N)) E mkProperEmp))) ∗ K) ⊢
      (WP H (coPset_difference E (nclose N)) e
        (\lam v => mkProperFUpd H.iris_wsat
          (coPset_difference E (nclose N)) E (Phi v)))) :
  ((iris.base_logic.lib.invariants.inv H.iris_wsat N P) ∗ K) ⊢
    (WP H E e Phi) =>
  \let
    | D => coPset_difference E (nclose N)
    | Close => (|> P) -∗
        (mkProperFUpd H.iris_wsat D E mkProperEmp)
    | Access => ((|> P) ∗ Close) ∗ K
    | Client => ((Rnow ∗ (|> Rafter)) ∗ Close) ∗ K
    | WPInner => WP H D e
        (\lam v => mkProperFUpd H.iris_wsat D E (Phi v))
    | laterSplit : (|> P) ⊢
        ((|> Rnow) ∗ (|> Rafter)) =>
        properUPred_ent_trans (|> P)
          (|> (Rnow ∗ Rafter))
          ((|> Rnow) ∗ (|> Rafter))
          (proper_later_mono P (Rnow ∗ Rafter) split)
          (proper_later_sep_1 Rnow Rafter)
    | nowExcept : (|> P) ⊢
        ((<except_0> Rnow) ∗ (|> Rafter)) =>
        properUPred_ent_trans (|> P)
          ((|> Rnow) ∗ (|> Rafter))
          ((<except_0> Rnow) ∗ (|> Rafter))
          laterSplit
          (sep_mono_l_ent (|> Rnow)
            (<except_0> Rnow) (|> Rafter) hNow)
    | accessToExcept : Access ⊢
        (<except_0> Client) =>
        \lam n x hx h =>
          \let
            | staged : ((((<except_0> Rnow) ∗
                    (|> Rafter)) ∗ Close) ∗ K).upred_holds n x =>
                sep_mono_l_ent
                  ((|> P) ∗ Close)
                  (((<except_0> Rnow) ∗
                      (|> Rafter)) ∗ Close) K
                  (sep_mono_l_ent (|> P)
                    ((<except_0> Rnow) ∗
                      (|> Rafter)) Close nowExcept)
                  n x hx h
            | e1 : ((((<except_0> Rnow) ∗
                      (|> Rafter)) ∗ Close) ∗ K) ⊢
                (((<except_0>
                      (Rnow ∗ (|> Rafter))) ∗ Close) ∗ K) =>
                sep_mono_l_ent
                  (((<except_0> Rnow) ∗
                      (|> Rafter)) ∗ Close)
                  ((<except_0>
                      (Rnow ∗ (|> Rafter))) ∗ Close) K
                  (sep_mono_l_ent
                    ((<except_0> Rnow) ∗ (|> Rafter))
                    (<except_0>
                      (Rnow ∗ (|> Rafter))) Close
                    (except_zero_frame_r Rnow (|> Rafter)))
            | e2 : (((<except_0>
                      (Rnow ∗ (|> Rafter))) ∗ Close) ∗ K) ⊢
                ((<except_0>
                    ((Rnow ∗ (|> Rafter)) ∗ Close)) ∗ K) =>
                sep_mono_l_ent
                  ((<except_0>
                      (Rnow ∗ (|> Rafter))) ∗ Close)
                  (<except_0>
                    ((Rnow ∗ (|> Rafter)) ∗ Close)) K
                  (except_zero_frame_r
                    (Rnow ∗ (|> Rafter)) Close)
          \in except_zero_frame_r
              ((Rnow ∗ (|> Rafter)) ∗ Close) K
              n x hx (e2 n x hx (e1 n x hx staged))
    | access : ((iris.base_logic.lib.invariants.inv H.iris_wsat N P) ∗ K) ⊢
        (mkProperFUpd H.iris_wsat E D Access) =>
        properUPred_ent_trans
          ((iris.base_logic.lib.invariants.inv H.iris_wsat N P) ∗ K)
          ((mkProperFUpd H.iris_wsat E D
              ((|> P) ∗ Close)) ∗ K)
          (mkProperFUpd H.iris_wsat E D Access)
          (sep_mono_l_ent
            (iris.base_logic.lib.invariants.inv H.iris_wsat N P)
            (mkProperFUpd H.iris_wsat E D
              ((|> P) ∗ Close)) K
            (inv_acc H.iris_wsat E N P hNE))
          (fupd_frame_r H.iris_wsat E D
            ((|> P) ∗ Close) K)
    | openedExcept : Access ⊢
        (<except_0> WPInner) =>
        properUPred_ent_trans Access
          (<except_0> Client)
          (<except_0> WPInner) accessToExcept
          (except_zero_mono Client WPInner opened)
  \in properUPred_ent_trans
      ((iris.base_logic.lib.invariants.inv H.iris_wsat N P) ∗ K)
      (mkProperFUpd H.iris_wsat E D WPInner)
      (WP H E e Phi)
      (properUPred_ent_trans
        ((iris.base_logic.lib.invariants.inv H.iris_wsat N P) ∗ K)
        (mkProperFUpd H.iris_wsat E D Access)
        (mkProperFUpd H.iris_wsat E D WPInner) access
        (properUPred_ent_trans
          (mkProperFUpd H.iris_wsat E D Access)
          (mkProperFUpd H.iris_wsat E D
            (<except_0> WPInner))
          (mkProperFUpd H.iris_wsat E D WPInner)
          (fupd_mono H.iris_wsat E D Access
            (<except_0> WPInner) openedExcept)
          (fupd_except_0 H.iris_wsat E D WPInner)))
      (wp_atomic H E D e Phi atomic)

\func inv_exist_pair {S : gFunctors} {T : \Set0}
    (Rnow Rafter : T -> iProp S) (t : T) : iProp S =>
  (Rnow t) ∗ (Rafter t)

\func inv_exist_choice {S : gFunctors} {T : \Set0}
    (Rnow Rafter : T -> iProp S) : iProp S =>
  (|> (mkProperPure Empty)) ∨
    (mkProperExist T (\lam t => |>
      (inv_exist_pair Rnow Rafter t)))

\func inv_exist_access {S : gFunctors} (P Close K : iProp S) : iProp S =>
  ((|> P) ∗ Close) ∗ K

\func inv_exist_staged {S : gFunctors} {T : \Set0}
    (Rnow Rafter : T -> iProp S) (Close K : iProp S) : iProp S =>
  ((inv_exist_choice Rnow Rafter) ∗ Close) ∗ K

\func inv_exist_client {S : gFunctors} {T : \Set0}
    (Rnow Rafter : T -> iProp S) (Close K : iProp S) (t : T) : iProp S =>
  (((Rnow t) ∗ (|> (Rafter t))) ∗ Close) ∗ K

\lemma inv_exist_opened_except_suc {S : gFunctors} {T : \Set0}
    (Rnow Rafter : T -> iProp S) (Close K Q : iProp S)
    (hNow : \Pi (t : T) -> Timeless (Rnow t))
    (opened : \Pi (t : T) -> (inv_exist_client Rnow Rafter Close K t) ⊢ Q)
    (k : Nat) (x : (iResUR S).E) (hx : (iResUR S).validN (suc k) x)
    (hstaged : (inv_exist_staged Rnow Rafter Close K)
      .upred_holds (suc k) x) : Q.upred_holds (suc k) x =>
  \case hstaged \with {
    | inP (xlc, xk, dx, hlc, hK) => \case hlc \with {
      | inP (xo, xc, dlc, hor, hclose) => \case hor \with {
        | byLeft impossible => absurd impossible
        | byRight hex => \case hex \with {
          | inP (t, hlaterPair) =>
            \let
              | xoValid : (iResUR S).validN (suc k) xo =>
                  validN_sub_l {iResUR S} (suc k) xlc xo xc
                    (validN_sub_l {iResUR S} (suc k) x xlc xk
                      hx dx) dlc
              | laterParts : ((|> (Rnow t)) ∗
                  (|> (Rafter t))).upred_holds
                  (suc k) xo =>
                  proper_later_sep_1 (Rnow t) (Rafter t)
                    (suc k) xo xoValid hlaterPair
            \in \case laterParts \with {
              | inP (xn, xa, dparts, hnLater, haLater) =>
                \let
                  | xnValid : (iResUR S).validN (suc k) xn =>
                      validN_sub_l {iResUR S} (suc k) xo xn xa
                        xoValid dparts
                  | hnExcept : (<except_0> (Rnow t))
                      .upred_holds (suc k) xn =>
                      hNow t (suc k) xn xnValid hnLater
                \in \case hnExcept \with {
                  | byLeft impossible => absurd impossible
                  | byRight hn => opened t (suc k) x hx
                      (inP (xlc, xk, dx,
                        inP (xo, xc, dlc,
                          inP (xn, xa, dparts, hn, haLater),
                          hclose), hK))
                }
            }
        }
      }
    }
  }

\lemma inv_exist_opened_except_at {S : gFunctors} {T : \Set0}
    (P : iProp S) (Rnow Rafter : T -> iProp S)
    (Close K Q : iProp S)
    (hNow : \Pi (t : T) -> Timeless (Rnow t))
    (staged : (inv_exist_access P Close K) ⊢
      (inv_exist_staged Rnow Rafter Close K))
    (opened : \Pi (t : T) -> (inv_exist_client Rnow Rafter Close K t) ⊢ Q)
    (n : Nat) (x : (iResUR S).E) (hx : (iResUR S).validN n x)
    (haccess : (inv_exist_access P Close K).upred_holds n x) :
  (<except_0> Q).upred_holds n x \elim n, hx, haccess
  | 0, _, _ => byLeft ()
  | suc k, hxk, hk => byRight
      (inv_exist_opened_except_suc Rnow Rafter Close K Q hNow opened
        k x hxk (staged (suc k) x hxk hk))

\lemma inv_exist_opened_except {S : gFunctors} {T : \Set0}
    (P : iProp S) (Rnow Rafter : T -> iProp S)
    (Close K Q : iProp S)
    (hNow : \Pi (t : T) -> Timeless (Rnow t))
    (staged : (inv_exist_access P Close K) ⊢
      (inv_exist_staged Rnow Rafter Close K))
    (opened : \Pi (t : T) -> (inv_exist_client Rnow Rafter Close K t) ⊢ Q) :
  (inv_exist_access P Close K) ⊢
    (<except_0> Q) =>
  \lam n x hx haccess => inv_exist_opened_except_at
    P Rnow Rafter Close K Q hNow staged opened n x hx haccess

-- Dependent form of `wp_atomic_inv_acc_timeless_frame`.  The invariant may
-- choose witnesses (array contents, request map, focused index decomposition)
-- when it is opened; the timeless component and delayed frame are tied to the
-- same witness, which is essential for array invariants.
\lemma wp_atomic_inv_acc_timeless_exist_frame {cnt : Countable Loc}
    {S : gFunctors} {T : \Set0}
    (H : irisGS cnt S) (E : coPset) (N : Namespace)
    (P : iProp S) (Rnow Rafter : T -> iProp S) (K : iProp S)
    (e : Expr) (Phi : Value -> iProp S)
    (hNE : coPSubset (nclose N) E)
    (atomic : StronglyAtomic {cnt} e)
    (hNow : \Pi (t : T) -> Timeless (Rnow t))
    (split : P ⊢
      (mkProperExist T (\lam t => (Rnow t) ∗ (Rafter t))))
    (opened : \Pi (t : T) -> ((((Rnow t) ∗ (|> (Rafter t))) ∗
          ((|> P) -∗
            (mkProperFUpd H.iris_wsat
              (coPset_difference E (nclose N)) E mkProperEmp))) ∗ K) ⊢
      (WP H (coPset_difference E (nclose N)) e
        (\lam v => mkProperFUpd H.iris_wsat
          (coPset_difference E (nclose N)) E (Phi v)))) :
  ((iris.base_logic.lib.invariants.inv H.iris_wsat N P) ∗ K) ⊢
    (WP H E e Phi) =>
  \let
    | D => coPset_difference E (nclose N)
    | Close => (|> P) -∗
        (mkProperFUpd H.iris_wsat D E mkProperEmp)
    | Access => ((|> P) ∗ Close) ∗ K
    | PairF : T -> iProp S => \lam t =>
        (Rnow t) ∗ (Rafter t)
    | LaterPairF : T -> iProp S => \lam t =>
        |> (PairF t)
    | Bad => |> (mkProperPure {iResUR S} Empty)
    | Choices => mkProperExist T LaterPairF
    | ChoiceOr => Bad ∨ Choices
    | WPInner => WP H D e
        (\lam v => mkProperFUpd H.iris_wsat D E (Phi v))
    | exposeChoice : (|> P) ⊢ ChoiceOr =>
        properUPred_ent_trans (|> P)
          (|> (mkProperExist T PairF)) ChoiceOr
          (proper_later_mono P (mkProperExist T PairF) split)
          (proper_later_exist_false PairF)
    | exposeInClose : ((|> P) ∗ Close) ⊢
        (ChoiceOr ∗ Close) =>
        sep_mono_l_ent (|> P) ChoiceOr Close exposeChoice
    | staged : Access ⊢
        ((ChoiceOr ∗ Close) ∗ K) =>
        sep_mono_l_ent ((|> P) ∗ Close)
          (ChoiceOr ∗ Close) K exposeInClose
    | openedExcept : Access ⊢
        (<except_0> WPInner) =>
        inv_exist_opened_except P Rnow Rafter Close K WPInner
          hNow staged opened
    | access : ((iris.base_logic.lib.invariants.inv H.iris_wsat N P) ∗ K) ⊢
        (mkProperFUpd H.iris_wsat E D Access) =>
        properUPred_ent_trans
          ((iris.base_logic.lib.invariants.inv H.iris_wsat N P) ∗ K)
          ((mkProperFUpd H.iris_wsat E D
              ((|> P) ∗ Close)) ∗ K)
          (mkProperFUpd H.iris_wsat E D Access)
          (sep_mono_l_ent
            (iris.base_logic.lib.invariants.inv H.iris_wsat N P)
            (mkProperFUpd H.iris_wsat E D
              ((|> P) ∗ Close)) K
            (inv_acc H.iris_wsat E N P hNE))
          (fupd_frame_r H.iris_wsat E D
            ((|> P) ∗ Close) K)
  \in properUPred_ent_trans
      ((iris.base_logic.lib.invariants.inv H.iris_wsat N P) ∗ K)
      (mkProperFUpd H.iris_wsat E D WPInner)
      (WP H E e Phi)
      (properUPred_ent_trans
        ((iris.base_logic.lib.invariants.inv H.iris_wsat N P) ∗ K)
        (mkProperFUpd H.iris_wsat E D Access)
        (mkProperFUpd H.iris_wsat E D WPInner) access
        (properUPred_ent_trans
          (mkProperFUpd H.iris_wsat E D Access)
          (mkProperFUpd H.iris_wsat E D
            (<except_0> WPInner))
          (mkProperFUpd H.iris_wsat E D WPInner)
          (fupd_mono H.iris_wsat E D Access
            (<except_0> WPInner) openedExcept)
          (fupd_except_0 H.iris_wsat E D WPInner)))
      (wp_atomic H E D e Phi atomic)

-- Evaluation-context postcondition used by `wp_bind`.
\func wp_bind_post {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (K : Ectx)
    (Phi : Value -> iProp S) : Value -> iProp S =>
  \lam v => WP H E (fill K (Val v)) Phi

\func wp_bind_pre_zero {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (K : Ectx)
    (e : Expr) (Phi : Value -> iProp S)
    (tv : Maybe Value) (peq : to_val e = tv)
    (x : iResUR S) (hx : (iResUR S).validN 0 x)
    (hp : (wp_pre_body H E (wp H) e
      (wp_bind_post H E K Phi) tv).upred_holds 0 x)
  : (wp_pre H (wp H) E (fill K e) Phi).upred_holds 0 x
  \elim tv
  | just v =>
    \let
      | hwp : (WP H E (fill K (Val v)) Phi).upred_holds 0 x =>
          fupd_wp H E (fill K (Val v)) Phi 0 x hx hp
      | e_eq : Val v = e => of_to_val e v peq
      | fill_eq : fill K (Val v) = fill K e =>
          pmap (\lam ee => fill K ee) e_eq
    \in transport
      (\lam ee => (wp_pre H (wp H) E ee Phi).upred_holds 0 x)
      fill_eq
      ((wp_unfold H E (fill K (Val v)) Phi 0 x hx).1 hwp)
  | nothing =>
    \let
      | no_fill : to_val (fill K e) = nothing => fill_not_val K e peq
      | SrcCore : State cnt -> List Observation -> List Observation -> iProp S =>
        \lam sigma observations futureObservations =>
          (mkProperPure (Reducible e sigma)) ∧
            (|>
              (wp_steps H E (wp H) e
                (wp_bind_post H E K Phi) sigma observations futureObservations))
      | TgtCore : State cnt -> List Observation -> List Observation -> iProp S =>
        \lam sigma observations futureObservations =>
          (mkProperPure (Reducible (fill K e) sigma)) ∧
            (|>
              (wp_steps H E (wp H) (fill K e) Phi sigma observations futureObservations))
      | core_map : \Pi (sigma : State cnt)
          (observations futureObservations : List Observation) ->
          properUPred_ent_at 0 (SrcCore sigma observations futureObservations)
            (TgtCore sigma observations futureObservations) =>
          \lam sigma observations futureObservations r r_le_0 a ha hcore =>
            \case \elim r, r_le_0, ha, hcore \with {
              | 0, _, _, hcore0 =>
                (reducible_fill K e sigma hcore0.1, ())
              | suc r', le, _, _ => absurd (le NatOrder.zero<suc)
            }
      | target_none : (wp_pre_body H E (wp H)
          (fill K e) Phi nothing).upred_holds 0 x =>
          \lam sigma observations futureObservations m m_le_0 frame hx_frame hstate =>
            fupd_mono_at H.iris_wsat 0 E coPset_empty
              (SrcCore sigma observations futureObservations)
              (TgtCore sigma observations futureObservations)
              (core_map sigma observations futureObservations)
              m m_le_0 ((iResUR S).op x frame) hx_frame
              (hp sigma observations futureObservations
                m m_le_0 frame hx_frame hstate)
    \in transport
      (\lam tv' => (wp_pre_body H E (wp H)
        (fill K e) Phi tv').upred_holds 0 x)
      (inv no_fill) target_none

\func wp_bind_pre_step {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (K : Ectx)
    (e : Expr) (Phi : Value -> iProp S) (n : Nat)
    (tv : Maybe Value) (peq : to_val e = tv)
    (x : iResUR S) (hx : (iResUR S).validN (suc n) x)
    (hp : (wp_pre_body H E (wp H) e
      (wp_bind_post H E K Phi) tv).upred_holds (suc n) x)
    (ih : \Pi (k : Nat) -> k <= n -> \Pi (e' : Expr) (a : iResUR S) ->
      (iResUR S).validN k a ->
      (WP H E e' (wp_bind_post H E K Phi)).upred_holds k a ->
      (WP H E (fill K e') Phi).upred_holds k a)
  : (wp_pre H (wp H) E (fill K e) Phi)
      .upred_holds (suc n) x
  \elim tv
  | just v =>
    \let
      | hwp : (WP H E (fill K (Val v)) Phi).upred_holds (suc n) x =>
          fupd_wp H E (fill K (Val v)) Phi (suc n) x hx hp
      | e_eq : Val v = e => of_to_val e v peq
      | fill_eq : fill K (Val v) = fill K e =>
          pmap (\lam ee => fill K ee) e_eq
    \in transport
      (\lam ee => (wp_pre H (wp H) E ee Phi)
        .upred_holds (suc n) x)
      fill_eq
      ((wp_unfold H E (fill K (Val v)) Phi (suc n) x hx).1 hwp)
  | nothing =>
    \let
      | M => iResUR S
      | no_fill : to_val (fill K e) = nothing => fill_not_val K e peq
      | SrcCore : State cnt -> List Observation -> List Observation -> iProp S =>
        \lam sigma observations futureObservations =>
          (mkProperPure (Reducible e sigma)) ∧
            (|>
              (wp_steps H E (wp H) e
                (wp_bind_post H E K Phi) sigma observations futureObservations))
      | TgtCore : State cnt -> List Observation -> List Observation -> iProp S =>
        \lam sigma observations futureObservations =>
          (mkProperPure (Reducible (fill K e) sigma)) ∧
            (|>
              (wp_steps H E (wp H) (fill K e) Phi sigma observations futureObservations))
      | core_map : \Pi (sigma : State cnt)
          (observations futureObservations : List Observation) ->
          properUPred_ent_at (suc n) (SrcCore sigma observations futureObservations)
            (TgtCore sigma observations futureObservations) =>
          \lam sigma observations futureObservations r r_le_sn a ha hcore =>
            \case \elim r, r_le_sn, ha, hcore \with {
              | 0, _, _, hcore0 =>
                (reducible_fill K e sigma hcore0.1, ())
              | suc r', r_le_sn', ha', hcore' =>
                \let
                  | r'_le_n : r' <= n => suc<=suc.conv r_le_sn'
                  | source_steps : (wp_steps H E (wp H) e
                      (wp_bind_post H E K Phi) sigma observations futureObservations)
                      .upred_holds r' a => hcore'.2
                  | target_steps : (wp_steps H E (wp H)
                      (fill K e) Phi sigma observations futureObservations)
                      .upred_holds r' a =>
                      \lam e2 sigma2 efs j j_le_r' c incl_c hc hstep_fill =>
                        \case fill_step_inv K e sigma e2 sigma2 efs observations
                            peq hstep_fill \with {
                          | inP (e2', e2_eq, hstep_inner) =>
                            \let
                              | source_result : (mkProperFUpd H.iris_wsat
                                  coPset_empty E
                                  ((state_interp H sigma2 futureObservations) ∗
                                    ((WP H E e2'
                                        (wp_bind_post H E K Phi)) ∗
                                      (wp_forks H.iris_fork_post
                                        (wp H) efs))))
                                  .upred_holds j c =>
                                  source_steps e2' sigma2 efs j j_le_r' c
                                    incl_c hc hstep_inner
                              | wp_map : properUPred_ent_at n
                                  (WP H E e2'
                                    (wp_bind_post H E K Phi))
                                  (WP H E e2 Phi) =>
                                  \lam q q_le_n d hd hwp_inner =>
                                    transport
                                      (\lam ee => (WP H E ee Phi)
                                        .upred_holds q d)
                                      (inv e2_eq)
                                      (ih q q_le_n e2' d hd hwp_inner)
                              | forks => wp_forks H.iris_fork_post
                                  (wp H) efs
                              | wp_forks_map : properUPred_ent_at n
                                  ((WP H E e2'
                                      (wp_bind_post H E K Phi)) ∗ forks)
                                  ((WP H E e2 Phi) ∗ forks) =>
                                  \lam q q_le_n d hd hs => \case hs \with {
                                    | inP (awp, afs, dd, hwp', hfs) =>
                                      \let
                                        | hd_parts : (iResUR S).validN q
                                            ((iResUR S).op awp afs) =>
                                            (iResUR S).cmra_validN_ne q d
                                              ((iResUR S).op awp afs) dd hd
                                        | hawp : (iResUR S).validN q awp =>
                                            (iResUR S).cmra_validN_op_l q
                                              awp afs hd_parts
                                      \in inP (awp, afs, dd,
                                        wp_map q q_le_n awp hawp hwp', hfs)
                                  }
                              | result_map : properUPred_ent_at n
                                  ((state_interp H sigma2 futureObservations) ∗
                                    ((WP H E e2'
                                        (wp_bind_post H E K Phi)) ∗ forks))
                                  ((state_interp H sigma2 futureObservations) ∗
                                    ((WP H E e2 Phi) ∗ forks)) =>
                                  sep_mono_r_at n (state_interp H sigma2 futureObservations)
                                    ((WP H E e2'
                                        (wp_bind_post H E K Phi)) ∗ forks)
                                    ((WP H E e2 Phi) ∗ forks)
                                    wp_forks_map
                            \in fupd_mono_at H.iris_wsat n coPset_empty E
                              ((state_interp H sigma2 futureObservations) ∗
                                ((WP H E e2'
                                    (wp_bind_post H E K Phi)) ∗ forks))
                              ((state_interp H sigma2 futureObservations) ∗
                                ((WP H E e2 Phi) ∗ forks)) result_map
                              j ((NatSemiring.<=∘) j_le_r' r'_le_n)
                              c hc source_result
                        }
                \in (reducible_fill K e sigma hcore'.1, target_steps)
            }
      | target_none : (wp_pre_body H E (wp H)
          (fill K e) Phi nothing).upred_holds (suc n) x =>
          \lam sigma observations futureObservations m m_le_sn frame hx_frame hstate =>
            fupd_mono_at H.iris_wsat (suc n) E coPset_empty
              (SrcCore sigma observations futureObservations)
              (TgtCore sigma observations futureObservations)
              (core_map sigma observations futureObservations)
              m m_le_sn (M.op x frame) hx_frame
              (hp sigma observations futureObservations
                m m_le_sn frame hx_frame hstate)
    \in transport
      (\lam tv' => (wp_pre_body H E (wp H)
        (fill K e) Phi tv').upred_holds (suc n) x)
      (inv no_fill) target_none

\func wp_bind_at_le {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (K : Ectx)
    (Phi : Value -> iProp S) (N n : Nat) (n_le_N : n <= N)
    (e : Expr) (x : iResUR S) (hx : (iResUR S).validN n x)
    (hp : (WP H E e (wp_bind_post H E K Phi)).upred_holds n x)
  : (WP H E (fill K e) Phi).upred_holds n x
  \elim N
  | 0 => \case \elim n, n_le_N, hx, hp \with {
      | 0, _, hx0, hp0 =>
        \let
          | source_pre => (wp_unfold H E e
              (wp_bind_post H E K Phi) 0 x hx0).1 hp0
          | target_pre => wp_bind_pre_zero H E K e Phi
              (to_val e) idp x hx0 source_pre
        \in (wp_unfold H E (fill K e) Phi 0 x hx0).2 target_pre
      | suc n', le, _, _ => absurd (le NatOrder.zero<suc)
    }
  | suc N' => \case \elim n, n_le_N, hx, hp \with {
      | 0, _, hx0, hp0 =>
        \let
          | source_pre => (wp_unfold H E e
              (wp_bind_post H E K Phi) 0 x hx0).1 hp0
          | target_pre => wp_bind_pre_zero H E K e Phi
              (to_val e) idp x hx0 source_pre
        \in (wp_unfold H E (fill K e) Phi 0 x hx0).2 target_pre
      | suc n', le, hxS, hpS =>
        \let
          | n'_le_N' : n' <= N' => suc<=suc.conv le
          | source_pre => (wp_unfold H E e
              (wp_bind_post H E K Phi) (suc n') x hxS).1 hpS
          | target_pre => wp_bind_pre_step H E K e Phi n'
              (to_val e) idp x hxS source_pre
              (\lam k k_le_n' e' a ha hwp =>
                wp_bind_at_le H E K Phi N' k
                  ((NatSemiring.<=∘) k_le_n' n'_le_N')
                  e' a ha hwp)
        \in (wp_unfold H E (fill K e) Phi (suc n') x hxS).2 target_pre
    }

\lemma wp_bind {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (K : Ectx)
    (e : Expr) (Phi : Value -> iProp S)
  : (WP H E e (wp_bind_post H E K Phi)) ⊢
      (WP H E (fill K e) Phi) =>
  \lam n x hx hp =>
    wp_bind_at_le H E K Phi n n <=-refl e x hx hp

\lemma wp_bind_item {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (Ki : EctxItem)
    (e : Expr) (Phi : Value -> iProp S)
  : (WP H E e (\lam v => WP H E (fill_item Ki (Val v)) Phi)) ⊢
      (WP H E (fill_item Ki e) Phi) =>
  wp_bind H E (ConsCtx Ki EmptyCtx) e Phi

-- Constructor form of the non-value WP branch.  Operational lifting lemmas
-- prove this premise and then fold it into WP without reopening the fixpoint.
\lemma wp_nonval_intro {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e : Expr)
    (Phi : Value -> iProp S) (notVal : to_val e = nothing)
  : (wp_nonval H E (wp H) e Phi) ⊢
      (WP H E e Phi) =>
  \lam n x hx hnonval =>
    (wp_unfold H E e Phi n x hx).2
      (transport
        (\lam tv => (wp_pre_body H E (wp H) e Phi tv)
          .upred_holds n x)
        (inv notVal) hnonval)

-- Open a smaller mask while retaining the corresponding closing update next
-- to an arbitrary frame.  Operational lifting uses this with E2 = empty: the
-- physical step runs while invariants are unavailable, and its successor
-- consumes the returned empty -> E token before continuing.
\lemma fupd_mask_frame {S : gFunctors} (W : wsatGS S)
    (E1 E2 : coPset) (hsub : coPSubset E2 E1) (P : iProp S)
  : P ⊢
      (mkProperFUpd W E1 E2
        ((mkProperFUpd W E2 E1 mkProperEmp) ∗ P)) =>
  properUPred_ent_trans P (mkProperEmp ∗ P)
    (mkProperFUpd W E1 E2
      ((mkProperFUpd W E2 E1 mkProperEmp) ∗ P))
    ((BIuPredMixin (iResUR S)).bi_mixin_emp_sep_1 P)
    (properUPred_ent_trans
      (mkProperEmp ∗ P)
      ((mkProperFUpd W E1 E2
          (mkProperFUpd W E2 E1 mkProperEmp)) ∗ P)
      (mkProperFUpd W E1 E2
        ((mkProperFUpd W E2 E1 mkProperEmp) ∗ P))
      (sep_mono_l_ent mkProperEmp
        (mkProperFUpd W E1 E2
          (mkProperFUpd W E2 E1 mkProperEmp)) P
        (fupd_mask_intro W E1 E2 hsub))
      (fupd_frame_r W E1 E2
        (mkProperFUpd W E2 E1 mkProperEmp) P))

-- Run a basic update while a mask-closing token is framed.  The basic update
-- changes ghost state; afterwards the token restores the invariant mask.
\lemma bupd_close {S : gFunctors} (W : wsatGS S)
    (E : coPset) (P : iProp S)
  : ((mkProperFUpd W coPset_empty E mkProperEmp) ∗
        (|==> P)) ⊢
      (mkProperFUpd W coPset_empty E P) =>
  \let
    | Close => mkProperFUpd W coPset_empty E mkProperEmp
    | close_frame : (P ∗ Close) ⊢
        (mkProperFUpd W coPset_empty E P) =>
        properUPred_ent_trans
          (P ∗ Close)
          (mkProperFUpd W coPset_empty E
            (P ∗ mkProperEmp))
          (mkProperFUpd W coPset_empty E P)
          (fupd_frame_l W coPset_empty E P mkProperEmp)
          (fupd_mono W coPset_empty E
            (P ∗ mkProperEmp) P
            (properUPred_ent_trans
              (P ∗ mkProperEmp)
              (mkProperEmp ∗ P) P
              (sep_comm_ent P mkProperEmp)
              ((BIuPredMixin (iResUR S)).bi_mixin_emp_sep_2 P)))
  \in properUPred_ent_trans
      (Close ∗ (|==> P))
      (|==> (P ∗ Close))
      (mkProperFUpd W coPset_empty E P)
      (properUPred_ent_trans
        (Close ∗ (|==> P))
        ((|==> P) ∗ Close)
        (|==> (P ∗ Close))
        (sep_comm_ent Close (|==> P))
        (bupd_frame_r P Close))
      (properUPred_ent_trans
        (|==> (P ∗ Close))
        (|==> (mkProperFUpd W coPset_empty E P))
        (mkProperFUpd W coPset_empty E P)
        (bupd_mono (P ∗ Close)
          (mkProperFUpd W coPset_empty E P) close_frame)
        (properUPred_ent_trans
          (|==> (mkProperFUpd W coPset_empty E P))
          (mkProperFUpd W coPset_empty coPset_empty
            (mkProperFUpd W coPset_empty E P))
          (mkProperFUpd W coPset_empty E P)
          (bupd_fupd W coPset_empty
            (mkProperFUpd W coPset_empty E P))
          (fupd_trans W coPset_empty coPset_empty E P)))

-- Sequential steps are the special case with no spawned expressions.
\lemma wp_add_empty_forks {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (sigma : State cnt)
    (futureObservations : List Observation)
    (e : Expr) (Phi : Value -> iProp S)
  : ((state_interp H sigma futureObservations) ∗ (WP H E e Phi)) ⊢
      ((state_interp H sigma futureObservations) ∗
        ((WP H E e Phi) ∗
          (wp_forks H.iris_fork_post (wp H) nil))) =>
  sep_mono_r_ent (state_interp H sigma futureObservations) (WP H E e Phi)
    ((WP H E e Phi) ∗
      (wp_forks H.iris_fork_post (wp H) nil))
    (add_emp_r_ent (WP H E e Phi))

\lemma wp_remove_empty_forks {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (sigma : State cnt)
    (futureObservations : List Observation)
    (e : Expr) (Phi : Value -> iProp S)
  : ((state_interp H sigma futureObservations) ∗
        ((WP H E e Phi) ∗
          (wp_forks H.iris_fork_post (wp H) nil))) ⊢
      ((state_interp H sigma futureObservations) ∗ (WP H E e Phi)) =>
  sep_mono_r_ent (state_interp H sigma futureObservations)
    ((WP H E e Phi) ∗
      (wp_forks H.iris_fork_post (wp H) nil))
    (WP H E e Phi)
    (properUPred_ent_trans
      ((WP H E e Phi) ∗ mkProperEmp)
      (mkProperEmp ∗ (WP H E e Phi))
      (WP H E e Phi)
      (sep_comm_ent (WP H E e Phi) mkProperEmp)
      ((BIuPredMixin (iResUR S)).bi_mixin_emp_sep_2 (WP H E e Phi)))

-- Atomic lifting rule. `R` is the client resource. Reducibility is
-- established from R and the physical state; every concrete successor may
-- perform a basic ghost update and must return the successor state, its WP,
-- and a WP at the fork postcondition for every spawned expression.
\lemma wp_lift_atomic {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e : Expr)
    (Phi : Value -> iProp S) (R : iProp S)
    (notVal : to_val e = nothing)
    (red : \Pi (sigma : State cnt) (allObservations : List Observation) ->
      (R ∗ (state_interp H sigma allObservations)) ⊢
      (mkProperPure (Reducible e sigma)))
    (step : \Pi (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt)
      (efs : List Expr) (observations futureObservations : List Observation) ->
      PrimStep e sigma e2 sigma2 efs observations -> (R ∗
          (state_interp H sigma (observations ++ futureObservations))) ⊢
        (|==>
          ((state_interp H sigma2 futureObservations) ∗
            ((WP H E e2 Phi) ∗
              (wp_forks H.iris_fork_post (wp H) efs)))))
  : R ⊢ (WP H E e Phi) =>
  properUPred_ent_trans R
    (wp_nonval H E (wp H) e Phi)
    (WP H E e Phi)
    (\lam n a ha hR sigma observations futureObservations
        m m_le_n frame ha_frame hstate =>
      \let
        | M => iResUR S
        | P => R ∗
            (state_interp H sigma (observations ++ futureObservations))
        | Close => mkProperFUpd H.iris_wsat coPset_empty E mkProperEmp
        | Opened => Close ∗ P
        | Core => (mkProperPure (Reducible e sigma)) ∧
            (|>
              (wp_steps H E (wp H) e Phi sigma observations futureObservations))
        | hp : P.upred_holds m (M.op a frame) =>
            inP (a, frame, M.ofe_dist_refl m (M.op a frame),
              R.upred_mono n m a a hR
                (inclN_refl_ucmra {M} m a) m_le_n,
              hstate)
        | hopened : (mkProperFUpd H.iris_wsat E coPset_empty Opened)
            .upred_holds m (M.op a frame) =>
            fupd_mask_frame H.iris_wsat E coPset_empty
              (coPSubset_empty_l E) P m (M.op a frame) ha_frame hp
        | opened_to_core : Opened ⊢ Core =>
            \lam r x hx hs =>
              \let
                | reducible : Reducible e sigma => \case hs \with {
                    | inP (ac, ap, dc, _, hP) =>
                      red sigma (observations ++ futureObservations) r ap
                        (cmra_validN_op_r {M} r ac ap
                          (M.cmra_validN_ne r x (M.op ac ap) dc hx)) hP
                  }
                | laterSteps : (|>
                    (wp_steps H E (wp H) e Phi sigma observations futureObservations))
                    .upred_holds r x =>
                    \case \elim r, hx, hs \with {
                      | 0, _, _ => ()
                      | suc k, hxk, hsk =>
                        \lam e2 sigma2 efs j j_le_k c incl_c hc hstep =>
                          \let
                            | hs_j : Opened.upred_holds j c =>
                                Opened.upred_mono (suc k) j x c hsk incl_c
                                  ((NatSemiring.<=∘) j_le_k (n<=sucn k))
                          \in \case hs_j \with {
                            | inP (ac, ap, dc, hclose, hPj) =>
                              bupd_close H.iris_wsat E
                                ((state_interp H sigma2 futureObservations) ∗
                                  ((WP H E e2 Phi) ∗
                                    (wp_forks H.iris_fork_post
                                      (wp H) efs)))
                                j c hc
                                (inP (ac, ap, dc, hclose,
                                  step sigma e2 sigma2 efs observations
                                    futureObservations hstep
                                    j ap
                                    (cmra_validN_op_r {M} j ac ap
                                      (M.cmra_validN_ne j c (M.op ac ap)
                                        dc hc))
                                    hPj))
                          }
                    }
              \in (reducible, laterSteps)
      \in fupd_mono H.iris_wsat E coPset_empty Opened Core
        opened_to_core m (M.op a frame) ha_frame hopened)
    (wp_nonval_intro H E e Phi notVal)

-- Atomic lifting with a one-step-delayed transition frame.  This is the
-- term-mode counterpart of the `▷` premise in Iris' atomic head-step rules:
-- `Rnow` is available immediately (and therefore establishes reducibility),
-- while `Rafter` becomes available exactly when the physical step's
-- successor obligation is checked.  It is the key rule for opening an
-- invariant around an atomic heap operation without pretending that the
-- whole invariant body is timeless.
\lemma wp_lift_atomic_later_frame {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e : Expr)
    (Phi : Value -> iProp S) (Rnow Rafter : iProp S)
    (notVal : to_val e = nothing)
    (red : \Pi (sigma : State cnt) (allObservations : List Observation) ->
      ((Rnow ∗ (|> Rafter)) ∗
          (state_interp H sigma allObservations)) ⊢
        (mkProperPure (Reducible e sigma)))
    (step : \Pi (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt)
      (efs : List Expr) (observations futureObservations : List Observation) ->
      PrimStep e sigma e2 sigma2 efs observations -> ((Rnow ∗ Rafter) ∗
          (state_interp H sigma (observations ++ futureObservations))) ⊢
        (|==>
          ((state_interp H sigma2 futureObservations) ∗
            ((WP H E e2 Phi) ∗
              (wp_forks H.iris_fork_post (wp H) efs))))) :
  (Rnow ∗ (|> Rafter)) ⊢
    (WP H E e Phi) =>
  \let
    | R => Rnow ∗ (|> Rafter)
    | Rstep => Rnow ∗ Rafter
    | shiftR : R ⊢ (|> Rstep) =>
        properUPred_ent_trans R
          ((|> Rnow) ∗ (|> Rafter))
          (|> Rstep)
          (sep_mono_l_ent Rnow (|> Rnow)
            (|> Rafter) (proper_later_intro Rnow))
          (proper_later_sep_2 Rnow Rafter)
  \in properUPred_ent_trans R
    (wp_nonval H E (wp H) e Phi)
    (WP H E e Phi)
    (\lam n a ha hR sigma observations futureObservations
        m m_le_n frame ha_frame hstate =>
      \let
        | M => iResUR S
        | StateP => state_interp H sigma
            (observations ++ futureObservations)
        | P => R ∗ StateP
        | Pstep => Rstep ∗ StateP
        | shiftP : P ⊢ (|> Pstep) =>
            properUPred_ent_trans P
              ((|> Rstep) ∗ (|> StateP))
              (|> Pstep)
              (properUPred_ent_trans P
                ((|> Rstep) ∗ StateP)
                ((|> Rstep) ∗ (|> StateP))
                (sep_mono_l_ent R (|> Rstep) StateP shiftR)
                (sep_mono_r_ent (|> Rstep) StateP
                  (|> StateP) (proper_later_intro StateP)))
              (proper_later_sep_2 Rstep StateP)
        | Close => mkProperFUpd H.iris_wsat coPset_empty E mkProperEmp
        | Opened => Close ∗ P
        | OpenedStep => Close ∗ Pstep
        | shiftOpened : Opened ⊢
            (|> OpenedStep) =>
            properUPred_ent_trans Opened
              ((|> Close) ∗ (|> Pstep))
              (|> OpenedStep)
              (properUPred_ent_trans Opened
                ((|> Close) ∗ P)
                ((|> Close) ∗ (|> Pstep))
                (sep_mono_l_ent Close (|> Close) P
                  (proper_later_intro Close))
                (sep_mono_r_ent (|> Close) P
                  (|> Pstep) shiftP))
              (proper_later_sep_2 Close Pstep)
        | Core => (mkProperPure (Reducible e sigma)) ∧
            (|>
              (wp_steps H E (wp H) e Phi sigma observations futureObservations))
        | hp : P.upred_holds m (M.op a frame) =>
            inP (a, frame, M.ofe_dist_refl m (M.op a frame),
              R.upred_mono n m a a hR
                (inclN_refl_ucmra {M} m a) m_le_n,
              hstate)
        | hopened : (mkProperFUpd H.iris_wsat E coPset_empty Opened)
            .upred_holds m (M.op a frame) =>
            fupd_mask_frame H.iris_wsat E coPset_empty
              (coPSubset_empty_l E) P m (M.op a frame) ha_frame hp
        | opened_to_core : Opened ⊢ Core =>
            \lam r x hx hs =>
              \let
                | reducible : Reducible e sigma => \case hs \with {
                    | inP (ac, ap, dc, _, hP) =>
                      red sigma (observations ++ futureObservations) r ap
                        (cmra_validN_op_r {M} r ac ap
                          (M.cmra_validN_ne r x (M.op ac ap) dc hx)) hP
                  }
                | laterSteps : (|>
                    (wp_steps H E (wp H) e Phi sigma observations
                      futureObservations)).upred_holds r x =>
                    \case \elim r, hx, hs \with {
                      | 0, _, _ => ()
                      | suc k, hxk, hsk =>
                        \lam e2 sigma2 efs j j_le_k c incl_c hc hstep =>
                          \let
                            | shifted : (|> OpenedStep)
                                .upred_holds (suc k) x =>
                                shiftOpened (suc k) x hxk hsk
                            | hs_j : OpenedStep.upred_holds j c =>
                                OpenedStep.upred_mono k j x c shifted incl_c
                                  j_le_k
                          \in \case hs_j \with {
                            | inP (ac, ap, dc, hclose, hPj) =>
                              bupd_close H.iris_wsat E
                                ((state_interp H sigma2 futureObservations) ∗
                                  ((WP H E e2 Phi) ∗
                                    (wp_forks H.iris_fork_post
                                      (wp H) efs)))
                                j c hc
                                (inP (ac, ap, dc, hclose,
                                  step sigma e2 sigma2 efs observations
                                    futureObservations hstep
                                    j ap
                                    (cmra_validN_op_r {M} j ac ap
                                      (M.cmra_validN_ne j c (M.op ac ap)
                                        dc hc))
                                    hPj))
                          }
                    }
              \in (reducible, laterSteps)
      \in fupd_mono H.iris_wsat E coPset_empty Opened Core
        opened_to_core m (M.op a frame) ha_frame hopened)
    (wp_nonval_intro H E e Phi notVal)

-- Generic deterministic pure-step rule.  The state resource is only framed,
-- never updated; the mask token above accounts for the E -> empty -> E cycle
-- required by the invariant-aware WP.
\lemma wp_pure_step {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e e' : Expr)
    (pure : \Pi (sigma : State cnt) -> PrimStep e sigma e' sigma nil nil)
    (det : \Pi (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt)
      (efs : List Expr) (observations : List Observation) ->
      PrimStep e sigma e2 sigma2 efs observations ->
      \Sigma (e2 = e') (sigma2 = sigma) (efs = nil) (observations = nil))
    (notVal : to_val e = nothing) (Phi : Value -> iProp S)
  : (WP H E e' Phi) ⊢ (WP H E e Phi) =>
  properUPred_ent_trans
    (WP H E e' Phi)
    (wp_nonval H E (wp H) e Phi)
    (WP H E e Phi)
    (\lam n a ha hwp sigma observations futureObservations
        m m_le_n frame ha_frame hstate =>
      \let
        | M => iResUR S
        | P => (WP H E e' Phi) ∗
            (state_interp H sigma (observations ++ futureObservations))
        | Close => mkProperFUpd H.iris_wsat coPset_empty E mkProperEmp
        | Opened => Close ∗ P
        | Core => (mkProperPure (Reducible e sigma)) ∧
            (|>
              (wp_steps H E (wp H) e Phi sigma observations futureObservations))
        | hp : P.upred_holds m (M.op a frame) =>
            inP (a, frame, M.ofe_dist_refl m (M.op a frame),
              (WP H E e' Phi).upred_mono n m a a hwp
                (inclN_refl_ucmra {M} m a) m_le_n,
              hstate)
        | hopened : (mkProperFUpd H.iris_wsat E coPset_empty Opened)
            .upred_holds m (M.op a frame) =>
            fupd_mask_frame H.iris_wsat E coPset_empty
              (coPSubset_empty_l E) P m (M.op a frame) ha_frame hp
        | opened_to_core : Opened ⊢ Core =>
            \lam r x hx hs =>
              \let
                | red : Reducible e sigma => inP (e', sigma, nil, nil, pure sigma)
                | laterSteps : (|>
                    (wp_steps H E (wp H) e Phi sigma observations futureObservations))
                    .upred_holds r x =>
                    \case \elim r, hx, hs \with {
                      | 0, _, _ => ()
                      | suc k, hxk, hsk =>
                        \lam e2 sigma2 efs j j_le_k c incl_c hc hstep =>
                          \let
                            | hs_j : Opened.upred_holds j c =>
                                Opened.upred_mono (suc k) j x c hsk incl_c
                                  ((NatSemiring.<=∘) j_le_k (n<=sucn k))
                          \in \case hs_j \with {
                            | inP (ac, ap, dc, hclose, hPj) =>
                              \let
                                | hclosed : (mkProperFUpd H.iris_wsat
                                    coPset_empty E
                                    (mkProperEmp ∗ P))
                                    .upred_holds j c =>
                                    fupd_frame_r H.iris_wsat coPset_empty E
                                      mkProperEmp P j c hc
                                      (inP (ac, ap, dc, hclose, hPj))
                                | hresult_main : (mkProperFUpd H.iris_wsat
                                    coPset_empty E
                                    ((state_interp H sigma
                                      (observations ++ futureObservations)) ∗
                                      (WP H E e' Phi)))
                                    .upred_holds j c =>
                                    fupd_mono H.iris_wsat coPset_empty E
                                      (mkProperEmp ∗ P)
                                      ((state_interp H sigma
                                        (observations ++ futureObservations)) ∗
                                        (WP H E e' Phi))
                                      (properUPred_ent_trans
                                        (mkProperEmp ∗ P) P
                                        ((state_interp H sigma
                                          (observations ++ futureObservations)) ∗
                                          (WP H E e' Phi))
                                        ((BIuPredMixin M).bi_mixin_emp_sep_2 P)
                                        (sep_comm_ent
                                          (WP H E e' Phi)
                                          (state_interp H sigma
                                            (observations ++ futureObservations))))
                                      j c hc hclosed
                                | target_nil => (state_interp H sigma
                                      (observations ++ futureObservations)) ∗
                                    ((WP H E e' Phi) ∗
                                      (wp_forks H.iris_fork_post
                                        (wp H) nil))
                                | hresult : (mkProperFUpd H.iris_wsat
                                    coPset_empty E target_nil)
                                    .upred_holds j c =>
                                    fupd_mono H.iris_wsat coPset_empty E
                                      ((state_interp H sigma
                                        (observations ++ futureObservations)) ∗
                                        (WP H E e' Phi)) target_nil
                                      (wp_add_empty_forks H E sigma
                                        (observations ++ futureObservations) e' Phi)
                                      j c hc hresult_main
                                | step_det => det sigma e2 sigma2 efs observations hstep
                                | hresult_future : (mkProperFUpd H.iris_wsat
                                    coPset_empty E
                                    ((state_interp H sigma futureObservations) ∗
                                      ((WP H E e' Phi) ∗
                                        (wp_forks H.iris_fork_post
                                          (wp H) nil)))).upred_holds j c =>
                                    transport
                                      (\lam obs =>
                                        (mkProperFUpd H.iris_wsat coPset_empty E
                                          ((state_interp H sigma
                                              (obs ++ futureObservations)) ∗
                                            ((WP H E e' Phi) ∗
                                              (wp_forks H.iris_fork_post
                                                (wp H) nil)))).upred_holds j c)
                                      step_det.4 hresult
                              \in transport
                                (\lam fs =>
                                  (mkProperFUpd H.iris_wsat coPset_empty E
                                    ((state_interp H sigma2 futureObservations) ∗
                                      ((WP H E e2 Phi) ∗
                                        (wp_forks H.iris_fork_post
                                          (wp H) fs)))).upred_holds j c)
                                (inv step_det.3)
                                (transport2
                                  (\lam ee ss =>
                                    (mkProperFUpd H.iris_wsat coPset_empty E
                                      ((state_interp H ss futureObservations) ∗
                                        ((WP H E ee Phi) ∗
                                          (wp_forks H.iris_fork_post
                                            (wp H) nil)))).upred_holds j c)
                                  (inv step_det.1) (inv step_det.2) hresult_future)
                          }
                    }
              \in (red, laterSteps)
      \in fupd_mono H.iris_wsat E coPset_empty Opened Core
        opened_to_core m (M.op a frame) ha_frame hopened)
    (wp_nonval_intro H E e Phi notVal)

\func pure_base_redex_step_det {cnt : Countable Loc}
    (e e' : Expr)
    (baseDet : \Pi (sigma : State cnt) (e2 : Expr)
      (sigma2 : State cnt) (efs : List Expr)
      (observations : List Observation) ->
      BaseStep e sigma e2 sigma2 efs observations ->
      \Sigma (e2 = e') (sigma2 = sigma) (efs = nil) (observations = nil))
    (ctxAbsurd : \Pi (sigma : State cnt) (sigma2 : State cnt)
      (efs : List Expr) (observations : List Observation)
      (Ki : EctxItem) (K : Ectx) (e1' e2' : Expr) ->
      e = fill_item Ki (fill K e1') ->
      BaseStep e1' sigma e2' sigma2 efs observations -> Empty)
    (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt)
    (efs : List Expr) (observations : List Observation)
    (step : PrimStep e sigma e2 sigma2 efs observations) :
  \Sigma (e2 = e') (sigma2 = sigma) (efs = nil) (observations = nil) =>
  \case step \with {
    | EctxStep K e1' e2' p1 p2 base =>
      pure_base_redex_step_det_ctx e e' baseDet ctxAbsurd sigma e2
        sigma2 efs observations K e1' e2' p1 p2 base
  }
  \where {
    \func pure_base_redex_step_det_ctx {cnt : Countable Loc}
        (e e' : Expr)
        (baseDet : \Pi (sigma : State cnt) (e2 : Expr)
          (sigma2 : State cnt) (efs : List Expr)
          (observations : List Observation) ->
          BaseStep e sigma e2 sigma2 efs observations ->
          \Sigma (e2 = e') (sigma2 = sigma)
            (efs = nil) (observations = nil))
        (ctxAbsurd : \Pi (sigma : State cnt) (sigma2 : State cnt)
          (efs : List Expr) (observations : List Observation)
          (Ki : EctxItem) (K : Ectx) (e1' e2' : Expr) ->
          e = fill_item Ki (fill K e1') ->
          BaseStep e1' sigma e2' sigma2 efs observations -> Empty)
        (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt)
        (efs : List Expr) (observations : List Observation)
        (K : Ectx) (e1' e2' : Expr)
        (p1 : e = fill K e1') (p2 : e2 = fill K e2')
        (base : BaseStep e1' sigma e2' sigma2 efs observations) :
      \Sigma (e2 = e') (sigma2 = sigma)
        (efs = nil) (observations = nil) \elim K
      | EmptyCtx =>
          \let
            | base' : BaseStep e sigma e2' sigma2 efs observations =>
                transport (\lam ee => BaseStep ee sigma e2' sigma2
                  efs observations) (inv p1) base
            | d => baseDet sigma e2' sigma2 efs observations base'
          \in (p2 *> d.1, d.2, d.3, d.4)
      | ConsCtx Ki K' => absurd
          (ctxAbsurd sigma sigma2 efs observations Ki K' e1' e2' p1 base)
  }

\func app_lam_pure_ctx_absurd {cnt : Countable Loc}
    (x : Name) (body : Expr) (v : Value)
    (sigma sigma2 : State cnt) (efs : List Expr)
    (observations : List Observation)
    (Ki : EctxItem) (K : Ectx) (e1' e2' : Expr)
    (p1 : App (Val (LamV x body)) (Val v) =
      fill_item Ki (fill K e1'))
    (base : BaseStep e1' sigma e2' sigma2 efs observations) : Empty
    \elim Ki
  | AppLCtx _ =>
      \let
        | innerEq : Val (LamV x body) = fill K e1' =>
            pmap (app_l_arg (Val (LamV x body))) p1
        | innerNotVal : to_val (fill K e1') = nothing =>
            fill_not_val K e1'
              (base_val_stuck e1' sigma e2' sigma2 efs observations base)
        | impossible : just (LamV x body) = nothing =>
            pmap to_val innerEq *> innerNotVal
      \in \case impossible \with {}
  | AppRCtx _ =>
      \let
        | innerEq : Val v = fill K e1' => pmap (app_r_arg (Val v)) p1
        | innerNotVal : to_val (fill K e1') = nothing =>
            fill_not_val K e1'
              (base_val_stuck e1' sigma e2' sigma2 efs observations base)
        | impossible : just v = nothing => pmap to_val innerEq *> innerNotVal
      \in \case impossible \with {}
  | IfCtx _ _ => \case p1 \with {}
  | PairLCtx _ => \case p1 \with {}
  | PairRCtx _ => \case p1 \with {}
  | FstCtx => \case p1 \with {}
  | SndCtx => \case p1 \with {}
  | IsZeroCtx => \case p1 \with {}
  | PredCtx => \case p1 \with {}
  | MulLCtx _ => \case p1 \with {}
  | MulRCtx _ => \case p1 \with {}
  | AllocCtx => \case p1 \with {}
  | LoadCtx => \case p1 \with {}
  | StoreLCtx _ => \case p1 \with {}
  | StoreRCtx _ => \case p1 \with {}
  | ResolveLCtx _ _ _ => \case p1 \with {}
  | ResolveMCtx _ _ => \case p1 \with {}
  | ResolveRCtx _ _ => \case p1 \with {}

\func base_lam_beta_pure_det {cnt : Countable Loc}
    (x : Name) (body : Expr) (v : Value)
    (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt)
    (efs : List Expr) (observations : List Observation)
    (base : BaseStep (App (Val (LamV x body)) (Val v)) sigma
      e2 sigma2 efs observations) :
  \Sigma (e2 = subst x v body) (sigma2 = sigma)
    (efs = nil) (observations = nil) =>
  \case base \with {
    | BetaS x' body' v' p1 p2 p3 {p0} {p4} =>
      \let
        | xEq : x = x' => pmap (\lam e => \case e \with {
            | App (Val (LamV xx _)) _ => xx | _ => x }) p1
        | bodyEq : body = body' => pmap (\lam e => \case e \with {
            | App (Val (LamV _ bb)) _ => bb | _ => body }) p1
        | vEq : v = v' => pmap (\lam e => \case e \with {
            | App _ (Val vv) => vv | _ => v }) p1
        | substEq : subst x' v' body' = subst x v body =>
            path (\lam i => subst (inv xEq @ i) (inv vEq @ i)
              (inv bodyEq @ i))
      \in (p2 *> substEq, p3, p4, p0)
    | RecBetaS _ _ _ _ p1 _ _ => \case p1 \with {}
    | LamS _ _ p1 _ _ => \case p1 \with {}
    | RecS _ _ _ p1 _ _ => \case p1 \with {}
    | IfTrueS _ _ p1 _ _ => \case p1 \with {}
    | IfFalseS _ _ p1 _ _ => \case p1 \with {}
    | FstS _ _ p1 _ _ => \case p1 \with {}
    | SndS _ _ p1 _ _ => \case p1 \with {}
    | PairS _ _ p1 _ _ => \case p1 \with {}
    | AllocS _ _ _ p1 _ _ => \case p1 \with {}
    | LoadS _ _ _ p1 _ _ => \case p1 \with {}
    | StoreS _ _ _ _ p1 _ _ => \case p1 \with {}
    | IsZeroZeroS p1 _ _ => \case p1 \with {}
    | IsZeroPosS _ p1 _ _ => \case p1 \with {}
    | PredS _ p1 _ _ => \case p1 \with {}
    | MulS _ _ p1 _ _ => \case p1 \with {}
    | BinOpS _ _ _ _ _ p1 _ _ => \case p1 \with {}
    | AllocNS _ _ _ _ _ p1 _ _ => \case p1 \with {}
    | FAAS _ _ _ _ p1 _ _ => \case p1 \with {}
    | ForkS _ p1 _ _ => \case p1 \with {}
    | NewProphS _ _ p1 _ _ => \case p1 \with {}
    | ResolveS _ _ _ _ _ _ _ _ p1 _ => \case p1 \with {}
  }

\lemma wp_lam_beta {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (x : Name) (body : Expr) (v : Value)
    (Phi : Value -> iProp S) :
  (WP H E (subst x v body) Phi) ⊢
    (WP H E (App (Val (LamV x body)) (Val v)) Phi) =>
  wp_pure_step H E (App (Val (LamV x body)) (Val v))
    (subst x v body)
    (\lam sigma => BasePrim (BetaS x body v idp idp idp {idp} {idp}))
    (pure_base_redex_step_det
      (App (Val (LamV x body)) (Val v)) (subst x v body)
      (base_lam_beta_pure_det x body v)
    (app_lam_pure_ctx_absurd x body v)) idp Phi

\func lam_beta_value_strongly_atomic {cnt : Countable Loc}
    (x : Name) (result arg : Value) :
  StronglyAtomic {cnt}
    (App (Val (LamV x (Val result))) (Val arg)) =>
  \lam sigma e2 sigma2 efs observations step =>
    \let | det => pure_base_redex_step_det
      (App (Val (LamV x (Val result))) (Val arg)) (Val result)
      (base_lam_beta_pure_det x (Val result) arg)
      (app_lam_pure_ctx_absurd x (Val result) arg)
      sigma e2 sigma2 efs observations step
    \in inP (result, det.1)

-- A value-returning beta step consumes a one-step-delayed logical frame.
-- This is the term-mode rule used for sequencing after an atomic operation
-- whose invariant transition produces a later postcondition.
\lemma wp_lam_beta_value_later_frame {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (x : Name) (result arg : Value) (Rafter : iProp S)
    (Phi : Value -> iProp S)
    (transition : Rafter ⊢
      (|==> (Phi result))) :
  ((mkProperEmp {iResUR S}) ∗ (|> Rafter)) ⊢
    (WP H E (App (Val (LamV x (Val result))) (Val arg)) Phi) =>
  \let
    | Rnow => mkProperEmp {iResUR S}
    | Expr0 => App (Val (LamV x (Val result))) (Val arg)
    | dropDelayed : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> ((Rnow ∗ (|> Rafter)) ∗
            (state_interp H sigma allObservations)) ⊢
          (state_interp H sigma allObservations) =>
        \lam sigma allObservations =>
          properUPred_ent_trans
            ((Rnow ∗ (|> Rafter)) ∗
              (state_interp H sigma allObservations))
            ((|> Rafter) ∗
              (state_interp H sigma allObservations))
            (state_interp H sigma allObservations)
            (sep_mono_l_ent (Rnow ∗ (|> Rafter))
              (|> Rafter)
              (state_interp H sigma allObservations)
              (sep_elim_r_ent Rnow (|> Rafter)))
            (sep_elim_r_ent (|> Rafter)
              (state_interp H sigma allObservations))
    | red : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> ((Rnow ∗ (|> Rafter)) ∗
            (state_interp H sigma allObservations)) ⊢
          (mkProperPure (Reducible Expr0 sigma)) =>
        \lam sigma allObservations n a ha hs =>
          \let | _state => dropDelayed sigma allObservations n a ha hs
          \in inP (Val result, sigma, nil, nil,
            BasePrim (BetaS x (Val result) arg idp idp idp {idp} {idp}))
    | step : \Pi (sigma : State cnt) (e2 : Expr)
        (sigma2 : State cnt) (efs : List Expr)
        (observations futureObservations : List Observation) ->
        PrimStep Expr0 sigma e2 sigma2 efs observations ->
        ((Rnow ∗ Rafter) ∗
            (state_interp H sigma
              (observations ++ futureObservations))) ⊢
          (|==>
            ((state_interp H sigma2 futureObservations) ∗
              ((WP H E e2 Phi) ∗
                (wp_forks H.iris_fork_post (wp H) efs)))) =>
        \lam sigma e2 sigma2 efs observations futureObservations hstep =>
          \let
            | det => pure_base_redex_step_det
                Expr0 (Val result)
                (base_lam_beta_pure_det x (Val result) arg)
                (app_lam_pure_ctx_absurd x (Val result) arg)
                sigma e2 sigma2 efs observations hstep
            | e2Eq : e2 = Val result => det.1
            | sigma2Eq : sigma2 = sigma => det.2
            | efsEq : efs = nil => det.3
            | obsEq : observations = nil => det.4
            | StateFuture => state_interp H sigma futureObservations
            | StatePost => StateFuture ∗ (Phi result)
            | Target => (state_interp H sigma2 futureObservations) ∗
                ((WP H E e2 Phi) ∗
                  (wp_forks H.iris_fork_post (wp H) efs))
            | trim : (state_interp H sigma
                  (observations ++ futureObservations)) ⊢ StateFuture =>
                \lam k y _ hstate => transport
                  (\lam obs => (state_interp H sigma
                    (obs ++ futureObservations)).upred_holds k y)
                  obsEq hstate
            | arrange : ((Rnow ∗ Rafter) ∗
                  (state_interp H sigma
                    (observations ++ futureObservations))) ⊢
                (StateFuture ∗ Rafter) =>
                properUPred_ent_trans
                  ((Rnow ∗ Rafter) ∗
                    (state_interp H sigma
                      (observations ++ futureObservations)))
                  (Rafter ∗
                    (state_interp H sigma
                      (observations ++ futureObservations)))
                  (StateFuture ∗ Rafter)
                  (sep_mono_l_ent (Rnow ∗ Rafter) Rafter
                    (state_interp H sigma
                      (observations ++ futureObservations))
                    (sep_elim_r_ent Rnow Rafter))
                  (properUPred_ent_trans
                    (Rafter ∗
                      (state_interp H sigma
                        (observations ++ futureObservations)))
                    (Rafter ∗ StateFuture)
                    (StateFuture ∗ Rafter)
                    (sep_mono_r_ent Rafter
                      (state_interp H sigma
                        (observations ++ futureObservations))
                      StateFuture trim)
                    (sep_comm_ent Rafter StateFuture))
            | update : (StateFuture ∗ Rafter) ⊢
                (|==> StatePost) =>
                properUPred_ent_trans
                  (StateFuture ∗ Rafter)
                  (StateFuture ∗
                    (|==> (Phi result)))
                  (|==> StatePost)
                  (sep_mono_r_ent StateFuture Rafter
                    (|==> (Phi result)) transition)
                  (bupd_frame_l {UPredBiBUpd (iResUR S)}
                    StateFuture (Phi result))
            | valueFinish : StatePost ⊢ Target =>
                \lam k y hy hs => \case hs \with {
                  | inP (astate, aphi, dy, hstate, hphi) =>
                    \let
                      | M => iResUR S
                      | hyParts : M.validN k (M.op astate aphi) =>
                          M.cmra_validN_ne k y (M.op astate aphi) dy hy
                      | phiValid : M.validN k aphi =>
                          cmra_validN_op_r {M} k astate aphi hyParts
                      | hwp : (WP H E (Val result) Phi)
                          .upred_holds k aphi =>
                          wp_value_intro H E result Phi
                            k aphi phiValid hphi
                      | assembled : (StateFuture ∗
                          (WP H E (Val result) Phi)).upred_holds k y =>
                          inP (astate, aphi, dy, hstate, hwp)
                    \in transport
                      (\lam fs => ((state_interp H sigma2 futureObservations) ∗
                        ((WP H E e2 Phi) ∗
                          (wp_forks H.iris_fork_post
                            (wp H) fs))).upred_holds k y)
                      (inv efsEq)
                      (transport2
                        (\lam ee ss => ((state_interp H ss futureObservations) ∗
                          ((WP H E ee Phi) ∗
                            (wp_forks H.iris_fork_post
                              (wp H) nil))).upred_holds k y)
                        (inv e2Eq) (inv sigma2Eq)
                        (wp_add_empty_forks H E sigma
                          futureObservations (Val result) Phi
                          k y hy assembled))
                }
          \in properUPred_ent_trans
              ((Rnow ∗ Rafter) ∗
                (state_interp H sigma
                  (observations ++ futureObservations)))
              (StateFuture ∗ Rafter)
              (|==> Target) arrange
              (properUPred_ent_trans
                (StateFuture ∗ Rafter)
                (|==> StatePost)
                (|==> Target) update
                (bupd_mono StatePost Target valueFinish))
  \in wp_lift_atomic_later_frame H E Expr0 Phi Rnow Rafter idp red step

\func app_values_pure_ctx_absurd {cnt : Countable Loc}
    (vf v : Value) (sigma sigma2 : State cnt) (efs : List Expr)
    (observations : List Observation)
    (Ki : EctxItem) (K : Ectx) (e1' e2' : Expr)
    (p1 : App (Val vf) (Val v) = fill_item Ki (fill K e1'))
    (base : BaseStep e1' sigma e2' sigma2 efs observations) : Empty
    \elim Ki
  | AppLCtx _ =>
      \let
        | innerEq : Val vf = fill K e1' => pmap (app_l_arg (Val vf)) p1
        | innerNotVal : to_val (fill K e1') = nothing =>
            fill_not_val K e1'
              (base_val_stuck e1' sigma e2' sigma2 efs observations base)
        | impossible : just vf = nothing => pmap to_val innerEq *> innerNotVal
      \in \case impossible \with {}
  | AppRCtx _ =>
      \let
        | innerEq : Val v = fill K e1' => pmap (app_r_arg (Val v)) p1
        | innerNotVal : to_val (fill K e1') = nothing =>
            fill_not_val K e1'
              (base_val_stuck e1' sigma e2' sigma2 efs observations base)
        | impossible : just v = nothing => pmap to_val innerEq *> innerNotVal
      \in \case impossible \with {}
  | IfCtx _ _ => \case p1 \with {}
  | PairLCtx _ => \case p1 \with {}
  | PairRCtx _ => \case p1 \with {}
  | FstCtx => \case p1 \with {}
  | SndCtx => \case p1 \with {}
  | IsZeroCtx => \case p1 \with {}
  | PredCtx => \case p1 \with {}
  | MulLCtx _ => \case p1 \with {}
  | MulRCtx _ => \case p1 \with {}
  | AllocCtx => \case p1 \with {}
  | LoadCtx => \case p1 \with {}
  | StoreLCtx _ => \case p1 \with {}
  | StoreRCtx _ => \case p1 \with {}
  | ResolveLCtx _ _ _ => \case p1 \with {}
  | ResolveMCtx _ _ => \case p1 \with {}
  | ResolveRCtx _ _ => \case p1 \with {}

\func base_rec_beta_pure_det {cnt : Countable Loc}
    (f x : Name) (body : Expr) (v : Value)
    (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt)
    (efs : List Expr) (observations : List Observation)
    (base : BaseStep (App (Val (RecV f x body)) (Val v)) sigma
      e2 sigma2 efs observations) :
  \Sigma (e2 = subst x v (subst f (RecV f x body) body))
    (sigma2 = sigma) (efs = nil) (observations = nil) =>
  \case base \with {
    | RecBetaS f' x' body' v' p1 p2 p3 {p0} {p4} =>
      \let
        | fEq : f = f' => pmap (\lam e => \case e \with {
            | App (Val (RecV ff _ _)) _ => ff | _ => f }) p1
        | xEq : x = x' => pmap (\lam e => \case e \with {
            | App (Val (RecV _ xx _)) _ => xx | _ => x }) p1
        | bodyEq : body = body' => pmap (\lam e => \case e \with {
            | App (Val (RecV _ _ bb)) _ => bb | _ => body }) p1
        | vEq : v = v' => pmap (\lam e => \case e \with {
            | App _ (Val vv) => vv | _ => v }) p1
        | substEq : subst x' v' (subst f' (RecV f' x' body') body') =
            subst x v (subst f (RecV f x body) body) =>
            path (\lam i => subst (inv xEq @ i) (inv vEq @ i)
              (subst (inv fEq @ i)
                (RecV (inv fEq @ i) (inv xEq @ i) (inv bodyEq @ i))
                (inv bodyEq @ i)))
      \in (p2 *> substEq, p3, p4, p0)
    | BetaS _ _ _ p1 _ _ => \case p1 \with {}
    | LamS _ _ p1 _ _ => \case p1 \with {}
    | RecS _ _ _ p1 _ _ => \case p1 \with {}
    | IfTrueS _ _ p1 _ _ => \case p1 \with {}
    | IfFalseS _ _ p1 _ _ => \case p1 \with {}
    | FstS _ _ p1 _ _ => \case p1 \with {}
    | SndS _ _ p1 _ _ => \case p1 \with {}
    | PairS _ _ p1 _ _ => \case p1 \with {}
    | AllocS _ _ _ p1 _ _ => \case p1 \with {}
    | LoadS _ _ _ p1 _ _ => \case p1 \with {}
    | StoreS _ _ _ _ p1 _ _ => \case p1 \with {}
    | IsZeroZeroS p1 _ _ => \case p1 \with {}
    | IsZeroPosS _ p1 _ _ => \case p1 \with {}
    | PredS _ p1 _ _ => \case p1 \with {}
    | MulS _ _ p1 _ _ => \case p1 \with {}
    | BinOpS _ _ _ _ _ p1 _ _ => \case p1 \with {}
    | AllocNS _ _ _ _ _ p1 _ _ => \case p1 \with {}
    | FAAS _ _ _ _ p1 _ _ => \case p1 \with {}
    | ForkS _ p1 _ _ => \case p1 \with {}
    | NewProphS _ _ p1 _ _ => \case p1 \with {}
    | ResolveS _ _ _ _ _ _ _ _ p1 _ => \case p1 \with {}
  }

\lemma wp_rec_beta {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (f x : Name) (body : Expr) (v : Value)
    (Phi : Value -> iProp S) :
  (WP H E (subst x v (subst f (RecV f x body) body)) Phi) ⊢
    (WP H E (App (Val (RecV f x body)) (Val v)) Phi) =>
  wp_pure_step H E (App (Val (RecV f x body)) (Val v))
    (subst x v (subst f (RecV f x body) body))
    (\lam sigma => BasePrim
      (RecBetaS f x body v idp idp idp {idp} {idp}))
    (pure_base_redex_step_det
      (App (Val (RecV f x body)) (Val v))
      (subst x v (subst f (RecV f x body) body))
      (base_rec_beta_pure_det f x body v)
      (app_values_pure_ctx_absurd (RecV f x body) v)) idp Phi

\func pure_head_eval (e : Expr) : Maybe Expr \elim e
  | Lam x body => just (Val (LamV x body))
  | Rec f x body => just (Val (RecV f x body))
  | App (Val (LamV x body)) (Val v) => just (subst x v body)
  | App (Val (RecV f x body)) (Val v) =>
      just (subst x v (subst f (RecV f x body) body))
  | If (Val (LitV (LitBool true))) t f => just t
  | If (Val (LitV (LitBool false))) t f => just f
  | Pair (Val v1) (Val v2) => just (Val (PairV v1 v2))
  | Fst (Val (PairV v1 v2)) => just (Val v1)
  | Snd (Val (PairV v1 v2)) => just (Val v2)
  | _ => nothing

\func just_expr_inj (a b : Expr) (p : just a = just b) : a = b =>
  pmap (\case __ \with { | just e => e | nothing => a }) p

\func base_pure_head_eval_det {cnt : Countable Loc}
    (e result : Expr) (evaluates : pure_head_eval e = just result)
    (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt)
    (efs : List Expr) (observations : List Observation)
    (base : BaseStep e sigma e2 sigma2 efs observations) :
  \Sigma (e2 = result) (sigma2 = sigma)
    (efs = nil) (observations = nil) =>
  \case base \with {
    | BetaS x body v p1 p2 p3 {p0} {p4} =>
      (p2 *> just_expr_inj (subst x v body) result
        (inv (pmap pure_head_eval p1) *> evaluates), p3, p4, p0)
    | RecBetaS f x body v p1 p2 p3 {p0} {p4} =>
      (p2 *> just_expr_inj
        (subst x v (subst f (RecV f x body) body)) result
        (inv (pmap pure_head_eval p1) *> evaluates), p3, p4, p0)
    | IfTrueS t f p1 p2 p3 {p0} {p4} =>
      (p2 *> just_expr_inj t result
        (inv (pmap pure_head_eval p1) *> evaluates), p3, p4, p0)
    | IfFalseS t f p1 p2 p3 {p0} {p4} =>
      (p2 *> just_expr_inj f result
        (inv (pmap pure_head_eval p1) *> evaluates), p3, p4, p0)
    | FstS v1 v2 p1 p2 p3 {p0} {p4} =>
      (p2 *> just_expr_inj (Val v1) result
        (inv (pmap pure_head_eval p1) *> evaluates), p3, p4, p0)
    | SndS v1 v2 p1 p2 p3 {p0} {p4} =>
      (p2 *> just_expr_inj (Val v2) result
        (inv (pmap pure_head_eval p1) *> evaluates), p3, p4, p0)
    | PairS v1 v2 p1 p2 p3 {p0} {p4} =>
      (p2 *> just_expr_inj (Val (PairV v1 v2)) result
        (inv (pmap pure_head_eval p1) *> evaluates), p3, p4, p0)
    | LamS x body p1 p2 p3 {p0} {p4} =>
      (p2 *> just_expr_inj (Val (LamV x body)) result
        (inv (pmap pure_head_eval p1) *> evaluates), p3, p4, p0)
    | RecS f x body p1 p2 p3 {p0} {p4} =>
      (p2 *> just_expr_inj (Val (RecV f x body)) result
        (inv (pmap pure_head_eval p1) *> evaluates), p3, p4, p0)
    | AllocS _ _ _ p1 _ _ => \case inv (pmap pure_head_eval p1) *> evaluates \with {}
    | LoadS _ _ _ p1 _ _ => \case inv (pmap pure_head_eval p1) *> evaluates \with {}
    | StoreS _ _ _ _ p1 _ _ => \case inv (pmap pure_head_eval p1) *> evaluates \with {}
    | IsZeroZeroS p1 _ _ => \case inv (pmap pure_head_eval p1) *> evaluates \with {}
    | IsZeroPosS _ p1 _ _ => \case inv (pmap pure_head_eval p1) *> evaluates \with {}
    | PredS _ p1 _ _ => \case inv (pmap pure_head_eval p1) *> evaluates \with {}
    | MulS _ _ p1 _ _ => \case inv (pmap pure_head_eval p1) *> evaluates \with {}
    | BinOpS _ _ _ _ _ p1 _ _ => \case inv (pmap pure_head_eval p1) *> evaluates \with {}
    | AllocNS _ _ _ _ _ p1 _ _ => \case inv (pmap pure_head_eval p1) *> evaluates \with {}
    | FAAS _ _ _ _ p1 _ _ => \case inv (pmap pure_head_eval p1) *> evaluates \with {}
    | ForkS _ p1 _ _ => \case inv (pmap pure_head_eval p1) *> evaluates \with {}
    | NewProphS _ _ p1 _ _ => \case inv (pmap pure_head_eval p1) *> evaluates \with {}
    | ResolveS _ _ _ _ _ _ _ _ p1 _ =>
        \case inv (pmap pure_head_eval p1) *> evaluates \with {}
  }

\lemma wp_pure_head_step {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e result : Expr)
    (evaluates : pure_head_eval e = just result)
    (notVal : to_val e = nothing)
    (base : \Pi (sigma : State cnt) ->
      PrimStep e sigma result sigma nil nil)
    (ctxAbsurd : \Pi (sigma : State cnt) (sigma2 : State cnt)
      (efs : List Expr) (observations : List Observation)
      (Ki : EctxItem) (K : Ectx) (e1' e2' : Expr) ->
      e = fill_item Ki (fill K e1') ->
      BaseStep e1' sigma e2' sigma2 efs observations -> Empty)
    (Phi : Value -> iProp S) :
  (WP H E result Phi) ⊢ (WP H E e Phi) =>
  wp_pure_step H E e result base
    (pure_base_redex_step_det e result
      (base_pure_head_eval_det e result evaluates) ctxAbsurd) notVal Phi

\func pair_values_pure_ctx_absurd {cnt : Countable Loc}
    (v1 v2 : Value) (sigma sigma2 : State cnt) (efs : List Expr)
    (observations : List Observation)
    (Ki : EctxItem) (K : Ectx) (e1' e2' : Expr)
    (p1 : Pair (Val v1) (Val v2) = fill_item Ki (fill K e1'))
    (base : BaseStep e1' sigma e2' sigma2 efs observations) : Empty
    \elim Ki
  | PairLCtx _ =>
      \let
        | eq : Val v1 = fill K e1' => pmap (pair_l_arg (Val v1)) p1
        | nv => fill_not_val K e1'
            (base_val_stuck e1' sigma e2' sigma2 efs observations base)
      \in \case pmap to_val eq *> nv \with {}
  | PairRCtx _ =>
      \let
        | eq : Val v2 = fill K e1' => pmap (pair_r_arg (Val v2)) p1
        | nv => fill_not_val K e1'
            (base_val_stuck e1' sigma e2' sigma2 efs observations base)
      \in \case pmap to_val eq *> nv \with {}
  | AppLCtx _ => \case p1 \with {}
  | AppRCtx _ => \case p1 \with {}
  | IfCtx _ _ => \case p1 \with {}
  | FstCtx => \case p1 \with {}
  | SndCtx => \case p1 \with {}
  | IsZeroCtx => \case p1 \with {}
  | PredCtx => \case p1 \with {}
  | MulLCtx _ => \case p1 \with {}
  | MulRCtx _ => \case p1 \with {}
  | AllocCtx => \case p1 \with {}
  | LoadCtx => \case p1 \with {}
  | StoreLCtx _ => \case p1 \with {}
  | StoreRCtx _ => \case p1 \with {}
  | ResolveLCtx _ _ _ => \case p1 \with {}
  | ResolveMCtx _ _ => \case p1 \with {}
  | ResolveRCtx _ _ => \case p1 \with {}

\func fst_pair_pure_ctx_absurd {cnt : Countable Loc}
    (v1 v2 : Value) (sigma sigma2 : State cnt) (efs : List Expr)
    (observations : List Observation)
    (Ki : EctxItem) (K : Ectx) (e1' e2' : Expr)
    (p1 : Fst (Val (PairV v1 v2)) = fill_item Ki (fill K e1'))
    (base : BaseStep e1' sigma e2' sigma2 efs observations) : Empty
    \elim Ki
  | FstCtx =>
      \let
        | eq : Val (PairV v1 v2) = fill K e1' =>
            pmap (fst_arg (Val (PairV v1 v2))) p1
        | nv => fill_not_val K e1'
            (base_val_stuck e1' sigma e2' sigma2 efs observations base)
      \in \case pmap to_val eq *> nv \with {}
  | AppLCtx _ => \case p1 \with {}
  | AppRCtx _ => \case p1 \with {}
  | IfCtx _ _ => \case p1 \with {}
  | PairLCtx _ => \case p1 \with {}
  | PairRCtx _ => \case p1 \with {}
  | SndCtx => \case p1 \with {}
  | IsZeroCtx => \case p1 \with {}
  | PredCtx => \case p1 \with {}
  | MulLCtx _ => \case p1 \with {}
  | MulRCtx _ => \case p1 \with {}
  | AllocCtx => \case p1 \with {}
  | LoadCtx => \case p1 \with {}
  | StoreLCtx _ => \case p1 \with {}
  | StoreRCtx _ => \case p1 \with {}
  | ResolveLCtx _ _ _ => \case p1 \with {}
  | ResolveMCtx _ _ => \case p1 \with {}
  | ResolveRCtx _ _ => \case p1 \with {}

\func snd_pair_pure_ctx_absurd {cnt : Countable Loc}
    (v1 v2 : Value) (sigma sigma2 : State cnt) (efs : List Expr)
    (observations : List Observation)
    (Ki : EctxItem) (K : Ectx) (e1' e2' : Expr)
    (p1 : Snd (Val (PairV v1 v2)) = fill_item Ki (fill K e1'))
    (base : BaseStep e1' sigma e2' sigma2 efs observations) : Empty
    \elim Ki
  | SndCtx =>
      \let
        | eq : Val (PairV v1 v2) = fill K e1' =>
