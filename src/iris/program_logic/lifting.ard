\lemma wp_lam_expr {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (x : Name) (body : Expr)
    (Phi : Value -> iProp S) :
  (WP H E (Val (LamV x body)) Phi) ⊢
    (WP H E (Lam x body) Phi) =>
  wp_pure_head_step H E (Lam x body) (Val (LamV x body)) idp idp
    (\lam sigma => BasePrim (LamS x body idp idp idp {idp} {idp}))
    (lam_expr_pure_ctx_absurd x body) Phi

\lemma wp_rec_expr {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (f x : Name) (body : Expr)
    (Phi : Value -> iProp S) :
  (WP H E (Val (RecV f x body)) Phi) ⊢
    (WP H E (Rec f x body) Phi) =>
  wp_pure_head_step H E (Rec f x body) (Val (RecV f x body)) idp idp
    (\lam sigma => BasePrim (RecS f x body idp idp idp {idp} {idp}))
    (rec_expr_pure_ctx_absurd f x body) Phi

\lemma wp_pair_values {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (v1 v2 : Value)
    (Phi : Value -> iProp S) :
  (WP H E (Val (PairV v1 v2)) Phi) ⊢
    (WP H E (Pair (Val v1) (Val v2)) Phi) =>
  wp_pure_head_step H E (Pair (Val v1) (Val v2))
    (Val (PairV v1 v2)) idp idp
    (\lam sigma => BasePrim (PairS v1 v2 idp idp idp {idp} {idp}))
    (pair_values_pure_ctx_absurd v1 v2) Phi

\lemma wp_fst_pair {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (v1 v2 : Value)
    (Phi : Value -> iProp S) :
  (WP H E (Val v1) Phi) ⊢
    (WP H E (Fst (Val (PairV v1 v2))) Phi) =>
  wp_pure_head_step H E (Fst (Val (PairV v1 v2))) (Val v1) idp idp
    (\lam sigma => BasePrim (FstS v1 v2 idp idp idp {idp} {idp}))
    (fst_pair_pure_ctx_absurd v1 v2) Phi

\lemma wp_snd_pair {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (v1 v2 : Value)
    (Phi : Value -> iProp S) :
  (WP H E (Val v2) Phi) ⊢
    (WP H E (Snd (Val (PairV v1 v2))) Phi) =>
  wp_pure_head_step H E (Snd (Val (PairV v1 v2))) (Val v2) idp idp
    (\lam sigma => BasePrim (SndS v1 v2 idp idp idp {idp} {idp}))
    (snd_pair_pure_ctx_absurd v1 v2) Phi

\lemma wp_if_true {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (t f : Expr)
    (Phi : Value -> iProp S) :
  (WP H E t Phi) ⊢
    (WP H E (If (Val (boolV true)) t f) Phi) =>
  wp_pure_head_step H E (If (Val (boolV true)) t f) t idp idp
    (\lam sigma => BasePrim (IfTrueS t f idp idp idp {idp} {idp}))
    (if_bool_pure_ctx_absurd true t f) Phi

\lemma wp_if_false {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (t f : Expr)
    (Phi : Value -> iProp S) :
  (WP H E f Phi) ⊢
    (WP H E (If (Val (boolV false)) t f) Phi) =>
  wp_pure_head_step H E (If (Val (boolV false)) t f) f idp idp
    (\lam sigma => BasePrim (IfFalseS t f idp idp idp {idp} {idp}))
    (if_bool_pure_ctx_absurd false t f) Phi

-- Atomic binary operations are deterministic pure steps.  This derived rule
-- is the common WP interface for arithmetic, equality, and location offset.
\lemma wp_binop {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (op : HeapBinOp) (v1 v2 result : Value)
    (evaluates : eval_heap_binop op v1 v2 = just result)
    (Phi : Value -> iProp S)
  : (WP H E (Val result) Phi) ⊢
      (WP H E (BinOp op (Val v1) (Val v2)) Phi) =>
  wp_pure_step H E
    (BinOp op (Val v1) (Val v2)) (Val result)
    (\lam sigma => BasePrim
      (BinOpS op v1 v2 result evaluates idp idp idp {idp} {idp}))
    (\lam sigma e2 sigma2 efs observations hstep =>
      \case binop_step_inv op v1 v2 result evaluates sigma e2 sigma2
          efs observations hstep \with {
        | BinOpStepInvIntro e2_eq sigma2_eq efs_eq observations_eq =>
          (e2_eq, sigma2_eq, efs_eq, observations_eq)
      })
    idp Phi

\lemma wp_nat_add {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (n m : Nat)
    (Phi : Value -> iProp S)
  : (WP H E (Val (natV (n Nat.+ m))) Phi) ⊢
      (WP H E (NatAdd (Val (natV n)) (Val (natV m))) Phi) =>
  wp_binop H E NatAddOp (natV n) (natV m) (natV (n Nat.+ m)) idp Phi

\func eval_nat_eq_true (n m : Nat) (equal : n = m) :
  eval_heap_binop NatEqOp (natV n) (natV m) =
    just (boolV true) =>
  rewrite (decideEq=_reduce equal) idp

\func eval_nat_eq_false (n m : Nat) (different : n = m -> Empty) :
  eval_heap_binop NatEqOp (natV n) (natV m) =
    just (boolV false) =>
  rewrite (decideEq/=_reduce different) idp

\lemma wp_nat_eq_true {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (n m : Nat) (equal : n = m)
    (Phi : Value -> iProp S) :
  (WP H E (Val (boolV true)) Phi) ⊢
    (WP H E (NatEq (Val (natV n)) (Val (natV m))) Phi) =>
  wp_binop H E NatEqOp (natV n) (natV m) (boolV true)
    (eval_nat_eq_true n m equal) Phi

\lemma wp_nat_eq_false {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (n m : Nat)
    (different : n = m -> Empty) (Phi : Value -> iProp S) :
  (WP H E (Val (boolV false)) Phi) ⊢
    (WP H E (NatEq (Val (natV n)) (Val (natV m))) Phi) =>
  wp_binop H E NatEqOp (natV n) (natV m) (boolV false)
    (eval_nat_eq_false n m different) Phi

\lemma wp_loc_add {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (l i : Nat)
    (Phi : Value -> iProp S)
  : (WP H E (Val (LitV (LitLoc (l Nat.+ i)))) Phi) ⊢
      (WP H E (LocAdd (Val (LitV (LitLoc l))) (Val (natV i))) Phi) =>
  wp_binop H E LocAddOp (LitV (LitLoc l)) (natV i)
    (LitV (LitLoc (l Nat.+ i))) idp Phi

-- Fork transfers the spawned thread's WP to the machine's fork obligation and
-- returns unit in the parent.  The statement keeps both resources explicit;
-- later-introduction variants can be derived from the BI later laws.
\lemma wp_fork {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (body : Expr)
    (Phi : Value -> iProp S)
  : ((Phi unitV) ∗
        (WP H coPset_universe body H.iris_fork_post)) ⊢
      (WP H E (Fork body) Phi) =>
  \let
    | Parent => Phi unitV
    | Child => WP H coPset_universe body H.iris_fork_post
    | R => Parent ∗ Child
    | e => Fork body
    | red : \Pi (sigma : State cnt) (allObservations : List Observation) ->
        (R ∗
          (state_interp H sigma allObservations)) ⊢
          (mkProperPure (Reducible e sigma)) =>
        \lam sigma allObservations _ _ _ _ =>
          inP (Val unitV, sigma, body :: nil, nil,
            BasePrim (ForkS body idp idp idp {idp} {idp}))
    | step : \Pi (sigma : State cnt) (e2 : Expr)
        (sigma2 : State cnt) (efs : List Expr)
        (observations futureObservations : List Observation) ->
        PrimStep e sigma e2 sigma2 efs observations -> (R ∗ (state_interp H sigma
            (observations ++ futureObservations))) ⊢
          (|==>
            ((state_interp H sigma2 futureObservations) ∗
              ((WP H E e2 Phi) ∗
                (wp_forks H.iris_fork_post (wp H) efs)))) =>
        \lam sigma e2 sigma2 efs observations futureObservations hstep =>
          \case fork_step_inv body sigma e2 sigma2 efs observations hstep
            \with {
            | ForkStepInvIntro e2_eq sigma2_eq efs_eq observations_eq =>
              \let
                | StateNow => state_interp H sigma futureObservations
                | ParentWP => WP H E (Val unitV) Phi
                | ForksOne => wp_forks H.iris_fork_post (wp H) (body :: nil)
                | Normal => StateNow ∗
                    (ParentWP ∗ ForksOne)
                | childToForks : Child ⊢ ForksOne =>
                    properUPred_ent_trans Child
                      (mkProperEmp ∗ Child) ForksOne
                      ((BIuPredMixin (iResUR S)).bi_mixin_emp_sep_1 Child)
                      (sep_comm_ent mkProperEmp Child)
                | resourcesReady : R ⊢
                    (ParentWP ∗ ForksOne) =>
                    properUPred_ent_trans R
                      (ParentWP ∗ Child)
                      (ParentWP ∗ ForksOne)
                      (sep_mono_l_ent Parent ParentWP Child
                        (wp_value_intro H E unitV Phi))
                      (sep_mono_r_ent ParentWP Child ForksOne childToForks)
                | ready : (R ∗ StateNow) ⊢ Normal =>
                    properUPred_ent_trans
                      (R ∗ StateNow)
                      (StateNow ∗ R) Normal
                      (sep_comm_ent R StateNow)
                      (sep_mono_r_ent StateNow R
                        (ParentWP ∗ ForksOne) resourcesReady)
              \in \lam n x hx hsource =>
                \let
                  | sourceNow : (R ∗ StateNow).upred_holds n x =>
                      transport
                        (\lam obs => (R ∗
                          (state_interp H sigma
                            (obs ++ futureObservations))).upred_holds n x)
                        observations_eq hsource
                  | normal : Normal.upred_holds n x =>
                      ready n x hx sourceNow
                  | updated : (|==> Normal).upred_holds n x =>
                      bupd_intro Normal n x hx normal
                \in transport
                    (\lam fs => (|==>
                      ((state_interp H sigma2 futureObservations) ∗
                        ((WP H E e2 Phi) ∗
                          (wp_forks H.iris_fork_post (wp H) fs))))
                      .upred_holds n x)
                    (inv efs_eq)
                    (transport2
                      (\lam ee ss => (|==>
                        ((state_interp H ss futureObservations) ∗
                          ((WP H E ee Phi) ∗
                            (wp_forks H.iris_fork_post (wp H)
                              (body :: nil)))))
                        .upred_holds n x)
                      (inv e2_eq) (inv sigma2_eq) updated)
          }
  \in wp_lift_atomic H E e Phi R idp red step

-- Generic heap load.  Fractional ownership is preserved, and the returned
-- value is identified by agreement between the authoritative heap and the
-- fragment before the operational step is inverted.
\lemma state_interp_pointsto_valid {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (sigma : State cnt)
    (futureObservations : List Observation)
    (l : Loc) (dq : Dfrac) (v : Value)
  : ((pointsto H.iris_gen_heap l dq v) ∗
        (state_interp H sigma futureObservations)) ⊢
      (mkProperPure (glookup sigma.heap l = just v)) =>
  properUPred_ent_trans
    ((pointsto H.iris_gen_heap l dq v) ∗
      (state_interp H sigma futureObservations))
    (((pointsto H.iris_gen_heap l dq v) ∗
        (gen_heap_interp H.iris_gen_heap sigma.heap)) ∗
      (proph_map_interp H.iris_proph_map futureObservations sigma.usedProph))
    (mkProperPure (glookup sigma.heap l = just v))
    (sep_assoc_r_ent (pointsto H.iris_gen_heap l dq v)
      (gen_heap_interp H.iris_gen_heap sigma.heap)
      (proph_map_interp H.iris_proph_map futureObservations sigma.usedProph))
    (properUPred_ent_trans
      (((pointsto H.iris_gen_heap l dq v) ∗
          (gen_heap_interp H.iris_gen_heap sigma.heap)) ∗
        (proph_map_interp H.iris_proph_map futureObservations sigma.usedProph))
      ((pointsto H.iris_gen_heap l dq v) ∗
        (gen_heap_interp H.iris_gen_heap sigma.heap))
      (mkProperPure (glookup sigma.heap l = just v))
      (sep_elim_l_ent
        ((pointsto H.iris_gen_heap l dq v) ∗
          (gen_heap_interp H.iris_gen_heap sigma.heap))
        (proph_map_interp H.iris_proph_map futureObservations sigma.usedProph))
      (properUPred_ent_trans
        ((pointsto H.iris_gen_heap l dq v) ∗
          (gen_heap_interp H.iris_gen_heap sigma.heap))
        ((gen_heap_interp H.iris_gen_heap sigma.heap) ∗
          (pointsto H.iris_gen_heap l dq v))
        (mkProperPure (glookup sigma.heap l = just v))
        (sep_comm_ent (pointsto H.iris_gen_heap l dq v)
          (gen_heap_interp H.iris_gen_heap sigma.heap))
        (gen_heap_valid H.iris_gen_heap sigma.heap l dq v)))

\lemma state_interp_new_proph {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (sigma : State cnt)
    (futureObservations : List Observation) (p : ProphId)
    (fresh : plookup sigma.usedProph p = nothing)
  : (state_interp H sigma futureObservations) ⊢
      (|==>
        ((state_interp H
            (state_update_usedProph sigma
              (pinsert p () sigma.usedProph)) futureObservations) ∗
          (proph H.iris_proph_map p
            (proph_list_resolves futureObservations p)))) =>
  \let
    | Heap => gen_heap_interp H.iris_gen_heap sigma.heap
    | Old => proph_map_interp H.iris_proph_map
        futureObservations sigma.usedProph
    | New => (proph_map_interp H.iris_proph_map futureObservations
          (pinsert p () sigma.usedProph)) ∗
        (proph H.iris_proph_map p
          (proph_list_resolves futureObservations p))
    | Target => (state_interp H
          (state_update_usedProph sigma
            (pinsert p () sigma.usedProph)) futureObservations) ∗
        (proph H.iris_proph_map p
          (proph_list_resolves futureObservations p))
  \in properUPred_ent_trans
      (Heap ∗ Old)
      (Heap ∗ (|==> New))
      (|==> Target)
      (sep_mono_r_ent Heap Old (|==> New)
        (proph_map_new_proph H.iris_proph_map p sigma.usedProph
          futureObservations
          (\lam used => \case inv used *> fresh \with {})))
      (properUPred_ent_trans
        (Heap ∗ (|==> New))
        (|==> (Heap ∗ New))
        (|==> Target)
        (bupd_frame_l {UPredBiBUpd (iResUR S)} Heap New)
        (bupd_mono (Heap ∗ New) Target
          (sep_assoc_r_ent Heap
            (proph_map_interp H.iris_proph_map futureObservations
              (pinsert p () sigma.usedProph))
            (proph H.iris_proph_map p
              (proph_list_resolves futureObservations p)))))

\lemma state_interp_proph_agree {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (sigma : State cnt)
    (observations : List Observation) (p : ProphId)
    (resolves : List ProphPayload)
  : ((state_interp H sigma observations) ∗
        (proph H.iris_proph_map p resolves)) ⊢
      (mkProperPure
        (\Sigma (gset_in p sigma.usedProph)
          (resolves = proph_list_resolves observations p))) =>
  \let
    | Heap => gen_heap_interp H.iris_gen_heap sigma.heap
    | Interp => proph_map_interp H.iris_proph_map
        observations sigma.usedProph
    | Token => proph H.iris_proph_map p resolves
  \in properUPred_ent_trans
      ((Heap ∗ Interp) ∗ Token)
      (Heap ∗ (Interp ∗ Token))
      (mkProperPure
        (\Sigma (gset_in p sigma.usedProph)
          (resolves = proph_list_resolves observations p)))
      (sep_assoc_l_ent Heap Interp Token)
      (properUPred_ent_trans
        (Heap ∗ (Interp ∗ Token))
        (Interp ∗ Token)
        (mkProperPure
          (\Sigma (gset_in p sigma.usedProph)
            (resolves = proph_list_resolves observations p)))
        (sep_elim_r_ent Heap (Interp ∗ Token))
        (proph_map_agree H.iris_proph_map observations
          sigma.usedProph p resolves))

-- Consume the next trace event while retaining the heap interpretation.  This
-- is the state-level bridge used by Resolve lifting rules: the machine state
-- is unchanged, but its prophecy interpretation advances by one observation.
\lemma state_interp_resolve_proph {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (sigma : State cnt)
    (futureObservations : List Observation) (p : ProphId)
    (value : ProphPayload) (resolves : List ProphPayload)
  : ((state_interp H sigma ((p, value) :: futureObservations)) ∗
        (proph H.iris_proph_map p resolves)) ⊢
      (|==>
        (mkProperExist (List ProphPayload) (\lam remaining =>
          (mkProperPure (resolves = value :: remaining)) ∗
            ((state_interp H sigma futureObservations) ∗
              (proph H.iris_proph_map p remaining))))) =>
  \let
    | Heap => gen_heap_interp H.iris_gen_heap sigma.heap
    | OldInterp => proph_map_interp H.iris_proph_map
        ((p, value) :: futureObservations) sigma.usedProph
    | NewInterp => proph_map_interp H.iris_proph_map
        futureObservations sigma.usedProph
    | Token => proph H.iris_proph_map p resolves
    | ProphBody : List ProphPayload -> iProp S => \lam remaining =>
        (mkProperPure (resolves = value :: remaining)) ∗
          (NewInterp ∗
            (proph H.iris_proph_map p remaining))
    | ProphResult => mkProperExist (List ProphPayload) ProphBody
    | WholeBody : List ProphPayload -> iProp S => \lam remaining =>
        (mkProperPure (resolves = value :: remaining)) ∗
          ((state_interp H sigma futureObservations) ∗
            (proph H.iris_proph_map p remaining))
    | WholeResult => mkProperExist (List ProphPayload) WholeBody
    | arrangeSource : ((Heap ∗ OldInterp) ∗ Token) ⊢
        (Heap ∗ (OldInterp ∗ Token)) =>
        sep_assoc_l_ent Heap OldInterp Token
    | arrangeBody : \Pi (remaining : List ProphPayload) ->
        ((ProphBody remaining) ∗ Heap) ⊢
          (WholeBody remaining) =>
        \lam remaining =>
          \let
            | Pure => mkProperPure (resolves = value :: remaining)
            | Remaining => proph H.iris_proph_map p remaining
            | rearrangeTail : ((NewInterp ∗ Remaining) ∗ Heap) ⊢
                ((Heap ∗ NewInterp) ∗ Remaining) =>
                properUPred_ent_trans
                  ((NewInterp ∗ Remaining) ∗ Heap)
                  (NewInterp ∗ (Remaining ∗ Heap))
                  ((Heap ∗ NewInterp) ∗ Remaining)
                  (sep_assoc_l_ent NewInterp Remaining Heap)
                  (properUPred_ent_trans
                    (NewInterp ∗ (Remaining ∗ Heap))
                    (NewInterp ∗ (Heap ∗ Remaining))
                    ((Heap ∗ NewInterp) ∗ Remaining)
                    (sep_mono_r_ent NewInterp
                      (Remaining ∗ Heap)
                      (Heap ∗ Remaining)
                      (sep_comm_ent Remaining Heap))
                    (properUPred_ent_trans
                      (NewInterp ∗ (Heap ∗ Remaining))
                      ((NewInterp ∗ Heap) ∗ Remaining)
                      ((Heap ∗ NewInterp) ∗ Remaining)
                      (sep_assoc_r_ent NewInterp Heap Remaining)
                      (sep_mono_l_ent
                        (NewInterp ∗ Heap)
                        (Heap ∗ NewInterp) Remaining
                        (sep_comm_ent NewInterp Heap))))
          \in properUPred_ent_trans
              ((Pure ∗ (NewInterp ∗ Remaining)) ∗ Heap)
              (Pure ∗
                ((NewInterp ∗ Remaining) ∗ Heap))
              (Pure ∗
                ((Heap ∗ NewInterp) ∗ Remaining))
              (sep_assoc_l_ent Pure
                (NewInterp ∗ Remaining) Heap)
              (sep_mono_r_ent Pure
                ((NewInterp ∗ Remaining) ∗ Heap)
                ((Heap ∗ NewInterp) ∗ Remaining)
                rearrangeTail)
    | package : (Heap ∗ ProphResult) ⊢
        WholeResult =>
        properUPred_ent_trans
          (Heap ∗ ProphResult)
          (ProphResult ∗ Heap) WholeResult
          (sep_comm_ent Heap ProphResult)
          (sep_exist_l_elim ProphBody Heap WholeResult
            (\lam remaining => properUPred_ent_trans
              ((ProphBody remaining) ∗ Heap)
              (WholeBody remaining) WholeResult
              (arrangeBody remaining)
              (exist_intro_ent WholeBody remaining)))
  \in properUPred_ent_trans
      ((Heap ∗ OldInterp) ∗ Token)
      (Heap ∗ (|==> ProphResult))
      (|==> WholeResult)
      (properUPred_ent_trans
        ((Heap ∗ OldInterp) ∗ Token)
        (Heap ∗ (OldInterp ∗ Token))
        (Heap ∗ (|==> ProphResult))
        arrangeSource
        (sep_mono_r_ent Heap (OldInterp ∗ Token)
          (|==> ProphResult)
          (proph_map_resolve_proph H.iris_proph_map p value
            futureObservations sigma.usedProph resolves)))
      (properUPred_ent_trans
        (Heap ∗ (|==> ProphResult))
        (|==> (Heap ∗ ProphResult))
        (|==> WholeResult)
        (bupd_frame_l {UPredBiBUpd (iResUR S)} Heap ProphResult)
        (bupd_mono (Heap ∗ ProphResult) WholeResult package))

\lemma state_interp_pointsto_update {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (sigma : State cnt)
    (futureObservations : List Observation)
    (l : Loc) (old new : Value)
  : ((state_interp H sigma futureObservations) ∗
        (pointsto_full H.iris_gen_heap l old)) ⊢
      (|==>
        ((state_interp H
            (state_update_heap sigma (heap_update sigma.heap l new))
            futureObservations) ∗
          (pointsto_full H.iris_gen_heap l new))) =>
  \let
    | Heap => gen_heap_interp H.iris_gen_heap sigma.heap
    | Heap' => gen_heap_interp H.iris_gen_heap
        (heap_update sigma.heap l new)
    | Proph => proph_map_interp H.iris_proph_map
        futureObservations sigma.usedProph
    | Old => pointsto_full H.iris_gen_heap l old
    | New => pointsto_full H.iris_gen_heap l new
    | Updated => (Heap' ∗ New) ∗ Proph
    | Target => (Heap' ∗ Proph) ∗ New
    | arrange : ((Heap ∗ Proph) ∗ Old) ⊢
        ((Heap ∗ Old) ∗ Proph) =>
        properUPred_ent_trans
          ((Heap ∗ Proph) ∗ Old)
          (Heap ∗ (Proph ∗ Old))
          ((Heap ∗ Old) ∗ Proph)
          (sep_assoc_l_ent Heap Proph Old)
          (properUPred_ent_trans
            (Heap ∗ (Proph ∗ Old))
            (Heap ∗ (Old ∗ Proph))
            ((Heap ∗ Old) ∗ Proph)
            (sep_mono_r_ent Heap (Proph ∗ Old)
              (Old ∗ Proph) (sep_comm_ent Proph Old))
            (sep_assoc_r_ent Heap Old Proph))
    | finish : Updated ⊢ Target =>
        properUPred_ent_trans Updated
          (Heap' ∗ (New ∗ Proph)) Target
          (sep_assoc_l_ent Heap' New Proph)
          (properUPred_ent_trans
            (Heap' ∗ (New ∗ Proph))
            (Heap' ∗ (Proph ∗ New)) Target
            (sep_mono_r_ent Heap' (New ∗ Proph)
              (Proph ∗ New) (sep_comm_ent New Proph))
            (sep_assoc_r_ent Heap' Proph New))
  \in properUPred_ent_trans
      ((Heap ∗ Proph) ∗ Old)
      ((Heap ∗ Old) ∗ Proph)
      (|==> Target)
      arrange
      (properUPred_ent_trans
        ((Heap ∗ Old) ∗ Proph)
        ((|==> (Heap' ∗ New)) ∗ Proph)
        (|==> Target)
        (sep_mono_l_ent (Heap ∗ Old)
          (|==> (Heap' ∗ New)) Proph
          (gen_heap_update H.iris_gen_heap sigma.heap l old new))
        (properUPred_ent_trans
          ((|==> (Heap' ∗ New)) ∗ Proph)
          (|==> Updated) (|==> Target)
          (bupd_frame_r (Heap' ∗ New) Proph)
          (bupd_mono Updated Target finish)))

\lemma state_interp_alloc {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (sigma : State cnt)
    (futureObservations : List Observation) (l : Loc) (v : Value)
    (fresh : glookup sigma.heap l = nothing)
  : (state_interp H sigma futureObservations) ⊢
      (|==>
        ((state_interp H
            (state_update_heap sigma (heap_update sigma.heap l v))
            futureObservations) ∗
          (pointsto_full H.iris_gen_heap l v))) =>
  \let
    | Heap => gen_heap_interp H.iris_gen_heap sigma.heap
    | Heap' => gen_heap_interp H.iris_gen_heap
        (heap_update sigma.heap l v)
    | Proph => proph_map_interp H.iris_proph_map
        futureObservations sigma.usedProph
    | Token => pointsto_full H.iris_gen_heap l v
    | Updated => (Heap' ∗ Token) ∗ Proph
    | Target => (Heap' ∗ Proph) ∗ Token
    | finish : Updated ⊢ Target =>
        properUPred_ent_trans Updated
          (Heap' ∗ (Token ∗ Proph)) Target
          (sep_assoc_l_ent Heap' Token Proph)
          (properUPred_ent_trans
            (Heap' ∗ (Token ∗ Proph))
            (Heap' ∗ (Proph ∗ Token)) Target
            (sep_mono_r_ent Heap' (Token ∗ Proph)
              (Proph ∗ Token) (sep_comm_ent Token Proph))
            (sep_assoc_r_ent Heap' Proph Token))
  \in properUPred_ent_trans
      (Heap ∗ Proph)
      ((|==> (Heap' ∗ Token)) ∗ Proph)
      (|==> Target)
      (sep_mono_l_ent Heap
        (|==> (Heap' ∗ Token)) Proph
        (gen_heap_alloc H.iris_gen_heap sigma.heap l
          (DfracOwn qp_one) v fresh RatField.<=-refl))
      (properUPred_ent_trans
        ((|==> (Heap' ∗ Token)) ∗ Proph)
        (|==> Updated) (|==> Target)
        (bupd_frame_r (Heap' ∗ Token) Proph)
        (bupd_mono Updated Target finish))

-- Bulk allocation is repeated singleton allocation, but kept as one exported
-- rule so clients do not have to manipulate the authoritative heap or nested
-- basic updates.  The operational heap and the ownership block advance in the
-- same left-to-right order.
\lemma state_interp_alloc_block {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (sigma : State cnt)
    (futureObservations : List Observation) (l n : Nat) (v : Value)
    (fresh : heap_block_fresh sigma.heap l n)
  : (state_interp H sigma futureObservations) ⊢
      (|==>
        ((state_interp H
            (state_update_heap sigma
              (heap_insert_block sigma.heap l n v))
            futureObservations) ∗
          (pointsto_block H.iris_gen_heap suc l n v)))
  \elim n
  | 0 =>
      \let
        | State0 => state_interp H sigma futureObservations
        | Target => (state_interp H (state_update_heap sigma sigma.heap)
              futureObservations) ∗
            mkProperEmp
        | pair : State0 ⊢ Target =>
            properUPred_ent_trans State0
              (mkProperEmp ∗ State0) Target
              ((BIuPredMixin (iResUR S)).bi_mixin_emp_sep_1 State0)
              (sep_comm_ent mkProperEmp State0)
      \in properUPred_ent_trans State0 Target (|==> Target)
          pair (bupd_intro Target)
  | suc n =>
      \let
        | sigmaHead : State cnt => state_update_heap sigma
            (heap_update sigma.heap l v)
        | Head => pointsto_full H.iris_gen_heap l v
        | Tail => pointsto_block H.iris_gen_heap suc (suc l) n v
        | StateHead => state_interp H sigmaHead futureObservations
        | StateFinal => state_interp H
            (state_update_heap sigma
              (heap_insert_block sigma.heap l (suc n) v))
            futureObservations
        | AfterHead => StateHead ∗ Head
        | Target => StateFinal ∗ (Head ∗ Tail)
        | freshTail : heap_block_fresh sigmaHead.heap (suc l) n =>
            heap_block_fresh_insert_head sigma.heap l n v fresh.2
        | tailUpdate : StateHead ⊢
            (|==> (StateFinal ∗ Tail)) =>
            state_interp_alloc_block H sigmaHead futureObservations
              (suc l) n v freshTail
        | finish : ((StateFinal ∗ Tail) ∗ Head) ⊢ Target =>
            properUPred_ent_trans
              ((StateFinal ∗ Tail) ∗ Head)
              (StateFinal ∗ (Tail ∗ Head)) Target
              (sep_assoc_l_ent StateFinal Tail Head)
              (sep_mono_r_ent StateFinal
                (Tail ∗ Head) (Head ∗ Tail)
                (sep_comm_ent Tail Head))
        | continue : AfterHead ⊢ (|==> Target) =>
            properUPred_ent_trans AfterHead
              ((|==>
                (StateFinal ∗ Tail)) ∗ Head)
              (|==> Target)
              (sep_mono_l_ent StateHead
                (|==> (StateFinal ∗ Tail)) Head tailUpdate)
              (properUPred_ent_trans
                ((|==>
                  (StateFinal ∗ Tail)) ∗ Head)
                (|==>
                  ((StateFinal ∗ Tail) ∗ Head))
                (|==> Target)
                (bupd_frame_r (StateFinal ∗ Tail) Head)
                (bupd_mono
                  ((StateFinal ∗ Tail) ∗ Head)
                  Target finish))
        | first : (state_interp H sigma futureObservations) ⊢
            (|==> AfterHead) =>
            state_interp_alloc H sigma futureObservations l v fresh.1
      \in properUPred_ent_trans
          (state_interp H sigma futureObservations)
          (|==> AfterHead) (|==> Target) first
          (properUPred_ent_trans
            (|==> AfterHead)
            (|==> (|==> Target))
            (|==> Target)
            (bupd_mono AfterHead (|==> Target) continue)
            (bupd_trans Target))

\lemma state_interp_store_resolve {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (sigma : State cnt)
    (futureObservations : List Observation)
    (l : Loc) (old new : Value) (p : ProphId) (w : Value)
    (resolves : List ProphPayload)
  : (((state_interp H sigma
            ((p, (LitV LitUnit, w)) :: futureObservations)) ∗
          (pointsto_full H.iris_gen_heap l old)) ∗
        (proph H.iris_proph_map p resolves)) ⊢
      (|==>
        (mkProperExist (List ProphPayload) (\lam remaining =>
          (mkProperPure
              (resolves = (LitV LitUnit, w) :: remaining)) ∗
            (((state_interp H
                  (state_update_heap sigma
                    (heap_update sigma.heap l new))
                  futureObservations) ∗
                (pointsto_full H.iris_gen_heap l new)) ∗
              (proph H.iris_proph_map p remaining))))) =>
  \let
    | event : ProphPayload => (LitV LitUnit, w)
    | sigma' => state_update_heap sigma (heap_update sigma.heap l new)
    | StateEvent => state_interp H sigma ((p, event) :: futureObservations)
    | StateFuture => state_interp H sigma' futureObservations
    | Old => pointsto_full H.iris_gen_heap l old
    | New => pointsto_full H.iris_gen_heap l new
    | Token => proph H.iris_proph_map p resolves
    | AfterStore => (state_interp H sigma' ((p, event) :: futureObservations)) ∗ New
    | ResolveBody : List ProphPayload -> iProp S => \lam remaining =>
        (mkProperPure (resolves = event :: remaining)) ∗
          (StateFuture ∗
            (proph H.iris_proph_map p remaining))
    | ResolveResult => mkProperExist (List ProphPayload) ResolveBody
    | FinalBody : List ProphPayload -> iProp S => \lam remaining =>
        (mkProperPure (resolves = event :: remaining)) ∗
          ((StateFuture ∗ New) ∗
            (proph H.iris_proph_map p remaining))
    | FinalResult => mkProperExist (List ProphPayload) FinalBody
    | first : ((StateEvent ∗ Old) ∗ Token) ⊢
        (|==> (AfterStore ∗ Token)) =>
        properUPred_ent_trans
          ((StateEvent ∗ Old) ∗ Token)
          ((|==> AfterStore) ∗ Token)
          (|==> (AfterStore ∗ Token))
          (sep_mono_l_ent (StateEvent ∗ Old)
            (|==> AfterStore) Token
            (state_interp_pointsto_update H sigma
              ((p, event) :: futureObservations) l old new))
          (bupd_frame_r AfterStore Token)
    | arrangeSecond : (AfterStore ∗ Token) ⊢
        (((state_interp H sigma' ((p, event) :: futureObservations)) ∗
            Token) ∗ New) =>
        \let State' => state_interp H sigma'
              ((p, event) :: futureObservations)
        \in properUPred_ent_trans
          ((State' ∗ New) ∗ Token)
          (State' ∗ (New ∗ Token))
          ((State' ∗ Token) ∗ New)
          (sep_assoc_l_ent State' New Token)
          (properUPred_ent_trans
            (State' ∗ (New ∗ Token))
            (State' ∗ (Token ∗ New))
            ((State' ∗ Token) ∗ New)
            (sep_mono_r_ent State' (New ∗ Token)
              (Token ∗ New) (sep_comm_ent New Token))
            (sep_assoc_r_ent State' Token New))
    | package : (ResolveResult ∗ New) ⊢
        FinalResult =>
        sep_exist_l_elim ResolveBody New FinalResult (\lam remaining =>
          \let
            | Pure => mkProperPure (resolves = event :: remaining)
            | Remaining => proph H.iris_proph_map p remaining
            | rearrange : ((Pure ∗
                    (StateFuture ∗ Remaining)) ∗ New) ⊢
                (FinalBody remaining) =>
                properUPred_ent_trans
                  ((Pure ∗
                      (StateFuture ∗ Remaining)) ∗ New)
                  (Pure ∗
                    ((StateFuture ∗ Remaining) ∗ New))
                  (FinalBody remaining)
                  (sep_assoc_l_ent Pure
                    (StateFuture ∗ Remaining) New)
                  (properUPred_ent_trans
                    (Pure ∗
                      ((StateFuture ∗ Remaining) ∗ New))
                    (Pure ∗
                      (StateFuture ∗
                        (Remaining ∗ New)))
                    (FinalBody remaining)
                    (sep_mono_r_ent Pure
                      ((StateFuture ∗ Remaining) ∗ New)
                      (StateFuture ∗
                        (Remaining ∗ New))
                      (sep_assoc_l_ent StateFuture Remaining New))
                    (properUPred_ent_trans
                      (Pure ∗
                        (StateFuture ∗
                          (Remaining ∗ New)))
                      (Pure ∗
                        (StateFuture ∗
                          (New ∗ Remaining)))
                      (FinalBody remaining)
                      (sep_mono_r_ent Pure
                        (StateFuture ∗
                          (Remaining ∗ New))
                        (StateFuture ∗
                          (New ∗ Remaining))
                        (sep_mono_r_ent StateFuture
                          (Remaining ∗ New)
                          (New ∗ Remaining)
                          (sep_comm_ent Remaining New)))
                      (sep_mono_r_ent Pure
                        (StateFuture ∗
                          (New ∗ Remaining))
                        ((StateFuture ∗ New) ∗ Remaining)
                        (sep_assoc_r_ent StateFuture New Remaining))))
          \in properUPred_ent_trans
              ((ResolveBody remaining) ∗ New)
              (FinalBody remaining) FinalResult rearrange
              (exist_intro_ent FinalBody remaining))
    | second : (AfterStore ∗ Token) ⊢
        (|==> FinalResult) =>
        properUPred_ent_trans
          (AfterStore ∗ Token)
          ((|==> ResolveResult) ∗ New)
          (|==> FinalResult)
          (properUPred_ent_trans
            (AfterStore ∗ Token)
            (((state_interp H sigma'
                  ((p, event) :: futureObservations)) ∗ Token) ∗ New)
            ((|==> ResolveResult) ∗ New)
            arrangeSecond
            (sep_mono_l_ent
              ((state_interp H sigma'
                  ((p, event) :: futureObservations)) ∗ Token)
              (|==> ResolveResult) New
              (state_interp_resolve_proph H sigma' futureObservations
                p event resolves)))
          (properUPred_ent_trans
            ((|==> ResolveResult) ∗ New)
            (|==> (ResolveResult ∗ New))
            (|==> FinalResult)
            (bupd_frame_r ResolveResult New)
            (bupd_mono (ResolveResult ∗ New)
              FinalResult package))
  \in properUPred_ent_trans
      ((StateEvent ∗ Old) ∗ Token)
      (|==> (AfterStore ∗ Token))
      (|==> FinalResult) first
      (properUPred_ent_trans
        (|==> (AfterStore ∗ Token))
        (|==> (|==> FinalResult))
        (|==> FinalResult)
        (bupd_mono (AfterStore ∗ Token)
          (|==> FinalResult) second)
        (bupd_trans FinalResult))

\lemma wp_new_proph {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
  : mkProperEmp ⊢
      (WP H E NewProph (\lam w =>
        mkProperExist ProphId (\lam p =>
          mkProperExist (List ProphPayload) (\lam resolves =>
            (mkProperPure (w = LitV (LitProphecy p))) ∧
              (proph H.iris_proph_map p resolves))))) =>
  \let
    | Phi : Value -> iProp S => \lam w =>
        mkProperExist ProphId (\lam p =>
          mkProperExist (List ProphPayload) (\lam resolves =>
            (mkProperPure (w = LitV (LitProphecy p))) ∧
              (proph H.iris_proph_map p resolves)))
    | red : \Pi (sigma : State cnt) (allObservations : List Observation) ->
        (mkProperEmp ∗
            (state_interp H sigma allObservations)) ⊢
          (mkProperPure (Reducible NewProph sigma)) =>
        \lam sigma allObservations _ _ _ _ =>
          \let fresh => state_fresh_proph sigma
          \in inP (Val (LitV (LitProphecy fresh.1)),
            state_update_usedProph sigma
              (pinsert fresh.1 () sigma.usedProph),
            nil, nil,
            BasePrim (NewProphS fresh.1 fresh.2 idp idp idp
              {idp} {idp}))
    | step : \Pi (sigma : State cnt) (e2 : Expr)
        (sigma2 : State cnt) (efs : List Expr)
        (observations futureObservations : List Observation) ->
        PrimStep NewProph sigma e2 sigma2 efs observations ->
        (mkProperEmp ∗
            (state_interp H sigma
              (observations ++ futureObservations))) ⊢
          (|==>
            ((state_interp H sigma2 futureObservations) ∗
              ((WP H E e2 Phi) ∗
                (wp_forks H.iris_fork_post (wp H) efs)))) =>
        \lam sigma e2 sigma2 efs observations futureObservations hstep
          n x hx hsource =>
          \case new_proph_step_inv sigma e2 sigma2 efs observations
              hstep \with {
            | NewProphStepInvIntro p fresh e2eq sigma2eq efseq obseq =>
              \let
                | sigma' => state_update_usedProph sigma
                    (pinsert p () sigma.usedProph)
                | predicted => proph_list_resolves futureObservations p
                | Token => proph H.iris_proph_map p predicted
                | Updated => (state_interp H sigma' futureObservations) ∗ Token
                | Target => (state_interp H sigma2 futureObservations) ∗
                    ((WP H E e2 Phi) ∗
                      (wp_forks H.iris_fork_post (wp H) efs))
                | stateAll : (state_interp H sigma
                    (observations ++ futureObservations))
                    .upred_holds n x =>
                    ((BIuPredMixin (iResUR S)).bi_mixin_emp_sep_2
                      (state_interp H sigma
                        (observations ++ futureObservations)))
                      n x hx hsource
                | stateFuture : (state_interp H sigma futureObservations)
                    .upred_holds n x =>
                    transport
                      (\lam obs => (state_interp H sigma
                        (obs ++ futureObservations)).upred_holds n x)
                      obseq stateAll
                | finish : Updated ⊢ Target =>
                    \lam k y hy hupdated => \case hupdated \with {
                      | inP (astate, atoken, dy, hstate, htoken) =>
                        \let
                          | M => iResUR S
                          | hy_parts : M.validN k
                              (M.op astate atoken) =>
                              M.cmra_validN_ne k y
                                (M.op astate atoken) dy hy
                          | token_valid : M.validN k atoken =>
                              cmra_validN_op_r {M} k astate atoken hy_parts
                          | hPhi : (Phi (LitV (LitProphecy p)))
                              .upred_holds k atoken =>
                              inP (p, inP (predicted, (idp, htoken)))
                          | hwp : (WP H E
                              (Val (LitV (LitProphecy p))) Phi)
                              .upred_holds k atoken =>
                              wp_value_intro H E
                                (LitV (LitProphecy p)) Phi
                                k atoken token_valid hPhi
                          | result : ((state_interp H sigma' futureObservations) ∗
                              (WP H E (Val (LitV (LitProphecy p))) Phi))
                              .upred_holds k y =>
                              inP (astate, atoken, dy, hstate, hwp)
                        \in transport
                          (\lam fs => ((state_interp H sigma2 futureObservations) ∗
                            ((WP H E e2 Phi) ∗
                              (wp_forks H.iris_fork_post
                                (wp H) fs))).upred_holds k y)
                          (inv efseq)
                          (transport2
                            (\lam ee ss => ((state_interp H ss futureObservations) ∗
                              ((WP H E ee Phi) ∗
                                (wp_forks H.iris_fork_post
                                  (wp H) nil))).upred_holds k y)
                            (inv e2eq) (inv sigma2eq)
                            (wp_add_empty_forks H E sigma'
                              futureObservations
                              (Val (LitV (LitProphecy p))) Phi
                              k y hy result))
                    }
              \in properUPred_ent_trans
                  (state_interp H sigma futureObservations)
                  (|==> Updated)
                  (|==> Target)
                  (state_interp_new_proph H sigma futureObservations p fresh)
                  (bupd_mono Updated Target finish)
                  n x hx stateFuture
          }
  \in wp_lift_atomic H E NewProph Phi mkProperEmp idp red step

-- NewProph with a one-step-delayed logical frame.  The atomic allocation
-- consumes the later and exposes both the fresh prophecy token and the frame
-- to the client transition.
\lemma wp_new_proph_later_frame {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (Rafter : iProp S)
    (Phi : Value -> iProp S)
    (transition : \Pi (p : ProphId) (resolves : List ProphPayload) ->
      ((proph H.iris_proph_map p resolves) ∗ Rafter) ⊢
        (|==> (Phi (LitV (LitProphecy p))))) :
  (mkProperEmp ∗ (|> Rafter)) ⊢
    (WP H E NewProph Phi) =>
  \let
    | R => mkProperEmp {iResUR S}
    | e => NewProph
    | dropDelayed : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> ((R ∗ (|> Rafter)) ∗
          (state_interp H sigma allObservations)) ⊢
        (state_interp H sigma allObservations) =>
        \lam sigma allObservations =>
          properUPred_ent_trans
            ((R ∗ (|> Rafter)) ∗
              (state_interp H sigma allObservations))
            (R ∗
              ((|> Rafter) ∗
                (state_interp H sigma allObservations)))
            (state_interp H sigma allObservations)
            (sep_assoc_l_ent R (|> Rafter)
              (state_interp H sigma allObservations))
            (properUPred_ent_trans
              (R ∗
                ((|> Rafter) ∗
                  (state_interp H sigma allObservations)))
              ((|> Rafter) ∗
                (state_interp H sigma allObservations))
              (state_interp H sigma allObservations)
              (sep_elim_r_ent R
                ((|> Rafter) ∗
                  (state_interp H sigma allObservations)))
              (sep_elim_r_ent (|> Rafter)
                (state_interp H sigma allObservations)))
    | red : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> ((R ∗ (|> Rafter)) ∗
          (state_interp H sigma allObservations)) ⊢
        (mkProperPure (Reducible e sigma)) =>
        \lam sigma allObservations n x hx hs =>
          \let | fresh => state_fresh_proph sigma
          | _state => dropDelayed sigma allObservations n x hx hs
          \in inP (Val (LitV (LitProphecy fresh.1)),
            state_update_usedProph sigma
              (pinsert fresh.1 () sigma.usedProph),
            nil, nil,
            BasePrim (NewProphS fresh.1 fresh.2 idp idp idp
              {idp} {idp}))
    | step : \Pi (sigma : State cnt) (e2 : Expr)
        (sigma2 : State cnt) (efs : List Expr)
        (observations futureObservations : List Observation) ->
        PrimStep e sigma e2 sigma2 efs observations -> ((R ∗ Rafter) ∗
            (state_interp H sigma
              (observations ++ futureObservations))) ⊢
          (|==>
            ((state_interp H sigma2 futureObservations) ∗
              ((WP H E e2 Phi) ∗
                (wp_forks H.iris_fork_post (wp H) efs)))) =>
        \lam sigma e2 sigma2 efs observations futureObservations hstep =>
          \case new_proph_step_inv sigma e2 sigma2 efs observations
              hstep \with {
            | NewProphStepInvIntro p fresh e2Eq sigma2Eq efsEq obsEq =>
              \let
                | sigmaNew => state_update_usedProph sigma
                    (pinsert p () sigma.usedProph)
                | predicted => proph_list_resolves futureObservations p
                | Token => proph H.iris_proph_map p predicted
                | StateFuture => state_interp H sigma futureObservations
                | StateNew => state_interp H sigmaNew futureObservations
                | Updated => StateNew ∗ Token
                | StatePost => StateNew ∗
                    (Phi (LitV (LitProphecy p)))
                | SourceAll => (R ∗ Rafter) ∗
                    (state_interp H sigma
                      (observations ++ futureObservations))
                | Target => (state_interp H sigma2 futureObservations) ∗
                    ((WP H E e2 Phi) ∗
                      (wp_forks H.iris_fork_post (wp H) efs))
                | trim : SourceAll ⊢
                    (Rafter ∗ StateFuture) =>
                    properUPred_ent_trans SourceAll
                      (R ∗
                        (Rafter ∗
                          (state_interp H sigma
                            (observations ++ futureObservations))))
                      (Rafter ∗ StateFuture)
                      (sep_assoc_l_ent R Rafter
                        (state_interp H sigma
                          (observations ++ futureObservations)))
                      (properUPred_ent_trans
                        (R ∗
                          (Rafter ∗
                            (state_interp H sigma
                              (observations ++ futureObservations))))
                        (Rafter ∗
                          (state_interp H sigma
                            (observations ++ futureObservations)))
                        (Rafter ∗ StateFuture)
                        (sep_elim_r_ent R
                          (Rafter ∗
                            (state_interp H sigma
                              (observations ++ futureObservations))))
                        (sep_mono_r_ent Rafter
                          (state_interp H sigma
                            (observations ++ futureObservations))
                          StateFuture
                          (\lam n x _ hstate => transport
                            (\lam obs => (state_interp H sigma
                              (obs ++ futureObservations)).upred_holds n x)
                            obsEq hstate)))
                | updatedFrame : (Rafter ∗ StateFuture) ⊢
                    (|==>
                      (Updated ∗ Rafter)) =>
                    properUPred_ent_trans
                      (Rafter ∗ StateFuture)
                      (StateFuture ∗ Rafter)
                      (|==> (Updated ∗ Rafter))
                      (sep_comm_ent Rafter StateFuture)
                      (properUPred_ent_trans
                        (StateFuture ∗ Rafter)
                        ((|==> Updated) ∗ Rafter)
                        (|==> (Updated ∗ Rafter))
                        (sep_mono_l_ent StateFuture
                          (|==> Updated) Rafter
                          (state_interp_new_proph H sigma
                            futureObservations p fresh))
                        (bupd_frame_r Updated Rafter))
                | client : (Updated ∗ Rafter) ⊢
                    (|==> StatePost) =>
                    properUPred_ent_trans
                      ((StateNew ∗ Token) ∗ Rafter)
                      (StateNew ∗ (Token ∗ Rafter))
                      (|==> StatePost)
                      (sep_assoc_l_ent StateNew Token Rafter)
                      (properUPred_ent_trans
                        (StateNew ∗
                          (Token ∗ Rafter))
                        (StateNew ∗
                          (|==>
                            (Phi (LitV (LitProphecy p)))))
                        (|==> StatePost)
                        (sep_mono_r_ent StateNew
                          (Token ∗ Rafter)
                          (|==>
                            (Phi (LitV (LitProphecy p))))
                          (transition p predicted))
                        (bupd_frame_l {UPredBiBUpd (iResUR S)} StateNew
                          (Phi (LitV (LitProphecy p)))))
                | updatedClient : (|==> (Updated ∗ Rafter)) ⊢
                    (|==> StatePost) =>
                    properUPred_ent_trans
                      (|==> (Updated ∗ Rafter))
                      (|==> (|==> StatePost))
                      (|==> StatePost)
                      (bupd_mono (Updated ∗ Rafter)
                        (|==> StatePost) client)
                      (bupd_trans StatePost)
                | valueFinish : StatePost ⊢ Target =>
                    \lam n x hx hs => \case hs \with {
                      | inP (ast, ar, dx, hstate, hphi) =>
                        \let
                          | M => iResUR S
                          | hxParts : M.validN n (M.op ast ar) =>
                              M.cmra_validN_ne n x (M.op ast ar) dx hx
                          | hrValid : M.validN n ar =>
                              cmra_validN_op_r {M} n ast ar hxParts
                          | hwp : (WP H E
                              (Val (LitV (LitProphecy p))) Phi)
                              .upred_holds n ar =>
                              wp_value_intro H E
                                (LitV (LitProphecy p)) Phi
                                n ar hrValid hphi
                          | result : (StateNew ∗
                              (WP H E (Val (LitV (LitProphecy p))) Phi))
                              .upred_holds n x =>
                              inP (ast, ar, dx, hstate, hwp)
                        \in transport
                          (\lam fs => ((state_interp H sigma2 futureObservations) ∗
                            ((WP H E e2 Phi) ∗
                              (wp_forks H.iris_fork_post
                                (wp H) fs))).upred_holds n x)
                          (inv efsEq)
                          (transport2
                            (\lam ee ss => ((state_interp H ss futureObservations) ∗
                              ((WP H E ee Phi) ∗
                                (wp_forks H.iris_fork_post
                                  (wp H) nil))).upred_holds n x)
                            (inv e2Eq) (inv sigma2Eq)
                            (wp_add_empty_forks H E sigmaNew
                              futureObservations
                              (Val (LitV (LitProphecy p))) Phi
                              n x hx result))
                    }
              \in properUPred_ent_trans SourceAll
                  (Rafter ∗ StateFuture)
                  (|==> Target) trim
                  (properUPred_ent_trans
                    (Rafter ∗ StateFuture)
                    (|==> (Updated ∗ Rafter))
                    (|==> Target) updatedFrame
                    (properUPred_ent_trans
                      (|==> (Updated ∗ Rafter))
                      (|==> StatePost)
                      (|==> Target) updatedClient
                      (bupd_mono StatePost Target valueFinish)))
          }
  \in wp_lift_atomic_later_frame H E e Phi R Rafter idp red step

\lemma wp_load {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (l : Loc) (dq : Dfrac) (v : Value)
  : (pointsto H.iris_gen_heap l dq v) ⊢
      (WP H E (Load (Val (LitV (LitLoc l))))
        (\lam w => (mkProperPure (w = v)) ∧
          (pointsto H.iris_gen_heap l dq v))) =>
  \let
    | R => pointsto H.iris_gen_heap l dq v
    | e => Load (Val (LitV (LitLoc l)))
    | Phi : Value -> iProp S => \lam w =>
        (mkProperPure (w = v)) ∧ R
    | lookup_of : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> (R ∗ (state_interp H sigma allObservations)) ⊢
        (mkProperPure (glookup sigma.heap l = just v)) =>
        \lam sigma allObservations =>
          state_interp_pointsto_valid H sigma allObservations l dq v
    | red : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> (R ∗ (state_interp H sigma allObservations)) ⊢
        (mkProperPure (Reducible e sigma)) =>
        \lam sigma allObservations n x hx hs =>
          \let lookup => lookup_of sigma allObservations n x hx hs
          \in inP (Val v, sigma, nil, nil,
            BasePrim (LoadS l v lookup idp idp idp {idp} {idp}))
    | step : \Pi (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt)
        (efs : List Expr)
        (observations futureObservations : List Observation) ->
        PrimStep e sigma e2 sigma2 efs observations -> (R ∗ (state_interp H sigma
            (observations ++ futureObservations))) ⊢
          (|==>
            ((state_interp H sigma2 futureObservations) ∗
              ((WP H E e2 Phi) ∗
                (wp_forks H.iris_fork_post (wp H) efs)))) =>
        \lam sigma e2 sigma2 efs observations futureObservations
          hstep n x hx hs =>
          \let
            | M => iResUR S
            | lookup => lookup_of sigma
                (observations ++ futureObservations) n x hx hs
            | invStep => load_step_inv l v sigma e2 sigma2 efs
                observations lookup hstep
          \in \case hs \with {
            | inP (ar, ast, dx, hr, hstate) =>
              \let
                | hx_parts : M.validN n (M.op ar ast) =>
                    M.cmra_validN_ne n x (M.op ar ast) dx hx
                | hr_valid : M.validN n ar =>
                    M.cmra_validN_op_l n ar ast hx_parts
                | hwp : (WP H E (Val v) Phi).upred_holds n ar =>
                    wp_value_intro H E v Phi n ar hr_valid (idp, hr)
                | dswap : M.dist n x (M.op ast ar) =>
                    M.ofe_dist_trans n x (M.op ar ast) (M.op ast ar)
                      dx (cmra_comm_dist {M} n ar ast)
                | transported : ((state_interp H sigma2 futureObservations) ∗
                    ((WP H E e2 Phi) ∗
                      (wp_forks H.iris_fork_post (wp H) efs)))
                    .upred_holds n x =>
                    \case invStep \with {
                      | LoadStepInvIntro e2_eq sigma2_eq efs_eq obs_eq =>
                        \let
                          | hstateFuture : (state_interp H sigma
                              futureObservations).upred_holds n ast =>
                              transport
                                (\lam obs => (state_interp H sigma
                                  (obs ++ futureObservations))
                                  .upred_holds n ast)
                                obs_eq hstate
                          | hresult : ((state_interp H sigma futureObservations) ∗
                              (WP H E (Val v) Phi)).upred_holds n x =>
                              inP (ast, ar, dswap, hstateFuture, hwp)
                        \in
                        transport
                          (\lam fs => ((state_interp H sigma2 futureObservations) ∗
                            ((WP H E e2 Phi) ∗
                              (wp_forks H.iris_fork_post
                                (wp H) fs))).upred_holds n x)
                          (inv efs_eq)
                          (transport2
                            (\lam ee ss =>
                              ((state_interp H ss futureObservations) ∗
                                ((WP H E ee Phi) ∗
                                  (wp_forks H.iris_fork_post
                                    (wp H) nil))).upred_holds n x)
                            (inv e2_eq) (inv sigma2_eq)
                            (wp_add_empty_forks H E sigma
                              futureObservations (Val v) Phi
                              n x hx hresult))
                    }
              \in bupd_intro
                ((state_interp H sigma2 futureObservations) ∗
                  ((WP H E e2 Phi) ∗
                    (wp_forks H.iris_fork_post (wp H) efs)))
                n x hx transported
          }
  \in wp_lift_atomic H E e Phi R idp red step

-- Load with a one-step-delayed logical frame.  This is the read-only
-- companion of `wp_faa_later_frame`: the physical points-to is preserved,
-- while the delayed invariant resources become available to the client
-- transition after the atomic load step.
\lemma wp_load_later_frame {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (l : Loc) (dq : Dfrac) (v : Value) (Rafter : iProp S)
    (Phi : Value -> iProp S)
    (transition : ((pointsto H.iris_gen_heap l dq v) ∗ Rafter) ⊢
      (|==> (Phi v))) :
  ((pointsto H.iris_gen_heap l dq v) ∗
      (|> Rafter)) ⊢
    (WP H E (Load (Val (LitV (LitLoc l)))) Phi) =>
  \let
    | R => pointsto H.iris_gen_heap l dq v
    | e => Load (Val (LitV (LitLoc l)))
    | lookup_of : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> (R ∗ (state_interp H sigma allObservations)) ⊢
        (mkProperPure (glookup sigma.heap l = just v)) =>
        \lam sigma allObservations =>
          state_interp_pointsto_valid H sigma allObservations l dq v
    | dropDelayed : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> ((R ∗ (|> Rafter)) ∗
          (state_interp H sigma allObservations)) ⊢
        (R ∗ (state_interp H sigma allObservations)) =>
        \lam sigma allObservations =>
          \let StateP => state_interp H sigma allObservations
          \in properUPred_ent_trans
            ((R ∗ (|> Rafter)) ∗ StateP)
            (R ∗
              ((|> Rafter) ∗ StateP))
            (R ∗ StateP)
            (sep_assoc_l_ent R (|> Rafter) StateP)
            (sep_mono_r_ent R
              ((|> Rafter) ∗ StateP) StateP
              (sep_elim_r_ent (|> Rafter) StateP))
    | red : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> ((R ∗ (|> Rafter)) ∗
          (state_interp H sigma allObservations)) ⊢
        (mkProperPure (Reducible e sigma)) =>
        \lam sigma allObservations n x hx hs =>
          \let lookup => lookup_of sigma allObservations n x hx
            (dropDelayed sigma allObservations n x hx hs)
          \in inP (Val v, sigma, nil, nil,
            BasePrim (LoadS l v lookup idp idp idp {idp} {idp}))
    | step : \Pi (sigma : State cnt) (e2 : Expr)
        (sigma2 : State cnt) (efs : List Expr)
        (observations futureObservations : List Observation) ->
        PrimStep e sigma e2 sigma2 efs observations -> ((R ∗ Rafter) ∗
            (state_interp H sigma
              (observations ++ futureObservations))) ⊢
          (|==>
            ((state_interp H sigma2 futureObservations) ∗
              ((WP H E e2 Phi) ∗
                (wp_forks H.iris_fork_post (wp H) efs)))) =>
        \lam sigma e2 sigma2 efs observations futureObservations
          hstep n x hx hs =>
          \let
            | StateAll => state_interp H sigma
                (observations ++ futureObservations)
            | lookup : glookup sigma.heap l = just v =>
                lookup_of sigma
                  (observations ++ futureObservations) n x hx
                  (properUPred_ent_trans
                    ((R ∗ Rafter) ∗ StateAll)
                    (R ∗ (Rafter ∗ StateAll))
                    (R ∗ StateAll)
                    (sep_assoc_l_ent R Rafter StateAll)
                    (sep_mono_r_ent R (Rafter ∗ StateAll)
                      StateAll (sep_elim_r_ent Rafter StateAll))
                    n x hx hs)
            | invStep => load_step_inv l v sigma e2 sigma2 efs
                observations lookup hstep
          \in \case invStep \with {
            | LoadStepInvIntro e2Eq sigma2Eq efsEq observationsEq =>
              \let
                | StateFuture => state_interp H sigma futureObservations
                | SourceAll => (R ∗ Rafter) ∗ StateAll
                | SourceFuture => (R ∗ Rafter) ∗ StateFuture
                | StatePost => StateFuture ∗ (Phi v)
                | Target => (state_interp H sigma2 futureObservations) ∗
                    ((WP H E e2 Phi) ∗
                      (wp_forks H.iris_fork_post (wp H) efs))
                | trim : SourceAll ⊢ SourceFuture =>
                    \lam n x hx hs => \case hs \with {
                      | inP (ar, ast, dx, hr, hstate) =>
                        inP (ar, ast, dx, hr,
                          transport
                            (\lam obs => (state_interp H sigma
                              (obs ++ futureObservations)).upred_holds n ast)
                            observationsEq hstate)
                    }
                | prepare : SourceFuture ⊢
                    (StateFuture ∗ (R ∗ Rafter)) =>
                    properUPred_ent_trans SourceFuture
                      (R ∗ (Rafter ∗ StateFuture))
                      (StateFuture ∗ (R ∗ Rafter))
                      (sep_assoc_l_ent R Rafter StateFuture)
                      (properUPred_ent_trans
                        (R ∗
                          (Rafter ∗ StateFuture))
                        (R ∗
                          (StateFuture ∗ Rafter))
                        (StateFuture ∗ (R ∗ Rafter))
                        (sep_mono_r_ent R
                          (Rafter ∗ StateFuture)
                          (StateFuture ∗ Rafter)
                          (sep_comm_ent Rafter StateFuture))
                        (properUPred_ent_trans
                          (R ∗
                            (StateFuture ∗ Rafter))
                          ((R ∗ StateFuture) ∗ Rafter)
                          (StateFuture ∗ (R ∗ Rafter))
                          (sep_assoc_r_ent R StateFuture Rafter)
                          (properUPred_ent_trans
                            ((R ∗ StateFuture) ∗ Rafter)
                            ((StateFuture ∗ R) ∗ Rafter)
                            (StateFuture ∗
                              (R ∗ Rafter))
                            (sep_mono_l_ent
                              (R ∗ StateFuture)
                              (StateFuture ∗ R) Rafter
                              (sep_comm_ent R StateFuture))
                            (sep_assoc_l_ent StateFuture R Rafter))))
                | valueFinish : StatePost ⊢ Target =>
                    \lam n x hx hs => \case hs \with {
                      | inP (ast, ar, dx, hstate, hphi) =>
                        \let
                          | M => iResUR S
                          | hxParts : M.validN n (M.op ast ar) =>
                              M.cmra_validN_ne n x (M.op ast ar) dx hx
                          | hrValid : M.validN n ar =>
                              cmra_validN_op_r {M} n ast ar hxParts
                          | hwp : (WP H E (Val v) Phi).upred_holds n ar =>
                              wp_value_intro H E v Phi n ar hrValid hphi
                          | result : (StateFuture ∗
                              (WP H E (Val v) Phi)).upred_holds n x =>
                              inP (ast, ar, dx, hstate, hwp)
                        \in transport
                          (\lam fs => ((state_interp H sigma2 futureObservations) ∗
                            ((WP H E e2 Phi) ∗
                              (wp_forks H.iris_fork_post
                                (wp H) fs))).upred_holds n x)
                          (inv efsEq)
                          (transport2
                            (\lam ee ss => ((state_interp H ss futureObservations) ∗
                              ((WP H E ee Phi) ∗
                                (wp_forks H.iris_fork_post
                                  (wp H) nil))).upred_holds n x)
                            (inv e2Eq) (inv sigma2Eq)
                            (wp_add_empty_forks H E sigma
                              futureObservations (Val v) Phi
                              n x hx result))
                    }
                | finish : SourceFuture ⊢
                    (|==> Target) =>
                    properUPred_ent_trans SourceFuture
                      (StateFuture ∗ (R ∗ Rafter))
                      (|==> Target) prepare
                      (properUPred_ent_trans
                        (StateFuture ∗
                          (R ∗ Rafter))
                        (StateFuture ∗
                          (|==> (Phi v)))
                        (|==> Target)
                        (sep_mono_r_ent StateFuture
                          (R ∗ Rafter)
                          (|==> (Phi v)) transition)
                        (properUPred_ent_trans
                          (StateFuture ∗
                            (|==> (Phi v)))
                          (|==> StatePost)
                          (|==> Target)
                          (bupd_frame_l {UPredBiBUpd (iResUR S)}
                            StateFuture (Phi v))
                          (bupd_mono StatePost Target valueFinish)))
              \in properUPred_ent_trans SourceAll SourceFuture
                  (|==> Target) trim finish n x hx hs
          }
  \in wp_lift_atomic_later_frame H E e Phi R Rafter idp red step

-- Generic full-fraction store.  The authoritative heap and the exclusive
-- fragment are updated together by `gen_heap_update`; the operational
-- inversion then identifies the concrete successor with that ghost update.
\lemma wp_store {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (l : Loc) (old new : Value)
  : (pointsto_full H.iris_gen_heap l old) ⊢
      (WP H E
        (Store (Val (LitV (LitLoc l))) (Val new))
        (\lam w => (mkProperPure (w = LitV LitUnit)) ∧
          (pointsto_full H.iris_gen_heap l new))) =>
  \let
    | R => pointsto_full H.iris_gen_heap l old
    | Rnew => pointsto_full H.iris_gen_heap l new
    | e => Store (Val (LitV (LitLoc l))) (Val new)
    | unitV => LitV LitUnit
    | Phi : Value -> iProp S => \lam w =>
        (mkProperPure (w = unitV)) ∧ Rnew
    | lookup_of : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> (R ∗ (state_interp H sigma allObservations)) ⊢
        (mkProperPure (glookup sigma.heap l = just old)) =>
        \lam sigma allObservations =>
          state_interp_pointsto_valid H sigma allObservations l
            (DfracOwn qp_one) old
    | red : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> (R ∗ (state_interp H sigma allObservations)) ⊢
        (mkProperPure (Reducible e sigma)) =>
        \lam sigma allObservations n x hx hs =>
          \let lookup => lookup_of sigma allObservations n x hx hs
          \in inP (Val unitV,
            state_update_heap sigma (heap_update sigma.heap l new),
            nil, nil,
            BasePrim (StoreS l new old lookup idp idp idp {idp} {idp}))
    | step : \Pi (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt)
        (efs : List Expr)
        (observations futureObservations : List Observation) ->
        PrimStep e sigma e2 sigma2 efs observations -> (R ∗ (state_interp H sigma
            (observations ++ futureObservations))) ⊢
          (|==>
            ((state_interp H sigma2 futureObservations) ∗
              ((WP H E e2 Phi) ∗
                (wp_forks H.iris_fork_post (wp H) efs)))) =>
        \lam sigma e2 sigma2 efs observations futureObservations hstep =>
          \case store_step_inv l new sigma e2 sigma2 efs observations
              hstep \with {
          | StoreStepInvIntro actualOld allocated e2_eq sigma2_eq efs_eq
              observations_eq =>
          \let
            | sigma' : State cnt => state_update_heap sigma
                (heap_update sigma.heap l new)
            | Updated => (state_interp H sigma' futureObservations) ∗ Rnew
            | Target => (state_interp H sigma2 futureObservations) ∗
                ((WP H E e2 Phi) ∗
                  (wp_forks H.iris_fork_post (wp H) efs))
            | trim : (state_interp H sigma
                  (observations ++ futureObservations)) ⊢
                (state_interp H sigma futureObservations) =>
                \lam n x hx hstate => transport
                  (\lam obs => (state_interp H sigma
                    (obs ++ futureObservations)).upred_holds n x)
                  observations_eq hstate
            | source_to_future : (R ∗ (state_interp H sigma
                  (observations ++ futureObservations))) ⊢
                ((state_interp H sigma futureObservations) ∗ R) =>
                properUPred_ent_trans
                  (R ∗ (state_interp H sigma
                    (observations ++ futureObservations)))
                  (R ∗
                    (state_interp H sigma futureObservations))
                  ((state_interp H sigma futureObservations) ∗ R)
                  (sep_mono_r_ent R
                    (state_interp H sigma
                      (observations ++ futureObservations))
                    (state_interp H sigma futureObservations) trim)
                  (sep_comm_ent R
                    (state_interp H sigma futureObservations))
            | finish : Updated ⊢ Target =>
                \lam n x hx hs => \case hs \with {
                  | inP (ast, ar, dx, hstate, hr) =>
                    \let
                      | M => iResUR S
                      | hx_parts : M.validN n (M.op ast ar) =>
                          M.cmra_validN_ne n x (M.op ast ar) dx hx
                      | hr_valid : M.validN n ar =>
                          cmra_validN_op_r {M} n ast ar hx_parts
                      | hwp : (WP H E (Val unitV) Phi)
                          .upred_holds n ar =>
                          wp_value_intro H E unitV Phi
                            n ar hr_valid (idp, hr)
                      | result : ((state_interp H sigma' futureObservations) ∗
                          (WP H E (Val unitV) Phi))
                          .upred_holds n x =>
                          inP (ast, ar, dx, hstate, hwp)
                    \in transport
                          (\lam fs => ((state_interp H sigma2 futureObservations) ∗
                            ((WP H E e2 Phi) ∗
                              (wp_forks H.iris_fork_post
                                (wp H) fs))).upred_holds n x)
                          (inv efs_eq)
                          (transport2
                            (\lam ee ss =>
                              ((state_interp H ss futureObservations) ∗
                                ((WP H E ee Phi) ∗
                                  (wp_forks H.iris_fork_post
                                    (wp H) nil))).upred_holds n x)
                            (inv e2_eq) (inv sigma2_eq)
                            (wp_add_empty_forks H E sigma'
                              futureObservations (Val unitV) Phi
                              n x hx result))
                }
          \in properUPred_ent_trans
              (R ∗ (state_interp H sigma
                (observations ++ futureObservations)))
              ((state_interp H sigma futureObservations) ∗ R)
              (|==> Target)
              source_to_future
              (properUPred_ent_trans
                ((state_interp H sigma futureObservations) ∗ R)
                (|==> Updated)
                (|==> Target)
                (state_interp_pointsto_update H sigma
                  futureObservations l old new)
                (bupd_mono Updated Target finish))
          }
  \in wp_lift_atomic H E e Phi R idp red step

-- Fetch-and-add atomically returns the old natural number and installs the
-- incremented value while transferring full ownership to the new points-to.
\lemma wp_faa {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (l : Loc) (old incr : Nat)
  : (pointsto_full H.iris_gen_heap l (natV old)) ⊢
      (WP H E
        (FAA (Val (LitV (LitLoc l))) (Val (natV incr)))
        (\lam returned => (mkProperPure (returned = natV old)) ∧
          (pointsto_full H.iris_gen_heap l (natV (old Nat.+ incr))))) =>
  \let
    | R => pointsto_full H.iris_gen_heap l (natV old)
    | Rnew => pointsto_full H.iris_gen_heap l (natV (old Nat.+ incr))
    | e => FAA (Val (LitV (LitLoc l))) (Val (natV incr))
    | Phi : Value -> iProp S => \lam returned =>
        (mkProperPure (returned = natV old)) ∧ Rnew
    | lookup_of : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> (R ∗ (state_interp H sigma allObservations)) ⊢
        (mkProperPure (glookup sigma.heap l = just (natV old))) =>
        \lam sigma allObservations =>
          state_interp_pointsto_valid H sigma allObservations l
            (DfracOwn qp_one) (natV old)
    | red : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> (R ∗ (state_interp H sigma allObservations)) ⊢
        (mkProperPure (Reducible e sigma)) =>
        \lam sigma allObservations n x hx hs =>
          \let lookup => lookup_of sigma allObservations n x hx hs
          \in inP (Val (natV old),
            state_update_heap sigma
              (heap_update sigma.heap l (natV (old Nat.+ incr))),
            nil, nil,
            BasePrim (FAAS l old incr lookup idp idp idp {idp} {idp}))
    | step : \Pi (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt)
        (efs : List Expr)
        (observations futureObservations : List Observation) ->
        PrimStep e sigma e2 sigma2 efs observations -> (R ∗ (state_interp H sigma
            (observations ++ futureObservations))) ⊢
          (|==>
            ((state_interp H sigma2 futureObservations) ∗
              ((WP H E e2 Phi) ∗
                (wp_forks H.iris_fork_post (wp H) efs)))) =>
        \lam sigma e2 sigma2 efs observations futureObservations hstep =>
          \let stepInv =>
            faa_step_inv l incr sigma e2 sigma2 efs observations hstep
          \in \case stepInv \with {
          | FAAStepInvIntro actualOld allocated e2_eq sigma2_eq efs_eq
              observations_eq =>
          \let
            | oldEqFrom : (R ∗ (state_interp H sigma
                  (observations ++ futureObservations))) ⊢
                (mkProperPure (actualOld = old)) =>
                \lam n x hx hs =>
                  pmap (\case __ \with {
                    | nothing => actualOld
                    | just value => \case value_nat value \with {
                        | nothing => actualOld
                        | just valueNat => valueNat
                      }
                  }) (inv allocated *>
                    lookup_of sigma
                      (observations ++ futureObservations) n x hx hs)
            | sigma' : State cnt => state_update_heap sigma
                (heap_update sigma.heap l (natV (old Nat.+ incr)))
            | Updated => (state_interp H sigma' futureObservations) ∗ Rnew
            | Target => (state_interp H sigma2 futureObservations) ∗
                ((WP H E e2 Phi) ∗
                  (wp_forks H.iris_fork_post (wp H) efs))
          \in \lam n x hx hsource =>
            \let
              | oldEq : actualOld = old => oldEqFrom n x hx hsource
              | e2_old_eq : e2 = Val (natV old) =>
                  e2_eq *> pmap (\lam k => Val (natV k)) oldEq
              | sigma2_old_eq : sigma2 = sigma' =>
                  sigma2_eq *> pmap (\lam k => state_update_heap sigma
                    (heap_update sigma.heap l (natV (k Nat.+ incr)))) oldEq
              | sourceFuture : ((state_interp H sigma futureObservations) ∗ R)
                  .upred_holds n x =>
                  \case hsource \with {
                    | inP (ar, ast, dx, hr, hstate) =>
                      inP (ast, ar,
                        (iResUR S).ofe_dist_trans n x
                          ((iResUR S).op ar ast) ((iResUR S).op ast ar) dx
                          (cmra_comm_dist {iResUR S} n ar ast),
                        transport
                          (\lam obs => (state_interp H sigma
                            (obs ++ futureObservations)).upred_holds n ast)
                          observations_eq hstate,
                        hr)
                  }
              | updated : (|==> Updated).upred_holds n x =>
                  state_interp_pointsto_update H sigma futureObservations
                    l (natV old) (natV (old Nat.+ incr))
                    n x hx sourceFuture
              | finish : Updated ⊢ Target =>
                  \lam k y hy hs => \case hs \with {
                    | inP (ast, ar, dy, hstate, hr) =>
                      \let
                        | M => iResUR S
                        | hy_parts : M.validN k (M.op ast ar) =>
                            M.cmra_validN_ne k y (M.op ast ar) dy hy
                        | hr_valid : M.validN k ar =>
                            cmra_validN_op_r {M} k ast ar hy_parts
                        | hwp : (WP H E (Val (natV old)) Phi)
                            .upred_holds k ar =>
                            wp_value_intro H E (natV old) Phi
                              k ar hr_valid (idp, hr)
                        | result : ((state_interp H sigma' futureObservations) ∗
                            (WP H E (Val (natV old)) Phi))
                            .upred_holds k y =>
                            inP (ast, ar, dy, hstate, hwp)
                      \in transport
                        (\lam fs => ((state_interp H sigma2 futureObservations) ∗
                          ((WP H E e2 Phi) ∗
                            (wp_forks H.iris_fork_post (wp H) fs)))
                          .upred_holds k y)
                        (inv efs_eq)
                        (transport2
                          (\lam ee ss => ((state_interp H ss futureObservations) ∗
                            ((WP H E ee Phi) ∗
                              (wp_forks H.iris_fork_post (wp H) nil)))
                            .upred_holds k y)
                          (inv e2_old_eq) (inv sigma2_old_eq)
                          (wp_add_empty_forks H E sigma'
                            futureObservations (Val (natV old)) Phi
                            k y hy result))
                  }
            \in bupd_mono Updated Target finish n x hx updated
          }
  \in wp_lift_atomic H E e Phi R idp red step

-- FAA with a delayed logical frame and a client-supplied ghost transition.
-- The transition runs in the same basic update as the physical heap change;
-- this is the reusable atomic rule needed by invariant-based counters.
\lemma wp_faa_later_frame {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (l : Loc) (old incr : Nat) (Rafter : iProp S)
    (Phi : Value -> iProp S)
    (transition : ((pointsto_full H.iris_gen_heap l (natV (old Nat.+ incr))) ∗
        Rafter) ⊢
      (|==> (Phi (natV old)))) :
  ((pointsto_full H.iris_gen_heap l (natV old)) ∗
      (|> Rafter)) ⊢
    (WP H E
      (FAA (Val (LitV (LitLoc l))) (Val (natV incr))) Phi) =>
  \let
    | R => pointsto_full H.iris_gen_heap l (natV old)
    | Rnew => pointsto_full H.iris_gen_heap l
        (natV (old Nat.+ incr))
    | L => |> Rafter
    | e => FAA (Val (LitV (LitLoc l))) (Val (natV incr))
    | dropDelayed : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> ((R ∗ L) ∗
          (state_interp H sigma allObservations)) ⊢
        (R ∗ (state_interp H sigma allObservations)) =>
        \lam sigma allObservations =>
          \let StateP => state_interp H sigma allObservations
          \in properUPred_ent_trans
            ((R ∗ L) ∗ StateP)
            (R ∗ (StateP ∗ L))
            (R ∗ StateP)
            (properUPred_ent_trans
              ((R ∗ L) ∗ StateP)
              (R ∗ (L ∗ StateP))
              (R ∗ (StateP ∗ L))
              (sep_assoc_l_ent R L StateP)
              (sep_mono_r_ent R (L ∗ StateP)
                (StateP ∗ L) (sep_comm_ent L StateP)))
            (sep_mono_r_ent R (StateP ∗ L) StateP
              (sep_elim_l_ent StateP L))
    | lookup_of : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> (R ∗ (state_interp H sigma allObservations)) ⊢
        (mkProperPure (glookup sigma.heap l = just (natV old))) =>
        \lam sigma allObservations =>
          state_interp_pointsto_valid H sigma allObservations l
            (DfracOwn qp_one) (natV old)
    | red : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> ((R ∗ L) ∗
          (state_interp H sigma allObservations)) ⊢
        (mkProperPure (Reducible e sigma)) =>
        \lam sigma allObservations n x hx hs =>
          \let lookup => lookup_of sigma allObservations n x hx
            (dropDelayed sigma allObservations n x hx hs)
          \in inP (Val (natV old),
            state_update_heap sigma
              (heap_update sigma.heap l (natV (old Nat.+ incr))),
            nil, nil,
            BasePrim (FAAS l old incr lookup idp idp idp {idp} {idp}))
    | step : \Pi (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt)
        (efs : List Expr)
        (observations futureObservations : List Observation) ->
        PrimStep e sigma e2 sigma2 efs observations -> ((R ∗ Rafter) ∗
            (state_interp H sigma
              (observations ++ futureObservations))) ⊢
          (|==>
            ((state_interp H sigma2 futureObservations) ∗
              ((WP H E e2 Phi) ∗
                (wp_forks H.iris_fork_post (wp H) efs)))) =>
        \lam sigma e2 sigma2 efs observations futureObservations hstep =>
          \let stepInv =>
            faa_step_inv l incr sigma e2 sigma2 efs observations hstep
          \in \case stepInv \with {
          | FAAStepInvIntro actualOld allocated e2_eq sigma2_eq efs_eq
              observations_eq =>
          \let
            | StateAll => state_interp H sigma
                (observations ++ futureObservations)
            | SourceAll => (R ∗ Rafter) ∗ StateAll
            | dropAfter : SourceAll ⊢
                (R ∗ StateAll) =>
                properUPred_ent_trans SourceAll
                  (R ∗ (StateAll ∗ Rafter))
                  (R ∗ StateAll)
                  (properUPred_ent_trans SourceAll
                    (R ∗ (Rafter ∗ StateAll))
                    (R ∗ (StateAll ∗ Rafter))
                    (sep_assoc_l_ent R Rafter StateAll)
                    (sep_mono_r_ent R
                      (Rafter ∗ StateAll)
                      (StateAll ∗ Rafter)
                      (sep_comm_ent Rafter StateAll)))
                  (sep_mono_r_ent R
                    (StateAll ∗ Rafter) StateAll
                    (sep_elim_l_ent StateAll Rafter))
            | oldEqFrom : SourceAll ⊢
                (mkProperPure (actualOld = old)) =>
                properUPred_ent_trans SourceAll
                  (R ∗ StateAll)
                  (mkProperPure (actualOld = old)) dropAfter
                  (\lam n x hx hs =>
                    pmap (\case __ \with {
                      | nothing => actualOld
                      | just value => \case value_nat value \with {
                          | nothing => actualOld
                          | just valueNat => valueNat
                        }
                    }) (inv allocated *>
                      lookup_of sigma
                        (observations ++ futureObservations) n x hx hs))
            | sigma' : State cnt => state_update_heap sigma
                (heap_update sigma.heap l (natV (old Nat.+ incr)))
            | StateOld => state_interp H sigma futureObservations
            | StateNew => state_interp H sigma' futureObservations
            | SourceFuture => (R ∗ Rafter) ∗ StateOld
            | HeapSource => StateOld ∗ R
            | Updated => StateNew ∗ Rnew
            | Intermediate => Updated ∗ Rafter
            | StatePost => StateNew ∗ (Phi (natV old))
            | Target => (state_interp H sigma2 futureObservations) ∗
                ((WP H E e2 Phi) ∗
                  (wp_forks H.iris_fork_post (wp H) efs))
          \in \lam n x hx hsource =>
            \let
              | oldEq : actualOld = old => oldEqFrom n x hx hsource
              | e2_old_eq : e2 = Val (natV old) =>
                  e2_eq *> pmap (\lam k => Val (natV k)) oldEq
              | sigma2_old_eq : sigma2 = sigma' =>
                  sigma2_eq *> pmap (\lam k => state_update_heap sigma
                    (heap_update sigma.heap l (natV (k Nat.+ incr)))) oldEq
              | sourceFuture : SourceFuture.upred_holds n x =>
                  \case hsource \with {
                    | inP (arp, ast, dx, hrp, hstate) =>
                      inP (arp, ast, dx, hrp,
                        transport
                          (\lam obs => (state_interp H sigma
                            (obs ++ futureObservations)).upred_holds n ast)
                          observations_eq hstate)
                  }
              | Prep1 => R ∗
                  (Rafter ∗ StateOld)
              | Prep2 => R ∗
                  (StateOld ∗ Rafter)
              | Prep3 => (R ∗ StateOld) ∗ Rafter
              | Prep4 => HeapSource ∗ Rafter
              | prep01 : SourceFuture ⊢ Prep1 =>
                  sep_assoc_l_ent R Rafter StateOld
              | prep12 : Prep1 ⊢ Prep2 =>
                  sep_mono_r_ent R
                    (Rafter ∗ StateOld)
                    (StateOld ∗ Rafter)
                    (sep_comm_ent Rafter StateOld)
              | prep23 : Prep2 ⊢ Prep3 =>
                  sep_assoc_r_ent R StateOld Rafter
              | prep34 : Prep3 ⊢ Prep4 =>
                  sep_mono_l_ent
                    (R ∗ StateOld) HeapSource Rafter
                    (sep_comm_ent R StateOld)
              | prep02 : SourceFuture ⊢ Prep2 =>
                  properUPred_ent_trans SourceFuture Prep1 Prep2
                    prep01 prep12
              | prep03 : SourceFuture ⊢ Prep3 =>
                  properUPred_ent_trans SourceFuture Prep2 Prep3
                    prep02 prep23
              | prepare : SourceFuture ⊢ Prep4 =>
                  properUPred_ent_trans SourceFuture Prep3 Prep4
                    prep03 prep34
              | physical : SourceFuture ⊢
                  (|==> Intermediate) =>
                  properUPred_ent_trans SourceFuture
                    (HeapSource ∗ Rafter)
                    (|==> Intermediate) prepare
                    (properUPred_ent_trans
                      (HeapSource ∗ Rafter)
                      ((|==> Updated) ∗ Rafter)
                      (|==> Intermediate)
                      (sep_mono_l_ent HeapSource
                        (|==> Updated) Rafter
                        (state_interp_pointsto_update H sigma
                          futureObservations l (natV old)
                          (natV (old Nat.+ incr))))
                      (bupd_frame_r Updated Rafter))
              | valueFinish : StatePost ⊢ Target =>
                  \lam k y hy hs => \case hs \with {
                    | inP (ast, ar, dy, hstate, hphi) =>
                      \let
                        | M => iResUR S
                        | hy_parts : M.validN k (M.op ast ar) =>
                            M.cmra_validN_ne k y (M.op ast ar) dy hy
                        | hr_valid : M.validN k ar =>
                            cmra_validN_op_r {M} k ast ar hy_parts
                        | hwp : (WP H E (Val (natV old)) Phi)
                            .upred_holds k ar =>
                            wp_value_intro H E (natV old) Phi
                              k ar hr_valid hphi
                        | result : (StateNew ∗
                            (WP H E (Val (natV old)) Phi))
                            .upred_holds k y =>
                            inP (ast, ar, dy, hstate, hwp)
                      \in transport
                        (\lam fs => ((state_interp H sigma2 futureObservations) ∗
                          ((WP H E e2 Phi) ∗
                            (wp_forks H.iris_fork_post (wp H) fs)))
                          .upred_holds k y)
                        (inv efs_eq)
                        (transport2
                          (\lam ee ss => ((state_interp H ss futureObservations) ∗
                            ((WP H E ee Phi) ∗
                              (wp_forks H.iris_fork_post (wp H) nil)))
                            .upred_holds k y)
                          (inv e2_old_eq) (inv sigma2_old_eq)
                          (wp_add_empty_forks H E sigma'
                            futureObservations (Val (natV old)) Phi
                            k y hy result))
                  }
              | finish : Intermediate ⊢
                  (|==> Target) =>
                  properUPred_ent_trans Intermediate
                    (StateNew ∗
                      (Rnew ∗ Rafter))
                    (|==> Target)
                    (sep_assoc_l_ent StateNew Rnew Rafter)
                    (properUPred_ent_trans
                      (StateNew ∗
                        (Rnew ∗ Rafter))
                      (StateNew ∗
                        (|==> (Phi (natV old))))
                      (|==> Target)
                      (sep_mono_r_ent StateNew
                        (Rnew ∗ Rafter)
                        (|==> (Phi (natV old))) transition)
                      (properUPred_ent_trans
                        (StateNew ∗
                          (|==> (Phi (natV old))))
                        (|==> StatePost)
                        (|==> Target)
                        (bupd_frame_l {UPredBiBUpd (iResUR S)}
                          StateNew (Phi (natV old)))
                        (bupd_mono StatePost Target valueFinish)))
              | nested : (|==>
                  (|==> Target)).upred_holds n x =>
                  bupd_mono Intermediate (|==> Target) finish
                    n x hx (physical n x hx sourceFuture)
            \in bupd_trans Target n x hx nested
          }
  \in wp_lift_atomic_later_frame H E e Phi R Rafter idp red step

-- Resolve an atomic store.  Besides updating the heap, this consumes exactly
-- the observation appended by Resolve and returns the tail prophecy token.
-- It is the first derived rule that couples a physical invariant update with
-- the trace-indexed prophecy invariant in one WP step.
\func resolve_skip_expr (x : Name) (arg : Value) : Expr =>
  App (Val (LamV x (Val unitV))) (Val arg)

\func resolve_skip_strongly_atomic {cnt : Countable Loc}
    (x : Name) (arg : Value) :
  StronglyAtomic {cnt} (resolve_skip_expr x arg) =>
  \lam sigma e2 sigma2 efs observations step =>
    \let | det => pure_base_redex_step_det
      (resolve_skip_expr x arg) (Val unitV)
      (base_lam_beta_pure_det x (Val unitV) arg)
      (app_lam_pure_ctx_absurd x (Val unitV) arg)
      sigma e2 sigma2 efs observations step
    \in inP (unitV, det.1)

-- Resolve a prophecy around the heap-language Skip encoding.  This is the
-- ordinary Iris `wp_resolve` rule specialized to the pure atomic step used by
-- clients: it consumes the predicted trace head and returns the tail token.
\lemma wp_resolve_skip {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (x : Name) (arg : Value) (p : ProphId) (w : Value)
    (resolves : List ProphPayload) :
  (proph H.iris_proph_map p resolves) ⊢
    (WP H E
      (Resolve (resolve_skip_expr x arg)
        (Val (LitV (LitProphecy p))) (Val w))
      (\lam returned =>
        mkProperExist (List ProphPayload) (\lam remaining =>
          (mkProperPure
              (\Sigma (returned = unitV)
                (resolves = (unitV, w) :: remaining))) ∗
            (proph H.iris_proph_map p remaining)))) =>
  \let
    | Skip => resolve_skip_expr x arg
    | Event : ProphPayload => (unitV, w)
    | Token => proph H.iris_proph_map p resolves
    | ResolveExprBase => Resolve Skip (Val (LitV (LitProphecy p))) (Val w)
    | Phi : Value -> iProp S => \lam returned =>
        mkProperExist (List ProphPayload) (\lam remaining =>
          (mkProperPure
              (\Sigma (returned = unitV)
                (resolves = Event :: remaining))) ∗
            (proph H.iris_proph_map p remaining))
    | usedOf : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> (Token ∗ (state_interp H sigma allObservations)) ⊢
          (mkProperPure (gset_in p sigma.usedProph)) =>
        \lam sigma allObservations =>
          properUPred_ent_trans
            (Token ∗ (state_interp H sigma allObservations))
            ((state_interp H sigma allObservations) ∗ Token)
            (mkProperPure (gset_in p sigma.usedProph))
            (sep_comm_ent Token (state_interp H sigma allObservations))
            (properUPred_ent_trans
              ((state_interp H sigma allObservations) ∗ Token)
              (mkProperPure
                (\Sigma (gset_in p sigma.usedProph)
                  (resolves = proph_list_resolves allObservations p)))
              (mkProperPure (gset_in p sigma.usedProph))
              (state_interp_proph_agree H sigma allObservations p resolves)
              (\lam _ _ _ agreed => agreed.1))
    | red : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> (Token ∗ (state_interp H sigma allObservations)) ⊢
          (mkProperPure (Reducible ResolveExprBase sigma)) =>
        \lam sigma allObservations n r hr hsource =>
          \let
            | innerRed : Reducible Skip sigma =>
                inP (Val unitV, sigma, nil, nil,
                  BasePrim (BetaS x (Val unitV) arg idp idp idp {idp} {idp}))
            | used : gset_in p sigma.usedProph =>
                usedOf sigma allObservations n r hr hsource
          \in resolve_reducible Skip
              (resolve_skip_strongly_atomic x arg) sigma p w innerRed used
    | step : \Pi (sigma : State cnt) (e2 : Expr)
        (sigma2 : State cnt) (efs : List Expr)
        (observations futureObservations : List Observation) ->
        PrimStep ResolveExprBase sigma e2 sigma2 efs observations ->
        (Token ∗
            (state_interp H sigma (observations ++ futureObservations))) ⊢
          (|==>
            ((state_interp H sigma2 futureObservations) ∗
              ((WP H E e2 Phi) ∗
                (wp_forks H.iris_fork_post (wp H) efs)))) =>
        \lam sigma e2 sigma2 efs observations futureObservations hstep =>
          \case resolve_step_inv Skip
              (resolve_skip_strongly_atomic x arg) p w sigma e2 sigma2 efs
              observations hstep \with {
            | ResolveStepInvIntro returned innerObservations inner _
                e2Eq observationsEq =>
              \let
                | det => base_lam_beta_pure_det x (Val unitV) arg sigma
                    (Val returned) sigma2 efs innerObservations inner
                | returnedEq : returned = unitV =>
                    pmap (maybe_val returned) (pmap to_val det.1)
                | e2UnitEq : e2 = Val unitV =>
                    e2Eq *> pmap Val returnedEq
                | sigma2Eq : sigma2 = sigma => det.2
                | efsEq : efs = nil => det.3
                | innerObsEq : innerObservations = nil => det.4
                | observationsEvent : observations = (p, Event) :: nil =>
                    observationsEq
                    *> pmap (\lam obs => obs ++
                        (p, (returned, w)) :: nil) innerObsEq
                    *> pmap (\lam r => (p, (r, w)) :: nil) returnedEq
                | StateEvent => state_interp H sigma
                    ((p, Event) :: futureObservations)
                | StateFuture => state_interp H sigma futureObservations
                | ResolveBody : List ProphPayload -> iProp S =>
                    \lam remaining => (mkProperPure (resolves = Event :: remaining)) ∗
                      (StateFuture ∗
                        (proph H.iris_proph_map p remaining))
                | ResolveResult => mkProperExist (List ProphPayload) ResolveBody
                | Target => (state_interp H sigma2 futureObservations) ∗
                    ((WP H E e2 Phi) ∗
                      (wp_forks H.iris_fork_post (wp H) efs))
                | trim : (state_interp H sigma
                      (observations ++ futureObservations)) ⊢ StateEvent =>
                    \lam k y _ hstate => transport
                      (\lam obs => (state_interp H sigma
                        (obs ++ futureObservations)).upred_holds k y)
                      observationsEvent hstate
                | sourceUpdate : (Token ∗
                      (state_interp H sigma
                        (observations ++ futureObservations))) ⊢
                    (StateEvent ∗ Token) =>
                    properUPred_ent_trans
                      (Token ∗
                        (state_interp H sigma
                          (observations ++ futureObservations)))
                      (Token ∗ StateEvent)
                      (StateEvent ∗ Token)
                      (sep_mono_r_ent Token
                        (state_interp H sigma
                          (observations ++ futureObservations)) StateEvent trim)
                      (sep_comm_ent Token StateEvent)
                | finishBody : \Pi (remaining : List ProphPayload) ->
                    (ResolveBody remaining) ⊢ Target =>
                    \lam remaining =>
                      \let
                        | PureResolve => mkProperPure
                            (resolves = Event :: remaining)
                        | Remaining => proph H.iris_proph_map p remaining
                        | Payload => PureResolve ∗ Remaining
                        | PurePost => mkProperPure
                            (\Sigma (unitV = unitV)
                              (resolves = Event :: remaining))
                        | phiPayload : Payload ⊢ (Phi unitV) =>
                            properUPred_ent_trans Payload
                              (PurePost ∗ Remaining) (Phi unitV)
                              (sep_mono_l_ent PureResolve PurePost Remaining
                                (\lam _ _ _ eq => (idp, eq)))
                              (exist_intro_ent
                                (\lam tail => (mkProperPure
                                    (\Sigma (unitV = unitV)
                                      (resolves = Event :: tail))) ∗
                                  (proph H.iris_proph_map p tail)) remaining)
                        | payloadWP : Payload ⊢
                            (WP H E (Val unitV) Phi) =>
                            properUPred_ent_trans Payload (Phi unitV)
                              (WP H E (Val unitV) Phi) phiPayload
                              (wp_value_intro H E unitV Phi)
                        | arranged : (ResolveBody remaining) ⊢
                            (StateFuture ∗ Payload) =>
                            properUPred_ent_trans
                              (PureResolve ∗
                                (StateFuture ∗ Remaining))
                              (StateFuture ∗
                                (PureResolve ∗ Remaining))
                              (StateFuture ∗ Payload)
                              (sep_swap_ent PureResolve StateFuture Remaining)
                              (properUPred_ent_refl
                                (StateFuture ∗ Payload))
                        | result : (ResolveBody remaining) ⊢
                            (StateFuture ∗
                              (WP H E (Val unitV) Phi)) =>
                            properUPred_ent_trans (ResolveBody remaining)
                              (StateFuture ∗ Payload)
                              (StateFuture ∗
                                (WP H E (Val unitV) Phi)) arranged
                              (sep_mono_r_ent StateFuture Payload
                                (WP H E (Val unitV) Phi) payloadWP)
                      \in \lam k y hy hbody =>
                        transport (\lam fs =>
                          ((state_interp H sigma2 futureObservations) ∗
                            ((WP H E e2 Phi) ∗
                              (wp_forks H.iris_fork_post (wp H) fs)))
                            .upred_holds k y) (inv efsEq)
                          (transport2 (\lam ee ss =>
                            ((state_interp H ss futureObservations) ∗
                              ((WP H E ee Phi) ∗
                                (wp_forks H.iris_fork_post (wp H) nil)))
                              .upred_holds k y)
                            (inv e2UnitEq) (inv sigma2Eq)
                            (wp_add_empty_forks H E sigma
                              futureObservations (Val unitV) Phi
                              k y hy (result k y hy hbody)))
                | finish : ResolveResult ⊢ Target =>
                    exist_elim_ent ResolveBody Target finishBody
              \in properUPred_ent_trans
                  (Token ∗
                    (state_interp H sigma
                      (observations ++ futureObservations)))
                  (StateEvent ∗ Token)
                  (|==> Target) sourceUpdate
                  (properUPred_ent_trans (StateEvent ∗ Token)
                    (|==> ResolveResult) (|==> Target)
                    (state_interp_resolve_proph H sigma futureObservations
                      p Event resolves)
                    (bupd_mono ResolveResult Target finish))
          }
  \in wp_lift_atomic H E ResolveExprBase Phi Token idp red step

-- Resolve-Skip while carrying a logical resource that only becomes available
-- in the successor world.  This is the prophecy counterpart of the delayed
-- atomic heap rules above and is what lets clients open a non-timeless
-- invariant around Resolve.
\lemma wp_resolve_skip_later_frame {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (x : Name) (arg : Value) (p : ProphId) (w : Value)
    (resolves : List ProphPayload) (Rafter : iProp S)
    (Phi : Value -> iProp S)
    (transition : \Pi (remaining : List ProphPayload) ->
      (((mkProperPure (resolves = (unitV, w) :: remaining)) ∗
            (proph H.iris_proph_map p remaining)) ∗
          Rafter) ⊢
        (|==> (Phi unitV))) :
  ((proph H.iris_proph_map p resolves) ∗
      (|> Rafter)) ⊢
    (WP H E
      (Resolve (resolve_skip_expr x arg)
        (Val (LitV (LitProphecy p))) (Val w)) Phi) =>
  \let
    | Skip => resolve_skip_expr x arg
    | Event : ProphPayload => (unitV, w)
    | Token => proph H.iris_proph_map p resolves
    | ResolveExpr => Resolve Skip (Val (LitV (LitProphecy p))) (Val w)
    | usedOf : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> (Token ∗ (state_interp H sigma allObservations)) ⊢
          (mkProperPure (gset_in p sigma.usedProph)) =>
        \lam sigma allObservations =>
          properUPred_ent_trans
            (Token ∗ (state_interp H sigma allObservations))
            ((state_interp H sigma allObservations) ∗ Token)
            (mkProperPure (gset_in p sigma.usedProph))
            (sep_comm_ent Token (state_interp H sigma allObservations))
            (properUPred_ent_trans
              ((state_interp H sigma allObservations) ∗ Token)
              (mkProperPure
                (\Sigma (gset_in p sigma.usedProph)
                  (resolves = proph_list_resolves allObservations p)))
              (mkProperPure (gset_in p sigma.usedProph))
              (state_interp_proph_agree H sigma allObservations p resolves)
              (\lam _ _ _ agreed => agreed.1))
    | dropDelayed : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> ((Token ∗ (|> Rafter)) ∗
            (state_interp H sigma allObservations)) ⊢
          (Token ∗ (state_interp H sigma allObservations)) =>
        \lam sigma allObservations =>
          properUPred_ent_trans
            ((Token ∗ (|> Rafter)) ∗
              (state_interp H sigma allObservations))
            (Token ∗
              ((|> Rafter) ∗
                (state_interp H sigma allObservations)))
            (Token ∗ (state_interp H sigma allObservations))
            (sep_assoc_l_ent Token (|> Rafter)
              (state_interp H sigma allObservations))
            (sep_mono_r_ent Token
              ((|> Rafter) ∗
                (state_interp H sigma allObservations))
              (state_interp H sigma allObservations)
              (sep_elim_r_ent (|> Rafter)
                (state_interp H sigma allObservations)))
    | red : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> ((Token ∗ (|> Rafter)) ∗
            (state_interp H sigma allObservations)) ⊢
          (mkProperPure (Reducible ResolveExpr sigma)) =>
        \lam sigma allObservations n r hr hsource =>
          \let
            | source : (Token ∗
                (state_interp H sigma allObservations)).upred_holds n r =>
                dropDelayed sigma allObservations n r hr hsource
            | innerRed : Reducible Skip sigma =>
                inP (Val unitV, sigma, nil, nil,
                  BasePrim (BetaS x (Val unitV) arg idp idp idp {idp} {idp}))
            | used : gset_in p sigma.usedProph =>
                usedOf sigma allObservations n r hr source
          \in resolve_reducible Skip
              (resolve_skip_strongly_atomic x arg) sigma p w innerRed used
    | step : \Pi (sigma : State cnt) (e2 : Expr)
        (sigma2 : State cnt) (efs : List Expr)
        (observations futureObservations : List Observation) ->
        PrimStep ResolveExpr sigma e2 sigma2 efs observations ->
        ((Token ∗ Rafter) ∗
            (state_interp H sigma (observations ++ futureObservations))) ⊢
          (|==>
            ((state_interp H sigma2 futureObservations) ∗
              ((WP H E e2 Phi) ∗
                (wp_forks H.iris_fork_post (wp H) efs)))) =>
        \lam sigma e2 sigma2 efs observations futureObservations hstep =>
          \case resolve_step_inv Skip
              (resolve_skip_strongly_atomic x arg) p w sigma e2 sigma2 efs
              observations hstep \with {
            | ResolveStepInvIntro returned innerObservations inner _
                e2Eq observationsEq =>
              \let
                | det => base_lam_beta_pure_det x (Val unitV) arg sigma
                    (Val returned) sigma2 efs innerObservations inner
                | returnedEq : returned = unitV =>
                    pmap (maybe_val returned) (pmap to_val det.1)
                | e2UnitEq : e2 = Val unitV =>
                    e2Eq *> pmap Val returnedEq
                | sigma2Eq : sigma2 = sigma => det.2
                | efsEq : efs = nil => det.3
                | innerObsEq : innerObservations = nil => det.4
                | observationsEvent : observations = (p, Event) :: nil =>
                    observationsEq
                    *> pmap (\lam obs => obs ++
                        (p, (returned, w)) :: nil) innerObsEq
                    *> pmap (\lam r => (p, (r, w)) :: nil) returnedEq
                | StateEvent => state_interp H sigma
                    ((p, Event) :: futureObservations)
                | StateFuture => state_interp H sigma futureObservations
                | ResolveBody : List ProphPayload -> iProp S =>
                    \lam remaining => (mkProperPure (resolves = Event :: remaining)) ∗
                      (StateFuture ∗
                        (proph H.iris_proph_map p remaining))
                | ResolveResult => mkProperExist (List ProphPayload) ResolveBody
                | StatePost => StateFuture ∗ (Phi unitV)
                | Target => (state_interp H sigma2 futureObservations) ∗
                    ((WP H E e2 Phi) ∗
                      (wp_forks H.iris_fork_post (wp H) efs))
                | trim : (state_interp H sigma
                      (observations ++ futureObservations)) ⊢ StateEvent =>
                    \lam k y _ hstate => transport
                      (\lam obs => (state_interp H sigma
                        (obs ++ futureObservations)).upred_holds k y)
                      observationsEvent hstate
                | arrangeUpdate : ((Token ∗ Rafter) ∗
                      (state_interp H sigma
                        (observations ++ futureObservations))) ⊢
                    ((StateEvent ∗ Token) ∗ Rafter) =>
                    properUPred_ent_trans
                      ((Token ∗ Rafter) ∗
                        (state_interp H sigma
                          (observations ++ futureObservations)))
                      (Token ∗
                        (Rafter ∗
                          (state_interp H sigma
                            (observations ++ futureObservations))))
                      ((StateEvent ∗ Token) ∗ Rafter)
                      (sep_assoc_l_ent Token Rafter
                        (state_interp H sigma
                          (observations ++ futureObservations)))
                      (properUPred_ent_trans
                        (Token ∗
                          (Rafter ∗
                            (state_interp H sigma
                              (observations ++ futureObservations))))
                        (Token ∗
                          (StateEvent ∗ Rafter))
                        ((StateEvent ∗ Token) ∗ Rafter)
                        (sep_mono_r_ent Token
                          (Rafter ∗
                            (state_interp H sigma
                              (observations ++ futureObservations)))
                          (StateEvent ∗ Rafter)
                          (properUPred_ent_trans
                            (Rafter ∗
                              (state_interp H sigma
                                (observations ++ futureObservations)))
                            (Rafter ∗ StateEvent)
                            (StateEvent ∗ Rafter)
                            (sep_mono_r_ent Rafter
                              (state_interp H sigma
                                (observations ++ futureObservations))
                              StateEvent trim)
                            (sep_comm_ent Rafter StateEvent)))
                        (properUPred_ent_trans
                          (Token ∗
                            (StateEvent ∗ Rafter))
                          ((Token ∗ StateEvent) ∗ Rafter)
                          ((StateEvent ∗ Token) ∗ Rafter)
                          (sep_assoc_r_ent Token StateEvent Rafter)
                          (sep_mono_l_ent
                            (Token ∗ StateEvent)
                            (StateEvent ∗ Token) Rafter
                            (sep_comm_ent Token StateEvent))))
                | updateFrame : ((StateEvent ∗ Token) ∗ Rafter) ⊢
                    (|==>
                      (ResolveResult ∗ Rafter)) =>
                    properUPred_ent_trans
                      ((StateEvent ∗ Token) ∗ Rafter)
                      ((|==> ResolveResult) ∗ Rafter)
                      (|==> (ResolveResult ∗ Rafter))
                      (sep_mono_l_ent
                        (StateEvent ∗ Token)
                        (|==> ResolveResult) Rafter
                        (state_interp_resolve_proph H sigma
                          futureObservations p Event resolves))
                      (bupd_frame_r ResolveResult Rafter)
                | valueFinish : StatePost ⊢ Target =>
                    \lam k y hy hs => \case hs \with {
                      | inP (astate, aphi, dy, hstate, hphi) =>
                        \let
                          | M => iResUR S
                          | hyParts : M.validN k (M.op astate aphi) =>
                              M.cmra_validN_ne k y (M.op astate aphi) dy hy
                          | phiValid : M.validN k aphi =>
                              cmra_validN_op_r {M} k astate aphi hyParts
                          | hwp : (WP H E (Val unitV) Phi)
                              .upred_holds k aphi =>
                              wp_value_intro H E unitV Phi
                                k aphi phiValid hphi
                          | result : (StateFuture ∗
                              (WP H E (Val unitV) Phi)).upred_holds k y =>
                              inP (astate, aphi, dy, hstate, hwp)
                        \in transport
                          (\lam fs => ((state_interp H sigma2 futureObservations) ∗
                            ((WP H E e2 Phi) ∗
                              (wp_forks H.iris_fork_post
                                (wp H) fs))).upred_holds k y)
                          (inv efsEq)
                          (transport2
                            (\lam ee ss => ((state_interp H ss futureObservations) ∗
                              ((WP H E ee Phi) ∗
                                (wp_forks H.iris_fork_post
                                  (wp H) nil))).upred_holds k y)
                            (inv e2UnitEq) (inv sigma2Eq)
                            (wp_add_empty_forks H E sigma
                              futureObservations (Val unitV) Phi
                              k y hy result))
                    }
                | finishBody : \Pi (remaining : List ProphPayload) ->
                    ((ResolveBody remaining) ∗ Rafter) ⊢
                      (|==> Target) =>
                    \lam remaining =>
                      \let
                        | PureResolve => mkProperPure
                            (resolves = Event :: remaining)
                        | Remaining => proph H.iris_proph_map p remaining
                        | Client => (PureResolve ∗ Remaining) ∗ Rafter
                        | arranged : ((ResolveBody remaining) ∗ Rafter) ⊢
                            (StateFuture ∗ Client) =>
                            properUPred_ent_trans
                              ((PureResolve ∗
                                  (StateFuture ∗ Remaining)) ∗
                                Rafter)
                              (StateFuture ∗
                                ((PureResolve ∗ Remaining) ∗
                                  Rafter))
                              (StateFuture ∗ Client)
                              (properUPred_ent_trans
                                ((PureResolve ∗
                                    (StateFuture ∗ Remaining)) ∗
                                  Rafter)
                                ((StateFuture ∗
                                    (PureResolve ∗ Remaining)) ∗
                                  Rafter)
                                (StateFuture ∗
                                  ((PureResolve ∗ Remaining) ∗
                                    Rafter))
                                (sep_mono_l_ent
                                  (PureResolve ∗
                                    (StateFuture ∗ Remaining))
                                  (StateFuture ∗
                                    (PureResolve ∗ Remaining))
                                  Rafter
                                  (sep_swap_ent PureResolve
                                    StateFuture Remaining))
                                (sep_assoc_l_ent StateFuture
                                  (PureResolve ∗ Remaining)
                                  Rafter))
                              (properUPred_ent_refl
                                (StateFuture ∗ Client))
                        | clientUpdate : (StateFuture ∗ Client) ⊢
                            (|==> StatePost) =>
                            properUPred_ent_trans
                              (StateFuture ∗ Client)
                              (StateFuture ∗
                                (|==> (Phi unitV)))
                              (|==> StatePost)
                              (sep_mono_r_ent StateFuture Client
                                (|==> (Phi unitV))
                                (transition remaining))
                              (bupd_frame_l {UPredBiBUpd (iResUR S)}
                                StateFuture (Phi unitV))
                      \in properUPred_ent_trans
                          ((ResolveBody remaining) ∗ Rafter)
                          (StateFuture ∗ Client)
                          (|==> Target) arranged
                          (properUPred_ent_trans
                            (StateFuture ∗ Client)
                            (|==> StatePost)
                            (|==> Target) clientUpdate
                            (bupd_mono StatePost Target valueFinish))
                | finish : (ResolveResult ∗ Rafter) ⊢
                    (|==> Target) =>
                    sep_exist_l_elim ResolveBody Rafter
                      (|==> Target) finishBody
                | sourceUpdate : ((Token ∗ Rafter) ∗
                      (state_interp H sigma
                        (observations ++ futureObservations))) ⊢
                    (|==> (ResolveResult ∗ Rafter)) =>
                    properUPred_ent_trans
                      ((Token ∗ Rafter) ∗
                        (state_interp H sigma
                          (observations ++ futureObservations)))
                      ((StateEvent ∗ Token) ∗ Rafter)
                      (|==> (ResolveResult ∗ Rafter))
                      arrangeUpdate updateFrame
              \in properUPred_ent_trans
                  ((Token ∗ Rafter) ∗
                    (state_interp H sigma
                      (observations ++ futureObservations)))
                  (|==> (ResolveResult ∗ Rafter))
                  (|==> Target) sourceUpdate
                  (properUPred_ent_trans
                    (|==> (ResolveResult ∗ Rafter))
                    (|==> (|==> Target))
                    (|==> Target)
                    (bupd_mono (ResolveResult ∗ Rafter)
                      (|==> Target) finish)
                    (bupd_trans Target))
          }
  \in wp_lift_atomic_later_frame H E ResolveExpr Phi Token Rafter idp red step

\lemma wp_resolve_store {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (l : Loc) (old new : Value) (p : ProphId) (w : Value)
    (resolves : List ProphPayload)
  : ((pointsto_full H.iris_gen_heap l old) ∗
        (proph H.iris_proph_map p resolves)) ⊢
      (WP H E
        (Resolve
          (Store (Val (LitV (LitLoc l))) (Val new))
          (Val (LitV (LitProphecy p))) (Val w))
        (\lam returned =>
          mkProperExist (List ProphPayload) (\lam remaining =>
            (mkProperPure
                (\Sigma (returned = LitV LitUnit)
                  (resolves = (LitV LitUnit, w) :: remaining))) ∗
              ((pointsto_full H.iris_gen_heap l new) ∗
                (proph H.iris_proph_map p remaining))))) =>
  \let
    | unitV => LitV LitUnit
    | event : ProphPayload => (unitV, w)
    | StoreExpr => Store (Val (LitV (LitLoc l))) (Val new)
    | e => Resolve StoreExpr
        (Val (LitV (LitProphecy p))) (Val w)
    | Old => pointsto_full H.iris_gen_heap l old
    | New => pointsto_full H.iris_gen_heap l new
    | Token => proph H.iris_proph_map p resolves
    | R => Old ∗ Token
    | Phi : Value -> iProp S => \lam returned =>
        mkProperExist (List ProphPayload) (\lam remaining =>
          (mkProperPure
              (\Sigma (returned = unitV)
                (resolves = event :: remaining))) ∗
            (New ∗
              (proph H.iris_proph_map p remaining)))
    | lookup_of : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> (R ∗ (state_interp H sigma allObservations)) ⊢
          (mkProperPure (glookup sigma.heap l = just old)) =>
        \lam sigma allObservations =>
          \let
            | StateNow => state_interp H sigma allObservations
            | dropToken : (Old ∗ (Token ∗ StateNow)) ⊢
                (Old ∗ StateNow) =>
                sep_mono_r_ent Old (Token ∗ StateNow) StateNow
                  (sep_elim_r_ent Token StateNow)
            | lookupNow : (Old ∗ StateNow) ⊢
                (mkProperPure (glookup sigma.heap l = just old)) =>
                state_interp_pointsto_valid H sigma allObservations
                  l (DfracOwn qp_one) old
          \in properUPred_ent_trans
            ((Old ∗ Token) ∗
              StateNow)
            (Old ∗
              (Token ∗ StateNow))
            (mkProperPure (glookup sigma.heap l = just old))
            (sep_assoc_l_ent Old Token
              StateNow)
            (properUPred_ent_trans
              (Old ∗
                (Token ∗ StateNow))
              (Old ∗
                StateNow)
              (mkProperPure (glookup sigma.heap l = just old))
              dropToken lookupNow)
    | used_of : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> (R ∗ (state_interp H sigma allObservations)) ⊢
          (mkProperPure (gset_in p sigma.usedProph)) =>
        \lam sigma allObservations =>
          \let
            | StateNow => state_interp H sigma allObservations
            | discardOld : ((Old ∗ Token) ∗ StateNow) ⊢
                (Token ∗ StateNow) =>
                properUPred_ent_trans
                  ((Old ∗ Token) ∗ StateNow)
                  (Old ∗ (Token ∗ StateNow))
                  (Token ∗ StateNow)
                  (sep_assoc_l_ent Old Token StateNow)
                  (sep_elim_r_ent Old (Token ∗ StateNow))
            | agreeUsed : (StateNow ∗ Token) ⊢
                (mkProperPure (gset_in p sigma.usedProph)) =>
                properUPred_ent_trans
                  (StateNow ∗ Token)
                  (mkProperPure
                    (\Sigma (gset_in p sigma.usedProph)
                      (resolves = proph_list_resolves allObservations p)))
                  (mkProperPure (gset_in p sigma.usedProph))
                  (state_interp_proph_agree H sigma allObservations
                    p resolves)
                  (\lam _ _ _ agreed => agreed.1)
          \in properUPred_ent_trans
            ((Old ∗ Token) ∗
              StateNow)
            (Token ∗
              StateNow)
            (mkProperPure (gset_in p sigma.usedProph))
            discardOld
            (properUPred_ent_trans
              (Token ∗
                StateNow)
              (StateNow ∗ Token)
              (mkProperPure (gset_in p sigma.usedProph))
              (sep_comm_ent Token StateNow)
              agreeUsed)
    | red : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> (R ∗ (state_interp H sigma allObservations)) ⊢
          (mkProperPure (Reducible e sigma)) =>
        \lam sigma allObservations n x hx hsource =>
          \let
            | lookup => lookup_of sigma allObservations
                n x hx hsource
            | used => used_of sigma allObservations
                n x hx hsource
            | sigma' => state_update_heap sigma
                (heap_update sigma.heap l new)
            | inner : BaseStep StoreExpr sigma (Val unitV) sigma'
                nil nil =>
                StoreS l new old lookup idp idp idp {idp} {idp}
          \in inP (Val unitV, sigma', nil, (p, event) :: nil,
            BasePrim (ResolveS p unitV w StoreExpr nil nil inner used
              idp idp {idp} {idp}))
    | step : \Pi (sigma : State cnt) (e2 : Expr)
        (sigma2 : State cnt) (efs : List Expr)
        (observations futureObservations : List Observation) ->
        PrimStep e sigma e2 sigma2 efs observations -> (R ∗ (state_interp H sigma
            (observations ++ futureObservations))) ⊢
          (|==>
            ((state_interp H sigma2 futureObservations) ∗
              ((WP H E e2 Phi) ∗
                (wp_forks H.iris_fork_post (wp H) efs)))) =>
        \lam sigma e2 sigma2 efs observations futureObservations hstep =>
          \case resolve_step_inv StoreExpr
              (store_strongly_atomic l new) p w sigma e2 sigma2 efs
              observations hstep \with {
          | ResolveStepInvIntro returned innerObservations inner used
              e2_eq observations_eq =>
            \case base_store_step_inv l new sigma (Val returned)
                sigma2 efs innerObservations inner \with {
            | StoreStepInvIntro actualOld allocated inner_e2_eq sigma2_eq
                efs_eq inner_observations_eq =>
              \let
                | returned_eq : returned = unitV =>
                    pmap (maybe_val returned)
                      (pmap to_val inner_e2_eq)
                | e2_unit_eq : e2 = Val unitV =>
                    e2_eq *> pmap Val returned_eq
                | observations_event : observations = (p, event) :: nil =>
                    observations_eq
                    *> pmap (\lam obs => obs ++
                        (p, (returned, w)) :: nil)
                      inner_observations_eq
                    *> pmap (\lam r => (p, (r, w)) :: nil) returned_eq
                | sigma' => state_update_heap sigma
                    (heap_update sigma.heap l new)
                | UpdatedBody : List ProphPayload -> iProp S =>
                    \lam remaining => (mkProperPure (resolves = event :: remaining)) ∗
                      (((state_interp H sigma' futureObservations) ∗ New) ∗
                        (proph H.iris_proph_map p remaining))
                | Updated => mkProperExist (List ProphPayload) UpdatedBody
                | Target => (state_interp H sigma2 futureObservations) ∗
                    ((WP H E e2 Phi) ∗
                      (wp_forks H.iris_fork_post (wp H) efs))
                | trim : (state_interp H sigma
                      (observations ++ futureObservations)) ⊢
                    (state_interp H sigma
                      ((p, event) :: futureObservations)) =>
                    \lam n x hx hstate => transport
                      (\lam obs => (state_interp H sigma
                        (obs ++ futureObservations)).upred_holds n x)
                      observations_event hstate
                | arrangeSource : (R ∗
                      (state_interp H sigma
                        ((p, event) :: futureObservations))) ⊢
                    (((state_interp H sigma
                          ((p, event) :: futureObservations)) ∗ Old) ∗ Token) =>
                    \let StateEvent => state_interp H sigma
                          ((p, event) :: futureObservations)
                    \in properUPred_ent_trans
                      ((Old ∗ Token) ∗ StateEvent)
                      (Old ∗ (Token ∗ StateEvent))
                      ((StateEvent ∗ Old) ∗ Token)
                      (sep_assoc_l_ent Old Token StateEvent)
                      (properUPred_ent_trans
                        (Old ∗ (Token ∗ StateEvent))
                        (Old ∗ (StateEvent ∗ Token))
                        ((StateEvent ∗ Old) ∗ Token)
                        (sep_mono_r_ent Old
                          (Token ∗ StateEvent)
                          (StateEvent ∗ Token)
                          (sep_comm_ent Token StateEvent))
                        (properUPred_ent_trans
                          (Old ∗
                            (StateEvent ∗ Token))
                          ((Old ∗ StateEvent) ∗ Token)
                          ((StateEvent ∗ Old) ∗ Token)
                          (sep_assoc_r_ent Old StateEvent Token)
                          (sep_mono_l_ent
                            (Old ∗ StateEvent)
                            (StateEvent ∗ Old) Token
                            (sep_comm_ent Old StateEvent))))
                | source_to_update : (R ∗ (state_interp H sigma
                      (observations ++ futureObservations))) ⊢
                    (((state_interp H sigma
                          ((p, event) :: futureObservations)) ∗ Old) ∗ Token) =>
                    properUPred_ent_trans
                      (R ∗ (state_interp H sigma
                        (observations ++ futureObservations)))
                      (R ∗ (state_interp H sigma
                        ((p, event) :: futureObservations)))
                      (((state_interp H sigma
                            ((p, event) :: futureObservations)) ∗ Old) ∗ Token)
                      (sep_mono_r_ent R
                        (state_interp H sigma
                          (observations ++ futureObservations))
                        (state_interp H sigma
                          ((p, event) :: futureObservations)) trim)
                      arrangeSource
                | finishBody : \Pi (remaining : List ProphPayload) ->
                    (UpdatedBody remaining) ⊢ Target =>
                    \lam remaining =>
                      \let
                        | PureResolve => mkProperPure
                            (resolves = event :: remaining)
                        | Remaining => proph H.iris_proph_map p remaining
                        | Resources => New ∗ Remaining
                        | PurePost => mkProperPure
                            (\Sigma (unitV = unitV)
                              (resolves = event :: remaining))
                        | PostBody => PurePost ∗ Resources
                        | pureMap : PureResolve ⊢ PurePost =>
                            \lam _ _ _ eq => (idp, eq)
                        | payload : (PureResolve ∗ Resources) ⊢ (Phi unitV) =>
                            properUPred_ent_trans
                              (PureResolve ∗ Resources)
                              PostBody (Phi unitV)
                              (sep_mono_l_ent PureResolve PurePost
                                Resources pureMap)
                              (exist_intro_ent
                                (\lam tail => (mkProperPure
                                    (\Sigma (unitV = unitV)
                                      (resolves = event :: tail))) ∗
                                  (New ∗
                                    (proph H.iris_proph_map p tail)))
                                remaining)
                        | payloadWp : (PureResolve ∗ Resources) ⊢
                            (WP H E (Val unitV) Phi) =>
                            properUPred_ent_trans
                              (PureResolve ∗ Resources)
                              (Phi unitV) (WP H E (Val unitV) Phi)
                              payload (wp_value_intro H E unitV Phi)
                        | StateFuture => state_interp H sigma'
                            futureObservations
                        | arrangeBody : (UpdatedBody remaining) ⊢
                            (StateFuture ∗
                              (PureResolve ∗ Resources)) =>
                            properUPred_ent_trans
                              (PureResolve ∗
                                ((StateFuture ∗ New) ∗ Remaining))
                              (PureResolve ∗
                                (StateFuture ∗ Resources))
                              (StateFuture ∗
                                (PureResolve ∗ Resources))
                              (sep_mono_r_ent PureResolve
                                ((StateFuture ∗ New) ∗ Remaining)
                                (StateFuture ∗ Resources)
                                (sep_assoc_l_ent StateFuture New Remaining))
                              (sep_swap_ent PureResolve StateFuture Resources)
                        | stateWp : (UpdatedBody remaining) ⊢
                            (StateFuture ∗
                              (WP H E (Val unitV) Phi)) =>
                            properUPred_ent_trans
                              (UpdatedBody remaining)
                              (StateFuture ∗
                                (PureResolve ∗ Resources))
                              (StateFuture ∗
                                (WP H E (Val unitV) Phi))
                              arrangeBody
                              (sep_mono_r_ent StateFuture
                                (PureResolve ∗ Resources)
                                (WP H E (Val unitV) Phi) payloadWp)
                      \in properUPred_ent_trans
                          (UpdatedBody remaining)
                          (StateFuture ∗
                            (WP H E (Val unitV) Phi)) Target
                          stateWp
                          (\lam n x hx hstatewp =>
                            transport
                              (\lam fs => ((state_interp H sigma2 futureObservations) ∗
                                ((WP H E e2 Phi) ∗
                                  (wp_forks H.iris_fork_post
                                    (wp H) fs))).upred_holds n x)
                              (inv efs_eq)
                              (transport2
                                (\lam ee ss => ((state_interp H ss futureObservations) ∗
                                  ((WP H E ee Phi) ∗
                                    (wp_forks H.iris_fork_post
                                      (wp H) nil))).upred_holds n x)
                                (inv e2_unit_eq) (inv sigma2_eq)
                                (wp_add_empty_forks H E sigma'
                                  futureObservations (Val unitV) Phi
                                  n x hx hstatewp)))
                | finish : Updated ⊢ Target =>
                    exist_elim_ent UpdatedBody Target finishBody
              \in properUPred_ent_trans
                  (R ∗ (state_interp H sigma
                    (observations ++ futureObservations)))
                  (((state_interp H sigma
                        ((p, event) :: futureObservations)) ∗ Old) ∗ Token)
                  (|==> Target) source_to_update
                  (properUPred_ent_trans
                    (((state_interp H sigma
                          ((p, event) :: futureObservations)) ∗ Old) ∗ Token)
                    (|==> Updated) (|==> Target)
                    (state_interp_store_resolve H sigma
                      futureObservations l old new p w resolves)
                    (bupd_mono Updated Target finish))
            }
          }
  \in wp_lift_atomic H E e Phi R idp red step

-- Generic allocation.  The concrete fresh location is chosen by the
-- operational semantics and then allocated in the authoritative ghost heap;
-- the postcondition existentially exposes that location and its full fragment.
\lemma wp_alloc {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (v : Value)
  : mkProperEmp ⊢
      (WP H E (Alloc (Val v))
        (\lam w => mkProperExist Loc (\lam l =>
          (mkProperPure (w = LitV (LitLoc l))) ∧
            (pointsto_full H.iris_gen_heap l v)))) =>
  \let
    | e => Alloc (Val v)
    | Phi : Value -> iProp S => \lam w =>
        mkProperExist Loc (\lam l =>
          (mkProperPure (w = LitV (LitLoc l))) ∧
            (pointsto_full H.iris_gen_heap l v))
    | red : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> (mkProperEmp ∗
          (state_interp H sigma allObservations)) ⊢
        (mkProperPure (Reducible e sigma)) =>
        \lam sigma allObservations _ _ _ _ =>
          \let fresh => heap_fresh_loc sigma
          \in inP (Val (LitV (LitLoc fresh.1)),
            state_update_heap sigma (heap_update sigma.heap fresh.1 v),
            nil, nil,
            BasePrim (AllocS v fresh.1 fresh.2 idp idp idp {idp} {idp}))
    | step : \Pi (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt)
        (efs : List Expr)
        (observations futureObservations : List Observation) ->
        PrimStep e sigma e2 sigma2 efs observations -> (mkProperEmp ∗ (state_interp H sigma
            (observations ++ futureObservations))) ⊢
          (|==>
            ((state_interp H sigma2 futureObservations) ∗
              ((WP H E e2 Phi) ∗
                (wp_forks H.iris_fork_post (wp H) efs)))) =>
        \lam sigma e2 sigma2 efs observations futureObservations hstep =>
          \case alloc_step_inv v sigma e2 sigma2 efs observations hstep \with {
          | AllocStepInvIntro l fresh e2_eq sigma2_eq efs_eq observations_eq =>
            \let
              | sigma' : State cnt => state_update_heap sigma
                  (heap_update sigma.heap l v)
              | Rnew => pointsto_full H.iris_gen_heap l v
              | Updated => (state_interp H sigma' futureObservations) ∗ Rnew
              | Target => (state_interp H sigma2 futureObservations) ∗
                  ((WP H E e2 Phi) ∗
                    (wp_forks H.iris_fork_post (wp H) efs))
              | trim : (state_interp H sigma
                    (observations ++ futureObservations)) ⊢
                  (state_interp H sigma futureObservations) =>
                  \lam n x hx hstate => transport
                    (\lam obs => (state_interp H sigma
                      (obs ++ futureObservations)).upred_holds n x)
                    observations_eq hstate
              | source_to_future : (mkProperEmp ∗
                    (state_interp H sigma
                      (observations ++ futureObservations))) ⊢
                  (state_interp H sigma futureObservations) =>
                  properUPred_ent_trans
                    (mkProperEmp ∗
                      (state_interp H sigma
                        (observations ++ futureObservations)))
                    (state_interp H sigma
                      (observations ++ futureObservations))
                    (state_interp H sigma futureObservations)
                    ((BIuPredMixin (iResUR S)).bi_mixin_emp_sep_2
                      (state_interp H sigma
                        (observations ++ futureObservations)))
                    trim
              | finish : Updated ⊢ Target =>
                  \lam n x hx hs => \case hs \with {
                    | inP (ast, ar, dx, hstate, hr) =>
                      \let
                        | M => iResUR S
                        | hx_parts : M.validN n (M.op ast ar) =>
                            M.cmra_validN_ne n x (M.op ast ar) dx hx
                        | hr_valid : M.validN n ar =>
                            cmra_validN_op_r {M} n ast ar hx_parts
                        | locV => LitV (LitLoc l)
                        | hwp : (WP H E (Val locV) Phi)
                            .upred_holds n ar =>
                            wp_value_intro H E locV Phi n ar hr_valid
                              (inP (l, (idp, hr)))
                        | result : ((state_interp H sigma' futureObservations) ∗
                            (WP H E (Val locV) Phi))
                            .upred_holds n x =>
                            inP (ast, ar, dx, hstate, hwp)
                      \in transport
                        (\lam fs => ((state_interp H sigma2 futureObservations) ∗
                          ((WP H E e2 Phi) ∗
                            (wp_forks H.iris_fork_post
                              (wp H) fs))).upred_holds n x)
                        (inv efs_eq)
                        (transport2
                          (\lam ee ss =>
                            ((state_interp H ss futureObservations) ∗
                              ((WP H E ee Phi) ∗
                                (wp_forks H.iris_fork_post
                                  (wp H) nil))).upred_holds n x)
                          (inv e2_eq) (inv sigma2_eq)
                          (wp_add_empty_forks H E sigma'
                            futureObservations (Val locV) Phi
                            n x hx result))
                  }
            \in properUPred_ent_trans
                (mkProperEmp ∗
                  (state_interp H sigma
                    (observations ++ futureObservations)))
                (state_interp H sigma futureObservations)
                (|==> Target)
                source_to_future
                (properUPred_ent_trans
                  (state_interp H sigma futureObservations)
                  (|==> Updated)
                  (|==> Target)
                  (state_interp_alloc H sigma futureObservations l v fresh)
                  (bupd_mono Updated Target finish))
        }
  \in wp_lift_atomic H E e Phi mkProperEmp idp red step

-- Positive bulk allocation.  The postcondition owns the whole contiguous
-- block, not only its first cell; this is the rule needed by array clients.
\lemma wp_allocN {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (n : Nat) (v : Value)
    (positive : \Sigma (k : Nat) (n = suc k))
  : mkProperEmp ⊢
      (WP H E (AllocN (Val (natV n)) (Val v))
        (\lam w => mkProperExist Loc (\lam l =>
          (mkProperPure (w = LitV (LitLoc l))) ∧
            (pointsto_block H.iris_gen_heap suc l n v)))) =>
  \let
    | e => AllocN (Val (natV n)) (Val v)
    | Phi : Value -> iProp S => \lam w =>
        mkProperExist Loc (\lam l =>
          (mkProperPure (w = LitV (LitLoc l))) ∧
            (pointsto_block H.iris_gen_heap suc l n v))
    | red : \Pi (sigma : State cnt)
        (allObservations : List Observation) -> (mkProperEmp ∗
          (state_interp H sigma allObservations)) ⊢
        (mkProperPure (Reducible e sigma)) =>
        \lam sigma allObservations _ _ _ _ =>
          \let fresh => heap_fresh_block sigma n
          \in inP (Val (LitV (LitLoc fresh.1)),
            state_update_heap sigma
              (heap_insert_block sigma.heap fresh.1 n v),
            nil, nil,
            BasePrim (AllocNS n v fresh.1 positive fresh.2
              idp idp idp {idp} {idp}))
    | step : \Pi (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt)
        (efs : List Expr)
        (observations futureObservations : List Observation) ->
        PrimStep e sigma e2 sigma2 efs observations -> (mkProperEmp ∗ (state_interp H sigma
            (observations ++ futureObservations))) ⊢
          (|==>
            ((state_interp H sigma2 futureObservations) ∗
              ((WP H E e2 Phi) ∗
                (wp_forks H.iris_fork_post (wp H) efs)))) =>
        \lam sigma e2 sigma2 efs observations futureObservations hstep =>
          \case allocN_step_inv n v sigma e2 sigma2 efs observations
              hstep \with {
          | AllocNStepInvIntro l _ fresh e2_eq sigma2_eq efs_eq
              observations_eq =>
            \let
              | sigma' : State cnt => state_update_heap sigma
                  (heap_insert_block sigma.heap l n v)
              | Rnew => pointsto_block H.iris_gen_heap suc l n v
              | Updated => (state_interp H sigma' futureObservations) ∗ Rnew
              | Target => (state_interp H sigma2 futureObservations) ∗
                  ((WP H E e2 Phi) ∗
                    (wp_forks H.iris_fork_post (wp H) efs))
              | trim : (state_interp H sigma
                    (observations ++ futureObservations)) ⊢
                  (state_interp H sigma futureObservations) =>
                  \lam k x hx hstate => transport
                    (\lam obs => (state_interp H sigma
                      (obs ++ futureObservations)).upred_holds k x)
                    observations_eq hstate
              | source_to_future : (mkProperEmp ∗
                    (state_interp H sigma
                      (observations ++ futureObservations))) ⊢
                  (state_interp H sigma futureObservations) =>
                  properUPred_ent_trans
                    (mkProperEmp ∗
                      (state_interp H sigma
                        (observations ++ futureObservations)))
                    (state_interp H sigma
                      (observations ++ futureObservations))
                    (state_interp H sigma futureObservations)
                    ((BIuPredMixin (iResUR S)).bi_mixin_emp_sep_2
                      (state_interp H sigma
                        (observations ++ futureObservations)))
                    trim
              | finish : Updated ⊢ Target =>
                  \lam k x hx hs => \case hs \with {
                    | inP (ast, ar, dx, hstate, hr) =>
                      \let
                        | M => iResUR S
                        | hxParts : M.validN k (M.op ast ar) =>
                            M.cmra_validN_ne k x (M.op ast ar) dx hx
                        | hrValid : M.validN k ar =>
                            cmra_validN_op_r {M} k ast ar hxParts
                        | locV => LitV (LitLoc l)
                        | hwp : (WP H E (Val locV) Phi)
                            .upred_holds k ar =>
                            wp_value_intro H E locV Phi k ar hrValid
                              (inP (l, (idp, hr)))
                        | result : ((state_interp H sigma' futureObservations) ∗
                            (WP H E (Val locV) Phi))
                            .upred_holds k x =>
                            inP (ast, ar, dx, hstate, hwp)
                      \in transport
                        (\lam fs => ((state_interp H sigma2 futureObservations) ∗
                          ((WP H E e2 Phi) ∗
                            (wp_forks H.iris_fork_post
                              (wp H) fs))).upred_holds k x)
                        (inv efs_eq)
                        (transport2
                          (\lam ee ss =>
                            ((state_interp H ss futureObservations) ∗
                              ((WP H E ee Phi) ∗
                                (wp_forks H.iris_fork_post
                                  (wp H) nil))).upred_holds k x)
                          (inv e2_eq) (inv sigma2_eq)
                          (wp_add_empty_forks H E sigma'
                            futureObservations (Val locV) Phi
                            k x hx result))
                  }
            \in properUPred_ent_trans
                (mkProperEmp ∗
                  (state_interp H sigma
                    (observations ++ futureObservations)))
                (state_interp H sigma futureObservations)
                (|==> Target)
                source_to_future
                (properUPred_ent_trans
                  (state_interp H sigma futureObservations)
                  (|==> Updated)
                  (|==> Target)
                  (state_interp_alloc_block H sigma futureObservations
                    l n v fresh)
                  (bupd_mono Updated Target finish))
        }
  \in wp_lift_atomic H E e Phi mkProperEmp idp red step

\lemma wp_bind_app_r {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (vf : Value)
    (e : Expr) (Phi : Value -> iProp S)
  : (WP H E e (\lam v => WP H E (App (Val vf) (Val v)) Phi)) ⊢
      (WP H E (App (Val vf) e) Phi) =>
  wp_bind_item H E (AppRCtx vf) e Phi

\lemma wp_bind_app_l {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e1 e2 : Expr)
    (Phi : Value -> iProp S)
  : (WP H E e1 (\lam v => WP H E (App (Val v) e2) Phi)) ⊢
      (WP H E (App e1 e2) Phi) =>
  wp_bind_item H E (AppLCtx e2) e1 Phi

\lemma wp_bind_if {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e t f : Expr)
    (Phi : Value -> iProp S)
  : (WP H E e (\lam v => WP H E (If (Val v) t f) Phi)) ⊢
      (WP H E (If e t f) Phi) =>
  wp_bind_item H E (IfCtx t f) e Phi

\lemma wp_bind_store_r {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (v1 : Value)
    (e2 : Expr) (Phi : Value -> iProp S)
  : (WP H E e2
        (\lam v => WP H E (Store (Val v1) (Val v)) Phi)) ⊢
      (WP H E (Store (Val v1) e2) Phi) =>
  wp_bind_item H E (StoreRCtx v1) e2 Phi

\lemma wp_bind_pair_l {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e1 e2 : Expr)
    (Phi : Value -> iProp S)
  : (WP H E e1 (\lam v => WP H E (Pair (Val v) e2) Phi)) ⊢
      (WP H E (Pair e1 e2) Phi) =>
  wp_bind_item H E (PairLCtx e2) e1 Phi

\lemma wp_bind_pair_r {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (v1 : Value)
    (e2 : Expr) (Phi : Value -> iProp S)
  : (WP H E e2 (\lam v => WP H E (Pair (Val v1) (Val v)) Phi)) ⊢
      (WP H E (Pair (Val v1) e2) Phi) =>
  wp_bind_item H E (PairRCtx v1) e2 Phi

\lemma wp_bind_fst {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e : Expr)
    (Phi : Value -> iProp S)
  : (WP H E e (\lam v => WP H E (Fst (Val v)) Phi)) ⊢
      (WP H E (Fst e) Phi) =>
  wp_bind_item H E FstCtx e Phi

\lemma wp_bind_snd {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e : Expr)
    (Phi : Value -> iProp S)
  : (WP H E e (\lam v => WP H E (Snd (Val v)) Phi)) ⊢
      (WP H E (Snd e) Phi) =>
  wp_bind_item H E SndCtx e Phi

\lemma wp_bind_iszero {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e : Expr)
    (Phi : Value -> iProp S)
  : (WP H E e (\lam v => WP H E (IsZero (Val v)) Phi)) ⊢
      (WP H E (IsZero e) Phi) =>
  wp_bind_item H E IsZeroCtx e Phi

\lemma wp_bind_pred {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e : Expr)
    (Phi : Value -> iProp S)
  : (WP H E e (\lam v => WP H E (Pred (Val v)) Phi)) ⊢
      (WP H E (Pred e) Phi) =>
  wp_bind_item H E PredCtx e Phi

\lemma wp_bind_mul_l {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e1 e2 : Expr)
    (Phi : Value -> iProp S)
  : (WP H E e1 (\lam v => WP H E (Mul (Val v) e2) Phi)) ⊢
      (WP H E (Mul e1 e2) Phi) =>
  wp_bind_item H E (MulLCtx e2) e1 Phi

\lemma wp_bind_mul_r {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (v1 : Value)
    (e2 : Expr) (Phi : Value -> iProp S)
  : (WP H E e2 (\lam v => WP H E (Mul (Val v1) (Val v)) Phi)) ⊢
      (WP H E (Mul (Val v1) e2) Phi) =>
  wp_bind_item H E (MulRCtx v1) e2 Phi

\lemma wp_bind_alloc {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e : Expr)
    (Phi : Value -> iProp S)
  : (WP H E e (\lam v => WP H E (Alloc (Val v)) Phi)) ⊢
      (WP H E (Alloc e) Phi) =>
  wp_bind_item H E AllocCtx e Phi

\lemma wp_bind_load {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e : Expr)
    (Phi : Value -> iProp S)
  : (WP H E e (\lam v => WP H E (Load (Val v)) Phi)) ⊢
      (WP H E (Load e) Phi) =>
  wp_bind_item H E LoadCtx e Phi

\lemma wp_bind_store_l {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e1 e2 : Expr)
    (Phi : Value -> iProp S)
  : (WP H E e1 (\lam v => WP H E (Store (Val v) e2) Phi)) ⊢
      (WP H E (Store e1 e2) Phi) =>
  wp_bind_item H E (StoreLCtx e2) e1 Phi
