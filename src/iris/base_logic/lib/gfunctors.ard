\import Arith.Nat
\import Paths
\import Set
\import iris.algebra.cmra
\import iris.algebra.ofe
\import stdpp.pmap (Pos)

-- =================================================================================
-- Plan A, §A3: gFunctor / gFunctors / gid / gname / subG.
--
-- Faithful port of Iris/Rocq `base_logic/lib/iprop.v` (header section) plus
-- the underlying `rFunctor` declaration from `algebra/cmra.v` that Rocq's
-- gFunctor wraps.
--
-- The CMRA-valued `RFunctor` is the analogue of Rocq's `Record rFunctor` and
-- sits parallel to the COFE-valued `OFunctor` already in `ofe.ard`.  The
-- UCMRA-valued `URFunctor` variant (Rocq's `urFunctor`) lives below; it is the
-- codomain of the A4 lifting `iResF Σ`.
-- =================================================================================

\open Nat (+)

-- =================================================================================
-- RFunctor: a CMRA-valued functor C^op × C → CMRA.
--
-- Mirrors `Record rFunctor` in `algebra/cmra.v`.  CMRA \extends OFE, so the
-- `OFEMor` between two CMRA carriers makes sense without further coercion.
-- `rFunctor_mor` is Rocq's `CmraMorphism (rFunctor_map fg)` field; the gmap
-- lifting `gmapURF` needs it to show that the mapped gmap morphism is again a
-- CMRA morphism.
-- =================================================================================

\record RFunctor
  | rFunctor_car (A B : COFE.{0}) : CMRA.{0}
  | rFunctor_map {A1 A2 B1 B2 : COFE.{0}} :
      \Sigma (OFEMor A2 A1) (OFEMor B1 B2) ->
      OFEMor (rFunctor_car A1 B1) (rFunctor_car A2 B2)
  | rFunctor_map_ne {A1 A2 B1 B2 : COFE.{0}} :
      NonExpansive
        {ProdOFE (OFEMorOFE A2 A1) (OFEMorOFE B1 B2)}
        {OFEMorOFE (rFunctor_car A1 B1) (rFunctor_car A2 B2)}
        rFunctor_map
  | rFunctor_map_id {A B : COFE.{0}} (x : (rFunctor_car A B).E) :
      (rFunctor_car A B).equiv
        ((rFunctor_map (ofe_mor_id, ofe_mor_id)).ofe_mor_car x)
        x
  | rFunctor_map_compose {A1 A2 A3 B1 B2 B3 : COFE.{0}}
      (f : OFEMor A2 A1) (g : OFEMor A3 A2)
      (f' : OFEMor B1 B2) (g' : OFEMor B2 B3)
      (x : (rFunctor_car A1 B1).E) :
      (rFunctor_car A3 B3).equiv
        ((rFunctor_map (g, g')).ofe_mor_car
          ((rFunctor_map (f, f')).ofe_mor_car x))
        ((rFunctor_map (ofe_mor_comp f g, ofe_mor_comp g' f')).ofe_mor_car x)
  | rFunctor_mor {A1 A2 B1 B2 : COFE.{0}}
      (fg : \Sigma (OFEMor A2 A1) (OFEMor B1 B2)) :
      CmraMorphism {rFunctor_car A1 B1} {rFunctor_car A2 B2} (rFunctor_map fg)

\record RFunctorContractive (F : RFunctor)
  | rFunctor_map_contractive {A1 A2 B1 B2 : COFE.{0}} :
      ContractiveMap
        {ProdOFE (OFEMorOFE A2 A1) (OFEMorOFE B1 B2)}
        {OFEMorOFE (F.rFunctor_car A1 B1) (F.rFunctor_car A2 B2)}
        (F.rFunctor_map {A1} {A2} {B1} {B2})

-- Rocq's `rFunctor_apply F A : cmra := rFunctor_car F A A`.
\func rFunctor_apply (F : RFunctor) (A : COFE.{0}) : CMRA.{0} =>
  F.rFunctor_car A A

-- =================================================================================
-- constRF: the constant CMRA-valued functor (Rocq `constRF B`).  Ignores both
-- arguments and returns `B`; its action on morphisms is the identity, which is
-- a CMRA morphism (`cmra_morphism_id`).  Constant functors are contractive.
-- Needed to package non-recursive resources (e.g. `coPset_disjR`, `gset_disjR`)
-- as `gFunctor`s in `wsatΣ`.
-- =================================================================================

\func constRF (B : CMRA.{0}) : RFunctor \cowith
  | rFunctor_car => \lam _ _ => B
  | rFunctor_map => \lam _ => ofe_mor_id
  | rFunctor_map_ne => \lam n fg fg' hfg x => B.ofe_dist_refl n x
  | rFunctor_map_id => \lam x => B.equiv_refl x
  | rFunctor_map_compose {A1} {A2} {A3} {B1} {B2} {B3} => \lam f g f' g' x => B.equiv_refl x
  | rFunctor_mor => \lam _ => cmra_morphism_id {B}

\func constRF_contractive (B : CMRA.{0}) : RFunctorContractive (constRF B) \cowith
  | rFunctor_map_contractive => \lam n fg fg' hfg x => B.ofe_dist_refl n x

-- Rocq's `constRF B` applied at any COFE `A` is `B` (definitionally).
\func rFunctor_apply_constRF (B : CMRA.{0}) (A : COFE.{0})
  : rFunctor_apply (constRF B) A = {CMRA.{0}} B => idp

-- =================================================================================
-- URFunctor: a UCMRA-valued functor C^op × C → UCMRA.
--
-- Mirrors `Record urFunctor` in `algebra/cmra.v`.  Identical to `RFunctor`
-- except that the carrier is unital; `discrete_funURF` and `gmapURF` land
-- here, and `iResF Σ` (A4) is such a functor.
-- =================================================================================

\record URFunctor
  | urFunctor_car (A B : COFE.{0}) : UCMRA.{0}
  | urFunctor_map {A1 A2 B1 B2 : COFE.{0}} :
      \Sigma (OFEMor A2 A1) (OFEMor B1 B2) ->
      OFEMor (urFunctor_car A1 B1) (urFunctor_car A2 B2)
  | urFunctor_map_ne {A1 A2 B1 B2 : COFE.{0}} :
      NonExpansive
        {ProdOFE (OFEMorOFE A2 A1) (OFEMorOFE B1 B2)}
        {OFEMorOFE (urFunctor_car A1 B1) (urFunctor_car A2 B2)}
        urFunctor_map
  | urFunctor_map_id {A B : COFE.{0}} (x : (urFunctor_car A B).E) :
      (urFunctor_car A B).equiv
        ((urFunctor_map (ofe_mor_id, ofe_mor_id)).ofe_mor_car x)
        x
  | urFunctor_map_compose {A1 A2 A3 B1 B2 B3 : COFE.{0}}
      (f : OFEMor A2 A1) (g : OFEMor A3 A2)
      (f' : OFEMor B1 B2) (g' : OFEMor B2 B3)
      (x : (urFunctor_car A1 B1).E) :
      (urFunctor_car A3 B3).equiv
        ((urFunctor_map (g, g')).ofe_mor_car
          ((urFunctor_map (f, f')).ofe_mor_car x))
        ((urFunctor_map (ofe_mor_comp f g, ofe_mor_comp g' f')).ofe_mor_car x)
  | urFunctor_mor {A1 A2 B1 B2 : COFE.{0}}
      (fg : \Sigma (OFEMor A2 A1) (OFEMor B1 B2)) :
      CmraMorphism {urFunctor_car A1 B1} {urFunctor_car A2 B2} (urFunctor_map fg)

\record URFunctorContractive (F : URFunctor)
  | urFunctor_map_contractive {A1 A2 B1 B2 : COFE.{0}} :
      ContractiveMap
        {ProdOFE (OFEMorOFE A2 A1) (OFEMorOFE B1 B2)}
        {OFEMorOFE (F.urFunctor_car A1 B1) (F.urFunctor_car A2 B2)}
        (F.urFunctor_map {A1} {A2} {B1} {B2})

-- Rocq's `urFunctor_apply F A : ucmra := urFunctor_car F A A`.
\func urFunctor_apply (F : URFunctor) (A : COFE.{0}) : UCMRA.{0} =>
  F.urFunctor_car A A

-- =================================================================================
-- gFunctor: a bundled rFunctor + contractivity witness.
--
-- Rocq:
--   Structure gFunctor := GFunctor {
--     gFunctor_F :> rFunctor;
--     gFunctor_map_contractive : rFunctorContractive gFunctor_F;
--   }.
-- =================================================================================

\record gFunctor
  | gFunctor_F : RFunctor
  | gFunctor_map_contractive : RFunctorContractive gFunctor_F

-- Rocq's `GFunctor F` (requires `rFunctorContractive F`): the value constructor
-- used inside the `#[ ... ]` list building a concrete `gFunctors` (e.g. `wsatΣ`).
\func mkGFunctor (F : RFunctor) (h : RFunctorContractive F) : gFunctor \cowith
  | gFunctor_F => F
  | gFunctor_map_contractive => h

-- =================================================================================
-- gFunctors: indexable list of gFunctors.
--
-- Rocq:
--   Record gFunctors := GFunctors {
--     gFunctors_len    : nat;
--     gFunctors_lookup : fin gFunctors_len -> gFunctor;
--   }.
--
-- The dependent-record form (rather than `List gFunctor`) follows Rocq's
-- universe-management workaround; it carries over to Arend at the same cost.
-- =================================================================================

\record gFunctors
  | gFunctors_len : Nat
  | gFunctors_lookup : Fin gFunctors_len -> gFunctor

\func gid (S : gFunctors) : \Set => Fin S.gFunctors_len

\func gname : \Set => Pos

\func gnameO : OFE => DiscreteOFE gname

-- =================================================================================
-- Fin (n + m) helpers.
--
-- arend-lib provides `fin-inc`/`fin-raise`/`split-index`, but the split
-- combinator uses an opaque equivalence that does not compute by `idp` on
-- the two injections.  We re-introduce the Rocq-style `fin_L`, `fin_R`, and
-- `fin_add_inv` with definitional reduction rules so that `subG_app_l/r` can
-- be proved by direct rewriting.
-- =================================================================================

\func fin_L {n m : Nat} (i : Fin n) : Fin (n + m) \elim n, i
  | suc n, 0 => 0
  | suc n, suc i => suc (fin_L i)

\func fin_R {n m : Nat} (i : Fin m) : Fin (n + m) \elim n
  | 0 => i
  | suc n => suc (fin_R i)

\func fin_add_inv {A : \Type} (n m : Nat)
                  (Pl : Fin n -> A) (Pr : Fin m -> A)
                  (i : Fin (n + m)) : A \elim n, i
  | 0, i => Pr i
  | suc n, 0 => Pl 0
  | suc n, suc i => fin_add_inv n m (\lam j => Pl (suc j)) Pr i

\func fin_add_inv_L {A : \Type} (n m : Nat)
                    (Pl : Fin n -> A) (Pr : Fin m -> A) (i : Fin n) :
  fin_add_inv n m Pl Pr (fin_L i) = Pl i \elim n, i
  | suc n, 0 => idp
  | suc n, suc i => fin_add_inv_L n m (\lam j => Pl (suc j)) Pr i

\func fin_add_inv_R {A : \Type} (n m : Nat)
                    (Pl : Fin n -> A) (Pr : Fin m -> A) (i : Fin m) :
  fin_add_inv n m Pl Pr (fin_R i) = Pr i \elim n
  | 0 => idp
  | suc n => fin_add_inv_R n m (\lam j => Pl (suc j)) Pr i

-- =================================================================================
-- gFunctors combinators: nil, singleton, app.
--
-- Rocq lives them in `Module gFunctors`; Arend has no module nesting, so they
-- carry the `gFunctors_` prefix.
-- =================================================================================

\func gFunctors_nil : gFunctors \cowith
  | gFunctors_len => 0
  | gFunctors_lookup => \case __

\func gFunctors_singleton (F : gFunctor) : gFunctors \cowith
  | gFunctors_len => 1
  | gFunctors_lookup => \lam _ => F

\func gFunctors_app (S1 S2 : gFunctors) : gFunctors \cowith
  | gFunctors_len => S1.gFunctors_len + S2.gFunctors_len
  | gFunctors_lookup =>
      fin_add_inv S1.gFunctors_len S2.gFunctors_len
        S1.gFunctors_lookup S2.gFunctors_lookup

-- =================================================================================
-- subG: Σ1 is contained in Σ2.
--
-- Rocq:
--   Class subG (Σ1 Σ2 : gFunctors) := in_subG i :
--     { j | gFunctors_lookup Σ1 i = gFunctors_lookup Σ2 j }.
--
-- We use propositional equality on `gFunctor` records, which suffices for the
-- downstream `inG` derivation (Rocq does the same — its equation is a Leibniz
-- equality on the bundled rFunctor record).
-- =================================================================================

\record subG (S1 S2 : gFunctors)
  | in_subG (i : Fin S1.gFunctors_len) :
      \Sigma (j : Fin S2.gFunctors_len)
             (S1.gFunctors_lookup i = S2.gFunctors_lookup j)

\func subG_refl (S : gFunctors) : subG S S \cowith
  | in_subG => \lam i => (i, idp)

\func subG_app_l {S S1 S2 : gFunctors} (h : subG S S1)
  : subG S (gFunctors_app S1 S2) \cowith
  | in_subG => \lam i =>
      \let (j, eq) => h.in_subG i
      \in (fin_L {S1.gFunctors_len} {S2.gFunctors_len} j,
           eq *> inv (fin_add_inv_L S1.gFunctors_len S2.gFunctors_len
                       S1.gFunctors_lookup S2.gFunctors_lookup j))

\func subG_app_r {S S1 S2 : gFunctors} (h : subG S S2)
  : subG S (gFunctors_app S1 S2) \cowith
  | in_subG => \lam i =>
      \let (j, eq) => h.in_subG i
      \in (fin_R {S1.gFunctors_len} {S2.gFunctors_len} j,
           eq *> inv (fin_add_inv_R S1.gFunctors_len S2.gFunctors_len
                       S1.gFunctors_lookup S2.gFunctors_lookup j))

\func subG_inv_l {S1 S2 S : gFunctors} (h : subG (gFunctors_app S1 S2) S)
  : subG S1 S \cowith
  | in_subG => \lam i =>
      \let
        | (j, eq) => h.in_subG (fin_L {S1.gFunctors_len} {S2.gFunctors_len} i)
      \in (j,
           inv (fin_add_inv_L S1.gFunctors_len S2.gFunctors_len
                 S1.gFunctors_lookup S2.gFunctors_lookup i) *> eq)

\func subG_inv_r {S1 S2 S : gFunctors} (h : subG (gFunctors_app S1 S2) S)
  : subG S2 S \cowith
  | in_subG => \lam i =>
      \let
        | (j, eq) => h.in_subG (fin_R {S1.gFunctors_len} {S2.gFunctors_len} i)
      \in (j,
           inv (fin_add_inv_R S1.gFunctors_len S2.gFunctors_len
                 S1.gFunctors_lookup S2.gFunctors_lookup i) *> eq)

\func subG_inv {S1 S2 S : gFunctors} (h : subG (gFunctors_app S1 S2) S)
  : \Sigma (subG S1 S) (subG S2 S) =>
  (subG_inv_l h, subG_inv_r h)


-- =================================================================================
-- Decidable equality on `gid Σ = Fin n` (needed by `discrete_fun_singleton`).
-- =================================================================================

\func fin_eq_dec {n : Nat} (i j : Fin n) : Dec (i = j) \elim n, i, j
  | suc n, 0, 0 => yes idp
  | suc n, 0, suc j => no (\lam e => \case e \with {})
  | suc n, suc i, 0 => no (\lam e => \case e \with {})
  | suc n, suc i, suc j => \case fin_eq_dec i j \with {
    | yes e => yes (pmap {Fin n} {Fin (suc n)} (\lam k => suc k) e)
    | no ne => no (\lam e => ne (pmap (fin_pred i) e))
  }
  \where
    \func fin_pred {n : Nat} (def : Fin n) (k : Fin (suc n)) : Fin n \elim k
      | 0 => def
      | suc k => k
