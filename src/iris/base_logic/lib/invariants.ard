-- A11: semantic and derived invariants, following Iris
-- base_logic/lib/invariants.v.

\func own_inv {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (P : iProp S) : iProp S =>
  mkProperExist gname (\lam i =>
    mkProperAnd (mkProperPure (coPIn i (nclose N))) (ownI W i P))

\func inv_inner {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (P : iProp S) : iProp S =>
  mkProperForall coPset (\lam E =>
    mkProperImpl (mkProperPure (coPSubset (nclose N) E))
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (mkProperLater P)
          (mkProperWand (mkProperLater P)
            (mkProperFUpd W (coPset_difference E (nclose N)) E
              mkProperEmp)))))

\func inv_body {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (P : iProp S) : iProp S =>
  mkProperPersistently (inv_inner W N P)

\sfunc inv {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (P : iProp S) : iProp S =>
  inv_body W N P

\func inv_peval {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (P : iProp S)
  : inv W N P = inv_body W N P =>
  \peval inv W N P

\lemma coPmem_singleton_inv (i j : Pos)
    (h : coPIn j (coPset_singleton i)) : j = i \elim i, j
  | xH, xH => idp
  | xH, xO _ => \case h \with {}
  | xH, xI _ => \case h \with {}
  | xO _, xH => \case h \with {}
  | xO i, xO j => pmap xO (coPmem_singleton_inv i j h)
  | xO _, xI _ => \case h \with {}
  | xI _, xH => \case h \with {}
  | xI _, xO _ => \case h \with {}
  | xI i, xI j => pmap xI (coPmem_singleton_inv i j h)

\func coPset_singleton_subset (i : Pos) (X : coPset) (hi : coPIn i X)
  : coPSubset (coPset_singleton i) X =>
  \lam j hj => transport (\lam q => coPIn q X)
    (Paths.inv (coPmem_singleton_inv i j hj)) hi

\lemma ownE_equiv_ent {S : gFunctors} (W : wsatGS S)
    (E1 E2 : coPset) (heq : coPset_equiv E1 E2)
  : properUPred_ent (ownE W E1) (ownE W E2) =>
  \lam n x hv ho =>
    (own_proper W.wsatGpreS_enabled W.enabled_name
      (CoPset E1) (CoPset E2) heq n x hv).1 ho

\lemma ownE_split_subset {S : gFunctors} (W : wsatGS S)
    (X Y : coPset) (hsub : coPSubset Y X)
  : properUPred_ent (ownE W X)
      (mkProperSep (ownE W Y) (ownE W (coPset_difference X Y))) =>
  properUPred_ent_trans (ownE W X)
    (ownE W (coPset_union Y (coPset_difference X Y)))
    (mkProperSep (ownE W Y) (ownE W (coPset_difference X Y)))
    (ownE_equiv_ent W X (coPset_union Y (coPset_difference X Y))
      (coPset_subset_union_difference X Y hsub))
    (\lam n x hv ho =>
      (ownE_op W Y (coPset_difference X Y)
        (coPset_subset_difference_disjoint X Y) n x hv).1 ho)

\lemma ownE_join_subset {S : gFunctors} (W : wsatGS S)
    (X Y : coPset) (hsub : coPSubset Y X)
  : properUPred_ent
      (mkProperSep (ownE W Y) (ownE W (coPset_difference X Y)))
      (ownE W X) =>
  properUPred_ent_trans
    (mkProperSep (ownE W Y) (ownE W (coPset_difference X Y)))
    (ownE W (coPset_union Y (coPset_difference X Y)))
    (ownE W X)
    (\lam n x hv hs =>
      (ownE_op W Y (coPset_difference X Y)
        (coPset_subset_difference_disjoint X Y) n x hv).2 hs)
    (ownE_equiv_ent W (coPset_union Y (coPset_difference X Y)) X
      (coPset_equiv_sym X (coPset_union Y (coPset_difference X Y))
        (coPset_subset_union_difference X Y hsub)))

\lemma pure_sep_to_and {M : UCMRA} (phi : \Prop) (P : ProperUPred M)
  : properUPred_ent (mkProperSep (mkProperPure phi) P)
      (mkProperAnd (mkProperPure phi) P) =>
  \lam n x hv hs => \case hs \with {
    | inP (_, _, _, hphi, _) =>
      (hphi, sep_elim_r_ent (mkProperPure phi) P n x hv hs)
  }

\lemma own_inv_intro {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (P : iProp S) (i : gname)
  : properUPred_ent
      (mkProperSep (mkProperPure (coPIn i (nclose N))) (ownI W i P))
      (own_inv W N P) =>
  properUPred_ent_trans
    (mkProperSep (mkProperPure (coPIn i (nclose N))) (ownI W i P))
    (mkProperAnd (mkProperPure (coPIn i (nclose N))) (ownI W i P))
    (own_inv W N P)
    (pure_sep_to_and (coPIn i (nclose N)) (ownI W i P))
    (exist_intro_ent (\lam j =>
      mkProperAnd (mkProperPure (coPIn j (nclose N))) (ownI W j P)) i)

\func fresh_inv_oracle (N : Namespace)
  : \Pi (E : Gset) ->
      TruncP (\Sigma (i : gname) (plookup E i = nothing)
        (coPIn i (nclose N))) =>
  \lam E =>
    \let
      | (i, hnot, hiN) => fresh_inv_name E N
      | hfresh : plookup E i = nothing =>
          \case maybe_unit_eta (plookup E i) \with {
            | inl hn => hn
            | inr hj => absurd (hnot hj)
          }
    \in inP (i, hfresh, hiN)

\func ownI_core_id {S : gFunctors} (i : gname) (P : iProp S)
  : CoreId {wsat_invR S}
      (wsat_inv_frag i DfracDiscarded
        (to_agree (invariant_unfold P))) =>
  transport (CoreId {wsat_invR S})
    (Paths.inv (wsat_inv_frag_peval i DfracDiscarded
      (to_agree (invariant_unfold P))))
    (transport
      (\lam (K : GmapViewAgreeKit gname gnameCountable
          (LaterOFE (iPropO S))) =>
        CoreId {K.gva_R}
          (K.gva_frag i DfracDiscarded
            (to_agree (invariant_unfold P))))
      (Paths.inv (\peval wsat_invKit S))
      (gmap_view_frag_core_id i DfracDiscarded
        (to_agree (invariant_unfold P)) idp
        (\lam n => agree_dist_refl n
          (to_agree (invariant_unfold P)))))

\lemma ownI_dup {S : gFunctors} (W : wsatGS S)
    (i : gname) (P : iProp S)
  : properUPred_ent (ownI W i P)
      (mkProperSep (ownI W i P) (ownI W i P)) =>
  \let
    | a => wsat_inv_frag i DfracDiscarded
        (to_agree (invariant_unfold P))
    | haa : (wsat_invR S).equiv ((wsat_invR S).op a a) a =>
        core_id_dup a (ownI_core_id i P)
  \in properUPred_ent_trans
    (own W.wsatGpreS_inv W.invariant_name a)
    (own W.wsatGpreS_inv W.invariant_name ((wsat_invR S).op a a))
    (mkProperSep
      (own W.wsatGpreS_inv W.invariant_name a)
      (own W.wsatGpreS_inv W.invariant_name a))
    (\lam n x hv ho =>
      (own_proper W.wsatGpreS_inv W.invariant_name a
        ((wsat_invR S).op a a)
        ((wsat_invR S).equiv_sym ((wsat_invR S).op a a) a haa)
        n x hv).1 ho)
    (\lam n x hv ho =>
      (own_op W.wsatGpreS_inv W.invariant_name a a n x hv).1 ho)

\sfunc ownI_open_keep {S : gFunctors} (W : wsatGS S)
    (i : gname) (P : iProp S)
  : properUPred_ent
      (mkProperSep (wsat W)
        (mkProperSep (ownI W i P) (ownE W (coPset_singleton i))))
      (mkProperSep (wsat W)
        (mkProperSep (ownI W i P)
          (mkProperSep (mkProperLater P) (ownD W (gset_singleton i))))) =>
  \let
    | I => ownI W i P
    | O => ownE W (coPset_singleton i)
    | LD => mkProperSep (mkProperLater P) (ownD W (gset_singleton i))
    | step1 : properUPred_ent (mkProperSep (wsat W) (mkProperSep I O))
        (mkProperSep (wsat W) (mkProperSep (mkProperSep I I) O)) =>
        sep_mono_r_ent (wsat W) (mkProperSep I O)
          (mkProperSep (mkProperSep I I) O)
          (sep_mono_l_ent I (mkProperSep I I) O (ownI_dup W i P))
    | step2 : properUPred_ent
        (mkProperSep (wsat W) (mkProperSep (mkProperSep I I) O))
        (mkProperSep I (mkProperSep (wsat W) (mkProperSep I O))) =>
        properUPred_ent_trans
          (mkProperSep (wsat W) (mkProperSep (mkProperSep I I) O))
          (mkProperSep (wsat W) (mkProperSep I (mkProperSep I O)))
          (mkProperSep I (mkProperSep (wsat W) (mkProperSep I O)))
          (sep_mono_r_ent (wsat W) (mkProperSep (mkProperSep I I) O)
            (mkProperSep I (mkProperSep I O))
            (sep_assoc_l_ent I I O))
          (sep_swap_ent (wsat W) I (mkProperSep I O))
    | step3 : properUPred_ent
        (mkProperSep I (mkProperSep (wsat W) (mkProperSep I O)))
        (mkProperSep I (mkProperSep (wsat W) LD)) =>
        sep_mono_r_ent I (mkProperSep (wsat W) (mkProperSep I O))
          (mkProperSep (wsat W) LD) (ownI_open W i P)
    | step4 : properUPred_ent (mkProperSep I (mkProperSep (wsat W) LD))
        (mkProperSep (wsat W) (mkProperSep I LD)) =>
        sep_swap_ent I (wsat W) LD
  \in \lam n x hv h =>
    step4 n x hv (step3 n x hv (step2 n x hv (step1 n x hv h)))

-- (A * (B * C)) * (D * E) |- E * (B * (A * (C * D))).
\lemma sep_permute5 {M : UCMRA} (A B C D E : ProperUPred M)
  : properUPred_ent
      (mkProperSep (mkProperSep A (mkProperSep B C)) (mkProperSep D E))
      (mkProperSep E (mkProperSep B (mkProperSep A (mkProperSep C D)))) =>
  \let
    | S0 => mkProperSep (mkProperSep A (mkProperSep B C)) (mkProperSep D E)
    | S1 => mkProperSep (mkProperSep D E) (mkProperSep A (mkProperSep B C))
    | S2 => mkProperSep D (mkProperSep E (mkProperSep A (mkProperSep B C)))
    | S3 => mkProperSep E (mkProperSep D (mkProperSep A (mkProperSep B C)))
    | S4 => mkProperSep E (mkProperSep A (mkProperSep D (mkProperSep B C)))
    | S5 => mkProperSep E (mkProperSep A (mkProperSep B (mkProperSep D C)))
    | S6 => mkProperSep E (mkProperSep B (mkProperSep A (mkProperSep D C)))
    | S7 => mkProperSep E (mkProperSep B (mkProperSep A (mkProperSep C D)))
    | h01 : properUPred_ent S0 S1 =>
        sep_comm_ent (mkProperSep A (mkProperSep B C)) (mkProperSep D E)
    | h12 : properUPred_ent S1 S2 =>
        sep_assoc_l_ent D E (mkProperSep A (mkProperSep B C))
    | h23 : properUPred_ent S2 S3 => sep_swap_ent D E (mkProperSep A (mkProperSep B C))
    | h34 : properUPred_ent S3 S4 =>
        sep_mono_r_ent E (mkProperSep D (mkProperSep A (mkProperSep B C)))
          (mkProperSep A (mkProperSep D (mkProperSep B C)))
          (sep_swap_ent D A (mkProperSep B C))
    | h45 : properUPred_ent S4 S5 =>
        sep_mono_r_ent E (mkProperSep A (mkProperSep D (mkProperSep B C)))
          (mkProperSep A (mkProperSep B (mkProperSep D C)))
          (sep_mono_r_ent A (mkProperSep D (mkProperSep B C))
            (mkProperSep B (mkProperSep D C)) (sep_swap_ent D B C))
    | h56 : properUPred_ent S5 S6 =>
        sep_mono_r_ent E (mkProperSep A (mkProperSep B (mkProperSep D C)))
          (mkProperSep B (mkProperSep A (mkProperSep D C)))
          (sep_swap_ent A B (mkProperSep D C))
    | h67 : properUPred_ent S6 S7 =>
        sep_mono_r_ent E (mkProperSep B (mkProperSep A (mkProperSep D C)))
          (mkProperSep B (mkProperSep A (mkProperSep C D)))
          (sep_mono_r_ent B (mkProperSep A (mkProperSep D C))
            (mkProperSep A (mkProperSep C D))
            (sep_mono_r_ent A (mkProperSep D C) (mkProperSep C D)
              (sep_comm_ent D C)))
  \in \lam n x hv h => h67 n x hv (h56 n x hv (h45 n x hv
      (h34 n x hv (h23 n x hv (h12 n x hv (h01 n x hv h))))))

\lemma sep_move_fifth_front {M : UCMRA}
    (A B C D E F : ProperUPred M)
  : properUPred_ent
      (mkProperSep A (mkProperSep B (mkProperSep C
        (mkProperSep D (mkProperSep E F)))))
      (mkProperSep E (mkProperSep A (mkProperSep B
        (mkProperSep C (mkProperSep D F))))) =>
  \let
    | h1 => sep_mono_r_ent C
        (mkProperSep D (mkProperSep E F))
        (mkProperSep E (mkProperSep D F))
        (sep_swap_ent D E F)
    | h2 => sep_mono_r_ent B
        (mkProperSep C (mkProperSep E (mkProperSep D F)))
        (mkProperSep E (mkProperSep C (mkProperSep D F)))
        (sep_swap_ent C E (mkProperSep D F))
    | h3 => sep_mono_r_ent A
        (mkProperSep B (mkProperSep E (mkProperSep C (mkProperSep D F))))
        (mkProperSep E (mkProperSep B (mkProperSep C (mkProperSep D F))))
        (sep_swap_ent B E (mkProperSep C (mkProperSep D F)))
    | h4 => sep_swap_ent A E
        (mkProperSep B (mkProperSep C (mkProperSep D F)))
  \in \lam n x hv h =>
    \let
      | r1 => sep_mono_r_ent A
            (mkProperSep B (mkProperSep C (mkProperSep D (mkProperSep E F))))
            (mkProperSep B (mkProperSep C (mkProperSep E (mkProperSep D F))))
            (sep_mono_r_ent B
              (mkProperSep C (mkProperSep D (mkProperSep E F)))
              (mkProperSep C (mkProperSep E (mkProperSep D F))) h1)
            n x hv h
      | r2 => sep_mono_r_ent A
          (mkProperSep B (mkProperSep C (mkProperSep E (mkProperSep D F))))
          (mkProperSep B (mkProperSep E (mkProperSep C (mkProperSep D F))))
          h2 n x hv r1
      | r3 => h3 n x hv r2
    \in h4 n x hv r3

\lemma sep_rotate_third_front {M : UCMRA} (A B C R : ProperUPred M)
  : properUPred_ent
      (mkProperSep A (mkProperSep B (mkProperSep C R)))
      (mkProperSep C (mkProperSep A (mkProperSep B R))) =>
  \let
    | h1 : properUPred_ent
        (mkProperSep A (mkProperSep B (mkProperSep C R)))
        (mkProperSep A (mkProperSep C (mkProperSep B R))) =>
        sep_mono_r_ent A (mkProperSep B (mkProperSep C R))
          (mkProperSep C (mkProperSep B R)) (sep_swap_ent B C R)
    | h2 : properUPred_ent
        (mkProperSep A (mkProperSep C (mkProperSep B R)))
        (mkProperSep C (mkProperSep A (mkProperSep B R))) =>
        sep_swap_ent A C (mkProperSep B R)
  \in \lam n x hv h => h2 n x hv (h1 n x hv h)

\lemma sep_permute6_close {M : UCMRA} (A B C D E F : ProperUPred M)
  : properUPred_ent
      (mkProperSep (mkProperSep (mkProperSep A (mkProperSep B C)) D)
        (mkProperSep E F))
      (mkProperSep (mkProperSep E (mkProperSep A (mkProperSep D B)))
        (mkProperSep C F)) =>
  \let
    | Flat => mkProperSep A (mkProperSep B (mkProperSep C
        (mkProperSep D (mkProperSep E F))))
    | Moved => mkProperSep E (mkProperSep A (mkProperSep B
        (mkProperSep C (mkProperSep D F))))
    | Rotated => mkProperSep E (mkProperSep A (mkProperSep D
        (mkProperSep B (mkProperSep C F))))
    | hflat : properUPred_ent
        (mkProperSep (mkProperSep (mkProperSep A (mkProperSep B C)) D)
          (mkProperSep E F)) Flat =>
        \lam n x hv h =>
          \let
            | h1 => sep_assoc_l_ent (mkProperSep A (mkProperSep B C)) D
                (mkProperSep E F) n x hv h
            | h2 => sep_assoc_l_ent A (mkProperSep B C)
                (mkProperSep D (mkProperSep E F)) n x hv h1
            | h3 => sep_mono_r_ent A
                (mkProperSep (mkProperSep B C) (mkProperSep D (mkProperSep E F)))
                (mkProperSep B (mkProperSep C (mkProperSep D (mkProperSep E F))))
                (sep_assoc_l_ent B C (mkProperSep D (mkProperSep E F)))
                n x hv h2
          \in h3
    | hmove : properUPred_ent Flat Moved =>
        sep_move_fifth_front A B C D E F
    | hrotate : properUPred_ent Moved Rotated =>
        sep_mono_r_ent E
          (mkProperSep A (mkProperSep B (mkProperSep C (mkProperSep D F))))
          (mkProperSep A (mkProperSep D (mkProperSep B (mkProperSep C F))))
          (sep_mono_r_ent A
            (mkProperSep B (mkProperSep C (mkProperSep D F)))
            (mkProperSep D (mkProperSep B (mkProperSep C F)))
            (sep_rotate_third_front B C D F))
    | hgroup : properUPred_ent Rotated
        (mkProperSep (mkProperSep E (mkProperSep A (mkProperSep D B)))
          (mkProperSep C F)) =>
        \lam n x hv h =>
          \let
            | inner1 => sep_mono_r_ent A
                (mkProperSep D (mkProperSep B (mkProperSep C F)))
                (mkProperSep (mkProperSep D B) (mkProperSep C F))
                (sep_assoc_r_ent D B (mkProperSep C F))
            | inner2 => sep_assoc_r_ent A (mkProperSep D B) (mkProperSep C F)
            | h1 => sep_mono_r_ent E
                (mkProperSep A (mkProperSep D (mkProperSep B (mkProperSep C F))))
                (mkProperSep (mkProperSep A (mkProperSep D B)) (mkProperSep C F))
                (properUPred_ent_trans
                  (mkProperSep A (mkProperSep D (mkProperSep B (mkProperSep C F))))
                  (mkProperSep A (mkProperSep (mkProperSep D B) (mkProperSep C F)))
                  (mkProperSep (mkProperSep A (mkProperSep D B)) (mkProperSep C F))
                  inner1 inner2) n x hv h
          \in sep_assoc_r_ent E (mkProperSep A (mkProperSep D B))
            (mkProperSep C F) n x hv h1
  \in \lam n x hv h => hgroup n x hv
    (hrotate n x hv (hmove n x hv (hflat n x hv h)))

\sfunc own_inv_open_resources {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S) (i : gname)
    (hiN : coPIn i (nclose N)) (hNE : coPSubset (nclose N) E)
  : properUPred_ent
      (mkProperSep (ownI W i P) (mkProperSep (wsat W) (ownE W E)))
      (mkProperSep
        (mkProperSep (wsat W)
          (mkProperSep (ownI W i P)
            (mkProperSep (mkProperLater P) (ownD W (gset_singleton i)))))
        (mkProperSep
          (ownE W (coPset_difference (nclose N) (coPset_singleton i)))
          (ownE W (coPset_difference E (nclose N))))) =>
  \let
    | I => ownI W i P
    | OE => ownE W E
    | ON => ownE W (nclose N)
    | Oi => ownE W (coPset_singleton i)
    | ONi => ownE W (coPset_difference (nclose N) (coPset_singleton i))
    | OR => ownE W (coPset_difference E (nclose N))
    | Tail => mkProperSep ONi OR
    | step1 : properUPred_ent (mkProperSep I (mkProperSep (wsat W) OE))
        (mkProperSep (wsat W) (mkProperSep I OE)) =>
        sep_swap_ent I (wsat W) OE
    | splitE : properUPred_ent OE (mkProperSep ON OR) =>
        ownE_split_subset W E (nclose N) hNE
    | splitN : properUPred_ent ON (mkProperSep Oi ONi) =>
        ownE_split_subset W (nclose N) (coPset_singleton i)
          (coPset_singleton_subset i (nclose N) hiN)
    | step2 : properUPred_ent (mkProperSep (wsat W) (mkProperSep I OE))
        (mkProperSep (wsat W)
          (mkProperSep I (mkProperSep (mkProperSep Oi ONi) OR))) =>
        sep_mono_r_ent (wsat W) (mkProperSep I OE)
          (mkProperSep I (mkProperSep (mkProperSep Oi ONi) OR))
          (sep_mono_r_ent I OE (mkProperSep (mkProperSep Oi ONi) OR)
            (properUPred_ent_trans OE (mkProperSep ON OR)
              (mkProperSep (mkProperSep Oi ONi) OR) splitE
              (sep_mono_l_ent ON (mkProperSep Oi ONi) OR splitN)))
    | step3 : properUPred_ent
        (mkProperSep (wsat W)
          (mkProperSep I (mkProperSep (mkProperSep Oi ONi) OR)))
        (mkProperSep (mkProperSep (wsat W) (mkProperSep I Oi)) Tail) =>
        properUPred_ent_trans
          (mkProperSep (wsat W)
            (mkProperSep I (mkProperSep (mkProperSep Oi ONi) OR)))
          (mkProperSep (wsat W)
            (mkProperSep (mkProperSep I Oi) (mkProperSep ONi OR)))
          (mkProperSep (mkProperSep (wsat W) (mkProperSep I Oi)) Tail)
          (sep_mono_r_ent (wsat W)
            (mkProperSep I (mkProperSep (mkProperSep Oi ONi) OR))
            (mkProperSep (mkProperSep I Oi) (mkProperSep ONi OR))
            (properUPred_ent_trans
              (mkProperSep I (mkProperSep (mkProperSep Oi ONi) OR))
              (mkProperSep I (mkProperSep Oi (mkProperSep ONi OR)))
              (mkProperSep (mkProperSep I Oi) (mkProperSep ONi OR))
              (sep_mono_r_ent I (mkProperSep (mkProperSep Oi ONi) OR)
                (mkProperSep Oi (mkProperSep ONi OR))
                (sep_assoc_l_ent Oi ONi OR))
              (sep_assoc_r_ent I Oi (mkProperSep ONi OR))))
          (sep_assoc_r_ent (wsat W) (mkProperSep I Oi) Tail)
    | step4 : properUPred_ent
        (mkProperSep (mkProperSep (wsat W) (mkProperSep I Oi)) Tail)
        (mkProperSep
          (mkProperSep (wsat W)
            (mkProperSep I (mkProperSep (mkProperLater P)
              (ownD W (gset_singleton i))))) Tail) =>
        sep_mono_l_ent (mkProperSep (wsat W) (mkProperSep I Oi))
          (mkProperSep (wsat W)
            (mkProperSep I (mkProperSep (mkProperLater P)
              (ownD W (gset_singleton i))))) Tail
          (ownI_open_keep W i P)
  \in \lam n x hv h => step4 n x hv (step3 n x hv (step2 n x hv (step1 n x hv h)))

\sfunc own_inv_close_world {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S) (i : gname)
    (hiN : coPIn i (nclose N)) (hNE : coPSubset (nclose N) E)
  : properUPred_ent
      (mkProperSep
        (mkProperSep
          (mkProperSep (ownI W i P)
            (mkProperSep (ownD W (gset_singleton i))
              (ownE W (coPset_difference (nclose N) (coPset_singleton i)))))
          (mkProperLater P))
        (mkProperSep (wsat W) (ownE W (coPset_difference E (nclose N)))))
      (mkProperSep (wsat W) (ownE W E)) =>
  \let
    | I => ownI W i P
    | D => ownD W (gset_singleton i)
    | ONi => ownE W (coPset_difference (nclose N) (coPset_singleton i))
    | LP => mkProperLater P
    | OR => ownE W (coPset_difference E (nclose N))
    | Oi => ownE W (coPset_singleton i)
    | ON => ownE W (nclose N)
    | permuted : properUPred_ent
        (mkProperSep (mkProperSep (mkProperSep I (mkProperSep D ONi)) LP)
          (mkProperSep (wsat W) OR))
        (mkProperSep
          (mkProperSep (wsat W) (mkProperSep I (mkProperSep LP D)))
          (mkProperSep ONi OR)) =>
        sep_permute6_close I D ONi LP (wsat W) OR
    | closed : properUPred_ent
        (mkProperSep
          (mkProperSep (wsat W) (mkProperSep I (mkProperSep LP D)))
          (mkProperSep ONi OR))
        (mkProperSep (mkProperSep (wsat W) Oi) (mkProperSep ONi OR)) =>
        sep_mono_l_ent
          (mkProperSep (wsat W) (mkProperSep I (mkProperSep LP D)))
          (mkProperSep (wsat W) Oi) (mkProperSep ONi OR)
          (ownI_close W i P)
    | joined : properUPred_ent
        (mkProperSep (mkProperSep (wsat W) Oi) (mkProperSep ONi OR))
        (mkProperSep (wsat W) (ownE W E)) =>
        \lam n x hv h =>
          \let
            | h1 => sep_assoc_l_ent (wsat W) Oi (mkProperSep ONi OR)
                n x hv h
            | h2 => sep_mono_r_ent (wsat W)
                (mkProperSep Oi (mkProperSep ONi OR))
                (mkProperSep ON (ownE W (coPset_difference E (nclose N))))
                (properUPred_ent_trans
                  (mkProperSep Oi (mkProperSep ONi OR))
                  (mkProperSep (mkProperSep Oi ONi) OR)
                  (mkProperSep ON OR)
                  (sep_assoc_r_ent Oi ONi OR)
                  (sep_mono_l_ent (mkProperSep Oi ONi) ON OR
                    (ownE_join_subset W (nclose N) (coPset_singleton i)
                      (coPset_singleton_subset i (nclose N) hiN))))
                n x hv h1
          \in sep_mono_r_ent (wsat W)
            (mkProperSep ON (ownE W (coPset_difference E (nclose N))))
            (ownE W E)
            (ownE_join_subset W E (nclose N) hNE) n x hv h2
  \in \lam n x hv h => joined n x hv (closed n x hv (permuted n x hv h))

\sfunc own_inv_close_fupd {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S) (i : gname)
    (hiN : coPIn i (nclose N)) (hNE : coPSubset (nclose N) E)
  : properUPred_ent
      (mkProperSep
        (mkProperSep
          (mkProperSep (ownI W i P)
            (mkProperSep (ownD W (gset_singleton i))
              (ownE W (coPset_difference (nclose N) (coPset_singleton i)))))
          (mkProperLater P))
        (mkProperSep (wsat W) (ownE W (coPset_difference E (nclose N)))))
      (mkProperBUpd (mkProperExceptZero
        (mkProperSep (wsat W) (mkProperSep (ownE W E) mkProperEmp)))) =>
  \let
    | World => mkProperSep (wsat W) (ownE W E)
    | Target => mkProperSep (wsat W) (mkProperSep (ownE W E) mkProperEmp)
    | addEmp : properUPred_ent World Target =>
        sep_mono_r_ent (wsat W) (ownE W E)
          (mkProperSep (ownE W E) mkProperEmp) (add_emp_r_ent (ownE W E))
  \in \lam n x hv h =>
    bupd_intro (mkProperExceptZero Target) n x hv
      (byRight (addEmp n x hv (own_inv_close_world W N E P i hiN hNE n x hv h)))

\sfunc own_inv_close_token {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S) (i : gname)
    (hiN : coPIn i (nclose N)) (hNE : coPSubset (nclose N) E)
  : properUPred_ent
      (mkProperSep (ownI W i P)
        (mkProperSep (ownD W (gset_singleton i))
          (ownE W (coPset_difference (nclose N) (coPset_singleton i)))))
      (mkProperWand (mkProperLater P)
        (mkProperFUpd W (coPset_difference E (nclose N)) E mkProperEmp)) =>
  \let
    | R => mkProperSep (ownI W i P)
        (mkProperSep (ownD W (gset_singleton i))
          (ownE W (coPset_difference (nclose N) (coPset_singleton i))))
    | LP => mkProperLater P
    | F => mkProperFUpd W (coPset_difference E (nclose N)) E mkProperEmp
    | close : properUPred_ent (mkProperSep R LP) F =>
        \lam n x hv h m m_le_n frame hv_op hworld =>
          \let
            | hm : (mkProperSep R LP).upred_holds m x =>
                (mkProperSep R LP).upred_mono n m x x h
                  (inclN_refl_ucmra {iResUR S} m x) m_le_n
            | combined : (mkProperSep (mkProperSep R LP)
                (mkProperSep (wsat W)
                  (ownE W (coPset_difference E (nclose N))))).upred_holds m
                ((iResUR S).op x frame) =>
                inP (x, frame, (iResUR S).ofe_dist_refl m ((iResUR S).op x frame),
                  hm, hworld)
          \in own_inv_close_fupd W N E P i hiN hNE
            m ((iResUR S).op x frame) hv_op combined
  \in wand_intro_ent R LP F close

\func own_inv_acc_target {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S) : iProp S =>
  mkProperSep (wsat W)
    (mkProperSep (ownE W (coPset_difference E (nclose N)))
      (mkProperSep (mkProperLater P)
        (mkProperWand (mkProperLater P)
          (mkProperFUpd W (coPset_difference E (nclose N)) E mkProperEmp))))

\sfunc own_inv_acc_open_i {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S) (i : gname)
    (hiN : coPIn i (nclose N)) (hNE : coPSubset (nclose N) E)
  : properUPred_ent
      (mkProperSep (ownI W i P) (mkProperSep (wsat W) (ownE W E)))
      (own_inv_acc_target W N E P) =>
  \let
    | I => ownI W i P
    | LP => mkProperLater P
    | D => ownD W (gset_singleton i)
    | ONi => ownE W (coPset_difference (nclose N) (coPset_singleton i))
    | OR => ownE W (coPset_difference E (nclose N))
    | CloseR => mkProperSep I (mkProperSep D ONi)
    | Close => mkProperWand LP
        (mkProperFUpd W (coPset_difference E (nclose N)) E mkProperEmp)
    | opened => own_inv_open_resources W N E P i hiN hNE
    | arranged : properUPred_ent
        (mkProperSep
          (mkProperSep (wsat W) (mkProperSep I (mkProperSep LP D)))
          (mkProperSep ONi OR))
        (mkProperSep (wsat W) (mkProperSep OR (mkProperSep LP CloseR))) =>
        \lam n x hv h =>
          \let
            | h1 => sep_assoc_l_ent (wsat W) (mkProperSep I (mkProperSep LP D))
                (mkProperSep ONi OR) n x hv h
            | h2 => sep_mono_r_ent (wsat W)
                (mkProperSep (mkProperSep I (mkProperSep LP D))
                  (mkProperSep ONi OR))
                (mkProperSep OR (mkProperSep LP (mkProperSep I (mkProperSep D ONi))))
                (sep_permute5 I LP D ONi OR) n x hv h1
          \in h2
    | closeToken : properUPred_ent
        (mkProperSep (wsat W) (mkProperSep OR (mkProperSep LP CloseR)))
        (own_inv_acc_target W N E P) =>
        sep_mono_r_ent (wsat W) (mkProperSep OR (mkProperSep LP CloseR))
          (mkProperSep OR (mkProperSep LP Close))
          (sep_mono_r_ent OR (mkProperSep LP CloseR) (mkProperSep LP Close)
            (sep_mono_r_ent LP CloseR Close
              (own_inv_close_token W N E P i hiN hNE)))
  \in \lam n x hv h => closeToken n x hv (arranged n x hv (opened n x hv h))

\sfunc own_inv_acc_prepare {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S)
    (hNE : coPSubset (nclose N) E)
  : properUPred_ent
      (mkProperSep (own_inv W N P) (mkProperSep (wsat W) (ownE W E)))
      (own_inv_acc_target W N E P) =>
  sep_exist_l_elim
    (\lam i => mkProperAnd (mkProperPure (coPIn i (nclose N))) (ownI W i P))
    (mkProperSep (wsat W) (ownE W E)) (own_inv_acc_target W N E P)
    (\lam i n x hv h =>
      \case h \with {
        | inP (a, b, dab, hi, hworld) =>
          own_inv_acc_open_i W N E P i hi.1 hNE n x hv
            (sep_mono_l_ent
              (mkProperAnd (mkProperPure (coPIn i (nclose N))) (ownI W i P))
              (ownI W i P) (mkProperSep (wsat W) (ownE W E))
              (\lam k y _ hand => hand.2)
              n x hv (inP (a, b, dab, hi, hworld)))
      })

\sfunc own_inv_acc {S : gFunctors} (W : wsatGS S)
    (E : coPset) (N : Namespace) (P : iProp S)
    (hNE : coPSubset (nclose N) E)
  : properUPred_ent (own_inv W N P)
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (mkProperLater P)
          (mkProperWand (mkProperLater P)
            (mkProperFUpd W (coPset_difference E (nclose N)) E mkProperEmp)))) =>
  \lam n x hv hown m m_le_n frame hv_op hworld =>
    \let
      | hown_m : (own_inv W N P).upred_holds m x =>
          (own_inv W N P).upred_mono n m x x hown
            (inclN_refl_ucmra {iResUR S} m x) m_le_n
      | combined : (mkProperSep (own_inv W N P)
          (mkProperSep (wsat W) (ownE W E))).upred_holds m
          ((iResUR S).op x frame) =>
          inP (x, frame, (iResUR S).ofe_dist_refl m ((iResUR S).op x frame),
            hown_m, hworld)
      | opened => own_inv_acc_prepare W N E P hNE
          m ((iResUR S).op x frame) hv_op combined
    \in bupd_intro
      (mkProperExceptZero (own_inv_acc_target W N E P))
      m ((iResUR S).op x frame) hv_op (byRight opened)

\lemma own_inv_persistent {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (P : iProp S)
  : properUPred_ent (own_inv W N P)
      (mkProperPersistently (own_inv W N P)) =>
  \lam n x hv hown => \case hown \with {
    | inP (i, hi) => inP (i,
        (hi.1, own_core_persistent W.wsatGpreS_inv W.invariant_name
          (wsat_inv_frag i DfracDiscarded
            (to_agree (invariant_unfold P)))
          (ownI_core_id i P) n x hv hi.2))
  }

\lemma own_inv_to_inv {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (P : iProp S)
  : properUPred_ent (own_inv W N P) (inv W N P) =>
  \lam n x hv hown =>
    transport (\lam (Q : iProp S) => Q.upred_holds n x)
      (Paths.inv (inv_peval W N P))
      (\let
        | hcore : (own_inv W N P).upred_holds n
            (ucmra_core {iResUR S} x) =>
            own_inv_persistent W N P n x hv hown
        \in \lam E m m_le_n b incl_core_b hv_b hNE =>
          own_inv_acc W E N P hNE m b hv_b
          ((own_inv W N P).upred_mono n m (ucmra_core {iResUR S} x) b
            hcore incl_core_b m_le_n))

\lemma inv_persistent {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (P : iProp S)
  : properUPred_ent (inv W N P) (mkProperPersistently (inv W N P)) =>
  \lam n x hv hinv =>
    transport (\lam (Q : iProp S) => Q.upred_holds n x)
      (Paths.inv (pmap mkProperPersistently (inv_peval W N P)))
      ((BIuPredPersistentlyMixin (iResUR S)).persistently_idemp_2
        (inv_inner W N P) n x hv
        (transport (\lam (Q : iProp S) => Q.upred_holds n x)
          (inv_peval W N P) hinv))

\lemma inv_acc {S : gFunctors} (W : wsatGS S)
    (E : coPset) (N : Namespace) (P : iProp S)
    (hNE : coPSubset (nclose N) E)
  : properUPred_ent (inv W N P)
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (mkProperLater P)
          (mkProperWand (mkProperLater P)
            (mkProperFUpd W (coPset_difference E (nclose N)) E
              mkProperEmp)))) =>
  \lam n x hv hinv =>
    \let
      | hbody : (inv_body W N P).upred_holds n x =>
          transport (\lam (Q : iProp S) => Q.upred_holds n x)
            (inv_peval W N P) hinv
      | hinner_core : (inv_inner W N P).upred_holds n
          (ucmra_core {iResUR S} x) => hbody
      | core_incl : inclN {iResUR S}
          {\new Op (iResUR S).E { | op => (iResUR S).op }}
          (ucmra_core {iResUR S} x) n x =>
          inP (x, equiv_dist {iResUR S}
            {x} {(iResUR S).op (ucmra_core {iResUR S} x) x}
            ((iResUR S).equiv_sym
              ((iResUR S).op (ucmra_core {iResUR S} x) x) x
              (ucmra_core_left_id {iResUR S} x)) n)
      | hinner : (inv_inner W N P).upred_holds n x =>
          (inv_inner W N P).upred_mono n n (ucmra_core {iResUR S} x) x
            hinner_core core_incl <=-refl
    \in hinner E n <=-refl x (inclN_refl_ucmra {iResUR S} n x) hv hNE

\func own_inv_alloc_result {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (P : iProp S) : iProp S =>
  mkProperExist gname (\lam i =>
    mkProperSep (mkProperPure (coPIn i (nclose N)))
      (mkProperSep (wsat W) (ownI W i P)))

\func own_inv_alloc_target {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S) : iProp S =>
  mkProperSep (wsat W) (mkProperSep (ownE W E) (own_inv W N P))

\sfunc own_inv_alloc_inner {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S) (i : gname)
  : properUPred_ent
      (mkProperSep (mkProperPure (coPIn i (nclose N)))
        (mkProperSep (ownI W i P) (ownE W E)))
      (mkProperSep (ownE W E) (own_inv W N P)) =>
  \let
    | A => mkProperPure (coPIn i (nclose N))
    | I => ownI W i P
    | O => ownE W E
    | AI => mkProperSep A I
    | step1 : properUPred_ent (mkProperSep A (mkProperSep I O))
        (mkProperSep AI O) => sep_assoc_r_ent A I O
    | step2 : properUPred_ent (mkProperSep AI O)
        (mkProperSep O AI) => sep_comm_ent AI O
    | step3 : properUPred_ent (mkProperSep O AI)
        (mkProperSep O (own_inv W N P)) =>
        sep_mono_r_ent O AI (own_inv W N P) (own_inv_intro W N P i)
  \in \lam n x hv h =>
    \let
      | h1 => step1 n x hv h
      | h2 => step2 n x hv h1
    \in step3 n x hv h2

\sfunc own_inv_alloc_witness {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S) (i : gname)
  : properUPred_ent
      (mkProperSep
        (mkProperSep (mkProperPure (coPIn i (nclose N)))
          (mkProperSep (wsat W) (ownI W i P)))
        (ownE W E))
      (own_inv_alloc_target W N E P) =>
  \let
    | A => mkProperPure (coPIn i (nclose N))
    | I => ownI W i P
    | O => ownE W E
    | step1a : properUPred_ent (mkProperSep (mkProperSep A
        (mkProperSep (wsat W) I)) O)
        (mkProperSep A (mkProperSep (mkProperSep (wsat W) I) O)) =>
        sep_assoc_l_ent A (mkProperSep (wsat W) I) O
    | step1b : properUPred_ent
        (mkProperSep A (mkProperSep (mkProperSep (wsat W) I) O))
        (mkProperSep A (mkProperSep (wsat W) (mkProperSep I O))) =>
        sep_mono_r_ent A (mkProperSep (mkProperSep (wsat W) I) O)
          (mkProperSep (wsat W) (mkProperSep I O))
          (sep_assoc_l_ent (wsat W) I O)
    | step2 : properUPred_ent
        (mkProperSep A (mkProperSep (wsat W) (mkProperSep I O)))
        (mkProperSep (wsat W) (mkProperSep A (mkProperSep I O))) =>
        sep_swap_ent A (wsat W) (mkProperSep I O)
    | step3 : properUPred_ent
        (mkProperSep (wsat W) (mkProperSep A (mkProperSep I O)))
        (own_inv_alloc_target W N E P) =>
        sep_mono_r_ent (wsat W) (mkProperSep A (mkProperSep I O))
          (mkProperSep O (own_inv W N P))
          (own_inv_alloc_inner W N E P i)
  \in \lam n x hv h =>
    \let
      | h1a => step1a n x hv h
      | h1b => step1b n x hv h1a
      | h2 => step2 n x hv h1b
    \in step3 n x hv h2

\sfunc own_inv_alloc_reshape {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S)
  : properUPred_ent
      (mkProperSep (own_inv_alloc_result W N P) (ownE W E))
      (own_inv_alloc_target W N E P) =>
  sep_exist_l_elim
    (\lam i => mkProperSep (mkProperPure (coPIn i (nclose N)))
      (mkProperSep (wsat W) (ownI W i P)))
    (ownE W E) (own_inv_alloc_target W N E P)
    (own_inv_alloc_witness W N E P)

\sfunc own_inv_alloc_finish {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S)
  : properUPred_ent
      (mkProperSep (mkProperBUpd (own_inv_alloc_result W N P)) (ownE W E))
      (mkProperBUpd (mkProperExceptZero (own_inv_alloc_target W N E P))) =>
  \let
    | R => own_inv_alloc_result W N P
    | T => own_inv_alloc_target W N E P
    | cont : properUPred_ent (mkProperSep R (ownE W E))
        (mkProperBUpd (mkProperExceptZero T)) =>
        properUPred_ent_trans (mkProperSep R (ownE W E)) T
          (mkProperBUpd (mkProperExceptZero T))
          (own_inv_alloc_reshape W N E P)
          (properUPred_ent_trans T (mkProperExceptZero T)
            (mkProperBUpd (mkProperExceptZero T))
            (or_intro_r_ent (mkProperLater (mkProperPure Empty)) T)
            (bupd_intro (mkProperExceptZero T)))
  \in bupd_frame_trans R (ownE W E) (mkProperExceptZero T) cont

\sfunc own_inv_alloc {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S)
  : properUPred_ent (mkProperLater P)
      (mkProperFUpd W E E (own_inv W N P)) =>
  \lam n x hv hp m m_le_n frame hv_op hworld =>
    \let
      | hp_m : (mkProperLater P).upred_holds m x =>
          (mkProperLater P).upred_mono n m x x hp
            (inclN_refl_ucmra {iResUR S} m x) m_le_n
      | start : (mkProperSep (mkProperLater P)
          (mkProperSep (wsat W) (ownE W E))).upred_holds m
          ((iResUR S).op x frame) =>
          inP (x, frame, (iResUR S).ofe_dist_refl m ((iResUR S).op x frame),
            hp_m, hworld)
      | prepared : (mkProperSep (mkProperSep (wsat W) (mkProperLater P))
          (ownE W E)).upred_holds m ((iResUR S).op x frame) =>
          properUPred_ent_trans
            (mkProperSep (mkProperLater P) (mkProperSep (wsat W) (ownE W E)))
            (mkProperSep (wsat W) (mkProperSep (mkProperLater P) (ownE W E)))
            (mkProperSep (mkProperSep (wsat W) (mkProperLater P)) (ownE W E))
            (sep_swap_ent (mkProperLater P) (wsat W) (ownE W E))
            (sep_assoc_r_ent (wsat W) (mkProperLater P) (ownE W E))
            m ((iResUR S).op x frame) hv_op start
      | framed : (mkProperSep (mkProperBUpd (own_inv_alloc_result W N P))
          (ownE W E)).upred_holds m ((iResUR S).op x frame) =>
          sep_mono_l_ent (mkProperSep (wsat W) (mkProperLater P))
            (mkProperBUpd (own_inv_alloc_result W N P)) (ownE W E)
            (ownI_alloc W (\lam i => coPIn i (nclose N)) P
              (fresh_inv_oracle N))
            m ((iResUR S).op x frame) hv_op prepared
    \in own_inv_alloc_finish W N E P
      m ((iResUR S).op x frame) hv_op framed

\lemma inv_alloc {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S)
  : properUPred_ent (mkProperLater P)
      (mkProperFUpd W E E (inv W N P)) =>
  properUPred_ent_trans (mkProperLater P)
    (mkProperFUpd W E E (own_inv W N P))
    (mkProperFUpd W E E (inv W N P))
    (own_inv_alloc W N E P)
    (fupd_mono W E E (own_inv W N P) (inv W N P)
      (own_inv_to_inv W N P))

-- =================================================================================
-- Derived invariant laws
-- =================================================================================

-- =================================================================================
-- §1  Generic distance congruences (left-hand versions of the `_r` lemmas
--     in uPred.ard).
-- =================================================================================

\lemma upredDist_trans {M : UCMRA} (n : Nat) (P Q R : ProperUPred M)
    (h1 : upredDist n P Q) (h2 : upredDist n Q R) : upredDist n P R =>
  \lam m a hm hv =>
    \let | pq => h1 m a hm hv | qr => h2 m a hm hv
    \in (\lam hp => qr.1 (pq.1 hp), \lam hr => pq.2 (qr.2 hr))

\lemma upredDist_sep_l {M : UCMRA} (n : Nat) (R P Q : ProperUPred M)
    (h : upredDist n P Q)
  : upredDist n (mkProperSep P R) (mkProperSep Q R) =>
  \lam m a hm hv =>
    ( \lam hsep => \case hsep \with {
        | inP (a1, a2, dist_a, hp, hr) =>
          inP (a1, a2, dist_a,
            (h m a1 hm (validN_sub_l m a a1 a2 hv dist_a)).1 hp, hr)
      }
    , \lam hsep => \case hsep \with {
        | inP (a1, a2, dist_a, hq, hr) =>
          inP (a1, a2, dist_a,
            (h m a1 hm (validN_sub_l m a a1 a2 hv dist_a)).2 hq, hr)
      }
    )

\lemma upredDist_wand_l {M : UCMRA} (n : Nat) (R P Q : ProperUPred M)
    (h : upredDist n P Q)
  : upredDist n (mkProperWand P R) (mkProperWand Q R) =>
  \lam m a hm hv =>
    ( \lam hwand k k_le_m a2 hv_op hq =>
        hwand k k_le_m a2 hv_op
          ((h k a2 ((NatSemiring.<=∘) k_le_m hm)
             (cmra_validN_op_r {M} k a a2 hv_op)).2 hq)
    , \lam hwand k k_le_m a2 hv_op hp =>
        hwand k k_le_m a2 hv_op
          ((h k a2 ((NatSemiring.<=∘) k_le_m hm)
             (cmra_validN_op_r {M} k a a2 hv_op)).1 hp)
    )

-- =================================================================================
-- §2  Distance lemmas for `inv` (Rocq: inv_contractive, inv_ne, inv_proper).
--     `P` occurs in `inv_inner` only under `▷` — once on the left of the
--     `sep` and once on the left of the closing wand — so contractiveness
--     composes from `upredDist_later` and the congruences above.
-- =================================================================================

\sfunc inv_inner_ne {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (n : Nat) (P Q : iProp S)
    (hl : upredDist n (mkProperLater P) (mkProperLater Q))
  : upredDist n (inv_inner W N P) (inv_inner W N Q) =>
  upredDist_forall coPset n
    (\lam E => mkProperImpl (mkProperPure (coPSubset (nclose N) E))
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (mkProperLater P)
          (mkProperWand (mkProperLater P)
            (mkProperFUpd W (coPset_difference E (nclose N)) E
              mkProperEmp)))))
    (\lam E => mkProperImpl (mkProperPure (coPSubset (nclose N) E))
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (mkProperLater Q)
          (mkProperWand (mkProperLater Q)
            (mkProperFUpd W (coPset_difference E (nclose N)) E
              mkProperEmp)))))
    (\lam E =>
      \let
        | F => mkProperFUpd W (coPset_difference E (nclose N)) E mkProperEmp
        | LP => mkProperLater P
        | LQ => mkProperLater Q
        | bodyP => mkProperSep LP (mkProperWand LP F)
        | bodyM => mkProperSep LQ (mkProperWand LP F)
        | bodyQ => mkProperSep LQ (mkProperWand LQ F)
        | hbody : upredDist n bodyP bodyQ =>
            upredDist_trans n bodyP bodyM bodyQ
              (upredDist_sep_l n (mkProperWand LP F) LP LQ hl)
              (upredDist_sep_r n LQ (mkProperWand LP F) (mkProperWand LQ F)
                (upredDist_wand_l n F LP LQ hl))
      \in upredDist_impl_r n (mkProperPure (coPSubset (nclose N) E))
        (mkProperFUpd W E (coPset_difference E (nclose N)) bodyP)
        (mkProperFUpd W E (coPset_difference E (nclose N)) bodyQ)
        (fupd_ne W n E (coPset_difference E (nclose N)) bodyP bodyQ hbody))

\sfunc inv_contractive {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (n : Nat) (P Q : iProp S)
    (h : \Pi (k : Nat) -> k NatOrder.< n -> upredDist k P Q)
  : upredDist n (inv W N P) (inv W N Q) =>
  \let
    | hl : upredDist n (mkProperLater P) (mkProperLater Q) =>
        upredDist_later n P Q h
    | hbody : upredDist n (inv_body W N P) (inv_body W N Q) =>
        upredDist_persistently n (inv_inner W N P) (inv_inner W N Q)
          (inv_inner_ne W N n P Q hl)
  \in transport (\lam (Z : iProp S) => upredDist n Z (inv W N Q))
        (Paths.inv (inv_peval W N P))
        (transport (\lam (Z : iProp S) => upredDist n (inv_body W N P) Z)
          (Paths.inv (inv_peval W N Q))
          hbody)

\lemma inv_ne {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (n : Nat) (P Q : iProp S) (h : upredDist n P Q)
  : upredDist n (inv W N P) (inv W N Q) =>
  inv_contractive W N n P Q
    (\lam k hk =>
      upredDist_le n k P Q h ((NatSemiring.<=∘) (n<=sucn k) (suc_<_<= hk)))

\lemma inv_proper {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (P Q : iProp S) (h : upredEquiv P Q)
  : upredEquiv (inv W N P) (inv W N Q) =>
  \lam n a hv =>
    inv_ne W N n P Q (\lam m b _ hvb => h m b hvb) n a <=-refl hv

-- =================================================================================
-- §3  Small entailment helpers.
-- =================================================================================

\lemma inv_unfold_ent {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (P : iProp S)
  : properUPred_ent (inv W N P) (inv_body W N P) =>
  transport (\lam (Z : iProp S) => properUPred_ent Z (inv_body W N P))
    (Paths.inv (inv_peval W N P))
    (properUPred_ent_refl (inv_body W N P))

\lemma inv_fold_ent {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (P : iProp S)
  : properUPred_ent (inv_body W N P) (inv W N P) =>
  transport (\lam (Z : iProp S) => properUPred_ent (inv_body W N P) Z)
    (Paths.inv (inv_peval W N P))
    (properUPred_ent_refl (inv_body W N P))

\lemma and_elim_l_ent {M : UCMRA} (P Q : ProperUPred M)
  : properUPred_ent (mkProperAnd P Q) P =>
  \lam n x hv h => h.1

\lemma and_elim_r_ent {M : UCMRA} (P Q : ProperUPred M)
  : properUPred_ent (mkProperAnd P Q) Q =>
  \lam n x hv h => h.2

-- (P -∗ Q) ∗ P ⊢ Q
\lemma wand_elim_ent {M : UCMRA} (P Q : ProperUPred M)
  : properUPred_ent (mkProperSep (mkProperWand P Q) P) Q =>
  \lam n x hv hs => \case hs \with {
    | inP (a1, a2, da, hw, hp) =>
      Q.upred_mono n n (M.op a1 a2) x
        (hw n <=-refl a2 (M.cmra_validN_ne n x (M.op a1 a2) da hv) hp)
        (inclN_of_dist_unit n (M.op a1 a2) x da)
        <=-refl
  }

-- Eliminate a disjunction while retaining a shared spatial frame.  Proof
-- mode performs this distribution implicitly when destructing an `iOr`.
\lemma sep_or_l_elim {M : UCMRA} (P Q R Z : ProperUPred M)
    (hP : properUPred_ent (mkProperSep P R) Z)
    (hQ : properUPred_ent (mkProperSep Q R) Z) :
  properUPred_ent (mkProperSep (mkProperOr P Q) R) Z =>
  \let
    | W => mkProperWand R Z
    | choose : properUPred_ent (mkProperOr P Q) W =>
        (BIuPredMixin M).bi_mixin_or_elim P Q W
          (wand_intro_ent P R Z hP) (wand_intro_ent Q R Z hQ)
  \in properUPred_ent_trans (mkProperSep (mkProperOr P Q) R)
      (mkProperSep W R) Z
      (sep_mono_l_ent (mkProperOr P Q) W R choose)
      (wand_elim_ent R Z)

-- Löb induction for concrete uPreds.  At index zero the premise `▷ P` is
-- trivial; at `suc n` the induction hypothesis supplies `P` at index `n`.
-- This is the term-mode counterpart of proof mode's `iLöb` and is needed by
-- recursive polling loops such as heap_lang `join`.
\lemma lob_ent {M : UCMRA} (P : ProperUPred M)
    (step : properUPred_ent (mkProperLater P) P) :
  properUPred_ent mkProperEmp P =>
  \lam n x hv _ => lob_at n x hv
  \where {
    \func lob_at (n : Nat) (x : M.E) (hv : M.validN n x) :
      P.upred_holds n x \elim n
      | 0 => step 0 x hv ()
      | suc k => step (suc k) x hv
          (lob_at k x (M.cmra_validN_le (suc k) k x hv (n<=sucn k)))
  }

\lemma lob_wand_apply_ent {M : UCMRA} (K P : ProperUPred M)
    (step : properUPred_ent
      (mkProperSep (mkProperLater (mkProperWand K P)) K) P) :
  properUPred_ent K P =>
  \let
    | W => mkProperWand K P
    | makeStep : properUPred_ent (mkProperLater W) W =>
        wand_intro_ent (mkProperLater W) K P step
    | getW : properUPred_ent mkProperEmp W => lob_ent W makeStep
  \in properUPred_ent_trans K (mkProperSep mkProperEmp K) P
      ((BIuPredMixin M).bi_mixin_emp_sep_1 K)
      (properUPred_ent_trans (mkProperSep mkProperEmp K)
        (mkProperSep W K) P
        (sep_mono_l_ent mkProperEmp W K getW)
        (wand_elim_ent K P))

\lemma forall_intro_ent {M : UCMRA} {T : \Set0} (X : ProperUPred M)
    (Phi : T -> ProperUPred M)
    (h : \Pi (t : T) -> properUPred_ent X (Phi t))
  : properUPred_ent X (mkProperForall T Phi) =>
  \lam n x hv hX t => h t n x hv hX

\lemma forall_elim_ent {M : UCMRA} {T : \Set0} (Phi : T -> ProperUPred M)
    (t : T)
  : properUPred_ent (mkProperForall T Phi) (Phi t) =>
  \lam n x hv hAll => hAll t

\lemma impl_pure_intro_ent {M : UCMRA} (phi : \Prop) (X Y : ProperUPred M)
    (h : phi -> properUPred_ent X Y)
  : properUPred_ent X (mkProperImpl (mkProperPure phi) Y) =>
  \lam n x hv hX m m_le_n b incl hvb hphi =>
    h hphi m b hvb (X.upred_mono n m x b hX incl m_le_n)

\lemma impl_pure_elim_ent {M : UCMRA} (phi : \Prop) (Y : ProperUPred M)
    (hphi : phi)
  : properUPred_ent (mkProperImpl (mkProperPure phi) Y) Y =>
  \lam n x hv himpl =>
    himpl n <=-refl x (inclN_refl_ucmra n x) hv hphi

-- □P ∗ □Q ⊢ □(P ∗ Q): both conjuncts move to the shared core (the core is
-- monotone), which is duplicable.
\lemma persistently_sep_2_ent {M : UCMRA} (P Q : ProperUPred M)
  : properUPred_ent
      (mkProperSep (mkProperPersistently P) (mkProperPersistently Q))
      (mkProperPersistently (mkProperSep P Q)) =>
  \lam n x hv hs => \case hs \with {
    | inP (a1, a2, da, hp, hq) =>
      \let
        | incl1 : inclN {M} {\new Op M.E { | op => M.op }} a1 n x =>
            inP (a2, da)
        | incl2 : inclN {M} {\new Op M.E { | op => M.op }} a2 n x =>
            inP (a1, M.ofe_dist_trans n x (M.op a1 a2) (M.op a2 a1) da
              (cmra_comm_dist n a1 a2))
        | hp' : P.upred_holds n (ucmra_core x) =>
            P.upred_mono n n (ucmra_core a1) (ucmra_core x) hp
              (ucmra_core_monoN n a1 x incl1) <=-refl
        | hq' : Q.upred_holds n (ucmra_core x) =>
            Q.upred_mono n n (ucmra_core a2) (ucmra_core x) hq
              (ucmra_core_monoN n a2 x incl2) <=-refl
      \in inP (ucmra_core x, ucmra_core x,
        equiv_dist {M}
          (M.equiv_sym (M.op (ucmra_core x) (ucmra_core x)) (ucmra_core x)
            (ucmra_core_dup x)) n,
        hp', hq')
  }

-- □P ⊢ □P ∗ □P
\lemma persistently_dup_ent {M : UCMRA} (P : ProperUPred M)
  : properUPred_ent (mkProperPersistently P)
      (mkProperSep (mkProperPersistently P) (mkProperPersistently P)) =>
  \lam n x hv hp =>
    inP (ucmra_core x, x,
      equiv_dist {M}
        (M.equiv_sym (M.op (ucmra_core x) x) x (ucmra_core_left_id x)) n,
      P.upred_mono n n (ucmra_core x) (ucmra_core (ucmra_core x)) hp
        (inclN_of_dist_unit n (ucmra_core x) (ucmra_core (ucmra_core x))
          (equiv_dist {M} (ucmra_core_idemp x) n))
        <=-refl,
      hp)

-- □(P → Q) ∗ P ⊢ Q
\lemma persistently_impl_elim_ent {M : UCMRA} (P Q : ProperUPred M)
  : properUPred_ent
      (mkProperSep (mkProperPersistently (mkProperImpl P Q)) P) Q =>
  \lam n x hv hs => \case hs \with {
    | inP (a1, a2, da, himpl, hp) =>
      \let
        | incl1 : inclN {M} {\new Op M.E { | op => M.op }} a1 n x =>
            inP (a2, da)
        | incl2 : inclN {M} {\new Op M.E { | op => M.op }} a2 n x =>
            inP (a1, M.ofe_dist_trans n x (M.op a1 a2) (M.op a2 a1) da
              (cmra_comm_dist n a1 a2))
        | inclc : inclN {M} {\new Op M.E { | op => M.op }}
            (ucmra_core a1) n x =>
            inclN_trans n (ucmra_core a1) a1 x
              (inP (a1,
                equiv_dist {M}
                  (M.equiv_sym (M.op (ucmra_core a1) a1) a1
                    (ucmra_core_left_id a1)) n))
              incl1
      \in himpl n <=-refl x inclc hv
            (P.upred_mono n n a2 x hp incl2 <=-refl)
  }

-- emp ⊢ P implies emp ⊢ □P.
\lemma persistently_intro_emp_ent {M : UCMRA} (P : ProperUPred M)
    (h : properUPred_ent mkProperEmp P)
  : properUPred_ent mkProperEmp (mkProperPersistently P) =>
  \lam n x hv _ =>
    h n (ucmra_core x) (ucmra_core_validN n x hv)
      (emp_holds_all n (ucmra_core x))

-- X ⊢ X ∗ R for any R provable from emp.
\lemma attach_valid_r_ent {M : UCMRA} (X R : ProperUPred M)
    (h : properUPred_ent mkProperEmp R)
  : properUPred_ent X (mkProperSep X R) =>
  properUPred_ent_trans X (mkProperSep X mkProperEmp) (mkProperSep X R)
    (add_emp_r_ent X)
    (sep_mono_r_ent X mkProperEmp R h)

\lemma later_persistently_of_emp {M : UCMRA} (R : ProperUPred M)
    (h : properUPred_ent mkProperEmp R)
  : properUPred_ent mkProperEmp
      (mkProperLater (mkProperPersistently R)) =>
  properUPred_ent_trans mkProperEmp
    (mkProperPersistently R)
    (mkProperLater (mkProperPersistently R))
    (persistently_intro_emp_ent R h)
    (proper_later_intro (mkProperPersistently R))

-- ▷(P -∗ X) ∗ ▷P ⊢ ▷X
\lemma later_wand_apply_ent {M : UCMRA} (P X : ProperUPred M)
  : properUPred_ent
      (mkProperSep (mkProperLater (mkProperWand P X)) (mkProperLater P))
      (mkProperLater X) =>
  properUPred_ent_trans
    (mkProperSep (mkProperLater (mkProperWand P X)) (mkProperLater P))
    (mkProperLater (mkProperSep (mkProperWand P X) P))
    (mkProperLater X)
    (proper_later_sep_2 (mkProperWand P X) P)
    (proper_later_mono (mkProperSep (mkProperWand P X) P) X
      (wand_elim_ent P X))

-- =================================================================================
-- §4  except_0_inv (Rocq: `◇ inv N P ⊢ inv N P`).  A direct model proof:
--     the ▷False disjunct is only inhabited at step index 0, where any
--     fancy update holds trivially (its basic update answers with the
--     except-0 left disjunct).
-- =================================================================================

\lemma fupd_holds_at_zero {S : gFunctors} (W : wsatGS S)
    (E1 E2 : coPset) (P : iProp S) (m : Nat) (hm : m <= 0) (b : iResUR S)
  : (mkProperFUpd W E1 E2 P).upred_holds m b =>
  \lam k k_le_m a2 hv_op hworld j j_le_k yf hv_yf =>
    \let hj : j <= 0 =>
        (NatSemiring.<=∘) j_le_k ((NatSemiring.<=∘) k_le_m hm)
    \in inP ((iResUR S).op b a2, hv_yf,
      \case \elim j, hj \with {
        | 0, _ => byLeft ()
        | suc j', hj' => absurd (hj' NatOrder.zero<suc)
      })

\lemma except_0_inv {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (P : iProp S)
  : properUPred_ent (mkProperExceptZero (inv W N P)) (inv W N P) =>
  \lam n x hv h => \case h \with {
    | byRight hinv => hinv
    | byLeft hz => \case \elim n, hz, hv \with {
      | 0, _, _ =>
          transport (\lam (Z : iProp S) => Z.upred_holds 0 x)
            (Paths.inv (inv_peval W N P))
            (\lam E m m_le0 b incl hvb hNE =>
              fupd_holds_at_zero W E (coPset_difference E (nclose N))
                (mkProperSep (mkProperLater P)
                  (mkProperWand (mkProperLater P)
                    (mkProperFUpd W (coPset_difference E (nclose N)) E
                      mkProperEmp)))
                m m_le0 b)
      | suc n', hz', _ => absurd hz'
    }
  }

-- =================================================================================
-- §5  inv_alter and inv_iff (Rocq invariants.v:101, :109).
-- =================================================================================

\func alter_wand {S : gFunctors} (P Q : iProp S) : iProp S =>
  mkProperWand P (mkProperSep Q (mkProperWand Q P))

-- (▷P ∗ (▷P -∗ F)) ∗ ▷(alter_wand P Q) ⊢ ▷Q ∗ (▷Q -∗ F)
\sfunc inv_alter_body {S : gFunctors} (P Q F : iProp S)
  : properUPred_ent
      (mkProperSep
        (mkProperSep (mkProperLater P) (mkProperWand (mkProperLater P) F))
        (mkProperLater (alter_wand P Q)))
      (mkProperSep (mkProperLater Q) (mkProperWand (mkProperLater Q) F)) =>
  \let
    | LP => mkProperLater P
    | LQ => mkProperLater Q
    | WPF => mkProperWand LP F
    | LW => mkProperLater (alter_wand P Q)
    | LQP => mkProperLater (mkProperWand Q P)
    | LQpair => mkProperLater (mkProperSep Q (mkProperWand Q P))
    | s1 : properUPred_ent (mkProperSep (mkProperSep LP WPF) LW)
        (mkProperSep LW (mkProperSep LP WPF)) =>
        sep_comm_ent (mkProperSep LP WPF) LW
    | s2 : properUPred_ent (mkProperSep LW (mkProperSep LP WPF))
        (mkProperSep (mkProperSep LW LP) WPF) =>
        sep_assoc_r_ent LW LP WPF
    | s3 : properUPred_ent (mkProperSep LW LP) (mkProperSep LQ LQP) =>
        properUPred_ent_trans (mkProperSep LW LP) LQpair
          (mkProperSep LQ LQP)
          (later_wand_apply_ent P (mkProperSep Q (mkProperWand Q P)))
          (proper_later_sep_1 Q (mkProperWand Q P))
    | s4 : properUPred_ent (mkProperSep (mkProperSep LW LP) WPF)
        (mkProperSep (mkProperSep LQ LQP) WPF) =>
        sep_mono_l_ent (mkProperSep LW LP) (mkProperSep LQ LQP) WPF s3
    | s5 : properUPred_ent (mkProperSep (mkProperSep LQ LQP) WPF)
        (mkProperSep LQ (mkProperSep LQP WPF)) =>
        sep_assoc_l_ent LQ LQP WPF
    | closeF : properUPred_ent
        (mkProperSep (mkProperSep LQP WPF) LQ) F =>
        \let
          | c1 : properUPred_ent (mkProperSep (mkProperSep LQP WPF) LQ)
              (mkProperSep LQ (mkProperSep LQP WPF)) =>
              sep_comm_ent (mkProperSep LQP WPF) LQ
          | c2 : properUPred_ent (mkProperSep LQ (mkProperSep LQP WPF))
              (mkProperSep LQP (mkProperSep LQ WPF)) =>
              sep_swap_ent LQ LQP WPF
          | c3 : properUPred_ent (mkProperSep LQP (mkProperSep LQ WPF))
              (mkProperSep (mkProperSep LQP LQ) WPF) =>
              sep_assoc_r_ent LQP LQ WPF
          | c4 : properUPred_ent (mkProperSep (mkProperSep LQP LQ) WPF)
              (mkProperSep LP WPF) =>
              sep_mono_l_ent (mkProperSep LQP LQ) LP WPF
                (later_wand_apply_ent Q P)
          | c5 : properUPred_ent (mkProperSep LP WPF) F =>
              properUPred_ent_trans (mkProperSep LP WPF)
                (mkProperSep WPF LP) F
                (sep_comm_ent LP WPF)
                (wand_elim_ent LP F)
        \in \lam n x hv h =>
          c5 n x hv (c4 n x hv (c3 n x hv (c2 n x hv (c1 n x hv h))))
    | s6 : properUPred_ent (mkProperSep LQ (mkProperSep LQP WPF))
        (mkProperSep LQ (mkProperWand LQ F)) =>
        sep_mono_r_ent LQ (mkProperSep LQP WPF) (mkProperWand LQ F)
          (wand_intro_ent (mkProperSep LQP WPF) LQ F closeF)
  \in \lam n x hv h =>
    s6 n x hv (s5 n x hv (s4 n x hv (s2 n x hv (s1 n x hv h))))

-- inv_inner P ∗ ▷(alter_wand P Q) ⊢ inv_inner Q
\sfunc inv_alter_inner {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (P Q : iProp S)
  : properUPred_ent
      (mkProperSep (inv_inner W N P) (mkProperLater (alter_wand P Q)))
      (inv_inner W N Q) =>
  forall_intro_ent
    (mkProperSep (inv_inner W N P) (mkProperLater (alter_wand P Q)))
    (\lam E => mkProperImpl (mkProperPure (coPSubset (nclose N) E))
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (mkProperLater Q)
          (mkProperWand (mkProperLater Q)
            (mkProperFUpd W (coPset_difference E (nclose N)) E
              mkProperEmp)))))
    (\lam E => impl_pure_intro_ent (coPSubset (nclose N) E)
      (mkProperSep (inv_inner W N P) (mkProperLater (alter_wand P Q)))
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (mkProperLater Q)
          (mkProperWand (mkProperLater Q)
            (mkProperFUpd W (coPset_difference E (nclose N)) E
              mkProperEmp))))
      (\lam hNE =>
        \let
          | F => mkProperFUpd W (coPset_difference E (nclose N)) E
              mkProperEmp
          | bodyP => mkProperSep (mkProperLater P)
              (mkProperWand (mkProperLater P) F)
          | bodyQ => mkProperSep (mkProperLater Q)
              (mkProperWand (mkProperLater Q) F)
          | LW => mkProperLater (alter_wand P Q)
          | fupdP => mkProperFUpd W E (coPset_difference E (nclose N)) bodyP
          | fupdQ => mkProperFUpd W E (coPset_difference E (nclose N)) bodyQ
          | openP : properUPred_ent (inv_inner W N P) fupdP =>
              properUPred_ent_trans (inv_inner W N P)
                (mkProperImpl (mkProperPure (coPSubset (nclose N) E)) fupdP)
                fupdP
                (forall_elim_ent
                  (\lam E' => mkProperImpl
                    (mkProperPure (coPSubset (nclose N) E'))
                    (mkProperFUpd W E' (coPset_difference E' (nclose N))
                      (mkProperSep (mkProperLater P)
                        (mkProperWand (mkProperLater P)
                          (mkProperFUpd W
                            (coPset_difference E' (nclose N)) E'
                            mkProperEmp)))))
                  E)
                (impl_pure_elim_ent (coPSubset (nclose N) E) fupdP hNE)
        \in properUPred_ent_trans
          (mkProperSep (inv_inner W N P) LW)
          (mkProperFUpd W E (coPset_difference E (nclose N))
            (mkProperSep bodyP LW))
          fupdQ
          (properUPred_ent_trans
            (mkProperSep (inv_inner W N P) LW)
            (mkProperSep fupdP LW)
            (mkProperFUpd W E (coPset_difference E (nclose N))
              (mkProperSep bodyP LW))
            (sep_mono_l_ent (inv_inner W N P) fupdP LW openP)
            (fupd_frame_r W E (coPset_difference E (nclose N)) bodyP LW))
          (fupd_mono W E (coPset_difference E (nclose N))
            (mkProperSep bodyP LW) bodyQ
            (inv_alter_body P Q F))))

\lemma inv_alter {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (P Q : iProp S)
  : properUPred_ent
      (mkProperSep (inv W N P)
        (mkProperLater (mkProperPersistently (alter_wand P Q))))
      (inv W N Q) =>
  \let
    | LPW => mkProperLater (mkProperPersistently (alter_wand P Q))
    | PLW => mkProperPersistently (mkProperLater (alter_wand P Q))
    | s1 : properUPred_ent
        (mkProperSep (inv W N P) LPW)
        (mkProperSep (inv_body W N P) PLW) =>
        properUPred_ent_trans
          (mkProperSep (inv W N P) LPW)
          (mkProperSep (inv_body W N P) LPW)
          (mkProperSep (inv_body W N P) PLW)
          (sep_mono_l_ent (inv W N P) (inv_body W N P) LPW
            (inv_unfold_ent W N P))
          (sep_mono_r_ent (inv_body W N P) LPW PLW
            (proper_later_persistently_1 (alter_wand P Q)))
    | s2 : properUPred_ent
        (mkProperSep (inv_body W N P) PLW)
        (mkProperPersistently
          (mkProperSep (inv_inner W N P)
            (mkProperLater (alter_wand P Q)))) =>
        persistently_sep_2_ent (inv_inner W N P)
          (mkProperLater (alter_wand P Q))
    | s3 : properUPred_ent
        (mkProperPersistently
          (mkProperSep (inv_inner W N P)
            (mkProperLater (alter_wand P Q))))
        (inv_body W N Q) =>
        (BIuPredPersistentlyMixin (iResUR S)).persistently_mono
          (mkProperSep (inv_inner W N P) (mkProperLater (alter_wand P Q)))
          (inv_inner W N Q)
          (inv_alter_inner W N P Q)
  \in \lam n x hv h =>
    inv_fold_ent W N Q n x hv (s3 n x hv (s2 n x hv (s1 n x hv h)))

\func iff_body {S : gFunctors} (P Q : iProp S) : iProp S =>
  mkProperAnd (mkProperImpl P Q) (mkProperImpl Q P)

-- □(P ↔ Q) ⊢ alter_wand P Q
\sfunc persistently_iff_to_alter {S : gFunctors} (P Q : iProp S)
  : properUPred_ent
      (mkProperPersistently (iff_body P Q))
      (alter_wand P Q) =>
  \let
    | PIF => mkProperPersistently (iff_body P Q)
    | body : properUPred_ent (mkProperSep PIF P)
        (mkProperSep Q (mkProperWand Q P)) =>
        \let
          | d1 : properUPred_ent (mkProperSep PIF P)
              (mkProperSep (mkProperSep PIF PIF) P) =>
              sep_mono_l_ent PIF (mkProperSep PIF PIF) P
                (persistently_dup_ent (iff_body P Q))
          | d2 : properUPred_ent (mkProperSep (mkProperSep PIF PIF) P)
              (mkProperSep PIF (mkProperSep PIF P)) =>
              sep_assoc_l_ent PIF PIF P
          | d3 : properUPred_ent (mkProperSep PIF (mkProperSep PIF P))
              (mkProperSep PIF Q) =>
              sep_mono_r_ent PIF (mkProperSep PIF P) Q
                (properUPred_ent_trans (mkProperSep PIF P)
                  (mkProperSep
                    (mkProperPersistently (mkProperImpl P Q)) P)
                  Q
                  (sep_mono_l_ent PIF
                    (mkProperPersistently (mkProperImpl P Q)) P
                    ((BIuPredPersistentlyMixin (iResUR S)).persistently_mono
                      (iff_body P Q) (mkProperImpl P Q)
                      (and_elim_l_ent (mkProperImpl P Q)
                        (mkProperImpl Q P))))
                  (persistently_impl_elim_ent P Q))
          | d4 : properUPred_ent (mkProperSep PIF Q)
              (mkProperSep Q PIF) => sep_comm_ent PIF Q
          | d5 : properUPred_ent (mkProperSep Q PIF)
              (mkProperSep Q (mkProperWand Q P)) =>
              sep_mono_r_ent Q PIF (mkProperWand Q P)
                (wand_intro_ent PIF Q P
                  (properUPred_ent_trans (mkProperSep PIF Q)
                    (mkProperSep
                      (mkProperPersistently (mkProperImpl Q P)) Q)
                    P
                    (sep_mono_l_ent PIF
                      (mkProperPersistently (mkProperImpl Q P)) Q
                      ((BIuPredPersistentlyMixin (iResUR S)).persistently_mono
                        (iff_body P Q) (mkProperImpl Q P)
                        (and_elim_r_ent (mkProperImpl P Q)
                          (mkProperImpl Q P))))
                    (persistently_impl_elim_ent Q P)))
        \in \lam n x hv h =>
          d5 n x hv (d4 n x hv (d3 n x hv (d2 n x hv (d1 n x hv h))))
  \in wand_intro_ent PIF P (mkProperSep Q (mkProperWand Q P)) body

\lemma inv_iff {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (P Q : iProp S)
  : properUPred_ent
      (mkProperSep (inv W N P)
        (mkProperLater (mkProperPersistently (iff_body P Q))))
      (inv W N Q) =>
  \let
    | PIF => mkProperPersistently (iff_body P Q)
    | convert : properUPred_ent (mkProperLater PIF)
        (mkProperLater (mkProperPersistently (alter_wand P Q))) =>
        proper_later_mono PIF
          (mkProperPersistently (alter_wand P Q))
          (properUPred_ent_trans PIF
            (mkProperPersistently PIF)
            (mkProperPersistently (alter_wand P Q))
            ((BIuPredPersistentlyMixin (iResUR S)).persistently_idemp_2
              (iff_body P Q))
            ((BIuPredPersistentlyMixin (iResUR S)).persistently_mono
              PIF (alter_wand P Q)
              (persistently_iff_to_alter P Q)))
  \in \lam n x hv h =>
    inv_alter W N P Q n x hv
      (sep_mono_r_ent (inv W N P) (mkProperLater PIF)
        (mkProperLater (mkProperPersistently (alter_wand P Q)))
        convert n x hv h)

-- =================================================================================
-- §6  inv_split_l / inv_split_r / inv_split (Rocq invariants.v:203-217).
-- =================================================================================

-- emp ⊢ (P∗Q) -∗ (P ∗ (P -∗ P∗Q))
\sfunc split_l_wand_valid {S : gFunctors} (P Q : iProp S)
  : properUPred_ent mkProperEmp (alter_wand (mkProperSep P Q) P) =>
  wand_intro_ent mkProperEmp (mkProperSep P Q)
    (mkProperSep P (mkProperWand P (mkProperSep P Q)))
    (properUPred_ent_trans
      (mkProperSep mkProperEmp (mkProperSep P Q))
      (mkProperSep P Q)
      (mkProperSep P (mkProperWand P (mkProperSep P Q)))
      (sep_elim_r_ent mkProperEmp (mkProperSep P Q))
      (sep_mono_r_ent P Q (mkProperWand P (mkProperSep P Q))
        (wand_intro_ent Q P (mkProperSep P Q)
          (sep_comm_ent Q P))))

-- emp ⊢ (P∗Q) -∗ (Q ∗ (Q -∗ P∗Q))
\sfunc split_r_wand_valid {S : gFunctors} (P Q : iProp S)
  : properUPred_ent mkProperEmp (alter_wand (mkProperSep P Q) Q) =>
  wand_intro_ent mkProperEmp (mkProperSep P Q)
    (mkProperSep Q (mkProperWand Q (mkProperSep P Q)))
    (properUPred_ent_trans
      (mkProperSep mkProperEmp (mkProperSep P Q))
      (mkProperSep P Q)
      (mkProperSep Q (mkProperWand Q (mkProperSep P Q)))
      (sep_elim_r_ent mkProperEmp (mkProperSep P Q))
      (properUPred_ent_trans (mkProperSep P Q) (mkProperSep Q P)
        (mkProperSep Q (mkProperWand Q (mkProperSep P Q)))
        (sep_comm_ent P Q)
        (sep_mono_r_ent Q P (mkProperWand Q (mkProperSep P Q))
          (wand_intro_ent P Q (mkProperSep P Q)
            (properUPred_ent_refl (mkProperSep P Q))))))

\lemma inv_split_l {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (P Q : iProp S)
  : properUPred_ent (inv W N (mkProperSep P Q)) (inv W N P) =>
  \lam n x hv h =>
    inv_alter W N (mkProperSep P Q) P n x hv
      (attach_valid_r_ent (inv W N (mkProperSep P Q))
        (mkProperLater (mkProperPersistently
          (alter_wand (mkProperSep P Q) P)))
        (later_persistently_of_emp
          (alter_wand (mkProperSep P Q) P)
          (split_l_wand_valid P Q))
        n x hv h)

\lemma inv_split_r {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (P Q : iProp S)
  : properUPred_ent (inv W N (mkProperSep P Q)) (inv W N Q) =>
  \lam n x hv h =>
    inv_alter W N (mkProperSep P Q) Q n x hv
      (attach_valid_r_ent (inv W N (mkProperSep P Q))
        (mkProperLater (mkProperPersistently
          (alter_wand (mkProperSep P Q) Q)))
        (later_persistently_of_emp
          (alter_wand (mkProperSep P Q) Q)
          (split_r_wand_valid P Q))
        n x hv h)

-- inv is persistent, hence duplicable.
\lemma inv_dup_ent {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (P : iProp S)
  : properUPred_ent (inv W N P)
      (mkProperSep (inv W N P) (inv W N P)) =>
  \lam n x hv h =>
    inP (ucmra_core {iResUR S} x, x,
      equiv_dist {iResUR S} {x} {(iResUR S).op (ucmra_core {iResUR S} x) x}
        ((iResUR S).equiv_sym ((iResUR S).op (ucmra_core {iResUR S} x) x) x
          (ucmra_core_left_id {iResUR S} x)) n,
      inv_persistent W N P n x hv h, h)

\lemma inv_split {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (P Q : iProp S)
  : properUPred_ent (inv W N (mkProperSep P Q))
      (mkProperSep (inv W N P) (inv W N Q)) =>
  \lam n x hv h =>
    sep_mono_r_ent (inv W N P) (inv W N (mkProperSep P Q)) (inv W N Q)
      (inv_split_r W N P Q) n x hv
      (sep_mono_l_ent (inv W N (mkProperSep P Q)) (inv W N P)
        (inv W N (mkProperSep P Q))
        (inv_split_l W N P Q) n x hv
        (inv_dup_ent W N (mkProperSep P Q) n x hv h))


-- =================================================================================
-- §7  coPset mask algebra + fupd mask rewriting (support for §8/§10/§11).
-- =================================================================================

\lemma bool_and_not_self (a : Bool) : (a and not a) = false \elim a
  | true => idp
  | false => idp

\lemma bool_and_not_self_or (a b : Bool) : ((a and not a) or b) = b \elim a
  | true => idp
  | false => idp

\lemma not_true_to_false (b : Bool) (h : not b = true) : b = false \elim b
  | true => false_neq_true h
  | false => idp

\lemma coPSubset_refl (X : coPset) : coPSubset X X => \lam _ h => h

\lemma coPSubset_trans (X Y Z : coPset)
    (h1 : coPSubset X Y) (h2 : coPSubset Y Z) : coPSubset X Z =>
  \lam p hp => h2 p (h1 p hp)

\lemma coPSubset_union_l (X Y Z : coPset)
    (h : coPSubset (coPset_union X Y) Z) : coPSubset X Z =>
  \lam p hp => h p (coPmem_union_just_inl X Y p hp)

\lemma coPSubset_union_r (X Y Z : coPset)
    (h : coPSubset (coPset_union X Y) Z) : coPSubset Y Z =>
  \lam p hp => h p (coPmem_union_just_inr X Y p hp)

-- p ∉ N transfers down a subset A ⊆ N.
\lemma subset_false_transfer (A N : coPset) (p : Pos)
    (h : coPSubset A N) (hN : coPmem p N = false)
  : coPmem p A = false =>
  \case coPmem p A \as b, idp : coPmem p A = b \return b = false \with {
    | true, e => absurd (true/=false (Paths.inv (h p e) *> hN))
    | false, _ => idp
  }

-- A ⊆ E and B ## A imply A ⊆ E ∖ B.
\lemma coPSubset_difference_of_disjoint (A B E : coPset)
    (hAE : coPSubset A E) (hdisj : coPDisjoint B A)
  : coPSubset A (coPset_difference E B) =>
  \lam p hp =>
    \let
      | hE : coPmem p E = true => hAE p hp
      | hB : coPmem p B = false =>
          \case coPmem p B \as b, idp : coPmem p B = b \return b = false \with {
            | true, e => absurd (true/=false (Paths.inv hp *> hdisj p e))
            | false, _ => idp
          }
    \in coPmem_difference p E B *> pmap2 (\lam u v => u and not v) hE hB

-- E∖N ⊆ (E∖N1)∖N2 when N1 ⊆ N and N2 ⊆ N.
\lemma coPset_diff_mono_subsets (E N N1 N2 : coPset)
    (h1 : coPSubset N1 N) (h2 : coPSubset N2 N)
  : coPSubset (coPset_difference E N)
      (coPset_difference (coPset_difference E N1) N2) =>
  \lam p hp =>
    \let
      | hpair => bool_and_true_inv (coPmem p E) (not (coPmem p N))
          (Paths.inv (coPmem_difference p E N) *> hp)
      | hE : coPmem p E = true => hpair.1
      | hN : coPmem p N = false => not_true_to_false (coPmem p N) hpair.2
      | hN1 : coPmem p N1 = false => subset_false_transfer N1 N p h1 hN
      | hN2 : coPmem p N2 = false => subset_false_transfer N2 N p h2 hN
      | hD1 : coPmem p (coPset_difference E N1) = true =>
          coPmem_difference p E N1
            *> pmap2 (\lam u v => u and not v) hE hN1
    \in coPmem_difference p (coPset_difference E N1) N2
        *> pmap2 (\lam u v => u and not v) hD1 hN2

-- (X∖X) ∪ Y ≡ Y
\lemma coPset_diff_self_union_equiv (X Y : coPset)
  : coPset_equiv (coPset_union (coPset_difference X X) Y) Y =>
  \lam p =>
    coPmem_union p (coPset_difference X X) Y
    *> pmap (\lam b => b or coPmem p Y) (coPmem_difference p X X)
    *> bool_and_not_self_or (coPmem p X) (coPmem p Y)

-- overlap (X∖X) Y = false
\lemma coPset_diff_self_overlap_false (X Y : coPset)
  : coPset_overlap (coPset_difference X X) Y = false =>
  coPset_overlap_disjoint (coPset_difference X X) Y
    (\lam p hp _ =>
      true/=false
        (Paths.inv hp
          *> coPmem_difference p X X
          *> bool_and_not_self (coPmem p X)))

-- fupd is proper for coPset_equiv in both masks (generalizes
-- fupd_same_mask_equiv from fupd_mask.ard).
\sfunc fupd_masks_proper {S : gFunctors} (W : wsatGS S)
    (E1 E1' E2 E2' : coPset) (P : iProp S)
    (h1 : coPset_equiv E1 E1') (h2 : coPset_equiv E2 E2')
  : properUPred_ent (mkProperFUpd W E1 E2 P) (mkProperFUpd W E1' E2' P) =>
  \let
    | body => mkProperSep (wsat W) (mkProperSep (ownE W E2) P)
    | body' => mkProperSep (wsat W) (mkProperSep (ownE W E2') P)
    | body_mono : properUPred_ent body body' =>
        sep_mono_r_ent (wsat W) (mkProperSep (ownE W E2) P)
          (mkProperSep (ownE W E2') P)
          (sep_mono_l_ent (ownE W E2) (ownE W E2') P
            (ownE_equiv_ent W E2 E2' h2))
  \in \lam n x hv hf m m_le_n frame hv_op hworld' =>
    \let
      | hworld : (mkProperSep (wsat W) (ownE W E1)).upred_holds m frame =>
          sep_mono_r_ent (wsat W) (ownE W E1') (ownE W E1)
            (ownE_equiv_ent W E1' E1 (coPset_equiv_sym E1 E1' h1))
            m frame (cmra_validN_op_r {iResUR S} m x frame hv_op) hworld'
      | hb : (mkProperBUpd (mkProperExceptZero body)).upred_holds m
          ((iResUR S).op x frame) =>
          hf m m_le_n frame hv_op hworld
    \in bupd_mono (mkProperExceptZero body) (mkProperExceptZero body')
          (except_zero_mono body body' body_mono)
          m ((iResUR S).op x frame) hv_op hb

-- weaken a fupd body into the disjointness implication that
-- fupd_mask_frame_r consumes.
\lemma fupd_intro_impl_pure {S : gFunctors} (W : wsatGS S)
    (E1 E2 : coPset) (phi : \Prop) (P : iProp S)
  : properUPred_ent (mkProperFUpd W E1 E2 P)
      (mkProperFUpd W E1 E2
        (mkProperImpl (mkProperPure phi) P)) =>
  fupd_mono W E1 E2 P (mkProperImpl (mkProperPure phi) P)
    (\lam n x hv hp m m_le_n b incl hvb _ =>
      P.upred_mono n m x b hp incl m_le_n)


-- =================================================================================
-- §8  inv_acc_strong (Rocq invariants.v:183): the close continuation works
--     at an arbitrary mask E', returning ↑N ∪ E'.
-- =================================================================================
-- Sealed implementation of §8 inv_acc_strong.  The inner per-E' fancy
-- update is kept opaque behind `sealedFUpd` (from fupd_mask.ard) during all
-- entailment composition, and the public unsealed statement is recovered by
-- one transport at the very end — the same discipline as
-- fupd_mask_subseteq_sealed.

-- the strong close continuation, sealed and unsealed forms
\func inv_acc_strong_close_sealed {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (P : iProp S) : iProp S =>
  mkProperForall coPset (\lam E' =>
    mkProperWand (mkProperLater P)
      (sealedFUpd W E' (coPset_union (nclose N) E') mkProperEmp))

\func inv_acc_strong_close {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (P : iProp S) : iProp S =>
  mkProperForall coPset (\lam E' =>
    mkProperWand (mkProperLater P)
      (mkProperFUpd W E' (coPset_union (nclose N) E') mkProperEmp))

\func inv_acc_strong_close_peval {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (P : iProp S)
  : inv_acc_strong_close_sealed W N P = inv_acc_strong_close W N P =>
  pmap (mkProperForall coPset)
    (path (\lam i => \lam E' =>
      mkProperWand (mkProperLater P)
        (sealedFUpd_peval W E' (coPset_union (nclose N) E')
          mkProperEmp @ i)))

-- sealed-form core proof
\sfunc inv_acc_strong_sealed {S : gFunctors} (W : wsatGS S)
    (E : coPset) (N : Namespace) (P : iProp S)
    (hNE : coPSubset (nclose N) E)
  : properUPred_ent (inv W N P)
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (mkProperLater P)
          (inv_acc_strong_close_sealed W N P))) =>
  \let
    | UN => nclose N
    | Z => coPset_difference UN UN
    | ER => coPset_difference E UN
    | F0 => mkProperFUpd W Z UN mkProperEmp
    | C0 => mkProperWand (mkProperLater P) F0
    | body0 => mkProperSep (mkProperLater P) C0
    | strongC : properUPred_ent C0 (inv_acc_strong_close_sealed W N P) =>
        forall_intro_ent C0
          (\lam E' => mkProperWand (mkProperLater P)
            (sealedFUpd W E' (coPset_union UN E') mkProperEmp))
          (\lam E' => wand_intro_ent C0 (mkProperLater P)
            (sealedFUpd W E' (coPset_union UN E') mkProperEmp)
            (transport
              (\lam (Z' : iProp S) => properUPred_ent
                (mkProperSep C0 (mkProperLater P)) Z')
              (Paths.inv (sealedFUpd_peval W E' (coPset_union UN E')
                mkProperEmp))
              (properUPred_ent_trans
                (mkProperSep C0 (mkProperLater P)) F0
                (mkProperFUpd W E' (coPset_union UN E') mkProperEmp)
                (wand_elim_ent (mkProperLater P) F0)
                (properUPred_ent_trans F0
                  (mkProperFUpd W (coPset_union Z E')
                    (coPset_union UN E') mkProperEmp)
                  (mkProperFUpd W E' (coPset_union UN E') mkProperEmp)
                  (properUPred_ent_trans F0
                    (mkProperFUpd W Z UN
                      (mkProperImpl
                        (mkProperPure (coPset_overlap UN E' = false))
                        mkProperEmp))
                    (mkProperFUpd W (coPset_union Z E')
                      (coPset_union UN E') mkProperEmp)
                    (fupd_intro_impl_pure W Z UN
                      (coPset_overlap UN E' = false) mkProperEmp)
                    (fupd_mask_frame_r W Z UN E' mkProperEmp
                      (coPset_diff_self_overlap_false UN E')))
                  (fupd_masks_proper W (coPset_union Z E') E'
                    (coPset_union UN E') (coPset_union UN E')
                    mkProperEmp
                    (coPset_diff_self_union_equiv UN E')
                    (coPset_equiv_refl (coPset_union UN E')))))))
    | acc0 : properUPred_ent (inv W N P)
        (mkProperFUpd W UN Z body0) =>
        inv_acc W UN N P (coPSubset_refl UN)
    | framed : properUPred_ent (mkProperFUpd W UN Z body0)
        (mkProperFUpd W E ER body0) =>
        properUPred_ent_trans
          (mkProperFUpd W UN Z body0)
          (mkProperFUpd W (coPset_union UN ER) (coPset_union Z ER) body0)
          (mkProperFUpd W E ER body0)
          (properUPred_ent_trans
            (mkProperFUpd W UN Z body0)
            (mkProperFUpd W UN Z
              (mkProperImpl (mkProperPure (coPset_overlap Z ER = false))
                body0))
            (mkProperFUpd W (coPset_union UN ER) (coPset_union Z ER)
              body0)
            (fupd_intro_impl_pure W UN Z
              (coPset_overlap Z ER = false) body0)
            (fupd_mask_frame_r W UN Z ER body0
              (coPset_subset_difference_disjoint E UN)))
          (fupd_masks_proper W (coPset_union UN ER) E
            (coPset_union Z ER) ER body0
            (coPset_equiv_sym E (coPset_union UN ER)
              (coPset_subset_union_difference E UN hNE))
            (coPset_diff_self_union_equiv UN ER))
  \in properUPred_ent_trans (inv W N P)
    (mkProperFUpd W E ER body0)
    (mkProperFUpd W E ER
      (mkProperSep (mkProperLater P) (inv_acc_strong_close_sealed W N P)))
    (properUPred_ent_trans (inv W N P)
      (mkProperFUpd W UN Z body0)
      (mkProperFUpd W E ER body0)
      acc0 framed)
    (fupd_mono W E ER body0
      (mkProperSep (mkProperLater P) (inv_acc_strong_close_sealed W N P))
      (sep_mono_r_ent (mkProperLater P) C0
        (inv_acc_strong_close_sealed W N P) strongC))

-- public statement, recovered by transporting the sealed proof
\lemma inv_acc_strong {S : gFunctors} (W : wsatGS S)
    (E : coPset) (N : Namespace) (P : iProp S)
    (hNE : coPSubset (nclose N) E)
  : properUPred_ent (inv W N P)
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (mkProperLater P)
          (mkProperForall coPset (\lam E' =>
            mkProperWand (mkProperLater P)
              (mkProperFUpd W E' (coPset_union (nclose N) E')
                mkProperEmp))))) =>
  transport
    (\lam (Z' : iProp S) => properUPred_ent (inv W N P)
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (mkProperLater P) Z')))
    (inv_acc_strong_close_peval W N P)
    (inv_acc_strong_sealed W E N P hNE)

-- =================================================================================
-- §9  inv_acc_timeless (Rocq invariants.v:196): a Timeless invariant body
--     can be taken without the later.
-- =================================================================================

\lemma inv_acc_timeless {S : gFunctors} (W : wsatGS S)
    (E : coPset) (N : Namespace) (P : iProp S)
    (hNE : coPSubset (nclose N) E) (hT : Timeless P)
  : properUPred_ent (inv W N P)
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep P
          (mkProperWand P
            (mkProperFUpd W (coPset_difference E (nclose N)) E
              mkProperEmp)))) =>
  \let
    | F => mkProperFUpd W (coPset_difference E (nclose N)) E mkProperEmp
    | C => mkProperWand (mkProperLater P) F
    | C' => mkProperWand P F
    | strengthen : properUPred_ent C C' =>
        wand_intro_ent C P F
          (properUPred_ent_trans (mkProperSep C P)
            (mkProperSep C (mkProperLater P)) F
            (sep_mono_r_ent C P (mkProperLater P) (proper_later_intro P))
            (wand_elim_ent (mkProperLater P) F))
    | body : properUPred_ent
        (mkProperSep (mkProperLater P) C)
        (mkProperExceptZero (mkProperSep P C')) =>
        properUPred_ent_trans
          (mkProperSep (mkProperLater P) C)
          (mkProperSep (mkProperExceptZero P) C)
          (mkProperExceptZero (mkProperSep P C'))
          (sep_mono_l_ent (mkProperLater P) (mkProperExceptZero P) C hT)
          (properUPred_ent_trans
            (mkProperSep (mkProperExceptZero P) C)
            (mkProperExceptZero (mkProperSep P C))
            (mkProperExceptZero (mkProperSep P C'))
            (except_zero_frame_r P C)
            (except_zero_mono (mkProperSep P C) (mkProperSep P C')
              (sep_mono_r_ent P C C' strengthen)))
  \in properUPred_ent_trans (inv W N P)
    (mkProperFUpd W E (coPset_difference E (nclose N))
      (mkProperSep (mkProperLater P) C))
    (mkProperFUpd W E (coPset_difference E (nclose N))
      (mkProperSep P C'))
    (inv_acc W E N P hNE)
    (properUPred_ent_trans
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (mkProperLater P) C))
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperExceptZero (mkProperSep P C')))
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep P C'))
      (fupd_mono W E (coPset_difference E (nclose N))
        (mkProperSep (mkProperLater P) C)
        (mkProperExceptZero (mkProperSep P C')) body)
      (fupd_except_0 W E (coPset_difference E (nclose N))
        (mkProperSep P C')))

-- Open a timeless invariant, perform a basic ghost update, and close it
-- again.  This packages the standard proof-mode `iInv`/`iMod` pattern used
-- by client protocols that do not themselves execute a physical step.
\lemma inv_timeless_bupd_update {S : gFunctors} (W : wsatGS S)
    (E : coPset) (N : Namespace) (P X Y : iProp S)
    (hNE : coPSubset (nclose N) E) (hT : Timeless P)
    (step : properUPred_ent (mkProperSep P X)
      (mkProperBUpd (mkProperSep P Y))) :
  properUPred_ent
    (mkProperSep (inv W N P) X)
    (mkProperFUpd W E E Y) =>
  \let
    | D => coPset_difference E (nclose N)
    | Close => mkProperWand P (mkProperFUpd W D E mkProperEmp)
    | OpenBody => mkProperSep (mkProperSep P Close) X
    | Ready => mkProperSep (mkProperSep P X) Close
    | Updated => mkProperSep (mkProperSep P Y) Close
    | open : properUPred_ent (mkProperSep (inv W N P) X)
        (mkProperFUpd W E D OpenBody) =>
        properUPred_ent_trans (mkProperSep (inv W N P) X)
          (mkProperSep
            (mkProperFUpd W E D (mkProperSep P Close)) X)
          (mkProperFUpd W E D OpenBody)
          (sep_mono_l_ent (inv W N P)
            (mkProperFUpd W E D (mkProperSep P Close)) X
            (inv_acc_timeless W E N P hNE hT))
          (fupd_frame_r W E D (mkProperSep P Close) X)
    | arrangeOpen : properUPred_ent OpenBody Ready =>
        properUPred_ent_trans OpenBody
          (mkProperSep P (mkProperSep Close X)) Ready
          (sep_assoc_l_ent P Close X)
          (properUPred_ent_trans
            (mkProperSep P (mkProperSep Close X))
            (mkProperSep P (mkProperSep X Close)) Ready
            (sep_mono_r_ent P (mkProperSep Close X)
              (mkProperSep X Close) (sep_comm_ent Close X))
            (sep_assoc_r_ent P X Close))
    | update : properUPred_ent Ready (mkProperBUpd Updated) =>
        properUPred_ent_trans Ready
          (mkProperSep (mkProperBUpd (mkProperSep P Y)) Close)
          (mkProperBUpd Updated)
          (sep_mono_l_ent (mkProperSep P X)
            (mkProperBUpd (mkProperSep P Y)) Close step)
          (bupd_frame_r (mkProperSep P Y) Close)
    | closeBody : properUPred_ent Updated
        (mkProperFUpd W D E Y) =>
        properUPred_ent_trans Updated
          (mkProperSep Close (mkProperSep P Y))
          (mkProperFUpd W D E Y)
          (sep_comm_ent (mkProperSep P Y) Close)
          (properUPred_ent_trans
            (mkProperSep Close (mkProperSep P Y))
            (mkProperSep (mkProperSep Close P) Y)
            (mkProperFUpd W D E Y)
            (sep_assoc_r_ent Close P Y)
            (properUPred_ent_trans
              (mkProperSep (mkProperSep Close P) Y)
              (mkProperSep (mkProperFUpd W D E mkProperEmp) Y)
              (mkProperFUpd W D E Y)
              (sep_mono_l_ent (mkProperSep Close P)
                (mkProperFUpd W D E mkProperEmp) Y
                (wand_elim_ent P (mkProperFUpd W D E mkProperEmp)))
              (properUPred_ent_trans
                (mkProperSep (mkProperFUpd W D E mkProperEmp) Y)
                (mkProperFUpd W D E (mkProperSep mkProperEmp Y))
                (mkProperFUpd W D E Y)
                (fupd_frame_r W D E mkProperEmp Y)
                (fupd_mono W D E (mkProperSep mkProperEmp Y) Y
                  (sep_elim_r_ent mkProperEmp Y)))))
    | inner : properUPred_ent OpenBody (mkProperFUpd W D E Y) =>
        properUPred_ent_trans OpenBody Ready
          (mkProperFUpd W D E Y) arrangeOpen
          (properUPred_ent_trans Ready (mkProperBUpd Updated)
            (mkProperFUpd W D E Y) update
            (properUPred_ent_trans (mkProperBUpd Updated)
              (mkProperBUpd (mkProperFUpd W D E Y))
              (mkProperFUpd W D E Y)
              (bupd_mono Updated (mkProperFUpd W D E Y) closeBody)
              (bupd_fupd_flatten W D E Y)))
  \in properUPred_ent_trans
      (mkProperSep (inv W N P) X)
      (mkProperFUpd W E D OpenBody)
      (mkProperFUpd W E E Y) open
      (properUPred_ent_trans
        (mkProperFUpd W E D OpenBody)
        (mkProperFUpd W E D (mkProperFUpd W D E Y))
        (mkProperFUpd W E E Y)
        (fupd_mono W E D OpenBody (mkProperFUpd W D E Y) inner)
        (fupd_trans W E D E Y))


-- =================================================================================
-- §10  inv_alloc_open (Rocq invariants.v:60, :123): allocation that hands
--      the new invariant back open, together with a closing continuation.
--      Uses `ownI_alloc_open` and reuses `own_inv_close_token` from the
--      semantic core.
-- =================================================================================

-- ▷P ⊢ ◇-free close continuation target
\func inv_open_close_tok {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S) : iProp S =>
  mkProperWand (mkProperLater P)
    (mkProperFUpd W (coPset_difference E (nclose N)) E mkProperEmp)

\func inv_alloc_open_exist_body {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (P : iProp S) : iProp S =>
  mkProperExist gname (\lam i =>
    mkProperSep (mkProperPure (coPIn i (nclose N)))
      (mkProperSep
        (mkProperWand (ownE W (coPset_singleton i)) (wsat W))
        (mkProperSep (ownI W i P) (ownD W (gset_singleton i)))))

\func inv_alloc_open_target {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S) : iProp S =>
  mkProperSep (wsat W)
    (mkProperSep (ownE W (coPset_difference E (nclose N)))
      (mkProperSep (own_inv W N P) (inv_open_close_tok W N E P)))

-- per-witness assembly: the freshly allocated open invariant, the wsat
-- wand, the disabled token and ownE E are reshaped into the target world.
\sfunc inv_alloc_open_assemble {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S) (i : gname)
    (hiN : coPIn i (nclose N)) (hNE : coPSubset (nclose N) E)
  : properUPred_ent
      (mkProperSep
        (mkProperSep
          (mkProperWand (ownE W (coPset_singleton i)) (wsat W))
          (mkProperSep (ownI W i P) (ownD W (gset_singleton i))))
        (ownE W E))
      (inv_alloc_open_target W N E P) =>
  \let
    | UN => nclose N
    | WW => mkProperWand (ownE W (coPset_singleton i)) (wsat W)
    | I => ownI W i P
    | D => ownD W (gset_singleton i)
    | OE => ownE W E
    | ON => ownE W UN
    | Oi => ownE W (coPset_singleton i)
    | ONi => ownE W (coPset_difference UN (coPset_singleton i))
    | OR => ownE W (coPset_difference E UN)
    | Ctok => inv_open_close_tok W N E P
    -- split ownE E and duplicate ownI
    | t1 : properUPred_ent (mkProperSep (mkProperSep WW (mkProperSep I D)) OE)
        (mkProperSep (mkProperSep WW (mkProperSep I D))
          (mkProperSep ON OR)) =>
        sep_mono_r_ent (mkProperSep WW (mkProperSep I D)) OE
          (mkProperSep ON OR)
          (ownE_split_subset W E UN hNE)
    | t2 : properUPred_ent
        (mkProperSep (mkProperSep WW (mkProperSep I D))
          (mkProperSep ON OR))
        (mkProperSep (mkProperSep WW (mkProperSep I D))
          (mkProperSep (mkProperSep Oi ONi) OR)) =>
        sep_mono_r_ent (mkProperSep WW (mkProperSep I D))
          (mkProperSep ON OR)
          (mkProperSep (mkProperSep Oi ONi) OR)
          (sep_mono_l_ent ON (mkProperSep Oi ONi) OR
            (ownE_split_subset W UN (coPset_singleton i)
              (coPset_singleton_subset i UN hiN)))
    | t3 : properUPred_ent
        (mkProperSep (mkProperSep WW (mkProperSep I D))
          (mkProperSep (mkProperSep Oi ONi) OR))
        (mkProperSep (mkProperSep WW (mkProperSep (mkProperSep I I) D))
          (mkProperSep (mkProperSep Oi ONi) OR)) =>
        sep_mono_l_ent (mkProperSep WW (mkProperSep I D))
          (mkProperSep WW (mkProperSep (mkProperSep I I) D))
          (mkProperSep (mkProperSep Oi ONi) OR)
          (sep_mono_r_ent WW (mkProperSep I D)
            (mkProperSep (mkProperSep I I) D)
            (sep_mono_l_ent I (mkProperSep I I) D (ownI_dup W i P)))
    -- flatten to right-nested WW,I,I,D,Oi,ONi,OR
    | a1 : properUPred_ent
        (mkProperSep (mkProperSep WW (mkProperSep (mkProperSep I I) D))
          (mkProperSep (mkProperSep Oi ONi) OR))
        (mkProperSep WW (mkProperSep (mkProperSep (mkProperSep I I) D)
          (mkProperSep (mkProperSep Oi ONi) OR))) =>
        sep_assoc_l_ent WW (mkProperSep (mkProperSep I I) D)
          (mkProperSep (mkProperSep Oi ONi) OR)
    | a2 : properUPred_ent
        (mkProperSep WW (mkProperSep (mkProperSep (mkProperSep I I) D)
          (mkProperSep (mkProperSep Oi ONi) OR)))
        (mkProperSep WW (mkProperSep (mkProperSep I I)
          (mkProperSep D (mkProperSep (mkProperSep Oi ONi) OR)))) =>
        sep_mono_r_ent WW
          (mkProperSep (mkProperSep (mkProperSep I I) D)
            (mkProperSep (mkProperSep Oi ONi) OR))
          (mkProperSep (mkProperSep I I)
            (mkProperSep D (mkProperSep (mkProperSep Oi ONi) OR)))
          (sep_assoc_l_ent (mkProperSep I I) D
            (mkProperSep (mkProperSep Oi ONi) OR))
    | a3 : properUPred_ent
        (mkProperSep WW (mkProperSep (mkProperSep I I)
          (mkProperSep D (mkProperSep (mkProperSep Oi ONi) OR))))
        (mkProperSep WW (mkProperSep I (mkProperSep I
          (mkProperSep D (mkProperSep (mkProperSep Oi ONi) OR))))) =>
        sep_mono_r_ent WW
          (mkProperSep (mkProperSep I I)
            (mkProperSep D (mkProperSep (mkProperSep Oi ONi) OR)))
          (mkProperSep I (mkProperSep I
            (mkProperSep D (mkProperSep (mkProperSep Oi ONi) OR))))
          (sep_assoc_l_ent I I
            (mkProperSep D (mkProperSep (mkProperSep Oi ONi) OR)))
    | a4 : properUPred_ent
        (mkProperSep WW (mkProperSep I (mkProperSep I
          (mkProperSep D (mkProperSep (mkProperSep Oi ONi) OR)))))
        (mkProperSep WW (mkProperSep I (mkProperSep I
          (mkProperSep D (mkProperSep Oi (mkProperSep ONi OR)))))) =>
        sep_mono_r_ent WW _ _
          (sep_mono_r_ent I _ _
            (sep_mono_r_ent I _ _
              (sep_mono_r_ent D
                (mkProperSep (mkProperSep Oi ONi) OR)
                (mkProperSep Oi (mkProperSep ONi OR))
                (sep_assoc_l_ent Oi ONi OR))))
    -- bring Oi to the front (next to WW)
    | b1 : properUPred_ent
        (mkProperSep WW (mkProperSep I (mkProperSep I
          (mkProperSep D (mkProperSep Oi (mkProperSep ONi OR))))))
        (mkProperSep WW (mkProperSep I (mkProperSep I
          (mkProperSep Oi (mkProperSep D (mkProperSep ONi OR)))))) =>
        sep_mono_r_ent WW _ _
          (sep_mono_r_ent I _ _
            (sep_mono_r_ent I _ _
              (sep_swap_ent D Oi (mkProperSep ONi OR))))
    | b2 : properUPred_ent
        (mkProperSep WW (mkProperSep I (mkProperSep I
          (mkProperSep Oi (mkProperSep D (mkProperSep ONi OR))))))
        (mkProperSep WW (mkProperSep I (mkProperSep Oi
          (mkProperSep I (mkProperSep D (mkProperSep ONi OR)))))) =>
        sep_mono_r_ent WW _ _
          (sep_mono_r_ent I _ _
            (sep_swap_ent I Oi (mkProperSep D (mkProperSep ONi OR))))
    | b3 : properUPred_ent
        (mkProperSep WW (mkProperSep I (mkProperSep Oi
          (mkProperSep I (mkProperSep D (mkProperSep ONi OR))))))
        (mkProperSep WW (mkProperSep Oi (mkProperSep I
          (mkProperSep I (mkProperSep D (mkProperSep ONi OR)))))) =>
        sep_mono_r_ent WW _ _
          (sep_swap_ent I Oi
            (mkProperSep I (mkProperSep D (mkProperSep ONi OR))))
    | b4 : properUPred_ent
        (mkProperSep WW (mkProperSep Oi (mkProperSep I
          (mkProperSep I (mkProperSep D (mkProperSep ONi OR))))))
        (mkProperSep (mkProperSep WW Oi) (mkProperSep I
          (mkProperSep I (mkProperSep D (mkProperSep ONi OR))))) =>
        sep_assoc_r_ent WW Oi
          (mkProperSep I (mkProperSep I (mkProperSep D (mkProperSep ONi OR))))
    -- bring OR to the front of the right group
    | b5 : properUPred_ent
        (mkProperSep (mkProperSep WW Oi) (mkProperSep I
          (mkProperSep I (mkProperSep D (mkProperSep ONi OR)))))
        (mkProperSep (mkProperSep WW Oi) (mkProperSep I
          (mkProperSep I (mkProperSep D (mkProperSep OR ONi))))) =>
        sep_mono_r_ent (mkProperSep WW Oi) _ _
          (sep_mono_r_ent I _ _
            (sep_mono_r_ent I _ _
              (sep_mono_r_ent D
                (mkProperSep ONi OR) (mkProperSep OR ONi)
                (sep_comm_ent ONi OR))))
    | b6 : properUPred_ent
        (mkProperSep (mkProperSep WW Oi) (mkProperSep I
          (mkProperSep I (mkProperSep D (mkProperSep OR ONi)))))
        (mkProperSep (mkProperSep WW Oi) (mkProperSep I
          (mkProperSep I (mkProperSep OR (mkProperSep D ONi))))) =>
        sep_mono_r_ent (mkProperSep WW Oi) _ _
          (sep_mono_r_ent I _ _
            (sep_mono_r_ent I _ _
              (sep_swap_ent D OR ONi)))
    | b7 : properUPred_ent
        (mkProperSep (mkProperSep WW Oi) (mkProperSep I
          (mkProperSep I (mkProperSep OR (mkProperSep D ONi)))))
        (mkProperSep (mkProperSep WW Oi) (mkProperSep I
          (mkProperSep OR (mkProperSep I (mkProperSep D ONi))))) =>
        sep_mono_r_ent (mkProperSep WW Oi) _ _
          (sep_mono_r_ent I _ _
            (sep_swap_ent I OR (mkProperSep D ONi)))
    | b8 : properUPred_ent
        (mkProperSep (mkProperSep WW Oi) (mkProperSep I
          (mkProperSep OR (mkProperSep I (mkProperSep D ONi)))))
        (mkProperSep (mkProperSep WW Oi) (mkProperSep OR
          (mkProperSep I (mkProperSep I (mkProperSep D ONi))))) =>
        sep_mono_r_ent (mkProperSep WW Oi) _ _
          (sep_swap_ent I OR
            (mkProperSep I (mkProperSep D ONi)))
    -- final conversions
    | m1 : properUPred_ent
        (mkProperSep (mkProperSep WW Oi) (mkProperSep OR
          (mkProperSep I (mkProperSep I (mkProperSep D ONi)))))
        (mkProperSep (wsat W) (mkProperSep OR
          (mkProperSep I (mkProperSep I (mkProperSep D ONi))))) =>
        sep_mono_l_ent (mkProperSep WW Oi) (wsat W)
          (mkProperSep OR
            (mkProperSep I (mkProperSep I (mkProperSep D ONi))))
          (wand_elim_ent Oi (wsat W))
    | m2 : properUPred_ent
        (mkProperSep (wsat W) (mkProperSep OR
          (mkProperSep I (mkProperSep I (mkProperSep D ONi)))))
        (mkProperSep (wsat W) (mkProperSep OR
          (mkProperSep (own_inv W N P) (mkProperSep I (mkProperSep D ONi))))) =>
        sep_mono_r_ent (wsat W) _ _
          (sep_mono_r_ent OR _ _
            (sep_mono_l_ent I (own_inv W N P)
              (mkProperSep I (mkProperSep D ONi))
              (properUPred_ent_trans I
                (mkProperSep (mkProperPure (coPIn i UN)) I)
                (own_inv W N P)
                (pure_intro_sep_ent (coPIn i UN) hiN I)
                (own_inv_intro W N P i))))
    | m3 : properUPred_ent
        (mkProperSep (wsat W) (mkProperSep OR
          (mkProperSep (own_inv W N P)
            (mkProperSep I (mkProperSep D ONi)))))
        (inv_alloc_open_target W N E P) =>
        sep_mono_r_ent (wsat W) _ _
          (sep_mono_r_ent OR _ _
            (sep_mono_r_ent (own_inv W N P)
              (mkProperSep I (mkProperSep D ONi)) Ctok
              (own_inv_close_token W N E P i hiN hNE)))
  \in \lam n x hv h =>
    m3 n x hv (m2 n x hv (m1 n x hv (b8 n x hv (b7 n x hv (b6 n x hv
      (b5 n x hv (b4 n x hv (b3 n x hv (b2 n x hv (b1 n x hv (a4 n x hv
        (a3 n x hv (a2 n x hv (a1 n x hv (t3 n x hv (t2 n x hv
          (t1 n x hv h)))))))))))))))))

-- eliminate the existential and the pure witness membership
\sfunc inv_alloc_open_elim {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S)
    (hNE : coPSubset (nclose N) E)
  : properUPred_ent
      (mkProperSep (inv_alloc_open_exist_body W N P) (ownE W E))
      (inv_alloc_open_target W N E P) =>
  sep_exist_l_elim
    (\lam i =>
      mkProperSep (mkProperPure (coPIn i (nclose N)))
        (mkProperSep
          (mkProperWand (ownE W (coPset_singleton i)) (wsat W))
          (mkProperSep (ownI W i P) (ownD W (gset_singleton i)))))
    (ownE W E) (inv_alloc_open_target W N E P)
    (\lam i n x hv h => \case h \with {
      | inP (a, b, dab, hXi, hOE) => \case hXi \with {
        | inP (a1, a2, da12, hpure, hrest) =>
          inv_alloc_open_assemble W N E P i hpure hNE n x hv
            (inP (a, b, dab,
              sep_elim_r_ent (mkProperPure (coPIn i (nclose N)))
                (mkProperSep
                  (mkProperWand (ownE W (coPset_singleton i)) (wsat W))
                  (mkProperSep (ownI W i P) (ownD W (gset_singleton i))))
                n a (validN_sub_l {iResUR S} n x a b hv dab)
                (inP (a1, a2, da12, hpure, hrest)),
              hOE))
      }
    })

\sfunc own_inv_alloc_open {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S)
    (hNE : coPSubset (nclose N) E)
  : properUPred_ent mkProperEmp
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (own_inv W N P) (inv_open_close_tok W N E P))) =>
  \lam n x hv _ m m_le_n frame hv_op hworld =>
    \let
      | xf => (iResUR S).op x frame
      | hworld' : (mkProperSep (wsat W) (ownE W E)).upred_holds m xf =>
          (mkProperSep (wsat W) (ownE W E)).upred_mono m m frame xf hworld
            (inP (x, cmra_comm_dist {iResUR S} m x frame)) <=-refl
      | step1 : properUPred_ent
          (mkProperSep (wsat W) (ownE W E))
          (mkProperSep (mkProperBUpd (inv_alloc_open_exist_body W N P))
            (ownE W E)) =>
          sep_mono_l_ent (wsat W)
            (mkProperBUpd (inv_alloc_open_exist_body W N P)) (ownE W E)
            (ownI_alloc_open W (\lam i => coPIn i (nclose N)) P
              (fresh_inv_oracle N))
      | step2 : properUPred_ent
          (mkProperSep (mkProperBUpd (inv_alloc_open_exist_body W N P))
            (ownE W E))
          (mkProperBUpd
            (mkProperSep (inv_alloc_open_exist_body W N P) (ownE W E))) =>
          bupd_frame_r (inv_alloc_open_exist_body W N P) (ownE W E)
      | step3 : properUPred_ent
          (mkProperBUpd
            (mkProperSep (inv_alloc_open_exist_body W N P) (ownE W E)))
          (mkProperBUpd
            (mkProperExceptZero (inv_alloc_open_target W N E P))) =>
          bupd_mono
            (mkProperSep (inv_alloc_open_exist_body W N P) (ownE W E))
            (mkProperExceptZero (inv_alloc_open_target W N E P))
            (properUPred_ent_trans
              (mkProperSep (inv_alloc_open_exist_body W N P) (ownE W E))
              (inv_alloc_open_target W N E P)
              (mkProperExceptZero (inv_alloc_open_target W N E P))
              (inv_alloc_open_elim W N E P hNE)
              (or_intro_r_ent (mkProperLater (mkProperPure Empty))
                (inv_alloc_open_target W N E P)))
    \in step3 m xf hv_op (step2 m xf hv_op (step1 m xf hv_op hworld'))

\lemma inv_alloc_open {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S)
    (hNE : coPSubset (nclose N) E)
  : properUPred_ent mkProperEmp
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (inv W N P) (inv_open_close_tok W N E P))) =>
  properUPred_ent_trans mkProperEmp
    (mkProperFUpd W E (coPset_difference E (nclose N))
      (mkProperSep (own_inv W N P) (inv_open_close_tok W N E P)))
    (mkProperFUpd W E (coPset_difference E (nclose N))
      (mkProperSep (inv W N P) (inv_open_close_tok W N E P)))
    (own_inv_alloc_open W N E P hNE)
    (fupd_mono W E (coPset_difference E (nclose N))
      (mkProperSep (own_inv W N P) (inv_open_close_tok W N E P))
      (mkProperSep (inv W N P) (inv_open_close_tok W N E P))
      (sep_mono_l_ent (own_inv W N P) (inv W N P)
        (inv_open_close_tok W N E P)
        (own_inv_to_inv W N P)))


-- =================================================================================
-- §11  inv_combine and inv_combine_dup_l (Rocq invariants.v:136, :149).
--
-- All close continuations that would nest a fancy update inside another
-- fancy update's body are kept behind `sealedFUpd` during composition and
-- unsealed by a single transport at the end of each per-mask proof — the
-- same discipline as fupd_mask_subseteq_sealed and inv_acc_strong_sealed;
-- without it Arend's conversion checker diverges on the recursive iProp
-- wand towers.
-- =================================================================================

-- The combined close continuation: from the (sealed) mask-restore token and
-- the two openers' close wands, rebuild ▷(P∗Q) -∗ fupd DN E emp (sealed).
-- Generic in the four masks.
\sfunc fupd_close_chain {S : gFunctors} (W : wsatGS S)
    (E D1 D12 DN : coPset) (P Q : iProp S)
  : properUPred_ent
      (mkProperSep (mkProperFUpd W DN D12 mkProperEmp)
        (mkProperSep
          (mkProperWand (mkProperLater P) (mkProperFUpd W D1 E mkProperEmp))
          (mkProperWand (mkProperLater Q) (mkProperFUpd W D12 D1 mkProperEmp))))
      (mkProperWand (mkProperLater (mkProperSep P Q))
        (sealedFUpd W DN E mkProperEmp)) =>
  \let
    | K' => mkProperFUpd W DN D12 mkProperEmp
    | CP => mkProperWand (mkProperLater P) (mkProperFUpd W D1 E mkProperEmp)
    | CQ => mkProperWand (mkProperLater Q) (mkProperFUpd W D12 D1 mkProperEmp)
    | LP => mkProperLater P
    | LQ => mkProperLater Q
    | LPQ => mkProperLater (mkProperSep P Q)
    | R => mkProperSep CQ (mkProperSep LQ (mkProperSep CP LP))
    | e1 : properUPred_ent
        (mkProperSep (mkProperSep K' (mkProperSep CP CQ)) LPQ)
        (mkProperSep (mkProperSep K' (mkProperSep CP CQ))
          (mkProperSep LP LQ)) =>
        sep_mono_r_ent (mkProperSep K' (mkProperSep CP CQ)) LPQ
          (mkProperSep LP LQ)
          (proper_later_sep_1 P Q)
    | g1 : properUPred_ent
        (mkProperSep (mkProperSep K' (mkProperSep CP CQ))
          (mkProperSep LP LQ))
        (mkProperSep K' (mkProperSep (mkProperSep CP CQ)
          (mkProperSep LP LQ))) =>
        sep_assoc_l_ent K' (mkProperSep CP CQ) (mkProperSep LP LQ)
    | h1 : properUPred_ent
        (mkProperSep (mkProperSep CP CQ) (mkProperSep LP LQ))
        (mkProperSep CP (mkProperSep CQ (mkProperSep LP LQ))) =>
        sep_assoc_l_ent CP CQ (mkProperSep LP LQ)
    | h2 : properUPred_ent
        (mkProperSep CP (mkProperSep CQ (mkProperSep LP LQ)))
        (mkProperSep CP (mkProperSep CQ (mkProperSep LQ LP))) =>
        sep_mono_r_ent CP _ _
          (sep_mono_r_ent CQ (mkProperSep LP LQ) (mkProperSep LQ LP)
            (sep_comm_ent LP LQ))
    | h3 : properUPred_ent
        (mkProperSep CP (mkProperSep CQ (mkProperSep LQ LP)))
        (mkProperSep CQ (mkProperSep CP (mkProperSep LQ LP))) =>
        sep_swap_ent CP CQ (mkProperSep LQ LP)
    | h4 : properUPred_ent
        (mkProperSep CQ (mkProperSep CP (mkProperSep LQ LP)))
        (mkProperSep CQ (mkProperSep LQ (mkProperSep CP LP))) =>
        sep_mono_r_ent CQ _ _
          (sep_swap_ent CP LQ LP)
    | g2 : properUPred_ent
        (mkProperSep K' (mkProperSep (mkProperSep CP CQ)
          (mkProperSep LP LQ)))
        (mkProperSep K' R) =>
        sep_mono_r_ent K'
          (mkProperSep (mkProperSep CP CQ) (mkProperSep LP LQ)) R
          (\lam n x hv h =>
            h4 n x hv (h3 n x hv (h2 n x hv (h1 n x hv h))))
    | inner1 : properUPred_ent (mkProperSep mkProperEmp R)
        (mkProperFUpd W D12 D1
          (mkProperSep mkProperEmp (mkProperSep CP LP))) =>
        \lam n x hv h =>
          \let
            | i1 => sep_elim_r_ent mkProperEmp R n x hv h
            | i2 => sep_assoc_r_ent CQ LQ (mkProperSep CP LP) n x hv i1
            | i3 => sep_mono_l_ent (mkProperSep CQ LQ)
                (mkProperFUpd W D12 D1 mkProperEmp)
                (mkProperSep CP LP)
                (wand_elim_ent LQ (mkProperFUpd W D12 D1 mkProperEmp))
                n x hv i2
          \in fupd_frame_r W D12 D1 mkProperEmp (mkProperSep CP LP)
            n x hv i3
    | inner2 : properUPred_ent
        (mkProperSep mkProperEmp (mkProperSep CP LP))
        (mkProperFUpd W D1 E mkProperEmp) =>
        properUPred_ent_trans
          (mkProperSep mkProperEmp (mkProperSep CP LP))
          (mkProperSep CP LP)
          (mkProperFUpd W D1 E mkProperEmp)
          (sep_elim_r_ent mkProperEmp (mkProperSep CP LP))
          (wand_elim_ent LP (mkProperFUpd W D1 E mkProperEmp))
    | fchain : properUPred_ent (mkProperSep K' R)
        (mkProperFUpd W DN E mkProperEmp) =>
        \lam n x hv h =>
          \let
            | w1 => fupd_frame_r W DN D12 mkProperEmp R n x hv h
            | w2 => fupd_mono W DN D12
                (mkProperSep mkProperEmp R)
                (mkProperFUpd W D12 D1
                  (mkProperSep mkProperEmp (mkProperSep CP LP)))
                inner1 n x hv w1
            | w3 => fupd_trans W DN D12 D1
                (mkProperSep mkProperEmp (mkProperSep CP LP))
                n x hv w2
            | w4 => fupd_mono W DN D1
                (mkProperSep mkProperEmp (mkProperSep CP LP))
                (mkProperFUpd W D1 E mkProperEmp)
                inner2 n x hv w3
          \in fupd_trans W DN D1 E mkProperEmp n x hv w4
    | composite : properUPred_ent
        (mkProperSep (mkProperSep K' (mkProperSep CP CQ)) LPQ)
        (mkProperFUpd W DN E mkProperEmp) =>
        \lam n x hv h =>
          fchain n x hv (g2 n x hv (g1 n x hv (e1 n x hv h)))
  \in wand_intro_ent (mkProperSep K' (mkProperSep CP CQ)) LPQ
    (sealedFUpd W DN E mkProperEmp)
    (transport
      (\lam (Z : iProp S) => properUPred_ent
        (mkProperSep (mkProperSep K' (mkProperSep CP CQ)) LPQ) Z)
      (Paths.inv (sealedFUpd_peval W DN E mkProperEmp))
      composite)

-- (▷P ∗ CP) ∗ (▷Q ∗ CQ) ⊢ fupd D12 DN (▷(P∗Q) ∗ sealed-close), the

-- mask-restore step of inv_combine.
\sfunc inv_combine_at_inner_mask {S : gFunctors} (W : wsatGS S)
    (E D1 D12 DN : coPset) (P Q : iProp S)
    (hDN12 : coPSubset DN D12)
  : properUPred_ent
      (mkProperSep
        (mkProperSep (mkProperLater P)
          (mkProperWand (mkProperLater P) (mkProperFUpd W D1 E mkProperEmp)))
        (mkProperSep (mkProperLater Q)
          (mkProperWand (mkProperLater Q) (mkProperFUpd W D12 D1 mkProperEmp))))
      (mkProperFUpd W D12 DN
        (mkProperSep (mkProperLater (mkProperSep P Q))
          (mkProperWand (mkProperLater (mkProperSep P Q))
            (sealedFUpd W DN E mkProperEmp)))) =>
  \let
    | K' => mkProperFUpd W DN D12 mkProperEmp
    | Ks => sealedFUpd W DN D12 mkProperEmp
    | CP => mkProperWand (mkProperLater P) (mkProperFUpd W D1 E mkProperEmp)
    | CQ => mkProperWand (mkProperLater Q) (mkProperFUpd W D12 D1 mkProperEmp)
    | LP => mkProperLater P
    | LQ => mkProperLater Q
    | LPQ => mkProperLater (mkProperSep P Q)
    | CTs => mkProperWand LPQ (sealedFUpd W DN E mkProperEmp)
    | Ts => mkProperSep LPQ CTs
    | bodies => mkProperSep (mkProperSep LP CP) (mkProperSep LQ CQ)
    | unseal_K : properUPred_ent Ks K' =>
        transport (\lam (Z : iProp S) => properUPred_ent Z K')
          (Paths.inv (sealedFUpd_peval W DN D12 mkProperEmp))
          (properUPred_ent_refl K')
    | p0 : properUPred_ent bodies
        (mkProperSep LPQ (mkProperSep CP CQ)) =>
        \lam n x hv h =>
          \let
            | p1 => sep_assoc_l_ent LP CP (mkProperSep LQ CQ) n x hv h
            | p2 => sep_mono_r_ent LP
                (mkProperSep CP (mkProperSep LQ CQ))
                (mkProperSep LQ (mkProperSep CP CQ))
                (sep_swap_ent CP LQ CQ) n x hv p1
            | p3 => sep_assoc_r_ent LP LQ (mkProperSep CP CQ) n x hv p2
          \in sep_mono_l_ent (mkProperSep LP LQ) LPQ
            (mkProperSep CP CQ)
            (proper_later_sep_2 P Q) n x hv p3
    | final_asm : properUPred_ent
        (mkProperSep Ks bodies) Ts =>
        \lam n x hv h =>
          \let
            | h0 => sep_mono_l_ent Ks K' bodies unseal_K n x hv h
            | q0 => sep_mono_r_ent K' bodies
                (mkProperSep LPQ (mkProperSep CP CQ)) p0 n x hv h0
            | q1 => sep_swap_ent K' LPQ (mkProperSep CP CQ) n x hv q0
          \in sep_mono_r_ent LPQ
            (mkProperSep K' (mkProperSep CP CQ)) CTs
            (fupd_close_chain W E D1 D12 DN P Q) n x hv q1
  \in \lam n x hv h =>
    \let
      | k1 => attach_valid_r_ent bodies
          (mkProperFUpd W D12 DN Ks)
          (fupd_mask_subseteq_sealed W D12 DN hDN12) n x hv h
      | k2 => sep_comm_ent bodies (mkProperFUpd W D12 DN Ks) n x hv k1
      | k3 => fupd_frame_r W D12 DN Ks bodies n x hv k2
    \in fupd_mono W D12 DN (mkProperSep Ks bodies) Ts final_asm
      n x hv k3


-- inv_inner N1 P ∗ inv_inner N2 Q ⊢ inv_inner N (P ∗ Q)
\sfunc inv_combine_inner {S : gFunctors} (W : wsatGS S)
    (N1 N2 N : Namespace) (P Q : iProp S)
    (hdisj : ndisjoint N1 N2)
    (hsub : coPSubset (coPset_union (nclose N1) (nclose N2)) (nclose N))
  : properUPred_ent
      (mkProperSep (inv_inner W N1 P) (inv_inner W N2 Q))
      (inv_inner W N (mkProperSep P Q)) =>
  forall_intro_ent
    (mkProperSep (inv_inner W N1 P) (inv_inner W N2 Q))
    (\lam E => mkProperImpl (mkProperPure (coPSubset (nclose N) E))
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (mkProperLater (mkProperSep P Q))
          (mkProperWand (mkProperLater (mkProperSep P Q))
            (mkProperFUpd W (coPset_difference E (nclose N)) E
              mkProperEmp)))))
    (\lam E => impl_pure_intro_ent (coPSubset (nclose N) E)
      (mkProperSep (inv_inner W N1 P) (inv_inner W N2 Q))
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (mkProperLater (mkProperSep P Q))
          (mkProperWand (mkProperLater (mkProperSep P Q))
            (mkProperFUpd W (coPset_difference E (nclose N)) E
              mkProperEmp))))
      (\lam hNE =>
        \let
          | U1 => nclose N1
          | U2 => nclose N2
          | UN => nclose N
          | D1 => coPset_difference E U1
          | D12 => coPset_difference D1 U2
          | DN => coPset_difference E UN
          | hU1N : coPSubset U1 UN => coPSubset_union_l U1 U2 UN hsub
          | hU2N : coPSubset U2 UN => coPSubset_union_r U1 U2 UN hsub
          | hU1E : coPSubset U1 E => coPSubset_trans U1 UN E hU1N hNE
          | hU2E : coPSubset U2 E => coPSubset_trans U2 UN E hU2N hNE
          | hU2D1 : coPSubset U2 D1 =>
              coPSubset_difference_of_disjoint U2 U1 E hU2E hdisj
          | hDN12 : coPSubset DN D12 =>
              coPset_diff_mono_subsets E UN U1 U2 hU1N hU2N
          | CP => mkProperWand (mkProperLater P)
              (mkProperFUpd W D1 E mkProperEmp)
          | CQ => mkProperWand (mkProperLater Q)
              (mkProperFUpd W D12 D1 mkProperEmp)
          | bodyP => mkProperSep (mkProperLater P) CP
          | bodyQ => mkProperSep (mkProperLater Q) CQ
          | LPQ => mkProperLater (mkProperSep P Q)
          | Ts => mkProperSep LPQ
              (mkProperWand LPQ (sealedFUpd W DN E mkProperEmp))
          | openP : properUPred_ent (inv_inner W N1 P)
              (mkProperFUpd W E D1 bodyP) =>
              properUPred_ent_trans (inv_inner W N1 P)
                (mkProperImpl (mkProperPure (coPSubset U1 E))
                  (mkProperFUpd W E D1 bodyP))
                (mkProperFUpd W E D1 bodyP)
                (forall_elim_ent
                  (\lam E' => mkProperImpl
                    (mkProperPure (coPSubset (nclose N1) E'))
                    (mkProperFUpd W E' (coPset_difference E' (nclose N1))
                      (mkProperSep (mkProperLater P)
                        (mkProperWand (mkProperLater P)
                          (mkProperFUpd W
                            (coPset_difference E' (nclose N1)) E'
                            mkProperEmp)))))
                  E)
                (impl_pure_elim_ent (coPSubset U1 E)
                  (mkProperFUpd W E D1 bodyP) hU1E)
          | openQ : properUPred_ent (inv_inner W N2 Q)
              (mkProperFUpd W D1 D12 bodyQ) =>
              properUPred_ent_trans (inv_inner W N2 Q)
                (mkProperImpl (mkProperPure (coPSubset U2 D1))
                  (mkProperFUpd W D1 D12 bodyQ))
                (mkProperFUpd W D1 D12 bodyQ)
                (forall_elim_ent
                  (\lam E' => mkProperImpl
                    (mkProperPure (coPSubset (nclose N2) E'))
                    (mkProperFUpd W E' (coPset_difference E' (nclose N2))
                      (mkProperSep (mkProperLater Q)
                        (mkProperWand (mkProperLater Q)
                          (mkProperFUpd W
                            (coPset_difference E' (nclose N2)) E'
                            mkProperEmp)))))
                  D1)
                (impl_pure_elim_ent (coPSubset U2 D1)
                  (mkProperFUpd W D1 D12 bodyQ) hU2D1)
        \in \lam n x hv h =>
          \let
            | c1 => sep_mono_l_ent (inv_inner W N1 P)
                (mkProperFUpd W E D1 bodyP)
                (inv_inner W N2 Q) openP n x hv h
            | c2 => fupd_frame_r W E D1 bodyP (inv_inner W N2 Q)
                n x hv c1
            | c3 => fupd_mono W E D1
                (mkProperSep bodyP (inv_inner W N2 Q))
                (mkProperSep bodyP (mkProperFUpd W D1 D12 bodyQ))
                (sep_mono_r_ent bodyP (inv_inner W N2 Q)
                  (mkProperFUpd W D1 D12 bodyQ) openQ)
                n x hv c2
            | c4 => fupd_mono W E D1
                (mkProperSep bodyP (mkProperFUpd W D1 D12 bodyQ))
                (mkProperFUpd W D1 D12 (mkProperSep bodyP bodyQ))
                (fupd_frame_l W D1 D12 bodyP bodyQ)
                n x hv c3
            | c5 => fupd_trans W E D1 D12 (mkProperSep bodyP bodyQ)
                n x hv c4
            | c6 => fupd_mono W E D12
                (mkProperSep bodyP bodyQ)
                (mkProperFUpd W D12 DN Ts)
                (inv_combine_at_inner_mask W E D1 D12 DN P Q hDN12)
                n x hv c5
            | c7 => fupd_trans W E D12 DN Ts n x hv c6
          \in transport
            (\lam (Z : iProp S) =>
              (mkProperFUpd W E DN
                (mkProperSep LPQ (mkProperWand LPQ Z))).upred_holds n x)
            (sealedFUpd_peval W DN E mkProperEmp)
            c7))

\lemma inv_combine {S : gFunctors} (W : wsatGS S)
    (N1 N2 N : Namespace) (P Q : iProp S)
    (hdisj : ndisjoint N1 N2)
    (hsub : coPSubset (coPset_union (nclose N1) (nclose N2)) (nclose N))
  : properUPred_ent
      (mkProperSep (inv W N1 P) (inv W N2 Q))
      (inv W N (mkProperSep P Q)) =>
  \let
    | s1 : properUPred_ent
        (mkProperSep (inv W N1 P) (inv W N2 Q))
        (mkProperSep (inv_body W N1 P) (inv_body W N2 Q)) =>
        properUPred_ent_trans
          (mkProperSep (inv W N1 P) (inv W N2 Q))
          (mkProperSep (inv_body W N1 P) (inv W N2 Q))
          (mkProperSep (inv_body W N1 P) (inv_body W N2 Q))
          (sep_mono_l_ent (inv W N1 P) (inv_body W N1 P) (inv W N2 Q)
            (inv_unfold_ent W N1 P))
          (sep_mono_r_ent (inv_body W N1 P) (inv W N2 Q)
            (inv_body W N2 Q)
            (inv_unfold_ent W N2 Q))
    | s2 : properUPred_ent
        (mkProperSep (inv_body W N1 P) (inv_body W N2 Q))
        (mkProperPersistently
          (mkProperSep (inv_inner W N1 P) (inv_inner W N2 Q))) =>
        persistently_sep_2_ent (inv_inner W N1 P) (inv_inner W N2 Q)
    | s3 : properUPred_ent
        (mkProperPersistently
          (mkProperSep (inv_inner W N1 P) (inv_inner W N2 Q)))
        (inv_body W N (mkProperSep P Q)) =>
        (BIuPredPersistentlyMixin (iResUR S)).persistently_mono
          (mkProperSep (inv_inner W N1 P) (inv_inner W N2 Q))
          (inv_inner W N (mkProperSep P Q))
          (inv_combine_inner W N1 N2 N P Q hdisj hsub)
  \in \lam n x hv h =>
    inv_fold_ent W N (mkProperSep P Q) n x hv
      (s3 n x hv (s2 n x hv (s1 n x hv h)))

-- =================================================================================
-- inv_combine_dup_l: same namespace on both sides, P duplicable.
-- =================================================================================

\func dup_wand {S : gFunctors} (P : iProp S) : iProp S =>
  mkProperWand P (mkProperSep P P)

-- dupW ∗ (inv_inner N P ∗ inv_inner N Q) ⊢ inv_inner N (P ∗ Q)
\sfunc inv_combine_dup_inner {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (P Q : iProp S)
  : properUPred_ent
      (mkProperSep (dup_wand P)
        (mkProperSep (inv_inner W N P) (inv_inner W N Q)))
      (inv_inner W N (mkProperSep P Q)) =>
  forall_intro_ent
    (mkProperSep (dup_wand P)
      (mkProperSep (inv_inner W N P) (inv_inner W N Q)))
    (\lam E => mkProperImpl (mkProperPure (coPSubset (nclose N) E))
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (mkProperLater (mkProperSep P Q))
          (mkProperWand (mkProperLater (mkProperSep P Q))
            (mkProperFUpd W (coPset_difference E (nclose N)) E
              mkProperEmp)))))
    (\lam E => impl_pure_intro_ent (coPSubset (nclose N) E)
      (mkProperSep (dup_wand P)
        (mkProperSep (inv_inner W N P) (inv_inner W N Q)))
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (mkProperLater (mkProperSep P Q))
          (mkProperWand (mkProperLater (mkProperSep P Q))
            (mkProperFUpd W (coPset_difference E (nclose N)) E
              mkProperEmp))))
      (\lam hNE =>
        \let
          | UN => nclose N
          | DN => coPset_difference E UN
          | F0 => mkProperFUpd W DN E mkProperEmp
          | CPN => mkProperWand (mkProperLater P) F0
          | CQN => mkProperWand (mkProperLater Q) F0
          | bodyP => mkProperSep (mkProperLater P) CPN
          | bodyQ => mkProperSep (mkProperLater Q) CQN
          | LP => mkProperLater P
          | LQ => mkProperLater Q
          | LPQ => mkProperLater (mkProperSep P Q)
          | CTs => mkProperWand LPQ (sealedFUpd W DN E mkProperEmp)
          | Ts => mkProperSep LPQ CTs
          | iP => inv_inner W N P
          | iQ => inv_inner W N Q
          | dW => dup_wand P
          | opener => \lam (R : iProp S) (N' : Namespace)
              (E' : coPset) => mkProperImpl
                (mkProperPure (coPSubset (nclose N') E'))
                (mkProperFUpd W E' (coPset_difference E' (nclose N'))
                  (mkProperSep (mkProperLater R)
                    (mkProperWand (mkProperLater R)
                      (mkProperFUpd W
                        (coPset_difference E' (nclose N')) E'
                        mkProperEmp))))
          | openP : properUPred_ent iP (mkProperFUpd W E DN bodyP) =>
              properUPred_ent_trans iP
                (opener P N E)
                (mkProperFUpd W E DN bodyP)
                (forall_elim_ent (opener P N) E)
                (impl_pure_elim_ent (coPSubset UN E)
                  (mkProperFUpd W E DN bodyP) hNE)
          | openQ : properUPred_ent iQ (mkProperFUpd W E DN bodyQ) =>
              properUPred_ent_trans iQ
                (opener Q N E)
                (mkProperFUpd W E DN bodyQ)
                (forall_elim_ent (opener Q N) E)
                (impl_pure_elim_ent (coPSubset UN E)
                  (mkProperFUpd W E DN bodyQ) hNE)
          -- step A: duplicate ▷P and close the P-opening immediately
          | stepA : properUPred_ent
              (mkProperSep bodyP (mkProperSep dW iQ))
              (mkProperFUpd W DN E (mkProperSep LP iQ)) =>
              \lam n x hv h =>
                \let
                  | q1 => sep_assoc_l_ent LP CPN (mkProperSep dW iQ)
                      n x hv h
                  | q2 => sep_mono_r_ent LP
                      (mkProperSep CPN (mkProperSep dW iQ))
                      (mkProperSep dW (mkProperSep CPN iQ))
                      (sep_swap_ent CPN dW iQ) n x hv q1
                  | q3 => sep_swap_ent LP dW (mkProperSep CPN iQ)
                      n x hv q2
                  | q4 => sep_assoc_r_ent dW LP (mkProperSep CPN iQ)
                      n x hv q3
                  | q5 => sep_mono_l_ent (mkProperSep dW LP)
                      (mkProperSep LP LP)
                      (mkProperSep CPN iQ)
                      (properUPred_ent_trans (mkProperSep dW LP)
                        (mkProperSep (mkProperLater dW) LP)
                        (mkProperSep LP LP)
                        (sep_mono_l_ent dW (mkProperLater dW) LP
                          (proper_later_intro dW))
                        (properUPred_ent_trans
                          (mkProperSep (mkProperLater dW) LP)
                          (mkProperLater (mkProperSep P P))
                          (mkProperSep LP LP)
                          (later_wand_apply_ent P (mkProperSep P P))
                          (proper_later_sep_1 P P)))
                      n x hv q4
                  | q6 => sep_assoc_l_ent LP LP (mkProperSep CPN iQ)
                      n x hv q5
                  | q7 => sep_mono_r_ent LP
                      (mkProperSep LP (mkProperSep CPN iQ))
                      (mkProperSep (mkProperSep LP CPN) iQ)
                      (sep_assoc_r_ent LP CPN iQ) n x hv q6
                  | q8 => sep_mono_r_ent LP
                      (mkProperSep (mkProperSep LP CPN) iQ)
                      (mkProperSep F0 iQ)
                      (sep_mono_l_ent (mkProperSep LP CPN) F0 iQ
                        (properUPred_ent_trans (mkProperSep LP CPN)
                          (mkProperSep CPN LP) F0
                          (sep_comm_ent LP CPN)
                          (wand_elim_ent LP F0)))
                      n x hv q7
                  | q9 => sep_swap_ent LP F0 iQ n x hv q8
                  | q10 => fupd_frame_r W DN E mkProperEmp
                      (mkProperSep LP iQ) n x hv q9
                \in fupd_mono W DN E
                  (mkProperSep mkProperEmp (mkProperSep LP iQ))
                  (mkProperSep LP iQ)
                  (sep_elim_r_ent mkProperEmp (mkProperSep LP iQ))
                  n x hv q10
          -- step B: reopen for Q and build the combined body (sealed close)
          | conv : properUPred_ent (mkProperSep LP bodyQ) Ts =>
              \lam n x hv h =>
                \let
                  | s1' => sep_mono_r_ent LP bodyQ
                      (mkProperSep CQN LQ)
                      (sep_comm_ent LQ CQN) n x hv h
                  | s2' => sep_swap_ent LP CQN LQ n x hv s1'
                  | s3' => sep_mono_r_ent CQN (mkProperSep LP LQ) LPQ
                      (proper_later_sep_2 P Q) n x hv s2'
                  | s4' => sep_comm_ent CQN LPQ n x hv s3'
                \in sep_mono_r_ent LPQ CQN CTs
                  (wand_intro_ent CQN LPQ (sealedFUpd W DN E mkProperEmp)
                    (transport
                      (\lam (Z : iProp S) => properUPred_ent
                        (mkProperSep CQN LPQ) Z)
                      (Paths.inv (sealedFUpd_peval W DN E mkProperEmp))
                      (\lam n' x' hv' h' =>
                        \let
                          | w1 => sep_mono_r_ent CQN LPQ
                              (mkProperSep LP LQ)
                              (proper_later_sep_1 P Q) n' x' hv' h'
                          | w2 => sep_swap_ent CQN LP LQ n' x' hv' w1
                          | w3 => sep_mono_r_ent LP
                              (mkProperSep CQN LQ) F0
                              (wand_elim_ent LQ F0) n' x' hv' w2
                        \in sep_elim_r_ent LP F0 n' x' hv' w3)))
                  n x hv s4'
          | stepB : properUPred_ent (mkProperSep LP iQ)
              (mkProperFUpd W E DN Ts) =>
              \lam n x hv h =>
                \let
                  | r1 => sep_mono_r_ent LP iQ
                      (mkProperFUpd W E DN bodyQ) openQ n x hv h
                  | r2 => fupd_frame_l W E DN LP bodyQ n x hv r1
                \in fupd_mono W E DN (mkProperSep LP bodyQ) Ts conv
                  n x hv r2
        \in \lam n x hv h =>
          \let
            | d1 => sep_mono_r_ent dW
                (mkProperSep iP iQ)
                (mkProperSep (mkProperFUpd W E DN bodyP) iQ)
                (sep_mono_l_ent iP (mkProperFUpd W E DN bodyP) iQ openP)
                n x hv h
            | d2 => sep_swap_ent dW (mkProperFUpd W E DN bodyP) iQ
                n x hv d1
            | d3 => fupd_frame_r W E DN bodyP (mkProperSep dW iQ)
                n x hv d2
            | d4 => fupd_mono W E DN
                (mkProperSep bodyP (mkProperSep dW iQ))
                (mkProperFUpd W DN E (mkProperSep LP iQ))
                stepA n x hv d3
            | d5 => fupd_trans W E DN E (mkProperSep LP iQ) n x hv d4
            | d6 => fupd_mono W E E
                (mkProperSep LP iQ)
                (mkProperFUpd W E DN Ts)
                stepB n x hv d5
            | d7 => fupd_trans W E E DN Ts n x hv d6
          \in transport
            (\lam (Z : iProp S) =>
              (mkProperFUpd W E DN
                (mkProperSep LPQ (mkProperWand LPQ Z))).upred_holds n x)
            (sealedFUpd_peval W DN E mkProperEmp)
            d7))

\lemma inv_combine_dup_l {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (P Q : iProp S)
  : properUPred_ent
      (mkProperSep (mkProperPersistently (dup_wand P))
        (mkProperSep (inv W N P) (inv W N Q)))
      (inv W N (mkProperSep P Q)) =>
  \let
    | PD => mkProperPersistently (dup_wand P)
    | u1 : properUPred_ent
        (mkProperSep PD (mkProperSep (inv W N P) (inv W N Q)))
        (mkProperSep PD
          (mkProperSep (inv_body W N P) (inv_body W N Q))) =>
        sep_mono_r_ent PD
          (mkProperSep (inv W N P) (inv W N Q))
          (mkProperSep (inv_body W N P) (inv_body W N Q))
          (properUPred_ent_trans
            (mkProperSep (inv W N P) (inv W N Q))
            (mkProperSep (inv_body W N P) (inv W N Q))
            (mkProperSep (inv_body W N P) (inv_body W N Q))
            (sep_mono_l_ent (inv W N P) (inv_body W N P) (inv W N Q)
              (inv_unfold_ent W N P))
            (sep_mono_r_ent (inv_body W N P) (inv W N Q)
              (inv_body W N Q)
              (inv_unfold_ent W N Q)))
    | u2 : properUPred_ent
        (mkProperSep PD
          (mkProperSep (inv_body W N P) (inv_body W N Q)))
        (mkProperSep PD
          (mkProperPersistently
            (mkProperSep (inv_inner W N P) (inv_inner W N Q)))) =>
        sep_mono_r_ent PD
          (mkProperSep (inv_body W N P) (inv_body W N Q))
          (mkProperPersistently
            (mkProperSep (inv_inner W N P) (inv_inner W N Q)))
          (persistently_sep_2_ent (inv_inner W N P) (inv_inner W N Q))
    | u3 : properUPred_ent
        (mkProperSep PD
          (mkProperPersistently
            (mkProperSep (inv_inner W N P) (inv_inner W N Q))))
        (mkProperPersistently
          (mkProperSep (dup_wand P)
            (mkProperSep (inv_inner W N P) (inv_inner W N Q)))) =>
        persistently_sep_2_ent (dup_wand P)
          (mkProperSep (inv_inner W N P) (inv_inner W N Q))
    | u4 : properUPred_ent
        (mkProperPersistently
          (mkProperSep (dup_wand P)
            (mkProperSep (inv_inner W N P) (inv_inner W N Q))))
        (inv_body W N (mkProperSep P Q)) =>
        (BIuPredPersistentlyMixin (iResUR S)).persistently_mono
          (mkProperSep (dup_wand P)
            (mkProperSep (inv_inner W N P) (inv_inner W N Q)))
          (inv_inner W N (mkProperSep P Q))
          (inv_combine_dup_inner W N P Q)
  \in \lam n x hv h =>
    inv_fold_ent W N (mkProperSep P Q) n x hv
      (u4 n x hv (u3 n x hv (u2 n x hv (u1 n x hv h))))
