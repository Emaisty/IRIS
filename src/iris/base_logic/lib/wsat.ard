\import Logic
\import Paths
\import Set
\import Arith.Nat
\import Order.PartialOrder
\import Data.Bool
\import Data.Maybe
\import Data.List (List, nil, ::)
\import iris.algebra.ofe
\import iris.algebra.cmra
-- `uPred` also exports ownM-level `own_valid`/`own_mono`; hide them so the
-- `own`-level ones from `own.ard` resolve unambiguously.
\import iris.base_logic.upred \hiding (own_valid, own_mono, own_unit)
\import iris.base_logic.notation
\import iris.bi.updates
\import iris.base_logic.lib.iprop
\import iris.base_logic.lib.own
\import iris.bi.big_op
\import iris.base_logic.lib.gfunctors
\import iris.algebra.gmap
\import iris.algebra.frac
\import iris.algebra.dfrac
\import iris.algebra.agree
\import iris.algebra.view
\import iris.algebra.lib.gmap_view
\import stdpp.coPset
\import iris.algebra.coPset
\import iris.algebra.gset
\import stdpp.pmap (Pos, pmap_to_list, pomap, plookup, plookup_pomap, pomap_tree)

-- =================================================================================
-- Plan A, §A7: `wsatGS`, `ownI`, `ownE`, `ownD`, `wsat`.
--
-- Faithful port of the definition layer of Rocq `base_logic/lib/wsat.v` — the
-- sub-definitions built on `own` (A5).  The lemma layer (`ownE_op`,
-- `invariant_lookup`, `ownI_open/close/alloc`, `wsat_alloc`) comes next.
--
-- Deviations from Rocq, all forced by earlier design choices:
--   * `wsatGS` is an explicit record argument rather than a typeclass; this
--     follows the convention set by `inG` in `own.ard`.
--   * `locked` is dropped: Rocq locks `wsat` against `simpl`; Arend has no
--     such tactic pressure, and downstream proofs unfold `wsat` on purpose.
--   * `wsatΣ` / `subG_wsatΣ` remain deferred to the adequacy bootstrap.
-- =================================================================================

-- =================================================================================
-- The three ghost resources of world satisfaction (Rocq `wsatGpreS`/`wsatGS`).
--
--   * invariant map : gmap_view gname (agree (later (iProp Σ)))
--   * enabled set   : coPset_disj
--   * disabled set  : gset_disj positive
-- =================================================================================

\func wsat_invV (S : gFunctors) : CMRA.{0} => AgreeCMRA (LaterOFE (iPropO S))

-- The seal's *body* is built over `iPropCOFE S` (the COFE, coerced to its OFE
-- part) rather than `iPropO S`.  The two are definitionally interchangeable at
-- type level (`UPredCOFE`'s `OFE` field is `UPredOFE`), so the declared
-- interface keeps the `iPropO` leaf and nothing downstream changes.  The
-- `iPropCOFE` body leaf makes `\peval wsat_invKit S` land on the same leaf the
-- functor package `wsatSigma` applies at (`rFunctor_apply … (iPropCOFE S)`),
-- keeping the `subG_wsatSigma` conversion in the tractable same-leaf class —
-- with mismatched leaves the conversion checker diverges (see wsat_sigma.ard).
\sfunc wsat_invKit (S : gFunctors)
  : GmapViewAgreeKit gname gnameCountable (LaterOFE (iPropO S)) =>
  gmap_view_agree_kit gname gnameCountable (LaterOFE (iPropCOFE S))

\func wsat_invR (S : gFunctors) : CMRA.{0} =>
  (wsat_invKit S).gva_R

\sfunc wsat_inv_auth {S : gFunctors} (dq : Dfrac)
    (m : Gmap gname gnameCountable (wsat_invV S).E)
  : (wsat_invR S).E =>
  (wsat_invKit S).gva_auth dq m

\func wsat_inv_auth_peval {S : gFunctors} (dq : Dfrac)
    (m : Gmap gname gnameCountable (wsat_invV S).E)
  : wsat_inv_auth dq m = (wsat_invKit S).gva_auth dq m =>
  \peval wsat_inv_auth dq m

\sfunc wsat_inv_frag {S : gFunctors} (i : gname) (dq : Dfrac)
    (v : (wsat_invV S).E) : (wsat_invR S).E =>
  (wsat_invKit S).gva_frag i dq v

\func wsat_inv_frag_peval {S : gFunctors} (i : gname) (dq : Dfrac)
    (v : (wsat_invV S).E)
  : wsat_inv_frag i dq v = (wsat_invKit S).gva_frag i dq v =>
  \peval wsat_inv_frag i dq v

\lemma wsat_inv_auth_validN {S : gFunctors} (n : Nat) (dq : Dfrac)
    (m : Gmap gname gnameCountable (wsat_invV S).E)
    (hdq : dfrac_valid dq)
  : (wsat_invR S).validN n (wsat_inv_auth dq m) =>
  transport ((wsat_invR S).validN n)
    (inv (wsat_inv_auth_peval dq m))
    ((wsat_invKit S).gva_auth_validN n dq m hdq)

\lemma cmra_update_det_paths {M : UCMRA} (x x0 y y0 : M.E)
    (px : x = x0) (py : y = y0)
    (h : cmra_updateP {M} x0 (\lam z => z = y0))
  : cmra_updateP {M} x (\lam z => z = y) =>
  \lam n yf hv =>
    \let hv0 : M.validN n (M.op x0 yf) =>
      transport (M.validN n) (pmap (\lam a => M.op a yf) px) hv
    \in \scase h n yf hv0 \with {
      | inP (z, ez, hvz) =>
        \let
          | zy : z = y => ez *> inv py
          | hvy : M.validN n (M.op y yf) =>
              transport (M.validN n) (pmap (\lam a => M.op a yf) zy) hvz
        \in inP (y, idp, hvy)
    }

\lemma wsat_inv_alloc {S : gFunctors}
    (m : Gmap gname gnameCountable (wsat_invV S).E)
    (i : gname) (dq : Dfrac) (v : (wsat_invV S).E)
    (fresh : glookup m i = nothing) (hdq : dfrac_valid dq)
    (hv : (wsat_invV S).valid v)
  : cmra_updateP {(wsat_invKit S).gva_R}
      (wsat_inv_auth (DfracOwn qp_one) m)
      (\lam y => y = (wsat_invR S).op
        (wsat_inv_auth (DfracOwn qp_one) (ginsert i v m))
        (wsat_inv_frag i dq v)) =>
  \let
    | K => wsat_invKit S
    | x0 => K.gva_auth (DfracOwn qp_one) m
    | y0 => K.gva_R.op
        (K.gva_auth (DfracOwn qp_one) (ginsert i v m))
        (K.gva_frag i dq v)
    | y => (wsat_invR S).op
        (wsat_inv_auth (DfracOwn qp_one) (ginsert i v m))
        (wsat_inv_frag i dq v)
    | py : y = y0 => pmap2 (\lam a b => (wsat_invR S).op a b)
        (wsat_inv_auth_peval (DfracOwn qp_one) (ginsert i v m))
        (wsat_inv_frag_peval i dq v)
  \in cmra_update_det_paths {K.gva_R}
    (wsat_inv_auth (DfracOwn qp_one) m) x0 y y0
    (wsat_inv_auth_peval (DfracOwn qp_one) m) py
    (K.gva_alloc m i dq v fresh hdq hv)

\record wsatGpreS (S : gFunctors)
  | wsatGpreS_inv : inG S (wsat_invR S)
  | wsatGpreS_enabled : inG S coPset_disj_CMRA
  | wsatGpreS_disabled : inG S gset_disj_CMRA

\record wsatGS \extends wsatGpreS
  | invariant_name : gname
  | enabled_name : gname
  | disabled_name : gname

-- =================================================================================
-- The own-based sub-definitions.
-- =================================================================================

-- Rocq: `invariant_unfold P := Next P`.
\func invariant_unfold {S : gFunctors} (P : iProp S) : (LaterOFE (iPropO S)).E =>
  next P

-- Rocq: `ownI i P := own invariant_name (gmap_view_frag i DfracDiscarded
--                        (to_agree (invariant_unfold P)))`.
\func ownI {S : gFunctors} (W : wsatGS S) (i : gname) (P : iProp S) : iProp S =>
  own W.wsatGpreS_inv W.invariant_name
      (wsat_inv_frag i DfracDiscarded (to_agree (invariant_unfold P)))

\lemma ownI_holds_unfold {S : gFunctors} (W : wsatGS S)
    (i : gname) (P : iProp S) (n : Nat) (x : (iResUR S).E)
    (h : (ownI W i P).upred_holds n x)
  : (own W.wsatGpreS_inv W.invariant_name
      (wsat_inv_frag i DfracDiscarded
        (to_agree (invariant_unfold P)))).upred_holds n x => h

-- Rocq: `ownE E := own enabled_name (CoPset E)`.
\func ownE {S : gFunctors} (W : wsatGS S) (E : coPset) : iProp S =>
  own W.wsatGpreS_enabled W.enabled_name (CoPset E)

-- Rocq: `ownD D := own disabled_name (GSet D)`.
\func ownD {S : gFunctors} (W : wsatGS S) (D : Gset) : iProp S =>
  own W.wsatGpreS_disabled W.disabled_name (GSet D)

-- `invariant_unfold <$> I`, fused with the `Gmap` functorial map.  The store
-- keeps agreed `later (iProp S)` values.
\func invariant_unfold_map {S : gFunctors} (I : Gmap gname gnameCountable (iProp S))
  : Gmap gname gnameCountable (wsat_invV S).E =>
  gmap_to_agree_map I (\lam P => invariant_unfold P)

-- The per-key content of the invariant big-op: `▷ Q ∗ ownD {i} ∨ ownE {i}`.
-- Named so that `big_sepM_extract` instantiates at exactly this function.
\func wsat_entry {S : gFunctors} (W : wsatGS S) (i : gname) (Q : iProp S) : iProp S =>
  ((|> Q) ∗ (ownD W (gset_singleton i))) ∨
      (ownE W (coPset_singleton i))

-- Rocq:
--   wsat := locked (∃ I : gmap positive (iProp Σ),
--     own invariant_name (gmap_view_auth (DfracOwn 1)
--                           (to_agree <$> (invariant_unfold <$> I))) ∗
--     [∗ map] i ↦ Q ∈ I, ▷ Q ∗ ownD {[i]} ∨ ownE {[i]}).
\func wsat {S : gFunctors} (W : wsatGS S) : iProp S =>
  mkProperExist (Gmap gname gnameCountable (iProp S)) (\lam I =>
      (own W.wsatGpreS_inv W.invariant_name
              (wsat_inv_auth (DfracOwn qp_one) (invariant_unfold_map I))) ∗
          (big_sepM I (wsat_entry W)))

-- =================================================================================
-- ownE lemmas (Rocq: `ownE_op`, `ownE_disjoint`, `ownE_op'`,
-- `ownE_singleton_twice`).
--
-- Rocq's set-disjointness `E1 ## E2` is rendered as the decidable
-- `coPset_overlap E1 E2 = false`, the form the coPset_disj op-equations
-- already consume.
-- =================================================================================

\lemma ownE_op {S : gFunctors} (W : wsatGS S) (E1 E2 : coPset)
               (h : coPset_overlap E1 E2 = false)
  : (ownE W (coPset_union E1 E2)) ⊣⊢
               ((ownE W E1) ∗ (ownE W E2))
  => transport
      (\lam a => (own W.wsatGpreS_enabled W.enabled_name a) ⊣⊢
                            ((ownE W E1) ∗ (ownE W E2)))
      (op_CoPset_eq_CoPset E1 E2 h)
      (own_op W.wsatGpreS_enabled W.enabled_name (CoPset E1) (CoPset E2))

\lemma ownE_disjoint {S : gFunctors} (W : wsatGS S) (E1 E2 : coPset)
  : ((ownE W E1) ∗ (ownE W E2)) ⊢
                    (mkProperPure (coPset_overlap E1 E2 = false))
  => \lam n x hv hsep =>
      \case coPset_overlap E1 E2 \as b, idp : coPset_overlap E1 E2 = b
        \return coPset_overlap E1 E2 = false \with {
        | false, hb => hb
        | true, hb =>
          \let
            | hop => (own_op W.wsatGpreS_enabled W.enabled_name
                          (CoPset E1) (CoPset E2) n x hv).2 hsep
            | hval : coPset_disj_valid (coPset_disj_op (CoPset E1) (CoPset E2)) =>
                own_valid W.wsatGpreS_enabled W.enabled_name
                    (coPset_disj_op (CoPset E1) (CoPset E2)) n x hv hop
            | hbad : coPset_disj_valid CoPsetInvalid =>
                transport (\lam y => coPset_disj_valid y)
                    (op_CoPset_eq_invalid E1 E2 hb) hval
          \in absurd hbad
      }

\lemma ownE_op' {S : gFunctors} (W : wsatGS S) (E1 E2 : coPset)
  : ((mkProperPure (coPset_overlap E1 E2 = false)) ∧
                            (ownE W (coPset_union E1 E2))) ⊣⊢
               ((ownE W E1) ∗ (ownE W E2))
  => \lam n x hv =>
      ( \lam hand => (ownE_op W E1 E2 hand.1 n x hv).1 hand.2
      , \lam hsep =>
          \let hdisj => ownE_disjoint W E1 E2 n x hv hsep
          \in (hdisj, (ownE_op W E1 E2 hdisj n x hv).2 hsep)
      )

\lemma ownE_singleton_twice {S : gFunctors} (W : wsatGS S) (i : gname)
  : ((ownE W (coPset_singleton i)) ∗ (ownE W (coPset_singleton i))) ⊢
      (mkProperPure Empty)
  => \lam n x hv hsep =>
      \case inv (coPset_overlap_complete (coPset_singleton i) (coPset_singleton i) i
                    (coPmem_singleton_eq i) (coPmem_singleton_eq i))
            *> ownE_disjoint W (coPset_singleton i) (coPset_singleton i) n x hv hsep
      \with {}

-- =================================================================================
-- ownD lemmas (Rocq: `ownD_op`, `ownD_disjoint`, `ownD_op'`,
-- `ownD_singleton_twice`) — mirror images of the ownE family over gset_disj.
-- =================================================================================

\lemma ownD_op {S : gFunctors} (W : wsatGS S) (D1 D2 : Gset)
               (h : gset_overlap D1 D2 = false)
  : (ownD W (gset_union D1 D2)) ⊣⊢
               ((ownD W D1) ∗ (ownD W D2))
  => transport
      (\lam a => (own W.wsatGpreS_disabled W.disabled_name a) ⊣⊢
                            ((ownD W D1) ∗ (ownD W D2)))
      (op_GSet_eq_GSet D1 D2 h)
      (own_op W.wsatGpreS_disabled W.disabled_name (GSet D1) (GSet D2))

\lemma ownD_disjoint {S : gFunctors} (W : wsatGS S) (D1 D2 : Gset)
  : ((ownD W D1) ∗ (ownD W D2)) ⊢
                    (mkProperPure (gset_overlap D1 D2 = false))
  => \lam n x hv hsep =>
      \case gset_overlap D1 D2 \as b, idp : gset_overlap D1 D2 = b
        \return gset_overlap D1 D2 = false \with {
        | false, hb => hb
        | true, hb =>
          \let
            | hop => (own_op W.wsatGpreS_disabled W.disabled_name
                          (GSet D1) (GSet D2) n x hv).2 hsep
            | hval : gset_disj_valid (gset_disj_op (GSet D1) (GSet D2)) =>
                own_valid W.wsatGpreS_disabled W.disabled_name
                    (gset_disj_op (GSet D1) (GSet D2)) n x hv hop
            | hbad : gset_disj_valid GSetInvalid =>
                transport (\lam y => gset_disj_valid y)
                    (op_GSet_eq_invalid D1 D2 hb) hval
          \in absurd hbad
      }

\lemma ownD_op' {S : gFunctors} (W : wsatGS S) (D1 D2 : Gset)
  : ((mkProperPure (gset_overlap D1 D2 = false)) ∧
                            (ownD W (gset_union D1 D2))) ⊣⊢
               ((ownD W D1) ∗ (ownD W D2))
  => \lam n x hv =>
      ( \lam hand => (ownD_op W D1 D2 hand.1 n x hv).1 hand.2
      , \lam hsep =>
          \let hdisj => ownD_disjoint W D1 D2 n x hv hsep
          \in (hdisj, (ownD_op W D1 D2 hdisj n x hv).2 hsep)
      )

\lemma ownD_singleton_twice {S : gFunctors} (W : wsatGS S) (i : gname)
  : ((ownD W (gset_singleton i)) ∗ (ownD W (gset_singleton i))) ⊢
      (mkProperPure Empty)
  => \lam n x hv hsep =>
      \case inv (gset_overlap_complete (gset_singleton i) (gset_singleton i) i
                    (gset_in_singleton_eq i) (gset_in_singleton_eq i))
            *> ownD_disjoint W (gset_singleton i) (gset_singleton i) n x hv hsep
      \with {}

-- =================================================================================
-- invariant_lookup (Rocq: `invariant_lookup`).
--
--   own(auth I) ∗ ownI i P ⊢ ∃ Q, ⌜I !! i = just Q⌝ ∗ ▷ (Q ≡ P)
--
-- Rocq goes through `gmap_view_both_validI_total`, `to_agree_includedI` and
-- `later_equivI`; our model-level pipeline is `own_op` + `own_valid` +
-- `gmap_view_both_validN`, then inverting the `invariant_unfold <$> I` lookup
-- and reading the `LaterOFE` distance off as `▷ (Q ≡ P)`.
-- =================================================================================

-- Lookup inversion for `invariant_unfold_map` (pattern of
-- `gmap_to_agree_lookup_just` in gmap_view_full.ard).
\func invariant_unfold_map_lookup_just {S : gFunctors}
    (I : Gmap gname gnameCountable (iProp S)) (k : gname)
    (v : (wsat_invV S).E)
    (h : glookup (invariant_unfold_map I) k = just v)
  : \Sigma (Q : iProp S) (glookup I k = just Q)
      (v = to_agree (next Q))
  => gmap_to_agree_lookup_just
       {gname} {iProp S} {gnameCountable} {LaterOFE (iPropO S)}
       I (\lam P => invariant_unfold P) k v h

-- `dist_later n P Q` (from the stored `LaterOFE` value) gives the holds-witness
-- of `▷ (Q ≡ P)` at index `n` — resource-independently.
\lemma later_internal_eq_holds {S : gFunctors} (n : Nat) (x : (iResUR S).E)
    (Q P : iProp S) (h : DistLater {iPropO S} n P Q)
  : (|> (mkProperInternalEq {iResUR S} {iPropO S} Q P)).upred_holds n x
  => \case \elim n, \elim h \with {
    | 0, _ => ()
    | suc n', h' => (iPropO S).ofe_dist_sym n' P Q (h'.dist_later_lt n' id<suc)
  }

\lemma own_op_valid_at {S : gFunctors} {A : CMRA.{0}}
    (i : inG S A) (gam : gname) (a b : A.E)
    (n : Nat) (x : (iResUR S).E) (hv : (iResUR S).validN n x)
    (hsep : ((own i gam a) ∗ (own i gam b)).upred_holds n x)
  : A.validN n (A.op a b) =>
  own_op_valid i gam a b n x hv hsep

\lemma own_op_valid_elim_at {S : gFunctors} {A : CMRA.{0}}
    (i : inG S A) (gam : gname) (a b : A.E)
    (n : Nat) (x : (iResUR S).E) (hv : (iResUR S).validN n x)
    (P : \Prop) (k : A.validN n (A.op a b) -> P)
    (hsep : ((own i gam a) ∗ (own i gam b)).upred_holds n x)
  : P => k (own_op_valid_at i gam a b n x hv hsep)

-- Keep the full gmap-view validity calculation outside the `own` entailment.
-- This is the model-level content of `invariant_lookup`; making it a separate
-- checked definition prevents conversion from unfolding the whole view CMRA at
-- every use of the logical lemma.
\lemma invariant_lookup_validN {S : gFunctors} (n : Nat)
    (I : Gmap gname gnameCountable (iProp S)) (i : gname) (P : iProp S)
    (hval : (wsat_invR S).validN n
      ((wsat_invR S).op
        (wsat_inv_auth (DfracOwn qp_one) (invariant_unfold_map I))
        (wsat_inv_frag i DfracDiscarded (to_agree (invariant_unfold P)))))
  : TruncP (\Sigma (Q : iProp S) (glookup I i = just Q)
      (DistLater {iPropO S} n P Q)) =>
  \let
    | K => wsat_invKit S
    | auth0 => K.gva_auth (DfracOwn qp_one)
        (gmap_to_agree_map I (\lam Q => invariant_unfold Q))
    | frag0 => K.gva_frag i DfracDiscarded
        (to_agree (invariant_unfold P))
    | eop : (wsat_invR S).op
          (wsat_inv_auth (DfracOwn qp_one) (invariant_unfold_map I))
          (wsat_inv_frag i DfracDiscarded (to_agree (invariant_unfold P)))
        = (wsat_invR S).op auth0 frag0 =>
        pmap2 (\lam a b => (wsat_invR S).op a b)
          (wsat_inv_auth_peval (DfracOwn qp_one) (invariant_unfold_map I))
          (wsat_inv_frag_peval i DfracDiscarded
            (to_agree (invariant_unfold P)))
    | hmodel : (wsat_invR S).validN n ((wsat_invR S).op auth0 frag0) =>
        transport ((wsat_invR S).validN n) eop hval
  \in (K.gva_both_discarded_map_validN
    (iProp S) n (DfracOwn qp_one) I (\lam Q => invariant_unfold Q)
    i (invariant_unfold P) hmodel).2

\lemma invariant_lookup {S : gFunctors} (W : wsatGS S)
    (I : Gmap gname gnameCountable (iProp S)) (i : gname) (P : iProp S)
  : ((own W.wsatGpreS_inv W.invariant_name
              (wsat_inv_auth (DfracOwn qp_one) (invariant_unfold_map I))) ∗
          (ownI W i P)) ⊢
      (mkProperExist (iProp S) (\lam Q =>
          (mkProperPure (glookup I i = just Q)) ∗
              (|> (mkProperInternalEq {iResUR S} {iPropO S} Q P))))
  => \lam n x hv hsep => \case hsep \with {
      | inP (x1, x2, dx, hauth, hownI) =>
        \let
          | authE => wsat_inv_auth (DfracOwn qp_one) (invariant_unfold_map I)
          | fragE => wsat_inv_frag i DfracDiscarded (to_agree (invariant_unfold P))
          | hdirect : ((own W.wsatGpreS_inv W.invariant_name authE) ∗
                (own W.wsatGpreS_inv W.invariant_name fragE)).upred_holds n x =>
              inP (x1, x2, dx, hauth,
                ownI_holds_unfold W i P n x2 hownI)
          | found => own_op_valid_elim_at {S} {wsat_invR S}
              W.wsatGpreS_inv W.invariant_name authE fragE n x hv
              (TruncP (\Sigma (Q : iProp S) (glookup I i = just Q)
                (DistLater {iPropO S} n P Q)))
              (invariant_lookup_validN n I i P) hdirect
        \in \scase found \with {
          | inP (Q, hQ, hdl) =>
            inP (Q, inP (x, (iResUR S).unit,
                  (iResUR S).ofe_dist_sym n ((iResUR S).op x (iResUR S).unit) x
                      (ucmra_unit_right_id_dist {iResUR S} n x),
                  hQ,
                  later_internal_eq_holds n (iResUR S).unit Q P hdl))
        }
      }

-- =================================================================================
-- ▷-equality elimination: from ▷(Q ≡ P) use the stored equality one step later.
-- =================================================================================

\lemma later_eq_use {M : UCMRA} (n : Nat) (u w : M.E) (Q P : ProperUPred M)
    (hlater : (|> (mkProperInternalEq {M} {UPredOFE M} Q P)).upred_holds n w)
    (hQ : (|> Q).upred_holds n u)
    (hvu : M.validN n u)
  : (|> P).upred_holds n u
  => \case \elim n, hlater, hQ, hvu \with {
    | 0, _, _, _ => ()
    | suc n', hl, hq, hvu' =>
        (hl n' u <=-refl (M.cmra_validN_le (suc n') n' u hvu' (n<=sucn n'))).1 hq
  }

\lemma later_eq_use_rev {M : UCMRA} (n : Nat) (u w : M.E) (Q P : ProperUPred M)
    (hlater : (|> (mkProperInternalEq {M} {UPredOFE M} Q P)).upred_holds n w)
    (hP : (|> P).upred_holds n u)
    (hvu : M.validN n u)
  : (|> Q).upred_holds n u
  => \case \elim n, hlater, hP, hvu \with {
    | 0, _, _, _ => ()
    | suc n', hl, hp, hvu' =>
        (hl n' u <=-refl (M.cmra_validN_le (suc n') n' u hvu' (n<=sucn n'))).2 hp
  }

-- =================================================================================
-- ownI_open (Rocq: `ownI_open`):
--   wsat ∗ ownI i P ∗ ownE {i} ⊢ wsat ∗ ▷ P ∗ ownD {i}
-- =================================================================================

\lemma ownI_open {S : gFunctors} (W : wsatGS S) (i : gname) (P : iProp S)
  : ((wsat W) ∗ ((ownI W i P) ∗ (ownE W (coPset_singleton i)))) ⊢
      ((wsat W) ∗ ((|> P) ∗ (ownD W (gset_singleton i))))
  => \lam n x hv hsep => \case hsep \with {
    | inP (x1, x2, dx, hw, hoe) => \case hw \with {
      | inP (I, hI) => \case hI, hoe \with {
        | inP (y1, y2, d1, hauth, hbig), inP (z1, z2, d2, hfrag, hE) =>
          \let
            | M => iResUR S
            | dA : M.dist n x (M.op (M.op y1 y2) (M.op z1 z2)) =>
                dist_op_congr {iResUR S} n x x1 x2 (M.op y1 y2) (M.op z1 z2) dx d1 d2
            | dB : M.dist n x (M.op (M.op y1 z1) (M.op y2 z2)) =>
                M.ofe_dist_trans n x (M.op (M.op y1 y2) (M.op z1 z2)) (M.op (M.op y1 z1) (M.op y2 z2))
                    dA (op_exchange_dist {iResUR S} n y1 y2 z1 z2)
            | hv_y1z1 : M.validN n (M.op y1 z1) =>
                validN_sub_l {iResUR S} n x (M.op y1 z1) (M.op y2 z2) hv dB
            | hlk => invariant_lookup W I i P n (M.op y1 z1) hv_y1z1
                (inP (y1, z1, M.ofe_dist_refl n (M.op y1 z1), hauth, hfrag))
          \in \case hlk \with {
            | inP (Q, hQs) => \case hQs \with {
              | inP (u1, u2, _, hpure, hlater) =>
                \let
                  | (R, ext1, ext2) => big_sepM_extract {iResUR S} I (wsat_entry W) i Q hpure
                  | hv_y2 : M.validN n y2 =>
                      cmra_validN_op_r {iResUR S} n y1 y2 (validN_sub_l {iResUR S} n x (M.op y1 y2) (M.op z1 z2) hv dA)
                  | hsplit => ext1 n y2 hv_y2 hbig
                \in \case hsplit \with {
                  | inP (w1, w2, dy2, hentry, hR) => \case hentry \with {
                    | byRight hE1 =>
                        \let
                          | dC : M.dist n x (M.op (M.op y2 z2) (M.op y1 z1)) =>
                              M.ofe_dist_trans n x (M.op (M.op y1 y2) (M.op z1 z2)) (M.op (M.op y2 z2) (M.op y1 z1))
                                  dA
                                  (M.ofe_dist_trans n (M.op (M.op y1 y2) (M.op z1 z2))
                                      (M.op (M.op y2 y1) (M.op z2 z1))
                                      (M.op (M.op y2 z2) (M.op y1 z1))
                                      (cmra_op_ne_both n (M.op y1 y2) (M.op y2 y1) (M.op z1 z2) (M.op z2 z1)
                                          (cmra_comm_dist {iResUR S} n y1 y2) (cmra_comm_dist {iResUR S} n z1 z2))
                                      (op_exchange_dist {iResUR S} n y2 y1 z2 z1))
                          | dD : M.dist n x (M.op (M.op (M.op w1 w2) z2) (M.op y1 z1)) =>
                              M.ofe_dist_trans n x (M.op (M.op y2 z2) (M.op y1 z1)) (M.op (M.op (M.op w1 w2) z2) (M.op y1 z1))
                                  dC
                                  (M.cmra_op_ne_2 (M.op y1 z1) n (M.op y2 z2) (M.op (M.op w1 w2) z2)
                                      (M.cmra_op_ne_2 z2 n y2 (M.op w1 w2) dy2))
                          | dInner : M.dist n (M.op (M.op w1 w2) z2) (M.op (M.op w1 z2) w2) =>
                              M.ofe_dist_trans n (M.op (M.op w1 w2) z2) (M.op w1 (M.op w2 z2)) (M.op (M.op w1 z2) w2)
                                  (M.ofe_dist_sym n (M.op w1 (M.op w2 z2)) (M.op (M.op w1 w2) z2)
                                      (cmra_assoc_dist {iResUR S} n w1 w2 z2))
                                  (M.ofe_dist_trans n (M.op w1 (M.op w2 z2)) (M.op w1 (M.op z2 w2)) (M.op (M.op w1 z2) w2)
                                      (M.cmra_op_ne w1 n (M.op w2 z2) (M.op z2 w2) (cmra_comm_dist {iResUR S} n w2 z2))
                                      (cmra_assoc_dist {iResUR S} n w1 z2 w2))
                          | dE : M.dist n x (M.op (M.op (M.op w1 z2) w2) (M.op y1 z1)) =>
                              M.ofe_dist_trans n x (M.op (M.op (M.op w1 w2) z2) (M.op y1 z1)) (M.op (M.op (M.op w1 z2) w2) (M.op y1 z1))
                                  dD
                                  (M.cmra_op_ne_2 (M.op y1 z1) n (M.op (M.op w1 w2) z2) (M.op (M.op w1 z2) w2) dInner)
                          | hv_w1z2 : M.validN n (M.op w1 z2) =>
                              M.cmra_validN_op_l n (M.op w1 z2) w2
                                  (validN_sub_l {iResUR S} n x (M.op (M.op w1 z2) w2) (M.op y1 z1) hv dE)
                        \in absurd (ownE_singleton_twice W i n (M.op w1 z2) hv_w1z2
                              (inP (w1, z2, M.ofe_dist_refl n (M.op w1 z2), hE1, hE)))
                    | byLeft hld => \case hld \with {
                      | inP (u1', u2', dw1, hQl, hD) =>
                        \let
                          | u => M.op u1' u2'
                          | dA3 : M.dist n x (M.op (M.op y1 (M.op u w2)) (M.op z1 z2)) =>
                              M.ofe_dist_trans n x (M.op (M.op y1 y2) (M.op z1 z2)) (M.op (M.op y1 (M.op u w2)) (M.op z1 z2))
                                  dA
                                  (M.cmra_op_ne_2 (M.op z1 z2) n (M.op y1 y2) (M.op y1 (M.op u w2))
                                      (M.cmra_op_ne y1 n y2 (M.op u w2)
                                          (M.ofe_dist_trans n y2 (M.op w1 w2) (M.op u w2)
                                              dy2
                                              (M.cmra_op_ne_2 w2 n w1 u dw1))))
                          | dEx : M.dist n x (M.op (M.op y1 z1) (M.op (M.op u w2) z2)) =>
                              M.ofe_dist_trans n x (M.op (M.op y1 (M.op u w2)) (M.op z1 z2)) (M.op (M.op y1 z1) (M.op (M.op u w2) z2))
                                  dA3 (op_exchange_dist {iResUR S} n y1 (M.op u w2) z1 z2)
                          | dInner : M.dist n (M.op (M.op u w2) z2) (M.op (M.op z2 w2) u) =>
                              M.ofe_dist_trans n (M.op (M.op u w2) z2) (M.op u (M.op w2 z2)) (M.op (M.op z2 w2) u)
                                  (M.ofe_dist_sym n (M.op u (M.op w2 z2)) (M.op (M.op u w2) z2)
                                      (cmra_assoc_dist {iResUR S} n u w2 z2))
                                  (M.ofe_dist_trans n (M.op u (M.op w2 z2)) (M.op u (M.op z2 w2)) (M.op (M.op z2 w2) u)
                                      (M.cmra_op_ne u n (M.op w2 z2) (M.op z2 w2) (cmra_comm_dist {iResUR S} n w2 z2))
                                      (cmra_comm_dist {iResUR S} n u (M.op z2 w2)))
                          | dF : M.dist n x (M.op (M.op y1 z1) (M.op (M.op z2 w2) u)) =>
                              M.ofe_dist_trans n x (M.op (M.op y1 z1) (M.op (M.op u w2) z2)) (M.op (M.op y1 z1) (M.op (M.op z2 w2) u))
                                  dEx
                                  (M.cmra_op_ne (M.op y1 z1) n (M.op (M.op u w2) z2) (M.op (M.op z2 w2) u) dInner)
                          | dOut : M.dist n x (M.op (M.op (M.op y1 z1) (M.op z2 w2)) u) =>
                              M.ofe_dist_trans n x (M.op (M.op y1 z1) (M.op (M.op z2 w2) u)) (M.op (M.op (M.op y1 z1) (M.op z2 w2)) u)
                                  dF (cmra_assoc_dist {iResUR S} n (M.op y1 z1) (M.op z2 w2) u)
                          | hv_z2w2 : M.validN n (M.op z2 w2) =>
                              M.cmra_validN_op_l n (M.op z2 w2) u
                                  (validN_sub_r {iResUR S} n x (M.op y1 z1) (M.op (M.op z2 w2) u) hv dF)
                          | hv_u1 : M.validN n u1' =>
                              M.cmra_validN_op_l n u1' u2'
                                  (validN_sub_r {iResUR S} n x (M.op (M.op y1 z1) (M.op z2 w2)) u hv dOut)
                          | hauth2 => (own W.wsatGpreS_inv W.invariant_name
                                  (wsat_inv_auth (DfracOwn qp_one)
                                      (invariant_unfold_map I))).upred_mono
                                n n y1 (M.op y1 z1) hauth (inclN_op_l {iResUR S} n y1 z1) <=-refl
                          | hbig2 => ext2 n (M.op z2 w2) hv_z2w2
                              (inP (z2, w2, M.ofe_dist_refl n (M.op z2 w2), byRight hE, hR))
                          | hP => later_eq_use {iResUR S} n u1' u2 Q P hlater hQl hv_u1
                        \in inP (M.op (M.op y1 z1) (M.op z2 w2), u, dOut,
                              inP (I, inP (M.op y1 z1, M.op z2 w2,
                                  M.ofe_dist_refl n (M.op (M.op y1 z1) (M.op z2 w2)),
                                  hauth2, hbig2)),
                              inP (u1', u2', M.ofe_dist_refl n u, hP, hD))
                    }
                  }
                }
            }
          }
      }
    }
  }

-- =================================================================================
-- ownI_close (Rocq: `ownI_close`):
--   wsat ∗ ownI i P ∗ ▷ P ∗ ownD {i} ⊢ wsat ∗ ownE {i}
-- =================================================================================

\lemma ownI_close {S : gFunctors} (W : wsatGS S) (i : gname) (P : iProp S)
  : ((wsat W) ∗ ((ownI W i P) ∗
          ((|> P) ∗ (ownD W (gset_singleton i))))) ⊢
      ((wsat W) ∗ (ownE W (coPset_singleton i)))
  => \lam n x hv hsep => \case hsep \with {
    | inP (x1, x2, dx, hw, hrest) => \case hw \with {
      | inP (I, hI) => \case hI, hrest \with {
        | inP (y1, y2, d1, hauth, hbig), inP (z1, z23, d2, hfrag, h23) => \case h23 \with {
          | inP (z2, z3, d3, hP, hD) =>
            \let
              | M => iResUR S
              | dA : M.dist n x (M.op (M.op y1 y2) (M.op z1 (M.op z2 z3))) =>
                  dist_op_congr {iResUR S} n x x1 x2 (M.op y1 y2) (M.op z1 (M.op z2 z3)) dx d1
                      (M.ofe_dist_trans n x2 (M.op z1 z23) (M.op z1 (M.op z2 z3))
                          d2 (M.cmra_op_ne z1 n z23 (M.op z2 z3) d3))
              | dB : M.dist n x (M.op (M.op y1 z1) (M.op y2 (M.op z2 z3))) =>
                  M.ofe_dist_trans n x (M.op (M.op y1 y2) (M.op z1 (M.op z2 z3))) (M.op (M.op y1 z1) (M.op y2 (M.op z2 z3)))
                      dA (op_exchange_dist {iResUR S} n y1 y2 z1 (M.op z2 z3))
              | hv_y1z1 : M.validN n (M.op y1 z1) =>
                  validN_sub_l {iResUR S} n x (M.op y1 z1) (M.op y2 (M.op z2 z3)) hv dB
              | hlk => invariant_lookup W I i P n (M.op y1 z1) hv_y1z1
                  (inP (y1, z1, M.ofe_dist_refl n (M.op y1 z1), hauth, hfrag))
            \in \case hlk \with {
              | inP (Q, hQs) => \case hQs \with {
                | inP (u1, u2, _, hpure, hlater) =>
                  \let
                    | (R, ext1, ext2) => big_sepM_extract {iResUR S} I (wsat_entry W) i Q hpure
                    | hv_y2 : M.validN n y2 =>
                        cmra_validN_op_r {iResUR S} n y1 y2
                            (validN_sub_l {iResUR S} n x (M.op y1 y2) (M.op z1 (M.op z2 z3)) hv dA)
                    | hsplit => ext1 n y2 hv_y2 hbig
                  \in \case hsplit \with {
                    | inP (w1, w2, dy2, hentry, hR) => \case hentry \with {
                      | byLeft hld => \case hld \with {
                        | inP (u1', u2', dw1, hQl, hD') =>
                          \let
                            | dA2 : M.dist n x (M.op (M.op y1 (M.op (M.op u1' u2') w2)) (M.op z1 (M.op z2 z3))) =>
                                M.ofe_dist_trans n x (M.op (M.op y1 y2) (M.op z1 (M.op z2 z3))) (M.op (M.op y1 (M.op (M.op u1' u2') w2)) (M.op z1 (M.op z2 z3)))
                                    dA
                                    (M.cmra_op_ne_2 (M.op z1 (M.op z2 z3)) n (M.op y1 y2) (M.op y1 (M.op (M.op u1' u2') w2))
                                        (M.cmra_op_ne y1 n y2 (M.op (M.op u1' u2') w2)
                                            (M.ofe_dist_trans n y2 (M.op w1 w2) (M.op (M.op u1' u2') w2)
                                                dy2 (M.cmra_op_ne_2 w2 n w1 (M.op u1' u2') dw1))))
                            | dEx : M.dist n x (M.op (M.op y1 z1) (M.op (M.op (M.op u1' u2') w2) (M.op z2 z3))) =>
                                M.ofe_dist_trans n x (M.op (M.op y1 (M.op (M.op u1' u2') w2)) (M.op z1 (M.op z2 z3))) (M.op (M.op y1 z1) (M.op (M.op (M.op u1' u2') w2) (M.op z2 z3)))
                                    dA2 (op_exchange_dist {iResUR S} n y1 (M.op (M.op u1' u2') w2) z1 (M.op z2 z3))
                            | dI1 : M.dist n (M.op (M.op (M.op u1' u2') w2) (M.op z2 z3)) (M.op (M.op u1' (M.op u2' w2)) (M.op z2 z3)) =>
                                M.cmra_op_ne_2 (M.op z2 z3) n (M.op (M.op u1' u2') w2) (M.op u1' (M.op u2' w2))
                                    (M.ofe_dist_sym n (M.op u1' (M.op u2' w2)) (M.op (M.op u1' u2') w2)
                                        (cmra_assoc_dist {iResUR S} n u1' u2' w2))
                            | dI2 : M.dist n (M.op (M.op u1' (M.op u2' w2)) (M.op z2 z3)) (M.op (M.op u1' z2) (M.op (M.op u2' w2) z3)) =>
                                op_exchange_dist {iResUR S} n u1' (M.op u2' w2) z2 z3
                            | dI3 : M.dist n (M.op (M.op u2' w2) z3) (M.op (M.op u2' z3) w2) =>
                                M.ofe_dist_trans n (M.op (M.op u2' w2) z3) (M.op u2' (M.op w2 z3)) (M.op (M.op u2' z3) w2)
                                    (M.ofe_dist_sym n (M.op u2' (M.op w2 z3)) (M.op (M.op u2' w2) z3)
                                        (cmra_assoc_dist {iResUR S} n u2' w2 z3))
                                    (M.ofe_dist_trans n (M.op u2' (M.op w2 z3)) (M.op u2' (M.op z3 w2)) (M.op (M.op u2' z3) w2)
                                        (M.cmra_op_ne u2' n (M.op w2 z3) (M.op z3 w2) (cmra_comm_dist {iResUR S} n w2 z3))
                                        (cmra_assoc_dist {iResUR S} n u2' z3 w2))
                            | dFull : M.dist n x (M.op (M.op y1 z1) (M.op (M.op u1' z2) (M.op (M.op u2' z3) w2))) =>
                                M.ofe_dist_trans n x (M.op (M.op y1 z1) (M.op (M.op (M.op u1' u2') w2) (M.op z2 z3))) (M.op (M.op y1 z1) (M.op (M.op u1' z2) (M.op (M.op u2' z3) w2)))
                                    dEx
                                    (M.cmra_op_ne (M.op y1 z1) n (M.op (M.op (M.op u1' u2') w2) (M.op z2 z3)) (M.op (M.op u1' z2) (M.op (M.op u2' z3) w2))
                                        (M.ofe_dist_trans n (M.op (M.op (M.op u1' u2') w2) (M.op z2 z3)) (M.op (M.op u1' (M.op u2' w2)) (M.op z2 z3)) (M.op (M.op u1' z2) (M.op (M.op u2' z3) w2))
                                            dI1
                                            (M.ofe_dist_trans n (M.op (M.op u1' (M.op u2' w2)) (M.op z2 z3)) (M.op (M.op u1' z2) (M.op (M.op u2' w2) z3)) (M.op (M.op u1' z2) (M.op (M.op u2' z3) w2))
                                                dI2
                                                (M.cmra_op_ne (M.op u1' z2) n (M.op (M.op u2' w2) z3) (M.op (M.op u2' z3) w2) dI3))))
                            | hv_u2z3 : M.validN n (M.op u2' z3) =>
                                M.cmra_validN_op_l n (M.op u2' z3) w2
                                    (M.cmra_validN_op_l n (M.op (M.op u2' z3) w2) (M.op u1' z2)
                                        (M.cmra_validN_ne n (M.op (M.op u1' z2) (M.op (M.op u2' z3) w2)) (M.op (M.op (M.op u2' z3) w2) (M.op u1' z2))
                                            (cmra_comm_dist {iResUR S} n (M.op u1' z2) (M.op (M.op u2' z3) w2))
                                            (validN_sub_r {iResUR S} n x (M.op y1 z1) (M.op (M.op u1' z2) (M.op (M.op u2' z3) w2)) hv dFull)))
                          \in absurd (ownD_singleton_twice W i n (M.op u2' z3) hv_u2z3
                                (inP (u2', z3, M.ofe_dist_refl n (M.op u2' z3), hD', hD)))
                      }
                      | byRight hEw1 =>
                          \let
                            | dA2 : M.dist n x (M.op (M.op y1 (M.op w1 w2)) (M.op z1 (M.op z2 z3))) =>
                                M.ofe_dist_trans n x (M.op (M.op y1 y2) (M.op z1 (M.op z2 z3))) (M.op (M.op y1 (M.op w1 w2)) (M.op z1 (M.op z2 z3)))
                                    dA
                                    (M.cmra_op_ne_2 (M.op z1 (M.op z2 z3)) n (M.op y1 y2) (M.op y1 (M.op w1 w2))
                                        (M.cmra_op_ne y1 n y2 (M.op w1 w2) dy2))
                            | dEx : M.dist n x (M.op (M.op y1 z1) (M.op (M.op w1 w2) (M.op z2 z3))) =>
                                M.ofe_dist_trans n x (M.op (M.op y1 (M.op w1 w2)) (M.op z1 (M.op z2 z3))) (M.op (M.op y1 z1) (M.op (M.op w1 w2) (M.op z2 z3)))
                                    dA2 (op_exchange_dist {iResUR S} n y1 (M.op w1 w2) z1 (M.op z2 z3))
                            | dInner : M.dist n (M.op (M.op w1 w2) (M.op z2 z3)) (M.op (M.op (M.op z2 z3) w2) w1) =>
                                M.ofe_dist_trans n (M.op (M.op w1 w2) (M.op z2 z3)) (M.op (M.op z2 z3) (M.op w1 w2)) (M.op (M.op (M.op z2 z3) w2) w1)
                                    (cmra_comm_dist {iResUR S} n (M.op w1 w2) (M.op z2 z3))
                                    (M.ofe_dist_trans n (M.op (M.op z2 z3) (M.op w1 w2)) (M.op (M.op z2 z3) (M.op w2 w1)) (M.op (M.op (M.op z2 z3) w2) w1)
                                        (M.cmra_op_ne (M.op z2 z3) n (M.op w1 w2) (M.op w2 w1) (cmra_comm_dist {iResUR S} n w1 w2))
                                        (cmra_assoc_dist {iResUR S} n (M.op z2 z3) w2 w1))
                            | dF : M.dist n x (M.op (M.op y1 z1) (M.op (M.op (M.op z2 z3) w2) w1)) =>
                                M.ofe_dist_trans n x (M.op (M.op y1 z1) (M.op (M.op w1 w2) (M.op z2 z3))) (M.op (M.op y1 z1) (M.op (M.op (M.op z2 z3) w2) w1))
                                    dEx
                                    (M.cmra_op_ne (M.op y1 z1) n (M.op (M.op w1 w2) (M.op z2 z3)) (M.op (M.op (M.op z2 z3) w2) w1) dInner)
                            | dOut : M.dist n x (M.op (M.op (M.op y1 z1) (M.op (M.op z2 z3) w2)) w1) =>
                                M.ofe_dist_trans n x (M.op (M.op y1 z1) (M.op (M.op (M.op z2 z3) w2) w1)) (M.op (M.op (M.op y1 z1) (M.op (M.op z2 z3) w2)) w1)
                                    dF (cmra_assoc_dist {iResUR S} n (M.op y1 z1) (M.op (M.op z2 z3) w2) w1)
                            | hv_body : M.validN n (M.op (M.op z2 z3) w2) =>
                                M.cmra_validN_op_l n (M.op (M.op z2 z3) w2) w1
                                    (validN_sub_r {iResUR S} n x (M.op y1 z1) (M.op (M.op (M.op z2 z3) w2) w1) hv dF)
                            | hv_z2 : M.validN n z2 =>
                                M.cmra_validN_op_l n z2 z3
                                    (M.cmra_validN_op_l n (M.op z2 z3) w2 hv_body)
                            | hQ2 => later_eq_use_rev {iResUR S} n z2 u2 Q P hlater hP hv_z2
                            | hauth2 => (own W.wsatGpreS_inv W.invariant_name
                                    (wsat_inv_auth (DfracOwn qp_one)
                                        (invariant_unfold_map I))).upred_mono
                                  n n y1 (M.op y1 z1) hauth (inclN_op_l {iResUR S} n y1 z1) <=-refl
                            | hbig2 => ext2 n (M.op (M.op z2 z3) w2) hv_body
                                (inP (M.op z2 z3, w2, M.ofe_dist_refl n (M.op (M.op z2 z3) w2),
                                    byLeft (inP (z2, z3, M.ofe_dist_refl n (M.op z2 z3), hQ2, hD)),
                                    hR))
                          \in inP (M.op (M.op y1 z1) (M.op (M.op z2 z3) w2), w1, dOut,
                                inP (I, inP (M.op y1 z1, M.op (M.op z2 z3) w2,
                                    M.ofe_dist_refl n (M.op (M.op y1 z1) (M.op (M.op z2 z3) w2)),
                                    hauth2, hbig2)),
                                hEw1)
                    }
                  }
              }
            }
        }
      }
    }
  }
