-- =================================================================================
-- Plan A, §A7 (allocation): wsat_alloc, ownD_alloc_fresh, ownI_auth_alloc,
-- ownI_alloc, ownI_alloc_open.  Split from wsat.ard so the stable definition +
-- invariant-access layer stays cached while these heavier allocation proofs are
-- iterated on.
--
-- The invariant ghost state uses the sealed full fractional gmap-view package
-- from `wsat`; the generic bupd combinators below keep the large payload opaque.
-- =================================================================================

-- =================================================================================
-- bupd allocation framing: if `emp ⊢ |==> A`, then any `R` can gain `A`.
-- =================================================================================
\lemma bupd_alloc_frame {M : UCMRA} (A R : ProperUPred M)
    (h : mkProperEmp ⊢ (|==> A))
  : R ⊢ (|==> (A ∗ R))
  => \lam n x hv hR =>
      \let
        | emp_unit : mkProperEmp.upred_holds n M.unit => inclN_refl_ucmra n M.unit
        | hvu : M.validN n M.unit => (M.cmra_valid_validN M.unit).1 M.ucmra_unit_valid n
        | hbA : (|==> A).upred_holds n M.unit => h n M.unit hvu emp_unit
        | hsep : ((|==> A) ∗ R).upred_holds n x =>
            inP (M.unit, x,
                 M.ofe_dist_sym n (M.op M.unit x) x (ucmra_unit_left_id_dist n x),
                 hbA, hR)
      \in bupd_frame_r A R n x hv hsep

-- =================================================================================
-- Map-domain as a gset, and its freshness reflection.
-- =================================================================================
\func gmap_dom_gset {A : \Set} (I : Gmap gname gnameCountable A) : Gset =>
  pomap (\lam (_ : \Sigma gname A) => just ()) I.gtree

\lemma glookup_nothing_of_dom {A : \Set} (I : Gmap gname gnameCountable A) (i : gname)
    (h : plookup (gmap_dom_gset I) i = nothing) : glookup I i = nothing
  => \case plookup I.gtree i \as o, idp : plookup I.gtree i = o
       \return glookup I i = nothing \with {
       | nothing, ho => pmap (\lam (o : Maybe (\Sigma gname A)) =>
                                \case o \return Maybe A \with { | nothing => nothing | just p => just p.2 }) ho
       | just p, ho =>
           \let bad : nothing = {Maybe (\Sigma)} just () =>
               inv h
                 *> plookup_pomap (\lam (_ : \Sigma gname A) => just ()) I.gtree i
                 *> pmap (pomap_tree.option_bind (\lam (_ : \Sigma gname A) => just ())) ho
           \in \case bad \with {}
     }

-- =================================================================================
-- invariant_unfold_map commutes with fresh-key insert (mirror of
-- `gmap_to_agree_map_ginsert` in gmap_view_full.ard).
-- =================================================================================
\func invariant_unfold_map_ginsert {S : gFunctors}
    (I : Gmap gname gnameCountable (iProp S)) (i : gname) (P : iProp S)
  : invariant_unfold_map (ginsert i P I)
      = ginsert i (to_agree (invariant_unfold P)) (invariant_unfold_map I)
  => gmap_to_agree_map_ginsert I (\lam Q => invariant_unfold Q) i P

-- =================================================================================
-- Generic fused bupd chains.  Every `bupd_mono`/`bupd_trans`/`bupd_frame_*` here is
-- elaborated ONCE at abstract `ProperUPred M` arguments; the allocation lemmas below
-- instantiate them at the sealed `wsat_invR` own-payload.  The pure-entailment inputs
-- (`final`, `reshape`, `unpack`, …) are fine at the concrete payload — like the
-- invariant-access layer in wsat.ard, they never compose bupd over it.
-- =================================================================================

-- `P ⊢ |==>S` and `S ⊢ T` give `P ⊢ |==>T`.
\lemma bupd_ent_trans {M : UCMRA} (P S T : ProperUPred M)
    (h1 : P ⊢ (|==> S)) (h2 : S ⊢ T)
  : P ⊢ (|==> T)
  => properUPred_ent_trans P (|==> S) (|==> T)
      h1 (bupd_mono S T h2)

-- Allocate `A` (`emp ⊢ |==>A`) as a frame around `Body`, then continue.
\lemma bupd_alloc_frame_then {M : UCMRA} (A Body G : ProperUPred M)
    (h_alloc : mkProperEmp ⊢ (|==> A))
    (h_cont : (A ∗ Body) ⊢ (|==> G))
  : Body ⊢ (|==> G)
  => properUPred_ent_trans Body (|==> (|==> G)) (|==> G)
      (properUPred_ent_trans Body (|==> (A ∗ Body)) (|==> (|==> G))
          (bupd_alloc_frame A Body h_alloc)
          (bupd_mono (A ∗ Body) (|==> G) h_cont))
      (bupd_trans G)

-- Allocate three independent resources `A`, `B`, `C` and reshape:
--   emp ⊢ |==> C ∗ (B ∗ A) ⊢ G.
\lemma bupd_alloc_three_then {M : UCMRA} (A B C G : ProperUPred M)
    (ha : mkProperEmp ⊢ (|==> A))
    (hb : mkProperEmp ⊢ (|==> B))
    (hc : mkProperEmp ⊢ (|==> C))
    (final : (C ∗ (B ∗ A)) ⊢ G)
  : mkProperEmp ⊢ (|==> G)
  => \let
       | chain1 : mkProperEmp ⊢ (|==> (B ∗ A)) =>
           properUPred_ent_trans mkProperEmp
               (|==> (|==> (B ∗ A)))
               (|==> (B ∗ A))
               (properUPred_ent_trans mkProperEmp (|==> A)
                   (|==> (|==> (B ∗ A)))
                   ha
                   (bupd_mono A (|==> (B ∗ A))
                       (bupd_alloc_frame B A hb)))
               (bupd_trans (B ∗ A))
       | chain2 : mkProperEmp ⊢
             (|==> (C ∗ (B ∗ A))) =>
           properUPred_ent_trans mkProperEmp
               (|==> (|==> (C ∗ (B ∗ A))))
               (|==> (C ∗ (B ∗ A)))
               (properUPred_ent_trans mkProperEmp (|==> (B ∗ A))
                   (|==> (|==> (C ∗ (B ∗ A))))
                   chain1
                   (bupd_mono (B ∗ A)
                       (|==> (C ∗ (B ∗ A)))
                       (bupd_alloc_frame C (B ∗ A) hc)))
               (bupd_trans (C ∗ (B ∗ A)))
     \in properUPred_ent_trans mkProperEmp
         (|==> (C ∗ (B ∗ A)))
         (|==> G)
         chain2
         (bupd_mono (C ∗ (B ∗ A)) G final)

-- Allocate a unit resource, run a frame-preserving update to `Mid`, unpack to `Tgt`.
\lemma bupd_unit_then {M : UCMRA} (U Mid Tgt : ProperUPred M)
    (h_unit : mkProperEmp ⊢ (|==> U))
    (h_upd : U ⊢ (|==> Mid))
    (h_unpack : Mid ⊢ Tgt)
  : mkProperEmp ⊢ (|==> Tgt)
  => properUPred_ent_trans mkProperEmp (|==> Mid) (|==> Tgt)
      (properUPred_ent_trans mkProperEmp (|==> (|==> Mid)) (|==> Mid)
          (properUPred_ent_trans mkProperEmp (|==> U) (|==> (|==> Mid))
              h_unit
              (bupd_mono U (|==> Mid) h_upd))
          (bupd_trans Mid))
      (bupd_mono Mid Tgt h_unpack)

-- Register-then-reshape: from `auI ⊢ |==>(Ains ∗ oI)` and a pure reshape of
-- `(Ains ∗ oI) ∗ FRAME ⊢ G`, conclude `auI ∗ FRAME ⊢ |==>G`.
\lemma alloc_frame_reshape {M : UCMRA} (auI Ains oI FRAME G : ProperUPred M)
    (h_alloc : auI ⊢ (|==> (Ains ∗ oI)))
    (h_reshape : ((Ains ∗ oI) ∗ FRAME) ⊢ G)
  : (auI ∗ FRAME) ⊢ (|==> G)
  => properUPred_ent_trans (auI ∗ FRAME)
      ((|==> (Ains ∗ oI)) ∗ FRAME)
      (|==> G)
      (sep_mono_l_ent auI (|==> (Ains ∗ oI)) FRAME h_alloc)
      (bupd_frame_trans (Ains ∗ oI) FRAME G
          (properUPred_ent_trans ((Ains ∗ oI) ∗ FRAME) G (|==> G)
              h_reshape (bupd_intro G)))

-- =================================================================================
-- wsat_alloc (Rocq: `wsat_alloc`): allocate an initial world.
--   ⊢ |==> ∃ (W : wsatGS Σ). wsat W ∗ ownE ⊤
-- Parameterised by the `wsatGpreS` evidence (Rocq's `!wsatGpreS Σ`).
--
-- This is the one place where we use `mkProperExist1`.  Rocq keeps `wsatGS`
-- in `Set` because equality of CMRAs is proof-irrelevant (`Prop`); Arend's
-- CMRA path stored by `inG` instead makes `wsatGS S : Set1`.  The specialized
-- concrete-UPred existential preserves Rocq's direct `W : wsatGS S` witness
-- without raising the universe of the generic BI interface.  Consequently,
-- future consumers of this allocation result must eliminate the witness with
-- `exist1_elim_ent` (or `sep_exist1_l_elim`) rather than the Set0-only generic
-- BI existential laws.  Ordinary Iris existentials remain `mkProperExist`.
-- =================================================================================

\lemma wsat_alloc {S : gFunctors} (WP : wsatGpreS S)
  : mkProperEmp ⊢
      (|==> (mkProperExist1 (wsatGS S) (\lam W =>
          (wsat W) ∗ (ownE W coPset_universe))))
  => \let
       | M => iResUR S
       | av => wsat_inv_auth (DfracOwn qp_one)
           (invariant_unfold_map (gempty {gname} {gnameCountable} {iProp S}))
       | hval_I : (wsat_invR S).valid av =>
           ((wsat_invR S).cmra_valid_validN av).2
               (\lam n => wsat_inv_auth_validN n (DfracOwn qp_one)
                   (invariant_unfold_map gempty) RatField.<=-refl)
       | hval_E : coPset_disj_CMRA.valid (CoPset coPset_universe) => ()
       | hval_D : gset_disj_CMRA.valid (GSet gset_empty) => ()
       | A_I : ProperUPred (iResUR S) =>
           mkProperExist gname (\lam gI => own WP.wsatGpreS_inv gI av)
       | A_E : ProperUPred (iResUR S) =>
           mkProperExist gname (\lam gE => own WP.wsatGpreS_enabled gE (CoPset coPset_universe))
       | A_D : ProperUPred (iResUR S) =>
           mkProperExist gname (\lam gD => own WP.wsatGpreS_disabled gD (GSet gset_empty))
       | alloc_I => own_alloc WP.wsatGpreS_inv av hval_I
       | alloc_E => own_alloc WP.wsatGpreS_enabled (CoPset coPset_universe) hval_E
       | alloc_D => own_alloc WP.wsatGpreS_disabled (GSet gset_empty) hval_D
       | Goal_body : ProperUPred (iResUR S) =>
           mkProperExist1 (wsatGS S) (\lam W => (wsat W) ∗ (ownE W coPset_universe))
       | final : (A_D ∗ (A_E ∗ A_I)) ⊢ Goal_body =>
           \lam n x hv h => \case h \with {
             | inP (aD, aEI, dx, hAD, hAEI) => \case hAEI \with {
               | inP (aE, aI, dEI, hAE, hAI) => \case hAD, hAE, hAI \with {
                 | inP (gD, hownD), inP (gE, hownE), inP (gI, hownI) =>
                   \let
                     | W : wsatGS S => \new wsatGS {
                         | wsatGpreS_inv => WP.wsatGpreS_inv
                         | wsatGpreS_enabled => WP.wsatGpreS_enabled
                         | wsatGpreS_disabled => WP.wsatGpreS_disabled
                         | invariant_name => gI
                         | enabled_name => gE
                         | disabled_name => gD
                       }
                     | dxfull : M.dist n x (M.op aD (M.op aE aI)) =>
                         M.ofe_dist_trans n x (M.op aD aEI) (M.op aD (M.op aE aI))
                             dx (M.cmra_op_ne aD n aEI (M.op aE aI) dEI)
                     | dwant : M.dist n x (M.op aI (M.op aD aE)) =>
                         M.ofe_dist_trans n x (M.op aD (M.op aE aI)) (M.op aI (M.op aD aE))
                             dxfull
                             (M.ofe_dist_trans n (M.op aD (M.op aE aI)) (M.op (M.op aD aE) aI)
                                 (M.op aI (M.op aD aE))
                                 (cmra_assoc_dist {M} n aD aE aI)
                                 (cmra_comm_dist {M} n (M.op aD aE) aI))
                     | hwsat : (wsat W).upred_holds n aI =>
                         inP (gempty, inP (aI, M.unit,
                             M.ofe_dist_sym n (M.op aI M.unit) aI (ucmra_unit_right_id_dist {M} n aI),
                             hownI,
                             inclN_refl_ucmra n M.unit))
                     | hownE_big : (ownE W coPset_universe).upred_holds n (M.op aD aE) =>
                         (own WP.wsatGpreS_enabled gE (CoPset coPset_universe)).upred_mono
                             n n aE (M.op aD aE) hownE
                             (inP (aD, cmra_comm_dist {M} n aD aE))
                             <=-refl
                   \in inP (W, inP (aI, M.op aD aE, dwant, hwsat, hownE_big))
               }
             }
           }
     \in bupd_alloc_three_then {iResUR S} A_I A_E A_D Goal_body
         alloc_I alloc_E alloc_D final

-- =================================================================================
-- ownD_alloc_fresh: allocate a fresh disabled marker.
--   emp ⊢ |==> ∃ i. ⌜psi i⌝ ∗ ownD {i}
-- given a fresh-name oracle for `psi`.  (own_unit + own_updatePM on the
-- disabled ghost, via `gset_disj_alloc_empty_updatePM`.)
-- =================================================================================

\lemma ownD_alloc_fresh {S : gFunctors} (W : wsatGS S) (psi : gname -> \Prop)
    (oracle : \Pi (X : Gset) -> TruncP (\Sigma (i : gname) (plookup X i = nothing) (psi i)))
  : mkProperEmp ⊢
      (|==> (mkProperExist gname (\lam i =>
          (mkProperPure (psi i)) ∗ (ownD W (gset_singleton i)))))
  => \let
       | M => iResUR S
       | Xi : gset_disj -> \Prop => \lam y => TruncP (\Sigma (i : gname)
             (y = GSet (gset_singleton i)) (psi i))
       | step_unit => own_unit {S} {gset_disj_UCMRA} W.wsatGpreS_disabled W.disabled_name
       | step_updP => own_updatePM W.wsatGpreS_disabled W.disabled_name (GSet gset_empty) Xi
           (gset_disj_alloc_empty_updatePM psi oracle)
       | Mid : ProperUPred (iResUR S) => mkProperExist gset_disj (\lam b =>
           (mkProperPure (Xi b)) ∧ (own W.wsatGpreS_disabled W.disabled_name b))
       | Tgt : ProperUPred (iResUR S) => mkProperExist gname (\lam i =>
           (mkProperPure (psi i)) ∗ (ownD W (gset_singleton i)))
       | unpack : Mid ⊢ Tgt =>
           \lam n x hv hmid => \case hmid \with {
             | inP (b, (hpure, hown)) => \case hpure \with {
               | inP (i, beq, hpsi) =>
                   inP (i, inP (M.unit, x,
                       M.ofe_dist_sym n (M.op M.unit x) x (ucmra_unit_left_id_dist {M} n x),
                       hpsi,
                       transport (\lam bb => (own W.wsatGpreS_disabled W.disabled_name bb).upred_holds n x)
                           beq hown))
             }
           }
     \in bupd_unit_then {iResUR S}
         (own W.wsatGpreS_disabled W.disabled_name (GSet gset_empty)) Mid Tgt
         step_unit step_updP unpack

-- =================================================================================
-- ownI_auth_alloc: register a fresh invariant in the authoritative map.
--   own(auth (I)) ⊢ |==> own(auth (<[i:=P]>I)) ∗ ownI i P
-- for `i` fresh in `I`.  (gmap_view_alloc, deterministic, via own_update + own_op.)
-- =================================================================================

\lemma ownI_auth_alloc {S : gFunctors} (W : wsatGS S)
    (I : Gmap gname gnameCountable (iProp S)) (i : gname) (P : iProp S)
    (hfresh : glookup I i = nothing)
  : (own W.wsatGpreS_inv W.invariant_name
          (wsat_inv_auth (DfracOwn qp_one) (invariant_unfold_map I))) ⊢
      (|==> ((own W.wsatGpreS_inv W.invariant_name
              (wsat_inv_auth (DfracOwn qp_one)
                (invariant_unfold_map (ginsert i P I)))) ∗
          (ownI W i P)))
  => \let
       | m => invariant_unfold_map I
       | v => to_agree (invariant_unfold P)
       | hfresh_m : glookup m i = nothing =>
           glookup_map_support_absent I
             (\lam p => just (to_agree (invariant_unfold p.2))) i hfresh
       | authIns => wsat_inv_auth (DfracOwn qp_one) (ginsert i v m)
       | fragV => wsat_inv_frag i DfracDiscarded v
       | upd : cmra_updateP {(wsat_invKit S).gva_R}
             (wsat_inv_auth (DfracOwn qp_one) m)
             (\lam y => y = (wsat_invR S).op authIns fragV) =>
           wsat_inv_alloc m i DfracDiscarded v hfresh_m ()
             (\lam n => view_to_agree_validN n (invariant_unfold P))
       | upd_det : cmra_update {wsat_invR S}
             (wsat_inv_auth (DfracOwn qp_one) m)
             ((wsat_invR S).op authIns fragV) =>
           cmra_updateP_update_det {(wsat_invKit S).gva_R}
             (wsat_inv_auth (DfracOwn qp_one) m)
             ((wsat_invR S).op authIns fragV) upd
       | step => own_update_op W.wsatGpreS_inv W.invariant_name
           (wsat_inv_auth (DfracOwn qp_one) m) authIns fragV upd_det
       | reshape : ((own W.wsatGpreS_inv W.invariant_name authIns) ∗
                          (own W.wsatGpreS_inv W.invariant_name fragV)) ⊢
             ((own W.wsatGpreS_inv W.invariant_name
                     (wsat_inv_auth (DfracOwn qp_one)
                       (invariant_unfold_map (ginsert i P I)))) ∗
                 (ownI W i P)) =>
           \lam n x hv hown =>
               transport (\lam mm => ((own W.wsatGpreS_inv W.invariant_name
                                 (wsat_inv_auth (DfracOwn qp_one) mm)) ∗
                             (ownI W i P)).upred_holds n x)
                   (inv (invariant_unfold_map_ginsert I i P))
                   hown
     \in bupd_ent_trans {iResUR S}
         (own W.wsatGpreS_inv W.invariant_name
           (wsat_inv_auth (DfracOwn qp_one) m))
         ((own W.wsatGpreS_inv W.invariant_name authIns) ∗
                      (own W.wsatGpreS_inv W.invariant_name fragV))
         ((own W.wsatGpreS_inv W.invariant_name
                 (wsat_inv_auth (DfracOwn qp_one)
                   (invariant_unfold_map (ginsert i P I)))) ∗
             (ownI W i P))
         step reshape

-- =================================================================================
-- ownI_alloc (Rocq: `ownI_alloc`):
--   (∀ E, ∃ i, i ∉ E ∧ φ i) → wsat ∗ ▷P ==∗ ∃ i, ⌜φ i⌝ ∗ wsat ∗ ownI i P
-- =================================================================================

\lemma ownI_alloc {S : gFunctors} (W : wsatGS S) (phi : gname -> \Prop) (P : iProp S)
    (Hfresh : \Pi (E : Gset) -> TruncP (\Sigma (i : gname) (plookup E i = nothing) (phi i)))
  : ((wsat W) ∗ (|> P)) ⊢
      (|==> (mkProperExist gname (\lam i =>
          (mkProperPure (phi i)) ∗ ((wsat W) ∗ (ownI W i P)))))
  => \let
       | M => iResUR S
       | au : Gmap gname gnameCountable (iProp S) -> ProperUPred (iResUR S) =>
           \lam J => own W.wsatGpreS_inv W.invariant_name
               (wsat_inv_auth (DfracOwn qp_one) (invariant_unfold_map J))
       | big : Gmap gname gnameCountable (iProp S) -> ProperUPred (iResUR S) =>
           \lam J => big_sepM J (wsat_entry W)
       | Goal : ProperUPred (iResUR S) => mkProperExist gname (\lam i =>
           (mkProperPure (phi i)) ∗ ((wsat W) ∗ (ownI W i P)))
       -- per-I body of the proof
       | perI : \Pi (I : Gmap gname gnameCountable (iProp S)) ->
             (((au I) ∗ (big I)) ∗ (|> P)) ⊢
                             (|==> Goal) =>
           \lam I =>
             \let
               | psi_I : gname -> \Prop => \lam i => \Sigma (glookup I i = nothing) (phi i)
               | oracle_I : \Pi (X : Gset) -> TruncP (\Sigma (i : gname) (plookup X i = nothing) (psi_I i)) =>
                   \lam X => \case Hfresh (gset_union X (gmap_dom_gset I)) \with {
                     | inP (i, hfr, hphi) =>
                       \let
                         | hun : gset_union_fn (plookup X i) (plookup (gmap_dom_gset I) i) = nothing =>
                             inv (plookup_gset_union X (gmap_dom_gset I) i) *> hfr
                         | (hX, hdom) => gset_union_fn_nothing_inv
                             (plookup X i) (plookup (gmap_dom_gset I) i) hun
                       \in inP (i, hX, (glookup_nothing_of_dom I i hdom, hphi))
                   }
               | AiExist : ProperUPred (iResUR S) => mkProperExist gname (\lam i =>
                   (mkProperPure (psi_I i)) ∗ (ownD W (gset_singleton i)))
               | Body : ProperUPred (iResUR S) =>
                   ((au I) ∗ (big I)) ∗ (|> P)
               -- inner: (AiExist ∗ Body) ⊢ |==> Goal, eliminating the fresh index
               | perI_i : \Pi (i : gname) ->
                     (((mkProperPure (psi_I i)) ∗ (ownD W (gset_singleton i))) ∗ Body) ⊢
                         (|==> Goal) =>
                   \lam i => \lam n x hv hs =>
                     \let
                       | hfresh : glookup I i = nothing => \case hs \with {
                           | inP (aPD, _, _, hPD, _) => \case hPD \with {
                             | inP (_, _, _, hpu, _) => hpu.1 } }
                       | hphi : phi i => \case hs \with {
                           | inP (aPD, _, _, hPD, _) => \case hPD \with {
                             | inP (_, _, _, hpu, _) => hpu.2 } }
                       | FRAME : ProperUPred (iResUR S) =>
                           ((|> P) ∗ (ownD W (gset_singleton i))) ∗ (big I)
                       -- reshape: (au(ins) ∗ ownI) ∗ FRAME ⊢ Goal
                       | reshape : (((au (ginsert i P I)) ∗ (ownI W i P)) ∗ FRAME) ⊢ Goal =>
                           \let
                             | frame_to_big : FRAME ⊢ (big (ginsert i P I)) =>
                                 properUPred_ent_trans FRAME
                                     ((wsat_entry W i P) ∗ (big I)) (big (ginsert i P I))
                                     (sep_mono_l_ent ((|> P) ∗ (ownD W (gset_singleton i)))
                                         (wsat_entry W i P) (big I)
                                         (or_intro_l_ent ((|> P) ∗ (ownD W (gset_singleton i)))
                                             (ownE W (coPset_singleton i))))
                                     (big_sepM_insert I (wsat_entry W) i P hfresh).2
                           \in properUPred_ent_trans
                               (((au (ginsert i P I)) ∗ (ownI W i P)) ∗ FRAME)
                               (((au (ginsert i P I)) ∗ (ownI W i P)) ∗ (big (ginsert i P I)))
                               Goal
                               (sep_mono_r_ent ((au (ginsert i P I)) ∗ (ownI W i P))
                                   FRAME (big (ginsert i P I)) frame_to_big)
                               (properUPred_ent_trans
                                   (((au (ginsert i P I)) ∗ (ownI W i P)) ∗ (big (ginsert i P I)))
                                   (((au (ginsert i P I)) ∗ (big (ginsert i P I))) ∗ (ownI W i P))
                                   Goal
                                   -- (au∗ownI)∗big ⊢ (au∗big)∗ownI
                                   (properUPred_ent_trans
                                       (((au (ginsert i P I)) ∗ (ownI W i P)) ∗ (big (ginsert i P I)))
                                       ((au (ginsert i P I)) ∗ ((ownI W i P) ∗ (big (ginsert i P I))))
                                       (((au (ginsert i P I)) ∗ (big (ginsert i P I))) ∗ (ownI W i P))
                                       (sep_assoc_l_ent (au (ginsert i P I)) (ownI W i P) (big (ginsert i P I)))
                                       (properUPred_ent_trans
                                           ((au (ginsert i P I)) ∗ ((ownI W i P) ∗ (big (ginsert i P I))))
                                           ((au (ginsert i P I)) ∗ ((big (ginsert i P I)) ∗ (ownI W i P)))
                                           (((au (ginsert i P I)) ∗ (big (ginsert i P I))) ∗ (ownI W i P))
                                           (sep_mono_r_ent (au (ginsert i P I))
                                               ((ownI W i P) ∗ (big (ginsert i P I)))
                                               ((big (ginsert i P I)) ∗ (ownI W i P))
                                               (sep_comm_ent (ownI W i P) (big (ginsert i P I))))
                                           (sep_assoc_r_ent (au (ginsert i P I)) (big (ginsert i P I)) (ownI W i P))))
                                   -- (au∗big)∗ownI ⊢ Goal
                                   (properUPred_ent_trans
                                       (((au (ginsert i P I)) ∗ (big (ginsert i P I))) ∗ (ownI W i P))
                                       ((wsat W) ∗ (ownI W i P))
                                       Goal
                                       (sep_mono_l_ent ((au (ginsert i P I)) ∗ (big (ginsert i P I)))
                                           (wsat W) (ownI W i P)
                                           (exist_intro_ent (\lam J => (au J) ∗ (big J)) (ginsert i P I)))
                                       (properUPred_ent_trans ((wsat W) ∗ (ownI W i P))
                                           ((mkProperPure (phi i)) ∗ ((wsat W) ∗ (ownI W i P)))
                                           Goal
                                           (pure_intro_sep_ent (phi i) hphi ((wsat W) ∗ (ownI W i P)))
                                           (exist_intro_ent (\lam i' =>
                                               (mkProperPure (phi i')) ∗ ((wsat W) ∗ (ownI W i' P))) i))))
                       -- chain: au I ∗ FRAME ⊢ |==> Goal
                       | chain : ((au I) ∗ FRAME) ⊢ (|==> Goal) =>
                           alloc_frame_reshape {iResUR S} (au I) (au (ginsert i P I)) (ownI W i P) FRAME Goal
                               (ownI_auth_alloc W I i P hfresh) reshape
                       -- rearr: LHS ⊢ au I ∗ FRAME
                       | rearr : (((mkProperPure (psi_I i)) ∗ (ownD W (gset_singleton i))) ∗ Body) ⊢
                             ((au I) ∗ FRAME) =>
                           \let
                             | oD => ownD W (gset_singleton i)
                             | lp => |> P
                             | innerFrame : (oD ∗ ((big I) ∗ lp)) ⊢
                                   FRAME =>
                                 properUPred_ent_trans
                                     (oD ∗ ((big I) ∗ lp))
                                     (oD ∗ (lp ∗ (big I)))
                                     FRAME
                                     (sep_mono_r_ent oD ((big I) ∗ lp) (lp ∗ (big I))
                                         (sep_comm_ent (big I) lp))
                                     (properUPred_ent_trans
                                         (oD ∗ (lp ∗ (big I)))
                                         ((oD ∗ lp) ∗ (big I))
                                         FRAME
                                         (sep_assoc_r_ent oD lp (big I))
                                         (sep_mono_l_ent (oD ∗ lp) (lp ∗ oD) (big I)
                                             (sep_comm_ent oD lp)))
                           \in properUPred_ent_trans
                               (((mkProperPure (psi_I i)) ∗ oD) ∗ Body)
                               (oD ∗ Body)
                               ((au I) ∗ FRAME)
                               (sep_mono_l_ent ((mkProperPure (psi_I i)) ∗ oD) oD Body
                                   (sep_elim_r_ent (mkProperPure (psi_I i)) oD))
                               (properUPred_ent_trans
                                   (oD ∗ Body)
                                   (oD ∗ ((au I) ∗ ((big I) ∗ lp)))
                                   ((au I) ∗ FRAME)
                                   (sep_mono_r_ent oD Body ((au I) ∗ ((big I) ∗ lp))
                                       (sep_assoc_l_ent (au I) (big I) lp))
                                   (properUPred_ent_trans
                                       (oD ∗ ((au I) ∗ ((big I) ∗ lp)))
                                       ((au I) ∗ (oD ∗ ((big I) ∗ lp)))
                                       ((au I) ∗ FRAME)
                                       (sep_swap_ent oD (au I) ((big I) ∗ lp))
                                       (sep_mono_r_ent (au I) (oD ∗ ((big I) ∗ lp)) FRAME
                                           innerFrame)))
                     \in chain n x hv (rearr n x hv hs)
             \in bupd_alloc_frame_then {iResUR S} AiExist Body Goal
                 (ownD_alloc_fresh W psi_I oracle_I)
                 (sep_exist_l_elim (\lam i => (mkProperPure (psi_I i)) ∗ (ownD W (gset_singleton i)))
                     Body (|==> Goal) perI_i)
     \in sep_exist_l_elim (\lam I => (au I) ∗ (big I)) (|> P)
         (|==> Goal) perI

-- =================================================================================
-- ownI_alloc_open (Rocq: `ownI_alloc_open`):
--   (∀ E, ∃ i, i ∉ E ∧ φ i) →
--   wsat ==∗ ∃ i, ⌜φ i⌝ ∗ (ownE {i} -∗ wsat) ∗ ownI i P ∗ ownD {i}
-- Like `ownI_alloc`, but the fresh invariant is registered "open": the disabled
-- marker goes to the caller, and `wsat` is only recovered once `ownE {i}` is
-- returned (the new map entry is the `ownE {i}` disjunct).
-- =================================================================================

\lemma ownI_alloc_open {S : gFunctors} (W : wsatGS S) (phi : gname -> \Prop) (P : iProp S)
    (Hfresh : \Pi (E : Gset) -> TruncP (\Sigma (i : gname) (plookup E i = nothing) (phi i)))
  : (wsat W) ⊢
      (|==> (mkProperExist gname (\lam i =>
          (mkProperPure (phi i)) ∗
              (((ownE W (coPset_singleton i)) -∗ (wsat W)) ∗
                  ((ownI W i P) ∗ (ownD W (gset_singleton i)))))))
  => \let
       | M => iResUR S
       | au : Gmap gname gnameCountable (iProp S) -> ProperUPred (iResUR S) =>
           \lam J => own W.wsatGpreS_inv W.invariant_name
               (wsat_inv_auth (DfracOwn qp_one) (invariant_unfold_map J))
       | big : Gmap gname gnameCountable (iProp S) -> ProperUPred (iResUR S) =>
           \lam J => big_sepM J (wsat_entry W)
       | Goal : ProperUPred (iResUR S) => mkProperExist gname (\lam i =>
           (mkProperPure (phi i)) ∗
               (((ownE W (coPset_singleton i)) -∗ (wsat W)) ∗
                   ((ownI W i P) ∗ (ownD W (gset_singleton i)))))
       | perI : \Pi (I : Gmap gname gnameCountable (iProp S)) ->
             ((au I) ∗ (big I)) ⊢ (|==> Goal) =>
           \lam I =>
             \let
               | psi_I : gname -> \Prop => \lam i => \Sigma (glookup I i = nothing) (phi i)
               | oracle_I : \Pi (X : Gset) -> TruncP (\Sigma (i : gname) (plookup X i = nothing) (psi_I i)) =>
                   \lam X => \case Hfresh (gset_union X (gmap_dom_gset I)) \with {
                     | inP (i, hfr, hphi) =>
                       \let
                         | hun : gset_union_fn (plookup X i) (plookup (gmap_dom_gset I) i) = nothing =>
                             inv (plookup_gset_union X (gmap_dom_gset I) i) *> hfr
                         | (hX, hdom) => gset_union_fn_nothing_inv
                             (plookup X i) (plookup (gmap_dom_gset I) i) hun
                       \in inP (i, hX, (glookup_nothing_of_dom I i hdom, hphi))
                   }
               | AiExist : ProperUPred (iResUR S) => mkProperExist gname (\lam i =>
                   (mkProperPure (psi_I i)) ∗ (ownD W (gset_singleton i)))
               | Body : ProperUPred (iResUR S) => (au I) ∗ (big I)
               | perI_i : \Pi (i : gname) ->
                     (((mkProperPure (psi_I i)) ∗ (ownD W (gset_singleton i))) ∗ Body) ⊢
                         (|==> Goal) =>
                   \lam i => \lam n x hv hs =>
                     \let
                       | hfresh : glookup I i = nothing => \case hs \with {
                           | inP (aPD, _, _, hPD, _) => \case hPD \with {
                             | inP (_, _, _, hpu, _) => hpu.1 } }
                       | hphi : phi i => \case hs \with {
                           | inP (aPD, _, _, hPD, _) => \case hPD \with {
                             | inP (_, _, _, hpu, _) => hpu.2 } }
                       | oD => ownD W (gset_singleton i)
                       | oE => ownE W (coPset_singleton i)
                       -- The wand `oE -∗ wsat W`, from `au(ins) ∗ big I`.
                       | wand_body : ((au (ginsert i P I)) ∗ (big I)) ⊢
                             (oE -∗ (wsat W)) =>
                           wand_intro_ent ((au (ginsert i P I)) ∗ (big I)) oE (wsat W)
                               (\let
                                  | to_big_ins : (oE ∗ (big I)) ⊢ (big (ginsert i P I)) =>
                                      properUPred_ent_trans (oE ∗ (big I))
                                          ((wsat_entry W i P) ∗ (big I)) (big (ginsert i P I))
                                          (sep_mono_l_ent oE (wsat_entry W i P) (big I)
                                              (or_intro_r_ent ((|> P) ∗ oD) oE))
                                          (big_sepM_insert I (wsat_entry W) i P hfresh).2
                                \in properUPred_ent_trans
                                    (((au (ginsert i P I)) ∗ (big I)) ∗ oE)
                                    ((au (ginsert i P I)) ∗ (big (ginsert i P I)))
                                    (wsat W)
                                    (properUPred_ent_trans
                                        (((au (ginsert i P I)) ∗ (big I)) ∗ oE)
                                        ((au (ginsert i P I)) ∗ ((big I) ∗ oE))
                                        ((au (ginsert i P I)) ∗ (big (ginsert i P I)))
                                        (sep_assoc_l_ent (au (ginsert i P I)) (big I) oE)
                                        (sep_mono_r_ent (au (ginsert i P I)) ((big I) ∗ oE)
                                            (big (ginsert i P I))
                                            (properUPred_ent_trans ((big I) ∗ oE)
                                                (oE ∗ (big I)) (big (ginsert i P I))
                                                (sep_comm_ent (big I) oE) to_big_ins)))
                                    (exist_intro_ent (\lam J => (au J) ∗ (big J)) (ginsert i P I)))
                       -- reshape: (au(ins) ∗ ownI) ∗ FRAME ⊢ Goal, FRAME = oD ∗ big I
                       | FRAME : ProperUPred (iResUR S) => oD ∗ (big I)
                       | reshape : (((au (ginsert i P I)) ∗ (ownI W i P)) ∗ FRAME) ⊢ Goal =>
                           \let
                             -- (au(ins) ∗ ownI) ∗ (oD ∗ big I) ⊢ (au(ins) ∗ big I) ∗ (ownI ∗ oD)
                             | regroup : (((au (ginsert i P I)) ∗ (ownI W i P)) ∗ FRAME) ⊢
                                   (((au (ginsert i P I)) ∗ (big I)) ∗
                                                ((ownI W i P) ∗ oD)) =>
                                 \lam n1 x1 hv1 h1 => \case h1 \with {
                                   | inP (aHead, aFr, dx1, hHead, hFr) => \case hHead \with {
                                     | inP (aAu, aOI, dHead, hAu, hOI) => \case hFr \with {
                                       | inP (aD, aB, dFr, hD, hB) =>
                                         inP (M.op aAu aB, M.op aOI aD,
                                              -- x1 ≡ (aAu·aOI)·(aD·aB) ≡ (aAu·aB)·(aOI·aD)
                                              M.ofe_dist_trans n1 x1
                                                  (M.op (M.op aAu aOI) (M.op aD aB))
                                                  (M.op (M.op aAu aB) (M.op aOI aD))
                                                  (M.ofe_dist_trans n1 x1 (M.op aHead aFr) (M.op (M.op aAu aOI) (M.op aD aB))
                                                      dx1
                                                      (cmra_op_ne_both n1 aHead (M.op aAu aOI) aFr (M.op aD aB) dHead dFr))
                                                  (op_regroup_swap {M} n1 aAu aOI aD aB),
                                              inP (aAu, aB, M.ofe_dist_refl n1 (M.op aAu aB), hAu, hB),
                                              inP (aOI, aD, M.ofe_dist_refl n1 (M.op aOI aD), hOI, hD))
                                     }
                                   }
                                 }
                           \in properUPred_ent_trans
                               (((au (ginsert i P I)) ∗ (ownI W i P)) ∗ FRAME)
                               (((au (ginsert i P I)) ∗ (big I)) ∗
                                            ((ownI W i P) ∗ oD))
                               Goal
                               regroup
                               (properUPred_ent_trans
                                   (((au (ginsert i P I)) ∗ (big I)) ∗
                                                ((ownI W i P) ∗ oD))
                                   ((oE -∗ (wsat W)) ∗ ((ownI W i P) ∗ oD))
                                   Goal
                                   (sep_mono_l_ent ((au (ginsert i P I)) ∗ (big I))
                                       (oE -∗ (wsat W)) ((ownI W i P) ∗ oD) wand_body)
                                   (properUPred_ent_trans
                                       ((oE -∗ (wsat W)) ∗ ((ownI W i P) ∗ oD))
                                       ((mkProperPure (phi i)) ∗
                                           ((oE -∗ (wsat W)) ∗ ((ownI W i P) ∗ oD)))
                                       Goal
                                       (pure_intro_sep_ent (phi i) hphi
                                           ((oE -∗ (wsat W)) ∗ ((ownI W i P) ∗ oD)))
                                       (exist_intro_ent (\lam i' =>
                                           (mkProperPure (phi i')) ∗
                                               (((ownE W (coPset_singleton i')) -∗ (wsat W)) ∗
                                                   ((ownI W i' P) ∗ (ownD W (gset_singleton i'))))) i)))
                       | chain : ((au I) ∗ FRAME) ⊢ (|==> Goal) =>
                           alloc_frame_reshape {iResUR S} (au I) (au (ginsert i P I)) (ownI W i P) FRAME Goal
                               (ownI_auth_alloc W I i P hfresh) reshape
                       -- rearr: ((pure ∗ oD) ∗ (au ∗ big)) ⊢ au ∗ (oD ∗ big) = au ∗ FRAME
                       | rearr : (((mkProperPure (psi_I i)) ∗ oD) ∗ Body) ⊢
                             ((au I) ∗ FRAME) =>
                           properUPred_ent_trans
                               (((mkProperPure (psi_I i)) ∗ oD) ∗ Body)
                               (oD ∗ Body)
                               ((au I) ∗ FRAME)
                               (sep_mono_l_ent ((mkProperPure (psi_I i)) ∗ oD) oD Body
                                   (sep_elim_r_ent (mkProperPure (psi_I i)) oD))
                               (sep_swap_ent oD (au I) (big I))
                     \in chain n x hv (rearr n x hv hs)
             \in bupd_alloc_frame_then {iResUR S} AiExist Body Goal
                 (ownD_alloc_fresh W psi_I oracle_I)
                 (sep_exist_l_elim (\lam i => (mkProperPure (psi_I i)) ∗ (ownD W (gset_singleton i)))
                     Body (|==> Goal) perI_i)
     \in exist_elim_ent (\lam I => (au I) ∗ (big I)) (|==> Goal) perI
