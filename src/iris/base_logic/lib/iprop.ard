\import Paths
\import Data.Maybe
\import iris.algebra.ofe
\import iris.algebra.cmra
\import iris.base_logic.upred
\import iris.algebra.cofe_solver
\import iris.base_logic.lib.gfunctors
\import iris.algebra.gmap
\import iris.algebra.gmap_functor
\import iris.algebra.functions
\import stdpp.pmap (Pos, Pos_eq_dec)

-- =================================================================================
-- Plan A, §A4: the recursive definition of `iProp`.
--
-- Faithful port of Rocq `base_logic/lib/iprop.v` (solution section).  We solve
--
--   iProp Σ ≈ uPred (∀ i : gid Σ. gname →fin (Σ i) (iProp Σ))
--
-- by applying the cofe_solver to the locally contractive bifunctor
-- `uPredOF (iResF Σ)`, where
--
--   iResF Σ := discrete_funURF (λ i. gmapURF gname (Σ i)).
--
-- Rocq seals the construction behind the module type `iProp_solution_sig`;
-- Arend has no module sealing, so downstream files should only use
-- `iPrePropO` / `iResUR` / `iProp(O)` / `iProp_unfold` / `iProp_fold` and the
-- two round-trip laws below, never the raw solver internals.
-- =================================================================================

-- `gname = Pos` is countable via the identity encoding.
\instance gnameCountable : Countable Pos
  | decideEq => Pos_eq_dec
  | encode => \lam p => p
  | decode => just
  | decode_encode => \lam _ => idp
  | encode_inj => \lam _ _ h => h

-- =================================================================================
-- The resources functor `iResF Σ A := ∀ i : gid Σ. gname →fin (Σ i) A`.
-- =================================================================================

\func iResF (S : gFunctors) : URFunctor =>
  discrete_funURF (\lam (i : gid S) =>
      gmapURF gname gnameCountable (S.gFunctors_lookup i).gFunctor_F)

\func iResF_contractive (S : gFunctors) : URFunctorContractive (iResF S) =>
  discrete_funURF_contractive
      (\lam (i : gid S) =>
          gmapURF gname gnameCountable (S.gFunctors_lookup i).gFunctor_F)
      (\lam i => gmapURF_contractive gname gnameCountable
          (S.gFunctors_lookup i).gFunctor_F
          (S.gFunctors_lookup i).gFunctor_map_contractive)

-- =================================================================================
-- The solver-facing instances for `uPredOF F`.
-- =================================================================================

\func uPredOF_applyCOFE (F : URFunctor) : OFunctorApplyCOFE (uPredOF F) \cowith
  | oFunctor_apply_compl => \lam A => (UPredCOFE (F.urFunctor_car A A)).compl
  | oFunctor_apply_conv_compl => \lam A =>
      (UPredCOFE (F.urFunctor_car A A)).cofe_conv_compl

\func uPredOF_inhabited (F : URFunctor)
  : Inhabited ((uPredOF F).oFunctor_car UnitCOFE UnitCOFE).E \cowith
  | default => mkProperPure (\Sigma)

-- =================================================================================
-- The solution `iPrePropO Σ ≅ uPredO (iResUR Σ)` (Rocq `iProp_result`).
-- =================================================================================

-- `\sfunc` seals the solver application: without it, every use of
-- `iProp_unfold`/`iProp_fold` lets conversion checking unfold `solver_result`
-- into the full tower construction, which does not terminate in practice.
-- This is the Arend counterpart of Rocq's opaque `iProp_solution_sig` module.
\sfunc iProp_result (S : gFunctors) : Solution (uPredOF (iResF S)) =>
  solver_result (uPredOF (iResF S))
      (uPredOF_applyCOFE (iResF S))
      (uPredOF_contractive (iResF S) (iResF_contractive S))
      (uPredOF_inhabited (iResF S))

\func iPrePropO (S : gFunctors) : COFE => (iProp_result S).solution_car

-- `iResUR Σ := ∀ i : gid Σ. gname →fin (Σ i) (iPrePropO Σ)`.
--
-- Rocq spells this out as `discrete_funUR (λ i, gmapUR gname (rFunctor_apply
-- (Σ i) (iPrePropO Σ)))`; we keep it in functor-application form instead.  The
-- two are definitionally equal by unfolding `urFunctor_apply` /
-- `discrete_funURF` / `gmapURF`, but the spelled-out form makes every use of
-- `iProp_unfold`/`iProp_fold` compare the solver's carrier against a freshly
-- built `DiscreteFunUCMRA` instance field-by-field, which sends the
-- typechecker into a normalization blow-up (>45 min).  In this form the
-- comparison is a couple of delta steps.
\func iResUR (S : gFunctors) : UCMRA =>
  urFunctor_apply (iResF S) (iPrePropO S)

\func iProp (S : gFunctors) : \Set => ProperUPred (iResUR S)

\func iPropO (S : gFunctors) : OFE => UPredOFE (iResUR S)

\func iPropCOFE (S : gFunctors) : COFE => UPredCOFE (iResUR S)

-- =================================================================================
-- Folding and unfolding, plus the two round-trip laws used everywhere in A5+.
-- =================================================================================

\func iProp_unfold {S : gFunctors} : OFEMor (iPropO S) (iPrePropO S) =>
  (iProp_result S).solution_iso.ofe_iso_1

\func iProp_fold {S : gFunctors} : OFEMor (iPrePropO S) (iPropO S) =>
  (iProp_result S).solution_iso.ofe_iso_2

\lemma iProp_fold_unfold {S : gFunctors} (P : iProp S)
  : (iPropO S).equiv
      ((iProp_fold {S}).ofe_mor_car ((iProp_unfold {S}).ofe_mor_car P))
      P
  => (iProp_result S).solution_iso.ofe_iso_21 P

\lemma iProp_unfold_fold {S : gFunctors} (P : (iPrePropO S).E)
  : (iPrePropO S).equiv
      ((iProp_unfold {S}).ofe_mor_car ((iProp_fold {S}).ofe_mor_car P))
      P
  => (iProp_result S).solution_iso.ofe_iso_12 P
