\import Logic
\import Paths
\import Data.Maybe
\import Arith.Rat
\import Algebra.StrictlyOrdered
\import iris.algebra.ofe
\import iris.algebra.cmra
\import iris.algebra.frac
\import iris.algebra.dfrac
\import iris.algebra.prod
\import iris.algebra.option
\import iris.algebra.excl
\import iris.algebra.auth
\import iris.algebra.lib.gmap_view

-- Authoritative ghost state whose fragments carry positive fractions.  This
-- follows Iris's auth/option/product representation; the public fragment API
-- uses owned fractions only.

\func frac_auth_baseUR (A : CMRA) : UCMRA =>
  OptionUCMRA (ProdCMRA DfracCMRA A)

\func frac_authR (A : CMRA) : CMRA =>
  AuthCMRA (frac_auth_baseUR A)

\func frac_authUR (A : CMRA) : UCMRA =>
  AuthUCMRA (frac_auth_baseUR A)

\func frac_auth_auth {A : CMRA} (a : A.E) : (frac_authR A).E =>
  (just (excl (just (DfracOwn qp_one, a))), nothing)

\func frac_auth_frag {A : CMRA} (q : Qp) (a : A.E) : (frac_authR A).E =>
  (nothing, just (DfracOwn q, a))

\lemma frac_auth_frag_discrete {A : CMRA} (q : Qp) (a : A.E)
    (ha : Discrete {A} a) :
  Discrete {frac_authR A} (frac_auth_frag q a) =>
  prod_discrete nothing (just (DfracOwn q, a))
    exclU_nothing_discrete
    (option_just_discrete (DfracOwn q, a)
      (prod_discrete (DfracOwn q) a
        (discreteOFE_discrete Dfrac (DfracOwn q)) ha))

\lemma frac_auth_frag_proper {A : CMRA} (q : Qp) (a b : A.E)
    (h : A.equiv a b) :
  (frac_authR A).equiv (frac_auth_frag q a) (frac_auth_frag q b) =>
  ((ExclUOFE (frac_auth_baseUR A)).equiv_refl nothing,
    ((DfracCMRA.equiv_refl (DfracOwn q)), h))

\lemma frac_auth_frag_op {A : CMRA} (q1 q2 : Qp) (a1 a2 : A.E) :
  (frac_authR A).equiv
    (frac_auth_frag (qp_add q1 q2) (A.op a1 a2))
    ((frac_authR A).op (frac_auth_frag q1 a1) (frac_auth_frag q2 a2)) =>
  ((ExclUOFE (frac_auth_baseUR A)).equiv_refl nothing,
    ((DfracCMRA.equiv_refl (DfracOwn (qp_add q1 q2))),
      A.equiv_refl (A.op a1 a2)))

\lemma frac_auth_frag_op_core_id {A : CMRA} (q1 q2 : Qp) (a : A.E)
    (hdup : A.equiv (A.op a a) a) :
  (frac_authR A).equiv
    (frac_auth_frag (qp_add q1 q2) a)
    ((frac_authR A).op (frac_auth_frag q1 a) (frac_auth_frag q2 a)) =>
  (frac_authR A).equiv_trans
    (frac_auth_frag (qp_add q1 q2) a)
    (frac_auth_frag (qp_add q1 q2) (A.op a a))
    ((frac_authR A).op (frac_auth_frag q1 a) (frac_auth_frag q2 a))
    ((frac_authR A).equiv_sym
      (frac_auth_frag (qp_add q1 q2) (A.op a a))
      (frac_auth_frag (qp_add q1 q2) a)
      (frac_auth_frag_proper (qp_add q1 q2) (A.op a a) a hdup))
    (frac_auth_frag_op q1 q2 a a)

\lemma frac_auth_validN {A : CMRA} (step : Nat) (a : A.E)
    (ha : A.validN step a) :
  (frac_authR A).validN step
    ((frac_authR A).op (frac_auth_auth a) (frac_auth_frag qp_one a)) =>
  ((RatField.<=-refl, ha),
    inclN_refl_ucmra {frac_auth_baseUR A} step
      (just (DfracOwn qp_one, a)))

\lemma frac_auth_valid {A : CMRA} (a : A.E) (ha : A.valid a) :
  (frac_authR A).valid
    ((frac_authR A).op (frac_auth_auth a) (frac_auth_frag qp_one a)) =>
  \lam step => frac_auth_validN step a ((A.cmra_valid_validN a).1 ha step)

\lemma frac_auth_agreeN {A : CMRA} (step : Nat) (a b : A.E)
    (h : (frac_authR A).validN step
      ((frac_authR A).op (frac_auth_auth a) (frac_auth_frag qp_one b))) :
  A.dist step a b =>
  (gmap_view_full_option_included_exact step
    (DfracOwn qp_one, a) b h.1 h.2).2

\lemma frac_auth_agree {A : CMRA} (a b : A.E)
    (h : (frac_authR A).valid
      ((frac_authR A).op (frac_auth_auth a) (frac_auth_frag qp_one b))) :
  A.equiv a b =>
  (A.ofe_equiv_dist a b).2 (\lam step => frac_auth_agreeN step a b (h step))

\func frac_auth_update_1_valid {A : CMRA} (a b a' : A.E)
    (ha' : A.valid a') (step : Nat)
    (frameAuth : Maybe (Excl (frac_auth_baseUR A).E))
    (frameFrag : (frac_auth_baseUR A).E)
    (hv : (frac_authR A).validN step
      ((frac_authR A).op
        ((frac_authR A).op (frac_auth_auth a) (frac_auth_frag qp_one b))
        (frameAuth, frameFrag))) :
  (frac_authR A).validN step
    ((frac_authR A).op
      ((frac_authR A).op (frac_auth_auth a') (frac_auth_frag qp_one a'))
      (frameAuth, frameFrag)) \elim frameAuth, frameFrag
  | just _, _ => \case hv \with {}
  | nothing, nothing =>
      ((RatField.<=-refl,
        (A.cmra_valid_validN a').1 ha' step),
       inclN_refl_ucmra {frac_auth_baseUR A} step
         (just (DfracOwn qp_one, a')))
  | nothing, just z =>
      \let combinedValid :
          (ProdCMRA DfracCMRA A).validN step
            ((ProdCMRA DfracCMRA A).op (DfracOwn qp_one, b) z) =>
        cmra_validN_includedN {frac_auth_baseUR A} step
          (just ((ProdCMRA DfracCMRA A).op (DfracOwn qp_one, b) z))
          (just (DfracOwn qp_one, a)) hv.1 hv.2
      \in \case dfrac_full_exclusive z.1 combinedValid.1 \with {}

\lemma frac_auth_update_1 {A : CMRA} (a b a' : A.E) (ha' : A.valid a') :
  cmra_updateP {frac_authUR A}
    ((frac_authR A).op (frac_auth_auth a) (frac_auth_frag qp_one b))
    (\lam y => y =
      (frac_authR A).op (frac_auth_auth a') (frac_auth_frag qp_one a')) =>
  \lam step frame hv =>
    inP ((frac_authR A).op (frac_auth_auth a') (frac_auth_frag qp_one a'),
      idp,
      frac_auth_update_1_valid a b a' ha' step frame.1 frame.2 hv)
