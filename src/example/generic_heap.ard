\import uPred
\import iprop
\import lang
\import weakestpre
\import lifting
\import hoare
\import lib.coPset
\import lib.gFunctors
\import lib.gmap_cmra
\import lib.gen_heap

-- A closed, binder-free heap-language client of the canonical generic stack.
-- It deliberately avoids `String` and therefore remains a useful A12 smoke
-- example while named-variable substitution is deferred.
\func alloc_unit_program : Expr => Alloc (Val (LitV LitUnit))

\lemma alloc_unit_wp {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
  : properUPred_ent mkProperEmp
      (wp H E alloc_unit_program
        (\lam w => mkProperExist Loc (\lam l =>
          mkProperAnd (mkProperPure (w = LitV (LitLoc l)))
            (pointsto_full H.iris_gen_heap l (LitV LitUnit))))) =>
  wp_alloc H E (LitV LitUnit)

\lemma alloc_unit_hoare {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
  : properUPred_ent mkProperEmp
      (ht H E mkProperEmp alloc_unit_program
        (\lam w => mkProperExist Loc (\lam l =>
          mkProperAnd (mkProperPure (w = LitV (LitLoc l)))
            (pointsto_full H.iris_gen_heap l (LitV LitUnit))))) =>
  ht_alloc H E (LitV LitUnit)
