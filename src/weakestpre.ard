-- wp_alloc: True  ⊢  wp (Alloc v) (\v'. ∃ l. v' = LitLoc l ∧ l ↦ v)
\lemma wp_alloc
  {cnt : Countable Loc}
  (v   : Value)
  : properUPred_ent {HeapCMRA Loc cnt Value}
    (mkProperPure (\Sigma))
    (wp (Alloc (Val v))
        (\lam v' => mkProperExist Loc (\lam l =>
            mkProperAnd
                (mkProperPure (v' = LitV (LitLoc l)))
                (pointsTo l v))))
  => {?}

\lemma sep_exist_l
  {cnt : Countable Loc}
  (T : \Type) (Phi : T -> ProperUPred (HeapCMRA Loc cnt Value))
  (R : ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent
    (mkProperSep (mkProperExist T Phi) R)
    (mkProperExist T (\lam t => mkProperSep (Phi t) R))
  => \lam n a hv hsep =>
      \case hsep \with {
        | inP (a1, a2, dist_a, hexist, hR) =>
          \case hexist \with {
            | inP (t, hPhi) => inP (t, inP (a1, a2, dist_a, hPhi, hR))
          }
      }


\func wp_bind_mul_l
  {cnt : Countable Loc}
  (e1 e2 : Expr)
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent {HeapCMRA Loc cnt Value}
    (wp e1 (\lam v => wp (Mul (Val v) e2) Phi))
    (wp (Mul e1 e2) Phi)
  => {?}

\func wp_bind_mul_r
  {cnt : Countable Loc}
  (v1 : Value)
  (e2 : Expr)
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent {HeapCMRA Loc cnt Value}
    (wp e2 (\lam v => wp (Mul (Val v1) (Val v)) Phi))
    (wp (Mul (Val v1) e2) Phi)
  => {?}

\lemma exist_intro_ent
  {cnt : Countable Loc}
  (T : \Type) (Phi : T -> ProperUPred (HeapCMRA Loc cnt Value))
  (t : T)
  : properUPred_ent (Phi t) (mkProperExist T Phi)
  => \lam n a hv hp => inP (t, hp)

\lemma exist_elim_ent
  {cnt : Countable Loc}
  (T : \Type)
  (Phi : T -> ProperUPred (HeapCMRA Loc cnt Value))
  (Q : ProperUPred (HeapCMRA Loc cnt Value))
  (h : \Pi (t : T) -> properUPred_ent (Phi t) Q)
  : properUPred_ent (mkProperExist T Phi) Q
  => \lam n a hv hp =>
      \case hp \with { | inP (t, ht') => h t n a hv ht' }

\lemma true_sep_drop
  {cnt : Countable Loc}
  (P : ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent (mkProperSep (mkProperPure (\Sigma)) P) P
  => \lam n a hv hsep =>
      \case hsep \with {
        | inP (a1, a2, dist_a, _, hP) =>
          \let M => HeapCMRA Loc cnt Value
          \in P.upred_mono n n a2 a hP
              (inP (a1,
                    M.ofe_dist_trans n a (M.op a1 a2) (M.op a2 a1)
                        dist_a
                        (transport (\lam w => M.dist n (M.op a1 a2) w)
                            (M.cmra_comm a1 a2)
                            (M.ofe_dist_refl n (M.op a1 a2)))))
              <=-refl
      }

\lemma wp_rec
  {cnt : Countable Loc}
  (f x : String) (body : Expr)
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent (Phi (RecV f x body)) (wp (Rec f x body) Phi)
  => properUPred_ent_trans
      (Phi (RecV f x body))
      (wp (Val (RecV f x body)) Phi)
      (wp (Rec f x body) Phi)
      (wp_value_intro (RecV f x body) Phi)
      (wp_pure_step
          (Rec f x body)
          (Val (RecV f x body))
          (\lam s => RecS f x body idp idp idp) idp Phi)

\lemma wp_iszero_zero
  {cnt : Countable Loc}
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent (Phi (LitV (LitBool true)))
    (wp (IsZero (Val (natV 0))) Phi)
  => properUPred_ent_trans
      (Phi (LitV (LitBool true)))
      (wp (Val (LitV (LitBool true))) Phi)
      (wp (IsZero (Val (natV 0))) Phi)
      (wp_value_intro (LitV (LitBool true)) Phi)
      (wp_pure_step
          (IsZero (Val (natV 0)))
          (Val (LitV (LitBool true)))
          (\lam s => IsZeroZeroS idp idp idp) idp Phi)

\lemma wp_iszero_suc {cnt : Countable Loc} (n : Nat)
                     (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent (Phi (LitV (LitBool false)))
    (wp (IsZero (Val (natV (suc n)))) Phi)
  => properUPred_ent_trans
      (Phi (LitV (LitBool false)))
      (wp (Val (LitV (LitBool false))) Phi)
      (wp (IsZero (Val (natV (suc n)))) Phi)
      (wp_value_intro (LitV (LitBool false)) Phi)
      (wp_pure_step
          (IsZero (Val (natV (suc n))))
          (Val (LitV (LitBool false)))
          (\lam s => IsZeroPosS n idp idp idp) idp Phi)

\lemma wp_pred_suc {cnt : Countable Loc} (n : Nat)
                   (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent (Phi (natV n)) (wp (Pred (Val (natV (suc n)))) Phi)
  => properUPred_ent_trans
      (Phi (natV n))
      (wp (Val (natV n)) Phi)
      (wp (Pred (Val (natV (suc n)))) Phi)
      (wp_value_intro (natV n) Phi)
      (wp_pure_step
          (Pred (Val (natV (suc n))))
          (Val (natV n))
          (\lam s => PredS n idp idp idp) idp Phi)

\lemma wp_mul {cnt : Countable Loc} (a b : Nat)
              (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent (Phi (natV (a Nat.* b)))
    (wp (Mul (Val (natV a)) (Val (natV b))) Phi)
  => properUPred_ent_trans

      (Phi (natV (a Nat.* b)))
      (wp (Val (natV (a Nat.* b))) Phi)
      (wp (Mul (Val (natV a)) (Val (natV b))) Phi)
      (wp_value_intro (natV (a Nat.* b)) Phi)
      (wp_pure_step
          (Mul (Val (natV a)) (Val (natV b)))
          (Val (natV (a Nat.* b)))
          (\lam s => MulS a b idp idp idp) idp Phi)