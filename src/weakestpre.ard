-- =================================================================================
-- Helper Functions
-- =================================================================================


\func big_sep_list {B : BIMixin} (l : List Value) (Phi : Value -> B.E) : B.E \elim l
  | nil => emp
  | v :: l' => Phi v * big_sep_list l' Phi


-- =================================================================================
-- Heap Ownership for Simplified WP
-- =================================================================================


\func heap_state_to_gmap {cnt : Countable Loc} (s : State cnt)
  : Gmap Loc cnt (Maybe (Excl Value)) =>
  \new Gmap Loc cnt (Maybe (Excl Value)) {
    | gtree => pomap (\lam p => just (p.1, just (excl p.2))) s.heap.gtree
    | gtree_wf => heap_state_to_gmap_wf s
  }
  \where {
    \func tag (p : \Sigma Loc Value) : Maybe (\Sigma Loc (Maybe (Excl Value))) =>
      just (p.1, just (excl p.2))

    \func heap_state_to_gmap_wf
      {cnt : Countable Loc} (s : State cnt)
      : gmap_wf {Loc} {cnt} {Maybe (Excl Value)}
        (\new Pmap (\Sigma Loc (Maybe (Excl Value))) {
          | tree => (pomap tag s.heap.gtree).tree
          | tree_wf => (pomap tag s.heap.gtree).tree_wf
        })
      => \lam q p hp =>
          \let
            | step : pomap_tree.option_bind tag (plookup s.heap.gtree q) = just p
            => inv (plookup_pomap tag s.heap.gtree q) *> hp
          \in
            \case plookup s.heap.gtree q \as o,
                  idp : plookup s.heap.gtree q = o,
                  step : pomap_tree.option_bind tag o = just p
            \return encode {cnt} p.1 = q
            \with {
              | nothing, _, e => \case e \with {}
              | just pp, hpp, e =>
                -- e : just (pp.1, just (excl pp.2)) = just p, so p.1 = pp.1.
                \let
                  | hp1 : p.1 = pp.1 =>
                    inv (pmap (\lam mp => \case mp \with {
                      | nothing => pp.1
                      | just q' => q'.1
                    }) e)
                \in transport (\lam k' => encode {cnt} k' = q)
                    (inv hp1) (s.heap.gtree_wf q pp hpp)
            }
  }

\lemma heap_state_to_gmap_validN
  {cnt : Countable Loc}
  (n : Nat) (sigma : State cnt)
  : (GmapUCMRA Loc cnt (ExclUCMRA (DiscreteOFE Value))).validN n
    (heap_state_to_gmap sigma)
  => \lam i =>
      \let
        | g => heap_state_to_gmap sigma
        | step : plookup g.gtree (encode {cnt} i)
          = pomap_tree.option_bind heap_state_to_gmap.tag (plookup sigma.heap.gtree (encode {cnt} i))
        => plookup_pomap heap_state_to_gmap.tag sigma.heap.gtree (encode {cnt} i)
      \in
        \case plookup sigma.heap.gtree (encode {cnt} i) \as p,
              idp : plookup sigma.heap.gtree (encode {cnt} i) = p
        \return option_validN {ExclUCMRA (DiscreteOFE Value)} n (glookup g i)
        \with {
          | nothing, hp =>
            \let
              | glk_eq : plookup g.gtree (encode {cnt} i) = nothing
              => step *> pmap (pomap_tree.option_bind heap_state_to_gmap.tag) hp
            \in transport (\lam o => option_validN {ExclUCMRA (DiscreteOFE Value)} n
                (\case o \with { | nothing => nothing | just p => just p.2 }))
                (inv glk_eq) ()
          | just pp, hp =>
            \let
              | glk_eq : plookup g.gtree (encode {cnt} i)
                = just (pp.1, just (excl pp.2))
              => step *> pmap (pomap_tree.option_bind heap_state_to_gmap.tag) hp
            \in transport (\lam o => option_validN {ExclUCMRA (DiscreteOFE Value)} n
                (\case o \with { | nothing => nothing | just p => just p.2 }))
                (inv glk_eq) ()
        }

\func own_heap_auth {cnt : Countable Loc} (s : State cnt)
  : ProperUPred (HeapCMRA Loc cnt Value) \cowith
  | upred_holds => \lam n a =>
      inclN {HeapCMRA Loc cnt Value}
          {\new Op (HeapCMRA Loc cnt Value).E { | op => (HeapCMRA Loc cnt Value).op }}
          (heap_auth (heap_state_to_gmap s)) n a
  | upred_mono => \lam n1 n2 x1 x2 h_incl incl_x1_x2 n2_le_n1 =>
      heap_incl_trans n1 n2
          (heap_auth (heap_state_to_gmap s)) x1 x2
          h_incl incl_x1_x2 n2_le_n1


-- =================================================================================
-- WP Definition via Fixpoint
-- =================================================================================


\func wp_pre {cnt : Countable Loc}
             (wp   : Expr -> (Value -> ProperUPred (HeapCMRA Loc cnt Value)) -> ProperUPred (HeapCMRA Loc cnt Value))
             (e    : Expr)
             (Phi  : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : ProperUPred (HeapCMRA Loc cnt Value)
  => \case to_val e \with {
    | just v  => mkProperBUpd (Phi v)
    | nothing =>
      mkProperForall (State cnt) (\lam sigma =>
          mkProperWand
              (own_heap_auth sigma)
              (mkProperBUpd (
                mkProperAnd
                    (mkProperPure (Reducible e sigma))
                    (mkProperLater (
                      mkProperForall Expr (\lam e2 =>
                          mkProperForall (State cnt) (\lam sigma2 =>
                              mkProperImpl
                                  (mkProperPure (PrimStep e sigma e2 sigma2))
                                  (mkProperBUpd (
                                    mkProperSep
                                        (own_heap_auth sigma2)
                                        (wp e2 Phi)
                                  ))
                          ))
                    ))
              ))
      )
  }


-- =================================================================================
-- Contractivity of wp_pre
-- =================================================================================


\func WPFun {cnt : Countable Loc} : \Type =>
  Expr -> (Value -> ProperUPred (HeapCMRA Loc cnt Value)) -> ProperUPred (HeapCMRA Loc cnt Value)

\func WPFunDist {cnt : Countable Loc} (n : Nat) (f g : WPFun {cnt}) : \Prop =>
  \Pi (e : Expr) (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value)) ->
      upredDist n (f e Phi) (g e Phi)

\func ContractiveFun {cnt : Countable Loc} (F : WPFun {cnt} -> WPFun {cnt}) : \Prop =>
  \Pi (n : Nat) (f g : WPFun {cnt})
  -> (\Pi (k : Nat) -> k NatOrder.< n -> WPFunDist k f g)
  -> WPFunDist n (F f) (F g)

\lemma wp_pre_contractive
  {cnt : Countable Loc}
  : ContractiveFun wp_pre =>
  \lam n f g hdl e Phi =>
      \let
        | step_body_f (sigma : State cnt) : Expr -> ProperUPred (HeapCMRA Loc cnt Value) =>
          \lam e2 =>
              mkProperForall (State cnt) (\lam sigma2 =>
                  mkProperImpl (mkProperPure (PrimStep e sigma e2 sigma2))
                      (mkProperBUpd (mkProperSep (own_heap_auth sigma2) (f e2 Phi))))
        | step_body_g (sigma : State cnt) : Expr -> ProperUPred (HeapCMRA Loc cnt Value) =>
          \lam e2 =>
              mkProperForall (State cnt) (\lam sigma2 =>
                  mkProperImpl (mkProperPure (PrimStep e sigma e2 sigma2))
                      (mkProperBUpd (mkProperSep (own_heap_auth sigma2) (g e2 Phi))))
        | wand_body_f : State cnt -> ProperUPred (HeapCMRA Loc cnt Value) =>
          \lam sigma => mkProperWand (own_heap_auth sigma)
              (mkProperBUpd (mkProperAnd (mkProperPure (Reducible e sigma))
                  (mkProperLater (mkProperForall Expr (step_body_f sigma)))))
        | wand_body_g : State cnt -> ProperUPred (HeapCMRA Loc cnt Value) =>
          \lam sigma => mkProperWand (own_heap_auth sigma)
              (mkProperBUpd (mkProperAnd (mkProperPure (Reducible e sigma))
                  (mkProperLater (mkProperForall Expr (step_body_g sigma)))))
        | LHS_nothing : ProperUPred (HeapCMRA Loc cnt Value) =>
          mkProperForall (State cnt) wand_body_f
        | RHS_nothing : ProperUPred (HeapCMRA Loc cnt Value) =>
          mkProperForall (State cnt) wand_body_g
      \in
        \case to_val e \as tv
        \return upredDist n
            (\case tv \with { | just v => mkProperBUpd (Phi v) | nothing => LHS_nothing })
            (\case tv \with { | just v => mkProperBUpd (Phi v) | nothing => RHS_nothing })
        \with {
          | just _ =>
            \lam m a hm hv => (\lam h => h, \lam h => h)
          | nothing =>
            upredDist_forall {HeapCMRA Loc cnt Value} (State cnt) n wand_body_f wand_body_g
                (\lam sigma =>
                    \let body_dist : \Pi (k : Nat) -> k NatOrder.< n ->
                    upredDist {HeapCMRA Loc cnt Value} k
                        (mkProperForall Expr (step_body_f sigma))
                        (mkProperForall Expr (step_body_g sigma)) =>
                      \lam k hk =>
                          upredDist_forall {HeapCMRA Loc cnt Value} Expr k
                              (step_body_f sigma)
                              (step_body_g sigma)
                              (\lam e2 =>
                                  upredDist_forall {HeapCMRA Loc cnt Value} (State cnt) k
                                      (\lam sigma2 =>
                                          mkProperImpl (mkProperPure (PrimStep e sigma e2 sigma2))
                                              (mkProperBUpd (mkProperSep (own_heap_auth sigma2) (f e2 Phi))))
                                      (\lam sigma2 =>
                                          mkProperImpl (mkProperPure (PrimStep e sigma e2 sigma2))
                                              (mkProperBUpd (mkProperSep (own_heap_auth sigma2) (g e2 Phi))))
                                      (\lam sigma2 =>
                                          upredDist_impl_r {HeapCMRA Loc cnt Value} k
                                              (mkProperPure (PrimStep e sigma e2 sigma2))
                                              (mkProperBUpd (mkProperSep (own_heap_auth sigma2) (f e2 Phi)))
                                              (mkProperBUpd (mkProperSep (own_heap_auth sigma2) (g e2 Phi)))
                                              (bupd_ne k
                                                  (mkProperSep (own_heap_auth sigma2) (f e2 Phi))
                                                  (mkProperSep (own_heap_auth sigma2) (g e2 Phi))
                                                  (upredDist_sep_r {HeapCMRA Loc cnt Value} k (own_heap_auth sigma2)
                                                      (f e2 Phi) (g e2 Phi)
                                                      (hdl k hk e2 Phi)))))
                    \in upredDist_wand_r {HeapCMRA Loc cnt Value} n
                        (own_heap_auth sigma)
                        (mkProperBUpd (mkProperAnd (mkProperPure (Reducible e sigma))
                            (mkProperLater (mkProperForall Expr (step_body_f sigma)))))
                        (mkProperBUpd (mkProperAnd (mkProperPure (Reducible e sigma))
                            (mkProperLater (mkProperForall Expr (step_body_g sigma)))))
                        (bupd_ne n
                            (mkProperAnd (mkProperPure (Reducible e sigma))
                                (mkProperLater (mkProperForall Expr (step_body_f sigma))))
                            (mkProperAnd (mkProperPure (Reducible e sigma))
                                (mkProperLater (mkProperForall Expr (step_body_g sigma))))
                            (upredDist_and_r {HeapCMRA Loc cnt Value} n
                                (mkProperPure (Reducible e sigma))
                                (mkProperLater (mkProperForall Expr (step_body_f sigma)))
                                (mkProperLater (mkProperForall Expr (step_body_g sigma)))
                                (upredDist_later {HeapCMRA Loc cnt Value} n
                                    (mkProperForall Expr (step_body_f sigma))
                                    (mkProperForall Expr (step_body_g sigma))
                                    body_dist))))
        }

-- =================================================================================
-- WP Unfolding Lemma
-- =================================================================================


\func WPFunCOFE {cnt : Countable Loc} : COFE =>
  FunCOFE Expr
      (FunCOFE (Value -> ProperUPred (HeapCMRA Loc cnt Value))
          (UPredCOFE (HeapCMRA Loc cnt Value)))

\instance WPFunInhabited {cnt : Countable Loc} : Inhabited (WPFunCOFE {cnt}).E
  | default => \lam _ _ => mkProperPure Empty

\lemma wp_pre_contractive_ofe
  {cnt : Countable Loc}
  : Contractive {WPFunCOFE} wp_pre =>
  \lam n f g dl e Phi =>
          wp_pre_contractive n f g
          (\lam k hk e' Phi' => dl.dist_later_lt k hk e' Phi')
          e Phi

\func wp
  {cnt : Countable Loc}
  (e    : Expr)
  (Phi  : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : ProperUPred (HeapCMRA Loc cnt Value)
  => fixpoint {WPFunCOFE} {WPFunInhabited} wp_pre
      wp_pre_contractive_ofe e Phi

\func wp_unfold
  {cnt : Countable Loc}
  (e    : Expr)
  (Phi  : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : upredEquiv (wp e Phi) (wp_pre wp e Phi)
  => fixpoint_unfold {WPFunCOFE} {WPFunInhabited}
      wp_pre wp_pre_contractive_ofe e Phi


-- =================================================================================
-- WP Spport Rules
-- =================================================================================


\lemma exist_elim_ent
  {cnt : Countable Loc}
  (T : \Type)
  (Phi : T -> ProperUPred (HeapCMRA Loc cnt Value))
  (Q : ProperUPred (HeapCMRA Loc cnt Value))
  (h : \Pi (t : T) -> properUPred_ent (Phi t) Q)
  : properUPred_ent (mkProperExist T Phi) Q
  => \lam n a hv hp =>
      \case hp \with { | inP (t, ht') => h t n a hv ht' }

\lemma true_sep_drop
  {cnt : Countable Loc}
  (P : ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent (mkProperSep (mkProperPure (\Sigma)) P) P
  => \lam n a hv hsep =>
      \case hsep \with {
        | inP (a1, a2, dist_a, _, hP) =>
          \let M => HeapCMRA Loc cnt Value
          \in P.upred_mono n n a2 a hP
              (inP (a1,
                    M.ofe_dist_trans n a (M.op a1 a2) (M.op a2 a1)
                        dist_a
                        (transport (\lam w => M.dist n (M.op a1 a2) w)
                            (M.cmra_comm a1 a2)
                            (M.ofe_dist_refl n (M.op a1 a2)))))
              <=-refl
      }


-- =================================================================================
-- WP Rules
-- =================================================================================


\func wp_value
  {cnt : Countable Loc}
  (v   : Value)
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : upredEquiv (wp (Val v) Phi) (mkProperBUpd (Phi v))
  => wp_unfold (Val v) Phi


\func wp_mono
  {cnt : Countable Loc}
  (e       : Expr)
  (Phi Psi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  (h       : \Pi (v : Value) -> properUPred_ent (Phi v) (Psi v))
  : properUPred_ent (wp e Phi) (wp e Psi)
  => wp_mono_aux Phi Psi h e
  \where {
    \func wp_mono_at
      (Phi Psi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
      (h       : \Pi (v : Value) -> properUPred_ent (Phi v) (Psi v))
      (n : Nat) (e : Expr) (a : (HeapCMRA Loc cnt Value).E)
      (hv : validN {HeapCMRA Loc cnt Value} n a)
      (hp : (wp  e Phi).upred_holds n a)
      : (wp e Psi).upred_holds n a \elim n
      | 0 =>
        \let
          | unfPhi => (wp_unfold  e Phi 0 a hv).1 hp
          | unfPsi : (wp_pre wp e Psi).upred_holds 0 a =>
            wp_pre_mono_zero Phi Psi h e a hv unfPhi
        \in (wp_unfold e Psi 0 a hv).2 unfPsi
      | suc n =>
        \let
          | unfPhi => (wp_unfold e Phi (suc n) a hv).1 hp
          | unfPsi : (wp_pre wp e Psi).upred_holds (suc n) a =>
            wp_pre_mono_step Phi Psi h e a hv unfPhi
                (\lam e' a' hv' hp' => wp_mono_at Phi Psi h n e' a' hv' hp')
        \in (wp_unfold e Psi (suc n) a hv).2 unfPsi

    \func wp_mono_aux
      {cnt : Countable Loc}
      (Phi Psi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
      (h       : \Pi (v : Value) -> properUPred_ent (Phi v) (Psi v))
      (e : Expr)
      : properUPred_ent (wp e Phi) (wp e Psi)
      => {?}
      -- => \lam n a hv hp => wp_mono_at bu Phi Psi h n e a hv hp

    \func wp_pre_mono_zero
      {cnt : Countable Loc}
      (Phi Psi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
      (h       : \Pi (v : Value) -> properUPred_ent (Phi v) (Psi v))
      (e : Expr) (a : (HeapCMRA Loc cnt Value).E)
      (hv : validN {HeapCMRA Loc cnt Value} 0 a)
      (hp : (wp_pre wp e Phi).upred_holds 0 a)
      : (wp_pre wp e Psi).upred_holds 0 a => {?}

    \func wp_pre_mono_step
      {cnt : Countable Loc}
      (Phi Psi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
      (h       : \Pi (v : Value) -> properUPred_ent (Phi v) (Psi v))
      (e : Expr) (a : (HeapCMRA Loc cnt Value).E) {n : Nat}
      (hv : validN {HeapCMRA Loc cnt Value} (suc n) a)
      (hp : (wp_pre wp e Phi).upred_holds (suc n) a)
      (ih : \Pi (e' : Expr) (a' : (HeapCMRA Loc cnt Value).E)
      -> validN {HeapCMRA Loc cnt Value} n a'
          -> (wp e' Phi).upred_holds n a'
          -> (wp e' Psi).upred_holds n a')
      : (wp_pre wp e Psi).upred_holds (suc n) a => {?}
  }


\func wp_frame_l
  {cnt : Countable Loc}
  (e   : Expr)
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  (R   : ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent
    (mkProperSep R (wp e Phi))
    (wp e (\lam v => mkProperSep R (Phi v)))
  => {?}

\func wp_frame_r
  {cnt : Countable Loc}
  (e   : Expr)
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  (R   : ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent
    (mkProperSep (wp e Phi) R)
    (wp e (\lam v => mkProperSep (Phi v) R))
  => {?}

\lemma wp_value_intro
  {cnt : Countable Loc}
  (v   : Value)
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent (Phi v) (wp (Val v) Phi)
  -- Proof: combine `bu.bupd_intro` with `wp_value bu v Phi` (the equiv).
  => \lam n a hv hp =>
      (wp_value v Phi n a hv).2 (bupd_intro (Phi v) n a hv hp)

\lemma wp_post_mono
  {cnt : Countable Loc}
  (e       : Expr)
  (Phi Psi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  (h       : \Pi (v : Value) -> properUPred_ent (Phi v) (Psi v))
  : properUPred_ent (wp e Phi) (wp e Psi)
  => wp_mono e Phi Psi h

\lemma wp_pure_step
  {cnt : Countable Loc}
  (e e' : Expr)
  (pure : \Pi (sigma : State cnt) -> PrimStep e sigma e' sigma)
  (no_val : to_val e = nothing)
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent (wp e' Phi) (wp e Phi)
  => {?}

\lemma wp_pure_step'
  {cnt : Countable Loc}
  (e e' : Expr)
  (pure : \Pi (sigma : State cnt) -> PrimStep e sigma e' sigma)
  (no_val : to_val e = nothing)
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent (wp e' Phi) (wp e Phi)
  => {?}

\lemma wp_bind_app_l
  {cnt : Countable Loc}
  (e   : Expr)            -- focused subterm
  (e2  : Expr)            -- already-evaluated argument position
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent
    (wp e (\lam v => wp (App (Val v) e2) Phi))
    (wp (App e e2) Phi)
  => {?}

\lemma wp_bind_load
  {cnt : Countable Loc}
  (e   : Expr)
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent
    (wp e (\lam v => wp (Load (Val v)) Phi))
    (wp (Load e) Phi)
  => {?}

\lemma wp_bind_store_r
  {cnt : Countable Loc}
  (l   : Loc)
  (e   : Expr)
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent
    (wp e (\lam v => wp (Store (Val (LitV (LitLoc l))) (Val v)) Phi))
    (wp (Store (Val (LitV (LitLoc l))) e) Phi)
  => {?}

-- (S5) Heap operations
--
-- wp_load:  l ↦ v  ⊢  wp (Load (Loc l)) (\v'. v' = v ∧ l ↦ v)
\lemma wp_load
  {cnt : Countable Loc}
  (l   : Loc)
  (v   : Value)
  : properUPred_ent {HeapCMRA Loc cnt Value}
    (pointsTo l v)
    (wp (Load (Val (LitV (LitLoc l))))
        (\lam v' => mkProperAnd (mkProperPure (v' = v)) (pointsTo l v)))
  =>
    \lam n a_frag hv_frag h_frag =>
        \let
          | M    => HeapCMRA Loc cnt Value
          | Phi  : Value -> ProperUPred M =>
            \lam v' => mkProperAnd (mkProperPure (v' = v)) (pointsTo l v)
          | e    : Expr => Load (Val (LitV (LitLoc l)))
          | tv_e : to_val e = nothing => idp
          | wp_pre_eq : wp_pre wp e Phi =
          mkProperForall (State cnt) (\lam sigma =>
              mkProperWand (own_heap_auth sigma)
                  (mkProperBUpd (mkProperAnd
                      (mkProperPure (Reducible e sigma))
                      (mkProperLater (mkProperForall Expr (\lam e2 =>
                          mkProperForall (State cnt) (\lam sigma2 =>
                              mkProperImpl (mkProperPure (PrimStep e sigma e2 sigma2))
                                  (mkProperBUpd (mkProperSep
                                      (own_heap_auth sigma2) (wp e2 Phi)))))))))) =>
            pmap (\lam tv => \case tv \with {
              | just w  => mkProperBUpd (Phi w)
              | nothing => mkProperForall (State cnt) (\lam sigma =>
                  mkProperWand (own_heap_auth sigma)
                      (mkProperBUpd (mkProperAnd
                          (mkProperPure (Reducible e sigma))
                          (mkProperLater (mkProperForall Expr (\lam e2 =>
                              mkProperForall (State cnt) (\lam sigma2 =>
                                  mkProperImpl (mkProperPure (PrimStep e sigma e2 sigma2))
                                      (mkProperBUpd (mkProperSep
                                          (own_heap_auth sigma2) (wp e2 Phi))))))))))
            }) tv_e
          | body : (wp_pre wp e Phi).upred_holds n a_frag =>
            transport
                (\lam (P : ProperUPred M) => P.upred_holds n a_frag)
                (inv wp_pre_eq)
                (\lam sigma m m_le_n a_auth hv_op h_auth =>
                    \let
                      | hv_frag_m : M.validN m a_frag =>
                        M.cmra_validN_le n m a_frag hv_frag m_le_n
                      | lookup : glookup sigma.heap l = just v =>
                        heap_auth_frag_agree m sigma a_frag a_auth l v hv_op h_auth
                            ((pointsTo l v).upred_mono n m a_frag a_frag h_frag
                                (inP (M.unit,
                                      transport (\lam w => M.dist m a_frag w)
                                          (inv (ucmra_unit_right_id a_frag))
                                          (M.ofe_dist_refl m a_frag)))
                                m_le_n)
                      | red : Reducible e sigma =>
                        inP (Val v, sigma, BasePrim (LoadS l v lookup idp idp idp))
                      | later_body :
                            (mkProperLater (mkProperForall Expr (\lam e2 =>
                                mkProperForall (State cnt) (\lam sigma2 =>
                                    mkProperImpl
                                        (mkProperPure (PrimStep e sigma e2 sigma2))
                                        (mkProperBUpd (mkProperSep
                                            (own_heap_auth sigma2) (wp e2 Phi)))))))
                            .upred_holds m (M.op a_frag a_auth) =>
                        \case \elim m, hv_op, h_auth, h_frag, m_le_n
                        \return
                            (mkProperLater (mkProperForall Expr (\lam e2 =>
                                mkProperForall (State cnt) (\lam sigma2 =>
                                    mkProperImpl
                                        (mkProperPure (PrimStep e sigma e2 sigma2))
                                        (mkProperBUpd (mkProperSep
                                            (own_heap_auth sigma2) (wp e2 Phi)))))))
                            .upred_holds m (M.op a_frag a_auth)
                        \with {
                          | 0, _, _, _, _ => ()
                          | suc k, hv_op_sk, h_auth_sk, h_frag_sk, le_sk =>
                            \lam e2 sigma2 j j_le_k b incl_b hv_b hstep =>
                                \let
                                  -- Decompose PrimStep for Load: it must be LoadS,
                                  -- giving e2 = Val v and sigma2 = sigma.
                                  | step_eq :
                                    LoadStepInv l v sigma e2 sigma2 =>
                                    load_step_inv l v sigma e2 sigma2 lookup hstep
                                  | post_holds :
                                        (mkProperBUpd (mkProperSep
                                            (own_heap_auth sigma) (wp (Val v) Phi))).upred_holds j b =>
                                    \let
                                      | hfrag_j : (pointsTo l v).upred_holds j a_frag =>
                                            (pointsTo l v).upred_mono n j a_frag a_frag h_frag
                                            (inP (M.unit,
                                                  transport (\lam w => M.dist j a_frag w)
                                                      (inv (ucmra_unit_right_id a_frag))
                                                      (M.ofe_dist_refl j a_frag)))
                                            (NatSemiring.<=∘ j_le_k
                                                (NatSemiring.<=∘ (n<=sucn k) le_sk))
                                      | hauth_j : (own_heap_auth sigma).upred_holds j a_auth =>
                                            (own_heap_auth sigma).upred_mono (suc k) j a_auth a_auth h_auth_sk
                                            (inP (M.unit,
                                                  transport (\lam w => M.dist j a_auth w)
                                                      (inv (ucmra_unit_right_id a_auth))
                                                      (M.ofe_dist_refl j a_auth)))
                                            (NatSemiring.<=∘ j_le_k (n<=sucn k))
                                      | hphi_v : (Phi v).upred_holds j a_frag =>
                                        ((idp : v = v), hfrag_j)
                                      | hv_a_frag_j : M.validN j a_frag =>
                                        M.cmra_validN_le n j a_frag hv_frag
                                            (NatSemiring.<=∘ j_le_k
                                                (NatSemiring.<=∘ (n<=sucn k) le_sk))
                                      | hwp_val_frag :
                                            (wp (Val v) Phi).upred_holds j a_frag =>
                                        wp_value_intro v Phi j a_frag hv_a_frag_j hphi_v
                                      -- Build the separating conjunction at M.op a_auth a_frag,
                                      -- then transport along b ~ M.op a_frag a_auth (incl_b says
                                      -- b is a frame-extension of M.op a_frag a_auth, we use mono).
                                      | hsep_at_op :
                                            (mkProperSep (own_heap_auth sigma) (wp (Val v) Phi))
                                            .upred_holds j (M.op a_auth a_frag) =>
                                        inP (a_auth, a_frag,
                                             M.ofe_dist_refl j (M.op a_auth a_frag),
                                             hauth_j, hwp_val_frag)
                                      -- Reassociate to M.op a_frag a_auth.
                                      | hsep_at_swap :
                                            (mkProperSep (own_heap_auth sigma) (wp (Val v) Phi))
                                            .upred_holds j (M.op a_frag a_auth) =>
                                            (mkProperSep (own_heap_auth sigma) (wp (Val v) Phi))
                                            .upred_mono j j (M.op a_auth a_frag) (M.op a_frag a_auth)
                                            hsep_at_op
                                            (inP (M.unit,
                                                  M.ofe_dist_trans j (M.op a_frag a_auth)
                                                      (M.op a_auth a_frag)
                                                      (M.op (M.op a_auth a_frag) M.unit)
                                                      (transport
                                                          (\lam w => M.dist j (M.op a_frag a_auth) w)
                                                          (M.cmra_comm a_frag a_auth)
                                                          (M.ofe_dist_refl j (M.op a_frag a_auth)))
                                                      (transport
                                                          (\lam w => M.dist j (M.op a_auth a_frag) w)
                                                          (inv (ucmra_unit_right_id (M.op a_auth a_frag)))
                                                          (M.ofe_dist_refl j (M.op a_auth a_frag)))))
                                            <=-refl
                                      -- Push along inclusion to b.
                                      | hsep_at_b :
                                            (mkProperSep (own_heap_auth sigma) (wp (Val v) Phi))
                                            .upred_holds j b =>
                                            (mkProperSep (own_heap_auth sigma) (wp (Val v) Phi))
                                            .upred_mono j j (M.op a_frag a_auth) b
                                            hsep_at_swap incl_b <=-refl
                                    \in bupd_intro
                                        (mkProperSep (own_heap_auth sigma) (wp (Val v) Phi))
                                        j b hv_b hsep_at_b
                                \in \case step_eq \with {
                                  | LoadStepInvIntro e2_eq sigma2_eq =>
                                    transport2
                                      (\lam ee ss =>
                                              (mkProperBUpd (mkProperSep
                                                  (own_heap_auth ss) (wp ee Phi))).upred_holds j b)
                                      (inv e2_eq) (inv sigma2_eq)
                                      post_holds
                                }
                        }
                      | core : (mkProperAnd
                          (mkProperPure (Reducible e sigma))
                          (mkProperLater (mkProperForall Expr (\lam e2 =>
                              mkProperForall (State cnt) (\lam sigma2 =>
                                  mkProperImpl
                                      (mkProperPure (PrimStep e sigma e2 sigma2))
                                      (mkProperBUpd (mkProperSep
                                          (own_heap_auth sigma2) (wp e2 Phi))))))))
                               .upred_holds m (M.op a_frag a_auth) =>
                        (red, later_body)
                    \in bupd_intro _ m (M.op a_frag a_auth) hv_op core)
        \in (wp_unfold e Phi n a_frag hv_frag).2 body
  \where {

    \func own_heap_auth_heap_eq
      {cnt : Countable Loc} (s1 s2 : State cnt)
      (h : s1.heap = s2.heap)
      : own_heap_auth s1 = own_heap_auth s2
      => pmap own_heap_auth
          (path (\lam i => \new State cnt {
            | heap => h @ i
          }))

    \func heap_auth_frag_agree
      {cnt : Countable Loc}
      (n : Nat) (sigma : State cnt)
      (a_frag a_auth : (HeapCMRA Loc cnt Value).E)
      (l : Loc) (v : Value)
      (hv  : (HeapCMRA Loc cnt Value).validN n
          ((HeapCMRA Loc cnt Value).op a_frag a_auth))
      (h_auth : (own_heap_auth sigma).upred_holds n a_auth)
      (h_frag : (pointsTo l v).upred_holds n a_frag)
      : glookup sigma.heap l = just v
      =>
        \let
          | M    : CMRA  => HeapCMRA Loc cnt Value
          | G    : UCMRA => GmapUCMRA Loc cnt (ExclUCMRA (DiscreteOFE Value))
          | EU   : UCMRA => ExclUCMRA (DiscreteOFE Value)
          | EU_ofe : OFE => EU
          | m    : G.E   => heap_state_to_gmap sigma
          | sing : G.E   => gmap_singleton l (just (excl v))
          | A    : M.E   => heap_auth {Loc} {cnt} {Value} m
          | F    : M.E   => heap_frag {Loc} {cnt} {Value} l v
          | incl_AF : inclN {M} {\new Op M.E { | op => M.op }}
              (M.op A F) n (M.op a_frag a_auth) =>
            \case h_auth, h_frag \with {
              | inP (zA, dA), inP (zF, dF) =>
                \let
                  | both : M.dist n (M.op a_frag a_auth) (M.op (M.op F zF) (M.op A zA))
                  => cmra_op_ne_both {M} n a_frag (M.op F zF) a_auth (M.op A zA) dF dA
                  | rearr : M.op (M.op A F) (M.op zF zA)
                    = M.op (M.op F zF) (M.op A zA)
                  =>
                    inv (M.cmra_assoc A F (M.op zF zA))
                      *> pmap (M.op A) (M.cmra_assoc F zF zA)
                           *> M.cmra_assoc A (M.op F zF) zA
                                *> pmap (\lam u => M.op u zA) (M.cmra_comm A (M.op F zF))
                                     *> inv (M.cmra_assoc (M.op F zF) A zA)
                \in inP (M.op zF zA,
                         transport (\lam w => M.dist n (M.op a_frag a_auth) w)
                             (inv rearr) both)
            }
          | hv_AF : M.validN n (M.op A F) =>
            cmra_validN_includedN {M} n (M.op A F) (M.op a_frag a_auth) hv incl_AF
          | snd_canonical : (M.op A F).2 = G.op G.unit sing => idp
          | hv_canon : AuthValidN {G} n (AuthOp (just (excl m), G.unit) (nothing, sing)) =>
            hv_AF
          | (sing_in_m, valid_m) => auth_both_validN {G} n m sing hv_canon
          | (y, hy_lookup, sing_incl_y) =>
            singleton_includedN_l {Loc} {cnt} {EU} n m l (just (excl v)) sing_in_m
          | y_validN : EU.validN n y =>
            \let
              | gml   : Maybe EU.E                 => glookup m l
              | hd    : (OptionOFE EU).dist n gml (just y) => hy_lookup
              | vgml  : option_validN {EU} n gml   => valid_m l
            \in \case gml \as g,
                      hd  : (OptionOFE EU).dist n g (just y),
                      vgml : option_validN {EU} n g
            \return EU.validN n y
            \with {
              | nothing, hd', _    => \case hd' \with {}
              | just y0, hd', vy0  =>
                cmra_validN_ne {EU} n y0 y hd' vy0
            }
          | y_eq : y = just (excl v) =>
            excl_option_includedN_eq {Value} n v y y_validN sing_incl_y
          | (mv, h_heap, h_m_shape) =>
            glookup_of_pomap_pair
                (\lam (w : Value) => just (excl w))
                sigma.heap l
                (heap_state_to_gmap sigma)
                idp
        \in
          \case mv \as mv',
                h_heap : glookup sigma.heap l = mv',
                h_m_shape : glookup m l
                  = (\case mv' \with {
                  | nothing => nothing
                  | just w  => just (just (excl w))
                })
          \return glookup sigma.heap l = just v
          \with {
            | nothing, hh, hms =>
              \let
                | shape_eq : (just (just (excl v)) : Maybe (Maybe (Excl Value))) = nothing
                => inv (pmap just y_eq)
                    *> inv (option_dist_to_eq_local n (glookup m l) (just y) hy_lookup)
                         *> hms
              \in \case shape_eq \with {}
            | just w0, hh, hms =>
              \let
                | shape_eq : (just (just (excl w0)) : Maybe (Maybe (Excl Value)))
                  = just (just (excl v))
                => inv hms
                    *> option_dist_to_eq_local n (glookup m l) (just y) hy_lookup
                         *> pmap just y_eq
                | w0_eq_v : w0 = v =>
                  pmap (\lam (mm : Maybe (Maybe (Excl Value))) => \case mm \with {
                    | just (just (excl w)) => w
                    | _                    => w0
                  }) shape_eq
              \in hh *> pmap just w0_eq_v
          }
      \where {
        \func option_dist_to_eq_local
          (n : Nat) (o1 o2 : Maybe (Maybe (Excl Value)))
          (h : (OptionOFE (ExclUCMRA (DiscreteOFE Value))).dist n o1 o2)
          : o1 = o2
          => \case \elim o1, \elim o2, h \with {
            | nothing,  nothing,  _  => idp
            | nothing,  just _,   h' => \case h' \with {}
            | just _,   nothing,  h' => \case h' \with {}
            | just a1,  just a2,  h' => pmap just (option_excl_dist_to_eq Value n a1 a2 h')
          }
      }

    \func base_load_step_inv
      {cnt : Countable Loc}
      (l : Loc) (v : Value) (sigma : State cnt)
      (e2 : Expr) (sigma2 : State cnt)
      (lookup : glookup sigma.heap l = just v)
      (hstep : BaseStep (Load (Val (LitV (LitLoc l)))) sigma e2 sigma2)
      : \Sigma (e2 = Val v) (sigma2 = sigma)
      => \case hstep \with {
        | BetaS _ _ _ p1 _ _ => \case p1 \with {}
        | RecBetaS _ _ _ _ p1 _ _ => \case p1 \with {}
        | RecS _ _ _ p1 _ _ => \case p1 \with {}
        | IfTrueS _ _ p1 _ _ => \case p1 \with {}
        | IfFalseS _ _ p1 _ _ => \case p1 \with {}
        | FstS _ _ p1 _ _ => \case p1 \with {}
        | SndS _ _ p1 _ _ => \case p1 \with {}
        | PairS _ _ p1 _ _ => \case p1 \with {}
        | AllocS _ _ _ p1 _ _ => \case p1 \with {}
        | LoadS l' v' lookup' p1 p2 p3 =>
          \let
            | l_eq : l = l' =>
              pmap (\lam (e : Expr) => \case e \with {
                | Load (Val (LitV (LitLoc x))) => x
                | _ => l
              }) p1
            | lookup'' : glookup sigma.heap l' = just v =>
              transport (\lam ll => glookup sigma.heap ll = just v) l_eq lookup
            | v_eq : v = v' =>
              pmap (\lam (m : Maybe Value) => \case m \with {
                | just w => w
                | nothing => v
              }) (inv lookup'' *> lookup')
          \in (p2 *> pmap Val (inv v_eq), p3)
        | StoreS _ _ _ _ p1 _ _ => \case p1 \with {}
        | IsZeroZeroS p1 _ _ => \case p1 \with {}
        | IsZeroPosS _ p1 _ _ => \case p1 \with {}
        | PredS _ p1 _ _ => \case p1 \with {}
        | MulS _ _ p1 _ _ => \case p1 \with {}
      }

    \truncated \data LoadStepInv
      {cnt : Countable Loc}
      (l : Loc) (v : Value) (sigma : State cnt)
      (e2 : Expr) (sigma2 : State cnt) : \Prop
      | LoadStepInvIntro (e2_eq : e2 = Val v) (sigma2_eq : sigma2 = sigma)

    \axiom load_step_inv
      {cnt : Countable Loc}
      (l : Loc) (v : Value) (sigma : State cnt)
      (e2 : Expr) (sigma2 : State cnt)
      (lookup : glookup sigma.heap l = just v)
      (hstep : PrimStep (Load (Val (LitV (LitLoc l)))) sigma e2 sigma2)
      : LoadStepInv l v sigma e2 sigma2
  }

-- wp_alloc: True  ⊢  wp (Alloc v) (\v'. ∃ l. v' = LitLoc l ∧ l ↦ v)
\lemma wp_alloc
  {cnt : Countable Loc}
  (v   : Value)
  : properUPred_ent {HeapCMRA Loc cnt Value}
    (mkProperPure (\Sigma))
    (wp (Alloc (Val v))
        (\lam v' => mkProperExist Loc (\lam l =>
            mkProperAnd
                (mkProperPure (v' = LitV (LitLoc l)))
                (pointsTo l v))))
  => {?}

\lemma sep_exist_l
  {cnt : Countable Loc}
  (T : \Type) (Phi : T -> ProperUPred (HeapCMRA Loc cnt Value))
  (R : ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent
    (mkProperSep (mkProperExist T Phi) R)
    (mkProperExist T (\lam t => mkProperSep (Phi t) R))
  => \lam n a hv hsep =>
      \case hsep \with {
        | inP (a1, a2, dist_a, hexist, hR) =>
          \case hexist \with {
            | inP (t, hPhi) => inP (t, inP (a1, a2, dist_a, hPhi, hR))
          }
      }


\func wp_bind_mul_r
  {cnt : Countable Loc}
  (v1 : Value)
  (e2 : Expr)
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent {HeapCMRA Loc cnt Value}
    (wp e2 (\lam v => wp (Mul (Val v1) (Val v)) Phi))
    (wp (Mul (Val v1) e2) Phi)
  => {?}

\lemma exist_intro_ent
  {cnt : Countable Loc}
  (T : \Type) (Phi : T -> ProperUPred (HeapCMRA Loc cnt Value))
  (t : T)
  : properUPred_ent (Phi t) (mkProperExist T Phi)
  => \lam n a hv hp => inP (t, hp)

\lemma wp_rec
  {cnt : Countable Loc}
  (f x : String) (body : Expr)
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent (Phi (RecV f x body)) (wp (Rec f x body) Phi)
  => properUPred_ent_trans
      (Phi (RecV f x body))
      (wp (Val (RecV f x body)) Phi)
      (wp (Rec f x body) Phi)
      (wp_value_intro (RecV f x body) Phi)
      (wp_pure_step
          (Rec f x body)
          (Val (RecV f x body))
          (\lam s => BasePrim (RecS f x body idp idp idp)) idp Phi)

\lemma wp_iszero_zero
  {cnt : Countable Loc}
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent (Phi (LitV (LitBool true)))
    (wp (IsZero (Val (natV 0))) Phi)
  => properUPred_ent_trans
      (Phi (LitV (LitBool true)))
      (wp (Val (LitV (LitBool true))) Phi)
      (wp (IsZero (Val (natV 0))) Phi)
      (wp_value_intro (LitV (LitBool true)) Phi)
      (wp_pure_step
          (IsZero (Val (natV 0)))
          (Val (LitV (LitBool true)))
          (\lam s => BasePrim (IsZeroZeroS idp idp idp)) idp Phi)

\lemma wp_iszero_suc {cnt : Countable Loc} (n : Nat)
                     (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent (Phi (LitV (LitBool false)))
    (wp (IsZero (Val (natV (suc n)))) Phi)
  => properUPred_ent_trans
      (Phi (LitV (LitBool false)))
      (wp (Val (LitV (LitBool false))) Phi)
      (wp (IsZero (Val (natV (suc n)))) Phi)
      (wp_value_intro (LitV (LitBool false)) Phi)
      (wp_pure_step
          (IsZero (Val (natV (suc n))))
          (Val (LitV (LitBool false)))
          (\lam s => BasePrim (IsZeroPosS n idp idp idp)) idp Phi)

\lemma wp_pred_suc {cnt : Countable Loc} (n : Nat)
                   (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent (Phi (natV n)) (wp (Pred (Val (natV (suc n)))) Phi)
  => properUPred_ent_trans
      (Phi (natV n))
      (wp (Val (natV n)) Phi)
      (wp (Pred (Val (natV (suc n)))) Phi)
      (wp_value_intro (natV n) Phi)
      (wp_pure_step
          (Pred (Val (natV (suc n))))
          (Val (natV n))
          (\lam s => BasePrim (PredS n idp idp idp)) idp Phi)

\lemma wp_mul {cnt : Countable Loc} (a b : Nat)
              (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent (Phi (natV (a Nat.* b)))
    (wp (Mul (Val (natV a)) (Val (natV b))) Phi)
  => properUPred_ent_trans

      (Phi (natV (a Nat.* b)))
      (wp (Val (natV (a Nat.* b))) Phi)
      (wp (Mul (Val (natV a)) (Val (natV b))) Phi)
      (wp_value_intro (natV (a Nat.* b)) Phi)
      (wp_pure_step
          (Mul (Val (natV a)) (Val (natV b)))
          (Val (natV (a Nat.* b)))
          (\lam s => BasePrim (MulS a b idp idp idp)) idp Phi)
