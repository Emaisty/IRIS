-- =================================================================================
-- Helper Functions
-- =================================================================================


\func big_sep_list {B : BIMixin} (l : List Value) (Phi : Value -> B.E) : B.E \elim l
  | nil => emp
  | v :: l' => Phi v * big_sep_list l' Phi


-- =================================================================================
-- Heap Ownership for Simplified WP
-- =================================================================================


\func heap_state_to_gmap {cnt : Countable Loc} (s : State cnt)
  : Gmap Loc cnt (Maybe (Excl Value)) =>
  \new Gmap Loc cnt (Maybe (Excl Value)) {
    | gtree => pomap (\lam p => just (p.1, just (excl p.2))) s.heap.gtree
    | gtree_wf => heap_state_to_gmap_wf s
  }
  \where {
    -- The mapping function we apply with `pomap`. Defined as a top-level helper so
    -- it appears literally in lookup-rewrites below.
    \func tag (p : \Sigma Loc Value) : Maybe (\Sigma Loc (Maybe (Excl Value))) =>
      just (p.1, just (excl p.2))

    \func heap_state_to_gmap_wf
      {cnt : Countable Loc} (s : State cnt)
      : gmap_wf {Loc} {cnt} {Maybe (Excl Value)}
        (\new Pmap (\Sigma Loc (Maybe (Excl Value))) {
          | tree => (pomap tag s.heap.gtree).tree
          | tree_wf => (pomap tag s.heap.gtree).tree_wf
        })
      => \lam q p hp =>
          \let
            -- Move the lookup through `pomap`:
            --   plookup (pomap tag s.heap.gtree) q = option_bind tag (plookup s.heap.gtree q)
            | step : pomap_tree.option_bind tag (plookup s.heap.gtree q) = just p
            => inv (plookup_pomap tag s.heap.gtree q) *> hp
          \in
            -- Now case-split on `plookup s.heap.gtree q`. Only the `just pp` branch
            -- is reachable: `option_bind tag nothing = nothing`, contradicting `= just p`.
            \case plookup s.heap.gtree q \as o,
                  idp : plookup s.heap.gtree q = o,
                  step : pomap_tree.option_bind tag o = just p
            \return encode {cnt} p.1 = q
            \with {
              | nothing, _, e => \case e \with {}
              | just pp, hpp, e =>
                -- e : just (pp.1, just (excl pp.2)) = just p, so p.1 = pp.1.
                \let
                  | hp1 : p.1 = pp.1 =>
                    inv (pmap (\lam mp => \case mp \with {
                      | nothing => pp.1
                      | just q' => q'.1
                    }) e)
                \in transport (\lam k' => encode {cnt} k' = q)
                    (inv hp1) (s.heap.gtree_wf q pp hpp)
            }
  }

\lemma heap_state_to_gmap_validN
  {cnt : Countable Loc}
  (n : Nat) (sigma : State cnt)
  : (GmapUCMRA Loc cnt (ExclUCMRA (DiscreteOFE Value))).validN n
    (heap_state_to_gmap sigma)
  => \lam i =>
      \let
        | g => heap_state_to_gmap sigma
        -- Unfold glookup: it's `\case plookup (pomap tag h.gtree) (encode i) \with ...`.
        -- pomap's plookup law gives us: result is either `nothing` or `just (just (excl _))`.
        | step : plookup g.gtree (encode {cnt} i)
          = pomap_tree.option_bind heap_state_to_gmap.tag (plookup sigma.heap.gtree (encode {cnt} i))
        => plookup_pomap heap_state_to_gmap.tag sigma.heap.gtree (encode {cnt} i)
      \in
        \case plookup sigma.heap.gtree (encode {cnt} i) \as p,
              idp : plookup sigma.heap.gtree (encode {cnt} i) = p
        \return option_validN {ExclUCMRA (DiscreteOFE Value)} n (glookup g i)
        \with {
          | nothing, hp => {?}      -- glookup g i = nothing, validN nothing = ()
          | just _,  hp => {?}      -- glookup g i = just (just (excl _)), validN of that = ()
        }

-- Own the full view of the state
\func own_heap_auth {cnt : Countable Loc} (s : State cnt)
  : ProperUPred (HeapCMRA Loc cnt Value) \cowith
  | upred_holds => \lam n a =>
      inclN {HeapCMRA Loc cnt Value}
          {\new Op (HeapCMRA Loc cnt Value).E { | op => (HeapCMRA Loc cnt Value).op }}
          (heap_auth (heap_state_to_gmap s)) n a
  | upred_mono => \lam n1 n2 x1 x2 h_incl incl_x1_x2 n2_le_n1 =>
      heap_incl_trans n1 n2
          (heap_auth (heap_state_to_gmap s)) x1 x2
          h_incl incl_x1_x2 n2_le_n1


-- =================================================================================
-- WP Definition via Fixpoint
-- =================================================================================


\func wp_pre {cnt : Countable Loc}
             (wp   : Expr -> (Value -> ProperUPred (HeapCMRA Loc cnt Value)) -> ProperUPred (HeapCMRA Loc cnt Value))
             (e    : Expr)
             (Phi  : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : ProperUPred (HeapCMRA Loc cnt Value)
  => \case to_val e \with {
    | just v  => mkProperBUpd (Phi v)
    | nothing =>
      mkProperForall (State cnt) (\lam sigma =>
          mkProperWand
              (own_heap_auth sigma)
              (mkProperBUpd (
                mkProperAnd
                    (mkProperPure (Reducible e sigma))
                    (mkProperLater (
                      mkProperForall Expr (\lam e2 =>
                          mkProperForall (State cnt) (\lam sigma2 =>
                              mkProperImpl
                                  (mkProperPure (PrimStep e sigma e2 sigma2))
                                  (mkProperBUpd (
                                    mkProperSep
                                        (own_heap_auth sigma2)
                                        (wp e2 Phi)
                                  ))
                          ))
                    ))
              ))
      )
  }


-- =================================================================================
-- Contractivity of wp_pre
-- =================================================================================


\func WPFun {cnt : Countable Loc} : \Type =>
  Expr -> (Value -> ProperUPred (HeapCMRA Loc cnt Value)) -> ProperUPred (HeapCMRA Loc cnt Value)

\func WPFunDist {cnt : Countable Loc} (n : Nat) (f g : WPFun {cnt}) : \Prop =>
  \Pi (e : Expr) (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value)) ->
      upredDist n (f e Phi) (g e Phi)

\func ContractiveFun {cnt : Countable Loc} (F : WPFun {cnt} -> WPFun {cnt}) : \Prop =>
  \Pi (n : Nat) (f g : WPFun {cnt})
  -> (\Pi (k : Nat) -> k NatOrder.< n -> WPFunDist k f g)
  -> WPFunDist n (F f) (F g)

\lemma wp_pre_contractive_core
  {cnt : Countable Loc}
  (n k : Nat) (hk : k NatOrder.< n)
  (f g : WPFun) (hdl : \Pi (j : Nat) -> j NatOrder.< n -> WPFunDist j f g)
  (e : Expr) (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  (sigma : State cnt)
  : upredDist k
    (mkProperBUpd (mkProperSep (own_heap_auth sigma) (f e Phi)))
    (mkProperBUpd (mkProperSep (own_heap_auth sigma) (g e Phi)))
  => {?}

\lemma wp_pre_contractive
  {cnt : Countable Loc}
  : ContractiveFun wp_pre =>
  \lam n f g hdl e Phi =>
      \let
        | step_body_f (sigma : State cnt) : Expr -> ProperUPred (HeapCMRA Loc cnt Value) =>
          \lam e2 =>
              mkProperForall (State cnt) (\lam sigma2 =>
                  mkProperImpl (mkProperPure (PrimStep e sigma e2 sigma2))
                      (mkProperBUpd (mkProperSep (own_heap_auth sigma2) (f e2 Phi))))
        | step_body_g (sigma : State cnt) : Expr -> ProperUPred (HeapCMRA Loc cnt Value) =>
          \lam e2 =>
              mkProperForall (State cnt) (\lam sigma2 =>
                  mkProperImpl (mkProperPure (PrimStep e sigma e2 sigma2))
                      (mkProperBUpd (mkProperSep (own_heap_auth sigma2) (g e2 Phi))))
        | wand_body_f : State cnt -> ProperUPred (HeapCMRA Loc cnt Value) =>
          \lam sigma => mkProperWand (own_heap_auth sigma)
              (mkProperBUpd (mkProperAnd (mkProperPure (Reducible e sigma))
                  (mkProperLater (mkProperForall Expr (step_body_f sigma)))))
        | wand_body_g : State cnt -> ProperUPred (HeapCMRA Loc cnt Value) =>
          \lam sigma => mkProperWand (own_heap_auth sigma)
              (mkProperBUpd (mkProperAnd (mkProperPure (Reducible e sigma))
                  (mkProperLater (mkProperForall Expr (step_body_g sigma)))))
        | LHS_nothing : ProperUPred (HeapCMRA Loc cnt Value) =>
          mkProperForall (State cnt) wand_body_f
        | RHS_nothing : ProperUPred (HeapCMRA Loc cnt Value) =>
          mkProperForall (State cnt) wand_body_g
      \in
        \case to_val e \as tv
        \return upredDist n
            (\case tv \with { | just v => mkProperBUpd (Phi v) | nothing => LHS_nothing })
            (\case tv \with { | just v => mkProperBUpd (Phi v) | nothing => RHS_nothing })
        \with {
          | just _ =>
            \lam m a hm hv => (\lam h => h, \lam h => h)
          | nothing =>
            upredDist_forall {HeapCMRA Loc cnt Value} (State cnt) n wand_body_f wand_body_g
                (\lam sigma =>
                    \let body_dist : \Pi (k : Nat) -> k NatOrder.< n ->
                    upredDist {HeapCMRA Loc cnt Value} k
                        (mkProperForall Expr (step_body_f sigma))
                        (mkProperForall Expr (step_body_g sigma)) =>
                      \lam k hk =>
                          upredDist_forall {HeapCMRA Loc cnt Value} Expr k
                              (step_body_f sigma)
                              (step_body_g sigma)
                              (\lam e2 =>
                                  upredDist_forall {HeapCMRA Loc cnt Value} (State cnt) k
                                      (\lam sigma2 =>
                                          mkProperImpl (mkProperPure (PrimStep e sigma e2 sigma2))
                                              (mkProperBUpd (mkProperSep (own_heap_auth sigma2) (f e2 Phi))))
                                      (\lam sigma2 =>
                                          mkProperImpl (mkProperPure (PrimStep e sigma e2 sigma2))
                                              (mkProperBUpd (mkProperSep (own_heap_auth sigma2) (g e2 Phi))))
                                      (\lam sigma2 =>
                                          upredDist_impl_r {HeapCMRA Loc cnt Value} k
                                              (mkProperPure (PrimStep e sigma e2 sigma2))
                                              (mkProperBUpd (mkProperSep (own_heap_auth sigma2) (f e2 Phi)))
                                              (mkProperBUpd (mkProperSep (own_heap_auth sigma2) (g e2 Phi)))
                                              (bupd_ne k
                                                  (mkProperSep (own_heap_auth sigma2) (f e2 Phi))
                                                  (mkProperSep (own_heap_auth sigma2) (g e2 Phi))
                                                  (upredDist_sep_r {HeapCMRA Loc cnt Value} k (own_heap_auth sigma2)
                                                      (f e2 Phi) (g e2 Phi)
                                                      (hdl k hk e2 Phi)))))
                    \in upredDist_wand_r {HeapCMRA Loc cnt Value} n
                        (own_heap_auth sigma)
                        (mkProperBUpd (mkProperAnd (mkProperPure (Reducible e sigma))
                            (mkProperLater (mkProperForall Expr (step_body_f sigma)))))
                        (mkProperBUpd (mkProperAnd (mkProperPure (Reducible e sigma))
                            (mkProperLater (mkProperForall Expr (step_body_g sigma)))))
                        (bupd_ne n
                            (mkProperAnd (mkProperPure (Reducible e sigma))
                                (mkProperLater (mkProperForall Expr (step_body_f sigma))))
                            (mkProperAnd (mkProperPure (Reducible e sigma))
                                (mkProperLater (mkProperForall Expr (step_body_g sigma))))
                            (upredDist_and_r {HeapCMRA Loc cnt Value} n
                                (mkProperPure (Reducible e sigma))
                                (mkProperLater (mkProperForall Expr (step_body_f sigma)))
                                (mkProperLater (mkProperForall Expr (step_body_g sigma)))
                                (upredDist_later {HeapCMRA Loc cnt Value} n
                                    (mkProperForall Expr (step_body_f sigma))
                                    (mkProperForall Expr (step_body_g sigma))
                                    body_dist))))
        }

-- =================================================================================
-- WP Unfolding Lemma
-- =================================================================================


\func WPFunCOFE {cnt : Countable Loc} : COFE =>
  FunCOFE Expr
      (FunCOFE (Value -> ProperUPred (HeapCMRA Loc cnt Value))
          (UPredCOFE (HeapCMRA Loc cnt Value)))

\instance WPFunInhabited {cnt : Countable Loc} : Inhabited (WPFunCOFE {cnt}).E
  | default => \lam _ _ => mkProperPure Empty

\lemma wp_pre_contractive_ofe
  {cnt : Countable Loc}
  : Contractive {WPFunCOFE} wp_pre =>
  \lam n f g dl e Phi =>
          wp_pre_contractive n f g
          (\lam k hk e' Phi' => dl.dist_later_lt k hk e' Phi')
          e Phi

\func wp
  {cnt : Countable Loc}
  (e    : Expr)
  (Phi  : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : ProperUPred (HeapCMRA Loc cnt Value)
  => fixpoint {WPFunCOFE} {WPFunInhabited} wp_pre
      wp_pre_contractive_ofe e Phi

\func wp_unfold
  {cnt : Countable Loc}
  (e    : Expr)
  (Phi  : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : upredEquiv (wp e Phi) (wp_pre wp e Phi)
  => fixpoint_unfold {WPFunCOFE} {WPFunInhabited}
      wp_pre wp_pre_contractive_ofe e Phi


-- =================================================================================
-- Basic WP Rules
-- =================================================================================


\func wp_value
  {cnt : Countable Loc}
  (v   : Value)
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : upredEquiv (wp (Val v) Phi) (mkProperBUpd (Phi v))
  => wp_unfold (Val v) Phi


\func wp_mono
  {cnt : Countable Loc}
  (e       : Expr)
  (Phi Psi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  (h       : \Pi (v : Value) -> properUPred_ent (Phi v) (Psi v))
  : properUPred_ent (wp e Phi) (wp e Psi)
  => wp_mono_aux Phi Psi h e
  \where {
    \func wp_mono_at
      (Phi Psi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
      (h       : \Pi (v : Value) -> properUPred_ent (Phi v) (Psi v))
      (n : Nat) (e : Expr) (a : (HeapCMRA Loc cnt Value).E)
      (hv : validN {HeapCMRA Loc cnt Value} n a)
      (hp : (wp  e Phi).upred_holds n a)
      : (wp e Psi).upred_holds n a \elim n
      | 0 =>
        \let
          | unfPhi => (wp_unfold  e Phi 0 a hv).1 hp
          | unfPsi : (wp_pre wp e Psi).upred_holds 0 a =>
            wp_pre_mono_zero Phi Psi h e a hv unfPhi
        \in (wp_unfold e Psi 0 a hv).2 unfPsi
      | suc n =>
        \let
          | unfPhi => (wp_unfold e Phi (suc n) a hv).1 hp
          | unfPsi : (wp_pre wp e Psi).upred_holds (suc n) a =>
            wp_pre_mono_step Phi Psi h e a hv unfPhi
                (\lam e' a' hv' hp' => wp_mono_at Phi Psi h n e' a' hv' hp')
        \in (wp_unfold e Psi (suc n) a hv).2 unfPsi

    \func wp_mono_aux
      {cnt : Countable Loc}
      (Phi Psi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
      (h       : \Pi (v : Value) -> properUPred_ent (Phi v) (Psi v))
      (e : Expr)
      : properUPred_ent (wp e Phi) (wp e Psi)
      => {?}
      -- => \lam n a hv hp => wp_mono_at bu Phi Psi h n e a hv hp

    \func wp_pre_mono_zero
      {cnt : Countable Loc}
      (Phi Psi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
      (h       : \Pi (v : Value) -> properUPred_ent (Phi v) (Psi v))
      (e : Expr) (a : (HeapCMRA Loc cnt Value).E)
      (hv : validN {HeapCMRA Loc cnt Value} 0 a)
      (hp : (wp_pre wp e Phi).upred_holds 0 a)
      : (wp_pre wp e Psi).upred_holds 0 a => {?}

    \func wp_pre_mono_step
      {cnt : Countable Loc}
      (Phi Psi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
      (h       : \Pi (v : Value) -> properUPred_ent (Phi v) (Psi v))
      (e : Expr) (a : (HeapCMRA Loc cnt Value).E) {n : Nat}
      (hv : validN {HeapCMRA Loc cnt Value} (suc n) a)
      (hp : (wp_pre wp e Phi).upred_holds (suc n) a)
      (ih : \Pi (e' : Expr) (a' : (HeapCMRA Loc cnt Value).E)
      -> validN {HeapCMRA Loc cnt Value} n a'
          -> (wp e' Phi).upred_holds n a'
          -> (wp e' Psi).upred_holds n a')
      : (wp_pre wp e Psi).upred_holds (suc n) a => {?}
  }


\func wp_frame_l
  {cnt : Countable Loc}
  (e   : Expr)
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  (R   : ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent
    (mkProperSep R (wp e Phi))
    (wp e (\lam v => mkProperSep R (Phi v)))
  => {?}

\func wp_frame_r
  {cnt : Countable Loc}
  (e   : Expr)
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  (R   : ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent
    (mkProperSep (wp e Phi) R)
    (wp e (\lam v => mkProperSep (Phi v) R))
  => {?}

\lemma wp_value_intro
  {cnt : Countable Loc}
  (v   : Value)
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent (Phi v) (wp (Val v) Phi)
  -- Proof: combine `bu.bupd_intro` with `wp_value bu v Phi` (the equiv).
  => \lam n a hv hp =>
      (wp_value v Phi n a hv).2 (bupd_intro (Phi v) n a hv hp)

\lemma wp_post_mono
  {cnt : Countable Loc}
  (e       : Expr)
  (Phi Psi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  (h       : \Pi (v : Value) -> properUPred_ent (Phi v) (Psi v))
  : properUPred_ent (wp e Phi) (wp e Psi)
  => wp_mono e Phi Psi h

\lemma wp_pure_step
  {cnt : Countable Loc}
  (e e' : Expr)
  (pure : \Pi (sigma : State cnt) -> PrimStep e sigma e' sigma)
  (no_val : to_val e = nothing)
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent (wp e' Phi) (wp e Phi)
  => {?}

\lemma wp_pure_step'
  {cnt : Countable Loc}
  (e e' : Expr)
  (pure : \Pi (sigma : State cnt) -> PrimStep e sigma e' sigma)
  (no_val : to_val e = nothing)
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent (wp e' Phi) (wp e Phi)
  => {?}

\lemma wp_bind_app_l
  {cnt : Countable Loc}
  (e   : Expr)            -- focused subterm
  (e2  : Expr)            -- already-evaluated argument position
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent
    (wp e (\lam v => wp (App (Val v) e2) Phi))
    (wp (App e e2) Phi)
  => {?}

\lemma wp_bind_app_r
  {cnt : Countable Loc}
  (vf  : Value)
  (e   : Expr)
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent
    (wp e (\lam v => wp (App (Val vf) (Val v)) Phi))
    (wp (App (Val vf) e) Phi)
  => {?}

\lemma wp_bind_load
  {cnt : Countable Loc}
  (e   : Expr)
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent
    (wp e (\lam v => wp (Load (Val v)) Phi))
    (wp (Load e) Phi)
  => {?}

\lemma wp_bind_store_r
  {cnt : Countable Loc}
  (l   : Loc)
  (e   : Expr)
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent
    (wp e (\lam v => wp (Store (Val (LitV (LitLoc l))) (Val v)) Phi))
    (wp (Store (Val (LitV (LitLoc l))) e) Phi)
  => {?}

\lemma wp_bind_if
  {cnt : Countable Loc}
  (e t f : Expr)
  (Phi : Value -> ProperUPred (HeapCMRA Loc cnt Value))
  : properUPred_ent
    (wp e (\lam v => wp (If (Val v) t f) Phi))
    (wp (If e t f) Phi)
  => {?}

-- (S5) Heap operations
--
-- wp_load:  l ↦ v  ⊢  wp (Load (Loc l)) (\v'. v' = v ∧ l ↦ v)
\lemma wp_load
  {cnt : Countable Loc}
  (l   : Loc)
  (v   : Value)
  : properUPred_ent {HeapCMRA Loc cnt Value}
    (pointsTo l v)
    (wp (Load (Val (LitV (LitLoc l))))
        (\lam v' => mkProperAnd (mkProperPure (v' = v)) (pointsTo l v)))
  => {?}

