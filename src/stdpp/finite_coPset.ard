\import Logic
\import Logic.Meta
\import Paths
\import Set
\import Data.Bool
\import Data.Maybe
\import stdpp.pmap
\import stdpp.coPset
\import iris.algebra.gset

-- The finite `Gset Pos` embedding used by the stdpp namespace API.

\func maybeUnitBool (o : Maybe (\Sigma)) : Bool \elim o
  | nothing => false
  | just _ => true

\func gsetTreeToCoPset (t : Pmap' (\Sigma)) : coPset \elim t
  | PEmpty => coPset_empty
  | PNode v l r =>
      coPNode (maybeUnitBool v) (gsetTreeToCoPset l) (gsetTreeToCoPset r)

\func gsetToCoPset (E : Gset) : coPset => gsetTreeToCoPset E.tree

\lemma coPmem_gsetTreeToCoPset (p : Pos) (t : Pmap' (\Sigma))
  : coPmem p (gsetTreeToCoPset t) = maybeUnitBool (plookup' t p)
  \elim p, t
  | p, PEmpty => inv (coPmem_empty p)
  | xH, PNode v l r => idp
  | xO p, PNode v l r => coPmem_gsetTreeToCoPset p l
  | xI p, PNode v l r => coPmem_gsetTreeToCoPset p r

\lemma maybeUnitBool_true (o : Maybe (\Sigma))
    (h : maybeUnitBool o = true) : o = just () \elim o
  | nothing => \case h \with {}
  | just () => idp

\lemma maybeUnitBool_just (o : Maybe (\Sigma))
    (h : o = just ()) : maybeUnitBool o = true =>
  pmap maybeUnitBool h

\lemma gsetToCoPset_in (p : Pos) (E : Gset)
    (h : gset_in p E) : coPIn p (gsetToCoPset E) =>
  coPmem_gsetTreeToCoPset p E.tree
  *> maybeUnitBool_just (plookup E p) h

\lemma gsetToCoPset_in_inv (p : Pos) (E : Gset)
    (h : coPIn p (gsetToCoPset E)) : gset_in p E =>
  maybeUnitBool_true (plookup E p)
    (inv (coPmem_gsetTreeToCoPset p E.tree) *> h)

\lemma gsetToCoPset_not_in (p : Pos) (E : Gset)
    (h : plookup E p = nothing) : coPNotIn p (gsetToCoPset E) =>
  coPmem_gsetTreeToCoPset p E.tree *> pmap maybeUnitBool h

-- Constructive infinitude: X contains a point outside every finite Gset.
\func coPsetInfinite (X : coPset) : \Set =>
  \Pi (E : Gset) ->
    \Sigma (p : Pos) (coPIn p X) (Not (gset_in p E))

\lemma finite_bool_and_true (a b : Bool) (h : (a and b) = true)
  : \Sigma (a = true) (b = true) \elim a, b
  | false, false => \case h \with {}
  | false, true => \case h \with {}
  | true, false => \case h \with {}
  | true, true => (idp, idp)

\lemma finite_bool_not_true (b : Bool) (h : not b = true) : b = false \elim b
  | false => idp
  | true => \case h \with {}

\func coPset_difference_in_inv (p : Pos) (X Y : coPset)
    (h : coPIn p (coPset_difference X Y))
  : \Sigma (coPIn p X) (coPNotIn p Y) =>
  \let
    | hd : (coPmem p X and not (coPmem p Y)) = true =>
        inv (coPmem_difference p X Y) *> h
    | (hX, hY) => finite_bool_and_true _ _ hd
  \in (hX, finite_bool_not_true _ hY)

\func coPsetInfinite_difference_nonempty (X : coPset)
    (hinf : coPsetInfinite X) (E : Gset)
  : \Sigma (p : Pos) (coPIn p (coPset_difference X (gsetToCoPset E))) =>
  \let | (p, hpX, hpE) => hinf E
  \in (p,
    coPmem_difference p X (gsetToCoPset E)
    *> pmap (\lam b => coPmem p X and not b)
         (gsetToCoPset_not_mem p E hpE)
    *> pmap (\lam b => b and not false) hpX)
  \where {
    \func gsetToCoPset_not_mem (p : Pos) (E : Gset)
        (h : Not (gset_in p E)) : coPmem p (gsetToCoPset E) = false =>
      \case plookup E p \as o, idp : plookup E p = o \with {
        | nothing, e => gsetToCoPset_not_in p E e
        | just (), e => absurd (h e)
      }
  }
