\import Paths
\import ofe
\import cmra
\import iprop
\import lib.gFunctors
\import lib.agree_cmra
\import lib.gmap_view_full

-- Minimal reproducer for the class-instance eta divergence (2026-07-20).
-- Comparing two syntactically identical view-CMRA terms at the concrete
-- recursive `iProp` leaf diverges: the congruence-before-unfolding fast path
-- does not fire on this comparison shape (class-instance / FieldCall eta),
-- and normalizedCompare unfolds into the big view record.
\func repro_self (S : gFunctors)
  : gmap_viewR gname gnameCountable (AgreeCMRA (LaterOFE (iPropO S))) =
    gmap_viewR gname gnameCountable (AgreeCMRA (LaterOFE (iPropO S)))
  => idp
