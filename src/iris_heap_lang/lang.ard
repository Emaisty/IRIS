\import Arith.Nat
\import Data.Bool
\import Data.List
\import Data.Maybe
\import Data.Or
\import Set
\import Logic
\import Paths
\import Paths.Meta
\import Meta
\import Order.LinearOrder
\import Order.PartialOrder
\import iris.algebra.gmap
\import iris.algebra.gset
\import stdpp.pmap



-- \func String => List Nat
--
-- \func stringDecEq (x y : String) : (x = y) `Or` (Not (x = y)) \elim x, y
--   | nil, nil => inl idp
--   | nil, :: _ _ => inr (\lam p => \case p \with {})
--   | :: _ _, nil => inr (\lam p => \case p \with {})
--   | :: a xs, :: b ys => \case decEqNat a b \with {
--     | inl ab => \case stringDecEq xs ys \with {
--       | inl xys => inl (pmap2 (::) ab xys)
--       | inr nxys => inr (\lam p => nxys (pmap tail p))
--     }
--     | inr nab => inr (\lam p => nab (pmap headDef p))
--   }
--   \where {
--     \func headDef (l : List Nat) : Nat
--       | nil => 0
--       | :: a _ => a
--
--     \func tail (l : List Nat) : List Nat
--       | nil => nil
--       | :: _ xs => xs
--   }

\func Loc => Nat

\func ProphId => Pos

\data Lit
  | LitInt (n : Int)
  | LitBool (b : Bool)
  | LitUnit
  | LitLoc (l : Loc)
  | LitProphecy (p : ProphId)

\data Value : \Set0
  | LitV (l : Lit)
  | LamV (x : String) (body : Expr)
  | RecV (f x : String) (body : Expr)
  | PairV (v1 v2 : Value)

\data Expr : \Set0
  | Val (v : Value)
  | Var (x : String)
  | Lam (x : String) (body : Expr)
  | Rec (f x : String) (body : Expr)
  | App (e1 e2 : Expr)
  | If (cond thenB elseB : Expr)
  | Pair (e1 e2 : Expr)
  | Fst (e : Expr)
  | Snd (e : Expr)
  | IsZero (e : Expr)
  | Pred (e : Expr)
  | Mul (e1 e2 : Expr)
  | Load (e : Expr)
  | Store (e1 e2 : Expr)
  | Alloc (e : Expr)
  | Fork (e : Expr)
  | NewProph
  | Resolve (e proph resolution : Expr)

\record State (cnt : Countable Loc)
  | heap : Gmap Loc cnt Value
  | usedProph : Gset

\func Observation : \Set => \Sigma ProphId (\Sigma Value Value)

\func of_val (v : Value) : Expr => Val v

\func to_val (e : Expr) : Maybe Value
  | Val v => just v
  | _ => nothing

\func subst (x : String) (v : Value) (e : Expr) : Expr \elim e
  | Val w => Val w
  | Var y => \case decideEq x y \with {
    | inl _ => Val v
    | inr _ => Var y
  }
  | Lam y body => \case decideEq x y \with {
    | inl _ => Lam y body
    | inr _ => Lam y (subst x v body)
  }
  | Rec f y body => \case decideEq x f \with {
    | inl _ => Rec f y body
    | inr _ => \case decideEq x y \with {
      | inl _ => Rec f y body
      | inr _ => Rec f y (subst x v body)
    }
  }
  | App e1 e2 => App (subst x v e1) (subst x v e2)
  | If cond thenB elseB => If (subst x v cond) (subst x v thenB) (subst x v elseB)
  | Pair e1 e2 => Pair (subst x v e1) (subst x v e2)
  | Fst e => Fst (subst x v e)
  | Snd e => Snd (subst x v e)
  | IsZero e => IsZero (subst x v e)
  | Pred e => Pred (subst x v e)
  | Mul e1 e2 => Mul (subst x v e1) (subst x v e2)
  | Alloc e => Alloc (subst x v e)
  | Load e => Load (subst x v e)
  | Store e1 e2 => Store (subst x v e1) (subst x v e2)
  | Fork e => Fork (subst x v e)
  | NewProph => NewProph
  | Resolve e proph resolution =>
      Resolve (subst x v e) (subst x v proph) (subst x v resolution)
  \where {
    -- Blocked on a concrete decidable equality proof for Arend String.
    -- Any proof unfolding substitution through binders may have to discharge this.
    \func decideEq (x y : String) : (x = y) `Or` (Not (x = y)) => {?}
  }

\func heap_update {cnt : Countable Loc} (h : Gmap Loc cnt Value) (l : Loc) (v : Value) : Gmap Loc cnt Value =>
  ginsert l v h

\func state_update_heap {cnt : Countable Loc}
    (s : State cnt) (h : Gmap Loc cnt Value) : State cnt \cowith
  | heap => h
  | usedProph => s.usedProph

\func state_update_usedProph {cnt : Countable Loc}
    (s : State cnt) (used : Gset) : State cnt \cowith
  | heap => s.heap
  | usedProph => used

\func nat_max (n m : Nat) : Nat \elim n, m
  | 0, m => m
  | suc n, 0 => suc n
  | suc n, suc m => suc (nat_max n m)

\lemma nat_max_le_l (n m : Nat) : n <= nat_max n m \elim n, m
  | 0, m => zero<=_
  | suc n, 0 => <=-refl
  | suc n, suc m => suc<=suc (nat_max_le_l n m)

\lemma nat_max_le_r (n m : Nat) : m <= nat_max n m \elim n, m
  | 0, m => <=-refl
  | suc n, 0 => zero<=_
  | suc n, suc m => suc<=suc (nat_max_le_r n m)

\lemma not_suc_le_self (n : Nat) : Not (suc n <= n)
  => \lam h => LinearOrder.notLess <=-refl (suc_<=_< h)

\func heap_tree_max {A : \Set} (t : Pmap' (\Sigma Loc A)) : Nat \elim t
  | PEmpty => 0
  | PNode nothing l r => nat_max (heap_tree_max l) (heap_tree_max r)
  | PNode (just p) l r => nat_max p.1 (nat_max (heap_tree_max l) (heap_tree_max r))

\lemma heap_tree_lookup_le {A : \Set} (t : Pmap' (\Sigma Loc A)) (q : Pos) (p : \Sigma Loc A)
                           (h : plookup' t q = just p)
  : p.1 <= heap_tree_max t
\elim t, q
  | PEmpty, _ => \case h \with {}
  | PNode nothing l r, xH => \case h \with {}
  | PNode (just p0) l r, xH =>
    \let hp : p0.1 = p.1 =>
      pmap (\lam o => \case o \with {
        | nothing => p0.1
        | just p' => p'.1
      }) h
    \in transport (\lam a => a <= nat_max p0.1 (nat_max (heap_tree_max l) (heap_tree_max r)))
         hp
         (nat_max_le_l p0.1 (nat_max (heap_tree_max l) (heap_tree_max r)))
  | PNode nothing l r, xO q' =>
    <=-transitive (heap_tree_lookup_le l q' p h)
      (nat_max_le_l (heap_tree_max l) (heap_tree_max r))
  | PNode nothing l r, xI q' =>
    <=-transitive (heap_tree_lookup_le r q' p h)
      (nat_max_le_r (heap_tree_max l) (heap_tree_max r))
  | PNode (just p0) l r, xO q' =>
    <=-transitive
      (heap_tree_lookup_le l q' p h)
      (<=-transitive
        (nat_max_le_l (heap_tree_max l) (heap_tree_max r))
        (nat_max_le_r p0.1 (nat_max (heap_tree_max l) (heap_tree_max r))))
  | PNode (just p0) l r, xI q' =>
    <=-transitive
      (heap_tree_lookup_le r q' p h)
      (<=-transitive
        (nat_max_le_r (heap_tree_max l) (heap_tree_max r))
        (nat_max_le_r p0.1 (nat_max (heap_tree_max l) (heap_tree_max r))))

\func heap_fresh_loc {cnt : Countable Loc} (s : State cnt)
  : \Sigma (l : Loc) (glookup s.heap l = nothing)
  =>
    \let
      | b : Nat => heap_tree_max s.heap.gtree.tree
      | l : Loc => suc b
      | fresh : glookup s.heap l = nothing =>
        \case plookup s.heap.gtree (encode {cnt} l) \as o,
              idp : plookup s.heap.gtree (encode {cnt} l) = o
        \return (\case o \with { | nothing => nothing | just p => just p.2 }) = nothing
        \with {
          | nothing, _ => idp
          | just p, hp =>
            \let
              | hp_loc : p.1 = l =>
                encode_inj {cnt} p.1 l (s.heap.gtree_wf (encode {cnt} l) p hp)
              | le_p : p.1 <= b =>
                heap_tree_lookup_le s.heap.gtree.tree (encode {cnt} l) p hp
              | le_l : l <= b =>
                transport (\lam a => a <= b) hp_loc le_p
            \in absurd (not_suc_le_self b le_l)
        }
    \in (l, fresh)

\func state_fresh_proph {cnt : Countable Loc} (s : State cnt)
  : \Sigma (p : ProphId) (plookup s.usedProph p = nothing) =>
  pmap_fresh_key s.usedProph


\truncated \data BaseStep {cnt : Countable Loc}
    (e1 : Expr) (s1 : State cnt) (e2 : Expr) (s2 : State cnt)
    (efs : List Expr) (observations : List Observation) : \Prop
  | BetaS (x : String) (body : Expr) (v : Value)
          (p1 : e1 = App (Val (LamV x body)) (Val v))
          (p2 : e2 = subst x v body)
          (p3 : s2 = s1) {p0 : observations = nil} {p4 : efs = nil}
  | RecBetaS (f x : String) (body : Expr) (v : Value)
             (p1 : e1 = App (Val (RecV f x body)) (Val v))
             (p2 : e2 = subst x v (subst f (RecV f x body) body))
             (p3 : s2 = s1) {p0 : observations = nil} {p4 : efs = nil}
  | LamS (x : String) (body : Expr)
         (p1 : e1 = Lam x body)
         (p2 : e2 = Val (LamV x body))
         (p3 : s2 = s1) {p0 : observations = nil} {p4 : efs = nil}
  | RecS (f x : String) (body : Expr)
         (p1 : e1 = Rec f x body)
         (p2 : e2 = Val (RecV f x body))
         (p3 : s2 = s1) {p0 : observations = nil} {p4 : efs = nil}
  | IfTrueS (t f : Expr)
            (p1 : e1 = If (Val (LitV (LitBool true))) t f)
            (p2 : e2 = t)
            (p3 : s2 = s1) {p0 : observations = nil} {p4 : efs = nil}
  | IfFalseS (t f : Expr)
             (p1 : e1 = If (Val (LitV (LitBool false))) t f)
             (p2 : e2 = f)
             (p3 : s2 = s1) {p0 : observations = nil} {p4 : efs = nil}
  | FstS (v1 v2 : Value)
         (p1 : e1 = Fst (Val (PairV v1 v2)))
         (p2 : e2 = Val v1)
         (p3 : s2 = s1) {p0 : observations = nil} {p4 : efs = nil}
  | SndS (v1 v2 : Value)
         (p1 : e1 = Snd (Val (PairV v1 v2)))
         (p2 : e2 = Val v2)
         (p3 : s2 = s1) {p0 : observations = nil} {p4 : efs = nil}
  | PairS (v1 v2 : Value)
          (p1 : e1 = Pair (Val v1) (Val v2))
          (p2 : e2 = Val (PairV v1 v2))
          (p3 : s2 = s1) {p0 : observations = nil} {p4 : efs = nil}
  | AllocS (v : Value) (l : Loc)
           (fresh : glookup s1.heap l = nothing)
           (p1 : e1 = Alloc (Val v))
           (p2 : e2 = Val (LitV (LitLoc l)))
           (p3 : s2 = state_update_heap s1 (heap_update s1.heap l v))
           {p0 : observations = nil} {p4 : efs = nil}
  | LoadS (l : Loc) (v : Value)
          (lookup : glookup s1.heap l = just v)
          (p1 : e1 = Load (Val (LitV (LitLoc l))))
          (p2 : e2 = Val v)
          (p3 : s2 = s1) {p0 : observations = nil} {p4 : efs = nil}
  | StoreS (l : Loc) (v v' : Value)
           (allocated : glookup s1.heap l = just v')
           (p1 : e1 = Store (Val (LitV (LitLoc l))) (Val v))
           (p2 : e2 = Val (LitV LitUnit))
           (p3 : s2 = state_update_heap s1 (heap_update s1.heap l v))
           {p0 : observations = nil} {p4 : efs = nil}
  | IsZeroZeroS
    (p1 : e1 = IsZero (Val (LitV (LitInt 0))))
    (p2 : e2 = Val (LitV (LitBool true)))
    (p3 : s2 = s1) {p0 : observations = nil} {p4 : efs = nil}
  | IsZeroPosS (n : Nat)
               (p1 : e1 = IsZero (Val (LitV (LitInt (pos (suc n))))))
               (p2 : e2 = Val (LitV (LitBool false)))
               (p3 : s2 = s1) {p0 : observations = nil} {p4 : efs = nil}
  | PredS (n : Nat)
          (p1 : e1 = Pred (Val (LitV (LitInt (pos (suc n))))))
          (p2 : e2 = Val (LitV (LitInt (pos n))))
          (p3 : s2 = s1) {p0 : observations = nil} {p4 : efs = nil}
  | MulS (a b : Nat)
         (p1 : e1 = Mul (Val (LitV (LitInt (pos a)))) (Val (LitV (LitInt (pos b)))))
         (p2 : e2 = Val (LitV (LitInt (pos (a Nat.* b)))))
         (p3 : s2 = s1) {p0 : observations = nil} {p4 : efs = nil}
  | ForkS (e : Expr)
          (p1 : e1 = Fork e)
          (p2 : e2 = Val (LitV LitUnit))
          (p3 : s2 = s1) {p0 : observations = nil} {p4 : efs = e :: nil}
  | NewProphS (p : ProphId)
      (fresh : plookup s1.usedProph p = nothing)
      (p1 : e1 = NewProph)
      (p2 : e2 = Val (LitV (LitProphecy p)))
      (p3 : s2 = state_update_usedProph s1 (pinsert p () s1.usedProph))
      {p0 : observations = nil} {p4 : efs = nil}
  | ResolveS (p : ProphId) (v w : Value) (e : Expr)
      (innerObservations : List Observation) (innerForks : List Expr)
      (step : BaseStep e s1 (Val v) s2 innerForks innerObservations)
      (used : gset_in p s1.usedProph)
      (p1 : e1 = Resolve e (Val (LitV (LitProphecy p))) (Val w))
      (p2 : e2 = Val v)
      {p0 : observations = innerObservations ++ (p, (v, w)) :: nil}
      {p4 : efs = innerForks}

\data EctxItem
  | AppLCtx (e2 : Expr)
  | AppRCtx (vf : Value)
  | IfCtx (thenB elseB : Expr)
  | PairLCtx (e2 : Expr)
  | PairRCtx (v1 : Value)
  | FstCtx
  | SndCtx
  | IsZeroCtx
  | PredCtx
  | MulLCtx (e2 : Expr)
  | MulRCtx (v1 : Value)
  | AllocCtx
  | LoadCtx
  | StoreLCtx (e2 : Expr)
  | StoreRCtx (v1 : Value)
  -- The first Resolve argument deliberately has no plain context item: only
  -- reductions strictly below one existing item are contextual.  Its final
  -- base step is performed atomically by ResolveS.
  | ResolveLCtx (Ki : EctxItem) (vp vt : Value)
  | ResolveMCtx (e0 : Expr) (vt : Value)
  | ResolveRCtx (e0 e1 : Expr)

\data Ectx
  | EmptyCtx
  | ConsCtx (Ki : EctxItem) (K : Ectx)

\func fill_item (Ki : EctxItem) (e : Expr) : Expr \elim Ki
  | AppLCtx e2 => App e e2
  | AppRCtx vf => App (Val vf) e
  | IfCtx thenB elseB => If e thenB elseB
  | PairLCtx e2 => Pair e e2
  | PairRCtx v1 => Pair (Val v1) e
  | FstCtx => Fst e
  | SndCtx => Snd e
  | IsZeroCtx => IsZero e
  | PredCtx => Pred e
  | MulLCtx e2 => Mul e e2
  | MulRCtx v1 => Mul (Val v1) e
  | AllocCtx => Alloc e
  | LoadCtx => Load e
  | StoreLCtx e2 => Store e e2
  | StoreRCtx v1 => Store (Val v1) e
  | ResolveLCtx Ki vp vt =>
      Resolve (fill_item Ki e) (Val vp) (Val vt)
  | ResolveMCtx e0 vt => Resolve e0 e (Val vt)
  | ResolveRCtx e0 e1 => Resolve e0 e1 e

\func empty_ectx : Ectx => EmptyCtx

\func comp_ectx (K1 K2 : Ectx) : Ectx \elim K1
  | EmptyCtx => K2
  | ConsCtx Ki K1' => ConsCtx Ki (comp_ectx K1' K2)

\func fill (K : Ectx) (e : Expr) : Expr \elim K
  | EmptyCtx => e
  | ConsCtx Ki K' => fill_item Ki (fill K' e)

\func fill_empty (e : Expr) : fill empty_ectx e = e => idp

\func fill_comp (K1 K2 : Ectx) (e : Expr) : fill K1 (fill K2 e) = fill (comp_ectx K1 K2) e \elim K1
  | EmptyCtx => idp
  | ConsCtx Ki K1' => pmap (fill_item Ki) (fill_comp K1' K2 e)

\truncated \data PrimStep {cnt : Countable Loc}
    (e1 : Expr) (s1 : State cnt) (e2 : Expr) (s2 : State cnt)
    (efs : List Expr) (observations : List Observation) : \Prop
  | EctxStep (K : Ectx) (e1' e2' : Expr)
             (p1 : e1 = fill K e1')
             (p2 : e2 = fill K e2')
             (step : BaseStep e1' s1 e2' s2 efs observations)

\func base_prim_step {cnt : Countable Loc}
                     {e1 e2 : Expr} {s1 s2 : State cnt}
                     {observations : List Observation} {efs : List Expr}
                     (step : BaseStep e1 s1 e2 s2 efs observations)
  : PrimStep e1 s1 e2 s2 efs observations =>
  EctxStep empty_ectx e1 e2 idp idp step

\func BasePrim {cnt : Countable Loc}
               {e1 e2 : Expr} {s1 s2 : State cnt}
               {observations : List Observation} {efs : List Expr}
               (step : BaseStep e1 s1 e2 s2 efs observations)
  : PrimStep e1 s1 e2 s2 efs observations =>
  base_prim_step step


-- =================================================================================
-- Mathematical factorial on Nat
-- =================================================================================

\func nat_fact (n : Nat) : Nat
  | 0      => 1
  | suc n' => suc n' Nat.* nat_fact n'

\func natV (n : Nat) : Value => LitV (LitInt (pos n))
