\import Logic
\import Data.Or
\import Paths
\import Paths.Meta
\import Set
\import iris_heap_lang.lang

\lemma subst_val (x : Name) (v w : Value)
  : subst x v (Val w) = Val w
  => idp

\lemma subst_var_same (x : Name) (v : Value)
  : subst x v (Var x) = Val v
  => \case nameDecEq x x \as d, idp : nameDecEq x x = d
       \return subst x v (Var x) = Val v \with {
    | inl _, h => rewrite h idp
    | inr neq, _ => absurd (neq idp)
  }

\lemma subst_var_ne (x y : Name) (v : Value)
  (neq : Not (x = y))
  : subst x v (Var y) = Var y
  => \case nameDecEq x y \as d, idp : nameDecEq x y = d
       \return subst x v (Var y) = Var y \with {
    | inl eq, _ => absurd (neq eq)
    | inr _, h => rewrite h idp
  }

\lemma subst_lam_same (x : Name) (v : Value) (body : Expr)
  : subst x v (Lam x body) = Lam x body
  => \case nameDecEq x x \as d, idp : nameDecEq x x = d
       \return subst x v (Lam x body) = Lam x body \with {
    | inl _, h => rewrite h idp
    | inr neq, _ => absurd (neq idp)
  }

\lemma subst_lam_ne (x y : Name) (v : Value) (body : Expr)
  (neq : Not (x = y))
  : subst x v (Lam y body) = Lam y (subst x v body)
  => \case nameDecEq x y \as d, idp : nameDecEq x y = d
       \return subst x v (Lam y body) = Lam y (subst x v body) \with {
    | inl eq, _ => absurd (neq eq)
    | inr _, h => rewrite h idp
  }

\lemma subst_rec_same_f (f x : Name) (v : Value) (body : Expr)
  : subst f v (Rec f x body) = Rec f x body
  => \case nameDecEq f f \as d, idp : nameDecEq f f = d
       \return subst f v (Rec f x body) = Rec f x body \with {
    | inl _, h => rewrite h idp
    | inr neq, _ => absurd (neq idp)
  }

\lemma subst_rec_same_x (f x : Name) (v : Value) (body : Expr)
  (f_ne_x : Not (x = f))
  : subst x v (Rec f x body) = Rec f x body
  => \case nameDecEq x f \as d, idp : nameDecEq x f = d
       \return subst x v (Rec f x body) = Rec f x body \with {
    | inl eq, _ => absurd (f_ne_x eq)
    | inr _, h => \case nameDecEq x x \as d', idp : nameDecEq x x = d'
         \return subst x v (Rec f x body) = Rec f x body \with {
      | inl _, h' => rewrite h (rewrite h' idp)
      | inr neq, _ => absurd (neq idp)
    }
  }

\lemma subst_rec_ne (z f x : Name) (v : Value) (body : Expr)
  (z_ne_f : Not (z = f)) (z_ne_x : Not (z = x))
  : subst z v (Rec f x body) = Rec f x (subst z v body)
  => \case nameDecEq z f \as d, idp : nameDecEq z f = d
       \return subst z v (Rec f x body) = Rec f x (subst z v body) \with {
    | inl eq, _ => absurd (z_ne_f eq)
    | inr _, h => \case nameDecEq z x \as d', idp : nameDecEq z x = d'
         \return subst z v (Rec f x body) = Rec f x (subst z v body) \with {
      | inl eq, _ => absurd (z_ne_x eq)
      | inr _, h' => rewrite h (rewrite h' idp)
    }
  }

\lemma subst_app (x : Name) (v : Value) (e1 e2 : Expr)
  : subst x v (App e1 e2) = App (subst x v e1) (subst x v e2)
  => idp

\lemma subst_if (x : Name) (v : Value) (cond thenB elseB : Expr)
  : subst x v (If cond thenB elseB) =
      If (subst x v cond) (subst x v thenB) (subst x v elseB)
  => idp

\lemma subst_pair (x : Name) (v : Value) (e1 e2 : Expr)
  : subst x v (Pair e1 e2) = Pair (subst x v e1) (subst x v e2)
  => idp

\lemma subst_fst (x : Name) (v : Value) (e : Expr)
  : subst x v (Fst e) = Fst (subst x v e)
  => idp

\lemma subst_snd (x : Name) (v : Value) (e : Expr)
  : subst x v (Snd e) = Snd (subst x v e)
  => idp

\lemma subst_iszero (x : Name) (v : Value) (e : Expr)
  : subst x v (IsZero e) = IsZero (subst x v e)
  => idp

\lemma subst_pred (x : Name) (v : Value) (e : Expr)
  : subst x v (Pred e) = Pred (subst x v e)
  => idp

\lemma subst_mul (x : Name) (v : Value) (e1 e2 : Expr)
  : subst x v (Mul e1 e2) = Mul (subst x v e1) (subst x v e2)
  => idp

\lemma subst_alloc (x : Name) (v : Value) (e : Expr)
  : subst x v (Alloc e) = Alloc (subst x v e)
  => idp

\lemma subst_load (x : Name) (v : Value) (e : Expr)
  : subst x v (Load e) = Load (subst x v e)
  => idp

\lemma subst_store (x : Name) (v : Value) (e1 e2 : Expr)
  : subst x v (Store e1 e2) = Store (subst x v e1) (subst x v e2)
  => idp
