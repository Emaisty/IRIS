\import Logic
\import Logic.Meta
\import Paths
\import Set
\import Data.Maybe
\import Data.Or
\import Arith.Nat
\import ofe
\import cmra
\import interface
\import lib.gFunctors
\import Order.PartialOrder
\import Order.LinearOrder


\func uPred (M : UCMRA) : \Type => Nat -> M.E -> \Prop


\record ProperUPred (M : UCMRA)
  | upred_holds : Nat -> M.E -> \Prop
  | upred_mono : \Pi (n1 n2 : Nat) (x1 x2 : M.E) ->
    upred_holds n1 x1 ->
    inclN {M} {\new Op M.E { | op => M.op }} x1 n2 x2 ->
    n2 <= n1 ->
    upred_holds n2 x2

\func properUPred_ent {M : UCMRA} (P Q : ProperUPred M) : \Prop =>
  \Pi (n : Nat) (a : M.E) -> M.validN n a -> P.upred_holds n a -> Q.upred_holds n a

\func properUPred_ent_refl {M : UCMRA} (P : ProperUPred M) : properUPred_ent P P =>
  \lam n a _ h => h

\func properUPred_ent_trans {M : UCMRA} (P Q R : ProperUPred M)
                            (h1 : properUPred_ent P Q) (h2 : properUPred_ent Q R) : properUPred_ent P R =>
  \lam n a hv hp => h2 n a hv (h1 n a hv hp)

\func mkProperPure {M : UCMRA} (phi : \Prop) : ProperUPred M \cowith
  | upred_holds => \lam n a => phi
  | upred_mono => \lam n1 n2 x1 x2 h _ _ => h

\func mkProperEmp {M : UCMRA} : ProperUPred M \cowith
  | upred_holds => \lam n a => inclN {M} {\new Op M.E { | op => M.op }} M.unit n a
  | upred_mono => \lam n1 n2 x1 x2 h_incl incl n2_le_n1 =>
    \case h_incl, incl \with {
      | inP (z1, dist_x1_uz1), inP (z2, dist_x2_x1z2) =>
        inP (M.op z1 z2,
             M.ofe_dist_trans n2 x2 (M.op z1 z2) (M.op M.unit (M.op z1 z2))
               (M.ofe_dist_trans n2 x2 (M.op x1 z2) (M.op z1 z2)
                 dist_x2_x1z2
                 (M.cmra_op_ne_2 z2 n2 x1 z1
                   (M.ofe_dist_trans n2 x1 (M.op M.unit z1) z1
                     (M.ofe_dist_le n1 n2 x1 (M.op M.unit z1) dist_x1_uz1 n2_le_n1)
                     (ucmra_unit_left_id_dist n2 z1))))
               (M.ofe_dist_sym n2 (M.op M.unit (M.op z1 z2)) (M.op z1 z2)
                 (ucmra_unit_left_id_dist n2 (M.op z1 z2))))

    }


-- =================================================================================
-- Primitive ownership and validity
-- =================================================================================
--
-- `mkProperOwn a` is the primitive resource-ownership predicate:
-- `ownM a` holds at `(n, x)` iff `a` is `n`-included in `x`.
-- It is the basic building block for ghost state and invariants.

\func mkProperOwn {M : UCMRA} (a : M.E) : ProperUPred M \cowith
  | upred_holds => \lam n x => inclN {M} {\new Op M.E { | op => M.op }} a n x
  | upred_mono  => \lam n1 n2 x1 x2 h_a_x1 h_x1_x2 n2_le_n1 =>
      inclN_trans n2 a x1 x2
          (inclN_le {M} {\new Op M.E { | op => M.op }} a x1 n1 n2 h_a_x1 n2_le_n1)
          h_x1_x2

-- `mkProperCMRAValid a` lifts CMRA validity into uPred:
-- holds at `(n, _)` iff `validN n a`. Resource-independent.

\func mkProperCMRAValid {M : UCMRA} (a : M.E) : ProperUPred M \cowith
  | upred_holds => \lam n _ => M.validN n a
  | upred_mono  => \lam n1 n2 _ _ hv _ n2_le_n1 =>
      M.cmra_validN_le n1 n2 a hv n2_le_n1

-- `mkProperInternalEq a b` is uPred's internal equality (Rocq
-- `uPred_internal_eq`): holds at `(n, _)` iff `a ≡{n}≡ b` in the OFE `A`.
-- Resource-independent; downward closure is `ofe_dist_le`.

\func mkProperInternalEq {M : UCMRA} {A : OFE} (a b : A.E) : ProperUPred M \cowith
  | upred_holds => \lam n _ => A.dist n a b
  | upred_mono  => \lam n1 n2 _ _ h _ n2_le_n1 => A.ofe_dist_le n1 n2 a b h n2_le_n1


\func mkProperAnd {M : UCMRA} (P Q : ProperUPred M) : ProperUPred M \cowith
  | upred_holds => \lam n a => \Sigma (P.upred_holds n a) (Q.upred_holds n a)
  | upred_mono => \lam n1 n2 x1 x2 (h_P, h_Q) incl n2_le_n1 =>
    (P.upred_mono n1 n2 x1 x2 h_P incl n2_le_n1, Q.upred_mono n1 n2 x1 x2 h_Q incl n2_le_n1)

\func mkProperOr {M : UCMRA} (P Q : ProperUPred M) : ProperUPred M \cowith
  | upred_holds => \lam n a => (P.upred_holds n a) || (Q.upred_holds n a)
  | upred_mono => \lam n1 n2 x1 x2 h incl n2_le_n1 => \case h \with {
    | byLeft h_P => byLeft (P.upred_mono n1 n2 x1 x2 h_P incl n2_le_n1)
    | byRight h_Q => byRight (Q.upred_mono n1 n2 x1 x2 h_Q incl n2_le_n1)
  }

\func mkProperImpl {M : UCMRA} (P Q : ProperUPred M) : ProperUPred M \cowith
  | upred_holds => \lam n a => \Pi (m : Nat) -> m <= n -> \Pi (b : M.E) ->
      inclN {M} {\new Op M.E { | op => M.op }} a m b ->
      M.validN m b -> P.upred_holds m b -> Q.upred_holds m b
  | upred_mono => \lam n1 n2 x1 x2 h incl n2_le_n1 m m_le_n2 b incl_x2_b hv hp =>
      h m (NatSemiring.<=∘ m_le_n2 n2_le_n1) b
          (inclN_trans m x1 x2 b
              (inclN_le {M} {\new Op M.E { | op => M.op }} x1 x2 n2 m incl m_le_n2)
              incl_x2_b)
          hv hp

\func mkProperForall {M : UCMRA} (T : \Type) (Phi : T -> ProperUPred M) : ProperUPred M \cowith
  | upred_holds => \lam n a => \Pi (t : T) -> (Phi t).upred_holds n a
  | upred_mono => \lam n1 n2 x1 x2 h incl n2_le_n1 t =>
      (Phi t).upred_mono n1 n2 x1 x2 (h t) incl n2_le_n1

\func mkProperExist {M : UCMRA} (T : \Type) (Phi : T -> ProperUPred M) : ProperUPred M \cowith
  | upred_holds => \lam n a => TruncP (\Sigma (t : T) ((Phi t).upred_holds n a))
  | upred_mono => \lam n1 n2 x1 x2 h incl n2_le_n1 => \case h \with {
    | inP (t, h_t) => inP (t, (Phi t).upred_mono n1 n2 x1 x2 h_t incl n2_le_n1)
  }

\func mkProperSep {M : UCMRA} (P Q : ProperUPred M) : ProperUPred M \cowith
  | upred_holds => \lam n a => TruncP (\Sigma (a1 a2 : M.E) (M.dist n a (M.op a1 a2)) (P.upred_holds n a1) (Q.upred_holds n a2))
  | upred_mono => \lam n1 n2 x1 x2 h incl n2_le_n1 => \case h, incl \with {
    | inP (a1, a2, dist_x1, hp, hq), inP (z, dist_x2) =>
      \let inclN_refl : \Pi (a : M.E) -> inclN {M} {\new Op M.E { | op => M.op }} a n2 a =>
        \lam a => inP (M.unit,
          M.ofe_dist_trans n2 a a (M.op a M.unit)
            (M.ofe_dist_refl n2 a)
            (M.ofe_dist_sym n2 (M.op a M.unit) a (ucmra_unit_right_id_dist n2 a)))
      \in inP (a1, M.op a2 z,
               M.ofe_dist_trans n2 x2 (M.op x1 z) (M.op a1 (M.op a2 z))
                 dist_x2
                 (M.ofe_dist_trans n2 (M.op x1 z) (M.op (M.op a1 a2) z) (M.op a1 (M.op a2 z))
                   (M.cmra_op_ne_2 z n2 x1 (M.op a1 a2)
                     (M.ofe_dist_le n1 n2 x1 (M.op a1 a2) dist_x1 n2_le_n1))
                   (M.ofe_dist_sym n2 (M.op a1 (M.op a2 z)) (M.op (M.op a1 a2) z)
                     (cmra_assoc_dist n2 a1 a2 z))),
               P.upred_mono n1 n2 a1 a1 hp (inclN_refl a1) n2_le_n1,
               Q.upred_mono n1 n2 a2 (M.op a2 z) hq (cmra_includedN_l n2 a2 z) n2_le_n1)
  }


\func mkProperWand {M : UCMRA} (P Q : ProperUPred M) : ProperUPred M \cowith
  | upred_holds => \lam n a1 => \Pi (m : Nat) -> m <= n -> \Pi (a2 : M.E) ->
      M.validN m (M.op a1 a2) -> P.upred_holds m a2 -> Q.upred_holds m (M.op a1 a2)
  | upred_mono => \lam n1 n2 x1 x2 h incl n2_le_n1 m m_le_n2 a2 hv hp =>
      \let
        | inclN_x1x2 : inclN {M} {\new Op M.E { | op => M.op }} x1 m x2 =>
          inclN_le x1 x2 n2 m incl m_le_n2
        | hv_x1a2 : M.validN m (M.op x1 a2) =>
          cmra_validN_includedN {M} m (M.op x1 a2) (M.op x2 a2) hv (inclN_op_r m x1 x2 a2 inclN_x1x2)
      \in Q.upred_mono m m (M.op x1 a2) (M.op x2 a2)
          (h m (NatSemiring.<=∘ m_le_n2 n2_le_n1) a2 hv_x1a2 hp)
          (inclN_op_r m x1 x2 a2 inclN_x1x2)
          <=-refl


\func mkProperLater {M : UCMRA} (P : ProperUPred M) : ProperUPred M \cowith
  | upred_holds => \lam n a => \case n \with {
    | 0 => \Sigma
    | suc n' => P.upred_holds n' a
  }
  | upred_mono => \lam n1 n2 x1 x2 h incl n2_le_n1 => \case \elim n1, \elim n2, h, incl, n2_le_n1 \with {
    | _, 0, _, _, _ => ()
    | 0, suc n2', _, _, le => absurd (le NatOrder.zero<suc)
    | suc n1', suc n2', h_p, incl', le =>
      P.upred_mono n1' n2' x1 x2 h_p
          (inclN_le x1 x2 (suc n2') n2' incl' (n<=sucn n2'))
          (suc<=suc.conv le)
  }

-- Iris's except-zero modality: `◇ P := ▷ False ∨ P`.
\func mkProperExceptZero {M : UCMRA} (P : ProperUPred M) : ProperUPred M =>
  mkProperOr (mkProperLater (mkProperPure Empty)) P

\func mkProperPersistently {M : UCMRA} (P : ProperUPred M) : ProperUPred M \cowith
  | upred_holds => \lam n a => \Pi (m : Nat) -> m <= n -> \Pi (b : M.E) ->
      inclN {M} {\new Op M.E { | op => M.op }} M.unit m b -> P.upred_holds m b
  | upred_mono => \lam n1 n2 x1 x2 h incl n2_le_n1 m m_le_n2 b unit_incl_b =>
      h m (NatSemiring.<=∘ m_le_n2 n2_le_n1) b unit_incl_b


\instance BIuPred (M : UCMRA) : BIBase \cowith
  | E => ProperUPred M
  | <= => properUPred_ent
  | <=-refl => \lam n a _ h => h
  | <=-transitive => \lam h1 h2 n a hv hp => h2 n a hv (h1 n a hv hp)
  | bi_emp => mkProperEmp
  | bi_pure => mkProperPure
  | bi_and => mkProperAnd
  | bi_or => mkProperOr
  | bi_impl => mkProperImpl
  | bi_forall => mkProperForall
  | bi_exist => mkProperExist
  | bi_sep => mkProperSep
  | bi_wand => mkProperWand
  | bi_persistently => mkProperPersistently
  | bi_later => mkProperLater


-- =================================================================================
-- OFE and COFE for ProperUPred
-- =================================================================================


\lemma proper_forall_mono {M : UCMRA} {T : \Type} (Phi Psi : T -> ProperUPred M)
                          (h : \Pi (t : T) -> properUPred_ent (Phi t) (Psi t))
  : properUPred_ent (mkProperForall T Phi) (mkProperForall T Psi)
  => \lam n a hv hPhi t => h t n a hv (hPhi t)

\lemma proper_and_mono_r {M : UCMRA} (P Q Q' : ProperUPred M)
                         (h : properUPred_ent Q Q') : properUPred_ent (mkProperAnd P Q) (mkProperAnd P Q')
  => \lam n a hv hPQ => (hPQ.1, h n a hv hPQ.2)

\lemma proper_later_mono {M : UCMRA} (P Q : ProperUPred M)
                         (h : properUPred_ent P Q) : properUPred_ent (mkProperLater P) (mkProperLater Q)
  => \lam n a hv hP => \case \elim n, hv, hP \with {
    | 0, _, _ => ()
    | suc n', hv', hP' => h n' a (M.cmra_validN_le (suc n') n' a hv' (n<=sucn n')) hP'
  }

\lemma proper_impl_mono_r {M : UCMRA} (P Q Q' : ProperUPred M)
                          (h : properUPred_ent Q Q') : properUPred_ent (mkProperImpl P Q) (mkProperImpl P Q')
  => \lam n a hv himpl m m_le_n b incl_a_b hv_b hp =>
      h m b hv_b (himpl m m_le_n b incl_a_b hv_b hp)

-- =================================================================================
-- OFE and COFE for ProperUPred
-- =================================================================================


\func upredDist {M : UCMRA} (n : Nat) (P Q : ProperUPred M) : \Prop =>
  \Pi (m : Nat) (a : M.E) -> m <= n -> M.validN m a ->
  \Sigma (P.upred_holds m a -> Q.upred_holds m a)
         (Q.upred_holds m a -> P.upred_holds m a)

\func upredEquiv {M : UCMRA} (P Q : ProperUPred M) : \Prop =>
  \Pi (n : Nat) (a : M.E) -> M.validN n a ->
  \Sigma (P.upred_holds n a -> Q.upred_holds n a)
         (Q.upred_holds n a -> P.upred_holds n a)

\func UPredOFE (M : UCMRA) : OFE \cowith
  | E => ProperUPred M
  | dist => upredDist
  | equiv => upredEquiv
  | equiv_refl P n a _ => (\lam h => h, \lam h => h)
  | equiv_sym P Q h n a hv =>
    \let r => h n a hv \in (r.2, r.1)
  | equiv_trans P Q R h1 h2 n a hv =>
    \let pq => h1 n a hv | qr => h2 n a hv
    \in (\lam hp => qr.1 (pq.1 hp), \lam hr => pq.2 (qr.2 hr))
  | ofe_equiv_dist => \lam P Q => (
    \lam heq n m a hle hv => heq m a hv,
    \lam hd n a hv => hd n n a <=-refl hv
  )
  | ofe_dist_refl => \lam n P m a _ _ => (\lam h => h, \lam h => h)
  | ofe_dist_sym => \lam n P Q hPQ m a hle hv =>
      \let r => hPQ m a hle hv \in (r.2, r.1)
  | ofe_dist_trans => \lam n P Q R hPQ hQR m a hle hv =>
      \let pq => hPQ m a hle hv
           | qr => hQR m a hle hv
      \in (\lam hp => qr.1 (pq.1 hp), \lam hr => pq.2 (qr.2 hr))
  | ofe_dist_le => \lam n k P Q h hle m a hm hv =>
      h m a (NatSemiring.<=∘ hm hle) hv


\func upred_compl {M : UCMRA} (c : Nat -> ProperUPred M) (hc : Chain {UPredOFE M} c)
  : ProperUPred M \cowith
  | upred_holds => \lam n a =>
      \Pi (n' : Nat) -> n' <= n -> M.validN n' a -> (c n').upred_holds n' a
  | upred_mono => \lam n1 n2 x1 x2 h hincl le n' n'_le_n2 hv' =>
          (c n').upred_mono n' n' x1 x2
          (h n' (NatSemiring.<=∘ n'_le_n2 le)
              (cmra_validN_includedN {M} n' x1 x2 hv'
                  (inclN_le {M} {\new Op M.E { | op => M.op }} x1 x2 n2 n' hincl n'_le_n2)))
          (inclN_le {M} {\new Op M.E { | op => M.op }} x1 x2 n2 n' hincl n'_le_n2)
          <=-refl


\func UPredCOFE (M : UCMRA) : COFE \cowith
  | OFE => UPredOFE M
  | compl => upred_compl
  | cofe_conv_compl => \lam c hc n m a hle hv =>
      ( \lam h => (hc.chain_cauchy m n hle m a <=-refl hv).2 (h m <=-refl hv)
      , \lam h => \lam n' n'_le_m hv' =>
          (hc.chain_cauchy n' n (NatSemiring.<=∘ n'_le_m hle) n' a <=-refl hv').1
              ((c n).upred_mono m n' a a h
                  (inP (M.unit,
                      M.ofe_dist_trans n' a a (M.op a M.unit)
                        (M.ofe_dist_refl n' a)
                        (M.ofe_dist_sym n' (M.op a M.unit) a (ucmra_unit_right_id_dist n' a))))
                  n'_le_m)
      )



-- =================================================================================
-- Non-expansiveness helpers for upredDist
-- =================================================================================


\lemma upredDist_le {M : UCMRA} (n k : Nat) (P Q : ProperUPred M)
                    (h : upredDist n P Q) (hle : k <= n) : upredDist k P Q =>
  \lam m a hm hv => h m a (NatSemiring.<=∘ hm hle) hv

\lemma upredDist_later {M : UCMRA} (n : Nat) (P Q : ProperUPred M)
                       (h : \Pi (k : Nat) -> k NatOrder.< n -> upredDist k P Q)
  : upredDist n (mkProperLater P) (mkProperLater Q) =>
  \lam m a hm hv => \case \elim m, hm, hv \with {
    | 0, _, _ => (\lam _ => (), \lam _ => ())
    | suc m', hm', hv' =>
      \let r => h m' (suc_<=_< hm') m' a <=-refl
                    (M.cmra_validN_le (suc m') m' a hv' (n<=sucn m'))
      \in (r.1, r.2)
  }

\lemma upredDist_forall {M : UCMRA} (T : \Type) (n : Nat)
                        (F G : T -> ProperUPred M)
                        (h : \Pi (t : T) -> upredDist n (F t) (G t))
  : upredDist n (mkProperForall T F) (mkProperForall T G) =>
  \lam m a hm hv =>
      ( \lam hF t => (h t m a hm hv).1 (hF t)
      , \lam hG t => (h t m a hm hv).2 (hG t)
      )

\lemma upredDist_or_r {M : UCMRA} (n : Nat) (R P Q : ProperUPred M)
                      (h : upredDist n P Q)
  : upredDist n (mkProperOr R P) (mkProperOr R Q) =>
  \lam m a hm hv =>
      ( \lam hRP => \case hRP \with {
          | byLeft hr => byLeft hr
          | byRight hp => byRight ((h m a hm hv).1 hp)
        }
      , \lam hRQ => \case hRQ \with {
          | byLeft hr => byLeft hr
          | byRight hq => byRight ((h m a hm hv).2 hq)
        }
      )

\lemma upredDist_except_zero {M : UCMRA} (n : Nat) (P Q : ProperUPred M)
                             (h : upredDist n P Q)
  : upredDist n (mkProperExceptZero P) (mkProperExceptZero Q) =>
  upredDist_or_r n (mkProperLater (mkProperPure Empty)) P Q h

\lemma upredDist_impl_r {M : UCMRA} (n : Nat) (P Q Q' : ProperUPred M)
                        (h : upredDist n Q Q')
  : upredDist n (mkProperImpl P Q) (mkProperImpl P Q') =>
  \lam m a hm hv =>
      ( \lam himpl k k_le_m b incl_a_b hv_b hp =>
          (h k b (NatSemiring.<=∘ k_le_m hm) hv_b).1
            (himpl k k_le_m b incl_a_b hv_b hp)
      , \lam himpl k k_le_m b incl_a_b hv_b hp =>
          (h k b (NatSemiring.<=∘ k_le_m hm) hv_b).2
            (himpl k k_le_m b incl_a_b hv_b hp)
      )

\lemma upredDist_sep_r {M : UCMRA} (n : Nat) (R P Q : ProperUPred M)
                       (h : upredDist n P Q)
  : upredDist n (mkProperSep R P) (mkProperSep R Q) =>
  \lam m a hm hv =>
      ( \lam hsep => \case hsep \with {
          | inP (a1, a2, dist_a, hr, hp) =>
            \let
              | hv_op : M.validN m (M.op a1 a2) =>
                M.cmra_validN_ne m a (M.op a1 a2) dist_a hv
              | hv_a2 : M.validN m a2 =>
                cmra_validN_op_r {M} m a1 a2 hv_op
            \in inP (a1, a2, dist_a, hr, (h m a2 hm hv_a2).1 hp)
        }
      , \lam hsep => \case hsep \with {
          | inP (a1, a2, dist_a, hr, hq) =>
            \let
              | hv_op : M.validN m (M.op a1 a2) =>
                M.cmra_validN_ne m a (M.op a1 a2) dist_a hv
              | hv_a2 : M.validN m a2 =>
                cmra_validN_op_r {M} m a1 a2 hv_op
            \in inP (a1, a2, dist_a, hr, (h m a2 hm hv_a2).2 hq)
        }
      )

\lemma upredDist_and_r {M : UCMRA} (n : Nat) (R P Q : ProperUPred M)
                       (h : upredDist n P Q)
  : upredDist n (mkProperAnd R P) (mkProperAnd R Q) =>
  \lam m a hm hv =>
      ( \lam hRP => (hRP.1, (h m a hm hv).1 hRP.2)
      , \lam hRQ => (hRQ.1, (h m a hm hv).2 hRQ.2)
      )

\lemma upredDist_wand_r {M : UCMRA} (n : Nat) (R P Q : ProperUPred M)
                        (h : upredDist n P Q)
  : upredDist n (mkProperWand R P) (mkProperWand R Q) =>
  \lam m a hm hv =>
      ( \lam hwand k k_le_m a2 hv_op hr =>
          (h k (M.op a a2) (NatSemiring.<=∘ k_le_m hm) hv_op).1
            (hwand k k_le_m a2 hv_op hr)
      , \lam hwand k k_le_m a2 hv_op hr =>
          (h k (M.op a a2) (NatSemiring.<=∘ k_le_m hm) hv_op).2
            (hwand k k_le_m a2 hv_op hr)
      )


-- =================================================================================
-- uPred updates
-- =================================================================================

\func mkProperBUpd {M : UCMRA} (P : ProperUPred M) : ProperUPred M \cowith
  | upred_holds => \lam n a =>
      \Pi (k : Nat) -> k <= n -> \Pi (yf : M.E) ->
          M.validN k (M.op a yf) ->
          TruncP (\Sigma (a' : M.E) (M.validN k (M.op a' yf)) (P.upred_holds k a'))
  | upred_mono => \lam n1 n2 x1 x2 h incl n2_le_n1 k k_le_n2 yf hv =>
      \case incl \with {
        | inP (x3, dist_x2_x1x3) =>
          \let
            | k_le_n1 : k <= n1 => NatSemiring.<=∘ k_le_n2 n2_le_n1
            | dist_x2_x1x3_k : M.dist k x2 (M.op x1 x3) =>
              M.ofe_dist_le n2 k x2 (M.op x1 x3) dist_x2_x1x3 k_le_n2
            | dist_op_yf : M.dist k (M.op x2 yf) (M.op (M.op x1 x3) yf) =>
              M.cmra_op_ne_2 yf k x2 (M.op x1 x3) dist_x2_x1x3_k
            | hv_x1x3_yf : M.validN k (M.op (M.op x1 x3) yf) =>
              M.cmra_validN_ne k (M.op x2 yf) (M.op (M.op x1 x3) yf) dist_op_yf hv
            | hv_x1_x3yf : M.validN k (M.op x1 (M.op x3 yf)) =>
              cmra_validN_proper {M} k (M.op (M.op x1 x3) yf) (M.op x1 (M.op x3 yf))
                (M.equiv_sym (M.op x1 (M.op x3 yf)) (M.op (M.op x1 x3) yf)
                  (M.cmra_assoc x1 x3 yf)) hv_x1x3_yf
            | step => h k k_le_n1 (M.op x3 yf) hv_x1_x3yf
          \in \case step \with {
            | inP (a', hv_a'_x3yf, hp_a') =>
              \let
                | hv_a'x3_yf : M.validN k (M.op (M.op a' x3) yf) =>
                  cmra_validN_proper {M} k (M.op a' (M.op x3 yf)) (M.op (M.op a' x3) yf)
                    (M.cmra_assoc a' x3 yf) hv_a'_x3yf
              \in inP (M.op a' x3, hv_a'x3_yf,
                       P.upred_mono k k a' (M.op a' x3) hp_a'
                           (inclN_op_l k a' x3) <=-refl)
          }
      }


-- =================================================================================
-- Derived laws for primitive ownership
-- =================================================================================


\lemma own_op_1 {M : UCMRA} (a b : M.E)
  : properUPred_ent (mkProperOwn (M.op a b)) (mkProperSep (mkProperOwn a) (mkProperOwn b)) =>
  \lam n x _ h_incl => \case h_incl \with {
    | inP (z, dist_x_abz) =>
      \let
        | dist_x_a_bz : M.dist n x (M.op a (M.op b z)) =>
          M.ofe_dist_trans n x (M.op (M.op a b) z) (M.op a (M.op b z))
            dist_x_abz
            (M.ofe_dist_sym n (M.op a (M.op b z)) (M.op (M.op a b) z)
              (cmra_assoc_dist n a b z))
      \in inP (a, M.op b z, dist_x_a_bz,
               inclN_refl_ucmra n a,
               inclN_op_l n b z)
  }

\lemma own_op_2 {M : UCMRA} (a b : M.E)
  : properUPred_ent (mkProperSep (mkProperOwn a) (mkProperOwn b)) (mkProperOwn (M.op a b)) =>
  \lam n x _ h_sep => \case h_sep \with {
    | inP (x1, x2, dist_x_x1x2, h_a_x1, h_b_x2) =>
      \case h_a_x1, h_b_x2 \with {
        | inP (z1, dist_x1_az1), inP (z2, dist_x2_bz2) =>
          \let
            | step1 : M.dist n (M.op x1 x2) (M.op (M.op a z1) x2) =>
              M.cmra_op_ne_2 x2 n x1 (M.op a z1) dist_x1_az1
            | step2 : M.dist n (M.op (M.op a z1) x2) (M.op (M.op a z1) (M.op b z2)) =>
              M.cmra_op_ne (M.op a z1) n x2 (M.op b z2) dist_x2_bz2
            | dist_x_full : M.dist n x (M.op (M.op a z1) (M.op b z2)) =>
              M.ofe_dist_trans n x (M.op x1 x2) (M.op (M.op a z1) (M.op b z2))
                  dist_x_x1x2
                  (M.ofe_dist_trans n (M.op x1 x2) (M.op (M.op a z1) x2)
                      (M.op (M.op a z1) (M.op b z2))
                      step1 step2)
            -- (a · z1) · (b · z2) ≡ (a · b) · (z1 · z2), by assoc/comm shuffling.
            | reassoc : M.equiv (M.op (M.op a z1) (M.op b z2)) (M.op (M.op a b) (M.op z1 z2)) =>
              M.equiv_trans (M.op (M.op a z1) (M.op b z2)) (M.op a (M.op z1 (M.op b z2))) (M.op (M.op a b) (M.op z1 z2))
                (M.equiv_sym (M.op a (M.op z1 (M.op b z2))) (M.op (M.op a z1) (M.op b z2))
                  (M.cmra_assoc a z1 (M.op b z2)))
                (M.equiv_trans (M.op a (M.op z1 (M.op b z2))) (M.op a (M.op (M.op z1 b) z2)) (M.op (M.op a b) (M.op z1 z2))
                  (op_proper_l {M} (M.cmra_assoc z1 b z2))
                  (M.equiv_trans (M.op a (M.op (M.op z1 b) z2)) (M.op a (M.op (M.op b z1) z2)) (M.op (M.op a b) (M.op z1 z2))
                    (op_proper_l {M} (op_proper_r {M} (M.cmra_comm z1 b)))
                    (M.equiv_trans (M.op a (M.op (M.op b z1) z2)) (M.op a (M.op b (M.op z1 z2))) (M.op (M.op a b) (M.op z1 z2))
                      (op_proper_l {M} (M.equiv_sym (M.op b (M.op z1 z2)) (M.op (M.op b z1) z2)
                        (M.cmra_assoc b z1 z2)))
                      (M.cmra_assoc a b (M.op z1 z2)))))
            | dist_x_target : M.dist n x (M.op (M.op a b) (M.op z1 z2)) =>
              M.ofe_dist_trans n x (M.op (M.op a z1) (M.op b z2)) (M.op (M.op a b) (M.op z1 z2))
                dist_x_full
                (equiv_dist {M} reassoc n)
          \in inP (M.op z1 z2, dist_x_target)
      }
  }

\lemma own_mono {M : UCMRA} (a b : M.E)
                (h : incl {M} {\new Op M.E { | op => M.op }} a b)
  : properUPred_ent (mkProperOwn b) (mkProperOwn a) =>
  \lam n x _ h_b_x => \case h, h_b_x \with {
    | inP (z, b_eq), inP (w, dist_x_bw) =>
      \let
        | dist_x_azw : M.dist n x (M.op a (M.op z w)) =>
          \let
            | dist_x_azw_unassoc : M.dist n x (M.op (M.op a z) w) =>
              M.ofe_dist_trans n x (M.op b w) (M.op (M.op a z) w)
                dist_x_bw
                (M.cmra_op_ne_2 w n b (M.op a z) (equiv_dist {M} b_eq n))
          \in M.ofe_dist_trans n x (M.op (M.op a z) w) (M.op a (M.op z w))
                dist_x_azw_unassoc
                (M.ofe_dist_sym n (M.op a (M.op z w)) (M.op (M.op a z) w)
                  (cmra_assoc_dist n a z w))
      \in inP (M.op z w, dist_x_azw)
  }

\lemma own_unit {M : UCMRA}
  : properUPred_ent (mkProperPure (\Sigma)) (mkProperOwn M.unit) =>
  \lam n x _ _ =>
      inP (x,
        M.ofe_dist_trans n x x (M.op M.unit x)
          (M.ofe_dist_refl n x)
          (M.ofe_dist_sym n (M.op M.unit x) x (ucmra_unit_left_id_dist n x)))

\lemma own_valid {M : UCMRA} (a : M.E)
  : properUPred_ent (mkProperOwn a) (mkProperCMRAValid a) =>
  \lam n x hv h_own => cmra_validN_includedN {M} n a x hv h_own


-- =================================================================================
-- Frame-preserving update for ownership
-- =================================================================================
--
-- If `a ~~>: Φ` is a frame-preserving update, then
--
--     ownM a ⊢ |==> ∃ b, ⌜Φ b⌝ ∧ ownM b
--
-- This is the engine that drives invariant allocation in IRIS: every
-- `inv_alloc` / `inv_acc` ultimately bottoms out in a call to this lemma.

\lemma bupd_ownM_updateP {M : UCMRA} (a : M.E) (Phi : M.E -> \Prop)
                         (h : cmra_updateP {M} a Phi)
  : properUPred_ent
      (mkProperOwn a)
      (mkProperBUpd (mkProperExist M.E (\lam b =>
         mkProperAnd (mkProperPure (Phi b)) (mkProperOwn b)))) =>
  \lam n x _ h_own k k_le_n yf hv_op =>
      \case h_own \with {
        | inP (z, dist_x_az) =>
          \let
            | dist_x_az_k : M.dist k x (M.op a z) =>
              M.ofe_dist_le n k x (M.op a z) dist_x_az k_le_n
            | dist_op_yf : M.dist k (M.op x yf) (M.op (M.op a z) yf) =>
              M.cmra_op_ne_2 yf k x (M.op a z) dist_x_az_k
            | hv_az_yf : M.validN k (M.op (M.op a z) yf) =>
              M.cmra_validN_ne k (M.op x yf) (M.op (M.op a z) yf) dist_op_yf hv_op
            | hv_a_zyf : M.validN k (M.op a (M.op z yf)) =>
              cmra_validN_proper {M} k (M.op (M.op a z) yf) (M.op a (M.op z yf))
                (M.equiv_sym (M.op a (M.op z yf)) (M.op (M.op a z) yf)
                  (M.cmra_assoc a z yf)) hv_az_yf
            | step => h k (M.op z yf) hv_a_zyf
          \in \case step \with {
            | inP (b, hPhi, hv_b_zyf) =>
              \let
                | hv_bz_yf : M.validN k (M.op (M.op b z) yf) =>
                  cmra_validN_proper {M} k (M.op b (M.op z yf)) (M.op (M.op b z) yf)
                    (M.cmra_assoc b z yf) hv_b_zyf
                | own_b_at_bz : (mkProperOwn b).upred_holds k (M.op b z) =>
                  inclN_op_l k b z
              \in inP (M.op b z, hv_bz_yf, inP (b, (hPhi, own_b_at_bz)))
          }
      }


-- =================================================================================
-- uPred functor: `uPred_map`, `uPredOF`.
--
-- Port of the "functor" section of Rocq's `base_logic/upred.v`.  `uPred_map`
-- precomposes a predicate with a CMRA morphism; monotonicity of the result
-- needs `cmra_morphism_monoN`, and non-expansiveness needs validN preservation
-- — hence the `CmraMorphism` argument.  `uPredOF` is the (contravariant) OFE
-- bifunctor `A B ↦ uPredO (F B A)` that A4 applies the cofe_solver to.
-- =================================================================================

\func uPred_map {M1 M2 : UCMRA} (f : OFEMor M2 M1) (hf : CmraMorphism f)
                (P : ProperUPred M1) : ProperUPred M2 \cowith
  | upred_holds => \lam n x => P.upred_holds n (f.ofe_mor_car x)
  | upred_mono => \lam n1 n2 x1 x2 h hincl hle =>
      P.upred_mono n1 n2 (f.ofe_mor_car x1) (f.ofe_mor_car x2) h
          (cmra_morphism_monoN hf n2 x1 x2 hincl) hle

\lemma uPred_map_ne {M1 M2 : UCMRA} (f : OFEMor M2 M1) (hf : CmraMorphism f)
                    (n : Nat) (P Q : ProperUPred M1)
                    (h : upredDist n P Q)
  : upredDist n (uPred_map f hf P) (uPred_map f hf Q)
  => \lam m a hm hv => h m (f.ofe_mor_car a) hm (hf.cmra_morphism_validN m a hv)

-- Rocq's `uPredO_map_ne`: `uPred_map` is non-expansive in the morphism itself.
\lemma uPred_map_dist {M1 M2 : UCMRA} (f g : OFEMor M2 M1)
                      (hf : CmraMorphism f) (hg : CmraMorphism g)
                      (n : Nat) (hfg : (OFEMorOFE M2 M1).dist n f g)
                      (P : ProperUPred M1)
  : upredDist n (uPred_map f hf P) (uPred_map g hg P)
  => \lam m a hm hv =>
      \let dfg : M1.dist m (f.ofe_mor_car a) (g.ofe_mor_car a) =>
          M1.ofe_dist_le n m (f.ofe_mor_car a) (g.ofe_mor_car a) (hfg a) hm
      \in
      ( \lam h => P.upred_mono m m (f.ofe_mor_car a) (g.ofe_mor_car a) h
            (inclN_of_dist_unit m (f.ofe_mor_car a) (g.ofe_mor_car a)
                (M1.ofe_dist_sym m (f.ofe_mor_car a) (g.ofe_mor_car a) dfg))
            <=-refl
      , \lam h => P.upred_mono m m (g.ofe_mor_car a) (f.ofe_mor_car a) h
            (inclN_of_dist_unit m (g.ofe_mor_car a) (f.ofe_mor_car a) dfg)
            <=-refl
      )

\lemma uPred_map_id {M : UCMRA} (P : ProperUPred M)
  : upredEquiv (uPred_map ofe_mor_id cmra_morphism_id P) P
  => \lam n a hv => (\lam h => h, \lam h => h)

\lemma uPred_map_compose {M1 M2 M3 : UCMRA} (f : OFEMor M1 M2) (g : OFEMor M2 M3)
                         (hf : CmraMorphism f) (hg : CmraMorphism g)
                         (P : ProperUPred M3)
  : upredEquiv (uPred_map (ofe_mor_comp g f) (cmra_morphism_comp hf hg) P)
               (uPred_map f hf (uPred_map g hg P))
  => \lam n a hv => (\lam h => h, \lam h => h)

\lemma uPred_map_ext {M1 M2 : UCMRA} (f g : OFEMor M2 M1)
                     (hf : CmraMorphism f) (hg : CmraMorphism g)
                     (hfg : \Pi (x : M2.E) -> M1.equiv (f.ofe_mor_car x) (g.ofe_mor_car x))
                     (P : ProperUPred M1)
  : upredEquiv (uPred_map f hf P) (uPred_map g hg P)
  => \lam n a hv =>
      ( \lam h => P.upred_mono n n (f.ofe_mor_car a) (g.ofe_mor_car a) h
            (inclN_of_dist_unit n (f.ofe_mor_car a) (g.ofe_mor_car a)
                (M1.ofe_dist_sym n (f.ofe_mor_car a) (g.ofe_mor_car a)
                    (equiv_dist {M1} (hfg a) n)))
            <=-refl
      , \lam h => P.upred_mono n n (g.ofe_mor_car a) (f.ofe_mor_car a) h
            (inclN_of_dist_unit n (g.ofe_mor_car a) (f.ofe_mor_car a)
                (equiv_dist {M1} (hfg a) n))
            <=-refl
      )

-- =================================================================================
-- uPredOF: `A B ↦ uPredO (F B A)` (note the contravariant flip, as in Rocq).
-- =================================================================================

\func uPredOF (F : URFunctor) : OFunctor \cowith
  | oFunctor_car => \lam A B => UPredOFE (F.urFunctor_car B A)
  | oFunctor_map => \lam {A1} {A2} {B1} {B2} fg => \new OFEMor _ _ {
      | ofe_mor_car =>
          uPred_map (F.urFunctor_map (fg.2, fg.1)) (F.urFunctor_mor (fg.2, fg.1))
      | ofe_mor_ne => \lam n P Q h =>
          uPred_map_ne (F.urFunctor_map (fg.2, fg.1)) (F.urFunctor_mor (fg.2, fg.1))
              n P Q h
    }
  | oFunctor_map_ne => \lam {A1} {A2} {B1} {B2} n fg fg' hfg P =>
      uPred_map_dist
          (F.urFunctor_map (fg.2, fg.1)) (F.urFunctor_map (fg'.2, fg'.1))
          (F.urFunctor_mor (fg.2, fg.1)) (F.urFunctor_mor (fg'.2, fg'.1))
          n
          (F.urFunctor_map_ne n (fg.2, fg.1) (fg'.2, fg'.1) (hfg.2, hfg.1))
          P
  | oFunctor_map_id => \lam {A} {B} P =>
      (UPredOFE (F.urFunctor_car B A)).equiv_trans
          (uPred_map (F.urFunctor_map (ofe_mor_id, ofe_mor_id))
              (F.urFunctor_mor (ofe_mor_id, ofe_mor_id)) P)
          (uPred_map ofe_mor_id cmra_morphism_id P)
          P
          (uPred_map_ext (F.urFunctor_map (ofe_mor_id, ofe_mor_id)) ofe_mor_id
              (F.urFunctor_mor (ofe_mor_id, ofe_mor_id)) cmra_morphism_id
              (\lam x => F.urFunctor_map_id x)
              P)
          (uPred_map_id P)
  | oFunctor_map_compose => \lam {A1} {A2} {A3} {B1} {B2} {B3} f g f' g' P =>
      \let
        | phi1 => F.urFunctor_map (f', f)
        | phi2 => F.urFunctor_map (g', g)
        | phi3 => F.urFunctor_map (ofe_mor_comp g' f', ofe_mor_comp f g)
        | hphi1 => F.urFunctor_mor (f', f)
        | hphi2 => F.urFunctor_mor (g', g)
        | hphi3 => F.urFunctor_mor (ofe_mor_comp g' f', ofe_mor_comp f g)
      \in (UPredOFE (F.urFunctor_car B3 A3)).equiv_trans
          (uPred_map phi2 hphi2 (uPred_map phi1 hphi1 P))
          (uPred_map (ofe_mor_comp phi1 phi2) (cmra_morphism_comp hphi2 hphi1) P)
          (uPred_map phi3 hphi3 P)
          ((UPredOFE (F.urFunctor_car B3 A3)).equiv_sym
              (uPred_map (ofe_mor_comp phi1 phi2) (cmra_morphism_comp hphi2 hphi1) P)
              (uPred_map phi2 hphi2 (uPred_map phi1 hphi1 P))
              (uPred_map_compose phi2 phi1 hphi2 hphi1 P))
          (uPred_map_ext (ofe_mor_comp phi1 phi2) phi3
              (cmra_morphism_comp hphi2 hphi1) hphi3
              (\lam y => F.urFunctor_map_compose g' f' g f y)
              P)

\func uPredOF_contractive (F : URFunctor) (hF : URFunctorContractive F)
  : OFunctorContractive (uPredOF F) \cowith
  | oFunctor_map_contractive => \lam {A1} {A2} {B1} {B2} n fg fg' hfg P =>
      uPred_map_dist
          (F.urFunctor_map (fg.2, fg.1)) (F.urFunctor_map (fg'.2, fg'.1))
          (F.urFunctor_mor (fg.2, fg.1)) (F.urFunctor_mor (fg'.2, fg'.1))
          n
          (hF.urFunctor_map_contractive n (fg.2, fg.1) (fg'.2, fg'.1)
              (\new DistLater {
                | dist_later_lt => \lam m hm =>
                    \let d => hfg.dist_later_lt m hm \in (d.2, d.1)
              }))
          P

-- COFE structure on the functor's carrier (used by the cofe_solver in A4).
\func uPredOF_cofe (F : URFunctor) : OFunctorCOFE (uPredOF F) \cowith
  | oFunctor_cofe => \lam A B => UPredCOFE (F.urFunctor_car B A)
  | oFunctor_cofe_OFE => \lam A B => idp
