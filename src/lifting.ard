-- The fundamental Rocq-shaped lifting rule for the masked generic WP.  A
-- concrete operational step consumes the state interpretation while the mask
-- is changed E -> empty, and returns the successor state/WP under a later and
-- the restoring update empty -> E.
\func wp_step_result {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e2 : Expr)
    (Phi : Value -> iProp S) (sigma2 : State cnt) : iProp S =>
  mkProperFUpd H.iris_wsat E coPset_empty
    (mkProperLater
      (mkProperFUpd H.iris_wsat coPset_empty E
        (mkProperSep (state_interp H sigma2) (wp H E e2 Phi))))

-- Expose the non-value branch of WP after supplying the physical state.  This
-- is the generic analogue of the "step-ready" fact used by adequacy: before a
-- concrete successor is selected, WP already guarantees reducibility and all
-- successor obligations under the E -> empty mask change.
\lemma wp_nonval_ready {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (e : Expr) (Phi : Value -> iProp S) (sigma : State cnt)
    (notVal : to_val e = nothing)
  : properUPred_ent
      (mkProperSep (wp H E e Phi) (state_interp H sigma))
      (mkProperFUpd H.iris_wsat E coPset_empty
        (mkProperAnd (mkProperPure (Reducible e sigma))
          (mkProperLater
            (wp_steps H E (wp H E) e Phi sigma)))) =>
  \lam n a ha hsep =>
  \let M => iResUR S
  \in \scase hsep \with {
    | inP (a_wp, a_state, da, hwp, hstate) =>
      \let
        | ha_parts : M.validN n (M.op a_wp a_state) =>
            M.cmra_validN_ne n a (M.op a_wp a_state) da ha
        | ha_wp : M.validN n a_wp => M.cmra_validN_op_l n a_wp a_state ha_parts
        | unfolded : (wp_pre H E (wp H E) e Phi).upred_holds n a_wp =>
            (wp_unfold H E e Phi n a_wp ha_wp).1 hwp
        | nonval : (wp_nonval H E (wp H E) e Phi).upred_holds n a_wp =>
            transport
              (\lam tv => (wp_pre_body H E (wp H E) e Phi tv)
                .upred_holds n a_wp)
              notVal unfolded
        | onParts : (mkProperFUpd H.iris_wsat E coPset_empty
            (mkProperAnd (mkProperPure (Reducible e sigma))
              (mkProperLater
                (wp_steps H E (wp H E) e Phi sigma))))
            .upred_holds n (M.op a_wp a_state) =>
            nonval sigma n <=-refl a_state ha_parts hstate
        | daUnit : M.dist n a (M.op (M.op a_wp a_state) M.unit) =>
            M.ofe_dist_trans n a (M.op a_wp a_state)
              (M.op (M.op a_wp a_state) M.unit) da
              (M.ofe_dist_sym n (M.op (M.op a_wp a_state) M.unit)
                (M.op a_wp a_state)
                (ucmra_unit_right_id_dist {M} n (M.op a_wp a_state)))
      \in (mkProperFUpd H.iris_wsat E coPset_empty
            (mkProperAnd (mkProperPure (Reducible e sigma))
              (mkProperLater
                (wp_steps H E (wp H E) e Phi sigma))))
          .upred_mono n n (M.op a_wp a_state) a onParts
            (inP (M.unit, daUnit)) <=-refl
  }

\lemma wp_reducible {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (e : Expr) (Phi : Value -> iProp S) (sigma : State cnt)
    (notVal : to_val e = nothing)
  : properUPred_ent
      (mkProperSep (wp H E e Phi) (state_interp H sigma))
      (mkProperFUpd H.iris_wsat E coPset_empty
        (mkProperPure (Reducible e sigma))) =>
  properUPred_ent_trans
    (mkProperSep (wp H E e Phi) (state_interp H sigma))
    (mkProperFUpd H.iris_wsat E coPset_empty
      (mkProperAnd (mkProperPure (Reducible e sigma))
        (mkProperLater
          (wp_steps H E (wp H E) e Phi sigma))))
    (mkProperFUpd H.iris_wsat E coPset_empty
      (mkProperPure (Reducible e sigma)))
    (wp_nonval_ready H E e Phi sigma notVal)
    (fupd_mono H.iris_wsat E coPset_empty
      (mkProperAnd (mkProperPure (Reducible e sigma))
        (mkProperLater
          (wp_steps H E (wp H E) e Phi sigma)))
      (mkProperPure (Reducible e sigma))
      (\lam _ _ _ h => h.1))

\lemma wp_prim_step {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (e e2 : Expr) (Phi : Value -> iProp S)
    (sigma sigma2 : State cnt) (hstep : PrimStep e sigma e2 sigma2)
  : properUPred_ent
      (mkProperSep (wp H E e Phi) (state_interp H sigma))
      (wp_step_result H E e2 Phi sigma2) =>
  \lam n a ha hsep =>
  \let M => iResUR S
  \in \scase hsep \with {
    | inP (a_wp, a_state, da, hwp, hstate) =>
      \let
        | notVal : to_val e = nothing => val_stuck e sigma e2 sigma2 hstep
        | ha_parts : M.validN n (M.op a_wp a_state) =>
            M.cmra_validN_ne n a (M.op a_wp a_state) da ha
        | ha_wp : M.validN n a_wp => M.cmra_validN_op_l n a_wp a_state ha_parts
        | unfolded : (wp_pre H E (wp H E) e Phi).upred_holds n a_wp =>
            (wp_unfold H E e Phi n a_wp ha_wp).1 hwp
        | nonval : (wp_nonval H E (wp H E) e Phi).upred_holds n a_wp =>
            transport
              (\lam tv => (wp_pre_body H E (wp H E) e Phi tv)
                .upred_holds n a_wp)
              notVal unfolded
        | onParts : (mkProperFUpd H.iris_wsat E coPset_empty
            (mkProperAnd (mkProperPure (Reducible e sigma))
              (mkProperLater
                (wp_steps H E (wp H E) e Phi sigma))))
            .upred_holds n (M.op a_wp a_state) =>
            nonval sigma n <=-refl a_state ha_parts hstate
        | daUnit : M.dist n a (M.op (M.op a_wp a_state) M.unit) =>
            M.ofe_dist_trans n a (M.op a_wp a_state)
              (M.op (M.op a_wp a_state) M.unit) da
              (M.ofe_dist_sym n (M.op (M.op a_wp a_state) M.unit)
                (M.op a_wp a_state)
                (ucmra_unit_right_id_dist {M} n (M.op a_wp a_state)))
        | onA : (mkProperFUpd H.iris_wsat E coPset_empty
            (mkProperAnd (mkProperPure (Reducible e sigma))
              (mkProperLater
                (wp_steps H E (wp H E) e Phi sigma))))
            .upred_holds n a =>
            (mkProperFUpd H.iris_wsat E coPset_empty
              (mkProperAnd (mkProperPure (Reducible e sigma))
                (mkProperLater
                  (wp_steps H E (wp H E) e Phi sigma))))
              .upred_mono n n (M.op a_wp a_state) a onParts
                (inP (M.unit, daUnit)) <=-refl
        | core => mkProperAnd (mkProperPure (Reducible e sigma))
            (mkProperLater (wp_steps H E (wp H E) e Phi sigma))
        | target => mkProperLater
            (mkProperFUpd H.iris_wsat coPset_empty E
              (mkProperSep (state_interp H sigma2)
                (wp H E e2 Phi)))
      \in fupd_mono H.iris_wsat E coPset_empty core target
        (\lam n' x hx hand =>
          \case n' \as k, hx \as hx' : M.validN k x,
              hand \as hand' : core.upred_holds k x
            \return target.upred_holds k x
          \with {
            | 0, _, _ => ()
            | suc k, hx', hand' =>
              \let hsteps : (wp_steps H E (wp H E) e Phi sigma)
                    .upred_holds k x => hand'.2
              \in hsteps e2 sigma2 k <=-refl x
                (inP (M.unit,
                  M.ofe_dist_sym k (M.op x M.unit) x
                    (ucmra_unit_right_id_dist {M} k x)))
                (M.cmra_validN_le (suc k) k x hx' (n<=sucn k))
                hstep
          }) n a ha onA
  }

-- A same-mask fancy update in front of WP can be absorbed by WP.  In the
-- non-value branch the update is framed with the physical state, then
-- composed with the ordinary step-readiness rule.  This is Rocq Iris'
-- `fupd_wp`, stated directly for the concrete uPred model.
\lemma fupd_wp_pre {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (e : Expr) (Phi : Value -> iProp S)
    (tv : Maybe Value) (peq : to_val e = tv)
    (n : Nat) (x : iResUR S) (hx : (iResUR S).validN n x)
    (hf : (mkProperFUpd H.iris_wsat E E (wp H E e Phi)).upred_holds n x)
  : (wp_pre_body H E (wp H E) e Phi tv).upred_holds n x
  \elim tv
        | just v =>
          \let
            | nested : (mkProperFUpd H.iris_wsat E E
                (mkProperFUpd H.iris_wsat E E (Phi v)))
                .upred_holds n x =>
                fupd_mono H.iris_wsat E E
                  (wp H E e Phi)
                  (mkProperFUpd H.iris_wsat E E (Phi v))
                  (\lam k a ha hwp =>
                    transport
                      (\lam ee => (wp H E ee Phi).upred_holds k a ->
                        (mkProperFUpd H.iris_wsat E E (Phi v)).upred_holds k a)
                      (of_to_val e v peq)
                      (\lam hval => wp_value_elim H E v Phi k a ha hval)
                      hwp)
                  n x hx hf
          \in fupd_trans H.iris_wsat E E E (Phi v) n x hx nested
        | nothing =>
          \let
            | Core : State cnt -> iProp S => \lam sigma =>
                mkProperAnd (mkProperPure (Reducible e sigma))
                  (mkProperLater
                    (wp_steps H E (wp H E) e Phi sigma))
            | ready : \Pi (sigma : State cnt) -> properUPred_ent
                (mkProperSep (wp H E e Phi) (state_interp H sigma))
                (mkProperFUpd H.iris_wsat E coPset_empty (Core sigma)) =>
                \lam sigma => wp_nonval_ready H E e Phi sigma peq
            | absorb : \Pi (sigma : State cnt) -> properUPred_ent
                (mkProperSep
                  (mkProperFUpd H.iris_wsat E E (wp H E e Phi))
                  (state_interp H sigma))
                (mkProperFUpd H.iris_wsat E coPset_empty (Core sigma)) =>
                \lam sigma => properUPred_ent_trans
                  (mkProperSep
                    (mkProperFUpd H.iris_wsat E E (wp H E e Phi))
                    (state_interp H sigma))
                  (mkProperFUpd H.iris_wsat E E
                    (mkProperSep (wp H E e Phi)
                      (state_interp H sigma)))
                  (mkProperFUpd H.iris_wsat E coPset_empty (Core sigma))
                  (fupd_frame_r H.iris_wsat E E
                    (wp H E e Phi) (state_interp H sigma))
                  (properUPred_ent_trans
                    (mkProperFUpd H.iris_wsat E E
                      (mkProperSep (wp H E e Phi)
                        (state_interp H sigma)))
                    (mkProperFUpd H.iris_wsat E E
                      (mkProperFUpd H.iris_wsat E coPset_empty (Core sigma)))
                    (mkProperFUpd H.iris_wsat E coPset_empty (Core sigma))
                    (fupd_mono H.iris_wsat E E
                      (mkProperSep (wp H E e Phi)
                        (state_interp H sigma))
                      (mkProperFUpd H.iris_wsat E coPset_empty (Core sigma))
                      (ready sigma))
                    (fupd_trans H.iris_wsat E E coPset_empty (Core sigma)))
          \in \lam sigma m mle frame hop hstate =>
                absorb sigma m ((iResUR S).op x frame) hop
                  (inP (x, frame,
                    (iResUR S).ofe_dist_refl m
                      ((iResUR S).op x frame),
                    (mkProperFUpd H.iris_wsat E E (wp H E e Phi))
                      .upred_mono n m x x hf
                        (inclN_refl_ucmra {iResUR S} m x) mle,
                    hstate))

\lemma fupd_wp {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (e : Expr) (Phi : Value -> iProp S)
  : properUPred_ent
      (mkProperFUpd H.iris_wsat E E (wp H E e Phi))
      (wp H E e Phi) =>
  \lam n x hx hf =>
  \let hpre => fupd_wp_pre H E e Phi (to_val e) idp n x hx hf
  \in (wp_unfold H E e Phi n x hx).2 hpre

-- Evaluation-context postcondition used by `wp_bind`.
\func wp_bind_post {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (K : Ectx)
    (Phi : Value -> iProp S) : Value -> iProp S =>
  \lam v => wp H E (fill K (Val v)) Phi

\func wp_bind_pre_zero {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (K : Ectx)
    (e : Expr) (Phi : Value -> iProp S)
    (tv : Maybe Value) (peq : to_val e = tv)
    (x : iResUR S) (hx : (iResUR S).validN 0 x)
    (hp : (wp_pre_body H E (wp H E) e
      (wp_bind_post H E K Phi) tv).upred_holds 0 x)
  : (wp_pre H E (wp H E) (fill K e) Phi).upred_holds 0 x
  \elim tv
  | just v =>
    \let
      | hwp : (wp H E (fill K (Val v)) Phi).upred_holds 0 x =>
          fupd_wp H E (fill K (Val v)) Phi 0 x hx hp
      | e_eq : Val v = e => of_to_val e v peq
      | fill_eq : fill K (Val v) = fill K e =>
          pmap (\lam ee => fill K ee) e_eq
    \in transport
      (\lam ee => (wp_pre H E (wp H E) ee Phi).upred_holds 0 x)
      fill_eq
      ((wp_unfold H E (fill K (Val v)) Phi 0 x hx).1 hwp)
  | nothing =>
    \let
      | no_fill : to_val (fill K e) = nothing => fill_not_val K e peq
      | SrcCore : State cnt -> iProp S => \lam sigma =>
          mkProperAnd (mkProperPure (Reducible e sigma))
            (mkProperLater
              (wp_steps H E (wp H E) e
                (wp_bind_post H E K Phi) sigma))
      | TgtCore : State cnt -> iProp S => \lam sigma =>
          mkProperAnd (mkProperPure (Reducible (fill K e) sigma))
            (mkProperLater
              (wp_steps H E (wp H E) (fill K e) Phi sigma))
      | core_map : \Pi (sigma : State cnt) ->
          properUPred_ent_at 0 (SrcCore sigma) (TgtCore sigma) =>
          \lam sigma r r_le_0 a ha hcore =>
            \case \elim r, r_le_0, ha, hcore \with {
              | 0, _, _, hcore0 =>
                (reducible_fill K e sigma hcore0.1, ())
              | suc r', le, _, _ => absurd (le NatOrder.zero<suc)
            }
      | target_none : (wp_pre_body H E (wp H E)
          (fill K e) Phi nothing).upred_holds 0 x =>
          \lam sigma m m_le_0 frame hx_frame hstate =>
            fupd_mono_at H.iris_wsat 0 E coPset_empty
              (SrcCore sigma) (TgtCore sigma) (core_map sigma)
              m m_le_0 ((iResUR S).op x frame) hx_frame
              (hp sigma m m_le_0 frame hx_frame hstate)
    \in transport
      (\lam tv' => (wp_pre_body H E (wp H E)
        (fill K e) Phi tv').upred_holds 0 x)
      (inv no_fill) target_none

\func wp_bind_pre_step {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (K : Ectx)
    (e : Expr) (Phi : Value -> iProp S) (n : Nat)
    (tv : Maybe Value) (peq : to_val e = tv)
    (x : iResUR S) (hx : (iResUR S).validN (suc n) x)
    (hp : (wp_pre_body H E (wp H E) e
      (wp_bind_post H E K Phi) tv).upred_holds (suc n) x)
    (ih : \Pi (k : Nat) -> k <= n -> \Pi (e' : Expr) (a : iResUR S) ->
      (iResUR S).validN k a ->
      (wp H E e' (wp_bind_post H E K Phi)).upred_holds k a ->
      (wp H E (fill K e') Phi).upred_holds k a)
  : (wp_pre H E (wp H E) (fill K e) Phi)
      .upred_holds (suc n) x
  \elim tv
  | just v =>
    \let
      | hwp : (wp H E (fill K (Val v)) Phi).upred_holds (suc n) x =>
          fupd_wp H E (fill K (Val v)) Phi (suc n) x hx hp
      | e_eq : Val v = e => of_to_val e v peq
      | fill_eq : fill K (Val v) = fill K e =>
          pmap (\lam ee => fill K ee) e_eq
    \in transport
      (\lam ee => (wp_pre H E (wp H E) ee Phi)
        .upred_holds (suc n) x)
      fill_eq
      ((wp_unfold H E (fill K (Val v)) Phi (suc n) x hx).1 hwp)
  | nothing =>
    \let
      | M => iResUR S
      | no_fill : to_val (fill K e) = nothing => fill_not_val K e peq
      | SrcCore : State cnt -> iProp S => \lam sigma =>
          mkProperAnd (mkProperPure (Reducible e sigma))
            (mkProperLater
              (wp_steps H E (wp H E) e
                (wp_bind_post H E K Phi) sigma))
      | TgtCore : State cnt -> iProp S => \lam sigma =>
          mkProperAnd (mkProperPure (Reducible (fill K e) sigma))
            (mkProperLater
              (wp_steps H E (wp H E) (fill K e) Phi sigma))
      | core_map : \Pi (sigma : State cnt) ->
          properUPred_ent_at (suc n) (SrcCore sigma) (TgtCore sigma) =>
          \lam sigma r r_le_sn a ha hcore =>
            \case \elim r, r_le_sn, ha, hcore \with {
              | 0, _, _, hcore0 =>
                (reducible_fill K e sigma hcore0.1, ())
              | suc r', r_le_sn', ha', hcore' =>
                \let
                  | r'_le_n : r' <= n => suc<=suc.conv r_le_sn'
                  | source_steps : (wp_steps H E (wp H E) e
                      (wp_bind_post H E K Phi) sigma)
                      .upred_holds r' a => hcore'.2
                  | target_steps : (wp_steps H E (wp H E)
                      (fill K e) Phi sigma).upred_holds r' a =>
                      \lam e2 sigma2 j j_le_r' c incl_c hc hstep_fill =>
                        \case fill_step_inv K e sigma e2 sigma2 peq hstep_fill \with {
                          | inP (e2', e2_eq, hstep_inner) =>
                            \let
                              | source_result : (mkProperFUpd H.iris_wsat
                                  coPset_empty E
                                  (mkProperSep (state_interp H sigma2)
                                    (wp H E e2'
                                      (wp_bind_post H E K Phi))))
                                  .upred_holds j c =>
                                  source_steps e2' sigma2 j j_le_r' c
                                    incl_c hc hstep_inner
                              | wp_map : properUPred_ent_at n
                                  (wp H E e2'
                                    (wp_bind_post H E K Phi))
                                  (wp H E e2 Phi) =>
                                  \lam q q_le_n d hd hwp_inner =>
                                    transport
                                      (\lam ee => (wp H E ee Phi)
                                        .upred_holds q d)
                                      (inv e2_eq)
                                      (ih q q_le_n e2' d hd hwp_inner)
                              | result_map : properUPred_ent_at n
                                  (mkProperSep (state_interp H sigma2)
                                    (wp H E e2'
                                      (wp_bind_post H E K Phi)))
                                  (mkProperSep (state_interp H sigma2)
                                    (wp H E e2 Phi)) =>
                                  sep_mono_r_at n (state_interp H sigma2)
                                    (wp H E e2'
                                      (wp_bind_post H E K Phi))
                                    (wp H E e2 Phi) wp_map
                            \in fupd_mono_at H.iris_wsat n coPset_empty E
                              (mkProperSep (state_interp H sigma2)
                                (wp H E e2'
                                  (wp_bind_post H E K Phi)))
                              (mkProperSep (state_interp H sigma2)
                                (wp H E e2 Phi)) result_map
                              j ((NatSemiring.<=∘) j_le_r' r'_le_n)
                              c hc source_result
                        }
                \in (reducible_fill K e sigma hcore'.1, target_steps)
            }
      | target_none : (wp_pre_body H E (wp H E)
          (fill K e) Phi nothing).upred_holds (suc n) x =>
          \lam sigma m m_le_sn frame hx_frame hstate =>
            fupd_mono_at H.iris_wsat (suc n) E coPset_empty
              (SrcCore sigma) (TgtCore sigma) (core_map sigma)
              m m_le_sn (M.op x frame) hx_frame
              (hp sigma m m_le_sn frame hx_frame hstate)
    \in transport
      (\lam tv' => (wp_pre_body H E (wp H E)
        (fill K e) Phi tv').upred_holds (suc n) x)
      (inv no_fill) target_none

\func wp_bind_at_le {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (K : Ectx)
    (Phi : Value -> iProp S) (N n : Nat) (n_le_N : n <= N)
    (e : Expr) (x : iResUR S) (hx : (iResUR S).validN n x)
    (hp : (wp H E e (wp_bind_post H E K Phi)).upred_holds n x)
  : (wp H E (fill K e) Phi).upred_holds n x
  \elim N
  | 0 => \case \elim n, n_le_N, hx, hp \with {
      | 0, _, hx0, hp0 =>
        \let
          | source_pre => (wp_unfold H E e
              (wp_bind_post H E K Phi) 0 x hx0).1 hp0
          | target_pre => wp_bind_pre_zero H E K e Phi
              (to_val e) idp x hx0 source_pre
        \in (wp_unfold H E (fill K e) Phi 0 x hx0).2 target_pre
      | suc n', le, _, _ => absurd (le NatOrder.zero<suc)
    }
  | suc N' => \case \elim n, n_le_N, hx, hp \with {
      | 0, _, hx0, hp0 =>
        \let
          | source_pre => (wp_unfold H E e
              (wp_bind_post H E K Phi) 0 x hx0).1 hp0
          | target_pre => wp_bind_pre_zero H E K e Phi
              (to_val e) idp x hx0 source_pre
        \in (wp_unfold H E (fill K e) Phi 0 x hx0).2 target_pre
      | suc n', le, hxS, hpS =>
        \let
          | n'_le_N' : n' <= N' => suc<=suc.conv le
          | source_pre => (wp_unfold H E e
              (wp_bind_post H E K Phi) (suc n') x hxS).1 hpS
          | target_pre => wp_bind_pre_step H E K e Phi n'
              (to_val e) idp x hxS source_pre
              (\lam k k_le_n' e' a ha hwp =>
                wp_bind_at_le H E K Phi N' k
                  ((NatSemiring.<=∘) k_le_n' n'_le_N')
                  e' a ha hwp)
        \in (wp_unfold H E (fill K e) Phi (suc n') x hxS).2 target_pre
    }

\lemma wp_bind {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (K : Ectx)
    (e : Expr) (Phi : Value -> iProp S)
  : properUPred_ent
      (wp H E e (wp_bind_post H E K Phi))
      (wp H E (fill K e) Phi) =>
  \lam n x hx hp =>
    wp_bind_at_le H E K Phi n n <=-refl e x hx hp

\lemma wp_bind_item {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (Ki : EctxItem)
    (e : Expr) (Phi : Value -> iProp S)
  : properUPred_ent
      (wp H E e (\lam v => wp H E (fill_item Ki (Val v)) Phi))
      (wp H E (fill_item Ki e) Phi) =>
  wp_bind H E (ConsCtx Ki EmptyCtx) e Phi

-- Constructor form of the non-value WP branch.  Operational lifting lemmas
-- prove this premise and then fold it into WP without reopening the fixpoint.
\lemma wp_nonval_intro {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e : Expr)
    (Phi : Value -> iProp S) (notVal : to_val e = nothing)
  : properUPred_ent (wp_nonval H E (wp H E) e Phi)
      (wp H E e Phi) =>
  \lam n x hx hnonval =>
    (wp_unfold H E e Phi n x hx).2
      (transport
        (\lam tv => (wp_pre_body H E (wp H E) e Phi tv)
          .upred_holds n x)
        (inv notVal) hnonval)

-- Open a smaller mask while retaining the corresponding closing update next
-- to an arbitrary frame.  Operational lifting uses this with E2 = empty: the
-- physical step runs while invariants are unavailable, and its successor
-- consumes the returned empty -> E token before continuing.
\lemma fupd_mask_frame {S : gFunctors} (W : wsatGS S)
    (E1 E2 : coPset) (hsub : coPSubset E2 E1) (P : iProp S)
  : properUPred_ent P
      (mkProperFUpd W E1 E2
        (mkProperSep (mkProperFUpd W E2 E1 mkProperEmp) P)) =>
  properUPred_ent_trans P (mkProperSep mkProperEmp P)
    (mkProperFUpd W E1 E2
      (mkProperSep (mkProperFUpd W E2 E1 mkProperEmp) P))
    ((BIuPredMixin (iResUR S)).bi_mixin_emp_sep_1 P)
    (properUPred_ent_trans
      (mkProperSep mkProperEmp P)
      (mkProperSep
        (mkProperFUpd W E1 E2
          (mkProperFUpd W E2 E1 mkProperEmp)) P)
      (mkProperFUpd W E1 E2
        (mkProperSep (mkProperFUpd W E2 E1 mkProperEmp) P))
      (sep_mono_l_ent mkProperEmp
        (mkProperFUpd W E1 E2
          (mkProperFUpd W E2 E1 mkProperEmp)) P
        (fupd_mask_intro W E1 E2 hsub))
      (fupd_frame_r W E1 E2
        (mkProperFUpd W E2 E1 mkProperEmp) P))

-- Run a basic update while a mask-closing token is framed.  The basic update
-- changes ghost state; afterwards the token restores the invariant mask.
\lemma bupd_close {S : gFunctors} (W : wsatGS S)
    (E : coPset) (P : iProp S)
  : properUPred_ent
      (mkProperSep (mkProperFUpd W coPset_empty E mkProperEmp)
        (mkProperBUpd P))
      (mkProperFUpd W coPset_empty E P) =>
  \let
    | Close => mkProperFUpd W coPset_empty E mkProperEmp
    | close_frame : properUPred_ent (mkProperSep P Close)
        (mkProperFUpd W coPset_empty E P) =>
        properUPred_ent_trans
          (mkProperSep P Close)
          (mkProperFUpd W coPset_empty E
            (mkProperSep P mkProperEmp))
          (mkProperFUpd W coPset_empty E P)
          (fupd_frame_l W coPset_empty E P mkProperEmp)
          (fupd_mono W coPset_empty E
            (mkProperSep P mkProperEmp) P
            (properUPred_ent_trans
              (mkProperSep P mkProperEmp)
              (mkProperSep mkProperEmp P) P
              (sep_comm_ent P mkProperEmp)
              ((BIuPredMixin (iResUR S)).bi_mixin_emp_sep_2 P)))
  \in properUPred_ent_trans
      (mkProperSep Close (mkProperBUpd P))
      (mkProperBUpd (mkProperSep P Close))
      (mkProperFUpd W coPset_empty E P)
      (properUPred_ent_trans
        (mkProperSep Close (mkProperBUpd P))
        (mkProperSep (mkProperBUpd P) Close)
        (mkProperBUpd (mkProperSep P Close))
        (sep_comm_ent Close (mkProperBUpd P))
        (bupd_frame_r P Close))
      (properUPred_ent_trans
        (mkProperBUpd (mkProperSep P Close))
        (mkProperBUpd (mkProperFUpd W coPset_empty E P))
        (mkProperFUpd W coPset_empty E P)
        (bupd_mono (mkProperSep P Close)
          (mkProperFUpd W coPset_empty E P) close_frame)
        (properUPred_ent_trans
          (mkProperBUpd (mkProperFUpd W coPset_empty E P))
          (mkProperFUpd W coPset_empty coPset_empty
            (mkProperFUpd W coPset_empty E P))
          (mkProperFUpd W coPset_empty E P)
          (bupd_fupd W coPset_empty
            (mkProperFUpd W coPset_empty E P))
          (fupd_trans W coPset_empty coPset_empty E P)))

-- Atomic lifting rule specialized to this sequential language.  `R` is the
-- client resource.  Reducibility is established from R and the physical
-- state; every concrete successor may perform a basic ghost update and must
-- return the successor state together with its WP.
\lemma wp_lift_atomic {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e : Expr)
    (Phi : Value -> iProp S) (R : iProp S)
    (notVal : to_val e = nothing)
    (red : \Pi (sigma : State cnt) -> properUPred_ent
      (mkProperSep R (state_interp H sigma))
      (mkProperPure (Reducible e sigma)))
    (step : \Pi (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt) ->
      PrimStep e sigma e2 sigma2 -> properUPred_ent
        (mkProperSep R (state_interp H sigma))
        (mkProperBUpd
          (mkProperSep (state_interp H sigma2) (wp H E e2 Phi))))
  : properUPred_ent R (wp H E e Phi) =>
  properUPred_ent_trans R
    (wp_nonval H E (wp H E) e Phi)
    (wp H E e Phi)
    (\lam n a ha hR sigma m m_le_n frame ha_frame hstate =>
      \let
        | M => iResUR S
        | P => mkProperSep R (state_interp H sigma)
        | Close => mkProperFUpd H.iris_wsat coPset_empty E mkProperEmp
        | Opened => mkProperSep Close P
        | Core => mkProperAnd (mkProperPure (Reducible e sigma))
            (mkProperLater (wp_steps H E (wp H E) e Phi sigma))
        | hp : P.upred_holds m (M.op a frame) =>
            inP (a, frame, M.ofe_dist_refl m (M.op a frame),
              R.upred_mono n m a a hR
                (inclN_refl_ucmra {M} m a) m_le_n,
              hstate)
        | hopened : (mkProperFUpd H.iris_wsat E coPset_empty Opened)
            .upred_holds m (M.op a frame) =>
            fupd_mask_frame H.iris_wsat E coPset_empty
              (coPSubset_empty_l E) P m (M.op a frame) ha_frame hp
        | opened_to_core : properUPred_ent Opened Core =>
            \lam r x hx hs =>
              \let
                | reducible : Reducible e sigma => \case hs \with {
                    | inP (ac, ap, dc, _, hP) =>
                      red sigma r ap
                        (cmra_validN_op_r {M} r ac ap
                          (M.cmra_validN_ne r x (M.op ac ap) dc hx)) hP
                  }
                | laterSteps : (mkProperLater
                    (wp_steps H E (wp H E) e Phi sigma))
                    .upred_holds r x =>
                    \case \elim r, hx, hs \with {
                      | 0, _, _ => ()
                      | suc k, hxk, hsk =>
                        \lam e2 sigma2 j j_le_k c incl_c hc hstep =>
                          \let
                            | hs_j : Opened.upred_holds j c =>
                                Opened.upred_mono (suc k) j x c hsk incl_c
                                  ((NatSemiring.<=∘) j_le_k (n<=sucn k))
                          \in \case hs_j \with {
                            | inP (ac, ap, dc, hclose, hPj) =>
                              bupd_close H.iris_wsat E
                                (mkProperSep (state_interp H sigma2)
                                  (wp H E e2 Phi))
                                j c hc
                                (inP (ac, ap, dc, hclose,
                                  step sigma e2 sigma2 hstep
                                    j ap
                                    (cmra_validN_op_r {M} j ac ap
                                      (M.cmra_validN_ne j c (M.op ac ap)
                                        dc hc))
                                    hPj))
                          }
                    }
              \in (reducible, laterSteps)
      \in fupd_mono H.iris_wsat E coPset_empty Opened Core
        opened_to_core m (M.op a frame) ha_frame hopened)
    (wp_nonval_intro H E e Phi notVal)

-- Generic deterministic pure-step rule.  The state resource is only framed,
-- never updated; the mask token above accounts for the E -> empty -> E cycle
-- required by the invariant-aware WP.
\lemma wp_pure_step {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e e' : Expr)
    (pure : \Pi (sigma : State cnt) -> PrimStep e sigma e' sigma)
    (det : \Pi (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt) ->
      PrimStep e sigma e2 sigma2 -> \Sigma (e2 = e') (sigma2 = sigma))
    (notVal : to_val e = nothing) (Phi : Value -> iProp S)
  : properUPred_ent (wp H E e' Phi) (wp H E e Phi) =>
  properUPred_ent_trans
    (wp H E e' Phi)
    (wp_nonval H E (wp H E) e Phi)
    (wp H E e Phi)
    (\lam n a ha hwp sigma m m_le_n frame ha_frame hstate =>
      \let
        | M => iResUR S
        | P => mkProperSep (wp H E e' Phi) (state_interp H sigma)
        | Close => mkProperFUpd H.iris_wsat coPset_empty E mkProperEmp
        | Opened => mkProperSep Close P
        | Core => mkProperAnd (mkProperPure (Reducible e sigma))
            (mkProperLater (wp_steps H E (wp H E) e Phi sigma))
        | hp : P.upred_holds m (M.op a frame) =>
            inP (a, frame, M.ofe_dist_refl m (M.op a frame),
              (wp H E e' Phi).upred_mono n m a a hwp
                (inclN_refl_ucmra {M} m a) m_le_n,
              hstate)
        | hopened : (mkProperFUpd H.iris_wsat E coPset_empty Opened)
            .upred_holds m (M.op a frame) =>
            fupd_mask_frame H.iris_wsat E coPset_empty
              (coPSubset_empty_l E) P m (M.op a frame) ha_frame hp
        | opened_to_core : properUPred_ent Opened Core =>
            \lam r x hx hs =>
              \let
                | red : Reducible e sigma => inP (e', sigma, pure sigma)
                | laterSteps : (mkProperLater
                    (wp_steps H E (wp H E) e Phi sigma))
                    .upred_holds r x =>
                    \case \elim r, hx, hs \with {
                      | 0, _, _ => ()
                      | suc k, hxk, hsk =>
                        \lam e2 sigma2 j j_le_k c incl_c hc hstep =>
                          \let
                            | hs_j : Opened.upred_holds j c =>
                                Opened.upred_mono (suc k) j x c hsk incl_c
                                  ((NatSemiring.<=∘) j_le_k (n<=sucn k))
                          \in \case hs_j \with {
                            | inP (ac, ap, dc, hclose, hPj) =>
                              \let
                                | hclosed : (mkProperFUpd H.iris_wsat
                                    coPset_empty E
                                    (mkProperSep mkProperEmp P))
                                    .upred_holds j c =>
                                    fupd_frame_r H.iris_wsat coPset_empty E
                                      mkProperEmp P j c hc
                                      (inP (ac, ap, dc, hclose, hPj))
                                | hresult : (mkProperFUpd H.iris_wsat
                                    coPset_empty E
                                    (mkProperSep (state_interp H sigma)
                                      (wp H E e' Phi)))
                                    .upred_holds j c =>
                                    fupd_mono H.iris_wsat coPset_empty E
                                      (mkProperSep mkProperEmp P)
                                      (mkProperSep (state_interp H sigma)
                                        (wp H E e' Phi))
                                      (properUPred_ent_trans
                                        (mkProperSep mkProperEmp P) P
                                        (mkProperSep (state_interp H sigma)
                                          (wp H E e' Phi))
                                        ((BIuPredMixin M).bi_mixin_emp_sep_2 P)
                                        (sep_comm_ent
                                          (wp H E e' Phi)
                                          (state_interp H sigma)))
                                      j c hc hclosed
                                | step_det => det sigma e2 sigma2 hstep
                              \in transport2
                                (\lam ee ss =>
                                  (mkProperFUpd H.iris_wsat coPset_empty E
                                    (mkProperSep (state_interp H ss)
                                      (wp H E ee Phi))).upred_holds j c)
                                (inv step_det.1) (inv step_det.2) hresult
                          }
                    }
              \in (red, laterSteps)
      \in fupd_mono H.iris_wsat E coPset_empty Opened Core
        opened_to_core m (M.op a frame) ha_frame hopened)
    (wp_nonval_intro H E e Phi notVal)

-- Generic heap load.  Fractional ownership is preserved, and the returned
-- value is identified by agreement between the authoritative heap and the
-- fragment before the operational step is inverted.
\lemma wp_load {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (l : Loc) (dq : Dfrac) (v : Value)
  : properUPred_ent
      (pointsto H.iris_gen_heap l dq v)
      (wp H E (Load (Val (LitV (LitLoc l))))
        (\lam w => mkProperAnd (mkProperPure (w = v))
          (pointsto H.iris_gen_heap l dq v))) =>
  \let
    | R => pointsto H.iris_gen_heap l dq v
    | e => Load (Val (LitV (LitLoc l)))
    | Phi : Value -> iProp S => \lam w =>
        mkProperAnd (mkProperPure (w = v)) R
    | lookup_of : \Pi (sigma : State cnt) -> properUPred_ent
        (mkProperSep R (state_interp H sigma))
        (mkProperPure (glookup sigma.heap l = just v)) =>
        \lam sigma => properUPred_ent_trans
          (mkProperSep R (state_interp H sigma))
          (mkProperSep (state_interp H sigma) R)
          (mkProperPure (glookup sigma.heap l = just v))
          (sep_comm_ent R (state_interp H sigma))
          (gen_heap_valid H.iris_gen_heap sigma.heap l dq v)
    | red : \Pi (sigma : State cnt) -> properUPred_ent
        (mkProperSep R (state_interp H sigma))
        (mkProperPure (Reducible e sigma)) =>
        \lam sigma n x hx hs =>
          \let lookup => lookup_of sigma n x hx hs
          \in inP (Val v, sigma,
            BasePrim (LoadS l v lookup idp idp idp))
    | step : \Pi (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt) ->
        PrimStep e sigma e2 sigma2 -> properUPred_ent
          (mkProperSep R (state_interp H sigma))
          (mkProperBUpd
            (mkProperSep (state_interp H sigma2)
              (wp H E e2 Phi))) =>
        \lam sigma e2 sigma2 hstep n x hx hs =>
          \let
            | M => iResUR S
            | lookup => lookup_of sigma n x hx hs
            | invStep => load_step_inv l v sigma e2 sigma2 lookup hstep
          \in \case hs \with {
            | inP (ar, ast, dx, hr, hstate) =>
              \let
                | hx_parts : M.validN n (M.op ar ast) =>
                    M.cmra_validN_ne n x (M.op ar ast) dx hx
                | hr_valid : M.validN n ar =>
                    M.cmra_validN_op_l n ar ast hx_parts
                | hwp : (wp H E (Val v) Phi).upred_holds n ar =>
                    wp_value_intro H E v Phi n ar hr_valid (idp, hr)
                | dswap : M.dist n x (M.op ast ar) =>
                    M.ofe_dist_trans n x (M.op ar ast) (M.op ast ar)
                      dx (cmra_comm_dist {M} n ar ast)
                | hresult : (mkProperSep (state_interp H sigma)
                    (wp H E (Val v) Phi)).upred_holds n x =>
                    inP (ast, ar, dswap, hstate, hwp)
                | transported : (mkProperSep (state_interp H sigma2)
                    (wp H E e2 Phi)).upred_holds n x =>
                    \case invStep \with {
                      | LoadStepInvIntro e2_eq sigma2_eq =>
                        transport2
                          (\lam ee ss => (mkProperSep (state_interp H ss)
                            (wp H E ee Phi)).upred_holds n x)
                          (inv e2_eq) (inv sigma2_eq) hresult
                    }
              \in bupd_intro
                (mkProperSep (state_interp H sigma2)
                  (wp H E e2 Phi)) n x hx transported
          }
  \in wp_lift_atomic H E e Phi R idp red step

-- Generic full-fraction store.  The authoritative heap and the exclusive
-- fragment are updated together by `gen_heap_update`; the operational
-- inversion then identifies the concrete successor with that ghost update.
\lemma wp_store {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset)
    (l : Loc) (old new : Value)
  : properUPred_ent
      (pointsto_full H.iris_gen_heap l old)
      (wp H E
        (Store (Val (LitV (LitLoc l))) (Val new))
        (\lam w => mkProperAnd
          (mkProperPure (w = LitV LitUnit))
          (pointsto_full H.iris_gen_heap l new))) =>
  \let
    | R => pointsto_full H.iris_gen_heap l old
    | Rnew => pointsto_full H.iris_gen_heap l new
    | e => Store (Val (LitV (LitLoc l))) (Val new)
    | unitV => LitV LitUnit
    | Phi : Value -> iProp S => \lam w =>
        mkProperAnd (mkProperPure (w = unitV)) Rnew
    | lookup_of : \Pi (sigma : State cnt) -> properUPred_ent
        (mkProperSep R (state_interp H sigma))
        (mkProperPure (glookup sigma.heap l = just old)) =>
        \lam sigma => properUPred_ent_trans
          (mkProperSep R (state_interp H sigma))
          (mkProperSep (state_interp H sigma) R)
          (mkProperPure (glookup sigma.heap l = just old))
          (sep_comm_ent R (state_interp H sigma))
          (gen_heap_valid H.iris_gen_heap sigma.heap l
            (DfracOwn qp_one) old)
    | red : \Pi (sigma : State cnt) -> properUPred_ent
        (mkProperSep R (state_interp H sigma))
        (mkProperPure (Reducible e sigma)) =>
        \lam sigma n x hx hs =>
          \let lookup => lookup_of sigma n x hx hs
          \in inP (Val unitV,
            \new State cnt { | heap => heap_update sigma.heap l new },
            BasePrim (StoreS l new old lookup idp idp idp))
    | step : \Pi (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt) ->
        PrimStep e sigma e2 sigma2 -> properUPred_ent
          (mkProperSep R (state_interp H sigma))
          (mkProperBUpd
            (mkProperSep (state_interp H sigma2)
              (wp H E e2 Phi))) =>
        \lam sigma e2 sigma2 hstep =>
          \let
            | sigma' : State cnt => \new State cnt {
                | heap => heap_update sigma.heap l new
              }
            | Updated => mkProperSep (state_interp H sigma') Rnew
            | Target => mkProperSep (state_interp H sigma2)
                (wp H E e2 Phi)
            | invStep => store_step_inv l new sigma e2 sigma2 hstep
            | finish : properUPred_ent Updated Target =>
                \lam n x hx hs => \case hs \with {
                  | inP (ast, ar, dx, hstate, hr) =>
                    \let
                      | M => iResUR S
                      | hx_parts : M.validN n (M.op ast ar) =>
                          M.cmra_validN_ne n x (M.op ast ar) dx hx
                      | hr_valid : M.validN n ar =>
                          cmra_validN_op_r {M} n ast ar hx_parts
                      | hwp : (wp H E (Val unitV) Phi)
                          .upred_holds n ar =>
                          wp_value_intro H E unitV Phi
                            n ar hr_valid (idp, hr)
                      | result : (mkProperSep (state_interp H sigma')
                          (wp H E (Val unitV) Phi))
                          .upred_holds n x =>
                          inP (ast, ar, dx, hstate, hwp)
                    \in \case invStep \with {
                      | StoreStepInvIntro _ _ e2_eq sigma2_eq =>
                        transport2
                          (\lam ee ss => (mkProperSep (state_interp H ss)
                            (wp H E ee Phi)).upred_holds n x)
                          (inv e2_eq) (inv sigma2_eq) result
                    }
                }
          \in properUPred_ent_trans
              (mkProperSep R (state_interp H sigma))
              (mkProperSep (state_interp H sigma) R)
              (mkProperBUpd Target)
              (sep_comm_ent R (state_interp H sigma))
              (properUPred_ent_trans
                (mkProperSep (state_interp H sigma) R)
                (mkProperBUpd Updated)
                (mkProperBUpd Target)
                (gen_heap_update H.iris_gen_heap sigma.heap l old new)
                (bupd_mono Updated Target finish))
  \in wp_lift_atomic H E e Phi R idp red step

-- Generic allocation.  The concrete fresh location is chosen by the
-- operational semantics and then allocated in the authoritative ghost heap;
-- the postcondition existentially exposes that location and its full fragment.
\lemma wp_alloc {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (v : Value)
  : properUPred_ent mkProperEmp
      (wp H E (Alloc (Val v))
        (\lam w => mkProperExist Loc (\lam l =>
          mkProperAnd (mkProperPure (w = LitV (LitLoc l)))
            (pointsto_full H.iris_gen_heap l v)))) =>
  \let
    | e => Alloc (Val v)
    | Phi : Value -> iProp S => \lam w =>
        mkProperExist Loc (\lam l =>
          mkProperAnd (mkProperPure (w = LitV (LitLoc l)))
            (pointsto_full H.iris_gen_heap l v))
    | red : \Pi (sigma : State cnt) -> properUPred_ent
        (mkProperSep mkProperEmp (state_interp H sigma))
        (mkProperPure (Reducible e sigma)) =>
        \lam sigma _ _ _ _ =>
          \let fresh => heap_fresh_loc sigma
          \in inP (Val (LitV (LitLoc fresh.1)),
            \new State cnt {
              | heap => heap_update sigma.heap fresh.1 v
            }, BasePrim (AllocS v fresh.1 fresh.2 idp idp idp))
    | step : \Pi (sigma : State cnt) (e2 : Expr) (sigma2 : State cnt) ->
        PrimStep e sigma e2 sigma2 -> properUPred_ent
          (mkProperSep mkProperEmp (state_interp H sigma))
          (mkProperBUpd
            (mkProperSep (state_interp H sigma2)
              (wp H E e2 Phi))) =>
        \lam sigma e2 sigma2 hstep => \case alloc_step_inv v sigma e2 sigma2 hstep \with {
          | AllocStepInvIntro l fresh e2_eq sigma2_eq =>
            \let
              | sigma' : State cnt => \new State cnt {
                  | heap => heap_update sigma.heap l v
                }
              | Rnew => pointsto_full H.iris_gen_heap l v
              | Updated => mkProperSep (state_interp H sigma') Rnew
              | Target => mkProperSep (state_interp H sigma2)
                  (wp H E e2 Phi)
              | finish : properUPred_ent Updated Target =>
                  \lam n x hx hs => \case hs \with {
                    | inP (ast, ar, dx, hstate, hr) =>
                      \let
                        | M => iResUR S
                        | hx_parts : M.validN n (M.op ast ar) =>
                            M.cmra_validN_ne n x (M.op ast ar) dx hx
                        | hr_valid : M.validN n ar =>
                            cmra_validN_op_r {M} n ast ar hx_parts
                        | locV => LitV (LitLoc l)
                        | hwp : (wp H E (Val locV) Phi)
                            .upred_holds n ar =>
                            wp_value_intro H E locV Phi n ar hr_valid
                              (inP (l, (idp, hr)))
                        | result : (mkProperSep (state_interp H sigma')
                            (wp H E (Val locV) Phi))
                            .upred_holds n x =>
                            inP (ast, ar, dx, hstate, hwp)
                      \in transport2
                        (\lam ee ss => (mkProperSep (state_interp H ss)
                          (wp H E ee Phi)).upred_holds n x)
                        (inv e2_eq) (inv sigma2_eq) result
                  }
            \in properUPred_ent_trans
                (mkProperSep mkProperEmp (state_interp H sigma))
                (state_interp H sigma)
                (mkProperBUpd Target)
                ((BIuPredMixin (iResUR S)).bi_mixin_emp_sep_2
                  (state_interp H sigma))
                (properUPred_ent_trans
                  (state_interp H sigma)
                  (mkProperBUpd Updated)
                  (mkProperBUpd Target)
                  (gen_heap_alloc H.iris_gen_heap sigma.heap l
                    (DfracOwn qp_one) v fresh RatField.<=-refl)
                  (bupd_mono Updated Target finish))
        }
  \in wp_lift_atomic H E e Phi mkProperEmp idp red step

\lemma wp_bind_app_r {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (vf : Value)
    (e : Expr) (Phi : Value -> iProp S)
  : properUPred_ent
      (wp H E e (\lam v => wp H E (App (Val vf) (Val v)) Phi))
      (wp H E (App (Val vf) e) Phi) =>
  wp_bind_item H E (AppRCtx vf) e Phi

\lemma wp_bind_app_l {cnt : Countable Loc} {S : gFunctors}
    (H : irisGS cnt S) (E : coPset) (e1 e2 : Expr)
    (Phi : Value -> iProp S)
  : properUPred_ent
      (wp H E e1 (\lam v => wp H E (App (Val v) e2) Phi))
      (wp H E (App e1 e2) Phi) =>
  wp_bind_item H E (AppLCtx e2) e1 Phi

