-- =================================================================================
-- Update Modalities for BI
-- =================================================================================


\class BUpd \extends BIBase
  | bupd : E -> E

-- \class FUpd (B : BIBase)
--   | fupd : Nat -> Nat -> B.E -> B.E


-- =================================================================================
-- BUpd Mixin: Axioms for Basic Updates
-- =================================================================================

\class BiBUpd \extends BUpd, BIMixin {
  | bi_bupd_mixin_bupd_intro (P : E) : P |- bupd P
  | bi_bupd_mixin_bupd_mono (P Q : E) : (P |- Q) -> (bupd P) |- (bupd Q)
  | bi_bupd_mixin_bupd_trans (P : E) : (bupd (bupd P)) |- (bupd P)
  | bi_bupd_mixin_bupd_frame_r (P R : E) : ((bupd P) * R) |- (bupd (P * R))
}


\instance BIuPredMixin (M : UCMRA) : BIMixin
  | BIBase => BIuPred M
  | bi_mixin_pure_intro    => {?}
  | bi_mixin_pure_elim     => {?}
  | bi_mixin_and_intro     => {?}
  | bi_mixin_and_elim_l    => {?}
  | bi_mixin_and_elim_r    => {?}
  | bi_mixin_or_intro_l    => {?}
  | bi_mixin_or_intro_r    => {?}
  | bi_mixin_or_elim       => {?}
  | bi_mixin_impl_intro_r  => {?}
  | bi_mixin_impl_elim_l   => {?}
  | bi_mixin_forall_intro  => {?}
  | bi_mixin_forall_elim   => {?}
  | bi_mixin_exist_intro   => {?}
  | bi_mixin_exist_elim    => {?}
  | bi_mixin_sep_mono      => {?}
  | bi_mixin_emp_sep_1     => {?}
  | bi_mixin_emp_sep_2     => {?}
  | bi_mixin_sep_comm      => {?}
  | bi_mixin_sep_assoc     => {?}
  | bi_mixin_wand_intro    => {?}
  | bi_mixin_wand_elim     => {?}

