\import Logic
\import Logic.Meta
\import Paths
\import Set
\import Data.Maybe
\import Data.Bool
\import Order.PartialOrder
\import Arith.Nat
\import interface
\import cmra
\import ofe
\import uPred
\import lang
\import lib.gmap_cmra
\import lib.heap
\import lib.coPset
\import lib.coPset_cmra



-- =================================================================================
-- Update Modalities for BI
-- =================================================================================


\class BUpd \extends BIBase
  | bupd : E -> E


-- =================================================================================
-- BUpd Mixin: Axioms for Basic Updates
-- =================================================================================

\class BiBUpd \extends BUpd, BIMixin {
  | bi_bupd_mixin_bupd_intro (P : E) : P |- bupd P
  | bi_bupd_mixin_bupd_mono (P Q : E) : (P |- Q) -> (bupd P) |- (bupd Q)
  | bi_bupd_mixin_bupd_trans (P : E) : (bupd (bupd P)) |- (bupd P)
  | bi_bupd_mixin_bupd_frame_r (P R : E) : ((bupd P) * R) |- (bupd (P * R))
}


-- =================================================================================
-- Fancy updates for BI
-- =================================================================================

\class FUpd \extends BIBase
  | fupd : coPset -> coPset -> E -> E

-- The generic BI interface has no OFE structure, so non-expansiveness is a
-- concrete uPred theorem rather than a field of this order-theoretic mixin.
\class BiFUpd \extends FUpd, BIMixin {
  | bi_fupd_mixin_fupd_mask_subseteq (E1 E2 : coPset)
      : coPSubset E2 E1 -> emp |- fupd E1 E2 (fupd E2 E1 emp)
  | bi_fupd_mixin_except_0_fupd (E1 E2 : coPset) (P : E)
      : bi_or (bi_later (bi_pure Empty)) (fupd E1 E2 P) |- fupd E1 E2 P
  | bi_fupd_mixin_fupd_mono (E1 E2 : coPset) (P Q : E)
      : (P |- Q) -> fupd E1 E2 P |- fupd E1 E2 Q
  | bi_fupd_mixin_fupd_trans (E1 E2 E3 : coPset) (P : E)
      : fupd E1 E2 (fupd E2 E3 P) |- fupd E1 E3 P
  | bi_fupd_mixin_fupd_mask_frame_r (E1 E2 Ef : coPset) (P : E)
      : coPset_overlap E1 Ef = false ->
        fupd E1 E2 (bi_impl (bi_pure (coPset_overlap E2 Ef = false)) P)
          |- fupd (coPset_union E1 Ef) (coPset_union E2 Ef) P
  | bi_fupd_mixin_fupd_frame_r (E1 E2 : coPset) (P R : E)
      : (fupd E1 E2 P * R) |- fupd E1 E2 (P * R)
}

\class BiBUpdFUpd \extends BiBUpd, BiFUpd {
  | bi_bupd_fupd (Em : coPset) (P : E)
      : bupd P |- fupd Em Em P
}


\instance BIuPredMixin (M : UCMRA) : BIMixin
  | BIBase => BIuPred M
  | bi_mixin_pure_intro phi P =>
    \lam hphi n a _ _ => hphi
  | bi_mixin_pure_elim phi P =>
    \lam h n a hv hp => h hp n a hv ()
  | bi_mixin_and_intro P Q R =>
    \lam hPQ hPR n a hv hp =>
        (hPQ n a hv hp, hPR n a hv hp)
  | bi_mixin_and_elim_l P Q =>
    \lam n a _ hpq => hpq.1
  | bi_mixin_and_elim_r P Q =>
    \lam n a _ hpq => hpq.2
  | bi_mixin_or_intro_l P Q =>
    \lam n a _ hp => byLeft hp
  | bi_mixin_or_intro_r P Q =>
    \lam n a _ hq => byRight hq
  | bi_mixin_or_elim P Q R =>
    \lam hPR hQR n a hv hpq => \case hpq \with {
      | byLeft hp  => hPR n a hv hp
      | byRight hq => hQR n a hv hq
    }
  | bi_mixin_impl_intro_r P Q R h =>
    \lam n a hv hp m m_le_n b incl_a_b hv_b hq_b =>
        h m b hv_b
            (P.upred_mono n m a b hp incl_a_b m_le_n, hq_b)
  | bi_mixin_impl_elim_l P Q R =>
    \lam hPI n a hv hpq =>
        hPI n a hv hpq.1 n <=-refl a
            (inP (M.unit,
                  M.ofe_dist_trans n a a (M.op a M.unit)
                    (M.ofe_dist_refl n a)
                    (M.ofe_dist_sym n (M.op a M.unit) a (ucmra_unit_right_id_dist n a))))
            hv hpq.2
  | bi_mixin_forall_intro {A} P Phi =>
    \lam h n a hv hp t => h t n a hv hp
  | bi_mixin_forall_elim {A} Phi t =>
    \lam n a _ h => h t
  | bi_mixin_exist_intro {A} Phi t =>
    \lam n a _ h => inP (t, h)
  | bi_mixin_exist_elim {A} Phi Q =>
    \lam h n a hv hex => \case hex \with {
      | inP (t, ht) => h t n a hv ht
    }
  | bi_mixin_sep_mono P P' Q Q' =>
    \lam hPP' hQQ' n a hv hsep => \case hsep \with {
      | inP (a1, a2, dist_a, hp, hq) =>
        \let
          | hv_op : M.validN n (M.op a1 a2) => M.cmra_validN_ne n a (M.op a1 a2) dist_a hv
          | hv_a1 : M.validN n a1 => M.cmra_validN_op_l n a1 a2 hv_op
          | hv_a2 : M.validN n a2 => cmra_validN_op_r {M} n a1 a2 hv_op
        \in inP (a1, a2, dist_a, hPP' n a1 hv_a1 hp, hQQ' n a2 hv_a2 hq)
    }
  | bi_mixin_emp_sep_1 P =>
    \lam n a hv hp =>
        inP (M.unit, a,
             M.ofe_dist_trans n a a (M.op M.unit a)
               (M.ofe_dist_refl n a)
               (M.ofe_dist_sym n (M.op M.unit a) a (ucmra_unit_left_id_dist n a)),
             inP (M.unit,
                  M.ofe_dist_trans n M.unit M.unit (M.op M.unit M.unit)
                    (M.ofe_dist_refl n M.unit)
                    (M.ofe_dist_sym n (M.op M.unit M.unit) M.unit (ucmra_unit_left_id_dist n M.unit))),
             hp)
  | bi_mixin_emp_sep_2 P =>
    \lam n a hv hsep => \case hsep \with {
      | inP (a1, a2, dist_a, _, hp) =>
        \let
          | dist_swap : M.dist n a (M.op a2 a1) =>
            M.ofe_dist_trans n a (M.op a1 a2) (M.op a2 a1)
                dist_a
                (cmra_comm_dist {M} n a1 a2)
          | inclN_a2_a : inclN {M} {\new Op M.E { | op => M.op }} a2 n a =>
            inP (a1, dist_swap)
        \in P.upred_mono n n a2 a hp inclN_a2_a <=-refl
    }
  | bi_mixin_sep_comm P Q =>
    \lam n a hv hsep => \case hsep \with {
      | inP (a1, a2, dist_a, hp, hq) =>
        inP (a2, a1,
             M.ofe_dist_trans n a (M.op a1 a2) (M.op a2 a1)
                 dist_a
                 (cmra_comm_dist {M} n a1 a2),
             hq, hp)
    }
  | bi_mixin_sep_assoc P Q R =>
    \lam n a hv hsep => \case hsep \with {
      | inP (a1, a2, dist_a, hpq, hr) => \case hpq \with {
        | inP (b1, b2, dist_a1, hp, hq) =>
          \let
            | dist_op : M.dist n (M.op a1 a2) (M.op (M.op b1 b2) a2) =>
              M.cmra_op_ne_2 a2 n a1 (M.op b1 b2) dist_a1
            | dist_a_op : M.dist n a (M.op (M.op b1 b2) a2) =>
              M.ofe_dist_trans n a (M.op a1 a2) (M.op (M.op b1 b2) a2) dist_a dist_op
            | dist_a_assoc : M.dist n a (M.op b1 (M.op b2 a2)) =>
              M.ofe_dist_trans n a (M.op (M.op b1 b2) a2) (M.op b1 (M.op b2 a2))
                dist_a_op
                (M.ofe_dist_sym n (M.op b1 (M.op b2 a2)) (M.op (M.op b1 b2) a2)
                  (cmra_assoc_dist n b1 b2 a2))
          \in inP (b1, M.op b2 a2, dist_a_assoc, hp,
                   inP (b2, a2, M.ofe_dist_refl n (M.op b2 a2), hq, hr))
      }
    }
  | bi_mixin_wand_intro P Q R h =>
    \lam n a1 hv hp m m_le_n a2 hv_op hq =>
        h m (M.op a1 a2) hv_op
            (inP (a1, a2, M.ofe_dist_refl m (M.op a1 a2),
                  P.upred_mono n m a1 a1 hp
                      (inP (M.unit,
                          M.ofe_dist_trans m a1 a1 (M.op a1 M.unit)
                            (M.ofe_dist_refl m a1)
                            (M.ofe_dist_sym m (M.op a1 M.unit) a1 (ucmra_unit_right_id_dist m a1))))
                      m_le_n,
                  hq))
  | bi_mixin_wand_elim P Q =>
    \lam n a hv hsep => \case hsep \with {
      | inP (a1, a2, dist_a, hp, hwand) =>
        \let
          | hv_op : M.validN n (M.op a1 a2) =>
            M.cmra_validN_ne n a (M.op a1 a2) dist_a hv
          | dist_swap : M.dist n (M.op a1 a2) (M.op a2 a1) =>
            cmra_comm_dist {M} n a1 a2
          | hv_swap : M.validN n (M.op a2 a1) =>
            M.cmra_validN_ne n (M.op a1 a2) (M.op a2 a1) dist_swap hv_op
          | hq_swap : Q.upred_holds n (M.op a2 a1) =>
            hwand n <=-refl a1 hv_swap hp
          | dist_a_swap : M.dist n a (M.op a2 a1) =>
            M.ofe_dist_trans n a (M.op a1 a2) (M.op a2 a1) dist_a dist_swap
          | inclN_swap_a : inclN {M} {\new Op M.E { | op => M.op }} (M.op a2 a1) n a =>
            inP (M.unit,
                 M.ofe_dist_trans n a (M.op a2 a1) (M.op (M.op a2 a1) M.unit)
                   dist_a_swap
                   (M.ofe_dist_sym n (M.op (M.op a2 a1) M.unit) (M.op a2 a1)
                     (ucmra_unit_right_id_dist n (M.op a2 a1))))
        \in Q.upred_mono n n (M.op a2 a1) a hq_swap inclN_swap_a <=-refl
    }







\func bupd_later_iter_fn {M : UCMRA}
                         (k : Nat)
                         (P : ProperUPred M)
  : ProperUPred M \elim k
  | 0     => P
  | suc k => mkProperBUpd (mkProperLater (bupd_later_iter_fn k P))

\lemma bupd_ne {M : UCMRA} (n : Nat) (P Q : ProperUPred M)
  : upredDist n P Q -> upredDist n (mkProperBUpd P) (mkProperBUpd Q) =>
  \lam hPQ m a m_le_n hv_a =>
      (\lam hP k k_le_m yf hv_op =>
           \case hP k k_le_m yf hv_op \with {
             | inP (a', hv'_op, hp_a') =>
               \let
                 | k_le_n : k <= n => NatSemiring.<=∘ k_le_m m_le_n
                 | hv_a' : M.validN k a' => M.cmra_validN_op_l k a' yf hv'_op
                 | hq_a' : Q.upred_holds k a' => (hPQ k a' k_le_n hv_a').1 hp_a'
               \in inP (a', hv'_op, hq_a')
           },
       \lam hQ k k_le_m yf hv_op =>
           \case hQ k k_le_m yf hv_op \with {
             | inP (a', hv'_op, hq_a') =>
               \let
                 | k_le_n : k <= n => NatSemiring.<=∘ k_le_m m_le_n
                 | hv_a' : M.validN k a' => M.cmra_validN_op_l k a' yf hv'_op
                 | hp_a' : P.upred_holds k a' => (hPQ k a' k_le_n hv_a').2 hq_a'
               \in inP (a', hv'_op, hp_a')
           })

\lemma bupd_mono {M : UCMRA} (P Q : ProperUPred M)
  : properUPred_ent P Q -> properUPred_ent (mkProperBUpd P) (mkProperBUpd Q) =>
  \lam hPQ n a hv hP k k_le_n yf hv_op =>
      \case hP k k_le_n yf hv_op \with {
        | inP (a', hv'_op, hp_a') =>
          \let
            | hv_a' : M.validN k a' => M.cmra_validN_op_l k a' yf hv'_op
            | hq_a' : Q.upred_holds k a' => hPQ k a' hv_a' hp_a'
          \in inP (a', hv'_op, hq_a')
      }

\lemma bupd_intro {M : UCMRA} (P : ProperUPred M)
  : properUPred_ent P (mkProperBUpd P) =>
  \lam n a hv hP k k_le_n yf hv_op =>
      inP (a, hv_op,
           P.upred_mono n k a a hP
               (inP (M.unit,
                     M.ofe_dist_trans k a a (M.op a M.unit)
                       (M.ofe_dist_refl k a)
                       (M.ofe_dist_sym k (M.op a M.unit) a (ucmra_unit_right_id_dist k a))))
               k_le_n)

\lemma bupd_trans {M : UCMRA} (P : ProperUPred M)
  : properUPred_ent (mkProperBUpd (mkProperBUpd P)) (mkProperBUpd P) =>
  \lam n a hv hPP k k_le_n yf hv_op =>
      \case hPP k k_le_n yf hv_op \with {
        | inP (a', hv'_op, hbupd_a') =>
          \case hbupd_a' k <=-refl yf hv'_op \with {
            | inP (a'', hv''_op, hp_a'') =>
              inP (a'', hv''_op, hp_a'')
          }
      }

\lemma bupd_frame_r {M : UCMRA} (P R : ProperUPred M)
  : properUPred_ent (mkProperSep (mkProperBUpd P) R) (mkProperBUpd (mkProperSep P R)) =>
  \lam n a hv hsep => \case hsep \with {
    | inP (a1, a2, dist_a, hbupd, hR) =>
      \lam k k_le_n yf hv_op =>
          \let
            | dist_a_k : M.dist k a (M.op a1 a2) =>
              M.ofe_dist_le n k a (M.op a1 a2) dist_a k_le_n
            | dist_op_yf : M.dist k (M.op a yf) (M.op (M.op a1 a2) yf) =>
              M.cmra_op_ne_2 yf k a (M.op a1 a2) dist_a_k
            | hv_assoc_l : M.validN k (M.op (M.op a1 a2) yf) =>
              M.cmra_validN_ne k (M.op a yf) (M.op (M.op a1 a2) yf) dist_op_yf hv_op
            | hv_a1_a2yf : M.validN k (M.op a1 (M.op a2 yf)) =>
              cmra_validN_proper {M} k (M.op (M.op a1 a2) yf) (M.op a1 (M.op a2 yf))
                (M.equiv_sym (M.op a1 (M.op a2 yf)) (M.op (M.op a1 a2) yf)
                  (M.cmra_assoc a1 a2 yf)) hv_assoc_l
            | hP_step : TruncP (\Sigma (a1' : M.E)
                                       (M.validN k (M.op a1' (M.op a2 yf)))
                                       (P.upred_holds k a1')) =>
              hbupd k k_le_n (M.op a2 yf) hv_a1_a2yf
          \in \case hP_step \with {
            | inP (a1', hv_a1'_a2yf, hP_a1') =>
              \let
                | hv_a1'a2_yf : M.validN k (M.op (M.op a1' a2) yf) =>
                  cmra_validN_proper {M} k (M.op a1' (M.op a2 yf)) (M.op (M.op a1' a2) yf)
                    (M.cmra_assoc a1' a2 yf) hv_a1'_a2yf
                | inclN_a2 : inclN {M} {\new Op M.E { | op => M.op }} a2 k a2 =>
                  inP (M.unit,
                       M.ofe_dist_trans k a2 a2 (M.op a2 M.unit)
                         (M.ofe_dist_refl k a2)
                         (M.ofe_dist_sym k (M.op a2 M.unit) a2 (ucmra_unit_right_id_dist k a2)))
                | hR_k : R.upred_holds k a2 =>
                  R.upred_mono n k a2 a2 hR inclN_a2 k_le_n
                | hsep_new : (mkProperSep P R).upred_holds k (M.op a1' a2) =>
                  inP (a1', a2,
                       M.ofe_dist_refl k (M.op a1' a2),
                       hP_a1', hR_k)
              \in inP (M.op a1' a2, hv_a1'a2_yf, hsep_new)
          }
  }

\lemma bupd_extract_pure {M : UCMRA} (phi : \Prop) (n : Nat) (a : M.E)
  : M.validN n a -> (mkProperBUpd (mkProperPure phi)).upred_holds n a -> phi =>
  \lam hv hbupd =>
      \let
        | hv_op : M.validN n (M.op a M.unit) =>
          cmra_validN_proper {M} n a (M.op a M.unit)
            (M.equiv_sym (M.op a M.unit) a (ucmra_unit_right_id a)) hv
      \in \case hbupd n <=-refl M.unit hv_op \with {
        | inP (_, _, hphi) => hphi
      }

\lemma bupd_later_iter_soundness
  {M : UCMRA} (k : Nat) (phi : \Prop) (a : M.E)
  : M.validN k a ->
    (bupd_later_iter_fn k (mkProperBUpd (mkProperPure phi))).upred_holds k a -> phi
\elim k
  | 0     => \lam hv h => bupd_extract_pure phi 0 a hv h
  | suc k => \lam hv h =>
      \let
        | hv_op : M.validN (suc k) (M.op a M.unit) =>
          cmra_validN_proper {M} (suc k) a (M.op a M.unit)
            (M.equiv_sym (M.op a M.unit) a (ucmra_unit_right_id a)) hv
      \in \case h (suc k) <=-refl M.unit hv_op \with {
        | inP (a', hv'_op, hlater_a') =>
          \let
            | hv'_op_k : M.validN k (M.op a' M.unit) =>
              M.cmra_validN_le (suc k) k (M.op a' M.unit) hv'_op (n<=sucn k)
            | hv_a'  : M.validN k a' =>
              M.cmra_validN_op_l k a' M.unit hv'_op_k
            | h_k    : (bupd_later_iter_fn k (mkProperBUpd (mkProperPure phi))).upred_holds k a' =>
              hlater_a'
          \in bupd_later_iter_soundness k phi a' hv_a' h_k
      }


\instance UPredBUpd (M : UCMRA) : BUpd
  | BIBase => BIuPred M
  | bupd => mkProperBUpd

\instance UPredBiBUpd (M : UCMRA) : BiBUpd
  | BIMixin => BIuPredMixin M
  | bupd => mkProperBUpd
  | bi_bupd_mixin_bupd_intro   => bupd_intro
  | bi_bupd_mixin_bupd_mono    => bupd_mono
  | bi_bupd_mixin_bupd_trans   => bupd_trans
  | bi_bupd_mixin_bupd_frame_r => bupd_frame_r


-- =================================================================================
-- Derived Laws for BUpd
-- =================================================================================


\lemma bupd_frame_trans {M : UCMRA}
  (P R Q : ProperUPred M)
  (h : properUPred_ent (mkProperSep P R) (mkProperBUpd Q))
  : properUPred_ent (mkProperSep (mkProperBUpd P) R) (mkProperBUpd Q)
  => properUPred_ent_trans
      (mkProperSep (mkProperBUpd P) R)
      (mkProperBUpd (mkProperSep P R))
      (mkProperBUpd Q)
      (bupd_frame_r P R)
      (properUPred_ent_trans
          (mkProperBUpd (mkProperSep P R))
          (mkProperBUpd (mkProperBUpd Q))
          (mkProperBUpd Q)
          (bupd_mono (mkProperSep P R) (mkProperBUpd Q) h)
          (bupd_trans Q))

\func bupd_frame_l {Bu : BiBUpd} (R Q : Bu.E)
  : (R * bupd Q) |- bupd (R * Q)
  => Bu.<=-transitive
      (sep_comm_lemma R (bupd Q))
      (Bu.<=-transitive
          (bi_bupd_mixin_bupd_frame_r Q R)
          (bi_bupd_mixin_bupd_mono (Q * R) (R * Q) (sep_comm_lemma Q R)))

\func bupd_sep {Bu : BiBUpd} (P Q : Bu.E)
  : (bupd P * bupd Q) |- bupd (P * Q)
  => Bu.<=-transitive
      (bi_bupd_mixin_bupd_frame_r P (bupd Q))
      (Bu.<=-transitive
          (bi_bupd_mixin_bupd_mono (P * bupd Q) (bupd (P * Q))
              (bupd_frame_l P Q))
          (bi_bupd_mixin_bupd_trans (P * Q)))
