\import Arith.Nat
\import Data.Bool
\import Data.List
\import Data.Maybe
\import Data.Or
\import Set
\import Logic
\import Paths
\import Paths.Meta
\import Meta
\import lib.gmap_cmra



-- \func String => List Nat
--
-- \func stringDecEq (x y : String) : (x = y) `Or` (Not (x = y)) \elim x, y
--   | nil, nil => inl idp
--   | nil, :: _ _ => inr (\lam p => \case p \with {})
--   | :: _ _, nil => inr (\lam p => \case p \with {})
--   | :: a xs, :: b ys => \case decEqNat a b \with {
--     | inl ab => \case stringDecEq xs ys \with {
--       | inl xys => inl (pmap2 (::) ab xys)
--       | inr nxys => inr (\lam p => nxys (pmap tail p))
--     }
--     | inr nab => inr (\lam p => nab (pmap headDef p))
--   }
--   \where {
--     \func headDef (l : List Nat) : Nat
--       | nil => 0
--       | :: a _ => a
--
--     \func tail (l : List Nat) : List Nat
--       | nil => nil
--       | :: _ xs => xs
--   }

\func Loc => Nat

\data Lit
  | LitInt (n : Int)
  | LitBool (b : Bool)
  | LitUnit
  | LitLoc (l : Loc)

\data Value : \Set
  | LitV (l : Lit)
  | LamV (x : String) (body : Expr)
  | RecV (f x : String) (body : Expr)
  | PairV (v1 v2 : Value)

\data Expr : \Set
  | Val (v : Value)
  | Var (x : String)
  | Lam (x : String) (body : Expr)
  | Rec (f x : String) (body : Expr)
  | App (e1 e2 : Expr)
  | If (cond thenB elseB : Expr)
  | Pair (e1 e2 : Expr)
  | Fst (e : Expr)
  | Snd (e : Expr)
  | IsZero (e : Expr)
  | Pred (e : Expr)
  | Mul (e1 e2 : Expr)
  | Load (e : Expr)
  | Store (e1 e2 : Expr)
  | Alloc (e : Expr)

\record State (cnt : Countable Loc)
  | heap : Gmap Loc cnt Value

\func of_val (v : Value) : Expr => Val v

\func to_val (e : Expr) : Maybe Value
  | Val v => just v
  | _ => nothing

\func subst (x : String) (v : Value) (e : Expr) : Expr \elim e
  | Val w => Val w
  | Var y => \case decideEq x y \with {
    | inl _ => Val v
    | inr _ => Var y
  }
  | Lam y body => \case decideEq x y \with {
    | inl _ => Lam y body
    | inr _ => Lam y (subst x v body)
  }
  | Rec f y body => \case decideEq x f \with {
    | inl _ => Rec f y body
    | inr _ => \case decideEq x y \with {
      | inl _ => Rec f y body
      | inr _ => Rec f y (subst x v body)
    }
  }
  | App e1 e2 => App (subst x v e1) (subst x v e2)
  | If cond thenB elseB => If (subst x v cond) (subst x v thenB) (subst x v elseB)
  | Pair e1 e2 => Pair (subst x v e1) (subst x v e2)
  | Fst e => Fst (subst x v e)
  | Snd e => Snd (subst x v e)
  | IsZero e => IsZero (subst x v e)
  | Pred e => Pred (subst x v e)
  | Mul e1 e2 => Mul (subst x v e1) (subst x v e2)
  | Alloc e => Alloc (subst x v e)
  | Load e => Load (subst x v e)
  | Store e1 e2 => Store (subst x v e1) (subst x v e2)
  \where {
    -- Blocked on a concrete decidable equality proof for Arend String.
    -- Any proof unfolding substitution through binders may have to discharge this.
    \func decideEq (x y : String) : (x = y) `Or` (Not (x = y)) => {?}
  }

\func heap_update {cnt : Countable Loc} (h : Gmap Loc cnt Value) (l : Loc) (v : Value) : Gmap Loc cnt Value =>
  ginsert l v h


\truncated \data BaseStep {cnt : Countable Loc}
                          (e1 : Expr) (s1 : State cnt) (e2 : Expr) (s2 : State cnt) : \Prop
  | BetaS (x : String) (body : Expr) (v : Value)
          (p1 : e1 = App (Val (LamV x body)) (Val v))
          (p2 : e2 = subst x v body)
          (p3 : s2 = s1)
  | RecBetaS (f x : String) (body : Expr) (v : Value)
             (p1 : e1 = App (Val (RecV f x body)) (Val v))
             (p2 : e2 = subst x v (subst f (RecV f x body) body))
             (p3 : s2 = s1)
  | RecS (f x : String) (body : Expr)
         (p1 : e1 = Rec f x body)
         (p2 : e2 = Val (RecV f x body))
         (p3 : s2 = s1)
  | IfTrueS (t f : Expr)
            (p1 : e1 = If (Val (LitV (LitBool true))) t f)
            (p2 : e2 = t)
            (p3 : s2 = s1)
  | IfFalseS (t f : Expr)
             (p1 : e1 = If (Val (LitV (LitBool false))) t f)
             (p2 : e2 = f)
             (p3 : s2 = s1)
  | FstS (v1 v2 : Value)
         (p1 : e1 = Fst (Val (PairV v1 v2)))
         (p2 : e2 = Val v1)
         (p3 : s2 = s1)
  | SndS (v1 v2 : Value)
         (p1 : e1 = Snd (Val (PairV v1 v2)))
         (p2 : e2 = Val v2)
         (p3 : s2 = s1)
  | PairS (v1 v2 : Value)
          (p1 : e1 = Pair (Val v1) (Val v2))
          (p2 : e2 = Val (PairV v1 v2))
          (p3 : s2 = s1)
  | AllocS (v : Value) (l : Loc)
           (fresh : glookup s1.heap l = nothing)
           (p1 : e1 = Alloc (Val v))
           (p2 : e2 = Val (LitV (LitLoc l)))
           (p3 : s2 = \new State cnt { | heap => heap_update s1.heap l v })
  | LoadS (l : Loc) (v : Value)
          (lookup : glookup s1.heap l = just v)
          (p1 : e1 = Load (Val (LitV (LitLoc l))))
          (p2 : e2 = Val v)
          (p3 : s2 = s1)
  | StoreS (l : Loc) (v v' : Value)
           (allocated : glookup s1.heap l = just v')
           (p1 : e1 = Store (Val (LitV (LitLoc l))) (Val v))
           (p2 : e2 = Val (LitV LitUnit))
           (p3 : s2 = \new State cnt { | heap => heap_update s1.heap l v })
  | IsZeroZeroS
    (p1 : e1 = IsZero (Val (LitV (LitInt 0))))
    (p2 : e2 = Val (LitV (LitBool true)))
    (p3 : s2 = s1)
  | IsZeroPosS (n : Nat)
               (p1 : e1 = IsZero (Val (LitV (LitInt (pos (suc n))))))
               (p2 : e2 = Val (LitV (LitBool false)))
               (p3 : s2 = s1)
  | PredS (n : Nat)
          (p1 : e1 = Pred (Val (LitV (LitInt (pos (suc n))))))
          (p2 : e2 = Val (LitV (LitInt (pos n))))
          (p3 : s2 = s1)
  | MulS (a b : Nat)
         (p1 : e1 = Mul (Val (LitV (LitInt (pos a)))) (Val (LitV (LitInt (pos b)))))
         (p2 : e2 = Val (LitV (LitInt (pos (a Nat.* b)))))
         (p3 : s2 = s1)

\data EctxItem
  | AppLCtx (e2 : Expr)
  | AppRCtx (vf : Value)
  | IfCtx (thenB elseB : Expr)
  | PairLCtx (e2 : Expr)
  | PairRCtx (v1 : Value)
  | FstCtx
  | SndCtx
  | IsZeroCtx
  | PredCtx
  | MulLCtx (e2 : Expr)
  | MulRCtx (v1 : Value)
  | AllocCtx
  | LoadCtx
  | StoreLCtx (e2 : Expr)
  | StoreRCtx (v1 : Value)

\data Ectx
  | EmptyCtx
  | ConsCtx (Ki : EctxItem) (K : Ectx)

\func fill_item (Ki : EctxItem) (e : Expr) : Expr \elim Ki
  | AppLCtx e2 => App e e2
  | AppRCtx vf => App (Val vf) e
  | IfCtx thenB elseB => If e thenB elseB
  | PairLCtx e2 => Pair e e2
  | PairRCtx v1 => Pair (Val v1) e
  | FstCtx => Fst e
  | SndCtx => Snd e
  | IsZeroCtx => IsZero e
  | PredCtx => Pred e
  | MulLCtx e2 => Mul e e2
  | MulRCtx v1 => Mul (Val v1) e
  | AllocCtx => Alloc e
  | LoadCtx => Load e
  | StoreLCtx e2 => Store e e2
  | StoreRCtx v1 => Store (Val v1) e

\func empty_ectx : Ectx => EmptyCtx

\func comp_ectx (K1 K2 : Ectx) : Ectx \elim K1
  | EmptyCtx => K2
  | ConsCtx Ki K1' => ConsCtx Ki (comp_ectx K1' K2)

\func fill (K : Ectx) (e : Expr) : Expr \elim K
  | EmptyCtx => e
  | ConsCtx Ki K' => fill_item Ki (fill K' e)

\func fill_empty (e : Expr) : fill empty_ectx e = e => idp

\func fill_comp (K1 K2 : Ectx) (e : Expr) : fill K1 (fill K2 e) = fill (comp_ectx K1 K2) e \elim K1
  | EmptyCtx => idp
  | ConsCtx Ki K1' => pmap (fill_item Ki) (fill_comp K1' K2 e)

\func fill_item_not_val (Ki : EctxItem) (e : Expr)
  : to_val e = nothing -> to_val (fill_item Ki e) = nothing \elim Ki
  | AppLCtx e2 => \lam (_ : to_val e = nothing) => idp
  | AppRCtx vf => \lam (_ : to_val e = nothing) => idp
  | IfCtx thenB elseB => \lam (_ : to_val e = nothing) => idp
  | PairLCtx e2 => \lam (_ : to_val e = nothing) => idp
  | PairRCtx v1 => \lam (_ : to_val e = nothing) => idp
  | FstCtx => \lam (_ : to_val e = nothing) => idp
  | SndCtx => \lam (_ : to_val e = nothing) => idp
  | IsZeroCtx => \lam (_ : to_val e = nothing) => idp
  | PredCtx => \lam (_ : to_val e = nothing) => idp
  | MulLCtx e2 => \lam (_ : to_val e = nothing) => idp
  | MulRCtx v1 => \lam (_ : to_val e = nothing) => idp
  | AllocCtx => \lam (_ : to_val e = nothing) => idp
  | LoadCtx => \lam (_ : to_val e = nothing) => idp
  | StoreLCtx e2 => \lam (_ : to_val e = nothing) => idp
  | StoreRCtx v1 => \lam (_ : to_val e = nothing) => idp

\func fill_not_val (K : Ectx) (e : Expr)
  : to_val e = nothing -> to_val (fill K e) = nothing \elim K
  | EmptyCtx => \lam (h : to_val e = nothing) => h
  | ConsCtx Ki K' => \lam h => fill_item_not_val Ki (fill K' e) (fill_not_val K' e h)

\truncated \data PrimStep {cnt : Countable Loc}
                          (e1 : Expr) (s1 : State cnt) (e2 : Expr) (s2 : State cnt) : \Prop
  | EctxStep (K : Ectx) (e1' e2' : Expr)
             (p1 : e1 = fill K e1')
             (p2 : e2 = fill K e2')
             (step : BaseStep e1' s1 e2' s2)

\func base_prim_step {cnt : Countable Loc}
                     {e1 e2 : Expr} {s1 s2 : State cnt}
                     (step : BaseStep e1 s1 e2 s2)
  : PrimStep e1 s1 e2 s2 =>
  EctxStep empty_ectx e1 e2 idp idp step

\func BasePrim {cnt : Countable Loc}
               {e1 e2 : Expr} {s1 s2 : State cnt}
               (step : BaseStep e1 s1 e2 s2)
  : PrimStep e1 s1 e2 s2 =>
  base_prim_step step

\func fill_step_item {cnt : Countable Loc}
                     (Ki : EctxItem)
                     {e1 e2 : Expr} {s1 s2 : State cnt}
                     (step : PrimStep e1 s1 e2 s2)
  : PrimStep (fill_item Ki e1) s1 (fill_item Ki e2) s2 \elim step
  | EctxStep K e1' e2' p1 p2 base =>
    EctxStep (ConsCtx Ki K) e1' e2' (pmap (fill_item Ki) p1) (pmap (fill_item Ki) p2) base

\func fill_step {cnt : Countable Loc}
                (K : Ectx)
                {e1 e2 : Expr} {s1 s2 : State cnt}
                (step : PrimStep e1 s1 e2 s2)
  : PrimStep (fill K e1) s1 (fill K e2) s2 \elim K
  | EmptyCtx => step
  | ConsCtx Ki K' => fill_step_item Ki (fill_step K' step)

\func BaseReducible {cnt : Countable Loc} (e : Expr) (s : State cnt) : \Prop =>
  TruncP (\Sigma (e' : Expr) (s' : State cnt) (BaseStep e s e' s'))

\func Reducible {cnt : Countable Loc} (e : Expr) (s : State cnt) : \Prop =>
  TruncP (\Sigma (e' : Expr) (s' : State cnt) (PrimStep e s e' s'))

\func base_reducible_prim {cnt : Countable Loc} (e : Expr) (s : State cnt)
  : BaseReducible e s -> Reducible e s =>
  \lam red => TruncP.map red
    (\lam (p : \Sigma (e' : Expr) (s' : State cnt) (BaseStep e s e' s')) =>
      (p.1, p.2, base_prim_step p.3))

\func reducible_fill_item {cnt : Countable Loc} (Ki : EctxItem) (e : Expr) (s : State cnt)
  : Reducible e s -> Reducible (fill_item Ki e) s =>
  \lam red => TruncP.map red
    (\lam (p : \Sigma (e' : Expr) (s' : State cnt) (PrimStep e s e' s')) =>
      (fill_item Ki p.1, p.2, fill_step_item Ki p.3))

\func reducible_fill {cnt : Countable Loc} (K : Ectx) (e : Expr) (s : State cnt)
  : Reducible e s -> Reducible (fill K e) s =>
  \lam red => TruncP.map red
    (\lam (p : \Sigma (e' : Expr) (s' : State cnt) (PrimStep e s e' s')) =>
      (fill K p.1, p.2, fill_step K p.3))

\axiom fill_step_inv_item {cnt : Countable Loc}
                          (Ki : EctxItem)
                          (e1 : Expr) (s1 : State cnt)
                          (e2 : Expr) (s2 : State cnt)
                          (no_val : to_val e1 = nothing)
                          (step : PrimStep (fill_item Ki e1) s1 e2 s2)
  : TruncP (\Sigma (e2' : Expr) (e2 = fill_item Ki e2') (PrimStep e1 s1 e2' s2))

\axiom fill_step_inv {cnt : Countable Loc}
                    (K : Ectx)
                    (e1 : Expr) (s1 : State cnt)
                    (e2 : Expr) (s2 : State cnt)
                    (no_val : to_val e1 = nothing)
                    (step : PrimStep (fill K e1) s1 e2 s2)
  : TruncP (\Sigma (e2' : Expr) (e2 = fill K e2') (PrimStep e1 s1 e2' s2))


\func to_of_val (v : Value) : to_val (of_val v) = just v => idp

\axiom of_to_val (e : Expr) (v : Value) (p : to_val e = just v) : of_val v = e

\func base_val_stuck {cnt : Countable Loc}
                     (e : Expr) (s : State cnt) (e' : Expr) (s' : State cnt)
                     (step : BaseStep e s e' s') : to_val e = nothing \elim step
  | BetaS x body v p1 p2 p3 => rewrite p1 idp
  | RecBetaS f x body v p1 p2 p3 => rewrite p1 idp
  | RecS f x body p1 p2 p3 => rewrite p1 idp
  | IfTrueS t f p1 p2 p3 => rewrite p1 idp
  | IfFalseS t f p1 p2 p3 => rewrite p1 idp
  | FstS v1 v2 p1 p2 p3 => rewrite p1 idp
  | SndS v1 v2 p1 p2 p3 => rewrite p1 idp
  | PairS v1 v2 p1 p2 p3 => rewrite p1 idp
  | AllocS v l fresh p1 p2 p3 => rewrite p1 idp
  | LoadS l v lookup p1 p2 p3 => rewrite p1 idp
  | StoreS l v v' allocated p1 p2 p3 => rewrite p1 idp
  | IsZeroZeroS p1 p2 p3 => rewrite p1 idp
  | IsZeroPosS n p1 p2 p3 => rewrite p1 idp
  | PredS n p1 p2 p3 => rewrite p1 idp
  | MulS a b p1 p2 p3 => rewrite p1 idp

\func val_stuck {cnt : Countable Loc}
                (e : Expr) (s : State cnt) (e' : Expr) (s' : State cnt)
                (step : PrimStep e s e' s') : to_val e = nothing \elim step
  | EctxStep K e1' e2' p1 p2 base =>
    transport (\lam x => to_val x = nothing) (inv p1)
      (fill_not_val K e1' (base_val_stuck e1' s e2' s' base))

-- =================================================================================
-- Mathematical factorial on Nat
-- =================================================================================

\func nat_fact (n : Nat) : Nat
  | 0      => 1
  | suc n' => suc n' Nat.* nat_fact n'

\func natV (n : Nat) : Value => LitV (LitInt (pos n))
