\import Logic
\import Logic.Meta
\import Paths
\import Set
\import Data.Maybe
\import Arith.Nat
\import Order.PartialOrder
\import ofe


-- =================================================================================
-- CMRA structure
-- =================================================================================

\class PCore (A : \Set)
  | pcore : A -> Maybe A

\class Op (A : \Set)
  | op : A -> A -> A

\func \infixl 7 op_dot {A : \Set} {opA : Op A} (x y : A) : A => op x y

\func opM {A : \Set} {opA : Op A} (x : A) (my : Maybe A) : A \elim my
  | just y  => op x y
  | nothing => x

\class Valid (A : \Set)
  | valid : A -> \Prop

\class ValidN (A : \Set)
  | validN : Nat -> A -> \Prop


\func vld {A : \Set} {vA : Valid A} (x : A) : \Prop => valid x
\func vldN {A : \Set} {vnA : ValidN A} (n : Nat) (x : A) : \Prop => validN n x


\func \infix 6 incl {A : \Set} {eA : BaseSet A} {opA : Op A} (x y : A) : \Prop =>
  ∃ (z : A) (y = op x z)

\func \infix 6 inclN {O : OFE} {opO : Op O.E} (x : O.E) (n : Nat) (y : O.E) : \Prop =>
  ∃ (z : O.E) (O.dist n y (op x z))


\class CMRA \extends OFE, PCore, Op, Valid, ValidN {
  | PCore.A => E
  | Op.A => E
  | Valid.A => E
  | ValidN.A => E

  | cmra_op_ne (x : E) : NonExpansive (op x)
  | cmra_op_ne_2 (y : E) : NonExpansive (\lam x => op x y)

  | cmra_pcore_ne (n : Nat) (x y : E) (cx : E) :
  dist n x y -> pcore x = just cx ->
  \Sigma (cy : E) (pcore y = just cy) (dist n cx cy)

  | cmra_validN_ne (n : Nat) (x y : E) : dist n x y -> validN n x -> validN n y

  | cmra_valid_validN (x : E) : valid x <-> (\Pi (n : Nat) -> validN n x)

  | cmra_validN_le (n m : Nat) (x : E) : validN n x -> m <= n -> validN m x

  | cmra_assoc (x y z : E) : op x (op y z) = op (op x y) z
  | cmra_comm (x y : E) : op x y = op y x

  | cmra_pcore_l (x cx : E) : pcore x = just cx -> op cx x = x
  | cmra_pcore_idemp (x cx : E) : pcore x = just cx -> pcore cx = just cx
  | cmra_pcore_mono (x y cx : E) : incl {E} {\this} {\new Op E { | op => op }} x y -> pcore x = just cx ->
  TruncP (\Sigma (cy : E) (pcore y = just cy) (incl {E} {\this} {\new Op E { | op => op }} cx cy))

  | cmra_validN_op_l (n : Nat) (x y : E) : validN n (op x y) -> validN n x

  | cmra_extend (n : Nat) (x y1 y2 : E) :
  validN n x -> dist n x (op y1 y2) ->
  \Sigma (z1 z2 : E) (x = op z1 z2) (dist n z1 y1) (dist n z2 y2)
}

-- =================================================================================
-- UCMRA: Unital CMRA (with unit element)
-- =================================================================================

\class Unit (A : \Set)
  | unit : A

\class UCMRA \extends CMRA, Unit{
  | Unit.A => E

  | ucmra_unit_valid : valid unit
  | ucmra_unit_left_id : \Pi (x : E) -> op unit x = x
  | ucmra_pcore_unit : pcore unit = just unit
}

\func CoreId {C : CMRA} (x : C.E) : \Prop => pcore {C} x = just x

\func Exclusive {C : CMRA} (x : C.E) : \Prop =>
  \Pi (y : C.E) -> validN {C} 0 (op {C} x y) -> Empty

\func Cancelable {C : CMRA} (x : C.E) : \Prop =>
  \Pi (n : Nat) (y z : C.E) -> validN {C} n (op {C} x y) -> C.dist n (op {C} x y) (op {C} x z) -> C.dist n y z

\func CMRATotal (C : CMRA) : \Prop =>
  \Pi (x : C.E) -> TruncP(\Sigma (cx : C.E) (pcore {C} x = just cx))

-- =================================================================================
-- Basic CMRA lemmas
-- =================================================================================

\lemma cmra_op_ne_both {C : CMRA} (n : Nat) (x1 x2 y1 y2 : C.E)
                       (h1 : C.dist n x1 x2) (h2 : C.dist n y1 y2) :
  C.dist n (op {C} x1 y1) (op {C} x2 y2) =>
  C.ofe_dist_trans n (op {C} x1 y1) (op {C} x2 y1) (op {C} x2 y2)
    (cmra_op_ne_2 {C} y1 n x1 x2 h1)
    (cmra_op_ne {C} x2 n y1 y2 h2)

\lemma cmra_validN_op_r {C : CMRA} (n : Nat) (x y : C.E) :
  validN {C} n (op {C} x y) -> validN {C} n y =>
  \lam h => cmra_validN_op_l {C} n y x (transport (validN {C} n) (cmra_comm {C} x y) h)


\lemma cmra_validN_includedN {C : CMRA} (n : Nat) (x y : C.E)
                             (hv : validN {C} n y)
                             (h : inclN {C} {\new Op C.E { | op => C.op }} x n y)
  : validN {C} n x => \case h \with {
  | inP (z, dist_y_xz) =>
    cmra_validN_op_l {C} n x z
        (cmra_validN_ne {C} n y (op {C} x z) dist_y_xz hv)
}

\lemma cmra_pcore_r {C : CMRA} (x cx : C.E) :
  pcore {C} x = just cx -> op {C} x cx = x =>
  \lam h => transport (\lam z => z = x) (cmra_comm {C} cx x) (cmra_pcore_l {C} x cx h)

\lemma ucmra_unit_right_id {U : UCMRA} (x : U.E) : op {U} x U.unit = x =>
  transport (\lam z => z = x) (inv (U.cmra_comm x U.unit)) (U.ucmra_unit_left_id x)

\func cmra_includedN_l {C : CMRA} (n : Nat) (x y : C.E) : inclN {C} {\new Op C.E { | op => C.op }} x n (C.op x y) =>
  inP (y, C.ofe_dist_refl n (C.op x y))

\func inclN_le {O : OFE} {opO : Op O.E} (x y : O.E) (n m : Nat)
               (h : inclN {O} {opO} x n y) (le : m <= n) : inclN {O} {opO} x m y
  => \case h \with {
    | inP (z, dist_y_xz) => inP (z, O.ofe_dist_le n m y (opO.op x z) dist_y_xz le)
  }

\func dist_op_ne_l {M : CMRA} (n : Nat) (x1 x2 y : M.E)
                   (h : M.dist n x1 x2) : M.dist n (M.op x1 y) (M.op x2 y)
  => M.cmra_op_ne_2 y n x1 x2 h

\func dist_op_ne_r {M : CMRA} (n : Nat) (x y1 y2 : M.E)
                   (h : M.dist n y1 y2) : M.dist n (M.op x y1) (M.op x y2)
  => M.cmra_op_ne x n y1 y2 h

\func inclN_op_l {M : CMRA} (n : Nat) (x y : M.E) : inclN {M} {\new Op M.E { | op => M.op }} x n (M.op x y)
  => inP (y, M.ofe_dist_refl n (M.op x y))

\func inclN_op_r {M : CMRA} (n : Nat) (x1 x2 a : M.E)
                 (h : inclN {M} {\new Op M.E { | op => M.op }} x1 n x2)
  : inclN {M} {\new Op M.E { | op => M.op }} (M.op x1 a) n (M.op x2 a)
  => \case h \with {
    | inP (z, dist_x2_x1z) =>
      inP (z,
           transport (\lam w => M.dist n (M.op x2 a) w)
             (inv (M.cmra_assoc x1 z a)
               *> pmap (M.op x1) (M.cmra_comm z a)
                    *> M.cmra_assoc x1 a z)
             (M.cmra_op_ne_2 a n x2 (M.op x1 z) dist_x2_x1z))
  }

\lemma inclN_trans {C : CMRA} (n : Nat) (x y w : C.E)
                   (h1 : inclN {C} {\new Op C.E { | op => C.op }} x n y)
                   (h2 : inclN {C} {\new Op C.E { | op => C.op }} y n w)
  : inclN {C} {\new Op C.E { | op => C.op }} x n w
  => \case h1, h2 \with {
    | inP (z1, hz1), inP (z2, hz2) =>
      inP (C.op z1 z2,
           C.ofe_dist_trans n w (C.op y z2) (C.op x (C.op z1 z2))
               hz2
               (C.ofe_dist_trans n (C.op y z2) (C.op (C.op x z1) z2) (C.op x (C.op z1 z2))
                   (C.cmra_op_ne_2 z2 n y (C.op x z1) hz1)
                   (equiv_dist_n {C} (C.op (C.op x z1) z2) (C.op x (C.op z1 z2))
                       (inv (C.cmra_assoc x z1 z2)) n)))
  }

-- =================================================================================
-- Derived laws
-- =================================================================================

\lemma cmra_pcore_ne_dist {C : CMRA} (n : Nat) (x y : C.E)
                          (h : C.dist n x y) (px py : Maybe C.E)
                          (hx : pcore {C} x = px) (hy : pcore {C} y = py)
  : (OptionOFE C).dist n px py
  => \case px \as px', py \as py', hx : pcore {C} x = px', hy : pcore {C} y = py'
  \return (OptionOFE C).dist n px' py'
  \with {
    | just cx, just cy, hx, hy =>
      \case C.cmra_pcore_ne n x y cx h hx \with {
        | (cy', hy', dcx_cy') =>
          \let cy_eq : just cy' = just cy =>
            transport (\lam z => z = just cy) hy' hy
          \in transport (\lam z => C.dist n cx z)
              (pmap (\case __ \with { | just c => c | nothing => cy' }) cy_eq)
              dcx_cy'
      }
    | nothing, nothing, _, _ => ()
    | just cx, nothing, hx, hy =>
      \case C.cmra_pcore_ne n x y cx h hx \with {
        | (_, hy', _) =>
          \case transport (\lam z => z = nothing) hy' hy
                : (just _ : Maybe C.E) = nothing \with {}
      }
    | nothing, just cy, hx, hy =>
      \case C.cmra_pcore_ne n y x cy (C.ofe_dist_sym n x y h) hy \with {
        | (_, hx', _) =>
          \case transport (\lam z => z = nothing) hx' hx
                : (just _ : Maybe C.E) = nothing \with {}
      }
  }

-- =================================================================================
-- Total core on a UCMRA
-- =================================================================================

\func ucmra_core {U : UCMRA} (x : U.E) : U.E =>
  \case pcore {U} x \with {
    | just c  => c
    | nothing => U.unit
  }

\lemma ucmra_unit_least {U : UCMRA} (x : U.E)
  : incl {U.E} {U} {\new Op U.E { | op => U.op }} U.unit x
  => inP (x, inv (U.ucmra_unit_left_id x))

\lemma ucmra_core_ne {U : UCMRA} (n : Nat) (x y : U.E)
                     (h : U.dist n x y)
  : U.dist n (ucmra_core x) (ucmra_core y)
  => \case pcore {U} x \as px, pcore {U} y \as py,
           idp : pcore {U} x = px, idp : pcore {U} y = py
  \return U.dist n
      (\case px \with { | just c => c | nothing => U.unit })
      (\case py \with { | just c => c | nothing => U.unit })
  \with {
    | just cx, just cy, hpx, hpy =>
      \case U.cmra_pcore_ne n x y cx h hpx \with {
        | (cy', hpy', dcxcy') =>
          \let cy_eq : cy' = cy =>
            pmap (\case __ \with { | just c => c | nothing => cy' })
                (transport (\lam z => z = just cy) hpy' hpy)
          \in transport (\lam z => U.dist n cx z) cy_eq dcxcy'
      }
    | nothing, nothing, _, _ => U.ofe_dist_refl n U.unit
    | just cx, nothing, hpx, hpy =>
      \case U.cmra_pcore_ne n x y cx h hpx \with {
        | (_, hpy', _) =>
          \case transport (\lam z => z = nothing) hpy' hpy
                : (just _ : Maybe U.E) = nothing \with {}
      }
    | nothing, just cy, hpx, hpy =>
      \case U.cmra_pcore_ne n y x cy (U.ofe_dist_sym n x y h) hpy \with {
        | (_, hpx', _) =>
          \case transport (\lam z => z = nothing) hpx' hpx
                : (just _ : Maybe U.E) = nothing \with {}
      }
  }

\lemma ucmra_core_left_id {U : UCMRA} (x : U.E)
  : U.op (ucmra_core x) x = x
  => \case pcore {U} x \as px, idp : pcore {U} x = px
  \return U.op (\case px \with { | just c => c | nothing => U.unit }) x = x
  \with {
    | just c, hpx => U.cmra_pcore_l x c hpx
    | nothing, _  => U.ucmra_unit_left_id x
  }

\lemma ucmra_core_idemp {U : UCMRA} (x : U.E)
  : ucmra_core (ucmra_core x) = ucmra_core x
  => \case pcore {U} x \as px, idp : pcore {U} x = px
  \return ucmra_core {U} (\case px \with { | just c => c | nothing => U.unit })
    = (\case px \with { | just c => c | nothing => U.unit })
  \with {
    | just c, hpx =>
      \let
        | hpcc : pcore {U} c = just c => U.cmra_pcore_idemp x c hpx
      \in path (\lam i =>
          \case hpcc @ i \with {
            | just c' => c'
            | nothing => U.unit
          })
    | nothing, _ =>
      path (\lam i =>
          \case U.ucmra_pcore_unit @ i \with {
            | just u => u
            | nothing => U.unit
          })
  }

\lemma ucmra_core_mono {U : UCMRA} (x y : U.E)
                       (h : incl {U.E} {U} {\new Op U.E { | op => U.op }} x y)
  : incl {U.E} {U} {\new Op U.E { | op => U.op }} (ucmra_core x) (ucmra_core y)
  => \case pcore {U} x \as px, idp : pcore {U} x = px
  \return incl {U.E} {U} {\new Op U.E { | op => U.op }}
      (\case px \with { | just c => c | nothing => U.unit })
      (ucmra_core y)
  \with {
    | nothing, _ => ucmra_unit_least (ucmra_core y)
    | just cx, hpx =>
      \case U.cmra_pcore_mono x y cx h hpx \with {
        | inP (cy, hpy, hincl_cy) =>
          transport
              (\lam py => incl {U.E} {U} {\new Op U.E { | op => U.op }}
                  cx
                  (\case py \with { | just c => c | nothing => U.unit }))
              (inv hpy)
              hincl_cy
      }
  }
