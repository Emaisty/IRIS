-- =================================================================================
-- Smoke tests for the assembled complete BI instance `BIuPredBI`
-- (IRIS_PORT_REMAINING.md, "Complete concrete BI instance").
--
-- Each test restates a public law's signature and proves it through the
-- combined BI instance rather than an individual mixin, so a drift in the
-- assembly (not just in one mixin) breaks the build.
-- =================================================================================

\import Logic
\import interface
\import cmra
\import uPred
\import updates

-- BIMixin part reachable from the assembled instance.
\lemma test_BI_and_elim_l {M : UCMRA} (P Q : ProperUPred M)
  : properUPred_ent (mkProperAnd P Q) P =>
  (BIuPredBI M).bi_mixin_and_elim_l P Q

-- BIPersistentlyMixin part reachable from the assembled instance.
\lemma test_BI_persistently_mono {M : UCMRA} (P Q : ProperUPred M)
                                 (h : properUPred_ent P Q)
  : properUPred_ent (mkProperPersistently P) (mkProperPersistently Q) =>
  (BIuPredBI M).persistently_mono P Q h

-- BILaterMixin part reachable from the assembled instance.
\lemma test_BI_later_intro {M : UCMRA} (P : ProperUPred M)
  : properUPred_ent P (mkProperLater P) =>
  (BIuPredBI M).later_intro P

\lemma test_BI_later_mono {M : UCMRA} (P Q : ProperUPred M)
                          (h : properUPred_ent P Q)
  : properUPred_ent (mkProperLater P) (mkProperLater Q) =>
  (BIuPredBI M).later_mono P Q h

\lemma test_BI_later_sep_split {M : UCMRA} (P Q : ProperUPred M)
  : properUPred_ent (mkProperLater (mkProperSep P Q))
                    (mkProperSep (mkProperLater P) (mkProperLater Q)) =>
  (BIuPredBI M).later_sep_1 P Q

\lemma test_BI_later_sep_merge {M : UCMRA} (P Q : ProperUPred M)
  : properUPred_ent (mkProperSep (mkProperLater P) (mkProperLater Q))
                    (mkProperLater (mkProperSep P Q)) =>
  (BIuPredBI M).later_sep_2 P Q

\lemma test_BI_later_persistently {M : UCMRA} (P : ProperUPred M)
  : properUPred_ent (mkProperLater (mkProperPersistently P))
                    (mkProperPersistently (mkProperLater P)) =>
  (BIuPredBI M).later_persistently_1 P

\lemma test_BI_later_false_em {M : UCMRA} (P : ProperUPred M)
  : properUPred_ent (mkProperLater P)
                    (mkProperOr (mkProperLater (mkProperPure Empty))
                                (mkProperImpl (mkProperLater (mkProperPure Empty)) P)) =>
  (BIuPredBI M).later_false_em P

-- A derivation across mixins: except-zero introduction `P ⊢ ◇ P`, built from
-- the BIMixin disjunction law at the later-based `◇` of uPred.
\lemma test_BI_except_zero_intro {M : UCMRA} (P : ProperUPred M)
  : properUPred_ent P (mkProperExceptZero P) =>
  (BIuPredBI M).bi_mixin_or_intro_r (mkProperLater (mkProperPure Empty)) P
