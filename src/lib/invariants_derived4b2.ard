-- mask-restore step of inv_combine.
\sfunc inv_combine_at_inner_mask {S : gFunctors} (W : wsatGS S)
    (E D1 D12 DN : coPset) (P Q : iProp S)
    (hDN12 : coPSubset DN D12)
  : properUPred_ent
      (mkProperSep
        (mkProperSep (mkProperLater P)
          (mkProperWand (mkProperLater P) (mkProperFUpd W D1 E mkProperEmp)))
        (mkProperSep (mkProperLater Q)
          (mkProperWand (mkProperLater Q) (mkProperFUpd W D12 D1 mkProperEmp))))
      (mkProperFUpd W D12 DN
        (mkProperSep (mkProperLater (mkProperSep P Q))
          (mkProperWand (mkProperLater (mkProperSep P Q))
            (sealedFUpd W DN E mkProperEmp)))) =>
  \let
    | K' => mkProperFUpd W DN D12 mkProperEmp
    | Ks => sealedFUpd W DN D12 mkProperEmp
    | CP => mkProperWand (mkProperLater P) (mkProperFUpd W D1 E mkProperEmp)
    | CQ => mkProperWand (mkProperLater Q) (mkProperFUpd W D12 D1 mkProperEmp)
    | LP => mkProperLater P
    | LQ => mkProperLater Q
    | LPQ => mkProperLater (mkProperSep P Q)
    | CTs => mkProperWand LPQ (sealedFUpd W DN E mkProperEmp)
    | Ts => mkProperSep LPQ CTs
    | bodies => mkProperSep (mkProperSep LP CP) (mkProperSep LQ CQ)
    | unseal_K : properUPred_ent Ks K' =>
        transport (\lam (Z : iProp S) => properUPred_ent Z K')
          (Paths.inv (sealedFUpd_peval W DN D12 mkProperEmp))
          (properUPred_ent_refl K')
    | p0 : properUPred_ent bodies
        (mkProperSep LPQ (mkProperSep CP CQ)) =>
        \lam n x hv h =>
          \let
            | p1 => sep_assoc_l_ent LP CP (mkProperSep LQ CQ) n x hv h
            | p2 => sep_mono_r_ent LP
                (mkProperSep CP (mkProperSep LQ CQ))
                (mkProperSep LQ (mkProperSep CP CQ))
                (sep_swap_ent CP LQ CQ) n x hv p1
            | p3 => sep_assoc_r_ent LP LQ (mkProperSep CP CQ) n x hv p2
          \in sep_mono_l_ent (mkProperSep LP LQ) LPQ
            (mkProperSep CP CQ)
            (proper_later_sep_2 P Q) n x hv p3
    | final_asm : properUPred_ent
        (mkProperSep Ks bodies) Ts =>
        \lam n x hv h =>
          \let
            | h0 => sep_mono_l_ent Ks K' bodies unseal_K n x hv h
            | q0 => sep_mono_r_ent K' bodies
                (mkProperSep LPQ (mkProperSep CP CQ)) p0 n x hv h0
            | q1 => sep_swap_ent K' LPQ (mkProperSep CP CQ) n x hv q0
          \in sep_mono_r_ent LPQ
            (mkProperSep K' (mkProperSep CP CQ)) CTs
            (fupd_close_chain W E D1 D12 DN P Q) n x hv q1
  \in \lam n x hv h =>
    \let
      | k1 => attach_valid_r_ent bodies
          (mkProperFUpd W D12 DN Ks)
          (fupd_mask_subseteq_sealed W D12 DN hDN12) n x hv h
      | k2 => sep_comm_ent bodies (mkProperFUpd W D12 DN Ks) n x hv k1
      | k3 => fupd_frame_r W D12 DN Ks bodies n x hv k2
    \in fupd_mono W D12 DN (mkProperSep Ks bodies) Ts final_asm
      n x hv k3

