-- =================================================================================
-- §9  inv_acc_timeless (Rocq invariants.v:196): a Timeless invariant body
--     can be taken without the later.
-- =================================================================================

\lemma inv_acc_timeless {S : gFunctors} (W : wsatGS S)
    (E : coPset) (N : Namespace) (P : iProp S)
    (hNE : coPSubset (nclose N) E) (hT : Timeless P)
  : properUPred_ent (inv W N P)
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep P
          (mkProperWand P
            (mkProperFUpd W (coPset_difference E (nclose N)) E
              mkProperEmp)))) =>
  \let
    | F => mkProperFUpd W (coPset_difference E (nclose N)) E mkProperEmp
    | C => mkProperWand (mkProperLater P) F
    | C' => mkProperWand P F
    | strengthen : properUPred_ent C C' =>
        wand_intro_ent C P F
          (properUPred_ent_trans (mkProperSep C P)
            (mkProperSep C (mkProperLater P)) F
            (sep_mono_r_ent C P (mkProperLater P) (proper_later_intro P))
            (wand_elim_ent (mkProperLater P) F))
    | body : properUPred_ent
        (mkProperSep (mkProperLater P) C)
        (mkProperExceptZero (mkProperSep P C')) =>
        properUPred_ent_trans
          (mkProperSep (mkProperLater P) C)
          (mkProperSep (mkProperExceptZero P) C)
          (mkProperExceptZero (mkProperSep P C'))
          (sep_mono_l_ent (mkProperLater P) (mkProperExceptZero P) C hT)
          (properUPred_ent_trans
            (mkProperSep (mkProperExceptZero P) C)
            (mkProperExceptZero (mkProperSep P C))
            (mkProperExceptZero (mkProperSep P C'))
            (except_zero_frame_r P C)
            (except_zero_mono (mkProperSep P C) (mkProperSep P C')
              (sep_mono_r_ent P C C' strengthen)))
  \in properUPred_ent_trans (inv W N P)
    (mkProperFUpd W E (coPset_difference E (nclose N))
      (mkProperSep (mkProperLater P) C))
    (mkProperFUpd W E (coPset_difference E (nclose N))
      (mkProperSep P C'))
    (inv_acc W E N P hNE)
    (properUPred_ent_trans
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (mkProperLater P) C))
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperExceptZero (mkProperSep P C')))
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep P C'))
      (fupd_mono W E (coPset_difference E (nclose N))
        (mkProperSep (mkProperLater P) C)
        (mkProperExceptZero (mkProperSep P C')) body)
      (fupd_except_0 W E (coPset_difference E (nclose N))
        (mkProperSep P C')))

