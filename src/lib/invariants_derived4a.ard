-- =================================================================================
-- §10  inv_alloc_open (Rocq invariants.v:60, :123): allocation that hands
--      the new invariant back open, together with a closing continuation.
--      Uses `ownI_alloc_open` and reuses `own_inv_close_token` from the
--      semantic core.
-- =================================================================================

-- ▷P ⊢ ◇-free close continuation target
\func inv_open_close_tok {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S) : iProp S =>
  mkProperWand (mkProperLater P)
    (mkProperFUpd W (coPset_difference E (nclose N)) E mkProperEmp)

\func inv_alloc_open_exist_body {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (P : iProp S) : iProp S =>
  mkProperExist gname (\lam i =>
    mkProperSep (mkProperPure (coPIn i (nclose N)))
      (mkProperSep
        (mkProperWand (ownE W (coPset_singleton i)) (wsat W))
        (mkProperSep (ownI W i P) (ownD W (gset_singleton i)))))

\func inv_alloc_open_target {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S) : iProp S =>
  mkProperSep (wsat W)
    (mkProperSep (ownE W (coPset_difference E (nclose N)))
      (mkProperSep (own_inv W N P) (inv_open_close_tok W N E P)))

-- per-witness assembly: the freshly allocated open invariant, the wsat
-- wand, the disabled token and ownE E are reshaped into the target world.
\sfunc inv_alloc_open_assemble {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S) (i : gname)
    (hiN : coPIn i (nclose N)) (hNE : coPSubset (nclose N) E)
  : properUPred_ent
      (mkProperSep
        (mkProperSep
          (mkProperWand (ownE W (coPset_singleton i)) (wsat W))
          (mkProperSep (ownI W i P) (ownD W (gset_singleton i))))
        (ownE W E))
      (inv_alloc_open_target W N E P) =>
  \let
    | UN => nclose N
    | WW => mkProperWand (ownE W (coPset_singleton i)) (wsat W)
    | I => ownI W i P
    | D => ownD W (gset_singleton i)
    | OE => ownE W E
    | ON => ownE W UN
    | Oi => ownE W (coPset_singleton i)
    | ONi => ownE W (coPset_difference UN (coPset_singleton i))
    | OR => ownE W (coPset_difference E UN)
    | Ctok => inv_open_close_tok W N E P
    -- split ownE E and duplicate ownI
    | t1 : properUPred_ent (mkProperSep (mkProperSep WW (mkProperSep I D)) OE)
        (mkProperSep (mkProperSep WW (mkProperSep I D))
          (mkProperSep ON OR)) =>
        sep_mono_r_ent (mkProperSep WW (mkProperSep I D)) OE
          (mkProperSep ON OR)
          (ownE_split_subset W E UN hNE)
    | t2 : properUPred_ent
        (mkProperSep (mkProperSep WW (mkProperSep I D))
          (mkProperSep ON OR))
        (mkProperSep (mkProperSep WW (mkProperSep I D))
          (mkProperSep (mkProperSep Oi ONi) OR)) =>
        sep_mono_r_ent (mkProperSep WW (mkProperSep I D))
          (mkProperSep ON OR)
          (mkProperSep (mkProperSep Oi ONi) OR)
          (sep_mono_l_ent ON (mkProperSep Oi ONi) OR
            (ownE_split_subset W UN (coPset_singleton i)
              (coPset_singleton_subset i UN hiN)))
    | t3 : properUPred_ent
        (mkProperSep (mkProperSep WW (mkProperSep I D))
          (mkProperSep (mkProperSep Oi ONi) OR))
        (mkProperSep (mkProperSep WW (mkProperSep (mkProperSep I I) D))
          (mkProperSep (mkProperSep Oi ONi) OR)) =>
        sep_mono_l_ent (mkProperSep WW (mkProperSep I D))
          (mkProperSep WW (mkProperSep (mkProperSep I I) D))
          (mkProperSep (mkProperSep Oi ONi) OR)
          (sep_mono_r_ent WW (mkProperSep I D)
            (mkProperSep (mkProperSep I I) D)
            (sep_mono_l_ent I (mkProperSep I I) D (ownI_dup W i P)))
    -- flatten to right-nested WW,I,I,D,Oi,ONi,OR
    | a1 : properUPred_ent
        (mkProperSep (mkProperSep WW (mkProperSep (mkProperSep I I) D))
          (mkProperSep (mkProperSep Oi ONi) OR))
        (mkProperSep WW (mkProperSep (mkProperSep (mkProperSep I I) D)
          (mkProperSep (mkProperSep Oi ONi) OR))) =>
        sep_assoc_l_ent WW (mkProperSep (mkProperSep I I) D)
          (mkProperSep (mkProperSep Oi ONi) OR)
    | a2 : properUPred_ent
        (mkProperSep WW (mkProperSep (mkProperSep (mkProperSep I I) D)
          (mkProperSep (mkProperSep Oi ONi) OR)))
        (mkProperSep WW (mkProperSep (mkProperSep I I)
          (mkProperSep D (mkProperSep (mkProperSep Oi ONi) OR)))) =>
        sep_mono_r_ent WW
          (mkProperSep (mkProperSep (mkProperSep I I) D)
            (mkProperSep (mkProperSep Oi ONi) OR))
          (mkProperSep (mkProperSep I I)
            (mkProperSep D (mkProperSep (mkProperSep Oi ONi) OR)))
          (sep_assoc_l_ent (mkProperSep I I) D
            (mkProperSep (mkProperSep Oi ONi) OR))
    | a3 : properUPred_ent
        (mkProperSep WW (mkProperSep (mkProperSep I I)
          (mkProperSep D (mkProperSep (mkProperSep Oi ONi) OR))))
        (mkProperSep WW (mkProperSep I (mkProperSep I
          (mkProperSep D (mkProperSep (mkProperSep Oi ONi) OR))))) =>
        sep_mono_r_ent WW
          (mkProperSep (mkProperSep I I)
            (mkProperSep D (mkProperSep (mkProperSep Oi ONi) OR)))
          (mkProperSep I (mkProperSep I
            (mkProperSep D (mkProperSep (mkProperSep Oi ONi) OR))))
          (sep_assoc_l_ent I I
            (mkProperSep D (mkProperSep (mkProperSep Oi ONi) OR)))
    | a4 : properUPred_ent
        (mkProperSep WW (mkProperSep I (mkProperSep I
          (mkProperSep D (mkProperSep (mkProperSep Oi ONi) OR)))))
        (mkProperSep WW (mkProperSep I (mkProperSep I
          (mkProperSep D (mkProperSep Oi (mkProperSep ONi OR)))))) =>
        sep_mono_r_ent WW _ _
          (sep_mono_r_ent I _ _
            (sep_mono_r_ent I _ _
              (sep_mono_r_ent D
                (mkProperSep (mkProperSep Oi ONi) OR)
                (mkProperSep Oi (mkProperSep ONi OR))
                (sep_assoc_l_ent Oi ONi OR))))
    -- bring Oi to the front (next to WW)
    | b1 : properUPred_ent
        (mkProperSep WW (mkProperSep I (mkProperSep I
          (mkProperSep D (mkProperSep Oi (mkProperSep ONi OR))))))
        (mkProperSep WW (mkProperSep I (mkProperSep I
          (mkProperSep Oi (mkProperSep D (mkProperSep ONi OR)))))) =>
        sep_mono_r_ent WW _ _
          (sep_mono_r_ent I _ _
            (sep_mono_r_ent I _ _
              (sep_swap_ent D Oi (mkProperSep ONi OR))))
    | b2 : properUPred_ent
        (mkProperSep WW (mkProperSep I (mkProperSep I
          (mkProperSep Oi (mkProperSep D (mkProperSep ONi OR))))))
        (mkProperSep WW (mkProperSep I (mkProperSep Oi
          (mkProperSep I (mkProperSep D (mkProperSep ONi OR)))))) =>
        sep_mono_r_ent WW _ _
          (sep_mono_r_ent I _ _
            (sep_swap_ent I Oi (mkProperSep D (mkProperSep ONi OR))))
    | b3 : properUPred_ent
        (mkProperSep WW (mkProperSep I (mkProperSep Oi
          (mkProperSep I (mkProperSep D (mkProperSep ONi OR))))))
        (mkProperSep WW (mkProperSep Oi (mkProperSep I
          (mkProperSep I (mkProperSep D (mkProperSep ONi OR)))))) =>
        sep_mono_r_ent WW _ _
          (sep_swap_ent I Oi
            (mkProperSep I (mkProperSep D (mkProperSep ONi OR))))
    | b4 : properUPred_ent
        (mkProperSep WW (mkProperSep Oi (mkProperSep I
          (mkProperSep I (mkProperSep D (mkProperSep ONi OR))))))
        (mkProperSep (mkProperSep WW Oi) (mkProperSep I
          (mkProperSep I (mkProperSep D (mkProperSep ONi OR))))) =>
        sep_assoc_r_ent WW Oi
          (mkProperSep I (mkProperSep I (mkProperSep D (mkProperSep ONi OR))))
    -- bring OR to the front of the right group
    | b5 : properUPred_ent
        (mkProperSep (mkProperSep WW Oi) (mkProperSep I
          (mkProperSep I (mkProperSep D (mkProperSep ONi OR)))))
        (mkProperSep (mkProperSep WW Oi) (mkProperSep I
          (mkProperSep I (mkProperSep D (mkProperSep OR ONi))))) =>
        sep_mono_r_ent (mkProperSep WW Oi) _ _
          (sep_mono_r_ent I _ _
            (sep_mono_r_ent I _ _
              (sep_mono_r_ent D
                (mkProperSep ONi OR) (mkProperSep OR ONi)
                (sep_comm_ent ONi OR))))
    | b6 : properUPred_ent
        (mkProperSep (mkProperSep WW Oi) (mkProperSep I
          (mkProperSep I (mkProperSep D (mkProperSep OR ONi)))))
        (mkProperSep (mkProperSep WW Oi) (mkProperSep I
          (mkProperSep I (mkProperSep OR (mkProperSep D ONi))))) =>
        sep_mono_r_ent (mkProperSep WW Oi) _ _
          (sep_mono_r_ent I _ _
            (sep_mono_r_ent I _ _
              (sep_swap_ent D OR ONi)))
    | b7 : properUPred_ent
        (mkProperSep (mkProperSep WW Oi) (mkProperSep I
          (mkProperSep I (mkProperSep OR (mkProperSep D ONi)))))
        (mkProperSep (mkProperSep WW Oi) (mkProperSep I
          (mkProperSep OR (mkProperSep I (mkProperSep D ONi))))) =>
        sep_mono_r_ent (mkProperSep WW Oi) _ _
          (sep_mono_r_ent I _ _
            (sep_swap_ent I OR (mkProperSep D ONi)))
    | b8 : properUPred_ent
        (mkProperSep (mkProperSep WW Oi) (mkProperSep I
          (mkProperSep OR (mkProperSep I (mkProperSep D ONi)))))
        (mkProperSep (mkProperSep WW Oi) (mkProperSep OR
          (mkProperSep I (mkProperSep I (mkProperSep D ONi))))) =>
        sep_mono_r_ent (mkProperSep WW Oi) _ _
          (sep_swap_ent I OR
            (mkProperSep I (mkProperSep D ONi)))
    -- final conversions
    | m1 : properUPred_ent
        (mkProperSep (mkProperSep WW Oi) (mkProperSep OR
          (mkProperSep I (mkProperSep I (mkProperSep D ONi)))))
        (mkProperSep (wsat W) (mkProperSep OR
          (mkProperSep I (mkProperSep I (mkProperSep D ONi))))) =>
        sep_mono_l_ent (mkProperSep WW Oi) (wsat W)
          (mkProperSep OR
            (mkProperSep I (mkProperSep I (mkProperSep D ONi))))
          (wand_elim_ent Oi (wsat W))
    | m2 : properUPred_ent
        (mkProperSep (wsat W) (mkProperSep OR
          (mkProperSep I (mkProperSep I (mkProperSep D ONi)))))
        (mkProperSep (wsat W) (mkProperSep OR
          (mkProperSep (own_inv W N P) (mkProperSep I (mkProperSep D ONi))))) =>
        sep_mono_r_ent (wsat W) _ _
          (sep_mono_r_ent OR _ _
            (sep_mono_l_ent I (own_inv W N P)
              (mkProperSep I (mkProperSep D ONi))
              (properUPred_ent_trans I
                (mkProperSep (mkProperPure (coPIn i UN)) I)
                (own_inv W N P)
                (pure_intro_sep_ent (coPIn i UN) hiN I)
                (own_inv_intro W N P i))))
    | m3 : properUPred_ent
        (mkProperSep (wsat W) (mkProperSep OR
          (mkProperSep (own_inv W N P)
            (mkProperSep I (mkProperSep D ONi)))))
        (inv_alloc_open_target W N E P) =>
        sep_mono_r_ent (wsat W) _ _
          (sep_mono_r_ent OR _ _
            (sep_mono_r_ent (own_inv W N P)
              (mkProperSep I (mkProperSep D ONi)) Ctok
              (own_inv_close_token W N E P i hiN hNE)))
  \in \lam n x hv h =>
    m3 n x hv (m2 n x hv (m1 n x hv (b8 n x hv (b7 n x hv (b6 n x hv
      (b5 n x hv (b4 n x hv (b3 n x hv (b2 n x hv (b1 n x hv (a4 n x hv
        (a3 n x hv (a2 n x hv (a1 n x hv (t3 n x hv (t2 n x hv
          (t1 n x hv h)))))))))))))))))

-- eliminate the existential and the pure witness membership
\sfunc inv_alloc_open_elim {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S)
    (hNE : coPSubset (nclose N) E)
  : properUPred_ent
      (mkProperSep (inv_alloc_open_exist_body W N P) (ownE W E))
      (inv_alloc_open_target W N E P) =>
  sep_exist_l_elim
    (\lam i =>
      mkProperSep (mkProperPure (coPIn i (nclose N)))
        (mkProperSep
          (mkProperWand (ownE W (coPset_singleton i)) (wsat W))
          (mkProperSep (ownI W i P) (ownD W (gset_singleton i)))))
    (ownE W E) (inv_alloc_open_target W N E P)
    (\lam i n x hv h => \case h \with {
      | inP (a, b, dab, hXi, hOE) => \case hXi \with {
        | inP (a1, a2, da12, hpure, hrest) =>
          inv_alloc_open_assemble W N E P i hpure hNE n x hv
            (inP (a, b, dab,
              sep_elim_r_ent (mkProperPure (coPIn i (nclose N)))
                (mkProperSep
                  (mkProperWand (ownE W (coPset_singleton i)) (wsat W))
                  (mkProperSep (ownI W i P) (ownD W (gset_singleton i))))
                n a (validN_sub_l {iResUR S} n x a b hv dab)
                (inP (a1, a2, da12, hpure, hrest)),
              hOE))
      }
    })

\sfunc own_inv_alloc_open {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S)
    (hNE : coPSubset (nclose N) E)
  : properUPred_ent mkProperEmp
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (own_inv W N P) (inv_open_close_tok W N E P))) =>
  \lam n x hv _ m m_le_n frame hv_op hworld =>
    \let
      | xf => (iResUR S).op x frame
      | hworld' : (mkProperSep (wsat W) (ownE W E)).upred_holds m xf =>
          (mkProperSep (wsat W) (ownE W E)).upred_mono m m frame xf hworld
            (inP (x, cmra_comm_dist {iResUR S} m x frame)) <=-refl
      | step1 : properUPred_ent
          (mkProperSep (wsat W) (ownE W E))
          (mkProperSep (mkProperBUpd (inv_alloc_open_exist_body W N P))
            (ownE W E)) =>
          sep_mono_l_ent (wsat W)
            (mkProperBUpd (inv_alloc_open_exist_body W N P)) (ownE W E)
            (ownI_alloc_open W (\lam i => coPIn i (nclose N)) P
              (fresh_inv_oracle N))
      | step2 : properUPred_ent
          (mkProperSep (mkProperBUpd (inv_alloc_open_exist_body W N P))
            (ownE W E))
          (mkProperBUpd
            (mkProperSep (inv_alloc_open_exist_body W N P) (ownE W E))) =>
          bupd_frame_r (inv_alloc_open_exist_body W N P) (ownE W E)
      | step3 : properUPred_ent
          (mkProperBUpd
            (mkProperSep (inv_alloc_open_exist_body W N P) (ownE W E)))
          (mkProperBUpd
            (mkProperExceptZero (inv_alloc_open_target W N E P))) =>
          bupd_mono
            (mkProperSep (inv_alloc_open_exist_body W N P) (ownE W E))
            (mkProperExceptZero (inv_alloc_open_target W N E P))
            (properUPred_ent_trans
              (mkProperSep (inv_alloc_open_exist_body W N P) (ownE W E))
              (inv_alloc_open_target W N E P)
              (mkProperExceptZero (inv_alloc_open_target W N E P))
              (inv_alloc_open_elim W N E P hNE)
              (or_intro_r_ent (mkProperLater (mkProperPure Empty))
                (inv_alloc_open_target W N E P)))
    \in step3 m xf hv_op (step2 m xf hv_op (step1 m xf hv_op hworld'))

\lemma inv_alloc_open {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S)
    (hNE : coPSubset (nclose N) E)
  : properUPred_ent mkProperEmp
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (inv W N P) (inv_open_close_tok W N E P))) =>
  properUPred_ent_trans mkProperEmp
    (mkProperFUpd W E (coPset_difference E (nclose N))
      (mkProperSep (own_inv W N P) (inv_open_close_tok W N E P)))
    (mkProperFUpd W E (coPset_difference E (nclose N))
      (mkProperSep (inv W N P) (inv_open_close_tok W N E P)))
    (own_inv_alloc_open W N E P hNE)
    (fupd_mono W E (coPset_difference E (nclose N))
      (mkProperSep (own_inv W N P) (inv_open_close_tok W N E P))
      (mkProperSep (inv W N P) (inv_open_close_tok W N E P))
      (sep_mono_l_ent (own_inv W N P) (inv W N P)
        (inv_open_close_tok W N E P)
        (own_inv_to_inv W N P)))

