-- =================================================================================
-- A11 (continued): the derived public invariant API, following Iris
-- base_logic/lib/invariants.v.  Split from `lib.invariants` so the heavy
-- semantic core stays cached while this layer is iterated on (same
-- convention as the wsat / wsat_alloc split).
--
-- Contents: inv_contractive/ne/proper, inv_alter, inv_iff, inv_alloc_open,
-- inv_combine(_dup_l), except_0_inv, inv_split_l/r, inv_split,
-- inv_acc_strong, inv_acc_timeless.
--
-- The generic `upredDist_*` congruences and the small entailment helpers in
-- §1/§3 are candidates for relocation into uPred.ard / lib.big_op next to
-- their siblings during the step-4 cleanup pass.
-- =================================================================================

-- =================================================================================
-- §1  Generic distance congruences (left-hand versions of the `_r` lemmas
--     in uPred.ard).
-- =================================================================================

\lemma upredDist_trans {M : UCMRA} (n : Nat) (P Q R : ProperUPred M)
    (h1 : upredDist n P Q) (h2 : upredDist n Q R) : upredDist n P R =>
  \lam m a hm hv =>
    \let | pq => h1 m a hm hv | qr => h2 m a hm hv
    \in (\lam hp => qr.1 (pq.1 hp), \lam hr => pq.2 (qr.2 hr))

\lemma upredDist_sep_l {M : UCMRA} (n : Nat) (R P Q : ProperUPred M)
    (h : upredDist n P Q)
  : upredDist n (mkProperSep P R) (mkProperSep Q R) =>
  \lam m a hm hv =>
    ( \lam hsep => \case hsep \with {
        | inP (a1, a2, dist_a, hp, hr) =>
          inP (a1, a2, dist_a,
            (h m a1 hm (validN_sub_l m a a1 a2 hv dist_a)).1 hp, hr)
      }
    , \lam hsep => \case hsep \with {
        | inP (a1, a2, dist_a, hq, hr) =>
          inP (a1, a2, dist_a,
            (h m a1 hm (validN_sub_l m a a1 a2 hv dist_a)).2 hq, hr)
      }
    )

\lemma upredDist_wand_l {M : UCMRA} (n : Nat) (R P Q : ProperUPred M)
    (h : upredDist n P Q)
  : upredDist n (mkProperWand P R) (mkProperWand Q R) =>
  \lam m a hm hv =>
    ( \lam hwand k k_le_m a2 hv_op hq =>
        hwand k k_le_m a2 hv_op
          ((h k a2 ((NatSemiring.<=∘) k_le_m hm)
             (cmra_validN_op_r {M} k a a2 hv_op)).2 hq)
    , \lam hwand k k_le_m a2 hv_op hp =>
        hwand k k_le_m a2 hv_op
          ((h k a2 ((NatSemiring.<=∘) k_le_m hm)
             (cmra_validN_op_r {M} k a a2 hv_op)).1 hp)
    )

-- =================================================================================
-- §2  Distance lemmas for `inv` (Rocq: inv_contractive, inv_ne, inv_proper).
--     `P` occurs in `inv_inner` only under `▷` — once on the left of the
--     `sep` and once on the left of the closing wand — so contractiveness
--     composes from `upredDist_later` and the congruences above.
-- =================================================================================

\sfunc inv_inner_ne {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (n : Nat) (P Q : iProp S)
    (hl : upredDist n (mkProperLater P) (mkProperLater Q))
  : upredDist n (inv_inner W N P) (inv_inner W N Q) =>
  upredDist_forall coPset n
    (\lam E => mkProperImpl (mkProperPure (coPSubset (nclose N) E))
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (mkProperLater P)
          (mkProperWand (mkProperLater P)
            (mkProperFUpd W (coPset_difference E (nclose N)) E
              mkProperEmp)))))
    (\lam E => mkProperImpl (mkProperPure (coPSubset (nclose N) E))
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (mkProperLater Q)
          (mkProperWand (mkProperLater Q)
            (mkProperFUpd W (coPset_difference E (nclose N)) E
              mkProperEmp)))))
    (\lam E =>
      \let
        | F => mkProperFUpd W (coPset_difference E (nclose N)) E mkProperEmp
        | LP => mkProperLater P
        | LQ => mkProperLater Q
        | bodyP => mkProperSep LP (mkProperWand LP F)
        | bodyM => mkProperSep LQ (mkProperWand LP F)
        | bodyQ => mkProperSep LQ (mkProperWand LQ F)
        | hbody : upredDist n bodyP bodyQ =>
            upredDist_trans n bodyP bodyM bodyQ
              (upredDist_sep_l n (mkProperWand LP F) LP LQ hl)
              (upredDist_sep_r n LQ (mkProperWand LP F) (mkProperWand LQ F)
                (upredDist_wand_l n F LP LQ hl))
      \in upredDist_impl_r n (mkProperPure (coPSubset (nclose N) E))
        (mkProperFUpd W E (coPset_difference E (nclose N)) bodyP)
        (mkProperFUpd W E (coPset_difference E (nclose N)) bodyQ)
        (fupd_ne W n E (coPset_difference E (nclose N)) bodyP bodyQ hbody))

\sfunc inv_contractive {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (n : Nat) (P Q : iProp S)
    (h : \Pi (k : Nat) -> k NatOrder.< n -> upredDist k P Q)
  : upredDist n (inv W N P) (inv W N Q) =>
  \let
    | hl : upredDist n (mkProperLater P) (mkProperLater Q) =>
        upredDist_later n P Q h
    | hbody : upredDist n (inv_body W N P) (inv_body W N Q) =>
        upredDist_persistently n (inv_inner W N P) (inv_inner W N Q)
          (inv_inner_ne W N n P Q hl)
  \in transport (\lam (Z : iProp S) => upredDist n Z (inv W N Q))
        (Paths.inv (inv_peval W N P))
        (transport (\lam (Z : iProp S) => upredDist n (inv_body W N P) Z)
          (Paths.inv (inv_peval W N Q))
          hbody)

\lemma inv_ne {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (n : Nat) (P Q : iProp S) (h : upredDist n P Q)
  : upredDist n (inv W N P) (inv W N Q) =>
  inv_contractive W N n P Q
    (\lam k hk =>
      upredDist_le n k P Q h ((NatSemiring.<=∘) (n<=sucn k) (suc_<_<= hk)))

\lemma inv_proper {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (P Q : iProp S) (h : upredEquiv P Q)
  : upredEquiv (inv W N P) (inv W N Q) =>
  \lam n a hv =>
    inv_ne W N n P Q (\lam m b _ hvb => h m b hvb) n a <=-refl hv

-- =================================================================================
-- §3  Small entailment helpers.
-- =================================================================================

\lemma inv_unfold_ent {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (P : iProp S)
  : properUPred_ent (inv W N P) (inv_body W N P) =>
  transport (\lam (Z : iProp S) => properUPred_ent Z (inv_body W N P))
    (Paths.inv (inv_peval W N P))
    (properUPred_ent_refl (inv_body W N P))

\lemma inv_fold_ent {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (P : iProp S)
  : properUPred_ent (inv_body W N P) (inv W N P) =>
  transport (\lam (Z : iProp S) => properUPred_ent (inv_body W N P) Z)
    (Paths.inv (inv_peval W N P))
    (properUPred_ent_refl (inv_body W N P))

\lemma and_elim_l_ent {M : UCMRA} (P Q : ProperUPred M)
  : properUPred_ent (mkProperAnd P Q) P =>
  \lam n x hv h => h.1

\lemma and_elim_r_ent {M : UCMRA} (P Q : ProperUPred M)
  : properUPred_ent (mkProperAnd P Q) Q =>
  \lam n x hv h => h.2

-- (P -∗ Q) ∗ P ⊢ Q
\lemma wand_elim_ent {M : UCMRA} (P Q : ProperUPred M)
  : properUPred_ent (mkProperSep (mkProperWand P Q) P) Q =>
  \lam n x hv hs => \case hs \with {
    | inP (a1, a2, da, hw, hp) =>
      Q.upred_mono n n (M.op a1 a2) x
        (hw n <=-refl a2 (M.cmra_validN_ne n x (M.op a1 a2) da hv) hp)
        (inclN_of_dist_unit n (M.op a1 a2) x da)
        <=-refl
  }

\lemma forall_intro_ent {M : UCMRA} {T : \Set0} (X : ProperUPred M)
    (Phi : T -> ProperUPred M)
    (h : \Pi (t : T) -> properUPred_ent X (Phi t))
  : properUPred_ent X (mkProperForall T Phi) =>
  \lam n x hv hX t => h t n x hv hX

\lemma forall_elim_ent {M : UCMRA} {T : \Set0} (Phi : T -> ProperUPred M)
    (t : T)
  : properUPred_ent (mkProperForall T Phi) (Phi t) =>
  \lam n x hv hAll => hAll t

\lemma impl_pure_intro_ent {M : UCMRA} (phi : \Prop) (X Y : ProperUPred M)
    (h : phi -> properUPred_ent X Y)
  : properUPred_ent X (mkProperImpl (mkProperPure phi) Y) =>
  \lam n x hv hX m m_le_n b incl hvb hphi =>
    h hphi m b hvb (X.upred_mono n m x b hX incl m_le_n)

\lemma impl_pure_elim_ent {M : UCMRA} (phi : \Prop) (Y : ProperUPred M)
    (hphi : phi)
  : properUPred_ent (mkProperImpl (mkProperPure phi) Y) Y =>
  \lam n x hv himpl =>
    himpl n <=-refl x (inclN_refl_ucmra n x) hv hphi

-- □P ∗ □Q ⊢ □(P ∗ Q): both conjuncts move to the shared core (the core is
-- monotone), which is duplicable.
\lemma persistently_sep_2_ent {M : UCMRA} (P Q : ProperUPred M)
  : properUPred_ent
      (mkProperSep (mkProperPersistently P) (mkProperPersistently Q))
      (mkProperPersistently (mkProperSep P Q)) =>
  \lam n x hv hs => \case hs \with {
    | inP (a1, a2, da, hp, hq) =>
      \let
        | incl1 : inclN {M} {\new Op M.E { | op => M.op }} a1 n x =>
            inP (a2, da)
        | incl2 : inclN {M} {\new Op M.E { | op => M.op }} a2 n x =>
            inP (a1, M.ofe_dist_trans n x (M.op a1 a2) (M.op a2 a1) da
              (cmra_comm_dist n a1 a2))
        | hp' : P.upred_holds n (ucmra_core x) =>
            P.upred_mono n n (ucmra_core a1) (ucmra_core x) hp
              (ucmra_core_monoN n a1 x incl1) <=-refl
        | hq' : Q.upred_holds n (ucmra_core x) =>
            Q.upred_mono n n (ucmra_core a2) (ucmra_core x) hq
              (ucmra_core_monoN n a2 x incl2) <=-refl
      \in inP (ucmra_core x, ucmra_core x,
        equiv_dist {M}
          (M.equiv_sym (M.op (ucmra_core x) (ucmra_core x)) (ucmra_core x)
            (ucmra_core_dup x)) n,
        hp', hq')
  }

-- □P ⊢ □P ∗ □P
\lemma persistently_dup_ent {M : UCMRA} (P : ProperUPred M)
  : properUPred_ent (mkProperPersistently P)
      (mkProperSep (mkProperPersistently P) (mkProperPersistently P)) =>
  \lam n x hv hp =>
    inP (ucmra_core x, x,
      equiv_dist {M}
        (M.equiv_sym (M.op (ucmra_core x) x) x (ucmra_core_left_id x)) n,
      P.upred_mono n n (ucmra_core x) (ucmra_core (ucmra_core x)) hp
        (inclN_of_dist_unit n (ucmra_core x) (ucmra_core (ucmra_core x))
          (equiv_dist {M} (ucmra_core_idemp x) n))
        <=-refl,
      hp)

-- □(P → Q) ∗ P ⊢ Q
\lemma persistently_impl_elim_ent {M : UCMRA} (P Q : ProperUPred M)
  : properUPred_ent
      (mkProperSep (mkProperPersistently (mkProperImpl P Q)) P) Q =>
  \lam n x hv hs => \case hs \with {
    | inP (a1, a2, da, himpl, hp) =>
      \let
        | incl1 : inclN {M} {\new Op M.E { | op => M.op }} a1 n x =>
            inP (a2, da)
        | incl2 : inclN {M} {\new Op M.E { | op => M.op }} a2 n x =>
            inP (a1, M.ofe_dist_trans n x (M.op a1 a2) (M.op a2 a1) da
              (cmra_comm_dist n a1 a2))
        | inclc : inclN {M} {\new Op M.E { | op => M.op }}
            (ucmra_core a1) n x =>
            inclN_trans n (ucmra_core a1) a1 x
              (inP (a1,
                equiv_dist {M}
                  (M.equiv_sym (M.op (ucmra_core a1) a1) a1
                    (ucmra_core_left_id a1)) n))
              incl1
      \in himpl n <=-refl x inclc hv
            (P.upred_mono n n a2 x hp incl2 <=-refl)
  }

-- emp ⊢ P implies emp ⊢ □P.
\lemma persistently_intro_emp_ent {M : UCMRA} (P : ProperUPred M)
    (h : properUPred_ent mkProperEmp P)
  : properUPred_ent mkProperEmp (mkProperPersistently P) =>
  \lam n x hv _ =>
    h n (ucmra_core x) (ucmra_core_validN n x hv)
      (emp_holds_all n (ucmra_core x))

-- X ⊢ X ∗ R for any R provable from emp.
\lemma attach_valid_r_ent {M : UCMRA} (X R : ProperUPred M)
    (h : properUPred_ent mkProperEmp R)
  : properUPred_ent X (mkProperSep X R) =>
  properUPred_ent_trans X (mkProperSep X mkProperEmp) (mkProperSep X R)
    (add_emp_r_ent X)
    (sep_mono_r_ent X mkProperEmp R h)

\lemma later_persistently_of_emp {M : UCMRA} (R : ProperUPred M)
    (h : properUPred_ent mkProperEmp R)
  : properUPred_ent mkProperEmp
      (mkProperLater (mkProperPersistently R)) =>
  properUPred_ent_trans mkProperEmp
    (mkProperPersistently R)
    (mkProperLater (mkProperPersistently R))
    (persistently_intro_emp_ent R h)
    (proper_later_intro (mkProperPersistently R))

-- ▷(P -∗ X) ∗ ▷P ⊢ ▷X
\lemma later_wand_apply_ent {M : UCMRA} (P X : ProperUPred M)
  : properUPred_ent
      (mkProperSep (mkProperLater (mkProperWand P X)) (mkProperLater P))
      (mkProperLater X) =>
  properUPred_ent_trans
    (mkProperSep (mkProperLater (mkProperWand P X)) (mkProperLater P))
    (mkProperLater (mkProperSep (mkProperWand P X) P))
    (mkProperLater X)
    (proper_later_sep_2 (mkProperWand P X) P)
    (proper_later_mono (mkProperSep (mkProperWand P X) P) X
      (wand_elim_ent P X))

-- =================================================================================
-- §4  except_0_inv (Rocq: `◇ inv N P ⊢ inv N P`).  A direct model proof:
--     the ▷False disjunct is only inhabited at step index 0, where any
--     fancy update holds trivially (its basic update answers with the
--     except-0 left disjunct).
-- =================================================================================

\lemma fupd_holds_at_zero {S : gFunctors} (W : wsatGS S)
    (E1 E2 : coPset) (P : iProp S) (m : Nat) (hm : m <= 0) (b : iResUR S)
  : (mkProperFUpd W E1 E2 P).upred_holds m b =>
  \lam k k_le_m a2 hv_op hworld j j_le_k yf hv_yf =>
    \let hj : j <= 0 =>
        (NatSemiring.<=∘) j_le_k ((NatSemiring.<=∘) k_le_m hm)
    \in inP ((iResUR S).op b a2, hv_yf,
      \case \elim j, hj \with {
        | 0, _ => byLeft ()
        | suc j', hj' => absurd (hj' NatOrder.zero<suc)
      })

\lemma except_0_inv {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (P : iProp S)
  : properUPred_ent (mkProperExceptZero (inv W N P)) (inv W N P) =>
  \lam n x hv h => \case h \with {
    | byRight hinv => hinv
    | byLeft hz => \case \elim n, hz, hv \with {
      | 0, _, _ =>
          transport (\lam (Z : iProp S) => Z.upred_holds 0 x)
            (Paths.inv (inv_peval W N P))
            (\lam E m m_le0 b incl hvb hNE =>
              fupd_holds_at_zero W E (coPset_difference E (nclose N))
                (mkProperSep (mkProperLater P)
                  (mkProperWand (mkProperLater P)
                    (mkProperFUpd W (coPset_difference E (nclose N)) E
                      mkProperEmp)))
                m m_le0 b)
      | suc n', hz', _ => absurd hz'
    }
  }
