-- =================================================================================
-- A11 smoke tests: each lemma restates a public signature of the invariant
-- API and delegates to the implementation (same style as fupd_test /
-- namespaces_test).  Destination: src/lib/invariants_derived_test.ard.
-- =================================================================================

-- distance lemmas
\lemma test_inv_contractive {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (n : Nat) (P Q : iProp S)
    (h : \Pi (k : Nat) -> k NatOrder.< n -> upredDist k P Q)
  : upredDist n (inv W N P) (inv W N Q) => inv_contractive W N n P Q h

\lemma test_inv_ne {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (n : Nat) (P Q : iProp S) (h : upredDist n P Q)
  : upredDist n (inv W N P) (inv W N Q) => inv_ne W N n P Q h

\lemma test_inv_proper {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (P Q : iProp S) (h : upredEquiv P Q)
  : upredEquiv (inv W N P) (inv W N Q) => inv_proper W N P Q h

-- allocation (closed and open)
\lemma test_inv_alloc {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S)
  : properUPred_ent (mkProperLater P) (mkProperFUpd W E E (inv W N P)) =>
  inv_alloc W N E P

\lemma test_inv_alloc_open {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S)
    (hNE : coPSubset (nclose N) E)
  : properUPred_ent mkProperEmp
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (inv W N P)
          (mkProperWand (mkProperLater P)
            (mkProperFUpd W (coPset_difference E (nclose N)) E
              mkProperEmp)))) =>
  inv_alloc_open W N E P hNE

-- accessors
\lemma test_inv_acc {S : gFunctors} (W : wsatGS S)
    (E : coPset) (N : Namespace) (P : iProp S)
    (hNE : coPSubset (nclose N) E)
  : properUPred_ent (inv W N P)
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (mkProperLater P)
          (mkProperWand (mkProperLater P)
            (mkProperFUpd W (coPset_difference E (nclose N)) E
              mkProperEmp)))) =>
  inv_acc W E N P hNE

\lemma test_inv_acc_strong {S : gFunctors} (W : wsatGS S)
    (E : coPset) (N : Namespace) (P : iProp S)
    (hNE : coPSubset (nclose N) E)
  : properUPred_ent (inv W N P)
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (mkProperLater P)
          (mkProperForall coPset (\lam E' =>
            mkProperWand (mkProperLater P)
              (mkProperFUpd W E' (coPset_union (nclose N) E')
                mkProperEmp))))) =>
  inv_acc_strong W E N P hNE

\lemma test_inv_acc_timeless {S : gFunctors} (W : wsatGS S)
    (E : coPset) (N : Namespace) (P : iProp S)
    (hNE : coPSubset (nclose N) E) (hT : Timeless P)
  : properUPred_ent (inv W N P)
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep P
          (mkProperWand P
            (mkProperFUpd W (coPset_difference E (nclose N)) E
              mkProperEmp)))) =>
  inv_acc_timeless W E N P hNE hT

-- alteration
\lemma test_inv_alter {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (P Q : iProp S)
  : properUPred_ent
      (mkProperSep (inv W N P)
        (mkProperLater (mkProperPersistently
          (mkProperWand P (mkProperSep Q (mkProperWand Q P))))))
      (inv W N Q) =>
  inv_alter W N P Q

\lemma test_inv_iff {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (P Q : iProp S)
  : properUPred_ent
      (mkProperSep (inv W N P)
        (mkProperLater (mkProperPersistently
          (mkProperAnd (mkProperImpl P Q) (mkProperImpl Q P)))))
      (inv W N Q) =>
  inv_iff W N P Q

-- combination
\lemma test_inv_combine {S : gFunctors} (W : wsatGS S)
    (N1 N2 N : Namespace) (P Q : iProp S)
    (hdisj : ndisjoint N1 N2)
    (hsub : coPSubset (coPset_union (nclose N1) (nclose N2)) (nclose N))
  : properUPred_ent
      (mkProperSep (inv W N1 P) (inv W N2 Q))
      (inv W N (mkProperSep P Q)) =>
  inv_combine W N1 N2 N P Q hdisj hsub

\lemma test_inv_combine_dup_l {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (P Q : iProp S)
  : properUPred_ent
      (mkProperSep (mkProperPersistently (mkProperWand P (mkProperSep P P)))
        (mkProperSep (inv W N P) (inv W N Q)))
      (inv W N (mkProperSep P Q)) =>
  inv_combine_dup_l W N P Q

-- splitting
\lemma test_inv_split_l {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (P Q : iProp S)
  : properUPred_ent (inv W N (mkProperSep P Q)) (inv W N P) =>
  inv_split_l W N P Q

\lemma test_inv_split_r {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (P Q : iProp S)
  : properUPred_ent (inv W N (mkProperSep P Q)) (inv W N Q) =>
  inv_split_r W N P Q

\lemma test_inv_split {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (P Q : iProp S)
  : properUPred_ent (inv W N (mkProperSep P Q))
      (mkProperSep (inv W N P) (inv W N Q)) =>
  inv_split W N P Q

-- except-0
\lemma test_except_0_inv {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (P : iProp S)
  : properUPred_ent (mkProperExceptZero (inv W N P)) (inv W N P) =>
  except_0_inv W N P

-- own_inv layer (Rocq invariants.v: own_inv_alloc, own_inv_acc,
-- own_inv_alloc_open, own_inv_to_inv)
\lemma test_own_inv_alloc {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S)
  : properUPred_ent (mkProperLater P)
      (mkProperFUpd W E E (own_inv W N P)) =>
  own_inv_alloc W N E P

\lemma test_own_inv_acc {S : gFunctors} (W : wsatGS S)
    (E : coPset) (N : Namespace) (P : iProp S)
    (hNE : coPSubset (nclose N) E)
  : properUPred_ent (own_inv W N P)
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (mkProperLater P)
          (mkProperWand (mkProperLater P)
            (mkProperFUpd W (coPset_difference E (nclose N)) E
              mkProperEmp)))) =>
  own_inv_acc W E N P hNE

\lemma test_own_inv_alloc_open {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (E : coPset) (P : iProp S)
    (hNE : coPSubset (nclose N) E)
  : properUPred_ent mkProperEmp
      (mkProperFUpd W E (coPset_difference E (nclose N))
        (mkProperSep (own_inv W N P)
          (mkProperWand (mkProperLater P)
            (mkProperFUpd W (coPset_difference E (nclose N)) E
              mkProperEmp)))) =>
  own_inv_alloc_open W N E P hNE

\lemma test_own_inv_to_inv {S : gFunctors} (W : wsatGS S)
    (N : Namespace) (P : iProp S)
  : properUPred_ent (own_inv W N P) (inv W N P) =>
  own_inv_to_inv W N P

-- persistence (re-exported from the core for completeness)
\lemma test_inv_persistent {S : gFunctors} (W : wsatGS S) (N : Namespace)
    (P : iProp S)
  : properUPred_ent (inv W N P) (mkProperPersistently (inv W N P)) =>
  inv_persistent W N P

-- Timeless instances
\lemma test_timeless_pure {M : UCMRA} (phi : \Prop)
  : Timeless {M} (mkProperPure phi) => timeless_pure phi

\lemma test_timeless_sep {M : UCMRA} (P Q : ProperUPred M)
    (hP : Timeless P) (hQ : Timeless Q)
  : Timeless (mkProperSep P Q) => timeless_sep P Q hP hQ
