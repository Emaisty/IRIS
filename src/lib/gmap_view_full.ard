\import Logic
\import Paths
\import Set
\import Data.Maybe
\import Data.Bool
\import Arith.Nat
\import Arith.Rat
\import Order.LinearOrder
\import ofe
\import cmra
\import lib.pmap
\import lib.gmap_cmra
\import lib.gmap_updates
\import lib.prod_cmra
\import lib.frac
\import lib.dfrac_cmra
\import lib.agree_cmra
\import lib.option_cmra
\import lib.view_cmra

-- Full fractional gmap view: V is an arbitrary CMRA and every fragment
-- carries a discardable fraction.

\func gmap_view_fragR (K : \Set) (cnt : Countable K) (V : CMRA) : CMRA =>
  GmapCMRA K cnt (ProdCMRA DfracCMRA V)

\func gmap_view_fragUR (K : \Set) (cnt : Countable K) (V : CMRA) : UCMRA =>
  GmapUCMRA K cnt (ProdCMRA DfracCMRA V)

\func erase_dfrac_lift {V : CMRA} (p : \Sigma \Set (\Sigma Dfrac V.E)) : Maybe V.E =>
  just p.2.2
  \where {
    \func at {K : \Set} {V : CMRA} (p : \Sigma K (\Sigma Dfrac V.E)) : Maybe V.E =>
      just p.2.2
  }

\func erase_dfrac_map {K : \Set} {cnt : Countable K} {V : CMRA}
    (m : Gmap K cnt (\Sigma Dfrac V.E)) : Gmap K cnt V.E =>
  gmap_map_support m erase_dfrac_lift.at

\func gmap_view_matches {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (fm : Gmap K cnt (\Sigma Dfrac V.E)) (m : Gmap K cnt V.E) : \Prop =>
  \Pi (k : K) (dv : \Sigma Dfrac V.E) -> glookup fm k = just dv ->
    TruncP (\Sigma (mv : V.E) (glookup m k = just mv) (V.dist n dv.2 mv))

\func glookup_dist_just {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (m m' : Gmap K cnt V.E) (k : K) (v : V.E)
    (hm : glookup m k = just v) (d : (GmapOFE K cnt V).dist n m m')
  : \Sigma (v' : V.E) (glookup m' k = just v') (V.dist n v v') =>
  \case glookup m' k \as o, idp : glookup m' k = o
    \return \Sigma (v' : V.E) (glookup m' k = just v') (V.dist n v v')
  \with {
    | nothing, hm' =>
        \case transport (\lam q => (OptionOFE V).dist n (just v) q)
          hm' (transport (\lam q => (OptionOFE V).dist n q (glookup m' k)) hm (d k)) \with {}
    | just v', hm' =>
        (v', hm', transport2 (\lam u w => (OptionOFE V).dist n u w)
          hm hm' (d k))
  }

-- Equivalent presentation of Iris's per-key relation: choose fractions only
-- for the keys covered by the fragment, require that witness map to be valid,
-- and match its values against authoritative lookups.
\func gmap_view_rel_holds {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (m : Gmap K cnt V.E) (f : Gmap K cnt (\Sigma Dfrac V.E)) : \Prop =>
  TruncP (\Sigma (fm : Gmap K cnt (\Sigma Dfrac V.E))
    (gmap_view_matches n fm m)
    ((gmap_view_fragUR K cnt V).validN n fm)
    (inclN {gmap_view_fragUR K cnt V}
      {\new Op _ { | op => (gmap_view_fragUR K cnt V).op }} f n fm))

\func gmap_view_rel (K : \Set) (cnt : Countable K) (V : CMRA)
  : ViewRel (GmapOFE K cnt V) (gmap_view_fragUR K cnt V) \cowith
  | view_rel_holds => gmap_view_rel_holds
  | view_rel_mono => \lam n m a a' b b' h ha hb le => \case h \with {
      | inP (fm, hem, hvm, hbf) =>
        inP (fm,
          (\lam k dv hfm => \case hem k dv hfm \with {
            | inP old =>
              \let new => glookup_dist_just m a a' k old.1 old.2 ha
              \in inP (new.1, new.2,
                V.ofe_dist_trans m dv.2 old.1 new.1
                  (V.ofe_dist_le n m dv.2 old.1 old.3 le) new.3)
          }),
          (gmap_view_fragUR K cnt V).cmra_validN_le n m fm hvm le,
          inclN_trans m b' b fm hb
            (inclN_le {gmap_view_fragUR K cnt V}
              {\new Op _ { | op => (gmap_view_fragUR K cnt V).op }}
              b fm n m hbf le))
    }
  | view_rel_validN => \lam n m f h => \case h \with {
      | inP (fm, _, hvm, hfm) => cmra_validN_includedN n f fm hvm hfm
    }
  | view_rel_unit => \lam n =>
      (gempty, inP (gempty,
        (\lam k dv h => \case inv h *> glookup_empty k \with {}),
        (gmap_view_fragUR K cnt V).ucmra_unit_valid,
        inclN_refl_ucmra n gempty))

\func gmap_viewR (K : \Set) (cnt : Countable K) (V : CMRA) : CMRA =>
  ViewCMRA (gmap_view_rel K cnt V)

\func gmap_viewUR (K : \Set) (cnt : Countable K) (V : CMRA) : UCMRA =>
  ViewUCMRA (gmap_view_rel K cnt V)

\func gmap_view_auth {K : \Set} {cnt : Countable K} {V : CMRA}
    (dq : Dfrac) (m : Gmap K cnt V.E) : (gmap_viewR K cnt V).E =>
  view_auth dq m

\func gmap_view_frag {K : \Set} {cnt : Countable K} {V : CMRA}
    (k : K) (dq : Dfrac) (v : V.E) : (gmap_viewR K cnt V).E =>
  view_frag (gsingleton k (dq, v))

\lemma gmap_view_frag_core_id {K : \Set} {cnt : Countable K} {V : CMRA}
    (k : K) (dq : Dfrac) (v : V.E)
    (hdq : CoreId {DfracCMRA} dq) (hv : CoreId {V} v)
  : CoreId {gmap_viewR K cnt V} (gmap_view_frag k dq v) =>
  view_frag_core_id (gmap_view_rel K cnt V) (gsingleton k (dq, v))
    (gmap_singleton_core_id k (dq, v) (prod_core_id (dq, v) hdq hv))

\lemma gmap_view_auth_dfrac_op {K : \Set} {cnt : Countable K} {V : CMRA}
    (dp dq : Dfrac) (m : Gmap K cnt V.E)
  : (gmap_viewR K cnt V).equiv
      (gmap_view_auth (dfrac_op dp dq) m)
      ((gmap_viewR K cnt V).op
        (gmap_view_auth dp m) (gmap_view_auth dq m)) =>
  ((idp, (AgreeOFE (GmapOFE K cnt V)).equiv_sym
      (agree_op (to_agree m) (to_agree m)) (to_agree m)
      (agree_idemp (to_agree m))),
   (gmap_view_fragUR K cnt V).equiv_sym
     ((gmap_view_fragUR K cnt V).op
       (gmap_view_fragUR K cnt V).unit
       (gmap_view_fragUR K cnt V).unit)
     (gmap_view_fragUR K cnt V).unit
     ((gmap_view_fragUR K cnt V).ucmra_unit_left_id
       (gmap_view_fragUR K cnt V).unit))

\lemma gmap_view_frag_op {K : \Set} {cnt : Countable K} {V : CMRA}
    (k : K) (dq1 dq2 : Dfrac) (v1 v2 : V.E)
  : (gmap_viewR K cnt V).equiv
      (gmap_view_frag k (dfrac_op dq1 dq2) (V.op v1 v2))
      ((gmap_viewR K cnt V).op
        (gmap_view_frag k dq1 v1) (gmap_view_frag k dq2 v2)) =>
  ((), gmap_singleton_op k (dq1, v1) (dq2, v2))

\func erase_dfrac_matches {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (fm : Gmap K cnt (\Sigma Dfrac V.E))
  : gmap_view_matches n fm (erase_dfrac_map fm) =>
  \lam k dv h => inP (dv.2,
    glookup_map_support_present fm erase_dfrac_lift.at k dv h,
    V.ofe_dist_refl n dv.2)

\lemma gmap_view_auth_validN {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (dq : Dfrac) (m : Gmap K cnt V.E) (hdq : dfrac_valid dq)
  : validN {gmap_viewR K cnt V} n (gmap_view_auth dq m) =>
  (hdq, inP (m,
    (AgreeOFE (GmapOFE K cnt V)).ofe_dist_refl n (to_agree m),
    inP (gempty,
      (\lam k dv h => \case inv h *> glookup_empty k \with {}),
      (gmap_view_fragUR K cnt V).ucmra_unit_valid,
      inclN_refl_ucmra n gempty)))

\lemma gmap_view_auth_validN_1 {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (dq : Dfrac) (m : Gmap K cnt V.E)
    (h : validN {gmap_viewR K cnt V} n (gmap_view_auth dq m))
  : dfrac_valid dq => h.1

\lemma gmap_view_auth_op_agreeN {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (dp dq : Dfrac) (m1 m2 : Gmap K cnt V.E)
    (h : validN {gmap_viewR K cnt V} n
      ((gmap_viewR K cnt V).op
        (gmap_view_auth dp m1) (gmap_view_auth dq m2)))
  : (GmapOFE K cnt V).dist n m1 m2 =>
  \case h.2 \with {
    | inP (m, dag, _) =>
      to_agree_op_inv n m1 m2
        ((AgreeCMRA (GmapOFE K cnt V)).cmra_validN_ne n
          (to_agree m)
          (agree_op (to_agree m1) (to_agree m2))
          ((AgreeOFE (GmapOFE K cnt V)).ofe_dist_sym n
            (agree_op (to_agree m1) (to_agree m2)) (to_agree m) dag)
          (view_to_agree_validN n m))
  }

\lemma gmap_view_auth_op_exclusiveN {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (m1 m2 : Gmap K cnt V.E)
    (h : validN {gmap_viewR K cnt V} n
      ((gmap_viewR K cnt V).op
        (gmap_view_auth (DfracOwn qp_one) m1)
        (gmap_view_auth (DfracOwn qp_one) m2)))
  : Empty => dfrac_full_exclusive (DfracOwn qp_one) h.1

\lemma gmap_view_frag_map_validN {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (f : Gmap K cnt (\Sigma Dfrac V.E))
    (hf : (gmap_view_fragUR K cnt V).validN n f)
  : validN {gmap_viewR K cnt V} n (view_frag f) =>
  inP (erase_dfrac_map f, inP (f,
    erase_dfrac_matches n f, hf, inclN_refl_ucmra n f))

\lemma gmap_view_frag_validN {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (k : K) (dq : Dfrac) (v : V.E)
    (hdq : dfrac_valid dq) (hv : V.validN n v)
  : validN {gmap_viewR K cnt V} n (gmap_view_frag k dq v) =>
  gmap_view_frag_map_validN n (gsingleton k (dq, v))
    (gmap_singleton_validN_2 k n (dq, v) (hdq, hv))

\lemma gmap_view_frag_validN_1 {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (k : K) (dq : Dfrac) (v : V.E)
    (h : validN {gmap_viewR K cnt V} n (gmap_view_frag k dq v))
  : \Sigma (dfrac_valid dq) (V.validN n v) =>
  \scase h \with {
    | inP (m, hr) => gmap_singleton_validN_1 k n (dq, v)
        ((gmap_view_rel K cnt V).view_rel_validN n m
          (gsingleton k (dq, v)) hr)
  }

\func gmap_view_included_lookup_present {K : \Set} {cnt : Countable K}
    {A : CMRA} (n : Nat) (f fm : Gmap K cnt A.E) (k : K) (x : A.E)
    (hlookup : glookup f k = just x)
    (hi : inclN {GmapUCMRA K cnt A}
      {\new Op _ { | op => (GmapUCMRA K cnt A).op }} f n fm)
  : TruncP (\Sigma (y : A.E) (glookup fm k = just y)
      (inclN {OptionUCMRA A}
        {\new Op (Maybe A.E) { | op => (OptionUCMRA A).op }}
        (just x) n (just y))) =>
  \case hi \with {
    | inP (z, hd) =>
      \let rhs : glookup ((GmapUCMRA K cnt A).op f z) k =
            option_op {A} (just x) (glookup z k) =>
        glookup_op f z k
          *> pmap (\lam o => option_op {A} o (glookup z k)) hlookup
      \in \case glookup fm k \as o, idp : glookup fm k = o
        \return TruncP (\Sigma (y : A.E) (glookup fm k = just y)
          (inclN {OptionUCMRA A}
            {\new Op (Maybe A.E) { | op => (OptionUCMRA A).op }}
            (just x) n (just y)))
      \with {
        | just y, hm => inP (y, hm, inP (glookup z k,
            transport2 (\lam u w => (OptionOFE A).dist n u w)
              hm rhs (hd k)))
        | nothing, hm =>
          \let
            | dnone : (OptionOFE A).dist n nothing
                (option_op {A} (just x) (glookup z k)) =>
                transport2 (\lam u w => (OptionOFE A).dist n u w)
                  hm rhs (hd k)
            | enone : option_op {A} (just x) (glookup z k) = nothing =>
                option_dist_nothing_eq n
                  (option_op {A} (just x) (glookup z k)) dnone
            | parts => option_op_eq_nothing_inv (just x) (glookup z k) enone
          \in \case parts.1 \with {}
      }
  }

\func gmap_view_rel_lookup {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (m : Gmap K cnt V.E)
    (f : Gmap K cnt (\Sigma Dfrac V.E))
    (hrel : gmap_view_rel_holds n m f)
    (k : K) (dv : \Sigma Dfrac V.E) (hf : glookup f k = just dv)
  : TruncP (\Sigma (stored : \Sigma Dfrac V.E) (mv : V.E)
      (glookup m k = just mv)
      ((ProdCMRA DfracCMRA V).validN n stored)
      (inclN {OptionUCMRA (ProdCMRA DfracCMRA V)}
        {\new Op (Maybe (\Sigma Dfrac V.E)) {
          | op => (OptionUCMRA (ProdCMRA DfracCMRA V)).op }}
        (just dv) n (just stored))
      (V.dist n stored.2 mv)) =>
  \scase hrel \with {
    | inP (fm, matches, hfm, hi) =>
      \scase gmap_view_included_lookup_present n f fm k dv hf hi \with {
        | inP (stored, hstored, hinc) => \scase matches k stored hstored \with {
            | inP (mv, hm, d) => inP (stored, mv, hm,
                transport (option_validN {ProdCMRA DfracCMRA V} n)
                  hstored (hfm k), hinc, d)
          }
      }
  }

\lemma gmap_view_total_lookup_dist {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (k : K) (dq : Dfrac) (v : V.E)
    (bf z : Gmap K cnt (\Sigma Dfrac V.E))
  : (OptionOFE (ProdCMRA DfracCMRA V)).dist n
      (glookup ((gmap_view_fragUR K cnt V).op
        ((gmap_view_fragUR K cnt V).op (gsingleton k (dq, v)) bf) z) k)
      (just (cmra_opM {ProdCMRA DfracCMRA V} (dq, v)
        (option_op {ProdCMRA DfracCMRA V} (glookup bf k) (glookup z k)))) =>
  \let
    | totalEq : glookup ((gmap_view_fragUR K cnt V).op
          ((gmap_view_fragUR K cnt V).op (gsingleton k (dq, v)) bf) z) k
        = option_op {ProdCMRA DfracCMRA V}
            (option_op {ProdCMRA DfracCMRA V}
              (just (dq, v)) (glookup bf k)) (glookup z k) =>
        glookup_op ((gmap_view_fragUR K cnt V).op
            (gsingleton k (dq, v)) bf) z k
          *> pmap (\lam o => option_op {ProdCMRA DfracCMRA V} o (glookup z k))
              (glookup_op (gsingleton k (dq, v)) bf k
                *> pmap (\lam o => option_op {ProdCMRA DfracCMRA V}
                    o (glookup bf k)) (glookup_singleton_eq k (dq, v)))
    | targetEq : option_op {ProdCMRA DfracCMRA V} (just (dq, v))
          (option_op {ProdCMRA DfracCMRA V} (glookup bf k) (glookup z k))
        = just (cmra_opM {ProdCMRA DfracCMRA V} (dq, v)
          (option_op {ProdCMRA DfracCMRA V} (glookup bf k) (glookup z k))) =>
        option_op_just_l (dq, v)
          (option_op {ProdCMRA DfracCMRA V} (glookup bf k) (glookup z k))
    | assocDist : (OptionOFE (ProdCMRA DfracCMRA V)).dist n
          (option_op {ProdCMRA DfracCMRA V}
            (option_op {ProdCMRA DfracCMRA V} (just (dq, v)) (glookup bf k))
            (glookup z k))
          (option_op {ProdCMRA DfracCMRA V} (just (dq, v))
            (option_op {ProdCMRA DfracCMRA V} (glookup bf k) (glookup z k))) =>
        (((OptionOFE (ProdCMRA DfracCMRA V)).ofe_equiv_dist _ _).1
          ((OptionOFE (ProdCMRA DfracCMRA V)).equiv_sym _ _
            (option_op_assoc (just (dq, v)) (glookup bf k) (glookup z k)))) n
  \in transport2
      (\lam u w => (OptionOFE (ProdCMRA DfracCMRA V)).dist n u w)
      (inv totalEq) targetEq assocDist

\func gmap_view_source_stored {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (fm bf z : Gmap K cnt (\Sigma Dfrac V.E))
    (k : K) (dq : Dfrac) (v : V.E)
    (hd : (GmapOFE K cnt (ProdCMRA DfracCMRA V)).dist n fm
      ((gmap_view_fragUR K cnt V).op
        ((gmap_view_fragUR K cnt V).op (gsingleton k (dq, v)) bf) z))
  : TruncP (\Sigma (stored : \Sigma Dfrac V.E)
      (glookup fm k = just stored)
      ((ProdCMRA DfracCMRA V).dist n stored
        (cmra_opM {ProdCMRA DfracCMRA V} (dq, v)
          (option_op {ProdCMRA DfracCMRA V} (glookup bf k) (glookup z k))))) =>
  \let allDist => (OptionOFE (ProdCMRA DfracCMRA V)).ofe_dist_trans n
      (glookup fm k)
      (glookup ((gmap_view_fragUR K cnt V).op
        ((gmap_view_fragUR K cnt V).op (gsingleton k (dq, v)) bf) z) k)
      (just (cmra_opM {ProdCMRA DfracCMRA V} (dq, v)
        (option_op {ProdCMRA DfracCMRA V} (glookup bf k) (glookup z k))))
      (hd k) (gmap_view_total_lookup_dist n k dq v bf z)
  \in \case glookup fm k \as om, idp : glookup fm k = om
    \return TruncP (\Sigma (stored : \Sigma Dfrac V.E)
      (glookup fm k = just stored)
      ((ProdCMRA DfracCMRA V).dist n stored
        (cmra_opM {ProdCMRA DfracCMRA V} (dq, v)
          (option_op {ProdCMRA DfracCMRA V} (glookup bf k) (glookup z k)))))
  \with {
    | nothing, hm => \case transport
        (\lam o => (OptionOFE (ProdCMRA DfracCMRA V)).dist n o
          (just (cmra_opM {ProdCMRA DfracCMRA V} (dq, v)
            (option_op {ProdCMRA DfracCMRA V} (glookup bf k) (glookup z k)))))
        hm allDist \with {}
    | just stored, hm => inP (stored, hm,
        transport
          (\lam o => (OptionOFE (ProdCMRA DfracCMRA V)).dist n o
            (just (cmra_opM {ProdCMRA DfracCMRA V} (dq, v)
              (option_op {ProdCMRA DfracCMRA V} (glookup bf k) (glookup z k)))))
          hm allDist)
  }

\lemma gmap_view_both_dfrac_validN {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (dp : Dfrac) (m : Gmap K cnt V.E)
    (k : K) (dq : Dfrac) (v : V.E)
    (h : validN {gmap_viewR K cnt V} n
      ((gmap_viewR K cnt V).op
        (gmap_view_auth dp m) (gmap_view_frag k dq v)))
  : \Sigma (dfrac_valid dp)
      (TruncP (\Sigma (stored : \Sigma Dfrac V.E) (mv : V.E)
        (glookup m k = just mv)
        ((ProdCMRA DfracCMRA V).validN n stored)
        (inclN {OptionUCMRA (ProdCMRA DfracCMRA V)}
          {\new Op (Maybe (\Sigma Dfrac V.E)) {
            | op => (OptionUCMRA (ProdCMRA DfracCMRA V)).op }}
          (just (dq, v)) n (just stored))
        (V.dist n stored.2 mv))) =>
  (h.1, \case h.2 \with {
    | inP (a, dag, hrel) =>
      \let
        | dm_a : (GmapOFE K cnt V).dist n m a =>
            view_agree_dist_extract n m (to_agree a) dag
        | hlookup : glookup
              ((gmap_view_fragUR K cnt V).op
                (gmap_view_fragUR K cnt V).unit
                (gsingleton k (dq, v))) k = just (dq, v) =>
            glookup_op (gmap_view_fragUR K cnt V).unit
              (gsingleton k (dq, v)) k
              *> pmap2 (option_op {ProdCMRA DfracCMRA V})
                  (glookup_empty k) (glookup_singleton_eq k (dq, v))
      \in \scase gmap_view_rel_lookup n a
          ((gmap_view_fragUR K cnt V).op
            (gmap_view_fragUR K cnt V).unit (gsingleton k (dq, v)))
          hrel k (dq, v) hlookup \with {
        | inP (stored, mv, ha, hs, hinc, d) =>
          \case glookup_dist_just n a m k mv ha
              ((GmapOFE K cnt V).ofe_dist_sym n m a dm_a) \with {
            | (mv0, hm0, dm) => inP (stored, mv0, hm0, hs, hinc,
                V.ofe_dist_trans n stored.2 mv mv0 d dm)
          }
      }
  })

\func gmap_view_full_option_included_exact {V : CMRA} (n : Nat)
    (stored : \Sigma Dfrac V.E) (v : V.E)
    (hvalid : (ProdCMRA DfracCMRA V).validN n stored)
    (hinc : inclN {OptionUCMRA (ProdCMRA DfracCMRA V)}
      {\new Op (Maybe (\Sigma Dfrac V.E)) {
        | op => (OptionUCMRA (ProdCMRA DfracCMRA V)).op }}
      (just (DfracOwn qp_one, v)) n (just stored))
  : (ProdCMRA DfracCMRA V).dist n stored (DfracOwn qp_one, v) =>
  \case hinc \with {
    | inP (nothing, d) => d
    | inP (just z, d) =>
      \let combinedValid : (ProdCMRA DfracCMRA V).validN n
          ((ProdCMRA DfracCMRA V).op (DfracOwn qp_one, v) z) =>
        (ProdCMRA DfracCMRA V).cmra_validN_ne n stored
          ((ProdCMRA DfracCMRA V).op (DfracOwn qp_one, v) z) d hvalid
      \in \case dfrac_full_exclusive z.1 combinedValid.1 \with {}
  }

\func gmap_view_agree_option_included_dist {O : OFE} (n : Nat)
    (stored : \Sigma Dfrac (AgreeElem O)) (dq : Dfrac) (v : AgreeElem O)
    (hvalid : (ProdCMRA DfracCMRA (AgreeCMRA O)).validN n stored)
    (hinc : inclN {OptionUCMRA (ProdCMRA DfracCMRA (AgreeCMRA O))}
      {\new Op (Maybe (\Sigma Dfrac (AgreeElem O))) {
        | op => (OptionUCMRA (ProdCMRA DfracCMRA (AgreeCMRA O))).op }}
      (just (dq, v)) n (just stored))
  : (AgreeOFE O).dist n stored.2 v =>
  \case hinc \with {
    | inP (nothing, d) => d.2
    | inP (just z, d) =>
      \let
        | combined => (ProdCMRA DfracCMRA (AgreeCMRA O)).op (dq, v) z
        | combinedValid : (ProdCMRA DfracCMRA (AgreeCMRA O)).validN n combined =>
            (ProdCMRA DfracCMRA (AgreeCMRA O)).cmra_validN_ne n
              stored combined d hvalid
        | opToV : (AgreeOFE O).dist n (agree_op v z.2) v =>
            agree_op_dist_left_valid n v z.2 combinedValid.2
      \in (AgreeOFE O).ofe_dist_trans n stored.2 (agree_op v z.2) v d.2 opToV
  }

-- The form used by invariant ghost state: a discarded Agree fragment must
-- agree with the authoritative value at its key.  Keeping the inclusion
-- bookkeeping abstract in `O` avoids re-elaborating it at recursive iProps.
\lemma gmap_view_both_discarded_agree_validN
    {K : \Set} {cnt : Countable K} {O : OFE}
    (n : Nat) (dp : Dfrac) (m : Gmap K cnt (AgreeElem O))
    (k : K) (v : AgreeElem O)
    (h : validN {gmap_viewR K cnt (AgreeCMRA O)} n
      ((gmap_viewR K cnt (AgreeCMRA O)).op
        (gmap_view_auth dp m)
        (gmap_view_frag k DfracDiscarded v)))
  : \Sigma (dfrac_valid dp)
      (TruncP (\Sigma (mv : AgreeElem O) (glookup m k = just mv)
        ((AgreeOFE O).dist n v mv))) =>
  \let raw => gmap_view_both_dfrac_validN {K} {cnt} {AgreeCMRA O}
      n dp m k DfracDiscarded v h
  \in (raw.1, \case raw.2 \with {
    | inP (stored, mv, hlook, hstored, hinc, hstoredAuth) =>
      \let hstoredFrag => gmap_view_agree_option_included_dist
          n stored DfracDiscarded v hstored hinc
      \in inP (mv, hlook,
        (AgreeOFE O).ofe_dist_trans n v stored.2 mv
          ((AgreeOFE O).ofe_dist_sym n stored.2 v hstoredFrag)
          hstoredAuth)
  })

\lemma agree_dist_eq_to_agree_extract {O : OFE} (n : Nat)
    (x : O.E) (v : AgreeElem O) (y : O.E)
    (h : (AgreeOFE O).dist n (to_agree x) v)
    (e : v = to_agree y)
  : O.dist n x y =>
  view_agree_dist_extract n x (to_agree y)
    (transport (\lam z => (AgreeOFE O).dist n (to_agree x) z) e h)

\func gmap_to_agree_map {K X : \Set} {cnt : Countable K} {O : OFE}
    (m : Gmap K cnt X) (f : X -> O.E)
  : Gmap K cnt (AgreeElem O) =>
  gmap_map_support m (\lam p => just (to_agree (f p.2)))

\func gmap_to_agree_map_ginsert {K X : \Set} {cnt : Countable K} {O : OFE}
    (m : Gmap K cnt X) (f : X -> O.E) (k : K) (x : X)
  : gmap_to_agree_map (ginsert k x m) f =
      ginsert k (to_agree (f x)) (gmap_to_agree_map m f) =>
  gmap_eq (gmap_to_agree_map (ginsert k x m) f)
    (ginsert k (to_agree (f x)) (gmap_to_agree_map m f)) (\lam k' =>
      \case EqDecision.decideEq {cnt} k' k \with {
        | yes p =>
          \let
            | lhs_eq : glookup (ginsert k x m) k' = just x =>
                transport (\lam j => glookup (ginsert k x m) j = just x)
                  (inv p) (glookup_insert_eq k x m)
            | lhs : glookup (gmap_to_agree_map (ginsert k x m) f) k' =
                just (to_agree (f x)) =>
                glookup_map_support_present (ginsert k x m)
                  (\lam q => just (to_agree (f q.2))) k' x lhs_eq
            | rhs : glookup
                (ginsert k (to_agree (f x)) (gmap_to_agree_map m f)) k' =
                just (to_agree (f x)) =>
                transport (\lam j => glookup
                  (ginsert k (to_agree (f x)) (gmap_to_agree_map m f)) j =
                  just (to_agree (f x))) (inv p)
                  (glookup_insert_eq k (to_agree (f x))
                    (gmap_to_agree_map m f))
          \in lhs *> inv rhs
        | no np =>
          \let
            | ne : Not (k = k') => \lam q => np (inv q)
            | lhs_ne : glookup (ginsert k x m) k' = glookup m k' =>
                glookup_insert_ne k k' x m ne
            | rhs_ne : glookup
                (ginsert k (to_agree (f x)) (gmap_to_agree_map m f)) k' =
                glookup (gmap_to_agree_map m f) k' =>
                glookup_insert_ne k k' (to_agree (f x))
                  (gmap_to_agree_map m f) ne
          \in \case glookup m k' \as om, idp : glookup m k' = om \with {
            | just y, hm =>
              \let
                | lhs : glookup (gmap_to_agree_map (ginsert k x m) f) k' =
                    just (to_agree (f y)) =>
                    glookup_map_support_present (ginsert k x m)
                      (\lam q => just (to_agree (f q.2))) k' y (lhs_ne *> hm)
                | rhs : glookup (gmap_to_agree_map m f) k' =
                    just (to_agree (f y)) =>
                    glookup_map_support_present m
                      (\lam q => just (to_agree (f q.2))) k' y hm
              \in lhs *> inv (rhs_ne *> rhs)
            | nothing, hm =>
              \let
                | lhs : glookup (gmap_to_agree_map (ginsert k x m) f) k' = nothing =>
                    glookup_map_support_absent (ginsert k x m)
                      (\lam q => just (to_agree (f q.2))) k' (lhs_ne *> hm)
                | rhs : glookup (gmap_to_agree_map m f) k' = nothing =>
                    glookup_map_support_absent m
                      (\lam q => just (to_agree (f q.2))) k' hm
              \in lhs *> inv (rhs_ne *> rhs)
          }
      })

\func gmap_to_agree_lookup_just {K X : \Set} {cnt : Countable K} {O : OFE}
    (m : Gmap K cnt X) (f : X -> O.E) (k : K) (v : AgreeElem O)
    (h : glookup (gmap_to_agree_map m f) k = just v)
  : \Sigma (x : X) (glookup m k = just x) (v = to_agree (f x)) =>
  \case glookup m k \as om, idp : glookup m k = om
    \return \Sigma (x : X) (glookup m k = just x) (v = to_agree (f x))
  \with {
    | just x, hm =>
      \let
        | mapped : glookup (gmap_to_agree_map m f) k =
              just (to_agree (f x)) =>
            glookup_map_support_present m
              (\lam p => just (to_agree (f p.2))) k x hm
        | eq : just v = just (to_agree (f x)) => inv h *> mapped
      \in (x, hm, pmap (\lam o => \case o \with {
        | just y => y
        | nothing => to_agree (f x)
      }) eq)
    | nothing, hm =>
      \let
        | mapped : glookup (gmap_to_agree_map m f) k = nothing =>
            glookup_map_support_absent m
              (\lam p => just (to_agree (f p.2))) k hm
        | bad : true = false =>
            pmap (\lam (o : Maybe (AgreeElem O)) => \case o \with {
              | just _ => true
              | nothing => false
            }) (inv h *> mapped)
      \in \case bad \with {}
  }

\lemma gmap_view_both_discarded_agree_map_validN
    {K X : \Set} {cnt : Countable K} {O : OFE}
    (n : Nat) (dp : Dfrac) (m : Gmap K cnt X) (f : X -> O.E)
    (k : K) (x : O.E)
    (h : validN {gmap_viewR K cnt (AgreeCMRA O)} n
      ((gmap_viewR K cnt (AgreeCMRA O)).op
        (gmap_view_auth dp (gmap_to_agree_map m f))
        (gmap_view_frag k DfracDiscarded (to_agree x))))
  : \Sigma (dfrac_valid dp)
      (TruncP (\Sigma (y : X) (glookup m k = just y)
        (O.dist n x (f y)))) =>
  \let raw => gmap_view_both_discarded_agree_validN
      n dp (gmap_to_agree_map m f) k (to_agree x) h
  \in (raw.1, \case raw.2 \with {
    | inP (v, hlookup, hdist) =>
      \let
        | (y, hy, ev) => gmap_to_agree_lookup_just m f k v hlookup
        | dxy => agree_dist_eq_to_agree_extract n x v (f y) hdist ev
      \in inP (y, hy, dxy)
  })

\lemma gmap_view_both_validN {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (dp : Dfrac) (m : Gmap K cnt V.E)
    (k : K) (v : V.E)
    (h : validN {gmap_viewR K cnt V} n
      ((gmap_viewR K cnt V).op
        (gmap_view_auth dp m)
        (gmap_view_frag k (DfracOwn qp_one) v)))
  : \Sigma (dfrac_valid dp) (V.validN n v)
      (TruncP (\Sigma (mv : V.E) (glookup m k = just mv) (V.dist n v mv))) =>
  \let raw => gmap_view_both_dfrac_validN n dp m k
      (DfracOwn qp_one) v h
  \in \scase raw.2 \with {
    | inP (stored, mv, hm, hs, hinc, dsm) =>
      \let
        | exact => gmap_view_full_option_included_exact n stored v hs hinc
        | hv : V.validN n v => V.cmra_validN_ne n stored.2 v exact.2 hs.2
        | dvm : V.dist n v mv => V.ofe_dist_trans n v stored.2 mv
            (V.ofe_dist_sym n stored.2 v exact.2) dsm
      \in (raw.1, hv, inP (mv, hm, dvm))
  }

\func gmap_view_match_fresh {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (fm : Gmap K cnt (\Sigma Dfrac V.E)) (m : Gmap K cnt V.E)
    (matches : gmap_view_matches n fm m) (k : K)
    (fresh : glookup m k = nothing) : glookup fm k = nothing =>
  \case glookup fm k \as o, idp : glookup fm k = o
    \return glookup fm k = nothing
  \with {
    | nothing, hm => hm
    | just dv, hm => \case matches k dv hm \with {
        | inP (mv, hmv, _) => \case inv hmv *> fresh \with {}
      }
  }

\lemma gmap_view_lookup_delete_eq {K : \Set} {cnt : Countable K} {A : \Set}
    (k : K) (m : Gmap K cnt A) : glookup (gdelete k m) k = nothing =>
  glookup_partial_alter_eq (\lam _ => nothing) k m

\lemma gmap_view_lookup_delete_ne {K : \Set} {cnt : Countable K} {A : \Set}
    (k j : K) (m : Gmap K cnt A) (ne : Not (k = j))
  : glookup (gdelete k m) j = glookup m j =>
  glookup_partial_alter_ne (\lam _ => nothing) k j m ne

\func gmap_view_delete_validN {K : \Set} {cnt : Countable K} {A : CMRA}
    (n : Nat) (k : K) (m : Gmap K cnt A.E)
    (h : (GmapUCMRA K cnt A).validN n m)
  : (GmapUCMRA K cnt A).validN n (gdelete k m) =>
  \lam j => \case EqDecision.decideEq {cnt} j k \with {
    | yes e => transport (option_validN {A} n)
        (inv (transport (\lam z => glookup (gdelete k m) z = nothing)
          (inv e) (gmap_view_lookup_delete_eq k m))) ()
    | no ne => transport (option_validN {A} n)
        (inv (gmap_view_lookup_delete_ne k j m (\lam q => ne (inv q)))) (h j)
  }

\func gmap_view_full_frame_absent {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (fm bf : Gmap K cnt (\Sigma Dfrac V.E)) (k : K) (v : V.E)
    (hfm : (gmap_view_fragUR K cnt V).validN n fm)
    (hi : inclN {gmap_view_fragUR K cnt V}
      {\new Op _ { | op => (gmap_view_fragUR K cnt V).op }}
      ((gmap_view_fragUR K cnt V).op
        (gsingleton k (DfracOwn qp_one, v)) bf) n fm)
  : glookup bf k = nothing =>
  \case glookup bf k \as o, idp : glookup bf k = o
    \return glookup bf k = nothing
  \with {
    | nothing, hbf => hbf
    | just dv, hbf =>
      \let
        | hvCombined : (gmap_view_fragUR K cnt V).validN n
            ((gmap_view_fragUR K cnt V).op
              (gsingleton k (DfracOwn qp_one, v)) bf) =>
            cmra_validN_includedN n
              ((gmap_view_fragUR K cnt V).op
                (gsingleton k (DfracOwn qp_one, v)) bf) fm hfm hi
        | atK : option_validN {ProdCMRA DfracCMRA V} n
            (just ((ProdCMRA DfracCMRA V).op
              (DfracOwn qp_one, v) dv)) =>
            transport (option_validN {ProdCMRA DfracCMRA V} n)
              (glookup_op (gsingleton k (DfracOwn qp_one, v)) bf k
                *> pmap2 (option_op {ProdCMRA DfracCMRA V})
                    (glookup_singleton_eq k (DfracOwn qp_one, v)) hbf)
              (hvCombined k)
      \in \case dfrac_full_exclusive dv.1 atK.1 \with {}
  }

\func gmap_view_full_included_exact {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (fm bf : Gmap K cnt (\Sigma Dfrac V.E)) (k : K) (v : V.E)
    (hfm : (gmap_view_fragUR K cnt V).validN n fm)
    (hi : inclN {gmap_view_fragUR K cnt V}
      {\new Op _ { | op => (gmap_view_fragUR K cnt V).op }}
      ((gmap_view_fragUR K cnt V).op
        (gsingleton k (DfracOwn qp_one, v)) bf) n fm)
  : TruncP (\Sigma (stored : \Sigma Dfrac V.E)
      (glookup fm k = just stored)
      ((ProdCMRA DfracCMRA V).dist n stored (DfracOwn qp_one, v))) =>
  \case hi \with {
    | inP (z, hd) =>
      \let
        | bfnone => gmap_view_full_frame_absent n fm bf k v hfm hi
        | total => (gmap_view_fragUR K cnt V).op
            ((gmap_view_fragUR K cnt V).op
              (gsingleton k (DfracOwn qp_one, v)) bf) z
        | htotal : (gmap_view_fragUR K cnt V).validN n total =>
            (gmap_view_fragUR K cnt V).cmra_validN_ne n fm total hd hfm
        | znone : glookup z k = nothing =>
            \case glookup z k \as oz, idp : glookup z k = oz
              \return glookup z k = nothing
            \with {
              | nothing, hz => hz
              | just dz, hz =>
                \let atK : option_validN {ProdCMRA DfracCMRA V} n
                    (just ((ProdCMRA DfracCMRA V).op
                      (DfracOwn qp_one, v) dz)) =>
                  transport (option_validN {ProdCMRA DfracCMRA V} n)
                    (glookup_op
                        ((gmap_view_fragUR K cnt V).op
                          (gsingleton k (DfracOwn qp_one, v)) bf) z k
                      *> pmap (\lam o => option_op {ProdCMRA DfracCMRA V}
                            o (glookup z k))
                          (glookup_op (gsingleton k (DfracOwn qp_one, v)) bf k
                            *> pmap2 (option_op {ProdCMRA DfracCMRA V})
                                (glookup_singleton_eq k (DfracOwn qp_one, v)) bfnone)
                      *> pmap (option_op {ProdCMRA DfracCMRA V}
                            (just (DfracOwn qp_one, v))) hz)
                    (htotal k)
                \in \case dfrac_full_exclusive dz.1 atK.1 \with {}
            }
        | rhs : glookup total k = just (DfracOwn qp_one, v) =>
            glookup_op
                ((gmap_view_fragUR K cnt V).op
                  (gsingleton k (DfracOwn qp_one, v)) bf) z k
              *> pmap (\lam o => option_op {ProdCMRA DfracCMRA V}
                    o (glookup z k))
                  (glookup_op (gsingleton k (DfracOwn qp_one, v)) bf k
                    *> pmap2 (option_op {ProdCMRA DfracCMRA V})
                        (glookup_singleton_eq k (DfracOwn qp_one, v)) bfnone)
              *> pmap (option_op {ProdCMRA DfracCMRA V}
                    (just (DfracOwn qp_one, v))) znone
      \in \case glookup fm k \as om, idp : glookup fm k = om
        \return TruncP (\Sigma (stored : \Sigma Dfrac V.E)
          (glookup fm k = just stored)
          ((ProdCMRA DfracCMRA V).dist n stored (DfracOwn qp_one, v)))
      \with {
        | nothing, hm => \case transport2
            (\lam x y => (OptionOFE (ProdCMRA DfracCMRA V)).dist n x y)
            hm rhs (hd k) \with {}
        | just stored, hm => inP (stored, hm,
            transport2
              (\lam x y => (OptionOFE (ProdCMRA DfracCMRA V)).dist n x y)
              hm rhs (hd k))
      }
  }

\func gmap_view_delete_includedN {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (fm bf : Gmap K cnt (\Sigma Dfrac V.E)) (k : K) (v : V.E)
    (hbf : glookup bf k = nothing)
    (hi : inclN {gmap_view_fragUR K cnt V}
      {\new Op _ { | op => (gmap_view_fragUR K cnt V).op }}
      ((gmap_view_fragUR K cnt V).op
        (gsingleton k (DfracOwn qp_one, v)) bf) n fm)
  : inclN {gmap_view_fragUR K cnt V}
      {\new Op _ { | op => (gmap_view_fragUR K cnt V).op }}
      bf n (gdelete k fm) =>
  \case hi \with {
    | inP (z, hd) => inP (gdelete k z, \lam j =>
      \case EqDecision.decideEq {cnt} j k \with {
        | yes e =>
          \let
            | lhs : glookup (gdelete k fm) j = nothing =>
                transport (\lam x => glookup (gdelete k fm) x = nothing)
                  (inv e) (gmap_view_lookup_delete_eq k fm)
            | bfnone : glookup bf j = nothing =>
                transport (\lam x => glookup bf x = nothing) (inv e) hbf
            | znone : glookup (gdelete k z) j = nothing =>
                transport (\lam x => glookup (gdelete k z) x = nothing)
                  (inv e) (gmap_view_lookup_delete_eq k z)
            | rhs : glookup ((gmap_view_fragUR K cnt V).op bf (gdelete k z)) j
                  = nothing =>
                glookup_op bf (gdelete k z) j
                  *> pmap2 (option_op {ProdCMRA DfracCMRA V}) bfnone znone
          \in transport2
            (\lam u w => (OptionOFE (ProdCMRA DfracCMRA V)).dist n u w)
            (inv lhs) (inv rhs) ()
        | no ne =>
          \let
            | kne : Not (k = j) => \lam q => ne (inv q)
            | lhs : glookup (gdelete k fm) j = glookup fm j =>
                gmap_view_lookup_delete_ne k j fm kne
            | zdel : glookup (gdelete k z) j = glookup z j =>
                gmap_view_lookup_delete_ne k j z kne
            | rhsNew : glookup ((gmap_view_fragUR K cnt V).op bf (gdelete k z)) j
                  = option_op {ProdCMRA DfracCMRA V}
                      (glookup bf j) (glookup z j) =>
                glookup_op bf (gdelete k z) j
                  *> pmap (option_op {ProdCMRA DfracCMRA V} (glookup bf j)) zdel
            | singNone : glookup (gsingleton k (DfracOwn qp_one, v)) j = nothing =>
                glookup_singleton_ne k j (DfracOwn qp_one, v) kne
            | rhsOld : glookup ((gmap_view_fragUR K cnt V).op
                    ((gmap_view_fragUR K cnt V).op
                      (gsingleton k (DfracOwn qp_one, v)) bf) z) j
                  = option_op {ProdCMRA DfracCMRA V}
                      (glookup bf j) (glookup z j) =>
                glookup_op
                    ((gmap_view_fragUR K cnt V).op
                      (gsingleton k (DfracOwn qp_one, v)) bf) z j
                  *> pmap (\lam o => option_op {ProdCMRA DfracCMRA V}
                        o (glookup z j))
                      (glookup_op (gsingleton k (DfracOwn qp_one, v)) bf j
                        *> pmap (\lam o => option_op {ProdCMRA DfracCMRA V}
                              o (glookup bf j)) singNone
                        *> option_op_nothing_l (glookup bf j))
          \in transport2
            (\lam u w => (OptionOFE (ProdCMRA DfracCMRA V)).dist n u w)
            (inv lhs) (rhsOld *> inv rhsNew) (hd j)
      })
  }

\func gmap_view_matches_delete {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (fm : Gmap K cnt (\Sigma Dfrac V.E)) (m : Gmap K cnt V.E)
    (matches : gmap_view_matches n fm m) (k : K)
  : gmap_view_matches n (gdelete k fm) (gdelete k m) =>
  \lam j dv hj => \case EqDecision.decideEq {cnt} j k \with {
    | yes e => \case inv hj *>
        transport (\lam x => glookup (gdelete k fm) x = nothing)
          (inv e) (gmap_view_lookup_delete_eq k fm) \with {}
    | no ne =>
      \let
        | kne : Not (k = j) => \lam q => ne (inv q)
        | old : glookup fm j = just dv =>
            inv (gmap_view_lookup_delete_ne k j fm kne) *> hj
      \in \case matches j dv old \with {
        | inP (mv, hm, d) => inP (mv,
            gmap_view_lookup_delete_ne k j m kne *> hm, d)
      }
  }

\func gmap_view_rel_delete {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (m : Gmap K cnt V.E) (bf : Gmap K cnt (\Sigma Dfrac V.E))
    (k : K) (v : V.E)
    (h : gmap_view_rel_holds n m
      ((gmap_view_fragUR K cnt V).op
        (gsingleton k (DfracOwn qp_one, v)) bf))
  : gmap_view_rel_holds n (gdelete k m) bf =>
  \scase h \with {
    | inP (fm, matches, hfm, hi) =>
      \let absent => gmap_view_full_frame_absent n fm bf k v hfm hi
      \in inP (gdelete k fm,
        gmap_view_matches_delete n fm m matches k,
        gmap_view_delete_validN n k fm hfm,
        gmap_view_delete_includedN n fm bf k v absent hi)
  }

\func gmap_view_matches_persist_full {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (fm : Gmap K cnt (\Sigma Dfrac V.E)) (m : Gmap K cnt V.E)
    (matches : gmap_view_matches n fm m) (k : K) (v : V.E)
    (stored : \Sigma Dfrac V.E) (hstored : glookup fm k = just stored)
    (dsv : (ProdCMRA DfracCMRA V).dist n stored (DfracOwn qp_one, v))
  : gmap_view_matches n
      (ginsert k (DfracDiscarded, v) (gdelete k fm)) m =>
  \lam j dv hj => \case EqDecision.decideEq {cnt} j k \with {
    | yes e =>
      \let
        | atj : glookup (ginsert k (DfracDiscarded, v) (gdelete k fm)) j
              = just (DfracDiscarded, v) =>
            transport (\lam z => glookup
              (ginsert k (DfracDiscarded, v) (gdelete k fm)) z
                = just (DfracDiscarded, v))
              (inv e) (glookup_insert_eq k (DfracDiscarded, v) (gdelete k fm))
        | edv : dv = (DfracDiscarded, v) =>
            pmap (\case __ \with {
              | just x => x
              | nothing => dv
            }) (inv hj *> atj)
      \in \scase matches k stored hstored \with {
        | inP (mv, hm, dsm) => inP (mv,
            transport (\lam z => glookup m z = just mv) (inv e) hm,
            transport (\lam x => V.dist n x.2 mv) (inv edv)
              (V.ofe_dist_trans n v stored.2 mv
                (V.ofe_dist_sym n stored.2 v dsv.2) dsm))
      }
    | no ne =>
      \let
        | kne : Not (k = j) => \lam q => ne (inv q)
        | old : glookup fm j = just dv =>
            inv (gmap_view_lookup_delete_ne k j fm kne)
              *> inv (glookup_insert_ne k j (DfracDiscarded, v)
                    (gdelete k fm) kne)
              *> hj
      \in matches j dv old
  }

\func gmap_view_matches_dfrac_update {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (fm : Gmap K cnt (\Sigma Dfrac V.E)) (m : Gmap K cnt V.E)
    (matches : gmap_view_matches n fm m) (k : K)
    (stored newStored : \Sigma Dfrac V.E)
    (hstored : glookup fm k = just stored)
    (dv : V.dist n newStored.2 stored.2)
  : gmap_view_matches n (ginsert k newStored (gdelete k fm)) m =>
  \lam j x hx => \case EqDecision.decideEq {cnt} j k \with {
    | yes e =>
      \let
        | atj : glookup (ginsert k newStored (gdelete k fm)) j = just newStored =>
            transport (\lam z => glookup (ginsert k newStored (gdelete k fm)) z
              = just newStored) (inv e)
              (glookup_insert_eq k newStored (gdelete k fm))
        | ex : x = newStored => pmap (\case __ \with {
            | just y => y
            | nothing => x
          }) (inv hx *> atj)
      \in \scase matches k stored hstored \with {
        | inP (mv, hm, dsm) => inP (mv,
            transport (\lam z => glookup m z = just mv) (inv e) hm,
            transport (\lam y => V.dist n y.2 mv) (inv ex)
              (V.ofe_dist_trans n newStored.2 stored.2 mv dv dsm))
      }
    | no ne =>
      \let
        | kne : Not (k = j) => \lam q => ne (inv q)
        | old : glookup fm j = just x =>
            inv (gmap_view_lookup_delete_ne k j fm kne)
              *> inv (glookup_insert_ne k j newStored (gdelete k fm) kne)
              *> hx
      \in matches j x old
  }

\func gmap_view_dfrac_update_includedN {K : \Set} {cnt : Countable K}
    {V : CMRA} (n : Nat) (fm bf z : Gmap K cnt (\Sigma Dfrac V.E))
    (k : K) (dq dq' : Dfrac) (v : V.E)
    (hd : (GmapOFE K cnt (ProdCMRA DfracCMRA V)).dist n fm
      ((gmap_view_fragUR K cnt V).op
        ((gmap_view_fragUR K cnt V).op (gsingleton k (dq, v)) bf) z))
  : inclN {gmap_view_fragUR K cnt V}
      {\new Op _ { | op => (gmap_view_fragUR K cnt V).op }}
      ((gmap_view_fragUR K cnt V).op (gsingleton k (dq', v)) bf) n
      (ginsert k
        (cmra_opM {DfracCMRA} dq'
            (maybe_fmap (\lam p => p.1)
              (option_op {ProdCMRA DfracCMRA V} (glookup bf k) (glookup z k))),
         cmra_opM {V} v
            (maybe_fmap (\lam p => p.2)
              (option_op {ProdCMRA DfracCMRA V} (glookup bf k) (glookup z k))))
        (gdelete k fm)) =>
  inP (z, \lam j => \case EqDecision.decideEq {cnt} j k \with {
    | yes e =>
      \let
        | frame => option_op {ProdCMRA DfracCMRA V} (glookup bf k) (glookup z k)
        | newStored =>
            (cmra_opM {DfracCMRA} dq' (maybe_fmap (\lam p => p.1) frame),
             cmra_opM {V} v (maybe_fmap (\lam p => p.2) frame))
        | lhsEq : glookup (ginsert k newStored (gdelete k fm)) j
              = just newStored =>
            transport (\lam x => glookup (ginsert k newStored (gdelete k fm)) x
              = just newStored) (inv e)
              (glookup_insert_eq k newStored (gdelete k fm))
        | compEq : cmra_opM {ProdCMRA DfracCMRA V} (dq', v) frame
              = newStored => prod_opM_components (dq', v) frame
        | rhsAtK : (OptionOFE (ProdCMRA DfracCMRA V)).dist n
              (glookup ((gmap_view_fragUR K cnt V).op
                ((gmap_view_fragUR K cnt V).op
                  (gsingleton k (dq', v)) bf) z) k)
              (just newStored) =>
            transport (\lam o => (OptionOFE (ProdCMRA DfracCMRA V)).dist n
              (glookup ((gmap_view_fragUR K cnt V).op
                ((gmap_view_fragUR K cnt V).op
                  (gsingleton k (dq', v)) bf) z) k) o)
              (pmap just compEq)
              (gmap_view_total_lookup_dist n k dq' v bf z)
        | backAtK : (OptionOFE (ProdCMRA DfracCMRA V)).dist n
              (just newStored)
              (glookup ((gmap_view_fragUR K cnt V).op
                ((gmap_view_fragUR K cnt V).op
                  (gsingleton k (dq', v)) bf) z) k) =>
            (OptionOFE (ProdCMRA DfracCMRA V)).ofe_dist_sym n _ _ rhsAtK
      \in transport2
        (\lam u w => (OptionOFE (ProdCMRA DfracCMRA V)).dist n u w)
        (inv lhsEq)
        (pmap (\lam x => glookup ((gmap_view_fragUR K cnt V).op
          ((gmap_view_fragUR K cnt V).op (gsingleton k (dq', v)) bf) z) x)
          (inv e)) backAtK
    | no ne =>
      \let
        | kne : Not (k = j) => \lam q => ne (inv q)
        | lhsEq : glookup (ginsert k
              (cmra_opM {DfracCMRA} dq'
                  (maybe_fmap (\lam p => p.1)
                    (option_op {ProdCMRA DfracCMRA V}
                      (glookup bf k) (glookup z k))),
               cmra_opM {V} v
                  (maybe_fmap (\lam p => p.2)
                    (option_op {ProdCMRA DfracCMRA V}
                      (glookup bf k) (glookup z k))))
              (gdelete k fm)) j = glookup fm j =>
            glookup_insert_ne k j _ (gdelete k fm) kne
              *> gmap_view_lookup_delete_ne k j fm kne
        | oldSing : glookup (gsingleton k (dq, v)) j = nothing =>
            glookup_singleton_ne k j (dq, v) kne
        | newSing : glookup (gsingleton k (dq', v)) j = nothing =>
            glookup_singleton_ne k j (dq', v) kne
        | rhsOld : glookup ((gmap_view_fragUR K cnt V).op
              ((gmap_view_fragUR K cnt V).op (gsingleton k (dq, v)) bf) z) j
            = option_op {ProdCMRA DfracCMRA V} (glookup bf j) (glookup z j) =>
            glookup_op ((gmap_view_fragUR K cnt V).op
                (gsingleton k (dq, v)) bf) z j
              *> pmap (\lam o => option_op {ProdCMRA DfracCMRA V} o
                  (glookup z j))
                (glookup_op (gsingleton k (dq, v)) bf j
                  *> pmap (\lam o => option_op {ProdCMRA DfracCMRA V} o
                      (glookup bf j)) oldSing
                  *> option_op_nothing_l (glookup bf j))
        | rhsNew : glookup ((gmap_view_fragUR K cnt V).op
              ((gmap_view_fragUR K cnt V).op (gsingleton k (dq', v)) bf) z) j
            = option_op {ProdCMRA DfracCMRA V} (glookup bf j) (glookup z j) =>
            glookup_op ((gmap_view_fragUR K cnt V).op
                (gsingleton k (dq', v)) bf) z j
              *> pmap (\lam o => option_op {ProdCMRA DfracCMRA V} o
                  (glookup z j))
                (glookup_op (gsingleton k (dq', v)) bf j
                  *> pmap (\lam o => option_op {ProdCMRA DfracCMRA V} o
                      (glookup bf j)) newSing
                  *> option_op_nothing_l (glookup bf j))
      \in transport2
          (\lam u w => (OptionOFE (ProdCMRA DfracCMRA V)).dist n u w)
          (inv lhsEq) (rhsOld *> inv rhsNew) (hd j)
  })

\func gmap_view_rel_dfrac_update {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (m : Gmap K cnt V.E)
    (bf : Gmap K cnt (\Sigma Dfrac V.E))
    (k : K) (dq : Dfrac) (v : V.E) (P : Dfrac -> \Prop)
    (hup : cmra_updatePM {DfracCMRA} dq P)
    (h : gmap_view_rel_holds n m
      ((gmap_view_fragUR K cnt V).op (gsingleton k (dq, v)) bf))
  : TruncP (\Sigma (dq' : Dfrac) (P dq')
      (gmap_view_rel_holds n m
        ((gmap_view_fragUR K cnt V).op (gsingleton k (dq', v)) bf))) =>
  \scase h \with {
    | inP (fm, matches, hfm, hi) => \scase hi \with {
        | inP (z, hd) =>
          \scase gmap_view_source_stored n fm bf z k dq v hd \with {
            | inP (stored, hstored, dsource) =>
              \let
                | frame => option_op {ProdCMRA DfracCMRA V}
                    (glookup bf k) (glookup z k)
                | source => cmra_opM {ProdCMRA DfracCMRA V} (dq, v) frame
                | sourceComponents =>
                    (cmra_opM {DfracCMRA} dq
                        (maybe_fmap (\lam p => p.1) frame),
                     cmra_opM {V} v
                        (maybe_fmap (\lam p => p.2) frame))
                | compEq : source = sourceComponents =>
                    prod_opM_components (dq, v) frame
                | storedValid : (ProdCMRA DfracCMRA V).validN n stored =>
                    transport (option_validN {ProdCMRA DfracCMRA V} n)
                      hstored (hfm k)
                | sourceValid : (ProdCMRA DfracCMRA V).validN n source =>
                    (ProdCMRA DfracCMRA V).cmra_validN_ne n stored source
                      dsource storedValid
                | sourceComponentsValid :
                    (ProdCMRA DfracCMRA V).validN n sourceComponents =>
                    transport ((ProdCMRA DfracCMRA V).validN n) compEq sourceValid
                | dcomponents : (ProdCMRA DfracCMRA V).dist n
                    stored sourceComponents =>
                    transport (\lam x => (ProdCMRA DfracCMRA V).dist n stored x)
                      compEq dsource
              \in \scase hup n
                  (maybe_fmap (\lam p => p.1) frame)
                  sourceComponentsValid.1 \with {
                | inP (dq', pdq', hdq') =>
                  \let
                    | newStored =>
                        (cmra_opM {DfracCMRA} dq'
                            (maybe_fmap (\lam p => p.1) frame),
                         cmra_opM {V} v
                            (maybe_fmap (\lam p => p.2) frame))
                    | newValid : (ProdCMRA DfracCMRA V).validN n newStored =>
                        (hdq', sourceComponentsValid.2)
                    | deletedValid => gmap_view_delete_validN n k fm hfm
                    | newMapValid => gmap_insert_validN n (gdelete k fm) k
                        newStored newValid deletedValid
                    | newMatches => gmap_view_matches_dfrac_update n fm m matches
                        k stored newStored hstored
                        (V.ofe_dist_sym n stored.2 newStored.2 dcomponents.2)
                    | newIncl => gmap_view_dfrac_update_includedN
                        n fm bf z k dq dq' v hd
                  \in inP (dq', pdq', inP (
                    ginsert k newStored (gdelete k fm),
                    newMatches, newMapValid, newIncl))
              }
          }
      }
  }

\func gmap_view_rel_persist_full {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (m : Gmap K cnt V.E) (bf : Gmap K cnt (\Sigma Dfrac V.E))
    (k : K) (v : V.E)
    (h : gmap_view_rel_holds n m
      ((gmap_view_fragUR K cnt V).op
        (gsingleton k (DfracOwn qp_one, v)) bf))
  : gmap_view_rel_holds n m
      ((gmap_view_fragUR K cnt V).op
        (gsingleton k (DfracDiscarded, v)) bf) =>
  \scase h \with {
    | inP (fm, matches, hfm, hi) =>
      \scase gmap_view_full_included_exact n fm bf k v hfm hi \with {
        | inP (stored, hstored, dsv) =>
          \let
            | storedValid : (ProdCMRA DfracCMRA V).validN n stored =>
                transport (option_validN {ProdCMRA DfracCMRA V} n)
                  hstored (hfm k)
            | vValid : V.validN n v =>
                V.cmra_validN_ne n stored.2 v dsv.2 storedValid.2
            | deletedValid => gmap_view_delete_validN n k fm hfm
            | insertedValid => gmap_insert_validN n (gdelete k fm) k
                (DfracDiscarded, v) ((), vValid) deletedValid
            | bfnone => gmap_view_full_frame_absent n fm bf k v hfm hi
            | bfInclDeleted =>
                gmap_view_delete_includedN n fm bf k v bfnone hi
            | insertedIncl => gmap_alloc_includedN n (gdelete k fm) bf k
                (DfracDiscarded, v) (gmap_view_lookup_delete_eq k fm)
                bfInclDeleted
          \in inP (ginsert k (DfracDiscarded, v) (gdelete k fm),
            gmap_view_matches_persist_full n fm m matches k v stored hstored dsv,
            insertedValid, insertedIncl)
      }
  }

\func gmap_view_matches_insert {K : \Set} {cnt : Countable K} {V : CMRA}
    (n : Nat) (fm : Gmap K cnt (\Sigma Dfrac V.E)) (m : Gmap K cnt V.E)
    (matches : gmap_view_matches n fm m) (k : K) (dq : Dfrac) (v : V.E)
  : gmap_view_matches n (ginsert k (dq, v) fm) (ginsert k v m) =>
  \lam j dv hj => \case EqDecision.decideEq {cnt} j k \with {
    | yes e =>
      \let
        | atj : glookup (ginsert k (dq, v) fm) j = just (dq, v) =>
            transport (\lam z => glookup (ginsert k (dq, v) fm) z = just (dq, v))
              (inv e) (glookup_insert_eq k (dq, v) fm)
        | edv : dv = (dq, v) =>
            pmap (\case __ \with { | just x => x | nothing => dv }) (inv hj *> atj)
        | authj : glookup (ginsert k v m) j = just v =>
            transport (\lam z => glookup (ginsert k v m) z = just v)
              (inv e) (glookup_insert_eq k v m)
      \in inP (v, authj,
        transport (\lam x => V.dist n x.2 v) (inv edv) (V.ofe_dist_refl n v))
    | no ne =>
      \let
        | ne' : Not (k = j) => \lam q => ne (inv q)
        | hfm : glookup fm j = just dv =>
            inv (glookup_insert_ne k j (dq, v) fm ne') *> hj
      \in \case matches j dv hfm \with {
        | inP (mv, hm, d) => inP (mv,
            glookup_insert_ne k j v m ne' *> hm, d)
      }
  }

\lemma gmap_view_alloc {K : \Set} {cnt : Countable K} {V : CMRA}
    (m : Gmap K cnt V.E) (k : K) (dq : Dfrac) (v : V.E)
    (fresh : glookup m k = nothing) (hdq : dfrac_valid dq) (hv : V.valid v)
  : cmra_updateP {gmap_viewUR K cnt V} (gmap_view_auth (DfracOwn qp_one) m)
      (\lam y => y = (gmap_viewR K cnt V).op
        (gmap_view_auth (DfracOwn qp_one) (ginsert k v m))
        (gmap_view_frag k dq v)) =>
  view_update_alloc (gmap_view_rel K cnt V) m (ginsert k v m)
    (gsingleton k (dq, v))
    (\lam n bf hrel => \case hrel \with {
      | inP (fm, matches, hfmv, hbf) =>
        \let
          | fmfresh : glookup fm k = nothing =>
              gmap_view_match_fresh n fm m matches k fresh
          | hdvn : (ProdCMRA DfracCMRA V).validN n (dq, v) =>
              (hdq, (V.cmra_valid_validN v).1 hv n)
          | insertedValid : (gmap_view_fragUR K cnt V).validN n
                (ginsert k (dq, v) fm) =>
              gmap_insert_validN n fm k (dq, v) hdvn hfmv
          | insertedIncl : inclN {gmap_view_fragUR K cnt V}
                {\new Op _ { | op => (gmap_view_fragUR K cnt V).op }}
                ((gmap_view_fragUR K cnt V).op (gsingleton k (dq, v)) bf)
                n (ginsert k (dq, v) fm) =>
              gmap_alloc_includedN n fm bf k (dq, v) fmfresh hbf
        \in inP (ginsert k (dq, v) fm,
          gmap_view_matches_insert n fm m matches k dq v,
          insertedValid, insertedIncl)
    })

-- An abstract package for the full gmap-view specialized to Agree values.
-- Clients with recursive OFEs can seal this package and use its projections;
-- conversion then compares projection applications instead of unfolding the
-- complete View CMRA record.  This package is intentionally level-0: all of
-- its clients are RFunctor/iProp constructions at level 0, and leaving these
-- levels unbounded makes paths over the package acquire an infinite level.
\record GmapViewAgreeKit (K : \Set0) (cnt : Countable K) (O : OFE.{0})
  | gva_R : UCMRA.{0}
  | gva_auth : Dfrac -> Gmap K cnt (AgreeElem O) -> gva_R.E
  | gva_frag : K -> Dfrac -> AgreeElem O -> gva_R.E
  | gva_auth_validN : \Pi (n : Nat) (dq : Dfrac)
      (m : Gmap K cnt (AgreeElem O)) -> dfrac_valid dq ->
      gva_R.validN n (gva_auth dq m)
  | gva_both_discarded_validN : \Pi (n : Nat) (dp : Dfrac)
      (m : Gmap K cnt (AgreeElem O)) (k : K) (v : AgreeElem O) ->
      gva_R.validN n (gva_R.op (gva_auth dp m)
        (gva_frag k DfracDiscarded v)) ->
      \Sigma (dfrac_valid dp)
        (TruncP (\Sigma (mv : AgreeElem O) (glookup m k = just mv)
          ((AgreeOFE O).dist n v mv)))
  | gva_both_discarded_map_validN : \Pi (X : \Set0) (n : Nat)
      (dp : Dfrac) (m : Gmap K cnt X) (f : X -> O.E) (k : K) (x : O.E) ->
      gva_R.validN n (gva_R.op
        (gva_auth dp (gmap_to_agree_map m f))
        (gva_frag k DfracDiscarded (to_agree x))) ->
      \Sigma (dfrac_valid dp)
        (TruncP (\Sigma (y : X) (glookup m k = just y)
          (O.dist n x (f y))))
  | gva_alloc : \Pi (m : Gmap K cnt (AgreeElem O)) (k : K)
      (dq : Dfrac) (v : AgreeElem O) -> glookup m k = nothing ->
      dfrac_valid dq -> (AgreeCMRA O).valid v ->
      cmra_updateP {gva_R} (gva_auth (DfracOwn qp_one) m)
        (\lam y => y = gva_R.op
          (gva_auth (DfracOwn qp_one) (ginsert k v m))
          (gva_frag k dq v))

\func gmap_view_agree_kit (K : \Set0) (cnt : Countable K) (O : OFE.{0})
  : GmapViewAgreeKit K cnt O \cowith
  | gva_R => gmap_viewUR K cnt (AgreeCMRA O)
  | gva_auth => \lam dq m => gmap_view_auth dq m
  | gva_frag => \lam k dq v => gmap_view_frag k dq v
  | gva_auth_validN => \lam n dq m hdq => gmap_view_auth_validN n dq m hdq
  | gva_both_discarded_validN => \lam n dp m k v h =>
      gmap_view_both_discarded_agree_validN n dp m k v h
  | gva_both_discarded_map_validN => \lam X n dp m f k x h =>
      gmap_view_both_discarded_agree_map_validN
        {K} {X} {cnt} {O} n dp m f k x h
  | gva_alloc => \lam m k dq v fresh hdq hv =>
      gmap_view_alloc {K} {cnt} {AgreeCMRA O}
        m k dq v fresh hdq hv

-- Expose the CMRA part of the unital construction without unfolding it at use
-- sites.  Keeping this conversion separate prevents one very large comparison.
\func gmap_viewUR_as_CMRA {K : \Set0} {cnt : Countable K} {V : CMRA.{0}}
  : (gmap_viewUR K cnt V : CMRA.{0}) = gmap_viewR K cnt V => idp

\lemma gmap_view_auth_persist {K : \Set} {cnt : Countable K} {V : CMRA}
    (dq : Dfrac) (m : Gmap K cnt V.E)
  : cmra_updateP {gmap_viewUR K cnt V} (gmap_view_auth dq m)
      (\lam y => y = gmap_view_auth DfracDiscarded m) =>
  view_auth_persist (gmap_view_rel K cnt V) dq m

\lemma gmap_view_auth_unpersist {K : \Set} {cnt : Countable K} {V : CMRA}
    (m : Gmap K cnt V.E)
  : cmra_updateP {gmap_viewUR K cnt V}
      (gmap_view_auth DfracDiscarded m)
      (\lam y => TruncP (\Sigma (q : Qp)
        (y = gmap_view_auth (DfracOwn q) m))) =>
  view_auth_unpersist (gmap_view_rel K cnt V) m

\lemma gmap_view_frag_dfrac_update {K : \Set} {cnt : Countable K} {V : CMRA}
    (k : K) (dq : Dfrac) (P : Dfrac -> \Prop) (v : V.E)
    (hup : cmra_updatePM {DfracCMRA} dq P)
  : cmra_updateP {gmap_viewUR K cnt V} (gmap_view_frag k dq v)
      (\lam y => TruncP (\Sigma (dq' : Dfrac)
        (y = gmap_view_frag k dq' v) (P dq'))) =>
  \let
    | mapP : Gmap K cnt (\Sigma Dfrac V.E) -> \Prop =>
        \lam b => TruncP (\Sigma (dq' : Dfrac)
          (b = gsingleton k (dq', v)) (P dq'))
    | relUpdate : \Pi (n : Nat) (a : Gmap K cnt V.E)
          (bf : Gmap K cnt (\Sigma Dfrac V.E)) ->
          gmap_view_rel_holds n a
            ((gmap_view_fragUR K cnt V).op (gsingleton k (dq, v)) bf) ->
          TruncP (\Sigma (b' : Gmap K cnt (\Sigma Dfrac V.E)) (mapP b')
            (gmap_view_rel_holds n a
              ((gmap_view_fragUR K cnt V).op b' bf))) =>
        \lam n a bf h => \scase
          gmap_view_rel_dfrac_update n a bf k dq v P hup h \with {
            | inP (dq', pdq', hr) => inP (gsingleton k (dq', v),
                inP (dq', idp, pdq'), hr)
          }
    | lifted => view_updateP_frag (gmap_view_rel K cnt V)
        (gsingleton k (dq, v)) mapP relUpdate
  \in \lam n frame hv => \scase lifted n frame hv \with {
    | inP (y, py, hy) => \scase py \with {
        | inP (b', ey, pb') => \scase pb' \with {
            | inP (dq', eb', pdq') => inP (y,
                inP (dq', ey *> pmap
                  (view_frag {GmapOFE K cnt V} {gmap_view_fragUR K cnt V})
                  eb', pdq'), hy)
          }
      }
  }

\lemma gmap_view_frag_persist {K : \Set} {cnt : Countable K} {V : CMRA}
    (k : K) (dq : Dfrac) (v : V.E)
  : cmra_updateP {gmap_viewUR K cnt V} (gmap_view_frag k dq v)
      (\lam y => y = gmap_view_frag k DfracDiscarded v) =>
  \lam n frame hv =>
    \scase gmap_view_frag_dfrac_update k dq
        (\lam x => x = DfracDiscarded) v (dfrac_discard_updatePM dq)
        n frame hv \with {
      | inP (y, py, hy) => \scase py \with {
          | inP (dq', ey, edq') => inP (y,
              ey *> pmap (\lam d => gmap_view_frag k d v) edq', hy)
        }
    }

\lemma gmap_view_frag_unpersist {K : \Set} {cnt : Countable K} {V : CMRA}
    (k : K) (v : V.E)
  : cmra_updateP {gmap_viewUR K cnt V}
      (gmap_view_frag k DfracDiscarded v)
      (\lam y => TruncP (\Sigma (q : Qp)
        (y = gmap_view_frag k (DfracOwn q) v))) =>
  \lam n frame hv =>
    \scase gmap_view_frag_dfrac_update k DfracDiscarded
        (\lam d => TruncP (\Sigma (q : Qp) (d = DfracOwn q)))
        v dfrac_undiscard_updatePM n frame hv \with {
      | inP (y, py, hy) => \scase py \with {
          | inP (dq', ey, pdq') => \scase pdq' \with {
              | inP (q, eq) => inP (y,
                  inP (q, ey *> pmap (\lam d => gmap_view_frag k d v) eq), hy)
            }
        }
    }

\lemma gmap_view_delete {K : \Set} {cnt : Countable K} {V : CMRA}
    (m : Gmap K cnt V.E) (k : K) (v : V.E)
  : cmra_updateP {gmap_viewUR K cnt V}
      ((gmap_viewR K cnt V).op
        (gmap_view_auth (DfracOwn qp_one) m)
        (gmap_view_frag k (DfracOwn qp_one) v))
      (\lam y => y = gmap_view_auth (DfracOwn qp_one) (gdelete k m)) =>
  view_update_dealloc (gmap_view_rel K cnt V) m
    (gsingleton k (DfracOwn qp_one, v)) (gdelete k m)
    (\lam n bf h => gmap_view_rel_delete n m bf k v h)

\lemma gmap_view_insert_delete {K : \Set} {cnt : Countable K} {A : \Set}
    (m : Gmap K cnt A) (k : K) (x : A)
  : ginsert k x (gdelete k m) = ginsert k x m =>
  gmap_eq (ginsert k x (gdelete k m)) (ginsert k x m) (\lam j =>
    \case EqDecision.decideEq {cnt} j k \with {
      | yes e =>
        transport (\lam z => glookup (ginsert k x (gdelete k m)) z =
          glookup (ginsert k x m) z) (inv e)
          (glookup_insert_eq k x (gdelete k m) *> inv (glookup_insert_eq k x m))
      | no ne =>
        \let kne : Not (k = j) => \lam q => ne (inv q)
        \in glookup_insert_ne k j x (gdelete k m) kne
          *> gmap_view_lookup_delete_ne k j m kne
          *> inv (glookup_insert_ne k j x m kne)
    })

\lemma gmap_view_replace {K : \Set} {cnt : Countable K} {V : CMRA}
    (m : Gmap K cnt V.E) (k : K) (v v' : V.E) (hv' : V.valid v')
  : cmra_updateP {gmap_viewUR K cnt V}
      ((gmap_viewR K cnt V).op
        (gmap_view_auth (DfracOwn qp_one) m)
        (gmap_view_frag k (DfracOwn qp_one) v))
      (\lam y => y = (gmap_viewR K cnt V).op
        (gmap_view_auth (DfracOwn qp_one) (ginsert k v' m))
        (gmap_view_frag k (DfracOwn qp_one) v')) =>
  \lam n frame hvalid =>
    \scase gmap_view_delete m k v n frame hvalid \with {
      | inP (deleted, edeleted, hdeleted) =>
        \let
          | hdeleted' : validN {gmap_viewUR K cnt V} n
              ((gmap_viewUR K cnt V).op
                (gmap_view_auth (DfracOwn qp_one) (gdelete k m)) frame) =>
              transport (\lam z => validN {gmap_viewUR K cnt V} n
                ((gmap_viewUR K cnt V).op z frame)) edeleted hdeleted
          | fresh : glookup (gdelete k m) k = nothing =>
              gmap_view_lookup_delete_eq k m
        \in \scase gmap_view_alloc (gdelete k m) k
            (DfracOwn qp_one) v' fresh
            RatField.<=-refl hv' n frame hdeleted' \with {
          | inP (replaced, ereplaced, hreplaced) =>
            inP (replaced,
              ereplaced *> pmap (\lam mm => (gmap_viewR K cnt V).op
                (gmap_view_auth (DfracOwn qp_one) mm)
                (gmap_view_frag k (DfracOwn qp_one) v'))
                (gmap_view_insert_delete m k v'),
              hreplaced)
        }
    }

-- Full ownership of a key permits an arbitrary valid value update.  This is
-- the operational single-key update; `gmap_view_replace` is its Iris-aligned
-- name and implementation.
\lemma gmap_view_update {K : \Set} {cnt : Countable K} {V : CMRA}
    (m : Gmap K cnt V.E) (k : K) (v v' : V.E) (hv' : V.valid v')
  : cmra_updateP {gmap_viewUR K cnt V}
      ((gmap_viewR K cnt V).op
        (gmap_view_auth (DfracOwn qp_one) m)
        (gmap_view_frag k (DfracOwn qp_one) v))
      (\lam y => y = (gmap_viewR K cnt V).op
        (gmap_view_auth (DfracOwn qp_one) (ginsert k v' m))
        (gmap_view_frag k (DfracOwn qp_one) v')) =>
  gmap_view_replace m k v v' hv'
