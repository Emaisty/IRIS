\import Logic
\import Logic.Meta
\import Paths
\import Set
\import Data.Bool
\import Data.Maybe
\import Data.Or
\import Arith.Nat
\import Order.PartialOrder
\import lib.pmap

-- =================================================================================
-- coPset: countable subsets of `Pos` as a binary tree.
-- =================================================================================
--
-- Mirrors stdpp's `coPset_raw`: each node carries a Boolean (whether the
-- positive routed *to this node* is included) and two subtrees for the `xO p`
-- and `xI p` branches. Leaves are constant (`true` = ⊤-from-here, `false` = ∅-from-here).
--
-- Following our equiv-based CMRA design, we deliberately *omit* the canonicity
-- (well-formedness) invariant present in stdpp. Comparison and equiv use
-- pointwise membership instead of propositional equality on the tree. The
-- price is that operations may produce non-canonical trees; the benefit is a
-- much smaller code surface.

\data coPset
  | coPLeaf Bool
  | coPNode Bool coPset coPset


-- =================================================================================
-- Membership
-- =================================================================================

\func coPmem (p : Pos) (X : coPset) : Bool \elim X
  | coPLeaf b => b
  | coPNode b L R => \case p \with {
      | xH => b
      | xO p' => coPmem p' L
      | xI p' => coPmem p' R
    }

\func coPIn (p : Pos) (X : coPset) : \Prop => coPmem p X = true
\func coPNotIn (p : Pos) (X : coPset) : \Prop => coPmem p X = false


-- =================================================================================
-- Constants
-- =================================================================================

\func coPset_empty : coPset => coPLeaf false
\func coPset_universe : coPset => coPLeaf true

\lemma coPmem_empty (p : Pos) : coPmem p coPset_empty = false \elim p
  | xH => idp
  | xO _ => idp
  | xI _ => idp

\lemma coPmem_universe (p : Pos) : coPmem p coPset_universe = true \elim p
  | xH => idp
  | xO _ => idp
  | xI _ => idp


-- =================================================================================
-- Singleton
-- =================================================================================

-- The singleton {p}: a tree with a single `true` at position p, false elsewhere.
\func coPset_singleton (p : Pos) : coPset \elim p
  | xH    => coPNode true coPset_empty coPset_empty
  | xO p' => coPNode false (coPset_singleton p') coPset_empty
  | xI p' => coPNode false coPset_empty (coPset_singleton p')

\lemma coPmem_singleton_eq (p : Pos) : coPmem p (coPset_singleton p) = true \elim p
  | xH => idp
  | xO p' => coPmem_singleton_eq p'
  | xI p' => coPmem_singleton_eq p'


-- =================================================================================
-- Union, intersection, complement, difference
-- =================================================================================

-- Operations are written *purely structurally* so reduction is uniform.
-- They may produce non-canonical trees (e.g. `coPNode true (coPLeaf true) (coPLeaf true)`
-- instead of `coPLeaf true`); since we compare via `coPset_equiv` rather than
-- propositional equality, this is fine.

\func coPset_union (X Y : coPset) : coPset \elim X, Y
  | coPLeaf bx, coPLeaf by_ => coPLeaf (bx or by_)
  | coPLeaf bx, coPNode by_ Ly Ry =>
      coPNode (bx or by_) (coPset_union (coPLeaf bx) Ly) (coPset_union (coPLeaf bx) Ry)
  | coPNode bx Lx Rx, coPLeaf by_ =>
      coPNode (bx or by_) (coPset_union Lx (coPLeaf by_)) (coPset_union Rx (coPLeaf by_))
  | coPNode bx Lx Rx, coPNode by_ Ly Ry =>
      coPNode (bx or by_) (coPset_union Lx Ly) (coPset_union Rx Ry)

\func coPset_intersection (X Y : coPset) : coPset \elim X, Y
  | coPLeaf bx, coPLeaf by_ => coPLeaf (bx and by_)
  | coPLeaf bx, coPNode by_ Ly Ry =>
      coPNode (bx and by_) (coPset_intersection (coPLeaf bx) Ly) (coPset_intersection (coPLeaf bx) Ry)
  | coPNode bx Lx Rx, coPLeaf by_ =>
      coPNode (bx and by_) (coPset_intersection Lx (coPLeaf by_)) (coPset_intersection Rx (coPLeaf by_))
  | coPNode bx Lx Rx, coPNode by_ Ly Ry =>
      coPNode (bx and by_) (coPset_intersection Lx Ly) (coPset_intersection Rx Ry)

\func coPset_complement (X : coPset) : coPset \elim X
  | coPLeaf b => coPLeaf (not b)
  | coPNode b L R => coPNode (not b) (coPset_complement L) (coPset_complement R)

\func coPset_difference (X Y : coPset) : coPset =>
  coPset_intersection X (coPset_complement Y)


-- =================================================================================
-- Membership lemmas
-- =================================================================================

\lemma coPmem_union (p : Pos) (X Y : coPset)
  : coPmem p (coPset_union X Y) = (coPmem p X or coPmem p Y) \elim p, X, Y
  | p, coPLeaf bx, coPLeaf by_ => idp
  | xH, coPLeaf bx, coPNode by_ Ly Ry => idp
  | xO p, coPLeaf bx, coPNode by_ Ly Ry => coPmem_union p (coPLeaf bx) Ly
  | xI p, coPLeaf bx, coPNode by_ Ly Ry => coPmem_union p (coPLeaf bx) Ry
  | xH, coPNode bx Lx Rx, coPLeaf by_ => idp
  | xO p, coPNode bx Lx Rx, coPLeaf by_ => coPmem_union p Lx (coPLeaf by_)
  | xI p, coPNode bx Lx Rx, coPLeaf by_ => coPmem_union p Rx (coPLeaf by_)
  | xH, coPNode bx Lx Rx, coPNode by_ Ly Ry => idp
  | xO p, coPNode bx Lx Rx, coPNode by_ Ly Ry => coPmem_union p Lx Ly
  | xI p, coPNode bx Lx Rx, coPNode by_ Ly Ry => coPmem_union p Rx Ry

\lemma coPmem_intersection (p : Pos) (X Y : coPset)
  : coPmem p (coPset_intersection X Y) = (coPmem p X and coPmem p Y) \elim p, X, Y
  | p, coPLeaf bx, coPLeaf by_ => idp
  | xH, coPLeaf bx, coPNode by_ Ly Ry => idp
  | xO p, coPLeaf bx, coPNode by_ Ly Ry => coPmem_intersection p (coPLeaf bx) Ly
  | xI p, coPLeaf bx, coPNode by_ Ly Ry => coPmem_intersection p (coPLeaf bx) Ry
  | xH, coPNode bx Lx Rx, coPLeaf by_ => idp
  | xO p, coPNode bx Lx Rx, coPLeaf by_ => coPmem_intersection p Lx (coPLeaf by_)
  | xI p, coPNode bx Lx Rx, coPLeaf by_ => coPmem_intersection p Rx (coPLeaf by_)
  | xH, coPNode bx Lx Rx, coPNode by_ Ly Ry => idp
  | xO p, coPNode bx Lx Rx, coPNode by_ Ly Ry => coPmem_intersection p Lx Ly
  | xI p, coPNode bx Lx Rx, coPNode by_ Ly Ry => coPmem_intersection p Rx Ry

\lemma coPmem_complement (p : Pos) (X : coPset)
  : coPmem p (coPset_complement X) = not (coPmem p X) \elim p, X
  | xH, coPLeaf b => idp
  | xO p, coPLeaf b => idp
  | xI p, coPLeaf b => idp
  | xH, coPNode b L R => idp
  | xO p, coPNode b L R => coPmem_complement p L
  | xI p, coPNode b L R => coPmem_complement p R

\lemma coPmem_difference (p : Pos) (X Y : coPset)
  : coPmem p (coPset_difference X Y) = (coPmem p X and not (coPmem p Y)) =>
  coPmem_intersection p X (coPset_complement Y)
  *> pmap (\lam b => coPmem p X and b) (coPmem_complement p Y)


-- =================================================================================
-- Set predicates
-- =================================================================================

\func coPset_equiv (X Y : coPset) : \Prop =>
  \Pi (p : Pos) -> coPmem p X = coPmem p Y

\func coPSubset (X Y : coPset) : \Prop =>
  \Pi (p : Pos) -> coPIn p X -> coPIn p Y

\func coPDisjoint (X Y : coPset) : \Prop =>
  \Pi (p : Pos) -> coPIn p X -> coPNotIn p Y

\lemma coPSubset_empty_l (X : coPset) : coPSubset coPset_empty X =>
  \lam p hp => \case coPmem_empty p *> hp \with {}


\lemma coPset_equiv_refl (X : coPset) : coPset_equiv X X => \lam _ => idp

\lemma coPset_equiv_sym (X Y : coPset) (h : coPset_equiv X Y) : coPset_equiv Y X =>
  \lam p => inv (h p)

\lemma coPset_equiv_trans (X Y Z : coPset)
                          (h1 : coPset_equiv X Y) (h2 : coPset_equiv Y Z)
  : coPset_equiv X Z => \lam p => h1 p *> h2 p

\lemma bool_subset_union_difference (a b : Bool) (h : b = true -> a = true)
  : a = (b or (a and not b)) \elim a, b
  | false, false => idp
  | false, true => \case h idp \with {}
  | true, false => idp
  | true, true => idp

-- If Y is a subset of X, then X is Y plus the disjoint remainder X \\ Y.
\lemma coPset_subset_union_difference (X Y : coPset) (h : coPSubset Y X)
  : coPset_equiv X (coPset_union Y (coPset_difference X Y)) =>
  \lam p =>
    bool_subset_union_difference (coPmem p X) (coPmem p Y) (h p)
    *> inv (coPmem_union p Y (coPset_difference X Y)
        *> pmap (\lam b => coPmem p Y or b) (coPmem_difference p X Y))


-- =================================================================================
-- coPpick: extract a positive from a non-empty coPset.
-- =================================================================================
--
-- Returns `nothing` if the set is empty (constant `false`). The structural
-- recursion walks the tree, preferring xH > xO > xI.

\func coPpick (X : coPset) : Maybe Pos \elim X
  | coPLeaf false => nothing
  | coPLeaf true => just xH
  | coPNode true _ _ => just xH
  | coPNode false L R => \case coPpick L \with {
      | just p => just (xO p)
      | nothing => \case coPpick R \with {
          | just p => just (xI p)
          | nothing => nothing
        }
    }

-- Soundness: if `coPpick X = just p`, then `p ∈ X`.
\lemma coPpick_sound (X : coPset) (p : Pos) (h : coPpick X = just p) : coPIn p X \elim X
  | coPLeaf false => \case (pmap (\case __ \with { | just _ => false | nothing => true }) h) \with {}
  | coPLeaf true =>
    \let p_eq : p = xH =>
      pmap (\case __ \with { | just q => q | nothing => xH }) (inv h)
    \in transport (\lam q => coPIn q (coPLeaf true)) (inv p_eq) idp
  | coPNode true _ _ =>
    \let p_eq : p = xH =>
      pmap (\case __ \with { | just q => q | nothing => xH }) (inv h)
    \in transport (\lam q => coPIn q (coPNode true _ _)) (inv p_eq) idp
  | coPNode false L R => \case coPpick L \as pl, idp : coPpick L = pl, h : (\case pl \with {
      | just q => just (xO q)
      | nothing => \case coPpick R \with {
          | just q => just (xI q)
          | nothing => nothing
        }
    }) = just p \with {
      | just q, hq, h' =>
        \let
          | p_eq : p = xO q => pmap (\case __ \with { | just z => z | nothing => xO q }) (inv h')
          | q_in_L : coPIn q L => coPpick_sound L q hq
        \in transport (\lam z => coPIn z (coPNode false L R)) (inv p_eq) q_in_L
      | nothing, _, h' => \case coPpick R \as pr, idp : coPpick R = pr, h' : (\case pr \with {
            | just q => just (xI q)
            | nothing => nothing
          }) = just p \with {
            | just q, hq, h'' =>
              \let
                | p_eq : p = xI q => pmap (\case __ \with { | just z => z | nothing => xI q }) (inv h'')
                | q_in_R : coPIn q R => coPpick_sound R q hq
              \in transport (\lam z => coPIn z (coPNode false L R)) (inv p_eq) q_in_R
            | nothing, _, h'' => \case (pmap (\case __ \with { | just _ => false | nothing => true }) h'') \with {}
          }
    }

-- Completeness for the unary witness: if there's *any* element of X, coPpick X is `just _`.
\func coPpick_nonempty (X : coPset) (p : Pos) (h : coPIn p X)
  : \Sigma (q : Pos) (coPpick X = just q) \elim X, p
  | coPLeaf false, p => \case h \with {}
  | coPLeaf true, p => (xH, idp)
  | coPNode true _ _, p => (xH, idp)
  | coPNode false L R, xH => \case h \with {}
  | coPNode false L R, xO p =>
    \let
      | rec => coPpick_nonempty L p h
    \in (xO rec.1, pick_node_left rec.1 L R rec.2)
  | coPNode false L R, xI p =>
    \let
      | rec => coPpick_nonempty R p h
    \in \case coPpick L \as pl, idp : coPpick L = pl \with {
      | just q, hq => (xO q, pick_node_left q L R hq)
      | nothing, hq => (xI rec.1, pick_node_right_only rec.1 L R hq rec.2)
    }
  \where {
    -- If `coPpick L = just q`, then `coPpick (coPNode false L R) = just (xO q)`.
    \func pick_node_left (q : Pos) (L R : coPset) (hq : coPpick L = just q)
      : coPpick (coPNode false L R) = just (xO q) =>
      pmap (\lam pl => \case pl \with {
        | just r => just (xO r)
        | nothing => \case coPpick R \with {
            | just r => just (xI r)
            | nothing => nothing
          }
      }) hq

    -- If `coPpick L = nothing` and `coPpick R = just q`, then
    -- `coPpick (coPNode false L R) = just (xI q)`.
    \func pick_node_right_only (q : Pos) (L R : coPset)
                                (hL : coPpick L = nothing) (hR : coPpick R = just q)
      : coPpick (coPNode false L R) = just (xI q) =>
      pmap (\lam pl => \case pl \with {
        | just r => just (xO r)
        | nothing => \case coPpick R \with {
            | just r => just (xI r)
            | nothing => nothing
          }
      }) hL
      *>
      pmap (\lam pr => \case pr \with {
        | just r => just (xI r)
        | nothing => nothing
      }) hR
  }
