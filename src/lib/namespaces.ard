\import Data.Bool
\import Data.List
\import Data.Maybe
\import Logic
\import Logic.Meta
\import Paths
\import Set
\import Arith.Nat
\import Order.PartialOrder
\import lib.pmap
\import lib.coPset
\import lib.gset_cmra
\import lib.finite_coPset

\func false_neq_true {A : \Type} (h : false = true) : A => absurd (true/=false (inv h))

-- =================================================================================
-- Plan A, §A10: Namespaces.
--
-- Mirrors stdpp's `namespaces.v` and the namespace-API used by Iris/Rocq's
-- `base_logic/lib/invariants.v` (`nclose_subseteq`, `nclose_infinite`,
-- `fresh_inv_name`, `ndisjoint`).
--
--   namespace := list positive
--   nroot     := nil
--   ndot N p  := p :: N           (newest segment at head, as in stdpp)
--   nclose N  := coPset_suffixes (positives_flatten N)
--
-- The bit-layout of `positives_flatten` differs in detail from stdpp's — we
-- use a 1-1 prefix-free encoding (each segment's bits are duplicated, with
-- `xI xH` as a separator marker).  All downstream proofs only care about the
-- *abstract* properties (`subseteq`, `infinite`, segment-disjointness), so
-- this choice is invisible from outside.
-- =================================================================================

-- =================================================================================
-- Pos-concatenation: write `p` at the low (xH) end of `acc`.
--
--   pos_concat xH      acc = acc
--   pos_concat (xO p') acc = xO (pos_concat p' acc)
--   pos_concat (xI p') acc = xI (pos_concat p' acc)
--
-- The result has `p`'s bits at the LSB end and `acc`'s bits at the MSB end.
-- Equivalently: it appends `acc` to the MSB-side of `p`.
-- =================================================================================

\func pos_concat (p acc : Pos) : Pos \elim p
  | xH => acc
  | xO p' => xO (pos_concat p' acc)
  | xI p' => xI (pos_concat p' acc)

\lemma pos_concat_xH (acc : Pos) : pos_concat xH acc = acc => idp

-- =================================================================================
-- Namespace, nroot, ndot
-- =================================================================================

\func Namespace : \Set => List Pos

\func nroot : Namespace => nil

\func ndot (N : Namespace) (p : Pos) : Namespace => p :: N

-- =================================================================================
-- positives_flatten: encode a Namespace as a single Pos.
--
-- For each segment we duplicate every bit (`xO ↦ xO . xO`, `xI ↦ xI . xI`),
-- then insert `xI . xO` as an end-of-segment marker before the rest of the
-- encoded tail.  Because the bit-doubling never produces an `xI . xO` pair
-- within a single segment, segment boundaries are unambiguous in the result.
--
-- Older segments live at the LSB end so that `suffix-matches` propagates the
-- right way under `nclose_subseteq`: extending a namespace appends new bits
-- at the *high* end, which keeps the LSB pattern of the shorter encoding as
-- a prefix of the LSB pattern of the longer one.
-- =================================================================================

\func segment_encode (p : Pos) : Pos \elim p
  | xH => xI (xO xH)
  | xO p' => xO (xO (segment_encode p'))
  | xI p' => xI (xI (segment_encode p'))

\func positives_flatten (N : Namespace) : Pos \elim N
  | nil => xH
  | :: p N' => pos_concat (positives_flatten N') (segment_encode p)

-- =================================================================================
-- coPset_suffixes: positives whose low-bit prefix matches `p`.
--
-- Walking from the root (xH) along the bits of `p`, descend the coPset tree
-- accordingly; the surviving subtree is `coPLeaf true` (universe), since
-- after `p`'s bits any continuation is allowed.
-- =================================================================================

\func coPset_suffixes (p : Pos) : coPset \elim p
  | xH => coPset_universe
  | xO p' => coPNode false (coPset_suffixes p') coPset_empty
  | xI p' => coPNode false coPset_empty (coPset_suffixes p')

\func nclose (N : Namespace) : coPset =>
  coPset_suffixes (positives_flatten N)

\lemma nclose_nroot : nclose nroot = coPset_universe => idp

-- =================================================================================
-- Lemma: `coPset_suffixes` semantics — `q ∈ suffixes p` iff `p` is the low
-- prefix of `q`, i.e. `q = pos_concat p r` for some `r`.
--
-- The forward direction (membership ⇒ split) and backward direction
-- (split ⇒ membership) are both used in the subseteq proof below.
-- =================================================================================

\lemma coPmem_suffixes_concat (p r : Pos) :
  coPIn (pos_concat p r) (coPset_suffixes p) \elim p
  | xH => coPmem_universe r
  | xO p' => coPmem_suffixes_concat p' r
  | xI p' => coPmem_suffixes_concat p' r

-- =================================================================================
-- Subseteq: extending a namespace can only shrink the set.
--
-- Concretely: if `coPmem q (suffixes (pos_concat p1 p2)) = true`, i.e. q has
-- (p1 . p2) as low-bit prefix, then q also has p2 as low-bit prefix in some
-- shifted sense — but the clean statement is at the namespace level:
--   nclose (p :: N) ⊆ nclose N.
-- =================================================================================

\lemma suffixes_subseteq_concat (acc p : Pos) (q : Pos)
  (h : coPmem q (coPset_suffixes (pos_concat acc p)) = true) :
  coPmem q (coPset_suffixes acc) = true \elim acc, q
  | xH, q => coPmem_universe q
  | xO acc', xH => false_neq_true h
  | xO acc', xO q' => suffixes_subseteq_concat acc' p q' h
  | xO acc', xI q' => false_neq_true h
  | xI acc', xH => false_neq_true h
  | xI acc', xO q' => false_neq_true h
  | xI acc', xI q' => suffixes_subseteq_concat acc' p q' h

\lemma nclose_subseteq (p : Pos) (N : Namespace) :
  coPSubset (nclose (p :: N)) (nclose N) =>
  \lam q h =>
    suffixes_subseteq_concat (positives_flatten N) (segment_encode p) q h

-- =================================================================================
-- Growth: every `coPset_suffixes p` is closed under doubling the high bits.
-- This will give infinity: from one element of `nclose N`, we generate
-- infinitely many distinct extensions.
-- =================================================================================

\lemma coPmem_suffixes_xO (p q : Pos)
  (h : coPmem q (coPset_suffixes p) = true) :
  coPmem (pos_concat q (xO xH)) (coPset_suffixes p) = true \elim p, q
  | xH, q => coPmem_universe (pos_concat q (xO xH))
  | xO p', xH => false_neq_true h
  | xO p', xO q' => coPmem_suffixes_xO p' q' h
  | xO p', xI q' => false_neq_true h
  | xI p', xH => false_neq_true h
  | xI p', xO q' => false_neq_true h
  | xI p', xI q' => coPmem_suffixes_xO p' q' h

-- =================================================================================
-- Non-emptiness: every namespace closure contains the "anchor"
-- `positives_flatten N` itself.  Used by `nclose_inhabited` and as the
-- base case of the infinity argument.
-- =================================================================================

\lemma nclose_anchor (N : Namespace) : coPIn (positives_flatten N) (nclose N) =>
  transport (\lam q => coPIn q (coPset_suffixes (positives_flatten N)))
    (pos_concat_p_xH (positives_flatten N))
    (coPmem_suffixes_concat (positives_flatten N) xH)
  \where {
    \func pos_concat_p_xH (p : Pos) : pos_concat p xH = p \elim p
      | xH => idp
      | xO p' => pmap xO (pos_concat_p_xH p')
      | xI p' => pmap xI (pos_concat_p_xH p')
  }

\lemma nclose_inhabited (N : Namespace) :
  ∃ (q : Pos) (coPIn q (nclose N)) =>
  inP (positives_flatten N, nclose_anchor N)

-- =================================================================================
-- Infinity and fresh names.
-- =================================================================================

\lemma pos_concat_len_r (p acc : Pos)
  : pos_len acc <= pos_len (pos_concat p acc) \elim p
  | xH => NatSemiring.<=-refl
  | xO p' => (NatSemiring.<=∘) (pos_concat_len_r p' acc)
      (namespace_n_le_suc (pos_len (pos_concat p' acc)))
  | xI p' => (NatSemiring.<=∘) (pos_concat_len_r p' acc)
      (namespace_n_le_suc (pos_len (pos_concat p' acc)))
  \where {
    \lemma namespace_n_le_suc (n : Nat) : n <= suc n \elim n
      | 0 => zero<=_
      | suc n => suc<=suc (namespace_n_le_suc n)
  }

\func nclose_infinite (N : Namespace) : coPsetInfinite (nclose N) =>
  \lam E =>
    \let
      | d => pmap_depth' E.tree
      | suffix => pos_pad d
      | q => pos_concat (positives_flatten N) suffix
      | hlen : suc d <= pos_len q =>
          transport (\lam k => k <= pos_len q) (pos_pad_len d)
            (pos_concat_len_r (positives_flatten N) suffix)
      | hfresh : plookup E q = nothing =>
          plookup'_beyond_depth E.tree q hlen
      | hnot : Not (gset_in q E) => \lam hin =>
          \case (inv hin *> hfresh) \with {}
    \in (q, coPmem_suffixes_concat (positives_flatten N) suffix, hnot)

\func nclose_non_empty (N : Namespace)
  : \Sigma (q : Pos) (coPIn q (nclose N)) =>
  (positives_flatten N, nclose_anchor N)

\func fresh_inv_name (E : Gset) (N : Namespace)
  : \Sigma (i : Pos) (Not (gset_in i E)) (coPIn i (nclose N)) =>
  \let
    | D => coPset_difference (nclose N) (gsetToCoPset E)
    | (q, hqD) => coPsetInfinite_difference_nonempty
        (nclose N) (nclose_infinite N) E
    | (i, hpick) => coPpick_nonempty D q hqD
    | hiD : coPIn i D => coPpick_sound D i hpick
    | (hiN, hiE) => coPset_difference_in_inv i (nclose N)
        (gsetToCoPset E) hiD
    | hnot : Not (gset_in i E) => \lam hin =>
        \case (inv (gsetToCoPset_in i E hin) *> hiE) \with {}
  \in (i, hnot, hiN)

-- =================================================================================
-- ndot is what stdpp writes as `N .@ x`.  In our minimal version we hard-code
-- the segment to be a `Pos` rather than `∀ A `{Countable A}, A`.
-- =================================================================================

\lemma nclose_ndot_subseteq (N : Namespace) (p : Pos) :
  coPSubset (nclose (ndot N p)) (nclose N) =>
  nclose_subseteq p N

\lemma nclose_subseteq' (E : coPset) (N : Namespace) (p : Pos)
    (h : coPSubset (nclose N) E)
  : coPSubset (nclose (ndot N p)) E =>
  \lam q hq => h q (nclose_ndot_subseteq N p q hq)

-- =================================================================================
-- Segment disjointness (`ndisjoint`).
--
-- Step 1: the "no shared prefix" base case `lemma_disjoint_segs`.  Given a
-- positive `q` that is supposed to lie in *both* `↑(segment_encode p1)` and
-- `↑(segment_encode p2)` with `p1 ≠ p2`, we case-split on `(p1, p2, q)` and
-- show that every cell is excluded by the coPset routing.  Whenever
-- `segment_encode p1` and `segment_encode p2` disagree at a bit position
-- `b`, one of the two tree paths routes through a left subtree and the
-- other through a right subtree at depth `b`, and one of the two children
-- is `coPset_empty`.
--
-- Step 2: lift `lemma_disjoint_segs` over the shared prefix `acc` (= the
-- common `positives_flatten N`).  Induction on `acc` and `q` strips the
-- shared bits one at a time until step 1 applies.
-- =================================================================================

\lemma lemma_disjoint_segs (p1 p2 : Pos) (hne : p1 = p2 -> Empty) (q : Pos)
  (h1 : coPmem q (coPset_suffixes (segment_encode p1)) = true)
  (h2 : coPmem q (coPset_suffixes (segment_encode p2)) = true)
  : Empty \elim p1, p2, q
  | xH, xH, _ => hne idp
  | xH, xO _, xH => false_neq_true h1
  | xH, xO _, xO _ => false_neq_true h1
  | xH, xO _, xI _ => false_neq_true h2
  | xH, xI _, xH => false_neq_true h1
  | xH, xI _, xO _ => false_neq_true h1
  | xH, xI _, xI xH => false_neq_true h1
  | xH, xI _, xI (xO _) => false_neq_true h2
  | xH, xI _, xI (xI _) => false_neq_true h1
  | xO _, xH, xH => false_neq_true h1
  | xO _, xH, xO _ => false_neq_true h2
  | xO _, xH, xI _ => false_neq_true h1
  | xO _, xO _, xH => false_neq_true h1
  | xO _, xO _, xO xH => false_neq_true h1
  | xO p1', xO p2', xO (xO q'') =>
      lemma_disjoint_segs p1' p2' (\lam e => hne (pmap xO e)) q'' h1 h2
  | xO _, xO _, xO (xI _) => false_neq_true h1
  | xO _, xO _, xI _ => false_neq_true h1
  | xO _, xI _, xH => false_neq_true h1
  | xO _, xI _, xO _ => false_neq_true h2
  | xO _, xI _, xI _ => false_neq_true h1
  | xI _, xH, xH => false_neq_true h1
  | xI _, xH, xO _ => false_neq_true h1
  | xI _, xH, xI xH => false_neq_true h1
  | xI _, xH, xI (xO _) => false_neq_true h1
  | xI _, xH, xI (xI _) => false_neq_true h2
  | xI _, xO _, xH => false_neq_true h1
  | xI _, xO _, xO _ => false_neq_true h1
  | xI _, xO _, xI _ => false_neq_true h2
  | xI _, xI _, xH => false_neq_true h1
  | xI _, xI _, xO _ => false_neq_true h1
  | xI _, xI _, xI xH => false_neq_true h1
  | xI _, xI _, xI (xO _) => false_neq_true h1
  | xI p1', xI p2', xI (xI q'') =>
      lemma_disjoint_segs p1' p2' (\lam e => hne (pmap xI e)) q'' h1 h2

\lemma lemma_disjoint_segs_acc (acc : Pos) (p1 p2 : Pos)
                               (hne : p1 = p2 -> Empty) (q : Pos)
  (h1 : coPmem q (coPset_suffixes (pos_concat acc (segment_encode p1))) = true)
  (h2 : coPmem q (coPset_suffixes (pos_concat acc (segment_encode p2))) = true)
  : Empty \elim acc, q
  | xH, q => lemma_disjoint_segs p1 p2 hne q h1 h2
  | xO _, xH => false_neq_true h1
  | xO acc', xO q' => lemma_disjoint_segs_acc acc' p1 p2 hne q' h1 h2
  | xO _, xI _ => false_neq_true h1
  | xI _, xH => false_neq_true h1
  | xI _, xO _ => false_neq_true h1
  | xI acc', xI q' => lemma_disjoint_segs_acc acc' p1 p2 hne q' h1 h2

\func nclose_ndot_disjoint (N : Namespace) (p1 p2 : Pos)
                           (hne : p1 = p2 -> Empty) :
  coPDisjoint (nclose (ndot N p1)) (nclose (ndot N p2)) =>
  \lam q h1 =>
    \case coPmem q (nclose (ndot N p2)) \as b, idp : coPmem q (nclose (ndot N p2)) = b \with {
      | true, h2 =>
          absurd (lemma_disjoint_segs_acc (positives_flatten N) p1 p2 hne q h1 h2)
      | false, h2 => h2
    }

\func ndisjoint (N1 N2 : Namespace) : \Prop =>
  coPDisjoint (nclose N1) (nclose N2)

\func ndisjoint_implies_disjoint (N1 N2 : Namespace)
    (h : ndisjoint N1 N2)
  : coPDisjoint (nclose N1) (nclose N2) => h

\func ndot_ne_disjoint (N : Namespace) (p1 p2 : Pos)
    (hne : p1 = p2 -> Empty)
  : ndisjoint (ndot N p1) (ndot N p2) =>
  nclose_ndot_disjoint N p1 p2 hne

\func ndot_preserve_disjoint_l (N : Namespace) (E : coPset) (p : Pos)
    (h : coPDisjoint (nclose N) E)
  : coPDisjoint (nclose (ndot N p)) E =>
  \lam q hq => h q (nclose_ndot_subseteq N p q hq)

\func ndot_preserve_disjoint_r (N : Namespace) (E : coPset) (p : Pos)
    (h : coPDisjoint E (nclose N))
  : coPDisjoint E (nclose (ndot N p)) =>
  \lam q hq =>
    \case coPmem q (nclose (ndot N p)) \as b, idp
      : coPmem q (nclose (ndot N p)) = b
      \return b = false \with {
        | false, _ => idp
        | true, e => false_neq_true
            (inv (h q hq) *> nclose_ndot_subseteq N p q e)
      }
