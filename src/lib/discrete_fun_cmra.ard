\import Logic
\import Logic.Meta
\import Set
\import Paths
\import Data.Maybe
\import Arith.Nat
\import cmra
\import ofe
\import lib.gFunctors

-- =================================================================================
-- Dependent function space (`discrete_fun`) OFE / COFE / UCMRA + URFunctor.
--
-- Port of Rocq's `discrete_fun` structures: the OFE/COFE live in
-- `algebra/ofe.v`, the CMRA/UCMRA in `algebra/cmra.v` (Section
-- discrete_fun_cmra), and the functor `discrete_funURF` in `algebra/cmra.v`.
-- (`algebra/functions.v` — insert/singleton/updates — is ported separately
-- when A5 needs `discrete_fun_singleton`.)
--
-- Everything is pointwise.  Two spots deserve comment:
--
--  * `cmra_pcore_mono` follows Rocq's choice-free trick: the inclusion witness
--    for `core f ≼ core g` is `core g` itself, justified pointwise via
--    `ucmra_core_mono` + `ucmra_core_dup` — this avoids extracting a witness
--    function from a family of truncated existentials.
--  * `cmra_extend` is direct because our `cmra_extend` returns a genuine
--    (non-truncated) Σ, so the components can be split pointwise.
-- =================================================================================

\func DiscreteFunOFE {I : \Set} (B : I -> OFE) : OFE \cowith
  | E => \Pi (i : I) -> (B i).E
  | dist => \lam n f g => \Pi (i : I) -> (B i).dist n (f i) (g i)
  | equiv => \lam f g => \Pi (i : I) -> (B i).equiv (f i) (g i)
  | equiv_refl => \lam f i => (B i).equiv_refl (f i)
  | equiv_sym => \lam f g h i => (B i).equiv_sym (f i) (g i) (h i)
  | equiv_trans => \lam f g h h1 h2 i => (B i).equiv_trans (f i) (g i) (h i) (h1 i) (h2 i)
  | ofe_equiv_dist => \lam f g => (
      \lam he n i => ((B i).ofe_equiv_dist (f i) (g i)).1 (he i) n,
      \lam hd i => ((B i).ofe_equiv_dist (f i) (g i)).2 (\lam n => hd n i))
  | ofe_dist_refl => \lam n f i => (B i).ofe_dist_refl n (f i)
  | ofe_dist_sym => \lam n f g h i => (B i).ofe_dist_sym n (f i) (g i) (h i)
  | ofe_dist_trans => \lam n f g h h1 h2 i =>
      (B i).ofe_dist_trans n (f i) (g i) (h i) (h1 i) (h2 i)
  | ofe_dist_le => \lam n m f g h le i => (B i).ofe_dist_le n m (f i) (g i) (h i) le

\func DiscreteFunCOFE {I : \Set} (B : I -> COFE) : COFE \cowith
  | OFE => DiscreteFunOFE (\lam i => B i)
  | compl => \lam c hc i =>
      (B i).compl (\lam n => c n i)
          (\new Chain { | chain_cauchy => \lam n m le => hc.chain_cauchy n m le i })
  | cofe_conv_compl => \lam c hc n i =>
      (B i).cofe_conv_compl (\lam k => c k i)
          (\new Chain { | chain_cauchy => \lam k l le => hc.chain_cauchy k l le i })
          n

\func DiscreteFunUCMRA {I : \Set} (B : I -> UCMRA) : UCMRA \cowith
  | OFE => DiscreteFunOFE (\lam i => B i)
  | op => \lam f g i => (B i).op (f i) (g i)
  | pcore => \lam f => just (\lam i => ucmra_core {B i} (f i))
  | valid => \lam f => \Pi (i : I) -> (B i).valid (f i)
  | validN => \lam n f => \Pi (i : I) -> (B i).validN n (f i)
  | unit => \lam i => (B i).unit

  | cmra_op_ne => \lam f n g1 g2 h i => (B i).cmra_op_ne (f i) n (g1 i) (g2 i) (h i)
  | cmra_op_ne_2 => \lam g n f1 f2 h i => (B i).cmra_op_ne_2 (g i) n (f1 i) (f2 i) (h i)

  | cmra_pcore_ne => \lam n f g cf hd hp =>
      ( \lam i => ucmra_core {B i} (g i)
      , idp
      , transport (\lam c => \Pi (i : I) -> (B i).dist n (c i) (ucmra_core {B i} (g i)))
            (discrete_fun_just_out hp)
            (\lam i => ucmra_core_ne {B i} n (f i) (g i) (hd i))
      )

  | cmra_validN_ne => \lam n f g h hv i => (B i).cmra_validN_ne n (f i) (g i) (h i) (hv i)

  | cmra_valid_validN => \lam f => (
      \lam hv n i => ((B i).cmra_valid_validN (f i)).1 (hv i) n,
      \lam h i => ((B i).cmra_valid_validN (f i)).2 (\lam n => h n i))

  | cmra_validN_le => \lam n m f hv le i => (B i).cmra_validN_le n m (f i) (hv i) le

  | cmra_assoc => \lam f g h i => (B i).cmra_assoc (f i) (g i) (h i)
  | cmra_comm => \lam f g i => (B i).cmra_comm (f i) (g i)

  | cmra_pcore_l => \lam f cf hp =>
      transport (\lam c => \Pi (i : I) -> (B i).equiv ((B i).op (c i) (f i)) (f i))
          (discrete_fun_just_out hp)
          (\lam i => ucmra_core_left_id (f i))

  | cmra_pcore_idemp => \lam f cf hp =>
      transport (\lam c => \Pi (i : I) -> (B i).equiv (ucmra_core {B i} (c i)) (c i))
          (discrete_fun_just_out hp)
          (\lam i => ucmra_core_idemp (f i))

  | cmra_pcore_mono => \lam f g cf h hp => \case h \with {
      | inP (z, hgz) => inP
          ( \lam i => ucmra_core {B i} (g i)
          , idp
          , inP
              ( \lam i => ucmra_core {B i} (g i)
              , transport
                    (\lam c => \Pi (i : I) ->
                        (B i).equiv (ucmra_core {B i} (g i))
                            ((B i).op (c i) (ucmra_core {B i} (g i))))
                    (discrete_fun_just_out hp)
                    (\lam i => discrete_fun_core_absorb {B i} (f i) (g i)
                        (inP (z i, hgz i)))
              )
          )
    }

  | cmra_validN_op_l => \lam n f g hv i => (B i).cmra_validN_op_l n (f i) (g i) (hv i)

  | cmra_extend => \lam n f g1 g2 hv hd =>
      \let FUN => \lam (i : I) => (B i).cmra_extend n (f i) (g1 i) (g2 i) (hv i) (hd i)
      \in ( \lam i => (FUN i).1
          , \lam i => (FUN i).2
          , \lam i => (FUN i).3
          , \lam i => (FUN i).4
          , \lam i => (FUN i).5
          )

  | ucmra_unit_valid => \lam i => (B i).ucmra_unit_valid
  | ucmra_unit_left_id => \lam f i => (B i).ucmra_unit_left_id (f i)
  | ucmra_pcore_unit => \lam i =>
      option_equiv_to_inner_equiv (pcore {B i} (B i).unit) (B i).unit (B i).unit
          (B i).ucmra_pcore_unit
  \where {
    -- Extract the underlying function equality from `just`-injectivity.
    \func discrete_fun_just_out {A : \Set} {a b : A} (h : just a = just b) : a = b =>
      pmap (\lam o => \case o \with { | just c => c | nothing => a }) h

    -- Pointwise step of the Rocq `core_mono` trick:
    -- from `f ≼ g` conclude `core g ≡ core f · core g`.
    \lemma discrete_fun_core_absorb {U : UCMRA} (x y : U.E)
                                    (h : incl {U} {\new Op U.E { | op => U.op }} x y)
      : U.equiv (ucmra_core y) (U.op (ucmra_core x) (ucmra_core y))
      => \case ucmra_core_mono x y h \with {
        | inP (w, hw) =>
          U.equiv_sym (U.op (ucmra_core x) (ucmra_core y)) (ucmra_core y)
              (U.equiv_trans (U.op (ucmra_core x) (ucmra_core y))
                  (U.op (ucmra_core x) (U.op (ucmra_core x) w))
                  (ucmra_core y)
                  (op_proper_l {U} hw)
                  (U.equiv_trans (U.op (ucmra_core x) (U.op (ucmra_core x) w))
                      (U.op (U.op (ucmra_core x) (ucmra_core x)) w)
                      (ucmra_core y)
                      (U.cmra_assoc (ucmra_core x) (ucmra_core x) w)
                      (U.equiv_trans (U.op (U.op (ucmra_core x) (ucmra_core x)) w)
                          (U.op (ucmra_core x) w)
                          (ucmra_core y)
                          (op_proper_r {U} (ucmra_core_dup x))
                          (U.equiv_sym (ucmra_core y) (U.op (ucmra_core x) w) hw))))
      }
  }

-- =================================================================================
-- discrete_funURF: lift a family of URFunctors pointwise.
--
-- Rocq (`algebra/cmra.v`):
--   Program Definition discrete_funURF {C} (F : C → urFunctor) : urFunctor := {|
--     urFunctor_car A _ B _ := discrete_funUR (λ c, urFunctor_car (F c) A B);
--     urFunctor_map A1 _ A2 _ B1 _ B2 _ fg :=
--       discrete_fun_map (λ c, urFunctor_map (F c) fg)
--   |}.
-- =================================================================================

\func discrete_funURF {I : \Set} (F : I -> URFunctor) : URFunctor \cowith
  | urFunctor_car => \lam A B => DiscreteFunUCMRA (\lam i => (F i).urFunctor_car A B)
  | urFunctor_map => \lam fg => \new OFEMor _ _ {
      | ofe_mor_car => \lam g i => ((F i).urFunctor_map fg).ofe_mor_car (g i)
      | ofe_mor_ne => \lam n g1 g2 h i =>
          ((F i).urFunctor_map fg).ofe_mor_ne n (g1 i) (g2 i) (h i)
    }
  | urFunctor_map_ne => \lam n fg fg' h g i => (F i).urFunctor_map_ne n fg fg' h (g i)
  | urFunctor_map_id => \lam g i => (F i).urFunctor_map_id (g i)
  | urFunctor_map_compose => \lam f g f' g' x i =>
      (F i).urFunctor_map_compose f g f' g' (x i)
  | urFunctor_mor => \lam fg => \new CmraMorphism _ {
      | cmra_morphism_validN => \lam n g hv i =>
          cmra_morphism_validN {(F i).urFunctor_mor fg} n (g i) (hv i)
      | cmra_morphism_pcore => \lam g i =>
          cmra_morphism_core ((F i).urFunctor_mor fg) (g i)
      | cmra_morphism_op => \lam g1 g2 i =>
          cmra_morphism_op {(F i).urFunctor_mor fg} (g1 i) (g2 i)
    }

\func discrete_funURF_contractive {I : \Set} (F : I -> URFunctor)
                                  (hF : \Pi (i : I) -> URFunctorContractive (F i))
  : URFunctorContractive (discrete_funURF F) \cowith
  | urFunctor_map_contractive => \lam n fg fg' h g i =>
      (hF i).urFunctor_map_contractive n fg fg' h (g i)


-- =================================================================================
-- discrete_fun_insert / discrete_fun_singleton (port of `algebra/functions.v`).
--
-- All lemmas take the decision procedure `dec` explicitly (`gid Σ = Fin n`
-- supplies `fin_eq_dec`).  Points other than the inserted one hold the unit,
-- so the family must be UCMRA-valued — same restriction as Rocq's
-- `discrete_fun_singleton`.
-- =================================================================================

\func discrete_fun_insert {I : \Set} (dec : \Pi (x y : I) -> Dec (x = y))
                          {B : I -> UCMRA} (x : I) (y : (B x).E)
                          (f : \Pi (i : I) -> (B i).E) : \Pi (i : I) -> (B i).E =>
  \lam i => \case dec x i \with {
    | yes p => transport (\lam j => (B j).E) p y
    | no _ => f i
  }

\func discrete_fun_singleton {I : \Set} (dec : \Pi (x y : I) -> Dec (x = y))
                             {B : I -> UCMRA} (x : I) (y : (B x).E)
  : \Pi (i : I) -> (B i).E =>
  discrete_fun_insert dec x y (\lam i => (B i).unit)

\lemma discrete_fun_lookup_insert {I : \Set} (dec : \Pi (x y : I) -> Dec (x = y))
                                  {B : I -> UCMRA} (x : I) (y : (B x).E)
                                  (f : \Pi (i : I) -> (B i).E)
  : discrete_fun_insert dec x y f x = y
  => \case dec x x \as d
     \return (\case d \with {
       | yes p => transport (\lam j => (B j).E) p y
       | no _ => f x
     }) = y
     \with {
       | yes p => pmap (\lam q => transport (\lam j => (B j).E) q y) (prop-pi {x = x} {p} {idp})
       | no np => absurd (np idp)
     }

\lemma discrete_fun_lookup_insert_ne {I : \Set} (dec : \Pi (x y : I) -> Dec (x = y))
                                     {B : I -> UCMRA} (x : I) (y : (B x).E)
                                     (f : \Pi (i : I) -> (B i).E)
                                     (i : I) (hne : Not (x = i))
  : discrete_fun_insert dec x y f i = f i
  => \case dec x i \as d
     \return (\case d \with {
       | yes p => transport (\lam j => (B j).E) p y
       | no _ => f i
     }) = f i
     \with {
       | yes p => absurd (hne p)
       | no _ => idp
     }

\lemma discrete_fun_lookup_singleton {I : \Set} (dec : \Pi (x y : I) -> Dec (x = y))
                                     {B : I -> UCMRA} (x : I) (y : (B x).E)
  : discrete_fun_singleton dec x y x = y
  => discrete_fun_lookup_insert dec x y (\lam i => (B i).unit)

\lemma discrete_fun_lookup_singleton_ne {I : \Set} (dec : \Pi (x y : I) -> Dec (x = y))
                                        {B : I -> UCMRA} (x : I) (y : (B x).E)
                                        (i : I) (hne : Not (x = i))
  : discrete_fun_singleton dec x y i = (B i).unit
  => discrete_fun_lookup_insert_ne dec x y (\lam j => (B j).unit) i hne

-- Transport helpers, all by path elimination.
\lemma dfun_transport_dist {I : \Set} {B : I -> UCMRA} {x i : I} (p : x = i)
                           (n : Nat) (y1 y2 : (B x).E) (h : (B x).dist n y1 y2)
  : (B i).dist n (transport (\lam j => (B j).E) p y1)
                 (transport (\lam j => (B j).E) p y2) \elim p
  | idp => h

\lemma dfun_transport_op_equiv {I : \Set} {B : I -> UCMRA} {x i : I} (p : x = i)
                               (y1 y2 : (B x).E)
  : (B i).equiv (transport (\lam j => (B j).E) p ((B x).op y1 y2))
                ((B i).op (transport (\lam j => (B j).E) p y1)
                          (transport (\lam j => (B j).E) p y2)) \elim p
  | idp => (B x).equiv_refl ((B x).op y1 y2)

\lemma dfun_transport_validN {I : \Set} {B : I -> UCMRA} {x i : I} (p : x = i)
                             (n : Nat) (y : (B x).E) (h : (B x).validN n y)
  : (B i).validN n (transport (\lam j => (B j).E) p y) \elim p
  | idp => h

\lemma dfun_transport_op_validN {I : \Set} {B : I -> UCMRA} {x i : I} (p : x = i)
                                (n : Nat) (y : (B x).E)
                                (g : \Pi (j : I) -> (B j).E)
                                (h : (B x).validN n ((B x).op y (g x)))
  : (B i).validN n ((B i).op (transport (\lam j => (B j).E) p y) (g i)) \elim p
  | idp => h

-- Non-expansiveness of the singleton in its value.
\lemma discrete_fun_singleton_ne {I : \Set} (dec : \Pi (x y : I) -> Dec (x = y))
                                 {B : I -> UCMRA} (x : I) (n : Nat)
                                 (y1 y2 : (B x).E) (h : (B x).dist n y1 y2)
  : (DiscreteFunUCMRA B).dist n (discrete_fun_singleton dec x y1)
                                (discrete_fun_singleton dec x y2)
  => \lam i => \case dec x i \as d
     \return (B i).dist n
       (\case d \with {
         | yes p => transport (\lam j => (B j).E) p y1
         | no _ => (B i).unit
       })
       (\case d \with {
         | yes p => transport (\lam j => (B j).E) p y2
         | no _ => (B i).unit
       })
     \with {
       | yes p => dfun_transport_dist p n y1 y2 h
       | no _ => (B i).ofe_dist_refl n (B i).unit
     }

-- `singleton x (y1 ⋅ y2) ≡ singleton x y1 ⋅ singleton x y2`.
\lemma discrete_fun_singleton_op {I : \Set} (dec : \Pi (x y : I) -> Dec (x = y))
                                 {B : I -> UCMRA} (x : I) (y1 y2 : (B x).E)
  : (DiscreteFunUCMRA B).equiv
      (discrete_fun_singleton dec x ((B x).op y1 y2))
      ((DiscreteFunUCMRA B).op (discrete_fun_singleton dec x y1)
                               (discrete_fun_singleton dec x y2))
  => \lam i => \case dec x i \as d
     \return (B i).equiv
       (\case d \with {
         | yes p => transport (\lam j => (B j).E) p ((B x).op y1 y2)
         | no _ => (B i).unit
       })
       ((B i).op
         (\case d \with {
           | yes p => transport (\lam j => (B j).E) p y1
           | no _ => (B i).unit
         })
         (\case d \with {
           | yes p => transport (\lam j => (B j).E) p y2
           | no _ => (B i).unit
         }))
     \with {
       | yes p => dfun_transport_op_equiv p y1 y2
       | no _ => (B i).equiv_sym ((B i).op (B i).unit (B i).unit) (B i).unit
           ((B i).ucmra_unit_left_id (B i).unit)
     }

-- Validity of a singleton is validity of its value.
\lemma discrete_fun_singleton_validN_1 {I : \Set} (dec : \Pi (x y : I) -> Dec (x = y))
                                       {B : I -> UCMRA} (x : I) (n : Nat) (y : (B x).E)
                                       (hv : (DiscreteFunUCMRA B).validN n
                                               (discrete_fun_singleton dec x y))
  : (B x).validN n y
  => transport ((B x).validN n) (discrete_fun_lookup_singleton dec x y) (hv x)

\lemma discrete_fun_singleton_validN_2 {I : \Set} (dec : \Pi (x y : I) -> Dec (x = y))
                                       {B : I -> UCMRA} (x : I) (n : Nat) (y : (B x).E)
                                       (hv : (B x).validN n y)
  : (DiscreteFunUCMRA B).validN n (discrete_fun_singleton dec x y)
  => \lam i => \case dec x i \as d
     \return (B i).validN n (\case d \with {
       | yes p => transport (\lam j => (B j).E) p y
       | no _ => (B i).unit
     })
     \with {
       | yes p => dfun_transport_validN p n y hv
       | no _ => ((B i).cmra_valid_validN (B i).unit).1 (B i).ucmra_unit_valid n
     }

-- =================================================================================
-- Frame-preserving updates through a singleton (Rocq
-- `discrete_fun_singleton_updateP` / `_updateP_empty`).
-- =================================================================================

\lemma discrete_fun_singleton_updateP {I : \Set} (dec : \Pi (x y : I) -> Dec (x = y))
    {B : I -> UCMRA} (x : I) (y : (B x).E) (P : (B x).E -> \Prop)
    (h : cmra_updateP {B x} y P)
  : cmra_updateP {DiscreteFunUCMRA B} (discrete_fun_singleton dec x y)
      (\lam g => TruncP (\Sigma (y' : (B x).E)
          (g = discrete_fun_singleton dec x y') (P y')))
  => \lam n gf hv =>
      \let hvx : (B x).validN n ((B x).op y (gf x)) =>
        \case dec x x \as d,
              hv x : (B x).validN n ((B x).op (\case d \with {
                | yes p => transport (\lam j => (B j).E) p y
                | no _ => (B x).unit
              }) (gf x))
        \return (B x).validN n ((B x).op y (gf x))
        \with {
          | yes p, hvx' =>
            transport (\lam v => (B x).validN n ((B x).op v (gf x)))
                (pmap (\lam q => transport (\lam j => (B j).E) q y) (prop-pi {x = x} {p} {idp}))
                hvx'
          | no np, _ => absurd (np idp)
        }
      \in \case h n (gf x) hvx \with {
        | inP (y', hp, hvy') => inP
            ( discrete_fun_singleton dec x y'
            , inP (y', idp, hp)
            , \lam i => \case dec x i \as d,
                  hv i : (B i).validN n ((B i).op (\case d \with {
                    | yes p => transport (\lam j => (B j).E) p y
                    | no _ => (B i).unit
                  }) (gf i))
              \return (B i).validN n ((B i).op (\case d \with {
                | yes p => transport (\lam j => (B j).E) p y'
                | no _ => (B i).unit
              }) (gf i))
              \with {
                | yes p, _ => dfun_transport_op_validN p n y' gf hvy'
                | no _, hvi => hvi
              }
            )
      }

\lemma discrete_fun_singleton_updateP_empty {I : \Set} (dec : \Pi (x y : I) -> Dec (x = y))
    {B : I -> UCMRA} (x : I) (P : (B x).E -> \Prop)
    (h : cmra_updateP {B x} (B x).unit P)
  : cmra_updateP {DiscreteFunUCMRA B} (DiscreteFunUCMRA B).unit
      (\lam g => TruncP (\Sigma (y' : (B x).E)
          (g = discrete_fun_singleton dec x y') (P y')))
  => \lam n gf hv =>
      \case h n (gf x) (hv x) \with {
        | inP (y', hp, hvy') => inP
            ( discrete_fun_singleton dec x y'
            , inP (y', idp, hp)
            , \lam i => \case dec x i \as d
              \return (B i).validN n ((B i).op (\case d \with {
                | yes p => transport (\lam j => (B j).E) p y'
                | no _ => (B i).unit
              }) (gf i))
              \with {
                | yes p => dfun_transport_op_validN p n y' gf hvy'
                | no _ => hv i
              }
            )
      }
