\import Logic
\import Logic.Classical
\import Logic.Meta
\import Paths
\import Paths.Meta
\import Set
\import Data.Maybe
\import Data.List
\import Arith.Nat
\import Order.PartialOrder
\import cmra
\import ofe
\import lib.pmap
\import lib.excl_cmra

-- =================================================================================
-- Countability
-- =================================================================================


\class EqDecision (A : \Set)
  | decideEq (x y : A) : Dec (x = y)

\class Countable \extends EqDecision
  | encode : A -> Pos
  | decode : Pos -> Maybe A
  | decode_encode (x : A) : decode (encode x) = just x
  | encode_inj (x y : A) : encode x = encode y -> x = y


-- =================================================================================
-- Option CMRA
-- =================================================================================


\func option_op {A : CMRA} (o1 o2 : Maybe A.E) : Maybe A.E \elim o1, o2
  | just a1, just a2 => just (A.op a1 a2)
  | just a1, nothing => just a1
  | nothing, just a2 => just a2
  | nothing, nothing => nothing

\func option_op_nothing_nothing {A : CMRA} : option_op {A} nothing nothing = nothing => idp

\func option_pcore {A : CMRA} (o : Maybe A.E) : Maybe A.E \elim o
  | nothing => nothing
  | just a => pcore {A} a

\func option_valid {A : CMRA} (o : Maybe A.E) : \Prop \elim o
  | nothing => \Sigma
  | just a  => valid {A} a

\func option_validN {A : CMRA} (n : Nat) (o : Maybe A.E) : \Prop \elim o
  | nothing => \Sigma
  | just a  => validN {A} n a

\lemma option_op_ne {A : CMRA} (n : Nat) (o : Maybe A.E) (o1 o2 : Maybe A.E)
                    (h : (OptionOFE A).dist n o1 o2)
  : (OptionOFE A).dist n (option_op {A} o o1) (option_op {A} o o2)
  => \case \elim o, \elim o1, \elim o2, h \with {
    | nothing,  nothing,  nothing,  _ => ()
    | nothing,  just _,   just _,   h => h
    | just a,   nothing,  nothing,  _ => A.ofe_dist_refl n a
    | just a,   just a1,  just a2,  h => A.cmra_op_ne a n a1 a2 h
    | nothing,  nothing,  just _,   e => \case e \with {}
    | nothing,  just _,   nothing,  e => \case e \with {}
    | just _,   nothing,  just _,   e => \case e \with {}
    | just _,   just _,   nothing,  e => \case e \with {}
  }

\lemma option_op_ne_2 {A : CMRA} (n : Nat) (o : Maybe A.E) (o1 o2 : Maybe A.E)
                      (h : (OptionOFE A).dist n o1 o2)
  : (OptionOFE A).dist n (option_op {A} o1 o) (option_op {A} o2 o)
  => \case \elim o, \elim o1, \elim o2, h \with {
    | nothing,  nothing,  nothing,  _ => ()
    | just a,   nothing,  nothing,  _ => A.ofe_dist_refl n a
    | nothing,  just _,   just _,   h => h
    | just a,   just a1,  just a2,  h => A.cmra_op_ne_2 a n a1 a2 h
    | nothing,  nothing,  just _,   e => \case e \with {}
    | nothing,  just _,   nothing,  e => \case e \with {}
    | just _,   nothing,  just _,   e => \case e \with {}
    | just _,   just _,   nothing,  e => \case e \with {}
  }

\lemma option_op_assoc {A : CMRA} (o1 o2 o3 : Maybe A.E)
  : option_op {A} o1 (option_op {A} o2 o3) = option_op {A} (option_op {A} o1 o2) o3
  => \case \elim o1, \elim o2, \elim o3 \with {
    | nothing,  nothing,  nothing  => idp
    | nothing,  nothing,  just _   => idp
    | nothing,  just _,   nothing  => idp
    | nothing,  just _,   just _   => idp
    | just _,   nothing,  nothing  => idp
    | just _,   nothing,  just _   => idp
    | just _,   just _,   nothing  => idp
    | just a1,  just a2,  just a3  => pmap just (A.cmra_assoc a1 a2 a3)
  }

\lemma option_op_comm {A : CMRA} (o1 o2 : Maybe A.E)
  : option_op {A} o1 o2 = option_op {A} o2 o1
  => \case \elim o1, \elim o2 \with {
    | nothing,  nothing  => idp
    | nothing,  just _   => idp
    | just _,   nothing  => idp
    | just a1,  just a2  => pmap just (A.cmra_comm a1 a2)
  }

\lemma option_validN_op_l {A : CMRA} (n : Nat) (o1 o2 : Maybe A.E)
                          (h : option_validN {A} n (option_op {A} o1 o2))
  : option_validN {A} n o1
  => \case \elim o1, \elim o2, h \with {
    | nothing, _,         _ => ()
    | just _,  nothing,   h => h
    | just a1, just a2,   h => A.cmra_validN_op_l n a1 a2 h
  }

\lemma option_validN_ne {A : CMRA} (n : Nat) (o1 o2 : Maybe A.E)
                        (h : (OptionOFE A).dist n o1 o2)
                        (hv : option_validN {A} n o1)
  : option_validN {A} n o2
  => \case \elim o1, \elim o2, h, hv \with {
    | nothing, nothing, _, _   => ()
    | just a1, just a2, h, hv => A.cmra_validN_ne n a1 a2 h hv
    | nothing, just _,  e, _   => \case e \with {}
    | just _,  nothing, e, _   => \case e \with {}
  }

\lemma option_validN_le {A : CMRA} (n m : Nat) (o : Maybe A.E)
                        (hv : option_validN {A} n o) (le : m <= n)
  : option_validN {A} m o
  => \case \elim o, hv \with {
    | nothing, _  => ()
    | just a,  hv => A.cmra_validN_le n m a hv le
  }

\lemma option_pcore_ne {A : CMRA} (n : Nat) (o1 o2 : Maybe A.E)
                       (h : (OptionOFE A).dist n o1 o2)
  : (OptionOFE A).dist n (option_pcore {A} o1) (option_pcore {A} o2)
  => \case \elim o1, \elim o2, h \with {
    | nothing, nothing, _ => ()
    | just a1, just a2, h =>
      cmra_pcore_ne_dist {A} n a1 a2 h (pcore {A} a1) (pcore {A} a2) idp idp
    | nothing, just _,  e => \case e \with {}
    | just _,  nothing, e => \case e \with {}
  }

\lemma option_pcore_l {A : CMRA} (o : Maybe A.E)
  : option_op {A} (option_pcore {A} o) o = o
  => \case \elim o \with {
    | nothing => idp
    | just a =>
      \case pcore {A} a \as pa, idp : pcore {A} a = pa
      \return option_op {A} pa (just a) = just a
      \with {
        | nothing, _   => idp
        | just c,  hp => pmap just (A.cmra_pcore_l a c hp)
      }
  }

\lemma option_pcore_idemp {A : CMRA} (o : Maybe A.E)
  : option_pcore {A} (option_pcore {A} o) = option_pcore {A} o
  => \case \elim o \with {
    | nothing => idp
    | just a =>
      \case pcore {A} a \as pa, idp : pcore {A} a = pa
      \return option_pcore {A} pa = pa
      \with {
        | nothing, _  => idp
        | just c, hp => A.cmra_pcore_idemp a c hp
      }
  }

\lemma option_pcore_mono {A : CMRA} (o1 o2 : Maybe A.E)
                         (h : incl {Maybe A.E}
                             {\new BaseSet (Maybe A.E)}
                             {\new Op (Maybe A.E) { | op => option_op {A} }}
                             o1 o2)
  : ∃ (w : Maybe A.E)
(option_pcore {A} o2 = option_op {A} (option_pcore {A} o1) w)
  => \case \elim o1, \elim o2, h \with {
    | nothing, nothing, _ => inP (nothing, idp)
    | nothing, just a2, _ => inP (option_pcore {A} (just a2), option_pcore_nothing_l {A} (option_pcore {A} (just a2)))
    | just a1, nothing, inP (z, hz) =>
      \case \elim z, hz \with {
        | nothing, e => \case e \with {}
        | just _,  e => \case e \with {}
      }
    | just a1, just a2, inP (z, hz) =>
      \case pcore {A} a1 \as pc1, idp : pcore {A} a1 = pc1
      \return ∃ (w : Maybe A.E)
        (option_pcore {A} (just a2) = option_op {A} pc1 w)
      \with {
        | nothing, _ =>
          inP (option_pcore {A} (just a2),
               option_pcore_nothing_l {A} (option_pcore {A} (just a2)))
        | just c1, hp1 =>
          \case \elim z, hz \with {
            | nothing, e =>
              \let
                | ha : a1 = a2 => pmap (\lam (o : Maybe A.E) => \case o \with {
                  | just v => v | nothing => a1
                }) (inv e)
                | hp2 : pcore {A} a2 = just c1 =>
                  transport (\lam a => pcore {A} a = just c1) ha hp1
              \in inP (nothing, hp2)
            | just b, e =>
              \let
                | ha : a2 = A.op a1 b => pmap (\lam (o : Maybe A.E) => \case o \with {
                  | just v => v | nothing => a2
                }) e
                | hincl_A : incl {A.E} {\new BaseSet A.E} {\new Op A.E { | op => A.op }} a1 a2 =>
                  inP (b, ha)
              \in \case A.cmra_pcore_mono a1 a2 c1 hincl_A hp1 \with {
                | inP mono => \case mono.3 \with {
                  | inP (d, hd) =>
                    inP (just d,
                         mono.2 *> pmap just hd)
                }
              }
          }
      }
  }
  \where {
    \lemma option_pcore_nothing_l {A : CMRA} (o : Maybe A.E)
      : o = option_op {A} nothing o
      => \case \elim o \with {
        | nothing => idp
        | just _ => idp
      }
  }

\func option_extend {A : CMRA} (n : Nat) (o o1 o2 : Maybe A.E)
                     (hv : option_validN {A} n o)
                     (hd : (OptionOFE A).dist n o (option_op {A} o1 o2))
  : \Sigma (z1 z2 : Maybe A.E)
           (o = option_op {A} z1 z2)
           ((OptionOFE A).dist n z1 o1)
           ((OptionOFE A).dist n z2 o2)
  => \case \elim o, \elim o1, \elim o2, hv, hd \with {
    | nothing, nothing, nothing, _, _ =>
      (nothing, nothing, idp, (), ())
    | nothing, nothing, just _,  _, e => \case e \with {}
    | nothing, just _,  nothing, _, e => \case e \with {}
    | nothing, just _,  just _,  _, e => \case e \with {}
    | just a, nothing, nothing, _, e => \case e \with {}
    | just a, nothing, just _, _, d =>
      (nothing, just a, idp, (), d)
    | just a, just _, nothing, _, d =>
      (just a, nothing, idp, d, ())
    | just a, just b1, just b2, hv, d =>
      \let
        | split : \Sigma (c1 c2 : A.E) (a = A.op c1 c2)
                         (A.dist n c1 b1) (A.dist n c2 b2)
        => A.cmra_extend n a b1 b2 hv d
      \in (just split.1, just split.2,
           pmap just split.3,
           split.4, split.5)
  }


-- =================================================================================
-- Gmap
-- =================================================================================


\func gmap_wf {K : \Set} {cnt : Countable K} {A : \Set} (m : Pmap (\Sigma K A)) : \Prop =>
  \Pi (k : Pos) (p : \Sigma K A) -> plookup m k = just p -> encode {cnt} p.1 = k

\record Gmap (K : \Set) (cnt : Countable K) (A : \Set)
  | gtree : Pmap (\Sigma K A)
  | gtree_wf : gmap_wf {K} {cnt} {A} gtree

\func glookup {K : \Set} {cnt : Countable K} {A : \Set} (m : Gmap K cnt A) (k : K) : Maybe A =>
  \case plookup m.gtree (encode {cnt} k) \with {
    | nothing => nothing
    | just p  => just p.2
  }

\func gempty {K : \Set} {cnt : Countable K} {A : \Set} : Gmap K cnt A \cowith
  | gtree => pempty
  | gtree_wf => \lam k p hp =>
      absurd (\case transport (\lam o => o = just p) (plookup_empty k) hp \with {})

\lemma glookup_empty {K : \Set} {cnt : Countable K} {A : \Set} (k : K)
  : glookup {K} {cnt} {A} gempty k = nothing
  => path (\lam i => \case plookup_empty {\Sigma K A} (encode {cnt} k) @ i \with {
    | nothing => nothing
    | just p  => just p.2
  })

\func gpartial_alter {K : \Set} {cnt : Countable K} {A : \Set}
                     (f : Maybe A -> Maybe A) (k : K) (m : Gmap K cnt A) : Gmap K cnt A \cowith
  | gtree => ppartial_alter (gpartial_alter_lift f k) (encode {cnt} k) m.gtree
  | gtree_wf => gpartial_alter_wf f k m
  \where {
    \func gpartial_alter_lift {K A : \Set} (f : Maybe A -> Maybe A) (k : K)
                              (o : Maybe (\Sigma K A)) : Maybe (\Sigma K A) =>
      \case f (\case o \with { | nothing => nothing | just p => just p.2 }) \with {
        | nothing => nothing
        | just a  => just (k, a)
      }

    \func gpartial_alter_wf {K : \Set} {cnt : Countable K} {A : \Set}
                            (f : Maybe A -> Maybe A) (k : K) (m : Gmap K cnt A)
      : gmap_wf {K} {cnt} {A}
        (\new Pmap (\Sigma K A) {
          | tree => (ppartial_alter (gpartial_alter_lift f k) (encode {cnt} k) m.gtree).tree
          | tree_wf => (ppartial_alter (gpartial_alter_lift f k) (encode {cnt} k) m.gtree).tree_wf
        }) =>
      \lam q p hp =>
          \case Pos_eq_dec (encode {cnt} k) q \with {
            | yes ekq =>
              \let
                | step : plookup (ppartial_alter (gpartial_alter_lift f k) (encode {cnt} k) m.gtree)
                    (encode {cnt} k)
                  = gpartial_alter_lift f k (plookup m.gtree (encode {cnt} k))
                => plookup_partial_alter_eq (gpartial_alter_lift f k) (encode {cnt} k) m.gtree
                | step2 : plookup (ppartial_alter (gpartial_alter_lift f k) (encode {cnt} k) m.gtree) q
                  = gpartial_alter_lift f k (plookup m.gtree (encode {cnt} k))
                => transport (\lam q' => plookup (ppartial_alter (gpartial_alter_lift f k) (encode {cnt} k) m.gtree) q'
                    = gpartial_alter_lift f k (plookup m.gtree (encode {cnt} k))) ekq step
                | hp' : gpartial_alter_lift f k (plookup m.gtree (encode {cnt} k)) = just p
                => inv step2 *> hp
                | hk : p.1 = k => gpartial_alter_lift_fst f k (plookup m.gtree (encode {cnt} k)) p hp'
              \in transport (\lam k' => encode {cnt} k' = q) (inv hk) ekq
            | no ne =>
              \let
                | step : plookup (ppartial_alter (gpartial_alter_lift f k) (encode {cnt} k) m.gtree) q
                  = plookup m.gtree q
                => plookup_partial_alter_ne (gpartial_alter_lift f k) (encode {cnt} k) q m.gtree ne
                | hp' : plookup m.gtree q = just p => inv step *> hp
              \in m.gtree_wf q p hp'
          }

    \func gpartial_alter_lift_fst {K A : \Set} (f : Maybe A -> Maybe A) (k : K)
                                  (o : Maybe (\Sigma K A)) (p : \Sigma K A)
                                  (h : gpartial_alter_lift f k o = just p)
      : p.1 = k =>
      \case f (\case o \with { | nothing => nothing | just p' => just p'.2 }) \as fr,
            idp : f (\case o \with { | nothing => nothing | just p' => just p'.2 }) = fr,
            h : (\case fr \with { | nothing => nothing | just a => just (k, a) }) = just p
      \return p.1 = k
      \with {
        | nothing, _, e => \case e \with {}
        | just a, _, e =>
          inv (pmap (\lam mp => \case mp \with {
            | nothing => k
            | just p' => p'.1
          }) e)
      }
  }

\func glookup_partial_alter_eq_aux {K A : \Set} (f : Maybe A -> Maybe A) (k : K)
                                   (oA : Maybe A) (oP : Maybe (\Sigma K A))
                                   (heq : (\case oP \with {
                                     | nothing => nothing
                                     | just p => just p.2
                                   }) = oA)
  : (\case \case f (\case oP \with {
  | nothing => nothing
  | just p' => just p'.2
}) \return Maybe (\Sigma K A) \with {
  | nothing => nothing
  | just a  => just (k, a)
} \with {
  | nothing => nothing
  | just p  => just p.2
}) = f oA \elim oP
  | nothing =>
    \case f nothing \as fr,
          idp : f nothing = fr
    \return (\case \case fr \return Maybe (\Sigma K A) \with {
      | nothing => nothing
      | just a  => just (k, a)
    } \with {
      | nothing => nothing
      | just p  => just p.2
    }) = f oA
    \with {
      | nothing, hf => inv hf *> pmap f heq
      | just a,  hf => inv hf *> pmap f heq
    }
  | just p =>
    \case f (just p.2) \as fr,
          idp : f (just p.2) = fr
    \return (\case \case fr \return Maybe (\Sigma K A) \with {
      | nothing => nothing
      | just a  => just (k, a)
    } \with {
      | nothing => nothing
      | just p'  => just p'.2
    }) = f oA
    \with {
      | nothing, hf => inv hf *> pmap f heq
      | just a,  hf => inv hf *> pmap f heq
    }


-- =================================================================================
-- Insert / delete / singleton
-- =================================================================================

\func ginsert {K : \Set} {cnt : Countable K} {A : \Set} (k : K) (x : A) (m : Gmap K cnt A) : Gmap K cnt A =>
  gpartial_alter (\lam _ => just x) k m

\lemma glookup_partial_alter_eq {K : \Set} {cnt : Countable K} {A : \Set}
                                (f : Maybe A -> Maybe A) (k : K) (m : Gmap K cnt A)
  : glookup (gpartial_alter f k m) k = f (glookup m k)
  =>
    \let
      | oP : Maybe (\Sigma K A) => plookup m.gtree (encode {cnt} k)
      | step : plookup (gpartial_alter f k m).gtree (encode {cnt} k)
          = gpartial_alter.gpartial_alter_lift f k oP
        => plookup_partial_alter_eq
             (gpartial_alter.gpartial_alter_lift f k)
             (encode {cnt} k)
             m.gtree
      | unfold_lhs : glookup (gpartial_alter f k m) k =
          (\case plookup (gpartial_alter f k m).gtree (encode {cnt} k) \with {
            | nothing => nothing
            | just p => just p.2
          }) => idp
      | step_lookup :
          (\case plookup (gpartial_alter f k m).gtree (encode {cnt} k) \with {
            | nothing => nothing
            | just p => just p.2
          }) =
          (\case gpartial_alter.gpartial_alter_lift f k oP \with {
            | nothing => nothing
            | just p => just p.2
          }) =>
        pmap (\lam q => \case q \with {
          | nothing => nothing
          | just p => just p.2
        }) step
      | rhs_aux :
          (\case gpartial_alter.gpartial_alter_lift f k oP \with {
            | nothing => nothing
            | just p => just p.2
          }) = f (glookup m k) =>
        glookup_partial_alter_eq_aux f k (glookup m k) oP idp
    \in unfold_lhs *> step_lookup *> rhs_aux

\lemma glookup_insert_eq {K : \Set} {cnt : Countable K} {A : \Set}
                         (k : K) (x : A) (m : Gmap K cnt A)
  : glookup (ginsert k x m) k = just x
  => glookup_partial_alter_eq (\lam _ => just x) k m

\lemma glookup_partial_alter_ne {K : \Set} {cnt : Countable K} {A : \Set}
                                (f : Maybe A -> Maybe A) (k k' : K) (m : Gmap K cnt A)
                                (ne : Not (k = k'))
  : glookup (gpartial_alter f k m) k' = glookup m k'
  =>
    \let
      | neq_pos : Not (encode {cnt} k = encode {cnt} k') =>
        \lam p => ne (encode_inj {cnt} k k' p)
      | step : plookup (gpartial_alter f k m).gtree (encode {cnt} k')
          = plookup m.gtree (encode {cnt} k') =>
        plookup_partial_alter_ne
          (gpartial_alter.gpartial_alter_lift f k)
          (encode {cnt} k)
          (encode {cnt} k')
          m.gtree
          neq_pos
    \in pmap (\lam q => \case q \with {
      | nothing => nothing
      | just p => just p.2
    }) step

\lemma glookup_insert_ne {K : \Set} {cnt : Countable K} {A : \Set}
                         (k k' : K) (x : A) (m : Gmap K cnt A)
                         (ne : Not (k = k'))
  : glookup (ginsert k x m) k' = glookup m k'
  => glookup_partial_alter_ne (\lam _ => just x) k k' m ne

\lemma gmap_insert_validN {K : \Set} {cnt : Countable K} {A : CMRA}
                          (n : Nat) (m : Gmap K cnt A.E) (k : K) (x : A.E)
                          (hvx : A.validN n x)
                          (hvm : GmapValidN {K} {cnt} {A} n m)
  : GmapValidN {K} {cnt} {A} n (ginsert k x m)
  => \lam k' =>
      \case decideEq k' k \with {
        | yes p =>
          transport
            (\lam kk => option_validN {A} n (glookup (ginsert k x m) kk))
            (inv p)
            (transport (option_validN {A} n)
              (inv (glookup_insert_eq k x m))
              hvx)
        | no np =>
          transport (option_validN {A} n)
            (inv (glookup_insert_ne k k' x m (\lam q => np (inv q))))
            (hvm k')
      }

\lemma gmap_alloc_includedN {K : \Set} {cnt : Countable K} {A : UCMRA}
                            (n : Nat) (m frame : Gmap K cnt A.E) (k : K) (x : A.E)
                            (fresh : glookup m k = nothing)
                            (hincl : inclN {GmapUCMRA K cnt A}
                              {\new Op _ { | op => (GmapUCMRA K cnt A).op }}
                              frame n m)
  : inclN {GmapUCMRA K cnt A}
      {\new Op _ { | op => (GmapUCMRA K cnt A).op }}
      ((GmapUCMRA K cnt A).op (gsingleton k x) frame)
      n (ginsert k x m)
  => \case hincl \with {
      | inP (z, hz) =>
        inP (z, \lam k' =>
          \case decideEq k' k \with {
            | yes p =>
              transport
                (\lam kk => (OptionOFE A).dist n
                  (glookup (ginsert k x m) kk)
                  (glookup ((GmapUCMRA K cnt A).op
                    ((GmapUCMRA K cnt A).op (gsingleton k x) frame) z) kk))
                (inv p)
                (gmap_alloc_includedN.at_fresh n m frame k x fresh z hz)
            | no np =>
              \let
                | ne : Not (k = k') => \lam q => np (inv q)
                | lhs_ne : glookup (ginsert k x m) k' = glookup m k' =>
                  glookup_insert_ne k k' x m ne
                | sing_ne : glookup (gsingleton k x) k' = nothing =>
                  glookup_insert_ne k k' x gempty ne *> glookup_empty k'
                | rhs_step :
                    glookup ((GmapUCMRA K cnt A).op
                      ((GmapUCMRA K cnt A).op (gsingleton k x) frame) z) k'
                    = option_op {A}
                        (glookup ((GmapUCMRA K cnt A).op (gsingleton k x) frame) k')
                        (glookup z k') =>
                  glookup_op ((GmapUCMRA K cnt A).op (gsingleton k x) frame) z k'
                | inner_step :
                    glookup ((GmapUCMRA K cnt A).op (gsingleton k x) frame) k'
                    = option_op {A} (glookup (gsingleton k x) k') (glookup frame k') =>
                  glookup_op (gsingleton k x) frame k'
                | rhs_simpl :
                    glookup ((GmapUCMRA K cnt A).op
                      ((GmapUCMRA K cnt A).op (gsingleton k x) frame) z) k'
                    = option_op {A} (glookup frame k') (glookup z k') =>
                  rhs_step
                  *> pmap (\lam o => option_op {A} o (glookup z k'))
                       (inner_step
                        *> pmap (\lam o => option_op {A} o (glookup frame k')) sing_ne
                        *> option_op_nothing_l (glookup frame k'))
                | old_rhs :
                    glookup ((GmapUCMRA K cnt A).op frame z) k'
                    = option_op {A} (glookup frame k') (glookup z k') =>
                  glookup_op frame z k'
              \in transport2
                   (\lam u v => (OptionOFE A).dist n u v)
                   (inv lhs_ne)
                   (old_rhs *> inv rhs_simpl)
                   (hz k')
          })
    }
  \where {
    \func at_fresh {K : \Set} {cnt : Countable K} {A : UCMRA}
                   (n : Nat) (m frame : Gmap K cnt A.E) (k : K) (x : A.E)
                   (fresh : glookup m k = nothing)
                   (z : Gmap K cnt A.E)
                   (hz : (GmapUCMRA K cnt A).dist n m ((GmapUCMRA K cnt A).op frame z))
      : (OptionOFE A).dist n
          (glookup (ginsert k x m) k)
          (glookup ((GmapUCMRA K cnt A).op
            ((GmapUCMRA K cnt A).op (gsingleton k x) frame) z) k)
      =>
        \let
          | old_rhs : glookup ((GmapUCMRA K cnt A).op frame z) k
              = option_op {A} (glookup frame k) (glookup z k) =>
            glookup_op frame z k
          | op_none : option_op {A} (glookup frame k) (glookup z k) = nothing =>
            option_dist_nothing_eq {A} n
              (option_op {A} (glookup frame k) (glookup z k))
              (transport (\lam o => (OptionOFE A).dist n nothing o)
                old_rhs
                (transport (\lam o => (OptionOFE A).dist n o
                    (glookup ((GmapUCMRA K cnt A).op frame z) k))
                  fresh
                  (hz k)))
          | none_parts => option_op_eq_nothing_inv {A} (glookup frame k) (glookup z k) op_none
          | lhs_eq : glookup (ginsert k x m) k = just x =>
            glookup_insert_eq k x m
          | inner_step :
              glookup ((GmapUCMRA K cnt A).op (gsingleton k x) frame) k
              = option_op {A} (glookup (gsingleton k x) k) (glookup frame k) =>
            glookup_op (gsingleton k x) frame k
          | rhs_step :
              glookup ((GmapUCMRA K cnt A).op
                ((GmapUCMRA K cnt A).op (gsingleton k x) frame) z) k
              = option_op {A}
                  (glookup ((GmapUCMRA K cnt A).op (gsingleton k x) frame) k)
                  (glookup z k) =>
            glookup_op ((GmapUCMRA K cnt A).op (gsingleton k x) frame) z k
          | rhs_eq :
              glookup ((GmapUCMRA K cnt A).op
                ((GmapUCMRA K cnt A).op (gsingleton k x) frame) z) k
              = just x =>
            rhs_step
            *> pmap (\lam o => option_op {A} o (glookup z k))
                 (inner_step
                  *> pmap (\lam o => option_op {A} o (glookup frame k))
                       (glookup_singleton_eq k x)
                  *> pmap (\lam o => option_op {A} (just x) o) none_parts.1)
            *> pmap (\lam o => option_op {A} (just x) o) none_parts.2
        \in transport2
             (\lam u v => (OptionOFE A).dist n u v)
             (inv lhs_eq)
             (inv rhs_eq)
             ((OptionOFE A).ofe_dist_refl n (just x))
  }

\func gdelete {K : \Set} {cnt : Countable K} {A : \Set} (k : K) (m : Gmap K cnt A) : Gmap K cnt A =>
  gpartial_alter (\lam _ => nothing) k m

\func gsingleton {K : \Set} {cnt : Countable K} {A : \Set} (k : K) (x : A) : Gmap K cnt A =>
  ginsert k x gempty

-- =================================================================================
-- Merge: pointwise combine two Gmaps using f.
-- =================================================================================

\func gmerge {K : \Set} {cnt : Countable K} {A B C : \Set}
             (f : Maybe A -> Maybe B -> Maybe C)
             (m1 : Gmap K cnt A) (m2 : Gmap K cnt B) : Gmap K cnt C \cowith
  | gtree => pmerge (gmerge_lift {K} {A} {B} {C} f) m1.gtree m2.gtree
  | gtree_wf => \lam q p hp =>
      \let
        | hf_nn : gmerge_lift {K} {A} {B} {C} f nothing nothing = nothing
        => gmerge_lift_nn f
        | step : plookup (pmerge (gmerge_lift {K} {A} {B} {C} f) m1.gtree m2.gtree) q
          = gmerge_lift {K} {A} {B} {C} f (plookup m1.gtree q) (plookup m2.gtree q)
        => plookup_merge (gmerge_lift {K} {A} {B} {C} f) hf_nn m1.gtree m2.gtree q
        | hp' : gmerge_lift {K} {A} {B} {C} f (plookup m1.gtree q) (plookup m2.gtree q) = just p
        => inv step *> hp
      \in gmerge_lift_fst f q p
          (plookup m1.gtree q) (plookup m2.gtree q) hp'
          (\lam p1 hq1 => m1.gtree_wf q p1 hq1)
          (\lam p2 hq2 => m2.gtree_wf q p2 hq2)
  \where {
    \func gmerge_lift {K A B C : \Set} (f : Maybe A -> Maybe B -> Maybe C)
                      (o1 : Maybe (\Sigma K A)) (o2 : Maybe (\Sigma K B)) : Maybe (\Sigma K C)
    \elim o1, o2
      | nothing, nothing => \case f nothing nothing \with {
        | nothing => nothing
        | just _  => nothing  -- unreachable in practice (f preserves nothing nothing)
      }
      | just p1, nothing => \case f (just p1.2) nothing \with {
        | nothing => nothing
        | just c  => just (p1.1, c)
      }
      | nothing, just p2 => \case f nothing (just p2.2) \with {
        | nothing => nothing
        | just c  => just (p2.1, c)
      }
      | just p1, just p2 => \case f (just p1.2) (just p2.2) \with {
        | nothing => nothing
        | just c  => just (p1.1, c)
      }

    \func gmerge_lift_nn {K A B C : \Set} (f : Maybe A -> Maybe B -> Maybe C)
      : gmerge_lift {K} {A} {B} {C} f nothing nothing = nothing
      => \case f nothing nothing \as fr, idp : f nothing nothing = fr
      \return (\case fr \return Maybe (\Sigma K C) \with {
        | nothing => nothing
        | just _  => nothing
      }) = nothing
      \with {
        | nothing, _ => idp
        | just _,  _ => idp
      }

    \func gmerge_lift_fst {K A B C : \Set} {cnt : Countable K}
                          (f : Maybe A -> Maybe B -> Maybe C)
                          (q : Pos) (p : \Sigma K C)
                          (o1 : Maybe (\Sigma K A)) (o2 : Maybe (\Sigma K B))
                          (h : gmerge_lift {K} {A} {B} {C} f o1 o2 = just p)
                          (wf1 : \Pi (p1 : \Sigma K A) -> o1 = just p1 -> encode {cnt} p1.1 = q)
                          (wf2 : \Pi (p2 : \Sigma K B) -> o2 = just p2 -> encode {cnt} p2.1 = q)
      : encode {cnt} p.1 = q
    \elim o1, o2
      | nothing, nothing =>
        \case f nothing nothing \as fr,
              idp : f nothing nothing = fr,
              h : (\case fr \return Maybe (\Sigma K C) \with {
                | nothing => nothing
                | just _  => nothing
              }) = just p
        \return encode {cnt} p.1 = q
        \with {
          | nothing, _, e => \case e \with {}
          | just _,  _, e => \case e \with {}
        }
      | just p1, nothing =>
        \case f (just p1.2) nothing \as fr,
              idp : f (just p1.2) nothing = fr,
              h : (\case fr \return Maybe (\Sigma K C) \with {
                | nothing => nothing
                | just c  => just (p1.1, c)
              }) = just p
        \return encode {cnt} p.1 = q
        \with {
          | nothing, _, e => \case e \with {}
          | just c,  _, e =>
            \let
              | hp1 : p.1 = p1.1 =>
                inv (pmap (\lam mp => \case mp \with {
                  | nothing => p1.1
                  | just p' => p'.1
                }) e)
            \in transport (\lam k' => encode {cnt} k' = q) (inv hp1) (wf1 p1 idp)
        }
      | nothing, just p2 =>
        \case f nothing (just p2.2) \as fr,
              idp : f nothing (just p2.2) = fr,
              h : (\case fr \return Maybe (\Sigma K C) \with {
                | nothing => nothing
                | just c  => just (p2.1, c)
              }) = just p
        \return encode {cnt} p.1 = q
        \with {
          | nothing, _, e => \case e \with {}
          | just c,  _, e =>
            \let
              | hp2 : p.1 = p2.1 =>
                inv (pmap (\lam mp => \case mp \with {
                  | nothing => p2.1
                  | just p' => p'.1
                }) e)
            \in transport (\lam k' => encode {cnt} k' = q) (inv hp2) (wf2 p2 idp)
        }
      | just p1, just p2 =>
        \case f (just p1.2) (just p2.2) \as fr,
              idp : f (just p1.2) (just p2.2) = fr,
              h : (\case fr \return Maybe (\Sigma K C) \with {
                | nothing => nothing
                | just c  => just (p1.1, c)
              }) = just p
        \return encode {cnt} p.1 = q
        \with {
          | nothing, _, e => \case e \with {}
          | just c,  _, e =>
            \let
              | hp1 : p.1 = p1.1 =>
                inv (pmap (\lam mp => \case mp \with {
                  | nothing => p1.1
                  | just p' => p'.1
                }) e)
            \in transport (\lam k' => encode {cnt} k' = q) (inv hp1) (wf1 p1 idp)
        }
  }

-- =================================================================================
-- OFE structure on Gmap (pointwise)
-- =================================================================================

\func GmapOFE (K : \Set) (cnt : Countable K) (A : OFE) : OFE \cowith
  | E => Gmap K cnt A.E
  | dist => \lam n m1 m2 => \Pi (k : K) -> (OptionOFE A).dist n (glookup m1 k) (glookup m2 k)
  | equiv => \lam m1 m2 => \Pi (k : K) -> (OptionOFE A).equiv (glookup m1 k) (glookup m2 k)
  | equiv_refl => \lam m k => (OptionOFE A).equiv_refl (glookup m k)
  | equiv_sym => \lam m1 m2 h k => (OptionOFE A).equiv_sym (glookup m1 k) (glookup m2 k) (h k)
  | equiv_trans => \lam m1 m2 m3 h1 h2 k =>
          (OptionOFE A).equiv_trans (glookup m1 k) (glookup m2 k) (glookup m3 k) (h1 k) (h2 k)
  | ofe_equiv_dist => \lam m1 m2 => (
    \lam he n k => ((OptionOFE A).ofe_equiv_dist (glookup m1 k) (glookup m2 k)).1 (he k) n,
    \lam h k => ((OptionOFE A).ofe_equiv_dist (glookup m1 k) (glookup m2 k)).2 (\lam n => h n k)
  )
  | ofe_dist_refl => \lam n m k => (OptionOFE A).ofe_dist_refl n (glookup m k)
  | ofe_dist_sym => \lam n m1 m2 h k => (OptionOFE A).ofe_dist_sym n (glookup m1 k) (glookup m2 k) (h k)
  | ofe_dist_trans => \lam n m1 m2 m3 h1 h2 k =>
          (OptionOFE A).ofe_dist_trans n (glookup m1 k) (glookup m2 k) (glookup m3 k) (h1 k) (h2 k)
  | ofe_dist_le => \lam n m m1 m2 h le k =>
          (OptionOFE A).ofe_dist_le n m (glookup m1 k) (glookup m2 k) (h k) le

-- =================================================================================
-- Validity
-- =================================================================================

\func GmapValidN {K : \Set} {cnt : Countable K} {A : CMRA} (n : Nat) (m : Gmap K cnt A.E) : \Prop =>
  \Pi (k : K) -> option_validN {A} n (glookup m k)

\func GmapValid {K : \Set} {cnt : Countable K} {A : CMRA} (m : Gmap K cnt A.E) : \Prop =>
  \Pi (k : K) -> option_valid {A} (glookup m k)

-- =================================================================================
-- The Gmap CMRA
-- =================================================================================

\func gmap_op {K : \Set} {cnt : Countable K} {A : CMRA} (m1 m2 : Gmap K cnt A.E) : Gmap K cnt A.E =>
  gmerge (option_op {A}) m1 m2

\func gmap_pcore {K : \Set} {cnt : Countable K} {A : CMRA} (m : Gmap K cnt A.E) : Maybe (Gmap K cnt A.E) =>
  just (\new Gmap K cnt A.E {
    | gtree => pomap (\lam p => \case pcore {A} p.2 \with {
      | nothing => nothing
      | just c  => just (p.1, c)
    }) m.gtree
    | gtree_wf => \lam q p hp =>
      \let
        | f : \Sigma K A.E -> Maybe (\Sigma K A.E) =>
          \lam p => \case pcore {A} p.2 \with {
            | nothing => nothing
            | just c  => just (p.1, c)
          }
        | pre : \Sigma (p0 : \Sigma K A.E) (plookup m.gtree q = just p0) (f p0 = just p) =>
          plookup_pomap_just_inv f m.gtree q p hp
      \in \case pcore {A} pre.1.2 \as pc, idp : pcore {A} pre.1.2 = pc,
                pre.3 : (\case pc \with {
                  | nothing => nothing
                  | just c  => just (pre.1.1, c)
                }) = just p
      \return encode {cnt} p.1 = q
      \with {
        | nothing, _, h => \case h \with {}
        | just c, _, h =>
          \let
            | pp : (pre.1.1, c) = p =>
              pmap (\lam o => \case o \with {
                | nothing => (pre.1.1, c)
                | just p' => p'
              }) h
            | key_eq : encode {cnt} pre.1.1 = encode {cnt} p.1 =>
              pmap (\lam p' => encode {cnt} p'.1) pp
          \in inv key_eq *> m.gtree_wf q pre.1 pre.2
      }
  })

\lemma glookup_op {K : \Set} {cnt : Countable K} {A : CMRA} (m1 m2 : Gmap K cnt A.E) (k : K)
  : glookup (gmap_op m1 m2) k = option_op {A} (glookup m1 k) (glookup m2 k)
  =>
    \let
      | f : Maybe A.E -> Maybe A.E -> Maybe A.E => option_op {A}
      | hf : f nothing nothing = nothing => idp
      | step : plookup (pmerge (gmerge.gmerge_lift {K} {A.E} {A.E} {A.E} f) m1.gtree m2.gtree)
          (encode {cnt} k)
        = gmerge.gmerge_lift {K} {A.E} {A.E} {A.E} f
              (plookup m1.gtree (encode {cnt} k))
              (plookup m2.gtree (encode {cnt} k))
      => plookup_merge (gmerge.gmerge_lift {K} {A.E} {A.E} {A.E} f)
            (gmerge.gmerge_lift_nn f)
            m1.gtree m2.gtree (encode {cnt} k)
    \in glookup_op_aux {K} {cnt} {A} m1 m2 k step
  \where {
    \func glookup_op_aux {K : \Set} {cnt : Countable K} {A : CMRA}
                         (m1 m2 : Gmap K cnt A.E) (k : K)
                         (step : plookup (pmerge (gmerge.gmerge_lift {K} {A.E} {A.E} {A.E}
                             (option_op {A}))
                             m1.gtree m2.gtree)
                             (encode {cnt} k)
                           = gmerge.gmerge_lift {K} {A.E} {A.E} {A.E} (option_op {A})
                                 (plookup m1.gtree (encode {cnt} k))
                                 (plookup m2.gtree (encode {cnt} k)))
      : glookup (gmap_op m1 m2) k = option_op {A} (glookup m1 k) (glookup m2 k)
      => \case plookup m1.gtree (encode {cnt} k) \as o1,
               idp : plookup m1.gtree (encode {cnt} k) = o1,
               plookup m2.gtree (encode {cnt} k) \as o2,
               idp : plookup m2.gtree (encode {cnt} k) = o2
      \return glookup (gmap_op m1 m2) k = option_op {A} (glookup m1 k) (glookup m2 k)
      \with {
        | nothing, ho1, nothing, ho2 =>
          \let
            | step' : plookup (pmerge (gmerge.gmerge_lift {K} {A.E} {A.E} {A.E} (option_op {A}))
                m1.gtree m2.gtree) (encode {cnt} k)
              = gmerge.gmerge_lift {K} {A.E} {A.E} {A.E} (option_op {A}) nothing nothing
            => step *> transport2 (\lam u v =>
                  gmerge.gmerge_lift {K} {A.E} {A.E} {A.E} (option_op {A})
                      (plookup m1.gtree (encode {cnt} k)) (plookup m2.gtree (encode {cnt} k))
                    = gmerge.gmerge_lift {K} {A.E} {A.E} {A.E} (option_op {A}) u v) ho1 ho2 idp
            | merge_eq : plookup (gmap_op m1 m2).gtree (encode {cnt} k) = nothing
            => step' *> gmerge.gmerge_lift_nn (option_op {A})
          \in path (\lam i => \case merge_eq @ i \with {
            | nothing => nothing
            | just p  => just p.2
          }) *> path (\lam i => option_op {A}
              (\case (inv ho1) @ i \with { | nothing => nothing | just p => just p.2 })
              (\case (inv ho2) @ i \with { | nothing => nothing | just p => just p.2 }))
        | nothing, ho1, just p2, ho2 =>
          \let
            | merge_eq : plookup (gmap_op m1 m2).gtree (encode {cnt} k)
              = just (p2.1, p2.2)
            => step *> transport2 (\lam u v => gmerge.gmerge_lift {K} {A.E} {A.E} {A.E}
                  (option_op {A}) u v = just (p2.1, p2.2))
                           (inv ho1) (inv ho2) idp
          \in path (\lam i => \case merge_eq @ i \with {
            | nothing => nothing
            | just p  => just p.2
          }) *> path (\lam i => option_op {A}
              (\case (inv ho1) @ i \with { | nothing => nothing | just p => just p.2 })
              (\case (inv ho2) @ i \with { | nothing => nothing | just p => just p.2 }))
        | just p1, ho1, nothing, ho2 =>
          \let
            | merge_eq : plookup (gmap_op m1 m2).gtree (encode {cnt} k)
              = just (p1.1, p1.2)
            => step *> transport2 (\lam u v => gmerge.gmerge_lift {K} {A.E} {A.E} {A.E}
                  (option_op {A}) u v = just (p1.1, p1.2))
                           (inv ho1) (inv ho2) idp
          \in path (\lam i => \case merge_eq @ i \with {
            | nothing => nothing
            | just p  => just p.2
          }) *> path (\lam i => option_op {A}
              (\case (inv ho1) @ i \with { | nothing => nothing | just p => just p.2 })
              (\case (inv ho2) @ i \with { | nothing => nothing | just p => just p.2 }))
        | just p1, ho1, just p2, ho2 =>
          \let
            | merge_eq : plookup (gmap_op m1 m2).gtree (encode {cnt} k)
              = just (p1.1, A.op p1.2 p2.2)
            => step *> transport2 (\lam u v => gmerge.gmerge_lift {K} {A.E} {A.E} {A.E}
                  (option_op {A}) u v
                = just (p1.1, A.op p1.2 p2.2))
                           (inv ho1) (inv ho2) idp
          \in path (\lam i => \case merge_eq @ i \with {
            | nothing => nothing
            | just p  => just p.2
          }) *> path (\lam i => option_op {A}
              (\case (inv ho1) @ i \with { | nothing => nothing | just p => just p.2 })
              (\case (inv ho2) @ i \with { | nothing => nothing | just p => just p.2 }))
      }
  }

\lemma glookup_core {K : \Set} {cnt : Countable K} {A : CMRA} (m : Gmap K cnt A.E) (k : K)
  : (\case gmap_pcore m \with {
  | nothing => nothing
  | just cm => glookup cm k
}) = option_pcore {A} (glookup m k)
  =>
    \let
      | f_lift : \Sigma K A.E -> Maybe (\Sigma K A.E) =>
        \lam (p : \Sigma K A.E) => \case pcore {A} p.2 \with {
          | nothing => nothing
          | just c  => just (p.1, c)
        }
      | step : plookup (pomap f_lift m.gtree) (encode {cnt} k)
        = pomap_tree.option_bind f_lift (plookup m.gtree (encode {cnt} k))
      => plookup_pomap f_lift m.gtree (encode {cnt} k)
    \in \case plookup m.gtree (encode {cnt} k) \as o,
              idp : plookup m.gtree (encode {cnt} k) = o
    \return (\case plookup (pomap f_lift m.gtree) (encode {cnt} k) \with {
      | nothing => nothing
      | just p  => just p.2
    }) = option_pcore {A} (glookup m k)
    \with {
      | nothing, ho =>
        path (\lam i => \case
          (step *> transport (\lam (u : Maybe (\Sigma K A.E)) =>
              pomap_tree.option_bind f_lift u
                = pomap_tree.option_bind f_lift (nothing : Maybe (\Sigma K A.E)))
                       (inv ho) idp) @ i
        \with {
          | nothing => nothing
          | just p  => just p.2
        })
          *> path (\lam i =>
            option_pcore {A} (\case (inv ho) @ i \with {
              | nothing => nothing
              | just p  => just p.2
            }))
      | just p, ho =>
        \let
          | step' : plookup (pomap f_lift m.gtree) (encode {cnt} k)
            = (\case pcore {A} p.2 \with {
            | nothing => nothing
            | just c  => just (p.1, c)
          })
          => step *> transport (\lam (u : Maybe (\Sigma K A.E)) =>
                pomap_tree.option_bind f_lift u
                  = (\case pcore {A} p.2 \with {
                  | nothing => nothing
                  | just c  => just (p.1, c)
                }))
                         (inv ho) idp
        \in \case pcore {A} p.2 \as pc, idp : pcore {A} p.2 = pc
        \return (\case plookup (pomap f_lift m.gtree) (encode {cnt} k) \with {
          | nothing => nothing
          | just p'  => just p'.2
        }) = option_pcore {A} (glookup m k)
        \with {
          | nothing, hpc =>
            path (\lam i => \case
              (step' *> transport (\lam (u : Maybe A.E) =>
                  (\case u \with {
                    | nothing => (nothing : Maybe (\Sigma K A.E))
                    | just c  => just (p.1, c)
                  }) = nothing) (inv hpc) idp) @ i
            \with {
              | nothing => nothing
              | just p' => just p'.2
            })
              *> inv hpc
                   *> path (\lam i => option_pcore {A}
                (\case (inv ho) @ i \with {
                  | nothing => nothing
                  | just p' => just p'.2
                }))
          | just c, hpc =>
            path (\lam i => \case
              (step' *> transport (\lam (u : Maybe A.E) =>
                  (\case u \with {
                    | nothing => (nothing : Maybe (\Sigma K A.E))
                    | just c' => just (p.1, c')
                  }) = just (p.1, c)) (inv hpc) idp) @ i
            \with {
              | nothing => nothing
              | just p' => just p'.2
            })
              *> inv hpc
                   *> path (\lam i => option_pcore {A}
                (\case (inv ho) @ i \with {
                  | nothing => nothing
                  | just p' => just p'.2
                }))
        }
    }


\lemma option_op_eq_nothing_inv {A : CMRA} (o1 o2 : Maybe A.E)
                                (h : option_op {A} o1 o2 = nothing)
  : \Sigma (o1 = nothing) (o2 = nothing)
  => \case \elim o1, \elim o2, h \with {
    | nothing, nothing, _ => (idp, idp)
    | nothing, just _,  e => \case e \with {}
    | just _,  nothing, e => \case e \with {}
    | just _,  just _,  e => \case e \with {}
  }

\lemma option_dist_nothing_eq {A : CMRA} (n : Nat) (o : Maybe A.E)
                              (h : (OptionOFE A).dist n nothing o)
  : o = nothing
  => \case \elim o, h \with {
    | nothing, _ => idp
    | just _,  e => \case e \with {}
  }

\func gmap_map_support {K : \Set} {cnt : Countable K} {A B : \Set}
                       (m : Gmap K cnt A)
                       (f : \Sigma K A -> Maybe B)
  : Gmap K cnt B \cowith
  | gtree => pomap (\lam p => \case f p \with {
      | nothing => nothing
      | just b  => just (p.1, b)
    }) m.gtree
  | gtree_wf => \lam q p hp =>
      \let
        | lift : \Sigma K A -> Maybe (\Sigma K B) =>
          \lam p => \case f p \with {
            | nothing => nothing
            | just b  => just (p.1, b)
          }
        | pre : \Sigma (p0 : \Sigma K A) (plookup m.gtree q = just p0) (lift p0 = just p) =>
          plookup_pomap_just_inv lift m.gtree q p hp
      \in \case f pre.1 \as fp, idp : f pre.1 = fp,
                pre.3 : (\case fp \with {
                  | nothing => nothing
                  | just b  => just (pre.1.1, b)
                }) = just p
      \return encode {cnt} p.1 = q
      \with {
        | nothing, _, h => \case h \with {}
        | just b, _, h =>
          \let
            | pp : (pre.1.1, b) = p =>
              pmap (\lam o => \case o \with {
                | nothing => (pre.1.1, b)
                | just p' => p'
              }) h
            | key_eq : encode {cnt} pre.1.1 = encode {cnt} p.1 =>
              pmap (\lam p' => encode {cnt} p'.1) pp
          \in inv key_eq *> m.gtree_wf q pre.1 pre.2
      }

\func gmap_map_support_lookup_aux {K A B : \Set}
                                  (f : \Sigma K A -> Maybe B)
                                  (o : Maybe (\Sigma K A))
  : (\case pomap_tree.option_bind
      (\lam p => \case f p \with {
        | nothing => nothing
        | just b  => just (p.1, b)
      }) o
    \with {
      | nothing => nothing
      | just p  => just p.2
    }) = (\case o \with {
      | nothing => nothing
      | just p  => f p
    })
  \elim o
  | nothing => idp
  | just p =>
    \case f p \as fp, idp : f p = fp
    \return (\case \case fp \return Maybe (\Sigma K B) \with {
      | nothing => nothing
      | just b  => just (p.1, b)
    } \with {
      | nothing => nothing
      | just p  => just p.2
    }) = f p
    \with {
      | nothing, hf => inv hf
      | just b,  hf => inv hf
    }

\lemma glookup_map_support_present {K : \Set} {cnt : Countable K} {A B : \Set}
                                   (m : Gmap K cnt A)
                                   (f : \Sigma K A -> Maybe B)
                                   (k : K) (a : A)
                                   (hp : glookup m k = just a)
  : glookup (gmap_map_support m f) k = f (k, a)
  =>
    \case plookup m.gtree (encode {cnt} k) \as o,
          idp : plookup m.gtree (encode {cnt} k) = o,
          hp : (\case o \with {
            | nothing => nothing
            | just p => just p.2
          }) = just a
    \return glookup (gmap_map_support m f) k = f (k, a)
    \with {
      | nothing, _, e => \case e \with {}
      | just p, ho, e =>
        \let
          | lift : \Sigma K A -> Maybe (\Sigma K B) =>
            \lam p => \case f p \with {
              | nothing => nothing
              | just b  => just (p.1, b)
            }
          | step : plookup (gmap_map_support m f).gtree (encode {cnt} k)
            = pomap_tree.option_bind lift (plookup m.gtree (encode {cnt} k)) =>
            plookup_pomap lift m.gtree (encode {cnt} k)
          | hpv : p.2 = a =>
            pmap (\lam o => \case o \with { | nothing => p.2 | just v => v }) e
          | hpk : p.1 = k =>
            encode_inj {cnt} p.1 k (m.gtree_wf (encode {cnt} k) p ho)
          | peq : p = (k, a) =>
            path (\lam i => (hpk @ i, hpv @ i))
        \in path (\lam i => \case
              (step *> transport (\lam u => pomap_tree.option_bind lift u = pomap_tree.option_bind lift (just p))
                (inv ho) idp) @ i
            \with {
              | nothing => nothing
              | just p' => just p'.2
            })
            *> gmap_map_support_lookup_aux f (just p)
            *> pmap f peq
    }

\lemma glookup_map_support_absent {K : \Set} {cnt : Countable K} {A B : \Set}
                                  (m : Gmap K cnt A)
                                  (f : \Sigma K A -> Maybe B)
                                  (k : K)
                                  (habs : glookup m k = nothing)
  : glookup (gmap_map_support m f) k = nothing
  =>
    \case plookup m.gtree (encode {cnt} k) \as o,
          idp : plookup m.gtree (encode {cnt} k) = o,
          habs : (\case o \with {
            | nothing => nothing
            | just p => just p.2
          }) = nothing
    \return glookup (gmap_map_support m f) k = nothing
    \with {
      | nothing, ho, _ =>
        \let
          | lift : \Sigma K A -> Maybe (\Sigma K B) =>
            \lam p => \case f p \with {
              | nothing => nothing
              | just b  => just (p.1, b)
            }
          | step : plookup (gmap_map_support m f).gtree (encode {cnt} k)
            = pomap_tree.option_bind lift (plookup m.gtree (encode {cnt} k)) =>
            plookup_pomap lift m.gtree (encode {cnt} k)
        \in path (\lam i => \case
              (step *> transport (\lam u => pomap_tree.option_bind lift u = pomap_tree.option_bind lift (nothing : Maybe (\Sigma K A)))
                (inv ho) idp) @ i
            \with {
              | nothing => nothing
              | just p' => just p'.2
            })
      | just p, _, e => \case e \with {}
    }

\lemma gmap_lookup_included {K : \Set} {cnt : Countable K} {A : CMRA}
                            (m1 m2 : Gmap K cnt A.E)
                            (h : \Pi (k : K) ->
                              incl {Maybe A.E}
                                {\new BaseSet (Maybe A.E)}
                                {\new Op (Maybe A.E) { | op => option_op {A} }}
                                (glookup m1 k) (glookup m2 k))
  : incl {Gmap K cnt A.E}
      {GmapOFE K cnt A}
      {\new Op (Gmap K cnt A.E) { | op => gmap_op }}
      m1 m2
  => \case achoice (\lam k => \Sigma (w : Maybe A.E)
        (glookup m2 k = option_op {A} (glookup m1 k) w)) h \with {
    | inP choose =>
      \let
        | wmap : Gmap K cnt A.E =>
          gmap_map_support m2 (\lam p => (choose p.1).1)
        | heq : m2 = gmap_op m1 wmap =>
          gmap_eq m2 (gmap_op m1 wmap) (\lam k =>
            \case glookup m2 k \as o2, idp : glookup m2 k = o2
            \return glookup m2 k = glookup (gmap_op m1 wmap) k
            \with {
              | nothing, hm2 =>
                \let
                  | none_inv : \Sigma (glookup m1 k = nothing) ((choose k).1 = nothing) =>
                    option_op_eq_nothing_inv {A} (glookup m1 k) (choose k).1
                      (inv (inv hm2 *> (choose k).2))
                  | gop_none : glookup (gmap_op m1 wmap) k = nothing =>
                    glookup_op m1 wmap k *>
                    pmap2 (option_op {A}) none_inv.1
                      (glookup_map_support_absent m2 (\lam p => (choose p.1).1) k hm2)
                \in hm2 *> inv gop_none
              | just a, hm2 =>
                (choose k).2 *>
                inv (pmap2 (option_op {A}) idp
                  (glookup_map_support_present m2 (\lam p => (choose p.1).1) k a hm2)) *>
                inv (glookup_op m1 wmap k)
            })
      \in inP (wmap, heq)
  }


\func gmap_cmra_pcore_mono_proof {K : \Set} {cnt : Countable K} {A : CMRA}
                                  (x y cx : Gmap K cnt A.E)
                                  (hxy : incl {Gmap K cnt A.E}
                                      {GmapOFE K cnt A}
                                      {\new Op (Gmap K cnt A.E) { | op => gmap_op }}
                                      x y)
                                  (hpx : gmap_pcore x = just cx)
  : TruncP (\Sigma (cy : Gmap K cnt A.E)
      (gmap_pcore y = just cy)
      (incl {Gmap K cnt A.E}
        {GmapOFE K cnt A}
        {\new Op (Gmap K cnt A.E) { | op => gmap_op }}
        cx cy))
  =>
    \let
      | gcore : Gmap K cnt A.E -> Gmap K cnt A.E =>
        \lam m => \case gmap_pcore m \with {
          | nothing => m
          | just c  => c
        }
      | hpcm_unfold : \Pi (m : Gmap K cnt A.E) -> gmap_pcore m = just (gcore m) =>
        \lam _ => idp
      | cx_eq : cx = gcore x =>
        pmap (\lam (o : Maybe (Gmap K cnt A.E)) => \case o \with {
          | nothing => cx
          | just c  => c
        }) (inv hpx *> hpcm_unfold x)
      | core_incl : incl {Gmap K cnt A.E}
          {GmapOFE K cnt A}
          {\new Op (Gmap K cnt A.E) { | op => gmap_op }}
          (gcore x) (gcore y) =>
        gmap_lookup_included (gcore x) (gcore y) (\lam k =>
          transport2 (\lam u v => incl {Maybe A.E}
              {\new BaseSet (Maybe A.E)}
              {\new Op (Maybe A.E) { | op => option_op {A} }}
              u v)
            (inv (glookup_core x k))
            (inv (glookup_core y k))
            (option_pcore_mono {A} (glookup x k) (glookup y k)
              (gmap_cmra_pcore_mono_proof.pointwise x y hxy k)))
    \in inP (gcore y, hpcm_unfold y,
      transport (\lam c => incl {Gmap K cnt A.E}
        {GmapOFE K cnt A}
        {\new Op (Gmap K cnt A.E) { | op => gmap_op }}
        c (gcore y)) (inv cx_eq) core_incl)
  \where {
    \func pointwise {K : \Set} {cnt : Countable K} {A : CMRA}
                    (x y : Gmap K cnt A.E)
                    (hxy : incl {Gmap K cnt A.E}
                        {GmapOFE K cnt A}
                        {\new Op (Gmap K cnt A.E) { | op => gmap_op }}
                        x y)
                    (k : K)
      : incl {Maybe A.E}
          {\new BaseSet (Maybe A.E)}
          {\new Op (Maybe A.E) { | op => option_op {A} }}
          (glookup x k) (glookup y k)
      => \case hxy \with {
        | inP (w, hw) => inP (glookup w k,
            pmap (\lam m => glookup m k) hw *> glookup_op x w k)
      }
  }

\func gmap_cmra_extend_proof {K : \Set} {cnt : Countable K} {A : CMRA}
                              (n : Nat) (x y1 y2 : Gmap K cnt A.E)
                              (hvx : GmapValidN {K} {cnt} {A} n x)
                              (hdist : (GmapOFE K cnt A).dist n x (gmap_op y1 y2))
  : \Sigma (z1 z2 : Gmap K cnt A.E)
      (x = gmap_op z1 z2)
      ((GmapOFE K cnt A).dist n z1 y1)
      ((GmapOFE K cnt A).dist n z2 y2)
  =>
    \let
      | split_at : \Pi (k : K) -> \Sigma (z1 z2 : Maybe A.E)
          (glookup x k = option_op {A} z1 z2)
          ((OptionOFE A).dist n z1 (glookup y1 k))
          ((OptionOFE A).dist n z2 (glookup y2 k)) =>
        \lam k => option_extend {A} n (glookup x k) (glookup y1 k) (glookup y2 k) (hvx k)
          (transport (\lam o => (OptionOFE A).dist n (glookup x k) o)
            (glookup_op y1 y2 k) (hdist k))
      | z1 : Gmap K cnt A.E =>
        gmap_map_support x (\lam p => (split_at p.1).1)
      | z2 : Gmap K cnt A.E =>
        gmap_map_support x (\lam p => (split_at p.1).2)
      | zop : x = gmap_op z1 z2 =>
        gmap_eq x (gmap_op z1 z2) (\lam k =>
          \case glookup x k \as ox, idp : glookup x k = ox
          \return glookup x k = glookup (gmap_op z1 z2) k
          \with {
            | nothing, hxk =>
              hxk *>
              inv (glookup_op z1 z2 k *>
                pmap2 (option_op {A})
                  (glookup_map_support_absent x (\lam p => (split_at p.1).1) k hxk)
                  (glookup_map_support_absent x (\lam p => (split_at p.1).2) k hxk))
            | just a, hxk =>
              (split_at k).3 *>
              inv (pmap2 (option_op {A})
                (glookup_map_support_present x (\lam p => (split_at p.1).1) k a hxk)
                (glookup_map_support_present x (\lam p => (split_at p.1).2) k a hxk)) *>
              inv (glookup_op z1 z2 k)
          })
      | dz1 : (GmapOFE K cnt A).dist n z1 y1 =>
        \lam k =>
          \case glookup x k \as ox, idp : glookup x k = ox
          \return (OptionOFE A).dist n (glookup z1 k) (glookup y1 k)
          \with {
            | nothing, hxk =>
              transport (\lam o => (OptionOFE A).dist n o (glookup y1 k))
                (inv (glookup_map_support_absent x (\lam p => (split_at p.1).1) k hxk))
                (\let | hop_none : option_op {A} (glookup y1 k) (glookup y2 k) = nothing =>
                         option_dist_nothing_eq {A} n (option_op {A} (glookup y1 k) (glookup y2 k))
                           (transport2 (\lam u v => (OptionOFE A).dist n u v)
                             hxk (glookup_op y1 y2 k) (hdist k))
                      | invs => option_op_eq_nothing_inv {A} (glookup y1 k) (glookup y2 k) hop_none
                 \in transport (\lam o => (OptionOFE A).dist n nothing o) (inv invs.1) ())
            | just a, hxk =>
              transport (\lam o => (OptionOFE A).dist n o (glookup y1 k))
                (inv (glookup_map_support_present x (\lam p => (split_at p.1).1) k a hxk))
                ((split_at k).4)
          }
      | dz2 : (GmapOFE K cnt A).dist n z2 y2 =>
        \lam k =>
          \case glookup x k \as ox, idp : glookup x k = ox
          \return (OptionOFE A).dist n (glookup z2 k) (glookup y2 k)
          \with {
            | nothing, hxk =>
              transport (\lam o => (OptionOFE A).dist n o (glookup y2 k))
                (inv (glookup_map_support_absent x (\lam p => (split_at p.1).2) k hxk))
                (\let | hop_none : option_op {A} (glookup y1 k) (glookup y2 k) = nothing =>
                         option_dist_nothing_eq {A} n (option_op {A} (glookup y1 k) (glookup y2 k))
                           (transport2 (\lam u v => (OptionOFE A).dist n u v)
                             hxk (glookup_op y1 y2 k) (hdist k))
                      | invs => option_op_eq_nothing_inv {A} (glookup y1 k) (glookup y2 k) hop_none
                 \in transport (\lam o => (OptionOFE A).dist n nothing o) (inv invs.2) ())
            | just a, hxk =>
              transport (\lam o => (OptionOFE A).dist n o (glookup y2 k))
                (inv (glookup_map_support_present x (\lam p => (split_at p.1).2) k a hxk))
                ((split_at k).5)
          }
    \in (z1, z2, zop, dz1, dz2)


-- =================================================================================
-- The CMRA instance
-- =================================================================================

\func GmapCMRA (K : \Set) (cnt : Countable K) (A : CMRA) : CMRA \cowith
  | OFE => GmapOFE K cnt A
  | pcore => gmap_pcore
  | op => gmap_op
  | valid => GmapValid {K} {cnt} {A}
  | validN => GmapValidN {K} {cnt} {A}

  | cmra_op_ne => \lam x n y1 y2 hy k =>
      transport2 (\lam u v => (OptionOFE A).dist n u v)
          (inv (glookup_op x y1 k))
          (inv (glookup_op x y2 k))
          (option_op_ne {A} n (glookup x k) (glookup y1 k) (glookup y2 k) (hy k))

  | cmra_op_ne_2 => \lam y n x1 x2 hx k =>
      transport2 (\lam u v => (OptionOFE A).dist n u v)
          (inv (glookup_op x1 y k))
          (inv (glookup_op x2 y k))
          (option_op_ne_2 {A} n (glookup y k) (glookup x1 k) (glookup x2 k) (hx k))

  | cmra_pcore_ne => \lam n m1 m2 cm hm hpcm =>
      \let
        | gcore : Gmap K cnt A.E -> Gmap K cnt A.E =>
          \lam m => \case gmap_pcore m \with {
            | nothing => m
            | just c  => c
          }
        | hpcm_unfold : \Pi (m : Gmap K cnt A.E) -> gmap_pcore m = just (gcore m) =>
          \lam _ => idp
        | cm_eq : cm = gcore m1 =>
          pmap (\lam (o : Maybe (Gmap K cnt A.E)) => \case o \with {
            | nothing => cm
            | just c  => c
          }) (inv hpcm *> hpcm_unfold m1)
        | gcore_lookup : \Pi (m : Gmap K cnt A.E) (k : K) ->
            glookup (gcore m) k = option_pcore {A} (glookup m k) =>
          \lam m k =>
              \let
                | step : plookup (gcore m).gtree (encode {cnt} k)
                  = pomap_tree.option_bind
                        (\lam (p : \Sigma K A.E) => \case pcore {A} p.2 \with {
                          | nothing => nothing
                          | just c  => just (p.1, c)
                        })
                        (plookup m.gtree (encode {cnt} k))
                => plookup_pomap _ m.gtree (encode {cnt} k)
              \in \case plookup m.gtree (encode {cnt} k) \as o,
                        idp : plookup m.gtree (encode {cnt} k) = o
              \return glookup (gcore m) k = option_pcore {A} (glookup m k)
              \with {
                | nothing, ho =>
                  \let
                    | f_lift : \Sigma K A.E -> Maybe (\Sigma K A.E) =>
                      \lam (p : \Sigma K A.E) => \case pcore {A} p.2 \with {
                        | nothing => nothing
                        | just c  => just (p.1, c)
                      }
                  \in path (\lam i => \case
                    (step *> transport (\lam (u : Maybe (\Sigma K A.E)) =>
                        pomap_tree.option_bind f_lift u = pomap_tree.option_bind f_lift (nothing : Maybe (\Sigma K A.E))) (inv ho) idp) @ i
                  \with {
                    | nothing => nothing
                    | just p  => just p.2
                  })
                    *> path (\lam i =>
                      option_pcore {A} (\case (inv ho) @ i \with {
                        | nothing => nothing
                        | just p  => just p.2
                      }))
                | just p, ho =>
                  \let
                    | step' : plookup (gcore m).gtree (encode {cnt} k)
                      = (\case pcore {A} p.2 \with {
                      | nothing => nothing
                      | just c  => just (p.1, c)
                    })
                    => step *> transport (\lam (u : Maybe (\Sigma K A.E)) =>
                          pomap_tree.option_bind
                              (\lam (p' : \Sigma K A.E) => \case pcore {A} p'.2 \with {
                                | nothing => nothing
                                | just c  => just (p'.1, c)
                              }) u
                            = (\case pcore {A} p.2 \with {
                            | nothing => nothing
                            | just c  => just (p.1, c)
                          }))
                                   (inv ho) idp
                  \in \case pcore {A} p.2 \as pc, idp : pcore {A} p.2 = pc
                  \return glookup (gcore m) k = option_pcore {A} (glookup m k)
                  \with {
                    | nothing, hpc =>
                      path (\lam i => \case
                        (step' *> transport (\lam (u : Maybe A.E) =>
                            (\case u \with {
                              | nothing => (nothing : Maybe (\Sigma K A.E))
                              | just c  => just (p.1, c)
                            }) = nothing) (inv hpc) idp) @ i
                      \with {
                        | nothing => nothing
                        | just p' => just p'.2
                      })
                        *> inv hpc
                             *> path (\lam i => option_pcore {A}
                          (\case (inv ho) @ i \with {
                            | nothing => nothing
                            | just p' => just p'.2
                          }))
                    | just c, hpc =>
                      path (\lam i => \case
                        (step' *> transport (\lam (u : Maybe A.E) =>
                            (\case u \with {
                              | nothing => (nothing : Maybe (\Sigma K A.E))
                              | just c' => just (p.1, c')
                            }) = just (p.1, c)) (inv hpc) idp) @ i
                      \with {
                        | nothing => nothing
                        | just p' => just p'.2
                      })
                        *> inv hpc
                             *> path (\lam i => option_pcore {A}
                          (\case (inv ho) @ i \with {
                            | nothing => nothing
                            | just p' => just p'.2
                          }))
                  }
              }
        | dist_cores : (GmapOFE K cnt A).dist n (gcore m1) (gcore m2) =>
          \lam k =>
              transport2 (\lam u v => (OptionOFE A).dist n u v)
                  (inv (gcore_lookup m1 k))
                  (inv (gcore_lookup m2 k))
                  (option_pcore_ne {A} n (glookup m1 k) (glookup m2 k) (hm k))
      \in (gcore m2, idp,
           transport (\lam c => (GmapOFE K cnt A).dist n c (gcore m2)) (inv cm_eq) dist_cores)

  | cmra_validN_ne => \lam n m1 m2 hm hv k =>
      option_validN_ne {A} n (glookup m1 k) (glookup m2 k) (hm k) (hv k)

  | cmra_valid_validN => \lam m => (
    \lam hv n k => \case glookup m k \as o, hv k : option_valid {A} o
    \return option_validN {A} n o \with {
      | nothing, _  => ()
      | just a,  hv => (A.cmra_valid_validN a).1 hv n
    },
    \lam hvn k => \case glookup m k \as o, \lam n => hvn n k : \Pi (n : Nat) -> option_validN {A} n o
    \return option_valid {A} o \with {
      | nothing, _ => ()
      | just a, h  => (A.cmra_valid_validN a).2 h
    }
  )

  | cmra_validN_le => \lam n m' x hvn hle k =>
      option_validN_le {A} n m' (glookup x k) (hvn k) hle

  | cmra_assoc => \lam x y z =>
      gmap_eq _ _ (\lam k =>
          glookup_op x (gmap_op y z) k *>
          pmap2 (option_op {A}) idp (glookup_op y z k) *>
          option_op_assoc {A} (glookup x k) (glookup y k) (glookup z k) *>
          inv (pmap2 (option_op {A}) (glookup_op x y k) idp) *>
          inv (glookup_op (gmap_op x y) z k))

  | cmra_comm => \lam x y =>
      gmap_eq _ _ (\lam k =>
          glookup_op x y k *>
          option_op_comm {A} (glookup x k) (glookup y k) *>
          inv (glookup_op y x k))

  | cmra_pcore_l => \lam x cx hpx =>
      \let
        | gcore : Gmap K cnt A.E => \case gmap_pcore x \with {
          | nothing => x
          | just c  => c
        }
        | hpx_unfold : gmap_pcore x = just gcore => idp
        | cx_eq : cx = gcore =>
          pmap (\lam (o : Maybe (Gmap K cnt A.E)) => \case o \with {
            | nothing => cx
            | just c  => c
          }) (inv hpx *> hpx_unfold)
        | core_lookup : \Pi (k : K) -> glookup cx k = option_pcore {A} (glookup x k) =>
          \lam k =>
              transport (\lam c => glookup c k = option_pcore {A} (glookup x k))
                  (inv cx_eq)
                  (glookup_core x k)
      \in gmap_eq _ _ (\lam k =>
          glookup_op cx x k *>
          pmap2 (option_op {A}) (core_lookup k) idp *>
          option_pcore_l {A} (glookup x k))
  | cmra_pcore_idemp => \lam x cx hpx =>
      \let
        | gcore : Gmap K cnt A.E -> Gmap K cnt A.E =>
          \lam m => \case gmap_pcore m \with {
            | nothing => m
            | just c  => c
          }
        | hpcm_unfold : \Pi (m : Gmap K cnt A.E) -> gmap_pcore m = just (gcore m) =>
          \lam _ => idp
        | cx_eq : cx = gcore x =>
          pmap (\lam (o : Maybe (Gmap K cnt A.E)) => \case o \with {
            | nothing => cx
            | just c  => c
          }) (inv hpx *> hpcm_unfold x)
        | gcore_lookup : \Pi (m : Gmap K cnt A.E) (k : K) ->
            glookup (gcore m) k = option_pcore {A} (glookup m k) =>
          \lam m k => glookup_core m k
        | core_idemp : gcore (gcore x) = gcore x =>
          gmap_eq _ _ (\lam k =>
              gcore_lookup (gcore x) k *>
              pmap (option_pcore {A}) (gcore_lookup x k) *>
              option_pcore_idemp {A} (glookup x k) *>
              inv (gcore_lookup x k))
        | step3 : gcore cx = cx =>
          pmap gcore cx_eq *> core_idemp *> inv cx_eq
      \in hpcm_unfold cx *> pmap just step3
  | cmra_pcore_mono => \lam x y cx hl hpx =>
      gmap_cmra_pcore_mono_proof x y cx hl hpx

  | cmra_validN_op_l => \lam n x y hv k =>
      option_validN_op_l {A} n (glookup x k) (glookup y k)
          (transport (option_validN {A} n) (glookup_op x y k) (hv k))

  | cmra_extend => \lam n x y1 y2 hvx hdist =>
      gmap_cmra_extend_proof n x y1 y2 hvx hdist

-- =================================================================================
-- The UCMRA instance
-- =================================================================================


\lemma option_op_nothing_l {A : CMRA} (o : Maybe A.E) : option_op {A} nothing o = o
  => \case \elim o \with {
    | nothing => idp
    | just _  => idp
  }

\lemma option_op_nothing_r {A : CMRA} (o : Maybe A.E) : option_op {A} o nothing = o
  => \case \elim o \with {
    | nothing => idp
    | just _  => idp
  }

\func GmapUCMRA (K : \Set) (cnt : Countable K) (A : UCMRA) : UCMRA \cowith
  | CMRA => GmapCMRA K cnt A
  | unit => gempty
  | ucmra_unit_valid => \lam k =>
      transport (option_valid {A}) (inv (glookup_empty k)) ()
  | ucmra_unit_left_id => \lam m =>
      gmap_eq _ _ (\lam k =>
          glookup_op gempty m k *>
          path (\lam i => option_op {A} (glookup_empty {K} {cnt} {A.E} k @ i) (glookup m k)) *>
          option_op_nothing_l {A} (glookup m k))
  | ucmra_unit_left_id => \lam m =>
      gmap_eq _ _ (\lam k =>
          glookup_op gempty m k *>
          path (\lam i => option_op {A} (glookup_empty {K} {cnt} {A.E} k @ i) (glookup m k)) *>
          option_op_nothing_l {A} (glookup m k))
  | ucmra_pcore_unit =>
    \let
      | gcore : Gmap K cnt A.E -> Gmap K cnt A.E =>
        \lam m => \case gmap_pcore m \with {
          | nothing => m
          | just c  => c
        }
      | hpcm_unfold : \Pi (m : Gmap K cnt A.E) -> gmap_pcore m = just (gcore m) =>
        \lam _ => idp
      | gcore_lookup : \Pi (m : Gmap K cnt A.E) (k : K) ->
          glookup (gcore m) k = option_pcore {A} (glookup m k) =>
        \lam m k => glookup_core m k
      | core_empty_eq : gcore (gempty {K} {cnt} {A.E}) = gempty {K} {cnt} {A.E} =>
        gmap_eq _ _ (\lam k =>
            gcore_lookup (gempty {K} {cnt} {A.E}) k *>
            pmap (option_pcore {A}) (glookup_empty {K} {cnt} {A.E} k) *>
            inv (glookup_empty {K} {cnt} {A.E} k))
    \in hpcm_unfold (gempty {K} {cnt} {A.E}) *> pmap just core_empty_eq


-- =================================================================================
-- Extensionality at the Gmap level (the key lemma we get from Pmap)
-- =================================================================================

\func gmap_eq {K : \Set} {cnt : Countable K} {A : \Set} (m1 m2 : Gmap K cnt A)
              (h : \Pi (k : K) -> glookup m1 k = glookup m2 k)
  : m1 = m2 =>
  \let
    | hpos : \Pi (q : Pos) -> plookup m1.gtree q = plookup m2.gtree q =>
      \lam q => gmap_eq_pos m1 m2 h q
    | teq : m1.gtree = m2.gtree =>
      pmap_eq m1.gtree m2.gtree hpos
  \in path (\lam i => \new Gmap K cnt A {
    | gtree => teq @ i
    | gtree_wf => prop-dpi (\lam i => gmap_wf {K} {cnt} {A} (teq @ i))
        m1.gtree_wf m2.gtree_wf @ i
  })
  \where {
    \func gmap_eq_pos {K : \Set} {cnt : Countable K} {A : \Set}
                      (m1 m2 : Gmap K cnt A)
                      (h : \Pi (k : K) -> glookup m1 k = glookup m2 k)
                      (q : Pos)
      : plookup m1.gtree q = plookup m2.gtree q =>
      both_nothing_or_eq m1 m2 h q (plookup m1.gtree q) idp (plookup m2.gtree q) idp

    \func both_nothing_or_eq {K : \Set} {cnt : Countable K} {A : \Set}
                             (m1 m2 : Gmap K cnt A)
                             (h : \Pi (k : K) -> glookup m1 k = glookup m2 k)
                             (q : Pos)
                             (o1 : Maybe (\Sigma K A)) (e1 : plookup m1.gtree q = o1)
                             (o2 : Maybe (\Sigma K A)) (e2 : plookup m2.gtree q = o2)
      : plookup m1.gtree q = plookup m2.gtree q \elim o1, o2
      | nothing, nothing => e1 *> inv e2
      | just p1, nothing =>
        \let
          | hq : encode {cnt} p1.1 = q => m1.gtree_wf q p1 e1
          | hk : glookup m1 p1.1 = just p1.2 =>
            transport (\lam q' => (\case plookup m1.gtree q' \with {
              | nothing => nothing
              | just p  => just p.2
            }) = just p1.2) (inv hq)
                (path (\lam i => \case e1 @ i \with {
                  | nothing => nothing
                  | just p  => just p.2
                }))
          | hk2 : glookup m2 p1.1 = just p1.2 => inv (h p1.1) *> hk
          | hk2' : (\case plookup m2.gtree q \with {
            | nothing => nothing
            | just p  => just p.2
          }) = just p1.2 =>
            transport (\lam q' => (\case plookup m2.gtree q' \with {
              | nothing => nothing
              | just p  => just p.2
            }) = just p1.2) hq hk2
          | contra : (nothing : Maybe A) = just p1.2 =>
            inv (path (\lam i => \case e2 @ i \with {
              | nothing => nothing
              | just p  => just p.2
            })) *> hk2'
        \in \case contra \with {}
      | nothing, just p2 =>
        \let
          | hq : encode {cnt} p2.1 = q => m2.gtree_wf q p2 e2
          | hk : glookup m2 p2.1 = just p2.2 =>
            transport (\lam q' => (\case plookup m2.gtree q' \with {
              | nothing => nothing
              | just p  => just p.2
            }) = just p2.2) (inv hq)
                (path (\lam i => \case e2 @ i \with {
                  | nothing => nothing
                  | just p  => just p.2
                }))
          | hk1 : glookup m1 p2.1 = just p2.2 => h p2.1 *> hk
          | hk1' : (\case plookup m1.gtree q \with {
            | nothing => nothing
            | just p  => just p.2
          }) = just p2.2 =>
            transport (\lam q' => (\case plookup m1.gtree q' \with {
              | nothing => nothing
              | just p  => just p.2
            }) = just p2.2) hq hk1
          | contra : (nothing : Maybe A) = just p2.2 =>
            inv (path (\lam i => \case e1 @ i \with {
              | nothing => nothing
              | just p  => just p.2
            })) *> hk1'
        \in \case contra \with {}
      | just p1, just p2 =>
        \let
          | hq1 : encode {cnt} p1.1 = q => m1.gtree_wf q p1 e1
          | hq2 : encode {cnt} p2.1 = q => m2.gtree_wf q p2 e2
          | hk_eq : p1.1 = p2.1 => encode_inj {cnt} p1.1 p2.1 (hq1 *> inv hq2)
          | hk1 : glookup m1 p1.1 = just p1.2 =>
            transport (\lam q' => (\case plookup m1.gtree q' \with {
              | nothing => nothing
              | just p  => just p.2
            }) = just p1.2) (inv hq1)
                (path (\lam i => \case e1 @ i \with {
                  | nothing => nothing
                  | just p  => just p.2
                }))
          | hk2 : glookup m2 p1.1 = just p2.2 =>
            transport (\lam k' => glookup m2 k' = just p2.2) (inv hk_eq)
                (transport (\lam q' => (\case plookup m2.gtree q' \with {
                  | nothing => nothing
                  | just p  => just p.2
                }) = just p2.2) (inv hq2)
                    (path (\lam i => \case e2 @ i \with {
                      | nothing => nothing
                      | just p  => just p.2
                    })))
          | val_eq : just p1.2 = {Maybe A} just p2.2 =>
            inv hk1 *> h p1.1 *> hk2
          | hv_eq : p1.2 = p2.2 =>
            pmap (\lam (o : Maybe A) => \case o \with { | just v => v | nothing => p1.2 }) val_eq
          | p_eq : p1 = p2 =>
            path (\lam i => (hk_eq @ i, hv_eq @ i))
        \in e1 *> pmap just p_eq *> inv e2
  }

\lemma glookup_singleton_eq {K : \Set} {cnt : Countable K} {A : \Set} (k : K) (x : A)
  : glookup (gsingleton k x) k = just x
  =>
    \let
      | step : plookup (gsingleton k x).gtree (encode {cnt} k) = just (k, x)
      => plookup_partial_alter_eq
            (gpartial_alter.gpartial_alter_lift (\lam _ => just x) k)
            (encode {cnt} k)
                (gempty {K} {cnt} {A}).gtree
          *> path (\lam i => gpartial_alter.gpartial_alter_lift (\lam _ => just x) k
            (plookup_empty {\Sigma K A} (encode {cnt} k) @ i))
    \in path (\lam i => \case step @ i \with {
      | nothing => nothing
      | just p  => just p.2
    })
