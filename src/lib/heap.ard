\import Logic
\import Logic.Meta
\import Paths
\import Paths.Meta
\import Set
\import Data.Maybe
\import Arith.Nat
\import Order.LinearOrder
\import Order.PartialOrder
\import ofe
\import cmra
\import uPred
\import lang
\import interface
\import lib.pmap
\import lib.excl_cmra
\import lib.auth_cmra
\import lib.gmap_cmra


-- =================================================================================
-- Heap CMRA: AUTH (gmap (Loc, ExclU(Val)))
-- =================================================================================


\func HeapCMRA (Loc : \Set) (cnt : Countable Loc) (Val : \Set) : UCMRA =>
  AuthUCMRA (GmapUCMRA Loc cnt (ExclUCMRA (DiscreteOFE Val)))

\func gmap_singleton {K : \Set} {cnt : Countable K} {V : \Set} (k : K) (v : V) : Gmap K cnt V =>
  gsingleton k v


\func heap_frag {Loc : \Set} {cnt : Countable Loc} {Val : \Set} (l : Loc) (v : Val)
  : (HeapCMRA Loc cnt Val).E =>
  (nothing, gmap_singleton l (just (excl v)))

\func heap_auth {Loc : \Set} {cnt : Countable Loc} {Val : \Set}
                (m : Gmap Loc cnt (Maybe (Excl Val))) : (HeapCMRA Loc cnt Val).E =>
  (just (excl m), gempty)


-- =================================================================================
-- Points-to connective
-- =================================================================================


\func pointsTo {Loc : \Set} {cnt : Countable Loc} {Val : \Set} (l : Loc) (v : Val)
  : ProperUPred (HeapCMRA Loc cnt Val) \cowith
  | upred_holds => \lam n a =>
      inclN {HeapCMRA Loc cnt Val}
          {\new Op (HeapCMRA Loc cnt Val).E { | op => (HeapCMRA Loc cnt Val).op }}
          (heap_frag l v) n a
  | upred_mono => \lam n1 n2 x1 x2 h_incl incl_x1_x2 n2_le_n1 =>
      heap_incl_trans n1 n2 (heap_frag l v) x1 x2 h_incl incl_x1_x2 n2_le_n1

\lemma pointsTo_frag {Loc : \Set} {cnt : Countable Loc} {Val : \Set}
                     (n : Nat) (l : Loc) (v : Val)
  : (pointsTo l v).upred_holds n (heap_frag l v)
  => inclN_refl_ucmra n (heap_frag l v)

-- =================================================================================
-- Helper lemmas for points-to
-- =================================================================================

\func heap_incl_trans {Loc : \Set} {cnt : Countable Loc} {Val : \Set} (n1 n2 : Nat)
                      (a b c : (HeapCMRA Loc cnt Val).E)
                      (h1 : inclN {HeapCMRA Loc cnt Val}
                          {\new Op (HeapCMRA Loc cnt Val).E { | op => (HeapCMRA Loc cnt Val).op }} a n1 b)
                      (h2 : inclN {HeapCMRA Loc cnt Val}
                          {\new Op (HeapCMRA Loc cnt Val).E { | op => (HeapCMRA Loc cnt Val).op }} b n2 c)
                      (le : n2 <= n1)
  : inclN {HeapCMRA Loc cnt Val}
    {\new Op (HeapCMRA Loc cnt Val).E { | op => (HeapCMRA Loc cnt Val).op }} a n2 c
  => \case h1, h2 \with {
    | inP (z1, dist_b_az1), inP (z2, dist_c_bz2) =>
      \let M => HeapCMRA Loc cnt Val
      \in inP (M.op z1 z2,
               M.ofe_dist_trans n2 c (M.op b z2) (M.op a (M.op z1 z2))
                   dist_c_bz2
                   (M.ofe_dist_trans n2 (M.op b z2) (M.op (M.op a z1) z2) (M.op a (M.op z1 z2))
                       (M.cmra_op_ne_2 z2 n2 b (M.op a z1)
                           (M.ofe_dist_le n1 n2 b (M.op a z1) dist_b_az1 le))
                       (M.ofe_dist_sym n2 (M.op a (M.op z1 z2)) (M.op (M.op a z1) z2)
                           (cmra_assoc_dist n2 a z1 z2))))
  }


-- =================================================================================
-- Heap lemmas
-- =================================================================================


\func heap_agree_gmap_valid {Loc : \Set} {cnt : Countable Loc} {Val : \Set}
                            (n : Nat)
                            (a1 a2 : (HeapCMRA Loc cnt Val).E)
                            (l : Loc) (v1 v2 : Val)
                            (hv_op : (HeapCMRA Loc cnt Val).validN n
                                ((HeapCMRA Loc cnt Val).op a1 a2))
                            (hfrag1 : (pointsTo l v1).upred_holds n a1)
                            (hfrag2 : (pointsTo l v2).upred_holds n a2)
  : (GmapUCMRA Loc cnt (ExclUCMRA (DiscreteOFE Val))).validN n
    ((GmapUCMRA Loc cnt (ExclUCMRA (DiscreteOFE Val))).op
        (gmap_singleton l (just (excl v1)))
        (gmap_singleton l (just (excl v2))))
  =>
    \let
      | M => HeapCMRA Loc cnt Val
      | G => GmapUCMRA Loc cnt (ExclUCMRA (DiscreteOFE Val))
      | frag1 : M.E => heap_frag l v1
      | frag2 : M.E => heap_frag l v2
      | hv_frag : validN {G} n (M.op a1 a2).2 =>
        auth_cmra_extend_proof.auth_extend_frag_valid {G} n (M.op a1 a2) hv_op
      | snd_op : (M.op a1 a2).2 = G.op a1.2 a2.2 => auth_op_snd {G} a1 a2
      | hv_op_snd : validN {G} n (G.op a1.2 a2.2) =>
        transport (validN {G} n) snd_op hv_frag
      | incl_snd1 : inclN {G} {\new Op G.E { | op => G.op }}
          (gmap_singleton l (just (excl v1))) n a1.2 =>
        \case hfrag1 \with {
          | inP (z, dist_a1_fragz) =>
            inP (z.2,
                 transport (\lam w => (G).dist n a1.2 w)
                     (auth_op_snd {G} frag1 z)
                     dist_a1_fragz.2)
        }
      | incl_snd2 : inclN {G} {\new Op G.E { | op => G.op }}
          (gmap_singleton l (just (excl v2))) n a2.2 =>
        \case hfrag2 \with {
          | inP (z, dist_a2_fragz) =>
            inP (z.2,
                 transport (\lam w => (G).dist n a2.2 w)
                     (auth_op_snd {G} frag2 z)
                     dist_a2_fragz.2)
        }
      | incl_combined : inclN {G} {\new Op G.E { | op => G.op }}
          (G.op (gmap_singleton l (just (excl v1))) (gmap_singleton l (just (excl v2))))
          n (G.op a1.2 a2.2) =>
        \case incl_snd1, incl_snd2 \with {
          | inP (w1, d1), inP (w2, d2) =>
            \let
              | s1 : G.E => gmap_singleton l (just (excl v1))
              | s2 : G.E => gmap_singleton l (just (excl v2))
              | step1 : G.dist n (G.op a1.2 a2.2) (G.op (G.op s1 w1) (G.op s2 w2)) =>
                cmra_op_ne_both {G} n a1.2 (G.op s1 w1) a2.2 (G.op s2 w2) d1 d2
              -- Reassociate `(s1·w1)·(s2·w2)` to `(s1·s2)·(w1·w2)` as a dist chain.
              | rearr_dist : G.dist n
                  (G.op (G.op s1 w1) (G.op s2 w2))
                  (G.op (G.op s1 s2) (G.op w1 w2)) =>
                \let
                  | step_a : G.dist n (G.op (G.op s1 w1) (G.op s2 w2)) (G.op s1 (G.op w1 (G.op s2 w2))) =>
                    G.ofe_dist_sym n (G.op s1 (G.op w1 (G.op s2 w2))) (G.op (G.op s1 w1) (G.op s2 w2))
                        (cmra_assoc_dist n s1 w1 (G.op s2 w2))
                  | step_b : G.dist n (G.op w1 (G.op s2 w2)) (G.op (G.op w1 s2) w2) =>
                    cmra_assoc_dist n w1 s2 w2
                  | step_c : G.dist n (G.op (G.op w1 s2) w2) (G.op (G.op s2 w1) w2) =>
                    G.cmra_op_ne_2 w2 n (G.op w1 s2) (G.op s2 w1) (cmra_comm_dist n w1 s2)
                  | step_d : G.dist n (G.op (G.op s2 w1) w2) (G.op s2 (G.op w1 w2)) =>
                    G.ofe_dist_sym n (G.op s2 (G.op w1 w2)) (G.op (G.op s2 w1) w2)
                        (cmra_assoc_dist n s2 w1 w2)
                  | step_e : G.dist n (G.op s1 (G.op s2 (G.op w1 w2))) (G.op (G.op s1 s2) (G.op w1 w2)) =>
                    cmra_assoc_dist n s1 s2 (G.op w1 w2)
                \in G.ofe_dist_trans n
                      (G.op (G.op s1 w1) (G.op s2 w2))
                      (G.op s1 (G.op s2 (G.op w1 w2)))
                      (G.op (G.op s1 s2) (G.op w1 w2))
                      (G.ofe_dist_trans n
                        (G.op (G.op s1 w1) (G.op s2 w2))
                        (G.op s1 (G.op w1 (G.op s2 w2)))
                        (G.op s1 (G.op s2 (G.op w1 w2)))
                        step_a
                        (G.cmra_op_ne s1 n (G.op w1 (G.op s2 w2)) (G.op s2 (G.op w1 w2))
                          (G.ofe_dist_trans n (G.op w1 (G.op s2 w2)) (G.op (G.op s2 w1) w2) (G.op s2 (G.op w1 w2))
                            (G.ofe_dist_trans n (G.op w1 (G.op s2 w2)) (G.op (G.op w1 s2) w2) (G.op (G.op s2 w1) w2)
                              step_b step_c)
                            step_d)))
                      step_e
            \in inP (G.op w1 w2,
                     G.ofe_dist_trans n (G.op a1.2 a2.2) (G.op (G.op s1 w1) (G.op s2 w2)) (G.op (G.op s1 s2) (G.op w1 w2))
                         step1 rearr_dist)
        }
    \in cmra_validN_includedN {G} n
        (G.op (gmap_singleton l (just (excl v1))) (gmap_singleton l (just (excl v2))))
        (G.op a1.2 a2.2)
        hv_op_snd
        incl_combined

\func heap_agree {Loc : \Set} {cnt : Countable Loc} {Val : \Set} {l : Loc} {v1 v2 : Val}
  : properUPred_ent {HeapCMRA Loc cnt Val}
    (mkProperSep (pointsTo l v1) (pointsTo l v2))
    (mkProperPure (v1 = v2))
  => \lam n a hv hsep =>
      \let M => HeapCMRA Loc cnt Val
           | G => GmapUCMRA Loc cnt (ExclUCMRA (DiscreteOFE Val))
      \in \case hsep \with {
        | inP (a1, a2, dist_a, hfrag1, hfrag2) =>
          \let
            | hv_op : M.validN n (M.op a1 a2) =>
              M.cmra_validN_ne n a (M.op a1 a2) dist_a hv
            | hv_gmap : G.validN n (G.op (gmap_singleton l (just (excl v1)))
                (gmap_singleton l (just (excl v2))))
            => heap_agree_gmap_valid n a1 a2 l v1 v2 hv_op hfrag1 hfrag2
            | at_l : option_validN {ExclUCMRA (DiscreteOFE Val)} n
                (glookup (G.op (gmap_singleton l (just (excl v1))) (gmap_singleton l (just (excl v2)))) l) =>
              hv_gmap l
            | at_l' : option_validN {ExclUCMRA (DiscreteOFE Val)} n
                (option_op {ExclUCMRA (DiscreteOFE Val)}
                    (glookup (gmap_singleton l (just (excl v1))) l)
                    (glookup (gmap_singleton l (just (excl v2))) l)) =>
              transport (option_validN {ExclUCMRA (DiscreteOFE Val)} n)
                  (glookup_op (gmap_singleton l (just (excl v1))) (gmap_singleton l (just (excl v2))) l)
                  at_l
            | at_l'' : excl_validN n (excl_op (excl v1) (excl v2)) =>
              transport2 (\lam x y => option_validN {ExclUCMRA (DiscreteOFE Val)} n (option_op {ExclUCMRA (DiscreteOFE Val)} x y))
                  (glookup_singleton_eq l (just (excl v1)))
                  (glookup_singleton_eq l (just (excl v2)))
                  at_l'
          \in \case at_l''
      }

\func heap_exclusive {Loc : \Set} {cnt : Countable Loc} {Val : \Set} {l : Loc} {v : Val}
  : properUPred_ent {HeapCMRA Loc cnt Val}
    (mkProperSep (pointsTo l v) (pointsTo l v))
    (mkProperPure Empty)
  => \lam n a hv hsep =>
      \let M => HeapCMRA Loc cnt Val
           | G => GmapUCMRA Loc cnt (ExclUCMRA (DiscreteOFE Val))
      \in \case hsep \with {
        | inP (a1, a2, dist_a, hfrag1, hfrag2) =>
          \let
            | hv_op : M.validN n (M.op a1 a2) =>
              M.cmra_validN_ne n a (M.op a1 a2) dist_a hv
            | hv_gmap : G.validN n (G.op (gmap_singleton l (just (excl v))) (gmap_singleton l (just (excl v))))
            => heap_agree_gmap_valid n a1 a2 l v v hv_op hfrag1 hfrag2
            | at_l : option_validN {ExclUCMRA (DiscreteOFE Val)} n
                (glookup (G.op (gmap_singleton l (just (excl v))) (gmap_singleton l (just (excl v)))) l) =>
              hv_gmap l
            | at_l' : option_validN {ExclUCMRA (DiscreteOFE Val)} n
                (option_op {ExclUCMRA (DiscreteOFE Val)}
                    (glookup (gmap_singleton l (just (excl v))) l)
                    (glookup (gmap_singleton l (just (excl v))) l)) =>
              transport (option_validN {ExclUCMRA (DiscreteOFE Val)} n)
                  (glookup_op (gmap_singleton l (just (excl v))) (gmap_singleton l (just (excl v))) l)
                  at_l
            | at_l'' : excl_validN n (excl_op (excl v) (excl v)) =>
              transport2 (\lam x y => option_validN {ExclUCMRA (DiscreteOFE Val)} n (option_op {ExclUCMRA (DiscreteOFE Val)} x y))
                  (glookup_singleton_eq l (just (excl v)))
                  (glookup_singleton_eq l (just (excl v)))
                  at_l'
          \in at_l''
      }

\func heap_frame {Loc : \Set} {cnt : Countable Loc} {Val : \Set} {l : Loc} {v : Val}
  : properUPred_ent {HeapCMRA Loc cnt Val}
    (pointsTo l v)
    (mkProperSep (pointsTo l v) mkProperEmp)
  => \lam n a hv h_incl =>
      \let M => HeapCMRA Loc cnt Val
           | frag => heap_frag l v
      \in \case h_incl \with {
        | inP (z, dist_a_fragz) =>
          inP (frag, M.op M.unit z,
               M.ofe_dist_trans n a (M.op frag z) (M.op frag (M.op M.unit z))
                   dist_a_fragz
                   (M.cmra_op_ne frag n z (M.op M.unit z)
                       (M.ofe_dist_sym n (M.op M.unit z) z (ucmra_unit_left_id_dist n z))),
               inP (M.unit,
                    M.ofe_dist_sym n (M.op frag M.unit) frag (ucmra_unit_right_id_dist n frag)),
               inP (z, M.ofe_dist_refl n (M.op M.unit z)))
      }

\lemma sep_frame_pointsTo {Loc : \Set} {cnt : Countable Loc} {Val : \Set}
                          {l1 l2 l3 : Loc} {v1 v2 v3 : Val}
                          (h : properUPred_ent {HeapCMRA Loc cnt Val}
                              (pointsTo l1 v1)
                              (pointsTo l2 v2))
  : properUPred_ent {HeapCMRA Loc cnt Val}
    (mkProperSep (pointsTo l1 v1) (pointsTo l3 v3))
    (mkProperSep (pointsTo l2 v2) (pointsTo l3 v3))
  => \lam n a hv hsep =>
      \let M => HeapCMRA Loc cnt Val \in
        \case hsep \with {
          | inP (a1, a2, dist_a, hp1, hp3) =>
            \let
              | hv_op : M.validN n (M.op a1 a2) =>
                M.cmra_validN_ne n a (M.op a1 a2) dist_a hv
              | hv_a1 : M.validN n a1 =>
                M.cmra_validN_op_l n a1 a2 hv_op
            \in inP (a1, a2, dist_a, h n a1 hv_a1 hp1, hp3)
        }

-- =================================================================================
-- BI instance for heap
-- =================================================================================


\func HeapBI (Loc : \Set) (cnt : Countable Loc) (Val : \Set) : BIBase =>
  BIuPred (HeapCMRA Loc cnt Val)


-- =================================================================================
-- Additional heap operations
-- =================================================================================


\func heap_lookup {Loc : \Set} {cnt : Countable Loc} {Val : \Set}
                  (h : Gmap Loc cnt (Maybe (Excl Val))) (l : Loc) : Maybe Val =>
  \case glookup h l \with {
    | nothing => nothing
    | just nothing => nothing
    | just (just (excl v)) => just v
    | just (just exclInvalid) => nothing
  }

\func heap_update {Loc : \Set} {cnt : Countable Loc} {Val : \Set}
                  (h : Gmap Loc cnt (Maybe (Excl Val))) (l : Loc) (v : Val)
  : Gmap Loc cnt (Maybe (Excl Val)) =>
  ginsert l (just (excl v)) h

\lemma heap_update_glookup_eq {Loc : \Set} {cnt : Countable Loc} {Val : \Set}
                              (h : Gmap Loc cnt (Maybe (Excl Val))) (l : Loc) (v : Val)
  : glookup (heap_update h l v) l = just (just (excl v))
  => glookup_insert_eq l (just (excl v)) h

\lemma heap_update_lookup_eq {Loc : \Set} {cnt : Countable Loc} {Val : \Set}
                             (h : Gmap Loc cnt (Maybe (Excl Val))) (l : Loc) (v : Val)
  : heap_lookup (heap_update h l v) l = just v
  => pmap (\lam o => \case o \with {
       | nothing => nothing
       | just nothing => nothing
       | just (just (excl w)) => just w
     | just (just exclInvalid) => nothing
   }) (heap_update_glookup_eq h l v)

\lemma heap_update_validN {Loc : \Set} {cnt : Countable Loc} {Val : \Set}
                          (n : Nat) (h : Gmap Loc cnt (Maybe (Excl Val))) (l : Loc) (v : Val)
                          (hvh : (GmapUCMRA Loc cnt (ExclUCMRA (DiscreteOFE Val))).validN n h)
  : (GmapUCMRA Loc cnt (ExclUCMRA (DiscreteOFE Val))).validN n (heap_update h l v)
  => gmap_insert_validN {Loc} {cnt} {ExclUCMRA (DiscreteOFE Val)}
      n h l (just (excl v)) () hvh

\lemma heap_replace_point_dist {Val : \Set}
  (n : Nat) (old new : Val)
  (f z : Maybe (Maybe (Excl Val)))
  (hd : (OptionOFE (ExclUCMRA (DiscreteOFE Val))).dist n
      (just (just (excl old)))
      (option_op {ExclUCMRA (DiscreteOFE Val)}
        (option_op {ExclUCMRA (DiscreteOFE Val)} (just (just (excl old))) f) z))
  : (OptionOFE (ExclUCMRA (DiscreteOFE Val))).dist n
      (just (just (excl new)))
      (option_op {ExclUCMRA (DiscreteOFE Val)}
        (option_op {ExclUCMRA (DiscreteOFE Val)} (just (just (excl new))) f) z)
  \elim f, z
  | nothing, nothing => (DiscreteOFE Val).ofe_dist_refl n new
  | nothing, just nothing => (DiscreteOFE Val).ofe_dist_refl n new
  | nothing, just (just (excl _)) => \case hd \with {}
  | nothing, just (just exclInvalid) => \case hd \with {}
  | just nothing, nothing => (DiscreteOFE Val).ofe_dist_refl n new
  | just nothing, just nothing => (DiscreteOFE Val).ofe_dist_refl n new
  | just nothing, just (just (excl _)) => \case hd \with {}
  | just nothing, just (just exclInvalid) => \case hd \with {}
  | just (just (excl _)), nothing => \case hd \with {}
  | just (just (excl _)), just nothing => \case hd \with {}
  | just (just (excl _)), just (just (excl _)) => \case hd \with {}
  | just (just (excl _)), just (just exclInvalid) => \case hd \with {}
  | just (just exclInvalid), nothing => \case hd \with {}
  | just (just exclInvalid), just nothing => \case hd \with {}
  | just (just exclInvalid), just (just (excl _)) => \case hd \with {}
  | just (just exclInvalid), just (just exclInvalid) => \case hd \with {}

\lemma gmap_replace_includedN {cnt : Countable Loc} {Val : \Set}
  (n : Nat)
  (m frame : Gmap Loc cnt (Maybe (Excl Val)))
  (k : Loc) (old new : Val)
  (lookup_old : glookup m k = just (just (excl old)))
  (hincl : inclN {GmapUCMRA Loc cnt (ExclUCMRA (DiscreteOFE Val))}
      {\new Op _ { | op => (GmapUCMRA Loc cnt (ExclUCMRA (DiscreteOFE Val))).op }}
      ((GmapUCMRA Loc cnt (ExclUCMRA (DiscreteOFE Val))).op
        (gmap_singleton k (just (excl old))) frame)
      n m)
  : inclN {GmapUCMRA Loc cnt (ExclUCMRA (DiscreteOFE Val))}
      {\new Op _ { | op => (GmapUCMRA Loc cnt (ExclUCMRA (DiscreteOFE Val))).op }}
      ((GmapUCMRA Loc cnt (ExclUCMRA (DiscreteOFE Val))).op
        (gmap_singleton k (just (excl new))) frame)
      n (heap_update m k new)
  => \case hincl \with {
    | inP (z, hz) =>
      \let
        | G => GmapUCMRA Loc cnt (ExclUCMRA (DiscreteOFE Val))
      \in inP (z, \lam k' =>
        \case NatSemiring.decideEq k' k \with {
          | yes p =>
            transport
              (\lam kk => (OptionOFE (ExclUCMRA (DiscreteOFE Val))).dist n
                (glookup (heap_update m k new) kk)
                (glookup (G.op (G.op (gmap_singleton k (just (excl new))) frame) z) kk))
              (inv p)
              (\let
                | lhs_eq : glookup (heap_update m k new) k = just (just (excl new)) =>
                  heap_update_glookup_eq m k new
                | rhs_step : glookup (G.op (G.op (gmap_singleton k (just (excl new))) frame) z) k
                    = option_op {ExclUCMRA (DiscreteOFE Val)}
                        (glookup (G.op (gmap_singleton k (just (excl new))) frame) k)
                        (glookup z k) =>
                  glookup_op (G.op (gmap_singleton k (just (excl new))) frame) z k
                | inner_step_new : glookup (G.op (gmap_singleton k (just (excl new))) frame) k
                    = option_op {ExclUCMRA (DiscreteOFE Val)}
                        (glookup (gmap_singleton k (just (excl new))) k)
                        (glookup frame k) =>
                  glookup_op (gmap_singleton k (just (excl new))) frame k
                | rhs_new_eq :
                    glookup (G.op (G.op (gmap_singleton k (just (excl new))) frame) z) k
                    = option_op {ExclUCMRA (DiscreteOFE Val)}
                        (option_op {ExclUCMRA (DiscreteOFE Val)}
                          (just (just (excl new))) (glookup frame k))
                        (glookup z k) =>
                  rhs_step
                  *> pmap (\lam o => option_op {ExclUCMRA (DiscreteOFE Val)} o (glookup z k))
                      (inner_step_new
                       *> pmap (\lam o => option_op {ExclUCMRA (DiscreteOFE Val)} o (glookup frame k))
                           (glookup_singleton_eq k (just (excl new))))
                | rhs_old_step : glookup (G.op (G.op (gmap_singleton k (just (excl old))) frame) z) k
                    = option_op {ExclUCMRA (DiscreteOFE Val)}
                        (glookup (G.op (gmap_singleton k (just (excl old))) frame) k)
                        (glookup z k) =>
                  glookup_op (G.op (gmap_singleton k (just (excl old))) frame) z k
                | inner_step_old : glookup (G.op (gmap_singleton k (just (excl old))) frame) k
                    = option_op {ExclUCMRA (DiscreteOFE Val)}
                        (glookup (gmap_singleton k (just (excl old))) k)
                        (glookup frame k) =>
                  glookup_op (gmap_singleton k (just (excl old))) frame k
                | rhs_old_eq :
                    glookup (G.op (G.op (gmap_singleton k (just (excl old))) frame) z) k
                    = option_op {ExclUCMRA (DiscreteOFE Val)}
                        (option_op {ExclUCMRA (DiscreteOFE Val)}
                          (just (just (excl old))) (glookup frame k))
                        (glookup z k) =>
                  rhs_old_step
                  *> pmap (\lam o => option_op {ExclUCMRA (DiscreteOFE Val)} o (glookup z k))
                      (inner_step_old
                       *> pmap (\lam o => option_op {ExclUCMRA (DiscreteOFE Val)} o (glookup frame k))
                           (glookup_singleton_eq k (just (excl old))))
                | old_point : (OptionOFE (ExclUCMRA (DiscreteOFE Val))).dist n
                    (just (just (excl old)))
                    (option_op {ExclUCMRA (DiscreteOFE Val)}
                      (option_op {ExclUCMRA (DiscreteOFE Val)}
                        (just (just (excl old))) (glookup frame k))
                      (glookup z k)) =>
                  transport2
                    (\lam u v => (OptionOFE (ExclUCMRA (DiscreteOFE Val))).dist n u v)
                    lookup_old
                    rhs_old_eq
                    (hz k)
              \in transport2
                  (\lam u v => (OptionOFE (ExclUCMRA (DiscreteOFE Val))).dist n u v)
                  (inv lhs_eq)
                  (inv rhs_new_eq)
                  (heap_replace_point_dist n old new (glookup frame k) (glookup z k) old_point))
          | no np =>
            \let
              | ne : Not (k = k') => \lam q => np (inv q)
              | lhs_ne : glookup (heap_update m k new) k' = glookup m k' =>
                glookup_insert_ne k k' (just (excl new)) m ne
              | sing_new_ne : glookup (gmap_singleton k (just (excl new))) k' = nothing =>
                glookup_insert_ne k k' (just (excl new)) gempty ne *> glookup_empty k'
              | sing_old_ne : glookup (gmap_singleton k (just (excl old))) k' = nothing =>
                glookup_insert_ne k k' (just (excl old)) gempty ne *> glookup_empty k'
              | rhs_new_step : glookup (G.op (G.op (gmap_singleton k (just (excl new))) frame) z) k'
                  = option_op {ExclUCMRA (DiscreteOFE Val)}
                      (glookup (G.op (gmap_singleton k (just (excl new))) frame) k')
                      (glookup z k') =>
                glookup_op (G.op (gmap_singleton k (just (excl new))) frame) z k'
              | inner_new : glookup (G.op (gmap_singleton k (just (excl new))) frame) k'
                  = option_op {ExclUCMRA (DiscreteOFE Val)}
                      (glookup (gmap_singleton k (just (excl new))) k')
                      (glookup frame k') =>
                glookup_op (gmap_singleton k (just (excl new))) frame k'
              | rhs_new_simpl :
                  glookup (G.op (G.op (gmap_singleton k (just (excl new))) frame) z) k'
                  = option_op {ExclUCMRA (DiscreteOFE Val)}
                      (glookup frame k') (glookup z k') =>
                rhs_new_step
                *> pmap (\lam o => option_op {ExclUCMRA (DiscreteOFE Val)} o (glookup z k'))
                    (inner_new
                     *> pmap (\lam o => option_op {ExclUCMRA (DiscreteOFE Val)} o (glookup frame k')) sing_new_ne
                     *> option_op_nothing_l (glookup frame k'))
              | rhs_old_step : glookup (G.op (G.op (gmap_singleton k (just (excl old))) frame) z) k'
                  = option_op {ExclUCMRA (DiscreteOFE Val)}
                      (glookup (G.op (gmap_singleton k (just (excl old))) frame) k')
                      (glookup z k') =>
                glookup_op (G.op (gmap_singleton k (just (excl old))) frame) z k'
              | inner_old : glookup (G.op (gmap_singleton k (just (excl old))) frame) k'
                  = option_op {ExclUCMRA (DiscreteOFE Val)}
                      (glookup (gmap_singleton k (just (excl old))) k')
                      (glookup frame k') =>
                glookup_op (gmap_singleton k (just (excl old))) frame k'
              | rhs_old_simpl :
                  glookup (G.op (G.op (gmap_singleton k (just (excl old))) frame) z) k'
                  = option_op {ExclUCMRA (DiscreteOFE Val)}
                      (glookup frame k') (glookup z k') =>
                rhs_old_step
                *> pmap (\lam o => option_op {ExclUCMRA (DiscreteOFE Val)} o (glookup z k'))
                    (inner_old
                     *> pmap (\lam o => option_op {ExclUCMRA (DiscreteOFE Val)} o (glookup frame k')) sing_old_ne
                     *> option_op_nothing_l (glookup frame k'))
            \in transport2
                (\lam u v => (OptionOFE (ExclUCMRA (DiscreteOFE Val))).dist n u v)
                (inv lhs_ne)
                (rhs_old_simpl *> inv rhs_new_simpl)
                (hz k')
        })
  }

\lemma heap_auth_alloc_validN {Loc : \Set} {cnt : Countable Loc} {Val : \Set}
                              (n : Nat)
                              (h : Gmap Loc cnt (Maybe (Excl Val))) (l : Loc) (v : Val)
                              (z yf : (HeapCMRA Loc cnt Val).E)
                              (fresh : glookup h l = nothing)
                              (hv : (HeapCMRA Loc cnt Val).validN n
                                ((HeapCMRA Loc cnt Val).op
                                  ((HeapCMRA Loc cnt Val).op (heap_auth h) z) yf))
  : (HeapCMRA Loc cnt Val).validN n
      ((HeapCMRA Loc cnt Val).op
        ((HeapCMRA Loc cnt Val).op
          ((HeapCMRA Loc cnt Val).op (heap_auth (heap_update h l v)) (heap_frag l v)) z) yf)
  \elim z, yf
  | (nothing, zf), (nothing, yff) =>
    \let
      | G => GmapUCMRA Loc cnt (ExclUCMRA (DiscreteOFE Val))
      | sing : G.E => gmap_singleton l (just (excl v))
      | frame : G.E => G.op (G.op G.unit zf) yff
      | hv_old : AuthValidN {G} n (just (excl h), frame) => hv
      | hincl_new_raw : inclN {G} {\new Op G.E { | op => G.op }}
          (G.op sing frame) n (heap_update h l v) =>
        gmap_alloc_includedN {Loc} {cnt} {ExclUCMRA (DiscreteOFE Val)}
          n h frame l (just (excl v)) fresh hv_old.2
      | hincl_new : inclN {G} {\new Op G.E { | op => G.op }}
          (G.op (G.op (G.op G.unit sing) zf) yff) n (heap_update h l v) =>
        \case hincl_new_raw \with {
          | inP (w, hw) =>
            \let
              -- Need: G.dist n (G.op sing frame) (G.op (G.op (G.op G.unit sing) zf) yff).
              -- frame = G.op (G.op G.unit zf) yff. Reassoc step-by-step.
              | step_inner : G.dist n (G.op sing G.unit) (G.op G.unit sing) =>
                G.ofe_dist_trans n (G.op sing G.unit) sing (G.op G.unit sing)
                    (ucmra_unit_right_id_dist n sing)
                    (G.ofe_dist_sym n (G.op G.unit sing) sing (ucmra_unit_left_id_dist n sing))
              | step_mid : G.dist n (G.op sing (G.op G.unit zf)) (G.op (G.op G.unit sing) zf) =>
                G.ofe_dist_trans n
                    (G.op sing (G.op G.unit zf))
                    (G.op (G.op sing G.unit) zf)
                    (G.op (G.op G.unit sing) zf)
                    (cmra_assoc_dist n sing G.unit zf)
                    (G.cmra_op_ne_2 zf n (G.op sing G.unit) (G.op G.unit sing) step_inner)
              | rearr_dist : G.dist n (G.op sing frame) (G.op (G.op (G.op G.unit sing) zf) yff) =>
                G.ofe_dist_trans n
                    (G.op sing frame)
                    (G.op (G.op sing (G.op G.unit zf)) yff)
                    (G.op (G.op (G.op G.unit sing) zf) yff)
                    (cmra_assoc_dist n sing (G.op G.unit zf) yff)
                    (G.cmra_op_ne_2 yff n (G.op sing (G.op G.unit zf)) (G.op (G.op G.unit sing) zf) step_mid)
            \in
            inP (w,
              G.ofe_dist_trans n (heap_update h l v) (G.op (G.op sing frame) w) (G.op (G.op (G.op (G.op G.unit sing) zf) yff) w)
                  hw
                  (G.cmra_op_ne_2 w n (G.op sing frame) (G.op (G.op (G.op G.unit sing) zf) yff) rearr_dist))
        }
    \in (heap_update_validN n h l v hv_old.1, hincl_new)
  | (nothing, _), (just (excl _), _) => \case hv \with {}
  | (nothing, _), (just exclInvalid, _) => \case hv \with {}
  | (just (excl _), _), (nothing, _) => \case hv \with {}
  | (just (excl _), _), (just (excl _), _) => \case hv \with {}
  | (just (excl _), _), (just exclInvalid, _) => \case hv \with {}
  | (just exclInvalid, _), (nothing, _) => \case hv \with {}
  | (just exclInvalid, _), (just (excl _), _) => \case hv \with {}
  | (just exclInvalid, _), (just exclInvalid, _) => \case hv \with {}

-- Helper: rearrange `G.op X (G.op (G.op G.unit Y) Z)` to
-- `G.op (G.op (G.op G.unit X) Y) Z` up to `dist n`. Used by alloc/store proofs.
\lemma frame_rearr_dist {G : UCMRA} (n : Nat) (X Y Z : G.E)
  : G.dist n (G.op X (G.op (G.op G.unit Y) Z))
             (G.op (G.op (G.op G.unit X) Y) Z) =>
  \let
    | step_inner : G.dist n (G.op X G.unit) (G.op G.unit X) =>
      G.ofe_dist_trans n (G.op X G.unit) X (G.op G.unit X)
          (ucmra_unit_right_id_dist n X)
          (G.ofe_dist_sym n (G.op G.unit X) X (ucmra_unit_left_id_dist n X))
    | step_mid : G.dist n (G.op X (G.op G.unit Y)) (G.op (G.op G.unit X) Y) =>
      G.ofe_dist_trans n
          (G.op X (G.op G.unit Y))
          (G.op (G.op X G.unit) Y)
          (G.op (G.op G.unit X) Y)
          (cmra_assoc_dist n X G.unit Y)
          (G.cmra_op_ne_2 Y n (G.op X G.unit) (G.op G.unit X) step_inner)
  \in G.ofe_dist_trans n
        (G.op X (G.op (G.op G.unit Y) Z))
        (G.op (G.op X (G.op G.unit Y)) Z)
        (G.op (G.op (G.op G.unit X) Y) Z)
        (cmra_assoc_dist n X (G.op G.unit Y) Z)
        (G.cmra_op_ne_2 Z n (G.op X (G.op G.unit Y)) (G.op (G.op G.unit X) Y) step_mid)

\lemma heap_auth_store_validN {cnt : Countable Loc} {Val : \Set}
                              (n : Nat)
                              (h : Gmap Loc cnt (Maybe (Excl Val))) (l : Loc)
                              (old new : Val)
                              (z yf : (HeapCMRA Loc cnt Val).E)
                              (lookup_old : glookup h l = just (just (excl old)))
                              (hv : (HeapCMRA Loc cnt Val).validN n
                                ((HeapCMRA Loc cnt Val).op
                                  ((HeapCMRA Loc cnt Val).op
                                    ((HeapCMRA Loc cnt Val).op (heap_auth h) (heap_frag l old)) z) yf))
  : (HeapCMRA Loc cnt Val).validN n
      ((HeapCMRA Loc cnt Val).op
        ((HeapCMRA Loc cnt Val).op
          ((HeapCMRA Loc cnt Val).op (heap_auth (heap_update h l new)) (heap_frag l new)) z) yf)
  \elim z, yf
  | (nothing, zf), (nothing, yff) =>
    \let
      | G => GmapUCMRA Loc cnt (ExclUCMRA (DiscreteOFE Val))
      | singNew : G.E => gmap_singleton l (just (excl new))
      | frame : G.E => G.op (G.op G.unit zf) yff
      | hv_old : AuthValidN {G} n (just (excl h),
          G.op (G.op (G.op G.unit (gmap_singleton l (just (excl old)))) zf) yff) => hv
      | hincl_old_rearranged : inclN {G} {\new Op G.E { | op => G.op }}
          (G.op (gmap_singleton l (just (excl old))) frame) n h =>
        \case hv_old.2 \with {
          | inP (w, hw) => inP (w,
            \let
              | sing_old : G.E => gmap_singleton l (just (excl old))
              | rearr_dist_sym : G.dist n
                  (G.op (G.op (G.op G.unit sing_old) zf) yff)
                  (G.op sing_old frame) =>
                G.ofe_dist_sym n (G.op sing_old frame)
                                 (G.op (G.op (G.op G.unit sing_old) zf) yff)
                    (frame_rearr_dist n sing_old zf yff)
            \in G.ofe_dist_trans n h
                  (G.op (G.op (G.op (G.op G.unit sing_old) zf) yff) w)
                  (G.op (G.op sing_old frame) w)
                  hw
                  (G.cmra_op_ne_2 w n
                    (G.op (G.op (G.op G.unit sing_old) zf) yff)
                    (G.op sing_old frame)
                    rearr_dist_sym))
        }
      | hincl_new_raw : inclN {G} {\new Op G.E { | op => G.op }}
          (G.op singNew frame) n (heap_update h l new) =>
        gmap_replace_includedN {cnt} {Val}
          n h frame l old new lookup_old hincl_old_rearranged
      | hincl_new : inclN {G} {\new Op G.E { | op => G.op }}
          (G.op (G.op (G.op G.unit singNew) zf) yff) n (heap_update h l new) =>
        \case hincl_new_raw \with {
          | inP (w, hw) =>
            inP (w,
              G.ofe_dist_trans n (heap_update h l new)
                  (G.op (G.op singNew frame) w)
                  (G.op (G.op (G.op (G.op G.unit singNew) zf) yff) w)
                  hw
                  (G.cmra_op_ne_2 w n
                    (G.op singNew frame)
                    (G.op (G.op (G.op G.unit singNew) zf) yff)
                    (frame_rearr_dist n singNew zf yff)))
        }
    \in (heap_update_validN n h l new hv_old.1, hincl_new)
  | (nothing, _), (just (excl _), _) => \case hv \with {}
  | (nothing, _), (just exclInvalid, _) => \case hv \with {}
  | (just (excl _), _), (nothing, _) => \case hv \with {}
  | (just (excl _), _), (just (excl _), _) => \case hv \with {}
  | (just (excl _), _), (just exclInvalid, _) => \case hv \with {}
  | (just exclInvalid, _), (nothing, _) => \case hv \with {}
  | (just exclInvalid, _), (just (excl _), _) => \case hv \with {}
  | (just exclInvalid, _), (just exclInvalid, _) => \case hv \with {}

\func heap_alloc {Loc : \Set} {cnt : Countable Loc} {Val : \Set}
                 (h : Gmap Loc cnt (Maybe (Excl Val))) (l : Loc) (v : Val)
  : Gmap Loc cnt (Maybe (Excl Val)) =>
  heap_update h l v


\func nat_max (n m : Nat) : Nat \elim n, m
  | 0, m => m
  | suc n, 0 => suc n
  | suc n, suc m => suc (nat_max n m)

\lemma nat_max_le_l (n m : Nat) : n <= nat_max n m \elim n, m
  | 0, m => zero<=_
  | suc n, 0 => <=-refl
  | suc n, suc m => suc<=suc (nat_max_le_l n m)

\lemma nat_max_le_r (n m : Nat) : m <= nat_max n m \elim n, m
  | 0, m => <=-refl
  | suc n, 0 => zero<=_
  | suc n, suc m => suc<=suc (nat_max_le_r n m)

\lemma not_suc_le_self (n : Nat) : Not (suc n <= n)
  => \lam h => LinearOrder.notLess <=-refl (suc_<=_< h)

\func heap_tree_max {A : \Set} (t : Pmap' (\Sigma Loc A)) : Nat \elim t
  | PEmpty => 0
  | PNode nothing l r => nat_max (heap_tree_max l) (heap_tree_max r)
  | PNode (just p) l r => nat_max p.1 (nat_max (heap_tree_max l) (heap_tree_max r))

\lemma heap_tree_lookup_le {A : \Set} (t : Pmap' (\Sigma Loc A)) (q : Pos) (p : \Sigma Loc A)
                           (h : plookup' t q = just p)
  : p.1 <= heap_tree_max t
\elim t, q
  | PEmpty, _ => \case h \with {}
  | PNode nothing l r, xH => \case h \with {}
  | PNode (just p0) l r, xH =>
    \let hp : p0.1 = p.1 =>
      pmap (\lam o => \case o \with {
        | nothing => p0.1
        | just p' => p'.1
      }) h
    \in transport (\lam a => a <= nat_max p0.1 (nat_max (heap_tree_max l) (heap_tree_max r)))
         hp
         (nat_max_le_l p0.1 (nat_max (heap_tree_max l) (heap_tree_max r)))
  | PNode nothing l r, xO q' =>
    <=-transitive (heap_tree_lookup_le l q' p h)
      (nat_max_le_l (heap_tree_max l) (heap_tree_max r))
  | PNode nothing l r, xI q' =>
    <=-transitive (heap_tree_lookup_le r q' p h)
      (nat_max_le_r (heap_tree_max l) (heap_tree_max r))
  | PNode (just p0) l r, xO q' =>
    <=-transitive
      (heap_tree_lookup_le l q' p h)
      (<=-transitive
        (nat_max_le_l (heap_tree_max l) (heap_tree_max r))
        (nat_max_le_r p0.1 (nat_max (heap_tree_max l) (heap_tree_max r))))
  | PNode (just p0) l r, xI q' =>
    <=-transitive
      (heap_tree_lookup_le r q' p h)
      (<=-transitive
        (nat_max_le_r (heap_tree_max l) (heap_tree_max r))
        (nat_max_le_r p0.1 (nat_max (heap_tree_max l) (heap_tree_max r))))

\func heap_fresh_loc {cnt : Countable Loc} (s : State cnt)
  : \Sigma (l : Loc) (glookup s.heap l = nothing)
  =>
    \let
      | b : Nat => heap_tree_max s.heap.gtree.tree
      | l : Loc => suc b
      | fresh : glookup s.heap l = nothing =>
        \case plookup s.heap.gtree (encode {cnt} l) \as o,
              idp : plookup s.heap.gtree (encode {cnt} l) = o
        \return (\case o \with { | nothing => nothing | just p => just p.2 }) = nothing
        \with {
          | nothing, _ => idp
          | just p, hp =>
            \let
              | hp_loc : p.1 = l =>
                encode_inj {cnt} p.1 l (s.heap.gtree_wf (encode {cnt} l) p hp)
              | le_p : p.1 <= b =>
                heap_tree_lookup_le s.heap.gtree.tree (encode {cnt} l) p hp
              | le_l : l <= b =>
                transport (\lam a => a <= b) hp_loc le_p
            \in absurd (not_suc_le_self b le_l)
        }
    \in (l, fresh)

\func singleton_includedN_l
  {K : \Set} {cnt : Countable K} {A : UCMRA}
  (n : Nat) (m : Gmap K cnt A.E) (k : K) (x : A.E)
  (h : inclN {GmapUCMRA K cnt A}
      {\new Op _ { | op => (GmapUCMRA K cnt A).op }}
      (gmap_singleton k x) n m)
  : \Sigma (y : A.E)
           ((OptionOFE A).dist n (glookup m k) (just y))
           (inclN {A} {\new Op A.E { | op => A.op }} x n y)
  => \case glookup m k \as mx, idp : glookup m k = mx
  \return \Sigma (y : A.E)
           ((OptionOFE A).dist n mx (just y))
           (inclN {A} {\new Op A.E { | op => A.op }} x n y)
  \with {
    | nothing, hm => absurd (singleton_includedN_l.empty_absurd n m k x h hm)
    | just y, hm =>
      (y,
       (OptionOFE A).ofe_dist_refl n (just y),
       singleton_includedN_l.just_incl n m k x y h hm)
  }
  \where {
    \func point_dist
      {K : \Set} {cnt : Countable K} {A : UCMRA}
      (n : Nat) (m : Gmap K cnt A.E) (k : K) (x : A.E)
      (z : Gmap K cnt A.E)
      (hz : (GmapUCMRA K cnt A).dist n m ((GmapUCMRA K cnt A).op (gmap_singleton k x) z))
      : (OptionOFE A).dist n (glookup m k) (option_op {A} (just x) (glookup z k))
      =>
        \let
          | rhs_eq : glookup ((GmapUCMRA K cnt A).op (gmap_singleton k x) z) k
            = option_op {A} (just x) (glookup z k)
          => glookup_op (gmap_singleton k x) z k
             *> pmap (\lam o => option_op {A} o (glookup z k))
                  (glookup_singleton_eq k x)
        \in transport (\lam o => (OptionOFE A).dist n (glookup m k) o) rhs_eq (hz k)

    \func empty_absurd
      {K : \Set} {cnt : Countable K} {A : UCMRA}
      (n : Nat) (m : Gmap K cnt A.E) (k : K) (x : A.E)
      (h : inclN {GmapUCMRA K cnt A}
          {\new Op _ { | op => (GmapUCMRA K cnt A).op }}
          (gmap_singleton k x) n m)
      (hm : glookup m k = nothing)
      : Empty
      => \case h \with {
        | inP (z, hz) =>
          empty_absurd_case n x (glookup z k)
            (transport (\lam o => (OptionOFE A).dist n o (option_op {A} (just x) (glookup z k)))
              hm
              (point_dist n m k x z hz))
      }

    \func empty_absurd_case
      {A : UCMRA} (n : Nat) (x : A.E) (mz : Maybe A.E)
      (hdist : (OptionOFE A).dist n nothing (option_op {A} (just x) mz))
      : Empty
    \elim mz
      | nothing => \case hdist \with {}
      | just w => \case hdist \with {}

    \func just_incl
      {K : \Set} {cnt : Countable K} {A : UCMRA}
      (n : Nat) (m : Gmap K cnt A.E) (k : K) (x y : A.E)
      (h : inclN {GmapUCMRA K cnt A}
          {\new Op _ { | op => (GmapUCMRA K cnt A).op }}
          (gmap_singleton k x) n m)
      (hm : glookup m k = just y)
      : inclN {A} {\new Op A.E { | op => A.op }} x n y
      => \case h \with {
        | inP (z, hz) =>
          just_incl_case n x y (glookup z k)
            (transport (\lam o => (OptionOFE A).dist n o (option_op {A} (just x) (glookup z k)))
              hm
              (point_dist n m k x z hz))
      }

    \func just_incl_case
      {A : UCMRA} (n : Nat) (x y : A.E) (mz : Maybe A.E)
      (hdist : (OptionOFE A).dist n (just y) (option_op {A} (just x) mz))
      : inclN {A} {\new Op A.E { | op => A.op }} x n y
    \elim mz
      | nothing =>
        inP (A.unit,
          A.ofe_dist_trans n y x (A.op x A.unit)
              hdist
              (A.ofe_dist_sym n (A.op x A.unit) x (ucmra_unit_right_id_dist n x)))
      | just w => inP (w, hdist)
  }

\func excl_some_includedN_eq
  {V : \Set} (n : Nat) (v : V) (y : Excl V)
  (hv : validN {ExclUCMRA (DiscreteOFE V)} n (just y))
  (h  : inclN {ExclUCMRA (DiscreteOFE V)}
      {\new Op _ { | op => (ExclUCMRA (DiscreteOFE V)).op }}
      (just (excl v)) n (just y))
  : y = excl v
  => \case h \with {
    | inP (z, hz) =>
      \case \elim z, \elim y, hv, hz \with {
        | nothing, excl a,        _,  hdist => excl_dist_to_eq V n (excl a) (excl v) hdist
        | nothing, exclInvalid,   hv, _     => absurd hv
        | just e,  excl a,        _,  hdist => \case hdist \with {}
        | just e,  exclInvalid,   hv, _     => absurd hv
      }
  }

\func glookup_of_pomap_pair
  {K : \Set} {cnt : Countable K} {V V' : \Set}
  (f : V -> V')
  (g : Gmap K cnt V) (k : K)
  (g' : Gmap K cnt V')
  (gtree_eq : g'.gtree
    = pomap (\lam (p : \Sigma K V) => just (p.1, f p.2)) g.gtree)
  : \Sigma (mv : Maybe V)
           (glookup g k = mv)
           (glookup g' k = \case mv \with {
             | nothing => nothing
             | just w  => just (f w)
           })
  =>
    \let
      | tag : \Sigma K V -> Maybe (\Sigma K V')
      => \lam p => just (p.1, f p.2)
      | q : Pos => encode {cnt} k
      | pl_pomap : plookup (pomap tag g.gtree) q
        = pomap_tree.option_bind tag (plookup g.gtree q)
      => plookup_pomap tag g.gtree q
      | pl_g' : plookup g'.gtree q
        = pomap_tree.option_bind tag (plookup g.gtree q)
      => pmap (\lam t => plookup t q) gtree_eq *> pl_pomap
    \in \case plookup g.gtree q \as p,
              idp : plookup g.gtree q = p
    \with {
      | nothing, hp =>
        \let
          | hg : glookup g k = nothing
          => path (\lam i => \case hp @ i \with {
              | nothing  => nothing
              | just pp  => just pp.2
            })
          | pl_g'_n : plookup g'.gtree q = nothing
          => pl_g' *> pmap (pomap_tree.option_bind tag) hp
          | hg' : glookup g' k = nothing
          => path (\lam i => \case pl_g'_n @ i \with {
              | nothing  => nothing
              | just pp  => just pp.2
            })
        \in (nothing, hg, hg')
      | just pp, hp =>
        \let
          | hg : glookup g k = just pp.2
          => path (\lam i => \case hp @ i \with {
              | nothing  => nothing
              | just qq  => just qq.2
            })
          | pl_g'_j : plookup g'.gtree q = just (pp.1, f pp.2)
          => pl_g' *> pmap (pomap_tree.option_bind tag) hp
          | hg' : glookup g' k = just (f pp.2)
          => path (\lam i => \case pl_g'_j @ i \with {
              | nothing  => nothing
              | just qq  => just qq.2
            })
        \in (just pp.2, hg, hg')
    }
