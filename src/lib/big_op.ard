\import Logic
\import Paths
\import Set
\import Arith.Nat
\import Order.PartialOrder
\import Data.Maybe
\import Data.List (List, nil, ::, ++, ++-assoc)
\import ofe
\import cmra
\import uPred \hiding (own_valid, own_mono)
\import lib.gmap_cmra
\import lib.pmap

-- =================================================================================
-- Big ops over lists and gmaps (Rocq: `algebra/big_op.v`, specialised to the
-- `sep` monoid of `ProperUPred M`).
--
--   big_opM o f m := big_opL o (λ _ '(k,x), f k x) (map_to_list m)
--
-- is mirrored literally: `gmap_to_list` reads the entries off the underlying
-- radix tree (which stores `(key, value)` pairs), and `big_sepM` is `big_sepL`
-- over it.
--
-- The workhorse lemma is `big_sepM_extract`: the entry at a present key can be
-- split off the big op and put back — the Arend stand-in for Rocq's
-- `big_sepM_delete` (we decompose the entry list in place instead of using
-- `delete`, which the `Gmap` library does not provide).
-- =================================================================================

\func big_sepL {M : UCMRA} {A : \Type} (Phi : A -> ProperUPred M) (l : List A)
  : ProperUPred M \elim l
  | nil => mkProperEmp
  | :: a l => mkProperSep (Phi a) (big_sepL Phi l)

\func gmap_to_list {K : \Set} {cnt : Countable K} {A : \Set} (m : Gmap K cnt A)
  : List (\Sigma K A) => strip (pmap_to_list m.gtree)
  \where
    \func strip {K A : \Set} (l : List (\Sigma Pos (\Sigma K A))) : List (\Sigma K A) \elim l
      | nil => nil
      | :: e l => e.2 :: strip l

\func big_sepM {M : UCMRA} {K : \Set} {cnt : Countable K} {A : \Set}
               (m : Gmap K cnt A) (Phi : K -> A -> ProperUPred M)
  : ProperUPred M => big_sepL (\lam e => Phi e.1 e.2) (gmap_to_list m)

-- =================================================================================
-- Entailment-level sep shuffles, proved directly at the model level.
-- =================================================================================

-- P ∗ (Q ∗ R) ⊢ Q ∗ (P ∗ R)
\lemma sep_swap_ent {M : UCMRA} (P Q R : ProperUPred M)
  : properUPred_ent (mkProperSep P (mkProperSep Q R)) (mkProperSep Q (mkProperSep P R))
  => \lam n x hv h => \case h \with {
    | inP (a, b, dab, hP, hQR) => \case hQR \with {
      | inP (c, d, dcd, hQ, hR) =>
        inP (c, M.op a d,
            -- x ≡ a·b ≡ a·(c·d) ≡ (a·c)·d ≡ (c·a)·d ≡ c·(a·d)
            M.ofe_dist_trans n x (M.op a (M.op c d)) (M.op c (M.op a d))
                (M.ofe_dist_trans n x (M.op a b) (M.op a (M.op c d))
                    dab (M.cmra_op_ne a n b (M.op c d) dcd))
                (M.ofe_dist_trans n (M.op a (M.op c d)) (M.op (M.op a c) d) (M.op c (M.op a d))
                    (cmra_assoc_dist {M} n a c d)
                    (M.ofe_dist_trans n (M.op (M.op a c) d) (M.op (M.op c a) d) (M.op c (M.op a d))
                        (M.cmra_op_ne_2 d n (M.op a c) (M.op c a) (cmra_comm_dist {M} n a c))
                        (M.ofe_dist_sym n (M.op c (M.op a d)) (M.op (M.op c a) d)
                            (cmra_assoc_dist {M} n c a d)))),
            hQ,
            inP (a, d, M.ofe_dist_refl n (M.op a d), hP, hR))
    }
  }

\lemma sep_mono_r_ent {M : UCMRA} (P Q Q' : ProperUPred M)
    (h : properUPred_ent Q Q')
  : properUPred_ent (mkProperSep P Q) (mkProperSep P Q')
  => \lam n x hv hs => \case hs \with {
    | inP (a, b, dab, hP, hQ) =>
      inP (a, b, dab, hP,
          h n b (cmra_validN_op_r {M} n a b (M.cmra_validN_ne n x (M.op a b) dab hv)) hQ)
  }

-- =================================================================================
-- Splitting a big_sepL at a distinguished entry.
-- =================================================================================

\lemma big_sepL_extract_1 {M : UCMRA} {A : \Type} (Phi : A -> ProperUPred M)
    (l1 l2 : List A) (a : A)
  : properUPred_ent (big_sepL Phi (l1 ++ a :: l2))
                    (mkProperSep (Phi a) (big_sepL Phi (l1 ++ l2)))
\elim l1
  | nil => properUPred_ent_refl (big_sepL Phi (a :: l2))
  | :: b l1 =>
      properUPred_ent_trans
        (mkProperSep (Phi b) (big_sepL Phi (l1 ++ a :: l2)))
        (mkProperSep (Phi b) (mkProperSep (Phi a) (big_sepL Phi (l1 ++ l2))))
        (mkProperSep (Phi a) (mkProperSep (Phi b) (big_sepL Phi (l1 ++ l2))))
        (sep_mono_r_ent (Phi b) (big_sepL Phi (l1 ++ a :: l2))
            (mkProperSep (Phi a) (big_sepL Phi (l1 ++ l2)))
            (big_sepL_extract_1 Phi l1 l2 a))
        (sep_swap_ent (Phi b) (Phi a) (big_sepL Phi (l1 ++ l2)))

\lemma big_sepL_extract_2 {M : UCMRA} {A : \Type} (Phi : A -> ProperUPred M)
    (l1 l2 : List A) (a : A)
  : properUPred_ent (mkProperSep (Phi a) (big_sepL Phi (l1 ++ l2)))
                    (big_sepL Phi (l1 ++ a :: l2))
\elim l1
  | nil => properUPred_ent_refl (big_sepL Phi (a :: l2))
  | :: b l1 =>
      properUPred_ent_trans
        (mkProperSep (Phi a) (mkProperSep (Phi b) (big_sepL Phi (l1 ++ l2))))
        (mkProperSep (Phi b) (mkProperSep (Phi a) (big_sepL Phi (l1 ++ l2))))
        (mkProperSep (Phi b) (big_sepL Phi (l1 ++ a :: l2)))
        (sep_swap_ent (Phi a) (Phi b) (big_sepL Phi (l1 ++ l2)))
        (sep_mono_r_ent (Phi b) (mkProperSep (Phi a) (big_sepL Phi (l1 ++ l2)))
            (big_sepL Phi (l1 ++ a :: l2))
            (big_sepL_extract_2 Phi l1 l2 a))

-- =================================================================================
-- Decomposing the entry list of a map at a present key.
-- =================================================================================

-- Tree level: a present key contributes its entry at a determined position of
-- the in-order traversal.
\func pmap_to_list_tree_decomp {A : \Set} (t : Pmap' A) (prefix : Pos -> Pos)
    (k : Pos) (a : A) (h : plookup' t k = just a)
  : \Sigma (l1 l2 : List (\Sigma Pos A))
           (pmap_to_list_tree t prefix = l1 ++ (prefix k, a) :: l2)
\elim t, k
  | PEmpty, k => \case h \with {}
  | PNode v l r, xH =>
      ( nil
      , pmap_to_list_tree l (\lam q => prefix (xO q))
          ++ pmap_to_list_tree r (\lam q => prefix (xI q))
      , pmap (\lam (o : Maybe A) =>
                (\case o \return List (\Sigma Pos A) \with {
                   | nothing => nil
                   | just x  => (prefix xH, x) :: nil
                 })
                ++ (pmap_to_list_tree l (\lam q => prefix (xO q))
                     ++ pmap_to_list_tree r (\lam q => prefix (xI q))))
             h)
  | PNode v l r, xO q =>
      \let
        | (l1', l2', p) => pmap_to_list_tree_decomp l (\lam q' => prefix (xO q')) q a h
        | here => \case v \return List (\Sigma Pos A) \with {
            | nothing => nil
            | just x  => (prefix xH, x) :: nil
          }
        | rt => pmap_to_list_tree r (\lam q' => prefix (xI q'))
      \in ( here ++ l1'
          , l2' ++ rt
          , pmap (\lam u => here ++ (u ++ rt)) p
              *> pmap (here ++ __)
                   (++-assoc {\Sigma Pos A} {l1'} {(prefix (xO q), a) :: l2'} {rt})
              *> inv (++-assoc {\Sigma Pos A} {here} {l1'} {(prefix (xO q), a) :: (l2' ++ rt)}))
  | PNode v l r, xI q =>
      \let
        | (l1', l2', p) => pmap_to_list_tree_decomp r (\lam q' => prefix (xI q')) q a h
        | here => \case v \return List (\Sigma Pos A) \with {
            | nothing => nil
            | just x  => (prefix xH, x) :: nil
          }
        | lt => pmap_to_list_tree l (\lam q' => prefix (xO q'))
      \in ( here ++ lt ++ l1'
          , l2'
          , pmap (\lam u => here ++ (lt ++ u)) p
              *> pmap (here ++ __)
                   (inv (++-assoc {\Sigma Pos A} {lt} {l1'} {(prefix (xI q), a) :: l2'}))
              *> inv (++-assoc {\Sigma Pos A} {here} {lt ++ l1'} {(prefix (xI q), a) :: l2'}))

\lemma strip_append {K A : \Set} (l1 l2 : List (\Sigma Pos (\Sigma K A)))
  : gmap_to_list.strip (l1 ++ l2) = gmap_to_list.strip l1 ++ gmap_to_list.strip l2
\elim l1
  | nil => idp
  | :: e l1 => pmap (e.2 ::) (strip_append l1 l2)

-- Gmap level: `glookup m k = just v` yields a decomposition of the entry list
-- around `(k, v)`.
\func gmap_to_list_decomp {K : \Set} {cnt : Countable K} {A : \Set}
    (m : Gmap K cnt A) (k : K) (v : A) (h : glookup m k = just v)
  : \Sigma (l1 l2 : List (\Sigma K A)) (gmap_to_list m = l1 ++ (k, v) :: l2)
  => \case plookup m.gtree (encode {cnt} k) \as o,
           idp : plookup m.gtree (encode {cnt} k) = o
       \return \Sigma (l1 l2 : List (\Sigma K A)) (gmap_to_list m = l1 ++ (k, v) :: l2)
     \with {
       | nothing, ho =>
           \let bad : nothing = {Maybe A} just v =>
               inv (pmap (\lam (o : Maybe (\Sigma K A)) => \case o \return Maybe A \with {
                            | nothing => nothing
                            | just p  => just p.2
                          }) ho)
                 *> h
           \in \case bad \with {}
       | just p, ho =>
           \let
             | hv2 : p.2 = v =>
                 pmap (\lam (o : Maybe A) => \case o \return A \with {
                         | nothing => v
                         | just w  => w
                       })
                      (inv (pmap (\lam (o : Maybe (\Sigma K A)) => \case o \return Maybe A \with {
                                    | nothing => nothing
                                    | just q  => just q.2
                                  }) ho)
                        *> h)
             | hk : p.1 = k => encode_inj {cnt} p.1 k (m.gtree_wf (encode {cnt} k) p ho)
             | (t1, t2, ptree) =>
                 pmap_to_list_tree_decomp m.gtree.tree (\lam x => x) (encode {cnt} k) p ho
             | ppair : p = {\Sigma K A} (k, v) => path (\lam i => (hk @ i, hv2 @ i))
           \in ( gmap_to_list.strip t1
               , gmap_to_list.strip t2
               , pmap gmap_to_list.strip ptree
                   *> strip_append t1 ((encode {cnt} k, p) :: t2)
                   *> pmap (\lam e => gmap_to_list.strip t1 ++ e :: gmap_to_list.strip t2) ppair)
     }

-- =================================================================================
-- big_sepM_extract: the Rocq `big_sepM_delete` workhorse, packaged with the
-- rest `R` existentially so that both directions share the same `R`.
-- =================================================================================

\func big_sepM_extract {M : UCMRA} {K : \Set} {cnt : Countable K} {A : \Set}
    (m : Gmap K cnt A) (Phi : K -> A -> ProperUPred M) (k : K) (v : A)
    (h : glookup m k = just v)
  : \Sigma (R : ProperUPred M)
           (properUPred_ent (big_sepM m Phi) (mkProperSep (Phi k v) R))
           (properUPred_ent (mkProperSep (Phi k v) R) (big_sepM m Phi))
  => \let
       | (l1, l2, p) => gmap_to_list_decomp m k v h
       | Phi' => \lam (e : \Sigma K A) => Phi e.1 e.2
     \in ( big_sepL Phi' (l1 ++ l2)
         , transport (\lam l => properUPred_ent (big_sepL Phi' l)
                                  (mkProperSep (Phi k v) (big_sepL Phi' (l1 ++ l2))))
             (inv p) (big_sepL_extract_1 Phi' l1 l2 (k, v))
         , transport (\lam l => properUPred_ent (mkProperSep (Phi k v) (big_sepL Phi' (l1 ++ l2)))
                                  (big_sepL Phi' l))
             (inv p) (big_sepL_extract_2 Phi' l1 l2 (k, v))
         )

-- =================================================================================
-- Distance-level resource shuffles and validity extraction (semantic helpers
-- for the wsat open/close proofs; Rocq does these steps inside the proofmode).
-- =================================================================================

-- x ≡n x1·x2, x1 ≡n a, x2 ≡n b ⟹ x ≡n a·b
\lemma dist_op_congr {M : CMRA} (n : Nat) (x x1 x2 a b : M.E)
    (dx : M.dist n x (M.op x1 x2)) (da : M.dist n x1 a) (db : M.dist n x2 b)
  : M.dist n x (M.op a b)
  => M.ofe_dist_trans n x (M.op x1 x2) (M.op a b) dx
      (cmra_op_ne_both n x1 a x2 b da db)

-- (a·b)·(c·d) ≡n (a·c)·(b·d)
\lemma op_exchange_dist {M : CMRA} (n : Nat) (a b c d : M.E)
  : M.dist n (M.op (M.op a b) (M.op c d)) (M.op (M.op a c) (M.op b d))
  => M.ofe_dist_trans n (M.op (M.op a b) (M.op c d)) (M.op a (M.op b (M.op c d))) (M.op (M.op a c) (M.op b d))
      (M.ofe_dist_sym n (M.op a (M.op b (M.op c d))) (M.op (M.op a b) (M.op c d))
          (cmra_assoc_dist n a b (M.op c d)))
      (M.ofe_dist_trans n (M.op a (M.op b (M.op c d))) (M.op a (M.op (M.op b c) d)) (M.op (M.op a c) (M.op b d))
          (M.cmra_op_ne a n (M.op b (M.op c d)) (M.op (M.op b c) d) (cmra_assoc_dist n b c d))
          (M.ofe_dist_trans n (M.op a (M.op (M.op b c) d)) (M.op a (M.op (M.op c b) d)) (M.op (M.op a c) (M.op b d))
              (M.cmra_op_ne a n (M.op (M.op b c) d) (M.op (M.op c b) d)
                  (M.cmra_op_ne_2 d n (M.op b c) (M.op c b) (cmra_comm_dist n b c)))
              (M.ofe_dist_trans n (M.op a (M.op (M.op c b) d)) (M.op a (M.op c (M.op b d))) (M.op (M.op a c) (M.op b d))
                  (M.cmra_op_ne a n (M.op (M.op c b) d) (M.op c (M.op b d))
                      (M.ofe_dist_sym n (M.op c (M.op b d)) (M.op (M.op c b) d) (cmra_assoc_dist n c b d)))
                  (cmra_assoc_dist n a c (M.op b d)))))

-- Validity of the factors of an n-decomposition.
\lemma validN_sub_l {M : CMRA} (n : Nat) (x a b : M.E)
    (hv : M.validN n x) (d : M.dist n x (M.op a b)) : M.validN n a
  => M.cmra_validN_op_l n a b (M.cmra_validN_ne n x (M.op a b) d hv)

\lemma validN_sub_r {M : CMRA} (n : Nat) (x a b : M.E)
    (hv : M.validN n x) (d : M.dist n x (M.op a b)) : M.validN n b
  => cmra_validN_op_r n a b (M.cmra_validN_ne n x (M.op a b) d hv)

-- =================================================================================
-- Decomposing the entry list of a fresh-key insert (for Rocq `big_sepM_insert`).
--
-- `partial_alter'` builds nodes through the canonicalising `PNode'`; inserting
-- (the altered value is always `just`) never collapses a node, so we first
-- expose the constructor shape and then read the traversal off.
-- =================================================================================

-- `PNode'` reduces to `PNode` whenever a child is a node.
\lemma PNode'_node_l {A : \Set} (v a : Maybe A) (x y r : Pmap' A)
  : PNode' v (PNode a x y) r = PNode v (PNode a x y) r \elim v, r
  | nothing, PEmpty => idp
  | nothing, PNode _ _ _ => idp
  | just _, _ => idp

\lemma PNode'_node_r {A : \Set} (v : Maybe A) (l : Pmap' A) (a : Maybe A) (x y : Pmap' A)
  : PNode' v l (PNode a x y) = PNode v l (PNode a x y) \elim v, l
  | nothing, PEmpty => idp
  | nothing, PNode _ _ _ => idp
  | just _, _ => idp

-- Inserting always yields a node, with a computed shape.
\func pmap_insert_node {A : \Set} (b : A) (k : Pos) (t : Pmap' A)
  : \Sigma (v' : Maybe A) (l' r' : Pmap' A)
           (partial_alter' (\lam _ => just b) k t = PNode v' l' r')
\elim k, t
  | xH, PEmpty => (just b, PEmpty, PEmpty, idp)
  | xH, PNode v l r => (just b, l, r, idp)
  | xO q, PEmpty =>
      \let (v', l', r', p) => pmap_insert_node b q PEmpty
      \in (nothing, PNode v' l' r', PEmpty,
           pmap (\lam u => PNode' nothing u PEmpty) p
             *> PNode'_node_l nothing v' l' r' PEmpty)
  | xO q, PNode v l r =>
      \let (v', l', r', p) => pmap_insert_node b q l
      \in (v, PNode v' l' r', r,
           pmap (\lam u => PNode' v u r) p *> PNode'_node_l v v' l' r' r)
  | xI q, PEmpty =>
      \let (v', l', r', p) => pmap_insert_node b q PEmpty
      \in (nothing, PEmpty, PNode v' l' r',
           pmap (\lam u => PNode' nothing PEmpty u) p
             *> PNode'_node_r nothing PEmpty v' l' r')
  | xI q, PNode v l r =>
      \let (v', l', r', p) => pmap_insert_node b q r
      \in (v, l, PNode v' l' r',
           pmap (\lam u => PNode' v l u) p *> PNode'_node_r v l v' l' r')

-- Inserting into the empty tree contributes exactly the one new entry.
\lemma pmap_insert_empty_to_list {A : \Set} (b : A) (k : Pos) (prefix : Pos -> Pos)
  : pmap_to_list_tree (partial_alter' (\lam _ => just b) k PEmpty) prefix
      = (prefix k, b) :: nil
\elim k
  | xH => idp
  | xO q =>
      \let
        | (v', l', r', p) => pmap_insert_node b q PEmpty
        | inner : pmap_to_list_tree (PNode v' l' r') (\lam q' => prefix (xO q'))
              = (prefix (xO q), b) :: nil =>
            pmap (\lam u => pmap_to_list_tree u (\lam q' => prefix (xO q'))) (inv p)
              *> pmap_insert_empty_to_list b q (\lam q' => prefix (xO q'))
      \in pmap (\lam u => pmap_to_list_tree (PNode' nothing u PEmpty) prefix) p
            *> pmap (\lam u => pmap_to_list_tree u prefix)
                 (PNode'_node_l nothing v' l' r' PEmpty)
            *> pmap (\lam u => u ++ nil) inner
  | xI q =>
      \let
        | (v', l', r', p) => pmap_insert_node b q PEmpty
        | inner : pmap_to_list_tree (PNode v' l' r') (\lam q' => prefix (xI q'))
              = (prefix (xI q), b) :: nil =>
            pmap (\lam u => pmap_to_list_tree u (\lam q' => prefix (xI q'))) (inv p)
              *> pmap_insert_empty_to_list b q (\lam q' => prefix (xI q'))
      \in pmap (\lam u => pmap_to_list_tree (PNode' nothing PEmpty u) prefix) p
            *> pmap (\lam u => pmap_to_list_tree u prefix)
                 (PNode'_node_r nothing PEmpty v' l' r')
            *> pmap (\lam u => u) inner

-- Fresh-key insert splits the traversal in place: the inserted entry appears
-- at its canonical position, everything else keeps its order.
\func pmap_to_list_tree_insert_decomp {A : \Set} (b : A) (t : Pmap' A)
    (prefix : Pos -> Pos) (k : Pos) (h : plookup' t k = nothing)
  : \Sigma (l1 l2 : List (\Sigma Pos A))
           (pmap_to_list_tree (partial_alter' (\lam _ => just b) k t) prefix
              = l1 ++ (prefix k, b) :: l2)
           (pmap_to_list_tree t prefix = l1 ++ l2)
\elim t, k
  | PEmpty, k => (nil, nil, pmap_insert_empty_to_list b k prefix, idp)
  | PNode v l r, xH =>
      ( nil
      , pmap_to_list_tree l (\lam q => prefix (xO q))
          ++ pmap_to_list_tree r (\lam q => prefix (xI q))
      , idp
      , pmap (\lam (o : Maybe A) =>
                (\case o \return List (\Sigma Pos A) \with {
                   | nothing => nil
                   | just x  => (prefix xH, x) :: nil
                 })
                ++ (pmap_to_list_tree l (\lam q => prefix (xO q))
                     ++ pmap_to_list_tree r (\lam q => prefix (xI q))))
             h)
  | PNode v l r, xO q =>
      \let
        | (v', l', r', p) => pmap_insert_node b q l
        | (l1', l2', p1, p2) =>
            pmap_to_list_tree_insert_decomp b l (\lam q' => prefix (xO q')) q h
        | here => \case v \return List (\Sigma Pos A) \with {
            | nothing => nil
            | just x  => (prefix xH, x) :: nil
          }
        | rt => pmap_to_list_tree r (\lam q' => prefix (xI q'))
      \in ( here ++ l1'
          , l2' ++ rt
          , pmap (\lam u => pmap_to_list_tree (PNode' v u r) prefix) p
              *> pmap (\lam u => pmap_to_list_tree u prefix) (PNode'_node_l v v' l' r' r)
              *> pmap (\lam u => here ++ (u ++ rt))
                   (pmap (\lam u => pmap_to_list_tree u (\lam q' => prefix (xO q'))) (inv p)
                     *> p1)
              *> pmap (here ++ __)
                   (++-assoc {\Sigma Pos A} {l1'} {(prefix (xO q), b) :: l2'} {rt})
              *> inv (++-assoc {\Sigma Pos A} {here} {l1'} {(prefix (xO q), b) :: (l2' ++ rt)})
          , pmap (\lam u => here ++ (u ++ rt)) p2
              *> pmap (here ++ __) (++-assoc {\Sigma Pos A} {l1'} {l2'} {rt})
              *> inv (++-assoc {\Sigma Pos A} {here} {l1'} {l2' ++ rt}))
  | PNode v l r, xI q =>
      \let
        | (v', l', r', p) => pmap_insert_node b q r
        | (l1', l2', p1, p2) =>
            pmap_to_list_tree_insert_decomp b r (\lam q' => prefix (xI q')) q h
        | here => \case v \return List (\Sigma Pos A) \with {
            | nothing => nil
            | just x  => (prefix xH, x) :: nil
          }
        | lt => pmap_to_list_tree l (\lam q' => prefix (xO q'))
      \in ( here ++ lt ++ l1'
          , l2'
          , pmap (\lam u => pmap_to_list_tree (PNode' v l u) prefix) p
              *> pmap (\lam u => pmap_to_list_tree u prefix) (PNode'_node_r v l v' l' r')
              *> pmap (\lam u => here ++ (lt ++ u))
                   (pmap (\lam u => pmap_to_list_tree u (\lam q' => prefix (xI q'))) (inv p)
                     *> p1)
              *> pmap (here ++ __)
                   (inv (++-assoc {\Sigma Pos A} {lt} {l1'} {(prefix (xI q), b) :: l2'}))
              *> inv (++-assoc {\Sigma Pos A} {here} {lt ++ l1'} {(prefix (xI q), b) :: l2'})
          , pmap (\lam u => here ++ (lt ++ u)) p2
              *> pmap (here ++ __) (inv (++-assoc {\Sigma Pos A} {lt} {l1'} {l2'}))
              *> inv (++-assoc {\Sigma Pos A} {here} {lt ++ l1'} {l2'}))

-- Gmap level.
\func gmap_to_list_insert_decomp {K : \Set} {cnt : Countable K} {A : \Set}
    (m : Gmap K cnt A) (k : K) (v : A) (h : glookup m k = nothing)
  : \Sigma (l1 l2 : List (\Sigma K A))
           (gmap_to_list (ginsert k v m) = l1 ++ (k, v) :: l2)
           (gmap_to_list m = l1 ++ l2)
  => \case plookup m.gtree (encode {cnt} k) \as o,
           idp : plookup m.gtree (encode {cnt} k) = o
       \return \Sigma (l1 l2 : List (\Sigma K A))
                      (gmap_to_list (ginsert k v m) = l1 ++ (k, v) :: l2)
                      (gmap_to_list m = l1 ++ l2)
     \with {
       | just p, ho =>
           \let bad : just p.2 = {Maybe A} nothing =>
               inv (pmap (\lam (o : Maybe (\Sigma K A)) => \case o \return Maybe A \with {
                            | nothing => nothing
                            | just q  => just q.2
                          }) ho)
                 *> h
           \in \case bad \with {}
       | nothing, ho =>
           \let
             | (t1, t2, q1, q2) =>
                 pmap_to_list_tree_insert_decomp (k, v) m.gtree.tree (\lam x => x)
                     (encode {cnt} k) ho
           \in ( gmap_to_list.strip t1
               , gmap_to_list.strip t2
               , pmap gmap_to_list.strip q1
                   *> strip_append t1 ((encode {cnt} k, (k, v)) :: t2)
               , pmap gmap_to_list.strip q2 *> strip_append t1 t2)
     }

-- Rocq `big_sepM_insert` (both directions), for a key absent from `m`.
\func big_sepM_insert {M : UCMRA} {K : \Set} {cnt : Countable K} {A : \Set}
    (m : Gmap K cnt A) (Phi : K -> A -> ProperUPred M) (k : K) (v : A)
    (h : glookup m k = nothing)
  : \Sigma (properUPred_ent (big_sepM (ginsert k v m) Phi)
               (mkProperSep (Phi k v) (big_sepM m Phi)))
           (properUPred_ent (mkProperSep (Phi k v) (big_sepM m Phi))
               (big_sepM (ginsert k v m) Phi))
  => \let
       | (l1, l2, p1, p2) => gmap_to_list_insert_decomp m k v h
       | Phi' => \lam (e : \Sigma K A) => Phi e.1 e.2
     \in ( transport2
              (\lam la lb => properUPred_ent (big_sepL Phi' la)
                  (mkProperSep (Phi k v) (big_sepL Phi' lb)))
              (inv p1) (inv p2)
              (big_sepL_extract_1 Phi' l1 l2 (k, v))
         , transport2
              (\lam la lb => properUPred_ent (mkProperSep (Phi k v) (big_sepL Phi' lb))
                  (big_sepL Phi' la))
              (inv p1) (inv p2)
              (big_sepL_extract_2 Phi' l1 l2 (k, v))
         )

-- =================================================================================
-- General separating-conjunction rearrangements (model-level, reusable).
-- =================================================================================

\lemma sep_mono_l_ent {M : UCMRA} (P P' Q : ProperUPred M)
    (h : properUPred_ent P P')
  : properUPred_ent (mkProperSep P Q) (mkProperSep P' Q)
  => \lam n x hv hs => \case hs \with {
    | inP (a, b, dab, hP, hQ) =>
      inP (a, b, dab, h n a (validN_sub_l n x a b hv dab) hP, hQ)
  }

\lemma sep_comm_ent {M : UCMRA} (P Q : ProperUPred M)
  : properUPred_ent (mkProperSep P Q) (mkProperSep Q P)
  => \lam n x hv hs => \case hs \with {
    | inP (a, b, dab, hP, hQ) =>
      inP (b, a,
           M.ofe_dist_trans n x (M.op a b) (M.op b a) dab (cmra_comm_dist {M} n a b),
           hQ, hP)
  }

\lemma sep_assoc_l_ent {M : UCMRA} (P Q R : ProperUPred M)
  : properUPred_ent (mkProperSep (mkProperSep P Q) R) (mkProperSep P (mkProperSep Q R))
  => \lam n x hv hs => \case hs \with {
    | inP (ab, c, dabc, hPQ, hR) => \case hPQ \with {
      | inP (a, b, dab, hP, hQ) =>
        inP (a, M.op b c,
             M.ofe_dist_trans n x (M.op (M.op a b) c) (M.op a (M.op b c))
                 (M.ofe_dist_trans n x (M.op ab c) (M.op (M.op a b) c)
                     dabc (M.cmra_op_ne_2 c n ab (M.op a b) dab))
                 (M.ofe_dist_sym n (M.op a (M.op b c)) (M.op (M.op a b) c)
                     (cmra_assoc_dist {M} n a b c)),
             hP,
             inP (b, c, M.ofe_dist_refl n (M.op b c), hQ, hR))
    }
  }

\lemma sep_assoc_r_ent {M : UCMRA} (P Q R : ProperUPred M)
  : properUPred_ent (mkProperSep P (mkProperSep Q R)) (mkProperSep (mkProperSep P Q) R)
  => \lam n x hv hs => \case hs \with {
    | inP (a, bc, dabc, hP, hQR) => \case hQR \with {
      | inP (b, c, dbc, hQ, hR) =>
        inP (M.op a b, c,
             M.ofe_dist_trans n x (M.op a (M.op b c)) (M.op (M.op a b) c)
                 (M.ofe_dist_trans n x (M.op a bc) (M.op a (M.op b c))
                     dabc (M.cmra_op_ne a n bc (M.op b c) dbc))
                 (cmra_assoc_dist {M} n a b c),
             inP (a, b, M.ofe_dist_refl n (M.op a b), hP, hQ),
             hR)
    }
  }

\lemma sep_exist_l_ent {M : UCMRA} {A : \Set0} (Phi : A -> ProperUPred M) (R : ProperUPred M)
  : properUPred_ent (mkProperSep (mkProperExist A Phi) R)
                    (mkProperExist A (\lam a => mkProperSep (Phi a) R))
  => \lam n x hv hs => \case hs \with {
    | inP (a1, a2, dab, hex, hR) => \case hex \with {
      | inP (t, hPhi) => inP (t, inP (a1, a2, dab, hPhi, hR))
    }
  }

-- Pull a big_sep existential out of an outer sep, then eliminate per-witness.
\lemma sep_exist_l_elim {M : UCMRA} {A : \Set0} (Phi : A -> ProperUPred M)
    (R Z : ProperUPred M)
    (h : \Pi (a : A) -> properUPred_ent (mkProperSep (Phi a) R) Z)
  : properUPred_ent (mkProperSep (mkProperExist A Phi) R) Z
  => \lam n x hv hs => \case sep_exist_l_ent Phi R n x hv hs \with {
    | inP (t, hbody) => h t n x hv hbody
  }

-- Extra sep/or/pure entailment primitives (append to lib/big_op.ard, after
-- the sep rearrangements).

\lemma sep_elim_r_ent {M : UCMRA} (P Q : ProperUPred M)
  : properUPred_ent (mkProperSep P Q) Q
  => \lam n x hv hs => \case hs \with {
    | inP (a, b, dab, hP, hQ) =>
      Q.upred_mono n n b x hQ
          (inP (a, M.ofe_dist_trans n x (M.op a b) (M.op b a) dab (cmra_comm_dist {M} n a b)))
          <=-refl
  }

\lemma or_intro_l_ent {M : UCMRA} (P Q : ProperUPred M)
  : properUPred_ent P (mkProperOr P Q)
  => \lam n x hv h => byLeft h

\lemma exist_intro_ent {M : UCMRA} {A : \Set0} (Phi : A -> ProperUPred M) (a : A)
  : properUPred_ent (Phi a) (mkProperExist A Phi)
  => \lam n x hv h => inP (a, h)

\lemma pure_intro_sep_ent {M : UCMRA} (phi : \Prop) (hphi : phi) (Q : ProperUPred M)
  : properUPred_ent Q (mkProperSep (mkProperPure phi) Q)
  => \lam n x hv hq =>
      inP (M.unit, x,
           M.ofe_dist_sym n (M.op M.unit x) x (ucmra_unit_left_id_dist n x),
           hphi, hq)

\lemma wand_intro_ent {M : UCMRA} (R P Q : ProperUPred M)
    (h : properUPred_ent (mkProperSep R P) Q)
  : properUPred_ent R (mkProperWand P Q)
  => \lam n a1 hv hR m m_le_n a2 hv_op hP =>
      h m (M.op a1 a2) hv_op
          (inP (a1, a2, M.ofe_dist_refl m (M.op a1 a2),
                R.upred_mono n m a1 a1 hR (inclN_refl_ucmra m a1) m_le_n,
                hP))

\lemma sep_elim_l_ent {M : UCMRA} (P Q : ProperUPred M)
  : properUPred_ent (mkProperSep P Q) P
  => \lam n x hv hs => \case hs \with {
    | inP (a, b, dab, hP, hQ) =>
      P.upred_mono n n a x hP
          (inP (b, dab))
          <=-refl
  }

\lemma or_intro_r_ent {M : UCMRA} (P Q : ProperUPred M)
  : properUPred_ent Q (mkProperOr P Q)
  => \lam n x hv h => byRight h

\lemma exist_elim_ent {M : UCMRA} {A : \Set0} (Phi : A -> ProperUPred M) (Z : ProperUPred M)
    (h : \Pi (a : A) -> properUPred_ent (Phi a) Z)
  : properUPred_ent (mkProperExist A Phi) Z
  => \lam n x hv hex => \case hex \with { | inP (t, hp) => h t n x hv hp }

-- (a·b)·(c·d) ≡ (a·d)·(b·c)
\lemma op_regroup_swap {M : UCMRA} (n : Nat) (a b c d : M.E)
  : M.dist n (M.op (M.op a b) (M.op c d)) (M.op (M.op a d) (M.op b c))
  => M.ofe_dist_trans n (M.op (M.op a b) (M.op c d)) (M.op a (M.op b (M.op c d))) (M.op (M.op a d) (M.op b c))
      (M.ofe_dist_sym n (M.op a (M.op b (M.op c d))) (M.op (M.op a b) (M.op c d))
          (cmra_assoc_dist {M} n a b (M.op c d)))
      (M.ofe_dist_trans n (M.op a (M.op b (M.op c d))) (M.op a (M.op (M.op b c) d)) (M.op (M.op a d) (M.op b c))
          (M.cmra_op_ne a n (M.op b (M.op c d)) (M.op (M.op b c) d) (cmra_assoc_dist {M} n b c d))
          (M.ofe_dist_trans n (M.op a (M.op (M.op b c) d)) (M.op a (M.op d (M.op b c))) (M.op (M.op a d) (M.op b c))
              (M.cmra_op_ne a n (M.op (M.op b c) d) (M.op d (M.op b c)) (cmra_comm_dist {M} n (M.op b c) d))
              (cmra_assoc_dist {M} n a d (M.op b c))))
