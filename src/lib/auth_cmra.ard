\import Logic
\import Logic.Meta
\import Paths
\import Paths.Meta
\import Set
\import Data.Maybe
\import Arith.Nat
\import Order.PartialOrder
\import cmra
\import ofe
\import lib.excl_cmra


-- =================================================================================
-- AuthElem
-- =================================================================================


\func AuthViewRel {A : UCMRA} (n : Nat) (a b : A.E) : \Prop =>
  \Sigma (inclN {A} {\new Op A.E { | op => A.op }} b n a) (validN {A} n a)

\func AuthElem (A : UCMRA) : \Set => \Sigma (Maybe (Excl A.E)) A.E

\func AuthOFE (A : UCMRA) : OFE => ProdOFE (ExclUOFE A) A

\func AuthOp {A : UCMRA} (x y : AuthElem A) : AuthElem A =>
  (exclU_op x.1 y.1, A.op x.2 y.2)


-- =================================================================================
-- Auth Valid
-- =================================================================================


\func AuthValidN {A : UCMRA} (n : Nat) (x : AuthElem A) : \Prop \elim x
  | (nothing, b) => validN {A} n b
  | (just (excl a), b) => \Sigma (validN {A} n a) (inclN {A} {\new Op A.E { | op => A.op }} b n a)
  | (just exclInvalid, _) => Empty

\func AuthValid {A : UCMRA} (x : AuthElem A) : \Prop =>
  \Pi (n : Nat) -> AuthValidN {A} n x


-- =================================================================================
-- Auth Core
-- =================================================================================


\func auth_total_core {A : UCMRA} (a : A.E) : A.E =>
  \case pcore {A} a \with {
    | just c  => c
    | nothing => A.unit
  }

\func AuthPCore {A : UCMRA} (x : AuthElem A) : Maybe (AuthElem A) =>
  just (nothing, ucmra_core x.2)


-- =================================================================================
-- Support lemmas
-- =================================================================================


\func inclN_le {O : OFE} {opO : Op O.E} (x y : O.E) (n m : Nat)
               (h : inclN {O} {opO} x n y) (le : m <= n) : inclN {O} {opO} x m y
  => \case h \with {
    | inP (z, dist_y_xz) => inP (z, O.ofe_dist_le n m y (opO.op x z) dist_y_xz le)
  }

\lemma inclN_trans {C : CMRA} (n : Nat) (x y w : C.E)
                   (h1 : inclN {C} {\new Op C.E { | op => C.op }} x n y)
                   (h2 : inclN {C} {\new Op C.E { | op => C.op }} y n w)
  : inclN {C} {\new Op C.E { | op => C.op }} x n w
  => \case h1, h2 \with {
    | inP (z1, hz1), inP (z2, hz2) =>
      inP (C.op z1 z2,
           C.ofe_dist_trans n w (C.op y z2) (C.op x (C.op z1 z2))
               hz2
               (C.ofe_dist_trans n (C.op y z2) (C.op (C.op x z1) z2) (C.op x (C.op z1 z2))
                   (C.cmra_op_ne_2 z2 n y (C.op x z1) hz1)
                   (equiv_dist_n {C} (C.op (C.op x z1) z2) (C.op x (C.op z1 z2))
                       (inv (C.cmra_assoc x z1 z2)) n)))
  }

\func dist_op_ne_l {M : CMRA} (n : Nat) (x1 x2 y : M.E)
                   (h : M.dist n x1 x2) : M.dist n (M.op x1 y) (M.op x2 y)
  => M.cmra_op_ne_2 y n x1 x2 h

\lemma auth_op_snd {A : UCMRA} (x y : AuthElem A) : (AuthOp x y).2 = A.op x.2 y.2 \elim x, y
  | (just _, _),  (just _, _)  => idp
  | (just _, _),  (nothing, _) => idp
  | (nothing, _), (just _, _)  => idp
  | (nothing, _), (nothing, _) => idp

\lemma auth_incl_snd {A : UCMRA} (x y : AuthElem A)
                     (h : incl {AuthElem A} {\new BaseSet (AuthElem A)}
                         {\new Op (AuthElem A) { | op => AuthOp }} x y)
  : incl {A.E} {A} {\new Op A.E { | op => A.op }} x.2 y.2
  => \case h \with {
    | inP (z, hyz) => inP (z.2, pmap __.2 hyz *> auth_op_snd x z)
  }

\lemma exclU_op_ne {A : UCMRA} (n : Nat) (e e1 e2 : Maybe (Excl A.E))
                   (h : (ExclUOFE A).dist n e1 e2)
  : (ExclUOFE A).dist n (exclU_op e e1) (exclU_op e e2)
  => (ExclUCMRA A).cmra_op_ne e n e1 e2 h

\lemma exclU_op_ne_2 {A : UCMRA} (n : Nat) (e e1 e2 : Maybe (Excl A.E))
                     (h : (ExclUOFE A).dist n e1 e2)
  : (ExclUOFE A).dist n (exclU_op e1 e) (exclU_op e2 e)
  => (ExclUCMRA A).cmra_op_ne_2 e n e1 e2 h

\lemma auth_validN_le_helper {A : UCMRA} (n m : Nat) (x : AuthElem A)
                             (hv : AuthValidN {A} n x) (le : m <= n)
  : AuthValidN {A} m x \elim x
  | (nothing, b) =>
    A.cmra_validN_le n m b hv le
  | (just (excl a), b) =>
    (A.cmra_validN_le n m a hv.1 le,
     inclN_le {A} {\new Op A.E { | op => A.op }} b a n m hv.2 le)
  | (just exclInvalid, _) => \case hv \with {}

\lemma auth_cmra_validN_op_l_proof {A : UCMRA}
                                   (n : Nat) (x y : AuthElem A) (hv : AuthValidN {A} n (AuthOp x y))
  : AuthValidN {A} n x \elim x, y
  | (nothing, b1), (nothing, b2) =>
    A.cmra_validN_op_l n b1 b2 hv

  | (nothing, b1), (just (excl a), b2) =>
    \let
      | va_b1b2 : validN {A} n (A.op b1 b2) =>
        cmra_validN_includedN {A} n (A.op b1 b2) a hv.1 hv.2
    \in A.cmra_validN_op_l n b1 b2 va_b1b2

  | (just (excl a), b1), (nothing, b2) =>
    ( hv.1
    , inclN_trans {A} n b1 (A.op b1 b2) a
          (inclN_op_l {A} n b1 b2)
          hv.2 )

  | (nothing, _),         (just exclInvalid, _) => \case hv \with {}
  | (just (excl _), _),   (just exclInvalid, _) => \case hv \with {}
  | (just exclInvalid, _), (just exclInvalid, _) => \case hv \with {}
  | (just exclInvalid, _), (nothing, _)       => \case hv \with {}
  | (just exclInvalid, _), (just (excl _), _) => \case hv \with {}
  | (just (excl _), _), (just (excl _), _) => \case hv \with {}

\func auth_cmra_extend_proof {A : UCMRA}
                              (n : Nat) (x y1 y2 : AuthElem A)
                              (hvx : AuthValidN {A} n x)
                              (hdist : (AuthOFE A).dist n x (AuthOp y1 y2))
  : \Sigma (z1 z2 : AuthElem A)
           (x = AuthOp z1 z2)
           ((AuthOFE A).dist n z1 y1)
           ((AuthOFE A).dist n z2 y2)
  =>
    \let
      | vfrag : validN {A} n x.2 => auth_extend_frag_valid {A} n x hvx
      | frag_split : \Sigma (c1 c2 : A.E)
                            (x.2 = A.op c1 c2)
                            (A.dist n c1 y1.2)
                            (A.dist n c2 y2.2) =>
        A.cmra_extend n x.2 y1.2 y2.2 vfrag hdist.2
    \in
      auth_extend_split {A} n x y1 y2 hvx hdist
          frag_split.1 frag_split.2 frag_split.3 frag_split.4 frag_split.5

  \where {
    \func auth_extend_frag_valid {A : UCMRA} (n : Nat) (x : AuthElem A)
                                 (hvx : AuthValidN {A} n x)
      : validN {A} n x.2 \elim x
      | (nothing, b) => hvx
      | (just (excl a), b) =>
        cmra_validN_includedN {A} n b a hvx.1 hvx.2
      | (just exclInvalid, _) => \case hvx \with {}

    \func auth_extend_split {A : UCMRA}
                            (n : Nat) (x y1 y2 : AuthElem A)
                            (hvx : AuthValidN {A} n x)
                            (hdist : (AuthOFE A).dist n x (AuthOp y1 y2))
                            (c1 c2 : A.E)
                            (heq : x.2 = A.op c1 c2)
                            (dc1 : A.dist n c1 y1.2)
                            (dc2 : A.dist n c2 y2.2)
      : \Sigma (z1 z2 : AuthElem A)
               (x = AuthOp z1 z2)
               ((AuthOFE A).dist n z1 y1)
               ((AuthOFE A).dist n z2 y2)
    \elim x, y1, y2
      | (nothing, _), (nothing, _), (nothing, _) =>
        ((nothing, c1), (nothing, c2),
         path (\lam i => (nothing, heq @ i)),
         ((ExclUOFE A).ofe_dist_refl n nothing, dc1),
         ((ExclUOFE A).ofe_dist_refl n nothing, dc2))

      | (nothing, _), (just _, _), (nothing, _) => \case hdist.1 \with {}
      | (nothing, _), (nothing, _), (just _, _) => \case hdist.1 \with {}
      | (nothing, _), (just _, _), (just _, _) => \case hdist.1 \with {}
      | (just (excl _), _), (nothing, _), (nothing, _) => \case hdist.1 \with {}
      | (just (excl a), _), (just e1, _), (nothing, _) =>
        ((just (excl a), c1), (nothing, c2),
         path (\lam i => (just (excl a), heq @ i)),
         (hdist.1, dc1),
         ((ExclUOFE A).ofe_dist_refl n nothing, dc2))

      | (just (excl a), _), (nothing, _), (just e2, _) =>
        ((nothing, c1), (just (excl a), c2),
         path (\lam i => (just (excl a), heq @ i)),
         ((ExclUOFE A).ofe_dist_refl n nothing, dc1),
         (hdist.1, dc2))

      | (just (excl _), _), (just _, _), (just _, _) => \case hdist.1 \with {}
      | (just exclInvalid, _), _, _ => \case hvx \with {}
  }


-- =================================================================================
-- AuthCMRA
-- =================================================================================


\func AuthCMRA (A : UCMRA) : CMRA \cowith
  | OFE => AuthOFE A
  | pcore => AuthPCore
  | op => AuthOp
  | valid => AuthValid
  | validN => AuthValidN
  | cmra_op_ne => \lam x n y1 y2 hy =>
      ( exclU_op_ne {A} n x.1 y1.1 y2.1 hy.1
      , A.cmra_op_ne x.2 n y1.2 y2.2 hy.2)
  | cmra_op_ne_2 => \lam y n x1 x2 hx =>
      ( exclU_op_ne_2 {A} n y.1 x1.1 x2.1 hx.1
      , A.cmra_op_ne_2 y.2 n x1.2 x2.2 hx.2)
  | cmra_pcore_ne => \lam n x y cx hxy hpx =>
      \let
        | cx_eq : cx = (nothing, ucmra_core x.2) =>
          inv (pmap (\case __ \with { | just c => c | nothing => (nothing, ucmra_core x.2) }) hpx)
      \in rewrite cx_eq
          ( (nothing, ucmra_core y.2)
          , idp
          , ( (ExclUOFE A).ofe_dist_refl n nothing
            , ucmra_core_ne n x.2 y.2 hxy.2))
  | cmra_validN_ne => \lam n x y hxy hvx => \case \elim x, \elim y, hxy, hvx \with {
    | (nothing, b1), (nothing, b2), hxy, hvx =>
      A.cmra_validN_ne n b1 b2 hxy.2 hvx
    | (just (excl a1), b1), (just (excl a2), b2), hxy, hvx =>
      \let
        | va2 : validN {A} n a2 => A.cmra_validN_ne n a1 a2 hxy.1 hvx.1
        | inclb2_a2 : inclN {A} {\new Op A.E { | op => A.op }} b2 n a2 =>
          \case hvx.2 \with {
            | inP (z, hz) => inP (z,
                                  A.ofe_dist_trans n a2 a1 (A.op b2 z)
                                      (A.ofe_dist_sym n a1 a2 hxy.1)
                                      (A.ofe_dist_trans n a1 (A.op b1 z) (A.op b2 z) hz
                                          (A.cmra_op_ne_2 z n b1 b2 hxy.2)))
          }
      \in (va2, inclb2_a2)
    | (just exclInvalid, _), _, _, hvx => \case hvx \with {}
    | (nothing, _), (just _, _), hxy, _ => \case hxy.1 \with {}
    | (just _, _), (nothing, _), hxy, _ => \case hxy.1 \with {}
    | (just (excl _), _), (just exclInvalid, _), hxy, _ => \case hxy.1 \with {}
  }
  | cmra_valid_validN => \lam x => (\lam hv n => hv n, \lam hvn n => hvn n)
  | cmra_validN_le => \lam n m x hvn hle => auth_validN_le_helper n m x hvn hle
  | cmra_assoc => \lam x y z =>
      path (\lam i =>
          ( (ExclUCMRA A).cmra_assoc x.1 y.1 z.1 @ i
          , A.cmra_assoc x.2 y.2 z.2 @ i))
  | cmra_comm => \lam x y =>
      path (\lam i =>
          ( (ExclUCMRA A).cmra_comm x.1 y.1 @ i
          , A.cmra_comm x.2 y.2 @ i))
  | cmra_pcore_l => \lam x cx hpx =>
      \let
        | cx_eq : cx = (nothing, ucmra_core x.2) =>
          inv (pmap (\case __ \with { | just c => c | nothing => (nothing, ucmra_core x.2) }) hpx)
      \in transport (\lam c => AuthOp c x = x) (inv cx_eq)
          (\case \elim x \return AuthOp (nothing, ucmra_core x.2) x = x \with {
            | (just a, b) => path (\lam i => (just a, ucmra_core_left_id {A} b @ i))
            | (nothing, b) => path (\lam i => (nothing, ucmra_core_left_id {A} b @ i))
          })
  | cmra_pcore_idemp => \lam x cx hpx =>
      \let
        | cx_eq : cx = (nothing, ucmra_core x.2) =>
          inv (pmap (\case __ \with { | just c => c | nothing => (nothing, ucmra_core x.2) }) hpx)
      \in transport (\lam c => AuthPCore c = just c) (inv cx_eq)
          (path (\lam i => just (nothing, ucmra_core_idemp {A} x.2 @ i)))
  | cmra_pcore_mono => \lam x y cx hincl hpx =>
      \let
        | cx_eq : cx = (nothing, ucmra_core x.2) =>
          inv (pmap (\case __ \with { | just c => c | nothing => (nothing, ucmra_core x.2) }) hpx)
        | hincl_snd : incl {A.E} {A} {\new Op A.E { | op => A.op }} x.2 y.2 =>
          auth_incl_snd x y hincl
        | hincl_cores : incl {A.E} {A} {\new Op A.E { | op => A.op }} (ucmra_core x.2) (ucmra_core y.2) =>
          ucmra_core_mono x.2 y.2 hincl_snd
        | incl_pair : incl {AuthElem A} {\new BaseSet (AuthElem A)}
            {\new Op (AuthElem A) { | op => AuthOp }}
            (nothing, ucmra_core x.2) (nothing, ucmra_core y.2) =>
          \case hincl_cores \with {
            | inP (z, hz) => inP ((nothing, z),
                                  path (\lam i => (nothing, hz @ i)))
          }
      \in ((nothing, ucmra_core y.2), idp,
           transport (\lam c => incl {AuthElem A} {\new BaseSet (AuthElem A)}
               {\new Op (AuthElem A) { | op => AuthOp }} c (nothing, ucmra_core y.2))
               (inv cx_eq) incl_pair)
  | cmra_validN_op_l => auth_cmra_validN_op_l_proof

  | cmra_extend => auth_cmra_extend_proof


-- =================================================================================
-- AuthUCMRA
-- =================================================================================


\func AuthUCMRA (A : UCMRA) : UCMRA \cowith
  | CMRA => AuthCMRA A
  | unit => (nothing, A.unit)
  | ucmra_unit_valid =>
    \lam n => (A.cmra_valid_validN A.unit).1 A.ucmra_unit_valid n
  | ucmra_unit_left_id => \lam x => \case \elim x \with {
    | (just a, b) => path (\lam i => (just a, A.ucmra_unit_left_id b @ i))
    | (nothing, b) => path (\lam i => (nothing, A.ucmra_unit_left_id b @ i))
  }
  | ucmra_pcore_unit =>
    path (\lam i =>
        just (nothing,
              \case A.ucmra_pcore_unit @ i \as p
              \return A.E
              \with {
                | just c  => c
                | nothing => A.unit
              }))
