\import Arith.Nat
\import Data.Or
\import Logic
\import Order.PartialOrder
\import Order.LinearOrder
\import Paths
\import Set
\import ofe

-- =================================================================================
-- COFE solver: recursive domain equations over Nat-indexed COFEs
-- =================================================================================
--
-- This file follows Iris/Rocq's `algebra/cofe_solver.v`.  The global
-- step-index type is already Nat in this port, so the solver is specialised to
-- finite step indices from the start.

\lemma solver_le_refl (k : Nat) : k LinearOrder.<= k \elim k
  | 0 => zero<=_
  | suc k => suc<=suc (solver_le_refl k)

\lemma solver_le_plus_right (k i : Nat) : k LinearOrder.<= ((Nat.+) i k) \elim i
  | 0 => solver_le_refl k
  | suc i => <=-transitive (solver_le_plus_right k i) (n<=sucn ((Nat.+) i k))

\lemma solver_le_plus_left (n d : Nat) : n LinearOrder.<= ((Nat.+) n d) \elim n
  | 0 => zero<=_
  | suc n => suc<=suc (solver_le_plus_left n d)

\lemma solver_plus_zero_right (n : Nat) : (Nat.+) n 0 = n \elim n
  | 0 => idp
  | suc n => pmap suc (solver_plus_zero_right n)

\lemma solver_plus_suc_right (n m : Nat) : (Nat.+) n (suc m) = suc ((Nat.+) n m) \elim n
  | 0 => idp
  | suc n => pmap suc (solver_plus_suc_right n m)

\func solver_plus_suc_right_fun (n m : Nat) : (Nat.+) n (suc m) = suc ((Nat.+) n m) \elim n
  | 0 => idp
  | suc n => pmap suc (solver_plus_suc_right_fun n m)

\data SolverNatSplit (a b : Nat)
  | split_left (d : Nat) (p : a = ((Nat.+) d b))
  | split_right (d : Nat) (p : b = ((Nat.+) d a))

\func solver_nat_split (a b : Nat) : SolverNatSplit a b \elim a, b
  | 0, b => split_right b (inv (solver_plus_zero_right b))
  | suc a, 0 => split_left (suc a) (inv (solver_plus_zero_right (suc a)))
  | suc a, suc b => \case solver_nat_split a b \with {
      | split_left d p =>
          split_left d (pmap (\lam z => suc z) p *> inv (solver_plus_suc_right d b))
      | split_right d p =>
          split_right d (pmap (\lam z => suc z) p *> inv (solver_plus_suc_right d a))
    }

\record OFunctorApplyCOFE (F : OFunctor)
  | oFunctor_apply_compl (A : COFE.{0})
      (c : Nat -> (F.oFunctor_car A A).E)
      (hc : Chain {F.oFunctor_car A A} c) : (F.oFunctor_car A A).E
  | oFunctor_apply_conv_compl (A : COFE.{0})
      (c : Nat -> (F.oFunctor_car A A).E)
      (hc : Chain {F.oFunctor_car A A} c)
      (n : Nat) :
      (F.oFunctor_car A A).dist n (oFunctor_apply_compl A c hc) (c n)

\func oFunctor_applyCOFE (F : OFunctor) (hF : OFunctorApplyCOFE F)
    (A : COFE.{0}) : COFE.{0} \cowith
  | OFE => F.oFunctor_car A A
  | compl => hF.oFunctor_apply_compl A
  | cofe_conv_compl => hF.oFunctor_apply_conv_compl A

\record Solution (F : OFunctor)
  | solution_car : COFE.{0}
  | solution_inhabited : Inhabited solution_car.E
  | solution_iso : OFEIso (F.oFunctor_car solution_car solution_car) solution_car

\func solver_A (F : OFunctor) (hF : OFunctorApplyCOFE F) (k : Nat) : COFE.{0} \elim k
  | 0 => UnitCOFE
  | suc k => oFunctor_applyCOFE F hF (solver_A F hF k)

\func solver_fg {F : OFunctor} (hF : OFunctorApplyCOFE F)
                (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                (k : Nat)
  : \Sigma
      (OFEMor (solver_A F hF k) (solver_A F hF (suc k)))
      (OFEMor (solver_A F hF (suc k)) (solver_A F hF k)) \elim k
  | 0 => (ofe_mor_const hInh.default, ofe_mor_const ())
  | suc k =>
      (F.oFunctor_map ((solver_fg hF hInh k).2, (solver_fg hF hInh k).1),
       F.oFunctor_map ((solver_fg hF hInh k).1, (solver_fg hF hInh k).2))

\func solver_f {F : OFunctor} (hF : OFunctorApplyCOFE F)
               (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
               (k : Nat) : OFEMor (solver_A F hF k) (solver_A F hF (suc k)) =>
  (solver_fg hF hInh k).1

\func solver_g {F : OFunctor} (hF : OFunctorApplyCOFE F)
               (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
               (k : Nat) : OFEMor (solver_A F hF (suc k)) (solver_A F hF k) =>
  (solver_fg hF hInh k).2

\func solver_f_S {F : OFunctor} (hF : OFunctorApplyCOFE F)
                  (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                  (k : Nat) :
  solver_f hF hInh (suc k) =
    {OFEMor (solver_A F hF (suc k)) (solver_A F hF (suc (suc k)))}
    F.oFunctor_map (solver_g hF hInh k, solver_f hF hInh k) => idp

\func solver_g_S {F : OFunctor} (hF : OFunctorApplyCOFE F)
                  (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                  (k : Nat) :
  solver_g hF hInh (suc k) =
    {OFEMor (solver_A F hF (suc (suc k))) (solver_A F hF (suc k))}
    F.oFunctor_map (solver_f hF hInh k, solver_g hF hInh k) => idp

\lemma solver_gf {F : OFunctor} (hF : OFunctorApplyCOFE F)
                 (hContr : OFunctorContractive F)
                 (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                 (k : Nat) (x : (solver_A F hF k).E) :
  (solver_A F hF k).equiv
    ((solver_g hF hInh k).ofe_mor_car ((solver_f hF hInh k).ofe_mor_car x))
    x \elim k
  | 0 => \case x \with { | () => idp }
  | suc k =>
      \let
        | hcomp : (solver_A F hF (suc k)).equiv
            ((F.oFunctor_map (solver_f hF hInh k, solver_g hF hInh k)).ofe_mor_car
              ((F.oFunctor_map (solver_g hF hInh k, solver_f hF hInh k)).ofe_mor_car x))
            ((F.oFunctor_map
              (ofe_mor_comp (solver_g hF hInh k) (solver_f hF hInh k),
               ofe_mor_comp (solver_g hF hInh k) (solver_f hF hInh k))).ofe_mor_car x) =>
            F.oFunctor_map_compose
              (solver_g hF hInh k) (solver_f hF hInh k)
              (solver_f hF hInh k) (solver_g hF hInh k)
              x
        | hid : (solver_A F hF (suc k)).equiv
            ((F.oFunctor_map
              (ofe_mor_comp (solver_g hF hInh k) (solver_f hF hInh k),
               ofe_mor_comp (solver_g hF hInh k) (solver_f hF hInh k))).ofe_mor_car x)
            x =>
            ((solver_A F hF (suc k)).ofe_equiv_dist
              ((F.oFunctor_map
                (ofe_mor_comp (solver_g hF hInh k) (solver_f hF hInh k),
                 ofe_mor_comp (solver_g hF hInh k) (solver_f hF hInh k))).ofe_mor_car x)
              x).2
              (\lam n =>
                (solver_A F hF (suc k)).ofe_dist_trans n
                  ((F.oFunctor_map
                    (ofe_mor_comp (solver_g hF hInh k) (solver_f hF hInh k),
                     ofe_mor_comp (solver_g hF hInh k) (solver_f hF hInh k))).ofe_mor_car x)
                  ((F.oFunctor_map (ofe_mor_id, ofe_mor_id)).ofe_mor_car x)
                  x
                  (hContr.oFunctor_map_contractive n
                    (ofe_mor_comp (solver_g hF hInh k) (solver_f hF hInh k),
                     ofe_mor_comp (solver_g hF hInh k) (solver_f hF hInh k))
                    (ofe_mor_id, ofe_mor_id)
                    (\new DistLater {
                      | dist_later_lt => \lam m hm =>
                          (\lam y => ((solver_A F hF k).ofe_equiv_dist
                            ((solver_g hF hInh k).ofe_mor_car ((solver_f hF hInh k).ofe_mor_car y))
                            y).1 (solver_gf hF hContr hInh k y) m,
                           \lam y => ((solver_A F hF k).ofe_equiv_dist
                            ((solver_g hF hInh k).ofe_mor_car ((solver_f hF hInh k).ofe_mor_car y))
                            y).1 (solver_gf hF hContr hInh k y) m)
                    })
                    x)
                  (((solver_A F hF (suc k)).ofe_equiv_dist
                    ((F.oFunctor_map (ofe_mor_id, ofe_mor_id)).ofe_mor_car x)
                    x).1 (F.oFunctor_map_id x) n))
      \in (solver_A F hF (suc k)).equiv_trans
          ((F.oFunctor_map (solver_f hF hInh k, solver_g hF hInh k)).ofe_mor_car
            ((F.oFunctor_map (solver_g hF hInh k, solver_f hF hInh k)).ofe_mor_car x))
          ((F.oFunctor_map
            (ofe_mor_comp (solver_g hF hInh k) (solver_f hF hInh k),
             ofe_mor_comp (solver_g hF hInh k) (solver_f hF hInh k))).ofe_mor_car x)
          x
          hcomp
          hid

\record Tower (F : OFunctor) (hF : OFunctorApplyCOFE F)
              (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
  | tower_car (k : Nat) : (solver_A F hF k).E
  | g_tower (k : Nat) :
      (solver_A F hF k).equiv
        ((solver_g hF hInh k).ofe_mor_car (tower_car (suc k)))
        (tower_car k)

\instance TowerOFE (F : OFunctor) (hF : OFunctorApplyCOFE F)
                   (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E) : OFE \cowith
  | E => Tower F hF hInh
  | dist => \lam n X Y => \Pi (k : Nat) ->
      (solver_A F hF k).dist n (X.tower_car k) (Y.tower_car k)
  | equiv => \lam X Y => \Pi (k : Nat) ->
      (solver_A F hF k).equiv (X.tower_car k) (Y.tower_car k)
  | equiv_refl => \lam X k => (solver_A F hF k).equiv_refl (X.tower_car k)
  | equiv_sym => \lam X Y h k =>
      (solver_A F hF k).equiv_sym (X.tower_car k) (Y.tower_car k) (h k)
  | equiv_trans => \lam X Y Z hXY hYZ k =>
      (solver_A F hF k).equiv_trans (X.tower_car k) (Y.tower_car k) (Z.tower_car k) (hXY k) (hYZ k)
  | ofe_equiv_dist => \lam X Y => (
      \lam h n k => ((solver_A F hF k).ofe_equiv_dist (X.tower_car k) (Y.tower_car k)).1 (h k) n,
      \lam h k => ((solver_A F hF k).ofe_equiv_dist (X.tower_car k) (Y.tower_car k)).2 (\lam n => h n k)
    )
  | ofe_dist_refl => \lam n X k => (solver_A F hF k).ofe_dist_refl n (X.tower_car k)
  | ofe_dist_sym => \lam n X Y h k =>
      (solver_A F hF k).ofe_dist_sym n (X.tower_car k) (Y.tower_car k) (h k)
  | ofe_dist_trans => \lam n X Y Z hXY hYZ k =>
      (solver_A F hF k).ofe_dist_trans n (X.tower_car k) (Y.tower_car k) (Z.tower_car k) (hXY k) (hYZ k)
  | ofe_dist_le => \lam n m X Y h le k =>
      (solver_A F hF k).ofe_dist_le n m (X.tower_car k) (Y.tower_car k) (h k) le

\func tower_chain {F : OFunctor} {hF : OFunctorApplyCOFE F}
                  {hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E}
                  (c : Nat -> (TowerOFE F hF hInh).E)
                  (hc : Chain {TowerOFE F hF hInh} c)
                  (k : Nat)
  : \Sigma (d : Nat -> (solver_A F hF k).E) (Chain d) =>
  (\lam n => (c n).tower_car k,
   \new Chain {
     | chain_cauchy => \lam n m le => hc.chain_cauchy n m le k
   })

\instance TowerCOFE (F : OFunctor) (hF : OFunctorApplyCOFE F)
                    (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E) : COFE \cowith
  | OFE => TowerOFE F hF hInh
  | compl => \lam c hc => \new Tower F hF hInh {
      | tower_car => \lam k =>
          (solver_A F hF k).compl (tower_chain c hc k).1 (tower_chain c hc k).2
      | g_tower => \lam k =>
          ((solver_A F hF k).ofe_equiv_dist
            ((solver_g hF hInh k).ofe_mor_car
              ((solver_A F hF (suc k)).compl (tower_chain c hc (suc k)).1 (tower_chain c hc (suc k)).2))
            ((solver_A F hF k).compl (tower_chain c hc k).1 (tower_chain c hc k).2)).2
            (\lam n =>
              (solver_A F hF k).ofe_dist_trans n
                ((solver_g hF hInh k).ofe_mor_car
                  ((solver_A F hF (suc k)).compl (tower_chain c hc (suc k)).1 (tower_chain c hc (suc k)).2))
                ((solver_g hF hInh k).ofe_mor_car ((c n).tower_car (suc k)))
                ((solver_A F hF k).compl (tower_chain c hc k).1 (tower_chain c hc k).2)
                ((solver_g hF hInh k).ofe_mor_ne n
                  ((solver_A F hF (suc k)).compl (tower_chain c hc (suc k)).1 (tower_chain c hc (suc k)).2)
                  ((c n).tower_car (suc k))
                  ((solver_A F hF (suc k)).cofe_conv_compl (tower_chain c hc (suc k)).1 (tower_chain c hc (suc k)).2 n))
                ((solver_A F hF k).ofe_dist_trans n
                  ((solver_g hF hInh k).ofe_mor_car ((c n).tower_car (suc k)))
                  ((c n).tower_car k)
                  ((solver_A F hF k).compl (tower_chain c hc k).1 (tower_chain c hc k).2)
                  (((solver_A F hF k).ofe_equiv_dist
                    ((solver_g hF hInh k).ofe_mor_car ((c n).tower_car (suc k)))
                    ((c n).tower_car k)).1 ((c n).g_tower k) n)
                  ((solver_A F hF k).ofe_dist_sym n
                    ((solver_A F hF k).compl (tower_chain c hc k).1 (tower_chain c hc k).2)
                    ((c n).tower_car k)
                    ((solver_A F hF k).cofe_conv_compl (tower_chain c hc k).1 (tower_chain c hc k).2 n))))
    }
  | cofe_conv_compl => \lam c hc n k =>
      (solver_A F hF k).cofe_conv_compl (tower_chain c hc k).1 (tower_chain c hc k).2 n

\func solver_seed {F : OFunctor} (hF : OFunctorApplyCOFE F)
                  (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                  (k : Nat) : (solver_A F hF k).E \elim k
  | 0 => ()
  | suc k => (solver_f hF hInh k).ofe_mor_car (solver_seed hF hInh k)

\instance TowerInhabited (F : OFunctor) (hF : OFunctorApplyCOFE F)
                         (hContr : OFunctorContractive F)
                         (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
  : Inhabited (TowerCOFE F hF hInh).E \cowith
  | default => \new Tower F hF hInh {
      | tower_car => solver_seed hF hInh
      | g_tower => \lam k => solver_gf hF hContr hInh k (solver_seed hF hInh k)
    }

\func solver_project {F : OFunctor} (hF : OFunctorApplyCOFE F)
                     (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                     (k : Nat) : OFEMor (TowerCOFE F hF hInh) (solver_A F hF k) \cowith
  | ofe_mor_car => \lam X => X.tower_car k
  | ofe_mor_ne => \lam n X Y h => h k

\func solver_ff {F : OFunctor} (hF : OFunctorApplyCOFE F)
                (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                {k : Nat} (i : Nat) : OFEMor (solver_A F hF k) (solver_A F hF ((Nat.+) i k)) \elim i
  | 0 => ofe_mor_id
  | suc i => ofe_mor_comp (solver_f hF hInh ((Nat.+) i k)) (solver_ff hF hInh i)

\func solver_gg {F : OFunctor} (hF : OFunctorApplyCOFE F)
                (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                {k : Nat} (i : Nat) : OFEMor (solver_A F hF ((Nat.+) i k)) (solver_A F hF k) \elim i
  | 0 => ofe_mor_id
  | suc i => ofe_mor_comp (solver_gg hF hInh i) (solver_g hF hInh ((Nat.+) i k))

\lemma solver_ggff {F : OFunctor} (hF : OFunctorApplyCOFE F)
                   (hContr : OFunctorContractive F)
                   (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                   {k : Nat} (i : Nat) (x : (solver_A F hF k).E) :
  (solver_A F hF k).equiv
    ((solver_gg hF hInh i).ofe_mor_car ((solver_ff hF hInh i).ofe_mor_car x))
    x \elim i
  | 0 => (solver_A F hF k).equiv_refl x
  | suc i =>
      (solver_A F hF k).equiv_trans
        ((solver_gg hF hInh i).ofe_mor_car
          ((solver_g hF hInh ((Nat.+) i k)).ofe_mor_car
            ((solver_f hF hInh ((Nat.+) i k)).ofe_mor_car
              ((solver_ff hF hInh i).ofe_mor_car x))))
        ((solver_gg hF hInh i).ofe_mor_car ((solver_ff hF hInh i).ofe_mor_car x))
        x
        (((solver_A F hF k).ofe_equiv_dist
          ((solver_gg hF hInh i).ofe_mor_car
            ((solver_g hF hInh ((Nat.+) i k)).ofe_mor_car
              ((solver_f hF hInh ((Nat.+) i k)).ofe_mor_car
                ((solver_ff hF hInh i).ofe_mor_car x))))
          ((solver_gg hF hInh i).ofe_mor_car ((solver_ff hF hInh i).ofe_mor_car x))).2
          (\lam n =>
            (solver_gg hF hInh i).ofe_mor_ne n
              ((solver_g hF hInh ((Nat.+) i k)).ofe_mor_car
                ((solver_f hF hInh ((Nat.+) i k)).ofe_mor_car
                  ((solver_ff hF hInh i).ofe_mor_car x)))
              ((solver_ff hF hInh i).ofe_mor_car x)
              (((solver_A F hF ((Nat.+) i k)).ofe_equiv_dist
                ((solver_g hF hInh ((Nat.+) i k)).ofe_mor_car
                  ((solver_f hF hInh ((Nat.+) i k)).ofe_mor_car
                    ((solver_ff hF hInh i).ofe_mor_car x)))
                ((solver_ff hF hInh i).ofe_mor_car x)).1
                (solver_gf hF hContr hInh ((Nat.+) i k) ((solver_ff hF hInh i).ofe_mor_car x))
                n)))
        (solver_ggff hF hContr hInh i x)

\lemma solver_gg_tower {F : OFunctor} (hF : OFunctorApplyCOFE F)
                       (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                       {k : Nat} (i : Nat) (X : (TowerCOFE F hF hInh).E) :
  (solver_A F hF k).equiv
    ((solver_gg hF hInh i).ofe_mor_car (X.tower_car ((Nat.+) i k)))
    (X.tower_car k) \elim i
  | 0 => (solver_A F hF k).equiv_refl (X.tower_car k)
  | suc i =>
      (solver_A F hF k).equiv_trans
        ((solver_gg hF hInh i).ofe_mor_car
          ((solver_g hF hInh ((Nat.+) i k)).ofe_mor_car (X.tower_car (suc ((Nat.+) i k)))))
        ((solver_gg hF hInh i).ofe_mor_car (X.tower_car ((Nat.+) i k)))
        (X.tower_car k)
        (((solver_A F hF k).ofe_equiv_dist
          ((solver_gg hF hInh i).ofe_mor_car
            ((solver_g hF hInh ((Nat.+) i k)).ofe_mor_car (X.tower_car (suc ((Nat.+) i k)))))
          ((solver_gg hF hInh i).ofe_mor_car (X.tower_car ((Nat.+) i k)))).2
          (\lam n =>
            (solver_gg hF hInh i).ofe_mor_ne n
              ((solver_g hF hInh ((Nat.+) i k)).ofe_mor_car (X.tower_car (suc ((Nat.+) i k))))
              (X.tower_car ((Nat.+) i k))
              (((solver_A F hF ((Nat.+) i k)).ofe_equiv_dist
                ((solver_g hF hInh ((Nat.+) i k)).ofe_mor_car (X.tower_car (suc ((Nat.+) i k))))
                (X.tower_car ((Nat.+) i k))).1
                (X.g_tower ((Nat.+) i k))
                n)))
        (solver_gg_tower hF hInh i X)

\lemma solver_fg_dist {F : OFunctor} (hF : OFunctorApplyCOFE F)
                      (hContr : OFunctorContractive F)
                      (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                      (k : Nat) (x : (solver_A F hF (suc (suc k))).E) :
  (solver_A F hF (suc (suc k))).dist k
    ((solver_f hF hInh (suc k)).ofe_mor_car ((solver_g hF hInh (suc k)).ofe_mor_car x))
    x \elim k
  | 0 =>
      (solver_A F hF (suc (suc 0))).ofe_dist_trans 0
        ((F.oFunctor_map (solver_g hF hInh 0, solver_f hF hInh 0)).ofe_mor_car
          ((F.oFunctor_map (solver_f hF hInh 0, solver_g hF hInh 0)).ofe_mor_car x))
        ((F.oFunctor_map
          (ofe_mor_comp (solver_f hF hInh 0) (solver_g hF hInh 0),
           ofe_mor_comp (solver_f hF hInh 0) (solver_g hF hInh 0))).ofe_mor_car x)
        x
        (((solver_A F hF (suc (suc 0))).ofe_equiv_dist
          ((F.oFunctor_map (solver_g hF hInh 0, solver_f hF hInh 0)).ofe_mor_car
            ((F.oFunctor_map (solver_f hF hInh 0, solver_g hF hInh 0)).ofe_mor_car x))
          ((F.oFunctor_map
            (ofe_mor_comp (solver_f hF hInh 0) (solver_g hF hInh 0),
             ofe_mor_comp (solver_f hF hInh 0) (solver_g hF hInh 0))).ofe_mor_car x)).1
          (F.oFunctor_map_compose
            (solver_f hF hInh 0) (solver_g hF hInh 0)
            (solver_g hF hInh 0) (solver_f hF hInh 0)
            x)
          0)
        ((solver_A F hF (suc (suc 0))).ofe_dist_trans 0
          ((F.oFunctor_map
            (ofe_mor_comp (solver_f hF hInh 0) (solver_g hF hInh 0),
             ofe_mor_comp (solver_f hF hInh 0) (solver_g hF hInh 0))).ofe_mor_car x)
          ((F.oFunctor_map (ofe_mor_id, ofe_mor_id)).ofe_mor_car x)
          x
          (hContr.oFunctor_map_contractive 0
            (ofe_mor_comp (solver_f hF hInh 0) (solver_g hF hInh 0),
             ofe_mor_comp (solver_f hF hInh 0) (solver_g hF hInh 0))
            (ofe_mor_id, ofe_mor_id)
            (dist_later_zero
              (ofe_mor_comp (solver_f hF hInh 0) (solver_g hF hInh 0),
               ofe_mor_comp (solver_f hF hInh 0) (solver_g hF hInh 0))
              (ofe_mor_id, ofe_mor_id))
            x)
          (((solver_A F hF (suc (suc 0))).ofe_equiv_dist
            ((F.oFunctor_map (ofe_mor_id, ofe_mor_id)).ofe_mor_car x)
            x).1 (F.oFunctor_map_id x) 0))
  | suc k =>
      (solver_A F hF (suc (suc (suc k)))).ofe_dist_trans (suc k)
        ((F.oFunctor_map (solver_g hF hInh (suc k), solver_f hF hInh (suc k))).ofe_mor_car
          ((F.oFunctor_map (solver_f hF hInh (suc k), solver_g hF hInh (suc k))).ofe_mor_car x))
        ((F.oFunctor_map
          (ofe_mor_comp (solver_f hF hInh (suc k)) (solver_g hF hInh (suc k)),
           ofe_mor_comp (solver_f hF hInh (suc k)) (solver_g hF hInh (suc k)))).ofe_mor_car x)
        x
        (((solver_A F hF (suc (suc (suc k)))).ofe_equiv_dist
          ((F.oFunctor_map (solver_g hF hInh (suc k), solver_f hF hInh (suc k))).ofe_mor_car
            ((F.oFunctor_map (solver_f hF hInh (suc k), solver_g hF hInh (suc k))).ofe_mor_car x))
          ((F.oFunctor_map
            (ofe_mor_comp (solver_f hF hInh (suc k)) (solver_g hF hInh (suc k)),
             ofe_mor_comp (solver_f hF hInh (suc k)) (solver_g hF hInh (suc k)))).ofe_mor_car x)).1
          (F.oFunctor_map_compose
            (solver_f hF hInh (suc k)) (solver_g hF hInh (suc k))
            (solver_g hF hInh (suc k)) (solver_f hF hInh (suc k))
            x)
          (suc k))
        ((solver_A F hF (suc (suc (suc k)))).ofe_dist_trans (suc k)
          ((F.oFunctor_map
            (ofe_mor_comp (solver_f hF hInh (suc k)) (solver_g hF hInh (suc k)),
             ofe_mor_comp (solver_f hF hInh (suc k)) (solver_g hF hInh (suc k)))).ofe_mor_car x)
          ((F.oFunctor_map (ofe_mor_id, ofe_mor_id)).ofe_mor_car x)
          x
          (hContr.oFunctor_map_contractive (suc k)
            (ofe_mor_comp (solver_f hF hInh (suc k)) (solver_g hF hInh (suc k)),
             ofe_mor_comp (solver_f hF hInh (suc k)) (solver_g hF hInh (suc k)))
            (ofe_mor_id, ofe_mor_id)
            (\new DistLater {
              | dist_later_lt => \lam m hm =>
                  (\lam y =>
                    (solver_A F hF (suc (suc k))).ofe_dist_le k m
                      ((solver_f hF hInh (suc k)).ofe_mor_car
                        ((solver_g hF hInh (suc k)).ofe_mor_car y))
                      y
                      (solver_fg_dist hF hContr hInh k y)
                      (<_suc_<= hm),
                   \lam y =>
                    (solver_A F hF (suc (suc k))).ofe_dist_le k m
                      ((solver_f hF hInh (suc k)).ofe_mor_car
                        ((solver_g hF hInh (suc k)).ofe_mor_car y))
                      y
                      (solver_fg_dist hF hContr hInh k y)
                      (<_suc_<= hm))
            })
            x)
          (((solver_A F hF (suc (suc (suc k)))).ofe_equiv_dist
            ((F.oFunctor_map (ofe_mor_id, ofe_mor_id)).ofe_mor_car x)
            x).1 (F.oFunctor_map_id x) (suc k)))

\lemma solver_f_tower {F : OFunctor} (hF : OFunctorApplyCOFE F)
                      (hContr : OFunctorContractive F)
                      (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                      (k : Nat) (X : (TowerCOFE F hF hInh).E) :
  (solver_A F hF (suc (suc k))).dist k
    ((solver_f hF hInh (suc k)).ofe_mor_car (X.tower_car (suc k)))
    (X.tower_car (suc (suc k))) =>
  (solver_A F hF (suc (suc k))).ofe_dist_trans k
    ((solver_f hF hInh (suc k)).ofe_mor_car (X.tower_car (suc k)))
    ((solver_f hF hInh (suc k)).ofe_mor_car
      ((solver_g hF hInh (suc k)).ofe_mor_car (X.tower_car (suc (suc k)))))
    (X.tower_car (suc (suc k)))
    ((solver_f hF hInh (suc k)).ofe_mor_ne k
      (X.tower_car (suc k))
      ((solver_g hF hInh (suc k)).ofe_mor_car (X.tower_car (suc (suc k))))
      (((solver_A F hF (suc k)).ofe_equiv_dist
        (X.tower_car (suc k))
        ((solver_g hF hInh (suc k)).ofe_mor_car (X.tower_car (suc (suc k))))).1
        ((solver_A F hF (suc k)).equiv_sym
          ((solver_g hF hInh (suc k)).ofe_mor_car (X.tower_car (suc (suc k))))
          (X.tower_car (suc k))
          (X.g_tower (suc k)))
        k))
    (solver_fg_dist hF hContr hInh k (X.tower_car (suc (suc k))))

\lemma solver_ff_tower {F : OFunctor} (hF : OFunctorApplyCOFE F)
                       (hContr : OFunctorContractive F)
                       (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                       (k i : Nat) (X : (TowerCOFE F hF hInh).E) :
  (solver_A F hF ((Nat.+) i (suc k))).dist k
    ((solver_ff hF hInh {suc k} i).ofe_mor_car (X.tower_car (suc k)))
    (X.tower_car ((Nat.+) i (suc k))) \elim i
  | 0 => (solver_A F hF (suc k)).ofe_dist_refl k (X.tower_car (suc k))
  | suc i =>
      (solver_A F hF (suc ((Nat.+) i (suc k)))).ofe_dist_trans k
        ((solver_f hF hInh ((Nat.+) i (suc k))).ofe_mor_car
          ((solver_ff hF hInh {suc k} i).ofe_mor_car (X.tower_car (suc k))))
        ((solver_f hF hInh ((Nat.+) i (suc k))).ofe_mor_car
          (X.tower_car ((Nat.+) i (suc k))))
        (X.tower_car (suc ((Nat.+) i (suc k))))
        ((solver_f hF hInh ((Nat.+) i (suc k))).ofe_mor_ne k
          ((solver_ff hF hInh {suc k} i).ofe_mor_car (X.tower_car (suc k)))
          (X.tower_car ((Nat.+) i (suc k)))
          (solver_ff_tower hF hContr hInh k i X))
        ((solver_A F hF (suc (suc ((Nat.+) i k)))).ofe_dist_le ((Nat.+) i k) k
          ((solver_f hF hInh (suc ((Nat.+) i k))).ofe_mor_car
            (X.tower_car (suc ((Nat.+) i k))))
          (X.tower_car (suc (suc ((Nat.+) i k))))
          (solver_f_tower hF hContr hInh ((Nat.+) i k) X)
          (solver_le_plus_right k i))

\func solver_coerce {F : OFunctor} (hF : OFunctorApplyCOFE F)
                    {i j : Nat} (p : i = j) :
  OFEMor (solver_A F hF i) (solver_A F hF j) \elim p
  | idp => ofe_mor_id

\func solver_embed_coerce {F : OFunctor} (hF : OFunctorApplyCOFE F)
                          (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                          {k : Nat} (i : Nat) :
  OFEMor (solver_A F hF k) (solver_A F hF i) \elim k, i
  | 0, 0 => ofe_mor_id
  | 0, suc i => ofe_mor_comp (solver_f hF hInh i) (solver_embed_coerce hF hInh {0} i)
  | suc k, 0 => ofe_mor_comp (solver_embed_coerce hF hInh {k} 0) (solver_g hF hInh k)
  | suc k, suc i =>
      F.oFunctor_map
        (solver_embed_coerce hF hInh {i} k,
         solver_embed_coerce hF hInh {k} i)

\func solver_g_coerce {F : OFunctor} (hF : OFunctorApplyCOFE F)
                      (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                      {k j : Nat} (p : k = j)
                      (x : (solver_A F hF (suc k)).E) :
  (solver_g hF hInh j).ofe_mor_car ((solver_coerce hF (pmap suc p)).ofe_mor_car x) =
    (solver_coerce hF p).ofe_mor_car ((solver_g hF hInh k).ofe_mor_car x)
  \elim p
  | idp => idp

\func solver_coerce_f {F : OFunctor} (hF : OFunctorApplyCOFE F)
                      (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                      {k j : Nat} (p : k = j)
                      (x : (solver_A F hF k).E) :
  (solver_coerce hF (pmap suc p)).ofe_mor_car ((solver_f hF hInh k).ofe_mor_car x) =
    (solver_f hF hInh j).ofe_mor_car
      ((solver_coerce hF p).ofe_mor_car x)
  \elim p
  | idp => idp

\record SolverEmbedCoerceLaws (F : OFunctor) (hF : OFunctorApplyCOFE F)
                              (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                              (k i : Nat)
  | g_embed_coerce (x : (solver_A F hF k).E) :
      (solver_A F hF i).equiv
        ((solver_g hF hInh i).ofe_mor_car
          ((solver_embed_coerce hF hInh {k} (suc i)).ofe_mor_car x))
        ((solver_embed_coerce hF hInh {k} i).ofe_mor_car x)
  | f_embed_coerce (x : (solver_A F hF i).E) :
      (solver_A F hF k).equiv
        ((solver_embed_coerce hF hInh {suc i} k).ofe_mor_car
          ((solver_f hF hInh i).ofe_mor_car x))
        ((solver_embed_coerce hF hInh {i} k).ofe_mor_car x)

\lemma solver_g_embed_coerce_zero {F : OFunctor} (hF : OFunctorApplyCOFE F)
                                  (hContr : OFunctorContractive F)
                                  (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                                  (i : Nat) (x : (solver_A F hF 0).E) :
  (solver_A F hF i).equiv
    ((solver_g hF hInh i).ofe_mor_car
      ((solver_embed_coerce hF hInh {0} (suc i)).ofe_mor_car x))
    ((solver_embed_coerce hF hInh {0} i).ofe_mor_car x) \elim i
  | 0 => solver_gf hF hContr hInh 0 x
  | suc i =>
      solver_gf hF hContr hInh (suc i)
        ((solver_embed_coerce hF hInh {0} (suc i)).ofe_mor_car x)

\lemma solver_f_embed_coerce_to_zero {F : OFunctor} (hF : OFunctorApplyCOFE F)
                                     (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                                     (i : Nat) (x : (solver_A F hF i).E) :
  (solver_A F hF 0).equiv
    ((solver_embed_coerce hF hInh {suc i} 0).ofe_mor_car
      ((solver_f hF hInh i).ofe_mor_car x))
    ((solver_embed_coerce hF hInh {i} 0).ofe_mor_car x) =>
  \case ((solver_embed_coerce hF hInh {suc i} 0).ofe_mor_car
          ((solver_f hF hInh i).ofe_mor_car x)),
        ((solver_embed_coerce hF hInh {i} 0).ofe_mor_car x) \with {
    | (), () => idp
  }

\lemma solver_g_embed_coerce_to_zero {F : OFunctor} (hF : OFunctorApplyCOFE F)
                                     (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                                     {k : Nat} (x : (solver_A F hF k).E) :
  (solver_A F hF 0).equiv
    ((solver_g hF hInh 0).ofe_mor_car
      ((solver_embed_coerce hF hInh {k} 1).ofe_mor_car x))
    ((solver_embed_coerce hF hInh {k} 0).ofe_mor_car x) =>
  \case ((solver_g hF hInh 0).ofe_mor_car
          ((solver_embed_coerce hF hInh {k} 1).ofe_mor_car x)),
        ((solver_embed_coerce hF hInh {k} 0).ofe_mor_car x) \with {
    | (), () => idp
  }

\lemma solver_f_embed_coerce_from_zero {F : OFunctor} (hF : OFunctorApplyCOFE F)
                                       (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                                       (k : Nat) (x : (solver_A F hF 0).E) :
  (solver_A F hF k).equiv
    ((solver_embed_coerce hF hInh {1} k).ofe_mor_car
      ((solver_f hF hInh 0).ofe_mor_car x))
    ((solver_embed_coerce hF hInh {0} k).ofe_mor_car x) \elim k
  | 0 =>
      \case x \with {
        | () => \case ((solver_embed_coerce hF hInh {1} 0).ofe_mor_car
                        ((solver_f hF hInh 0).ofe_mor_car ())) \with {
            | () => idp
          }
      }
  | suc 0 =>
      \case x \with {
        | () => F.oFunctor_map_id ((solver_f hF hInh 0).ofe_mor_car ())
      }
  | suc (suc k) =>
      \case x \with {
        | () =>
          (solver_A F hF (suc (suc k))).equiv_trans
            ((solver_embed_coerce hF hInh {1} (suc (suc k))).ofe_mor_car
              ((solver_f hF hInh 0).ofe_mor_car ()))
            ((solver_f hF hInh (suc k)).ofe_mor_car
              ((solver_embed_coerce hF hInh {1} (suc k)).ofe_mor_car
                ((solver_f hF hInh 0).ofe_mor_car ())))
            ((solver_embed_coerce hF hInh {0} (suc (suc k))).ofe_mor_car ())
            ((solver_A F hF (suc (suc k))).equiv_sym
              ((solver_f hF hInh (suc k)).ofe_mor_car
                ((solver_embed_coerce hF hInh {1} (suc k)).ofe_mor_car
                  ((solver_f hF hInh 0).ofe_mor_car ())))
              ((solver_embed_coerce hF hInh {1} (suc (suc k))).ofe_mor_car
                ((solver_f hF hInh 0).ofe_mor_car ()))
              (F.oFunctor_map_compose
                (solver_embed_coerce hF hInh {k} 0)
                (solver_g hF hInh k)
                (solver_embed_coerce hF hInh {0} k)
                (solver_f hF hInh k)
                ((solver_f hF hInh 0).ofe_mor_car ())))
            (ofe_mor_proper (solver_f hF hInh (suc k))
              ((solver_embed_coerce hF hInh {1} (suc k)).ofe_mor_car
                ((solver_f hF hInh 0).ofe_mor_car ()))
              ((solver_embed_coerce hF hInh {0} (suc k)).ofe_mor_car ())
              (solver_f_embed_coerce_from_zero hF hInh (suc k) ()))
      }

\lemma solver_oFunctor_map_equiv (F : OFunctor)
                                 {A1 A2 B1 B2 : COFE.{0}}
                                 (f g : OFEMor A2 A1)
                                 (f' g' : OFEMor B1 B2)
                                 (hfg : (OFEMorOFE A2 A1).equiv f g)
                                 (hfg' : (OFEMorOFE B1 B2).equiv f' g')
                                 (x : (F.oFunctor_car A1 B1).E) :
  (F.oFunctor_car A2 B2).equiv
    ((F.oFunctor_map (f, f')).ofe_mor_car x)
    ((F.oFunctor_map (g, g')).ofe_mor_car x) =>
  ((F.oFunctor_car A2 B2).ofe_equiv_dist
    ((F.oFunctor_map (f, f')).ofe_mor_car x)
    ((F.oFunctor_map (g, g')).ofe_mor_car x)).2
    (\lam n =>
      F.oFunctor_map_ne n (f, f') (g, g')
        (((OFEMorOFE A2 A1).ofe_equiv_dist f g).1 hfg n,
         ((OFEMorOFE B1 B2).ofe_equiv_dist f' g').1 hfg' n)
        x)

\lemma solver_eq_equiv {O : OFE} (x y : O.E) (p : x = y) : O.equiv x y =>
  (O.ofe_equiv_dist x y).2 (equiv_dist_n x y p)

\lemma solver_g_embed_coerce_suc_suc {F : OFunctor} (hF : OFunctorApplyCOFE F)
                                     (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                                     {k i : Nat}
                                     (law : SolverEmbedCoerceLaws F hF hInh k i)
                                     (x : (solver_A F hF (suc k)).E) :
  (solver_A F hF (suc i)).equiv
    ((solver_g hF hInh (suc i)).ofe_mor_car
      ((solver_embed_coerce hF hInh {suc k} (suc (suc i))).ofe_mor_car x))
    ((solver_embed_coerce hF hInh {suc k} (suc i)).ofe_mor_car x) =>
  (solver_A F hF (suc i)).equiv_trans
    ((F.oFunctor_map (solver_f hF hInh i, solver_g hF hInh i)).ofe_mor_car
      ((F.oFunctor_map
        (solver_embed_coerce hF hInh {suc i} k,
         solver_embed_coerce hF hInh {k} (suc i))).ofe_mor_car x))
    ((F.oFunctor_map
      (ofe_mor_comp (solver_embed_coerce hF hInh {suc i} k) (solver_f hF hInh i),
       ofe_mor_comp (solver_g hF hInh i) (solver_embed_coerce hF hInh {k} (suc i)))).ofe_mor_car x)
    ((F.oFunctor_map
      (solver_embed_coerce hF hInh {i} k,
       solver_embed_coerce hF hInh {k} i)).ofe_mor_car x)
    (F.oFunctor_map_compose
      (solver_embed_coerce hF hInh {suc i} k) (solver_f hF hInh i)
      (solver_embed_coerce hF hInh {k} (suc i)) (solver_g hF hInh i)
      x)
    (solver_oFunctor_map_equiv F
      (ofe_mor_comp (solver_embed_coerce hF hInh {suc i} k) (solver_f hF hInh i))
      (solver_embed_coerce hF hInh {i} k)
      (ofe_mor_comp (solver_g hF hInh i) (solver_embed_coerce hF hInh {k} (suc i)))
      (solver_embed_coerce hF hInh {k} i)
      (\lam y => law.f_embed_coerce y)
      (\lam y => law.g_embed_coerce y)
      x)

\lemma solver_f_embed_coerce_suc_suc {F : OFunctor} (hF : OFunctorApplyCOFE F)
                                     (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                                     {k i : Nat}
                                     (law : SolverEmbedCoerceLaws F hF hInh k i)
                                     (x : (solver_A F hF (suc i)).E) :
  (solver_A F hF (suc k)).equiv
    ((solver_embed_coerce hF hInh {suc (suc i)} (suc k)).ofe_mor_car
      ((solver_f hF hInh (suc i)).ofe_mor_car x))
    ((solver_embed_coerce hF hInh {suc i} (suc k)).ofe_mor_car x) =>
  (solver_A F hF (suc k)).equiv_trans
    ((F.oFunctor_map
      (solver_embed_coerce hF hInh {k} (suc i),
       solver_embed_coerce hF hInh {suc i} k)).ofe_mor_car
      ((F.oFunctor_map (solver_g hF hInh i, solver_f hF hInh i)).ofe_mor_car x))
    ((F.oFunctor_map
      (ofe_mor_comp (solver_g hF hInh i) (solver_embed_coerce hF hInh {k} (suc i)),
       ofe_mor_comp (solver_embed_coerce hF hInh {suc i} k) (solver_f hF hInh i))).ofe_mor_car x)
    ((F.oFunctor_map
      (solver_embed_coerce hF hInh {k} i,
       solver_embed_coerce hF hInh {i} k)).ofe_mor_car x)
    (F.oFunctor_map_compose
      (solver_g hF hInh i) (solver_embed_coerce hF hInh {k} (suc i))
      (solver_f hF hInh i) (solver_embed_coerce hF hInh {suc i} k)
      x)
    (solver_oFunctor_map_equiv F
      (ofe_mor_comp (solver_g hF hInh i) (solver_embed_coerce hF hInh {k} (suc i)))
      (solver_embed_coerce hF hInh {k} i)
      (ofe_mor_comp (solver_embed_coerce hF hInh {suc i} k) (solver_f hF hInh i))
      (solver_embed_coerce hF hInh {i} k)
      (\lam y => law.g_embed_coerce y)
      (\lam y => law.f_embed_coerce y)
      x)

\func solver_embed_coerce_laws {F : OFunctor} (hF : OFunctorApplyCOFE F)
                               (hContr : OFunctorContractive F)
                               (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                               (k i : Nat) : SolverEmbedCoerceLaws F hF hInh k i \elim k, i
  | 0, i => \new SolverEmbedCoerceLaws F hF hInh 0 i {
      | g_embed_coerce => solver_g_embed_coerce_zero hF hContr hInh i
      | f_embed_coerce => solver_f_embed_coerce_to_zero hF hInh i
    }
  | suc k, 0 => \new SolverEmbedCoerceLaws F hF hInh (suc k) 0 {
      | g_embed_coerce => \lam x => solver_g_embed_coerce_to_zero hF hInh {suc k} x
      | f_embed_coerce => \lam x => solver_f_embed_coerce_from_zero hF hInh (suc k) x
    }
  | suc k, suc i => \new SolverEmbedCoerceLaws F hF hInh (suc k) (suc i) {
      | g_embed_coerce => solver_g_embed_coerce_suc_suc hF hInh (solver_embed_coerce_laws hF hContr hInh k i)
      | f_embed_coerce => solver_f_embed_coerce_suc_suc hF hInh (solver_embed_coerce_laws hF hContr hInh k i)
    }

\func solver_embed {F : OFunctor} (hF : OFunctorApplyCOFE F)
                   (hContr : OFunctorContractive F)
                   (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                   (k : Nat) (x : (solver_A F hF k).E) : Tower F hF hInh \cowith
  | tower_car => \lam i => (solver_embed_coerce hF hInh {k} i).ofe_mor_car x
  | g_tower => \lam i => (solver_embed_coerce_laws hF hContr hInh k i).g_embed_coerce x

\func solver_embed_mor {F : OFunctor} (hF : OFunctorApplyCOFE F)
                       (hContr : OFunctorContractive F)
                       (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                       (k : Nat) : OFEMor (solver_A F hF k) (TowerCOFE F hF hInh) \cowith
  | ofe_mor_car => solver_embed hF hContr hInh k
  | ofe_mor_ne => \lam n x y h i => (solver_embed_coerce hF hInh {k} i).ofe_mor_ne n x y h

\lemma solver_embed_self {F : OFunctor} (hF : OFunctorApplyCOFE F)
                         (hContr : OFunctorContractive F)
                         (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                         (k : Nat) (x : (solver_A F hF k).E) :
  (solver_A F hF k).equiv
    ((solver_embed hF hContr hInh k x).tower_car k)
    x \elim k
  | 0 => \case x \with { | () => idp }
  | suc k =>
      (solver_A F hF (suc k)).equiv_trans
        ((F.oFunctor_map
          (solver_embed_coerce hF hInh {k} k,
           solver_embed_coerce hF hInh {k} k)).ofe_mor_car x)
        ((F.oFunctor_map (ofe_mor_id, ofe_mor_id)).ofe_mor_car x)
        x
        (solver_oFunctor_map_equiv F
          (solver_embed_coerce hF hInh {k} k)
          ofe_mor_id
          (solver_embed_coerce hF hInh {k} k)
          ofe_mor_id
          (\lam y => solver_embed_self hF hContr hInh k y)
          (\lam y => solver_embed_self hF hContr hInh k y)
          x)
        (F.oFunctor_map_id x)

\lemma solver_embed_f {F : OFunctor} (hF : OFunctorApplyCOFE F)
                      (hContr : OFunctorContractive F)
                      (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                      (k : Nat) (x : (solver_A F hF k).E) :
  (TowerCOFE F hF hInh).equiv
    (solver_embed hF hContr hInh (suc k) ((solver_f hF hInh k).ofe_mor_car x))
    (solver_embed hF hContr hInh k x) =>
  \lam i => (solver_embed_coerce_laws hF hContr hInh i k).f_embed_coerce x

\lemma solver_embed_ff {F : OFunctor} (hF : OFunctorApplyCOFE F)
                       (hContr : OFunctorContractive F)
                       (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                       {k : Nat} (d : Nat) (x : (solver_A F hF k).E) :
  (TowerCOFE F hF hInh).equiv
    (solver_embed hF hContr hInh ((Nat.+) d k)
      ((solver_ff hF hInh {k} d).ofe_mor_car x))
    (solver_embed hF hContr hInh k x) \elim d
  | 0 => (TowerCOFE F hF hInh).equiv_refl (solver_embed hF hContr hInh k x)
  | suc d =>
      (TowerCOFE F hF hInh).equiv_trans
        (solver_embed hF hContr hInh (suc ((Nat.+) d k))
          ((solver_f hF hInh ((Nat.+) d k)).ofe_mor_car
            ((solver_ff hF hInh {k} d).ofe_mor_car x)))
        (solver_embed hF hContr hInh ((Nat.+) d k)
          ((solver_ff hF hInh {k} d).ofe_mor_car x))
        (solver_embed hF hContr hInh k x)
        (solver_embed_f hF hContr hInh ((Nat.+) d k)
          ((solver_ff hF hInh {k} d).ofe_mor_car x))
        (solver_embed_ff hF hContr hInh d x)

\lemma solver_embed_tower_upper {F : OFunctor} (hF : OFunctorApplyCOFE F)
                                (hContr : OFunctorContractive F)
                                (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                                (k d : Nat) (X : (TowerCOFE F hF hInh).E) :
  (solver_A F hF ((Nat.+) d (suc k))).dist k
    ((solver_embed hF hContr hInh (suc k) (X.tower_car (suc k))).tower_car ((Nat.+) d (suc k)))
    (X.tower_car ((Nat.+) d (suc k))) =>
  \let
    | y : (solver_A F hF ((Nat.+) d (suc k))).E =>
        ((solver_ff hF hInh {suc k} d).ofe_mor_car (X.tower_car (suc k)))
    | h_embed_y : (solver_A F hF ((Nat.+) d (suc k))).equiv
        ((solver_embed hF hContr hInh ((Nat.+) d (suc k)) y).tower_car ((Nat.+) d (suc k)))
        y =>
        solver_embed_self hF hContr hInh ((Nat.+) d (suc k)) y
    | h_ff_embed : (solver_A F hF ((Nat.+) d (suc k))).equiv
        ((solver_embed hF hContr hInh ((Nat.+) d (suc k)) y).tower_car ((Nat.+) d (suc k)))
        ((solver_embed hF hContr hInh (suc k) (X.tower_car (suc k))).tower_car ((Nat.+) d (suc k))) =>
        (solver_embed_ff hF hContr hInh d (X.tower_car (suc k))) ((Nat.+) d (suc k))
    | h_embed_ff : (solver_A F hF ((Nat.+) d (suc k))).equiv
        ((solver_embed hF hContr hInh (suc k) (X.tower_car (suc k))).tower_car ((Nat.+) d (suc k)))
        y =>
        (solver_A F hF ((Nat.+) d (suc k))).equiv_trans
          ((solver_embed hF hContr hInh (suc k) (X.tower_car (suc k))).tower_car ((Nat.+) d (suc k)))
          ((solver_embed hF hContr hInh ((Nat.+) d (suc k)) y).tower_car ((Nat.+) d (suc k)))
          y
          ((solver_A F hF ((Nat.+) d (suc k))).equiv_sym
            ((solver_embed hF hContr hInh ((Nat.+) d (suc k)) y).tower_car ((Nat.+) d (suc k)))
            ((solver_embed hF hContr hInh (suc k) (X.tower_car (suc k))).tower_car ((Nat.+) d (suc k)))
            h_ff_embed)
          h_embed_y
  \in (solver_A F hF ((Nat.+) d (suc k))).ofe_dist_trans k
      ((solver_embed hF hContr hInh (suc k) (X.tower_car (suc k))).tower_car ((Nat.+) d (suc k)))
      y
      (X.tower_car ((Nat.+) d (suc k)))
      (((solver_A F hF ((Nat.+) d (suc k))).ofe_equiv_dist
        ((solver_embed hF hContr hInh (suc k) (X.tower_car (suc k))).tower_car ((Nat.+) d (suc k)))
        y).1 h_embed_ff k)
      (solver_ff_tower hF hContr hInh k d X)

\lemma solver_embed_tower_lower {F : OFunctor} (hF : OFunctorApplyCOFE F)
                                (hContr : OFunctorContractive F)
                                (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                                (d i : Nat) (X : (TowerCOFE F hF hInh).E) :
  (solver_A F hF i).equiv
    ((solver_embed hF hContr hInh ((Nat.+) d i) (X.tower_car ((Nat.+) d i))).tower_car i)
    (X.tower_car i) =>
  \let
    | E : (TowerCOFE F hF hInh).E =>
        solver_embed hF hContr hInh ((Nat.+) d i) (X.tower_car ((Nat.+) d i))
    | hE : (solver_A F hF i).equiv
        ((solver_gg hF hInh {i} d).ofe_mor_car (E.tower_car ((Nat.+) d i)))
        (E.tower_car i) =>
        solver_gg_tower hF hInh d E
    | hX : (solver_A F hF i).equiv
        ((solver_gg hF hInh {i} d).ofe_mor_car (X.tower_car ((Nat.+) d i)))
        (X.tower_car i) =>
        solver_gg_tower hF hInh d X
    | hself : (solver_A F hF ((Nat.+) d i)).equiv
        (E.tower_car ((Nat.+) d i))
        (X.tower_car ((Nat.+) d i)) =>
        solver_embed_self hF hContr hInh ((Nat.+) d i) (X.tower_car ((Nat.+) d i))
    | hgg : (solver_A F hF i).equiv
        ((solver_gg hF hInh {i} d).ofe_mor_car (E.tower_car ((Nat.+) d i)))
        ((solver_gg hF hInh {i} d).ofe_mor_car (X.tower_car ((Nat.+) d i))) =>
        ofe_mor_proper (solver_gg hF hInh {i} d)
          (E.tower_car ((Nat.+) d i))
          (X.tower_car ((Nat.+) d i))
          hself
  \in (solver_A F hF i).equiv_trans
      (E.tower_car i)
      ((solver_gg hF hInh {i} d).ofe_mor_car (E.tower_car ((Nat.+) d i)))
      (X.tower_car i)
      ((solver_A F hF i).equiv_sym
        ((solver_gg hF hInh {i} d).ofe_mor_car (E.tower_car ((Nat.+) d i)))
        (E.tower_car i)
        hE)
      ((solver_A F hF i).equiv_trans
        ((solver_gg hF hInh {i} d).ofe_mor_car (E.tower_car ((Nat.+) d i)))
        ((solver_gg hF hInh {i} d).ofe_mor_car (X.tower_car ((Nat.+) d i)))
        (X.tower_car i)
        hgg
        hX)

\lemma solver_embed_tower_component {F : OFunctor} (hF : OFunctorApplyCOFE F)
                                    (hContr : OFunctorContractive F)
                                    (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                                    (k i : Nat) (X : (TowerCOFE F hF hInh).E) :
  (solver_A F hF i).dist k
    ((solver_embed hF hContr hInh (suc k) (X.tower_car (suc k))).tower_car i)
    (X.tower_car i) =>
  \case solver_nat_split (suc k) i \with {
    | split_left d p =>
        transport
          (\lam z => (solver_A F hF i).dist k
            ((solver_embed hF hContr hInh z (X.tower_car z)).tower_car i)
            (X.tower_car i))
          (inv p)
          (((solver_A F hF i).ofe_equiv_dist
            ((solver_embed hF hContr hInh ((Nat.+) d i) (X.tower_car ((Nat.+) d i))).tower_car i)
            (X.tower_car i)).1
            (solver_embed_tower_lower hF hContr hInh d i X)
            k)
    | split_right d p =>
        transport
          (\lam z => (solver_A F hF z).dist k
            ((solver_embed hF hContr hInh (suc k) (X.tower_car (suc k))).tower_car z)
            (X.tower_car z))
          (inv p)
          (solver_embed_tower_upper hF hContr hInh k d X)
  }

\lemma solver_embed_tower {F : OFunctor} (hF : OFunctorApplyCOFE F)
                          (hContr : OFunctorContractive F)
                          (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                          (k : Nat) (X : (TowerCOFE F hF hInh).E) :
  (TowerCOFE F hF hInh).dist k
    (solver_embed hF hContr hInh (suc k) (X.tower_car (suc k)))
    X =>
  \lam i => solver_embed_tower_component hF hContr hInh k i X

\lemma solver_embed_g_later {F : OFunctor} (hF : OFunctorApplyCOFE F)
                            (hContr : OFunctorContractive F)
                            (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                            (n : Nat) (y : (solver_A F hF (suc n)).E) :
  DistLater {TowerOFE F hF hInh} n
    (solver_embed hF hContr hInh n ((solver_g hF hInh n).ofe_mor_car y))
    (solver_embed hF hContr hInh (suc n) y) \elim n
  | 0 => dist_later_zero _ _
  | suc n => \new DistLater {
      | dist_later_lt => \lam m hm i =>
          (solver_A F hF i).ofe_dist_trans m
            ((solver_embed hF hContr hInh (suc n)
              ((solver_g hF hInh (suc n)).ofe_mor_car y)).tower_car i)
            ((solver_embed hF hContr hInh (suc (suc n))
              ((solver_f hF hInh (suc n)).ofe_mor_car
                ((solver_g hF hInh (suc n)).ofe_mor_car y))).tower_car i)
            ((solver_embed hF hContr hInh (suc (suc n)) y).tower_car i)
            (((solver_A F hF i).ofe_equiv_dist
              ((solver_embed hF hContr hInh (suc n)
                ((solver_g hF hInh (suc n)).ofe_mor_car y)).tower_car i)
              ((solver_embed hF hContr hInh (suc (suc n))
                ((solver_f hF hInh (suc n)).ofe_mor_car
                  ((solver_g hF hInh (suc n)).ofe_mor_car y))).tower_car i)).1
              ((solver_A F hF i).equiv_sym
                ((solver_embed hF hContr hInh (suc (suc n))
                  ((solver_f hF hInh (suc n)).ofe_mor_car
                    ((solver_g hF hInh (suc n)).ofe_mor_car y))).tower_car i)
                ((solver_embed hF hContr hInh (suc n)
                  ((solver_g hF hInh (suc n)).ofe_mor_car y)).tower_car i)
                ((solver_embed_f hF hContr hInh (suc n)
                  ((solver_g hF hInh (suc n)).ofe_mor_car y)) i))
              m)
            ((solver_embed_mor hF hContr hInh (suc (suc n))).ofe_mor_ne m
              ((solver_f hF hInh (suc n)).ofe_mor_car
                ((solver_g hF hInh (suc n)).ofe_mor_car y))
              y
              ((solver_A F hF (suc (suc n))).ofe_dist_le n m
                ((solver_f hF hInh (suc n)).ofe_mor_car
                  ((solver_g hF hInh (suc n)).ofe_mor_car y))
                y
                (solver_fg_dist hF hContr hInh n y)
                (<_suc_<= hm))
              i)
    }

\lemma solver_project_f_later {F : OFunctor} (hF : OFunctorApplyCOFE F)
                              (hContr : OFunctorContractive F)
                              (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                              (n : Nat) :
  DistLater {OFEMorOFE (TowerCOFE F hF hInh) (solver_A F hF (suc n))} n
    (ofe_mor_comp (solver_f hF hInh n) (solver_project hF hInh n))
    (solver_project hF hInh (suc n)) \elim n
  | 0 => dist_later_zero _ _
  | suc n => \new DistLater {
      | dist_later_lt => \lam m hm X =>
          (solver_A F hF (suc (suc n))).ofe_dist_le n m
            ((solver_f hF hInh (suc n)).ofe_mor_car (X.tower_car (suc n)))
            (X.tower_car (suc (suc n)))
            (solver_f_tower hF hContr hInh n X)
            (<_suc_<= hm)
    }

\lemma solver_embed_project_f_later {F : OFunctor} (hF : OFunctorApplyCOFE F)
                                    (hContr : OFunctorContractive F)
                                    (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                                    (n : Nat) :
  DistLater {OFEMorOFE (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)} n
    (ofe_mor_comp
      (solver_embed_mor hF hContr hInh (suc (suc n)))
      (ofe_mor_comp (solver_f hF hInh (suc n)) (solver_project hF hInh (suc n))))
    ofe_mor_id =>
  \new DistLater {
    | dist_later_lt => \lam m hm X i =>
        (solver_A F hF i).ofe_dist_trans m
          ((solver_embed hF hContr hInh (suc (suc n))
            ((solver_f hF hInh (suc n)).ofe_mor_car (X.tower_car (suc n)))).tower_car i)
          ((solver_embed hF hContr hInh (suc (suc n))
            (X.tower_car (suc (suc n)))).tower_car i)
          (X.tower_car i)
          ((solver_embed_mor hF hContr hInh (suc (suc n))).ofe_mor_ne m
            ((solver_f hF hInh (suc n)).ofe_mor_car (X.tower_car (suc n)))
            (X.tower_car (suc (suc n)))
            ((solver_A F hF (suc (suc n))).ofe_dist_le n m
              ((solver_f hF hInh (suc n)).ofe_mor_car (X.tower_car (suc n)))
              (X.tower_car (suc (suc n)))
              (solver_f_tower hF hContr hInh n X)
              (LinearOrder.<_<= hm))
            i)
          ((TowerCOFE F hF hInh).ofe_dist_le (suc n) m
            (solver_embed hF hContr hInh (suc (suc n)) (X.tower_car (suc (suc n))))
            X
            (solver_embed_tower hF hContr hInh (suc n) X)
            (<=-transitive (LinearOrder.<_<= hm) (n<=sucn n))
            i)
  }

\lemma solver_embed_project_g_later {F : OFunctor} (hF : OFunctorApplyCOFE F)
                                    (hContr : OFunctorContractive F)
                                    (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                                    (n : Nat) :
  DistLater {OFEMorOFE (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)} n
    (ofe_mor_comp
      (ofe_mor_comp
        (solver_embed_mor hF hContr hInh (suc n))
        (solver_g hF hInh (suc n)))
      (solver_project hF hInh (suc (suc n))))
    ofe_mor_id =>
  \new DistLater {
    | dist_later_lt => \lam m hm X i =>
        (solver_A F hF i).ofe_dist_trans m
          ((solver_embed hF hContr hInh (suc n)
            ((solver_g hF hInh (suc n)).ofe_mor_car (X.tower_car (suc (suc n))))).tower_car i)
          ((solver_embed hF hContr hInh (suc n) (X.tower_car (suc n))).tower_car i)
          (X.tower_car i)
          (((solver_A F hF i).ofe_equiv_dist
            ((solver_embed hF hContr hInh (suc n)
              ((solver_g hF hInh (suc n)).ofe_mor_car (X.tower_car (suc (suc n))))).tower_car i)
            ((solver_embed hF hContr hInh (suc n) (X.tower_car (suc n))).tower_car i)).1
            ((ofe_mor_proper (solver_embed_mor hF hContr hInh (suc n))
              ((solver_g hF hInh (suc n)).ofe_mor_car (X.tower_car (suc (suc n))))
              (X.tower_car (suc n))
              (X.g_tower (suc n))) i)
            m)
          ((TowerCOFE F hF hInh).ofe_dist_le n m
            (solver_embed hF hContr hInh (suc n) (X.tower_car (suc n)))
            X
            (solver_embed_tower hF hContr hInh n X)
            (LinearOrder.<_<= hm)
            i)
  }

\func solver_unfold_chain_car {F : OFunctor} (hF : OFunctorApplyCOFE F)
                              (hContr : OFunctorContractive F)
                              (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                              (X : (TowerCOFE F hF hInh).E)
                              (n : Nat) : (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).E =>
  (F.oFunctor_map (solver_project hF hInh n, solver_embed_mor hF hContr hInh n)).ofe_mor_car
    (X.tower_car (suc n))

\lemma solver_unfold_chain_step {F : OFunctor} (hF : OFunctorApplyCOFE F)
                                (hContr : OFunctorContractive F)
                                (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                                (X : (TowerCOFE F hF hInh).E)
                                (n : Nat) :
  (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).dist n
    (solver_unfold_chain_car hF hContr hInh X (suc n))
    (solver_unfold_chain_car hF hContr hInh X n) =>
  \let
    | Xss : (solver_A F hF (suc (suc n))).E => X.tower_car (suc (suc n))
    | mid => (F.oFunctor_map
        (ofe_mor_comp (solver_f hF hInh n) (solver_project hF hInh n),
         ofe_mor_comp (solver_embed_mor hF hContr hInh n) (solver_g hF hInh n))).ofe_mor_car Xss
    | pre => (F.oFunctor_map
        (solver_project hF hInh n,
         solver_embed_mor hF hContr hInh n)).ofe_mor_car
        ((solver_g hF hInh (suc n)).ofe_mor_car Xss)
    | hcomp : (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).equiv pre mid =>
        F.oFunctor_map_compose
          (solver_f hF hInh n) (solver_project hF hInh n)
          (solver_g hF hInh n) (solver_embed_mor hF hContr hInh n)
          Xss
    | d_first_mid : (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).dist n
        (solver_unfold_chain_car hF hContr hInh X (suc n))
        mid =>
        (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).ofe_dist_sym n
          mid
          (solver_unfold_chain_car hF hContr hInh X (suc n))
          (hContr.oFunctor_map_contractive n
            (ofe_mor_comp (solver_f hF hInh n) (solver_project hF hInh n),
             ofe_mor_comp (solver_embed_mor hF hContr hInh n) (solver_g hF hInh n))
            (solver_project hF hInh (suc n), solver_embed_mor hF hContr hInh (suc n))
            (\new DistLater {
              | dist_later_lt => \lam m hm =>
                  ((solver_project_f_later hF hContr hInh n).dist_later_lt m hm,
                   \lam y => (solver_embed_g_later hF hContr hInh n y).dist_later_lt m hm)
            })
            Xss)
    | d_mid_pre : (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).dist n mid pre =>
        (((F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).ofe_equiv_dist mid pre).1
          ((F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).equiv_sym pre mid hcomp)
          n)
    | d_pre_last : (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).dist n pre
        (solver_unfold_chain_car hF hContr hInh X n) =>
        (F.oFunctor_map (solver_project hF hInh n, solver_embed_mor hF hContr hInh n)).ofe_mor_ne n
          ((solver_g hF hInh (suc n)).ofe_mor_car Xss)
          (X.tower_car (suc n))
          (((solver_A F hF (suc n)).ofe_equiv_dist
            ((solver_g hF hInh (suc n)).ofe_mor_car Xss)
            (X.tower_car (suc n))).1 (X.g_tower (suc n)) n)
  \in (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).ofe_dist_trans n
      (solver_unfold_chain_car hF hContr hInh X (suc n))
      mid
      (solver_unfold_chain_car hF hContr hInh X n)
      d_first_mid
      ((F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).ofe_dist_trans n
        mid
        pre
        (solver_unfold_chain_car hF hContr hInh X n)
        d_mid_pre
        d_pre_last)

\lemma solver_suc_not_le_zero (n : Nat) : suc n LinearOrder.<= 0 -> Empty =>
  \lam le => le (NatOrder.zero<suc {n})

\lemma solver_unfold_chain_cauchy_zero {F : OFunctor} (hF : OFunctorApplyCOFE F)
                                       (hContr : OFunctorContractive F)
                                       (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                                       (X : (TowerCOFE F hF hInh).E)
                                       (n : Nat) (le : n LinearOrder.<= 0) :
  (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).dist n
    (solver_unfold_chain_car hF hContr hInh X 0)
    (solver_unfold_chain_car hF hContr hInh X n) \elim n
  | 0 => (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).ofe_dist_refl 0
      (solver_unfold_chain_car hF hContr hInh X 0)
  | suc n => absurd (solver_suc_not_le_zero n le)

\lemma solver_unfold_chain_cauchy {F : OFunctor} (hF : OFunctorApplyCOFE F)
                                  (hContr : OFunctorContractive F)
                                  (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                                  (X : (TowerCOFE F hF hInh).E)
                                  (n m : Nat) (le : n LinearOrder.<= m) :
  (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).dist n
    (solver_unfold_chain_car hF hContr hInh X m)
    (solver_unfold_chain_car hF hContr hInh X n) \elim m
  | 0 => solver_unfold_chain_cauchy_zero hF hContr hInh X n le
  | suc m => \case LinearOrder.<=-dec le \with {
      | inr eq =>
          transport
            (\lam z => (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).dist n
              (solver_unfold_chain_car hF hContr hInh X z)
              (solver_unfold_chain_car hF hContr hInh X n))
            eq
            ((F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).ofe_dist_refl n
              (solver_unfold_chain_car hF hContr hInh X n))
      | inl lt =>
          (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).ofe_dist_trans n
            (solver_unfold_chain_car hF hContr hInh X (suc m))
            (solver_unfold_chain_car hF hContr hInh X m)
            (solver_unfold_chain_car hF hContr hInh X n)
            ((F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).ofe_dist_le m n
              (solver_unfold_chain_car hF hContr hInh X (suc m))
              (solver_unfold_chain_car hF hContr hInh X m)
              (solver_unfold_chain_step hF hContr hInh X m)
              (<_suc_<= lt))
            (solver_unfold_chain_cauchy hF hContr hInh X n m (<_suc_<= lt))
    }

\func solver_unfold_chain {F : OFunctor} (hF : OFunctorApplyCOFE F)
                          (hContr : OFunctorContractive F)
                          (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                          (X : (TowerCOFE F hF hInh).E)
  : \Sigma (c : Nat -> (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).E) (Chain c) =>
  (solver_unfold_chain_car hF hContr hInh X,
   \new Chain {
     | chain_cauchy => solver_unfold_chain_cauchy hF hContr hInh X
   })

\func solver_unfold {F : OFunctor} (hF : OFunctorApplyCOFE F)
                    (hContr : OFunctorContractive F)
                    (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
  : OFEMor (TowerCOFE F hF hInh) (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)) \cowith
  | ofe_mor_car => \lam X =>
      (oFunctor_applyCOFE F hF (TowerCOFE F hF hInh)).compl
        (solver_unfold_chain hF hContr hInh X).1
        (solver_unfold_chain hF hContr hInh X).2
  | ofe_mor_ne => \lam n X Y hXY =>
      (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).ofe_dist_trans n
        ((oFunctor_applyCOFE F hF (TowerCOFE F hF hInh)).compl
          (solver_unfold_chain hF hContr hInh X).1
          (solver_unfold_chain hF hContr hInh X).2)
        (solver_unfold_chain_car hF hContr hInh X n)
        ((oFunctor_applyCOFE F hF (TowerCOFE F hF hInh)).compl
          (solver_unfold_chain hF hContr hInh Y).1
          (solver_unfold_chain hF hContr hInh Y).2)
        ((oFunctor_applyCOFE F hF (TowerCOFE F hF hInh)).cofe_conv_compl
          (solver_unfold_chain hF hContr hInh X).1
          (solver_unfold_chain hF hContr hInh X).2
          n)
        ((F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).ofe_dist_trans n
          (solver_unfold_chain_car hF hContr hInh X n)
          (solver_unfold_chain_car hF hContr hInh Y n)
          ((oFunctor_applyCOFE F hF (TowerCOFE F hF hInh)).compl
            (solver_unfold_chain hF hContr hInh Y).1
            (solver_unfold_chain hF hContr hInh Y).2)
          ((F.oFunctor_map (solver_project hF hInh n, solver_embed_mor hF hContr hInh n)).ofe_mor_ne n
            (X.tower_car (suc n))
            (Y.tower_car (suc n))
            (hXY (suc n)))
          ((F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).ofe_dist_sym n
            ((oFunctor_applyCOFE F hF (TowerCOFE F hF hInh)).compl
              (solver_unfold_chain hF hContr hInh Y).1
              (solver_unfold_chain hF hContr hInh Y).2)
            (solver_unfold_chain_car hF hContr hInh Y n)
            ((oFunctor_applyCOFE F hF (TowerCOFE F hF hInh)).cofe_conv_compl
              (solver_unfold_chain hF hContr hInh Y).1
              (solver_unfold_chain hF hContr hInh Y).2
              n)))

\func solver_fold_car {F : OFunctor} (hF : OFunctorApplyCOFE F)
                      (hContr : OFunctorContractive F)
                      (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                      (X : (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).E)
                      (n : Nat) : (solver_A F hF n).E =>
  (solver_g hF hInh n).ofe_mor_car
    ((F.oFunctor_map (solver_embed_mor hF hContr hInh n, solver_project hF hInh n)).ofe_mor_car X)

\lemma solver_fold_car_tower {F : OFunctor} (hF : OFunctorApplyCOFE F)
                             (hContr : OFunctorContractive F)
                             (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                             (X : (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).E)
                             (k : Nat) :
  (solver_A F hF k).equiv
    ((solver_g hF hInh k).ofe_mor_car (solver_fold_car hF hContr hInh X (suc k)))
    (solver_fold_car hF hContr hInh X k) =>
  ofe_mor_proper (solver_g hF hInh k)
    (solver_fold_car hF hContr hInh X (suc k))
    ((F.oFunctor_map (solver_embed_mor hF hContr hInh k, solver_project hF hInh k)).ofe_mor_car X)
    ((solver_A F hF (suc k)).equiv_trans
      (solver_fold_car hF hContr hInh X (suc k))
      ((F.oFunctor_map
        (ofe_mor_comp (solver_embed_mor hF hContr hInh (suc k)) (solver_f hF hInh k),
         ofe_mor_comp (solver_g hF hInh k) (solver_project hF hInh (suc k)))).ofe_mor_car X)
      ((F.oFunctor_map (solver_embed_mor hF hContr hInh k, solver_project hF hInh k)).ofe_mor_car X)
      (F.oFunctor_map_compose
        (solver_embed_mor hF hContr hInh (suc k)) (solver_f hF hInh k)
        (solver_project hF hInh (suc k)) (solver_g hF hInh k)
        X)
      (solver_oFunctor_map_equiv F
        (ofe_mor_comp (solver_embed_mor hF hContr hInh (suc k)) (solver_f hF hInh k))
        (solver_embed_mor hF hContr hInh k)
        (ofe_mor_comp (solver_g hF hInh k) (solver_project hF hInh (suc k)))
        (solver_project hF hInh k)
        (\lam y => solver_embed_f hF hContr hInh k y)
        (\lam Y => Y.g_tower k)
        X))

\func solver_fold {F : OFunctor} (hF : OFunctorApplyCOFE F)
                  (hContr : OFunctorContractive F)
                  (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
  : OFEMor (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)) (TowerCOFE F hF hInh) \cowith
  | ofe_mor_car => \lam X => \new Tower F hF hInh {
      | tower_car => solver_fold_car hF hContr hInh X
      | g_tower => solver_fold_car_tower hF hContr hInh X
    }
  | ofe_mor_ne => \lam n X Y hXY k =>
      (solver_g hF hInh k).ofe_mor_ne n
        ((F.oFunctor_map (solver_embed_mor hF hContr hInh k, solver_project hF hInh k)).ofe_mor_car X)
        ((F.oFunctor_map (solver_embed_mor hF hContr hInh k, solver_project hF hInh k)).ofe_mor_car Y)
        ((F.oFunctor_map (solver_embed_mor hF hContr hInh k, solver_project hF hInh k)).ofe_mor_ne n X Y hXY)

\lemma solver_unfold_conv {F : OFunctor} (hF : OFunctorApplyCOFE F)
                          (hContr : OFunctorContractive F)
                          (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                          (X : (TowerCOFE F hF hInh).E)
                          (n : Nat) :
  (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).dist n
    ((solver_unfold hF hContr hInh).ofe_mor_car X)
    (solver_unfold_chain_car hF hContr hInh X n) =>
  (oFunctor_applyCOFE F hF (TowerCOFE F hF hInh)).cofe_conv_compl
    (solver_unfold_chain hF hContr hInh X).1
    (solver_unfold_chain hF hContr hInh X).2
    n

\lemma solver_unfold_fold_chain {F : OFunctor} (hF : OFunctorApplyCOFE F)
                                (hContr : OFunctorContractive F)
                                (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                                (X : (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).E)
                                (n : Nat) :
  (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).dist n
    (solver_unfold_chain_car hF hContr hInh
      ((solver_fold hF hContr hInh).ofe_mor_car X)
      (suc n))
    X =>
  \let
    | T : COFE.{0} => TowerCOFE F hF hInh
    | G : OFE.{0} => F.oFunctor_car T T
    | z : (F.oFunctor_car (solver_A F hF (suc (suc n))) (solver_A F hF (suc (suc n)))).E =>
        ((F.oFunctor_map
          (solver_embed_mor hF hContr hInh (suc (suc n)),
           solver_project hF hInh (suc (suc n)))).ofe_mor_car X)
    | mid1 : G.E =>
        ((F.oFunctor_map
          (ofe_mor_comp (solver_f hF hInh (suc n)) (solver_project hF hInh (suc n)),
           ofe_mor_comp (solver_embed_mor hF hContr hInh (suc n)) (solver_g hF hInh (suc n)))).ofe_mor_car z)
    | mid2 : G.E =>
        ((F.oFunctor_map
          (ofe_mor_comp
            (solver_embed_mor hF hContr hInh (suc (suc n)))
            (ofe_mor_comp (solver_f hF hInh (suc n)) (solver_project hF hInh (suc n))),
           ofe_mor_comp
            (ofe_mor_comp (solver_embed_mor hF hContr hInh (suc n)) (solver_g hF hInh (suc n)))
            (solver_project hF hInh (suc (suc n))))).ofe_mor_car X)
    | h_chain_mid1 : G.equiv
        (solver_unfold_chain_car hF hContr hInh
          ((solver_fold hF hContr hInh).ofe_mor_car X)
          (suc n))
        mid1 =>
        F.oFunctor_map_compose
          (solver_f hF hInh (suc n)) (solver_project hF hInh (suc n))
          (solver_g hF hInh (suc n)) (solver_embed_mor hF hContr hInh (suc n))
          z
    | h_mid1_mid2 : G.equiv mid1 mid2 =>
        F.oFunctor_map_compose
          (solver_embed_mor hF hContr hInh (suc (suc n)))
          (ofe_mor_comp (solver_f hF hInh (suc n)) (solver_project hF hInh (suc n)))
          (solver_project hF hInh (suc (suc n)))
          (ofe_mor_comp (solver_embed_mor hF hContr hInh (suc n)) (solver_g hF hInh (suc n)))
          X
    | h_mid2_id : G.dist n mid2 ((F.oFunctor_map (ofe_mor_id, ofe_mor_id)).ofe_mor_car X) =>
        hContr.oFunctor_map_contractive n
          (ofe_mor_comp
            (solver_embed_mor hF hContr hInh (suc (suc n)))
            (ofe_mor_comp (solver_f hF hInh (suc n)) (solver_project hF hInh (suc n))),
           ofe_mor_comp
            (ofe_mor_comp (solver_embed_mor hF hContr hInh (suc n)) (solver_g hF hInh (suc n)))
            (solver_project hF hInh (suc (suc n))))
          (ofe_mor_id, ofe_mor_id)
          (\new DistLater {
            | dist_later_lt => \lam m hm =>
                ((solver_embed_project_f_later hF hContr hInh n).dist_later_lt m hm,
                 (solver_embed_project_g_later hF hContr hInh n).dist_later_lt m hm)
          })
          X
  \in G.ofe_dist_trans n
      (solver_unfold_chain_car hF hContr hInh
        ((solver_fold hF hContr hInh).ofe_mor_car X)
        (suc n))
      mid1
      X
      ((G.ofe_equiv_dist
        (solver_unfold_chain_car hF hContr hInh
          ((solver_fold hF hContr hInh).ofe_mor_car X)
          (suc n))
        mid1).1 h_chain_mid1 n)
      (G.ofe_dist_trans n mid1 mid2 X
        ((G.ofe_equiv_dist mid1 mid2).1 h_mid1_mid2 n)
        (G.ofe_dist_trans n mid2 ((F.oFunctor_map (ofe_mor_id, ofe_mor_id)).ofe_mor_car X) X
          h_mid2_id
          ((G.ofe_equiv_dist ((F.oFunctor_map (ofe_mor_id, ofe_mor_id)).ofe_mor_car X) X).1
            (F.oFunctor_map_id X)
            n)))

\lemma solver_unfold_fold {F : OFunctor} (hF : OFunctorApplyCOFE F)
                          (hContr : OFunctorContractive F)
                          (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                          (X : (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).E) :
  (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).equiv
    ((solver_unfold hF hContr hInh).ofe_mor_car
      ((solver_fold hF hContr hInh).ofe_mor_car X))
    X =>
  ((F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).ofe_equiv_dist
    ((solver_unfold hF hContr hInh).ofe_mor_car
      ((solver_fold hF hContr hInh).ofe_mor_car X))
    X).2
    (\lam n =>
      (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).ofe_dist_trans n
        ((solver_unfold hF hContr hInh).ofe_mor_car
          ((solver_fold hF hContr hInh).ofe_mor_car X))
        (solver_unfold_chain_car hF hContr hInh
          ((solver_fold hF hContr hInh).ofe_mor_car X)
          (suc n))
        X
        ((F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)).ofe_dist_le (suc n) n
          ((solver_unfold hF hContr hInh).ofe_mor_car
            ((solver_fold hF hContr hInh).ofe_mor_car X))
          (solver_unfold_chain_car hF hContr hInh
            ((solver_fold hF hContr hInh).ofe_mor_car X)
            (suc n))
          ((oFunctor_applyCOFE F hF (TowerCOFE F hF hInh)).cofe_conv_compl
            (solver_unfold_chain hF hContr hInh
              ((solver_fold hF hContr hInh).ofe_mor_car X)).1
            (solver_unfold_chain hF hContr hInh
              ((solver_fold hF hContr hInh).ofe_mor_car X)).2
            (suc n))
          (n<=sucn n))
        (solver_unfold_fold_chain hF hContr hInh X n))

\func solver_tower_car_coerce {F : OFunctor} (hF : OFunctorApplyCOFE F)
                              (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                              {i j : Nat} (p : i = j)
                              (X : (TowerCOFE F hF hInh).E) :
  (solver_coerce hF p).ofe_mor_car (X.tower_car i) = X.tower_car j \elim p
  | idp => idp

\lemma solver_coerce_plus_suc_zero {F : OFunctor} (hF : OFunctorApplyCOFE F)
                                   (k : Nat)
                                   (x : (solver_A F hF (suc k)).E) :
  (solver_A F hF (suc k)).equiv
    x
      ((solver_coerce hF (inv (solver_plus_suc_right_fun 0 k))).ofe_mor_car x) =>
  (solver_A F hF (suc k)).equiv_refl x

\lemma solver_project_embed_ff {F : OFunctor} (hF : OFunctorApplyCOFE F)
                               (hContr : OFunctorContractive F)
                               (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                               {k : Nat} (i : Nat) :
  (OFEMorOFE (solver_A F hF k) (solver_A F hF ((Nat.+) i k))).equiv
    (ofe_mor_comp
      (solver_project hF hInh ((Nat.+) i k))
      (solver_embed_mor hF hContr hInh k))
    (solver_ff hF hInh {k} i) =>
  \lam x =>
    (solver_A F hF ((Nat.+) i k)).equiv_trans
      ((solver_embed hF hContr hInh k x).tower_car ((Nat.+) i k))
      ((solver_embed hF hContr hInh ((Nat.+) i k)
        ((solver_ff hF hInh {k} i).ofe_mor_car x)).tower_car ((Nat.+) i k))
      ((solver_ff hF hInh {k} i).ofe_mor_car x)
      ((solver_A F hF ((Nat.+) i k)).equiv_sym
        ((solver_embed hF hContr hInh ((Nat.+) i k)
          ((solver_ff hF hInh {k} i).ofe_mor_car x)).tower_car ((Nat.+) i k))
        ((solver_embed hF hContr hInh k x).tower_car ((Nat.+) i k))
        ((solver_embed_ff hF hContr hInh i x) ((Nat.+) i k)))
      (solver_embed_self hF hContr hInh ((Nat.+) i k)
        ((solver_ff hF hInh {k} i).ofe_mor_car x))

\lemma solver_project_embed_gg {F : OFunctor} (hF : OFunctorApplyCOFE F)
                               (hContr : OFunctorContractive F)
                               (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                               {k : Nat} (i : Nat) :
  (OFEMorOFE (solver_A F hF ((Nat.+) i k)) (solver_A F hF k)).equiv
    (ofe_mor_comp
      (solver_project hF hInh k)
      (solver_embed_mor hF hContr hInh ((Nat.+) i k)))
    (solver_gg hF hInh {k} i) =>
  \lam x =>
    \let
      | E : (TowerCOFE F hF hInh).E =>
          solver_embed hF hContr hInh ((Nat.+) i k) x
      | hself : (solver_A F hF ((Nat.+) i k)).equiv (E.tower_car ((Nat.+) i k)) x =>
          solver_embed_self hF hContr hInh ((Nat.+) i k) x
      | hgg : (solver_A F hF k).equiv
          ((solver_gg hF hInh {k} i).ofe_mor_car (E.tower_car ((Nat.+) i k)))
          (E.tower_car k) =>
          solver_gg_tower hF hInh i E
      | hproper : (solver_A F hF k).equiv
          ((solver_gg hF hInh {k} i).ofe_mor_car (E.tower_car ((Nat.+) i k)))
          ((solver_gg hF hInh {k} i).ofe_mor_car x) =>
          ofe_mor_proper (solver_gg hF hInh {k} i)
            (E.tower_car ((Nat.+) i k))
            x
            hself
    \in (solver_A F hF k).equiv_trans
        (E.tower_car k)
        ((solver_gg hF hInh {k} i).ofe_mor_car (E.tower_car ((Nat.+) i k)))
        ((solver_gg hF hInh {k} i).ofe_mor_car x)
        ((solver_A F hF k).equiv_sym
          ((solver_gg hF hInh {k} i).ofe_mor_car (E.tower_car ((Nat.+) i k)))
          (E.tower_car k)
          hgg)
        hproper

\lemma solver_map_ff_gg {F : OFunctor} (hF : OFunctorApplyCOFE F)
                        (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                        (i k : Nat)
                        (x : (solver_A F hF (suc ((Nat.+) i k))).E) :
  (solver_A F hF (suc k)).equiv
    ((F.oFunctor_map
      (solver_ff hF hInh {k} i,
       solver_gg hF hInh {k} i)).ofe_mor_car x)
    ((solver_gg hF hInh {suc k} i).ofe_mor_car
      ((solver_coerce hF (inv (solver_plus_suc_right_fun i k))).ofe_mor_car x)) \elim i
  | 0 =>
      (solver_A F hF (suc k)).equiv_trans
        ((F.oFunctor_map
          (solver_ff hF hInh {k} 0,
           solver_gg hF hInh {k} 0)).ofe_mor_car x)
        x
        ((solver_coerce hF (inv (solver_plus_suc_right_fun 0 k))).ofe_mor_car x)
        (F.oFunctor_map_id x)
        (solver_coerce_plus_suc_zero hF k x)
  | suc i =>
      \let
        | y : (solver_A F hF (suc ((Nat.+) i k))).E =>
            (solver_g hF hInh (suc ((Nat.+) i k))).ofe_mor_car x
        | pre : (solver_A F hF (suc k)).E =>
            ((F.oFunctor_map
              (solver_ff hF hInh {k} i,
               solver_gg hF hInh {k} i)).ofe_mor_car y)
        | hcomp : (solver_A F hF (suc k)).equiv pre
            ((F.oFunctor_map
              (ofe_mor_comp (solver_f hF hInh ((Nat.+) i k)) (solver_ff hF hInh {k} i),
               ofe_mor_comp (solver_gg hF hInh {k} i) (solver_g hF hInh ((Nat.+) i k)))).ofe_mor_car x) =>
            F.oFunctor_map_compose
              (solver_f hF hInh ((Nat.+) i k)) (solver_ff hF hInh {k} i)
              (solver_g hF hInh ((Nat.+) i k)) (solver_gg hF hInh {k} i)
              x
        | hIH : (solver_A F hF (suc k)).equiv pre
            ((solver_gg hF hInh {suc k} i).ofe_mor_car
              ((solver_coerce hF (inv (solver_plus_suc_right_fun i k))).ofe_mor_car y)) =>
            solver_map_ff_gg hF hInh i k y
      \in (solver_A F hF (suc k)).equiv_trans
          ((F.oFunctor_map
            (ofe_mor_comp (solver_f hF hInh ((Nat.+) i k)) (solver_ff hF hInh {k} i),
             ofe_mor_comp (solver_gg hF hInh {k} i) (solver_g hF hInh ((Nat.+) i k)))).ofe_mor_car x)
          pre
          ((solver_gg hF hInh {suc k} i).ofe_mor_car
            ((solver_g hF hInh (suc ((Nat.+) i k))).ofe_mor_car
              ((solver_coerce hF (inv (solver_plus_suc_right_fun (suc i) k))).ofe_mor_car x)))
          ((solver_A F hF (suc k)).equiv_sym pre
            ((F.oFunctor_map
              (ofe_mor_comp (solver_f hF hInh ((Nat.+) i k)) (solver_ff hF hInh {k} i),
               ofe_mor_comp (solver_gg hF hInh {k} i) (solver_g hF hInh ((Nat.+) i k)))).ofe_mor_car x)
            hcomp)
          ((solver_A F hF (suc k)).equiv_trans
            pre
            ((solver_gg hF hInh {suc k} i).ofe_mor_car
              ((solver_coerce hF (inv (solver_plus_suc_right_fun i k))).ofe_mor_car y))
            ((solver_gg hF hInh {suc k} i).ofe_mor_car
              ((solver_g hF hInh (suc ((Nat.+) i k))).ofe_mor_car
                ((solver_coerce hF (inv (solver_plus_suc_right_fun (suc i) k))).ofe_mor_car x)))
            hIH
            (ofe_mor_proper (solver_gg hF hInh {suc k} i)
              ((solver_coerce hF (inv (solver_plus_suc_right_fun i k))).ofe_mor_car y)
              ((solver_g hF hInh (suc ((Nat.+) i k))).ofe_mor_car
                ((solver_coerce hF (inv (solver_plus_suc_right_fun (suc i) k))).ofe_mor_car x))
              (((solver_A F hF ((Nat.+) i (suc k))).ofe_equiv_dist
                ((solver_coerce hF (inv (solver_plus_suc_right_fun i k))).ofe_mor_car y)
                ((solver_g hF hInh (suc ((Nat.+) i k))).ofe_mor_car
                  ((solver_coerce hF (inv (solver_plus_suc_right_fun (suc i) k))).ofe_mor_car x))).2
                (equiv_dist_n
                  ((solver_coerce hF (inv (solver_plus_suc_right_fun i k))).ofe_mor_car y)
                  ((solver_g hF hInh (suc ((Nat.+) i k))).ofe_mor_car
                    ((solver_coerce hF (inv (solver_plus_suc_right_fun (suc i) k))).ofe_mor_car x))
                  (inv (solver_g_coerce hF hInh
                    (inv (solver_plus_suc_right_fun i k))
                    x)
                   *> pmap
                    (\lam q => (solver_g hF hInh (suc ((Nat.+) i k))).ofe_mor_car
                      ((solver_coerce hF q).ofe_mor_car x))
                    (pmap_inv-comm suc (solver_plus_suc_right_fun i k)))))))

\lemma solver_fold_unfold_dist {F : OFunctor} (hF : OFunctorApplyCOFE F)
                               (hContr : OFunctorContractive F)
                               (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                               (X : (TowerCOFE F hF hInh).E)
                               (k n : Nat) :
  (solver_A F hF k).dist n
    (((solver_fold hF hContr hInh).ofe_mor_car
      ((solver_unfold hF hContr hInh).ofe_mor_car X)).tower_car k)
    (X.tower_car k) =>
  (solver_A F hF k).ofe_dist_trans n
          (((solver_fold hF hContr hInh).ofe_mor_car
            ((solver_unfold hF hContr hInh).ofe_mor_car X)).tower_car k)
          ((solver_g hF hInh k).ofe_mor_car (X.tower_car (suc k)))
          (X.tower_car k)
          ((solver_g hF hInh k).ofe_mor_ne n
            ((F.oFunctor_map
              (solver_embed_mor hF hContr hInh k,
               solver_project hF hInh k)).ofe_mor_car
              ((solver_unfold hF hContr hInh).ofe_mor_car X))
            (X.tower_car (suc k))
            (\let
              | r : Nat => (Nat.+) n k
              | G : OFE.{0} => F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)
              | U : G.E => (solver_unfold hF hContr hInh).ofe_mor_car X
              | x : (solver_A F hF (suc r)).E => X.tower_car (suc r)
              | C : G.E => solver_unfold_chain_car hF hContr hInh X r
              | map_k : OFEMor G (solver_A F hF (suc k)) =>
                  F.oFunctor_map
                    (solver_embed_mor hF hContr hInh k,
                     solver_project hF hInh k)
              | comped : (solver_A F hF (suc k)).E =>
                  (F.oFunctor_map
                    (ofe_mor_comp (solver_project hF hInh r) (solver_embed_mor hF hContr hInh k),
                     ofe_mor_comp (solver_project hF hInh k) (solver_embed_mor hF hContr hInh r))).ofe_mor_car x
              | mapff : (solver_A F hF (suc k)).E =>
                  (F.oFunctor_map
                    (solver_ff hF hInh {k} n,
                     solver_gg hF hInh {k} n)).ofe_mor_car x
              | mid : (solver_A F hF (suc k)).E =>
                  (solver_gg hF hInh {suc k} n).ofe_mor_car
                    ((solver_coerce hF (inv (solver_plus_suc_right_fun n k))).ofe_mor_car x)
              | hU_C : (solver_A F hF (suc k)).dist n
                  (map_k.ofe_mor_car U)
                  (map_k.ofe_mor_car C) =>
                  map_k.ofe_mor_ne n U C
                    (G.ofe_dist_le r n U C
                      (solver_unfold_conv hF hContr hInh X r)
                      (solver_le_plus_left n k))
              | hC_comped : (solver_A F hF (suc k)).equiv (map_k.ofe_mor_car C) comped =>
                  F.oFunctor_map_compose
                    (solver_project hF hInh r) (solver_embed_mor hF hContr hInh k)
                    (solver_embed_mor hF hContr hInh r) (solver_project hF hInh k)
                    x
              | hcomped_mapff : (solver_A F hF (suc k)).equiv comped mapff =>
                  solver_oFunctor_map_equiv F
                    (ofe_mor_comp (solver_project hF hInh r) (solver_embed_mor hF hContr hInh k))
                    (solver_ff hF hInh {k} n)
                    (ofe_mor_comp (solver_project hF hInh k) (solver_embed_mor hF hContr hInh r))
                    (solver_gg hF hInh {k} n)
                    (solver_project_embed_ff hF hContr hInh n)
                    (solver_project_embed_gg hF hContr hInh n)
                    x
              | hmapff_mid : (solver_A F hF (suc k)).equiv mapff mid =>
                  solver_map_ff_gg hF hInh n k x
              | hmid_tower : (solver_A F hF (suc k)).equiv mid (X.tower_car (suc k)) =>
                  (solver_A F hF (suc k)).equiv_trans
                    mid
                    ((solver_gg hF hInh {suc k} n).ofe_mor_car
                      (X.tower_car ((Nat.+) n (suc k))))
                    (X.tower_car (suc k))
                    (ofe_mor_proper (solver_gg hF hInh {suc k} n)
                      ((solver_coerce hF (inv (solver_plus_suc_right_fun n k))).ofe_mor_car x)
                      (X.tower_car ((Nat.+) n (suc k)))
                      (solver_eq_equiv
                        ((solver_coerce hF (inv (solver_plus_suc_right_fun n k))).ofe_mor_car x)
                        (X.tower_car ((Nat.+) n (suc k)))
                        (solver_tower_car_coerce hF hInh (inv (solver_plus_suc_right_fun n k)) X)))
                    (solver_gg_tower hF hInh n X)
            \in (solver_A F hF (suc k)).ofe_dist_trans n
                (map_k.ofe_mor_car U)
                (map_k.ofe_mor_car C)
                (X.tower_car (suc k))
                hU_C
                ((solver_A F hF (suc k)).ofe_dist_trans n
                  (map_k.ofe_mor_car C)
                  comped
                  (X.tower_car (suc k))
                  (((solver_A F hF (suc k)).ofe_equiv_dist (map_k.ofe_mor_car C) comped).1 hC_comped n)
                  ((solver_A F hF (suc k)).ofe_dist_trans n
                    comped
                    mapff
                    (X.tower_car (suc k))
                    (((solver_A F hF (suc k)).ofe_equiv_dist comped mapff).1 hcomped_mapff n)
                    ((solver_A F hF (suc k)).ofe_dist_trans n
                      mapff
                      mid
                      (X.tower_car (suc k))
                      (((solver_A F hF (suc k)).ofe_equiv_dist mapff mid).1 hmapff_mid n)
                      (((solver_A F hF (suc k)).ofe_equiv_dist mid (X.tower_car (suc k))).1 hmid_tower n))))))
          (((solver_A F hF k).ofe_equiv_dist
            ((solver_g hF hInh k).ofe_mor_car (X.tower_car (suc k)))
            (X.tower_car k)).1 (X.g_tower k) n)

\lemma solver_fold_unfold {F : OFunctor} (hF : OFunctorApplyCOFE F)
                          (hContr : OFunctorContractive F)
                          (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
                          (X : (TowerCOFE F hF hInh).E) :
  (TowerCOFE F hF hInh).equiv
    ((solver_fold hF hContr hInh).ofe_mor_car
      ((solver_unfold hF hContr hInh).ofe_mor_car X))
    X =>
  \lam k =>
    ((solver_A F hF k).ofe_equiv_dist
      (((solver_fold hF hContr hInh).ofe_mor_car
        ((solver_unfold hF hContr hInh).ofe_mor_car X)).tower_car k)
      (X.tower_car k)).2
      (\lam n => solver_fold_unfold_dist hF hContr hInh X k n)

\func solver_result (F : OFunctor)
                    (hF : OFunctorApplyCOFE F)
                    (hContr : OFunctorContractive F)
                    (hInh : Inhabited (F.oFunctor_car UnitCOFE UnitCOFE).E)
  : Solution F \cowith
  | solution_car => TowerCOFE F hF hInh
  | solution_inhabited => TowerInhabited F hF hContr hInh
  | solution_iso => \new OFEIso (F.oFunctor_car (TowerCOFE F hF hInh) (TowerCOFE F hF hInh)) (TowerCOFE F hF hInh) {
      | ofe_iso_1 => solver_fold hF hContr hInh
      | ofe_iso_2 => solver_unfold hF hContr hInh
      | ofe_iso_12 => solver_fold_unfold hF hContr hInh
      | ofe_iso_21 => solver_unfold_fold hF hContr hInh
    }
